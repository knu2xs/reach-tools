[{"result":{"data":{"json":{"id":"1032","stub":{"id":"1032","section":"2. Yaak Falls to Kootenai R.","altname":"","river":"Yaak","difficulty":"IVtoV","states":["USA-MNT"]},"primaryGaugeStatus":{"status":"high-runnable","latestReading":{"value":"5.81","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"110707","location":{"latitude":"48.6492","longitude":"-115.884003"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"115976","location":{"latitude":"48.560902","longitude":"-115.976997"},"name":"Take Out","distance":"6.5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"40922","ext":"jpeg","post_id":"9993","description":"This shows the falls at a potentially hazardous level.  They are much more manageable at lower levels.","caption":"Yaak Falls","poi_name":"Yaak Falls","subject":"Yaak Falls","author":"NW Paddler","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/40922","large":"https://api.americanwhitewater.org/image/images/big/40922"}},{"id":"11211","ext":"mov","post_id":"8655","description":"A quick shot of Will running the last drop of the Yak.  More pics and video available at www.middlebury.edu/~nvandal","caption":"","poi_name":"Good to the Last Drop","subject":"Will Carroll","author":"Goudi Vandal","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/11211","large":"https://api.americanwhitewater.org/image/images/big/11211"}},{"id":"15273","ext":"jpeg","post_id":"7206","description":"After missing the top eddy, we chose to at least \r\nscout the bottom half of Stone Chest","caption":"Second half of \"Stone Chest\"","poi_name":"Stone Chest","subject":"","author":"KJK","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/15273","large":"https://api.americanwhitewater.org/image/images/big/15273"}},{"id":"15386","ext":"jpeg","post_id":"7206","description":"Last class III rapid on the Yaak before a long flat \r\nstretch.  One of the few places where it is relatively \r\neasy to hike into the gorge.","caption":"One of many class III drops","poi_name":"","subject":"","author":"KJK","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/15386","large":"https://api.americanwhitewater.org/image/images/big/15386"}},{"id":"15491","ext":"jpeg","post_id":"2367","description":"","caption":"Lower Yaak falls","poi_name":"","subject":"Travis Nichols","author":"local resident \"Turk\"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/15491","large":"https://api.americanwhitewater.org/image/images/big/15491"}},{"id":"15277","ext":"jpeg","post_id":"5576","description":"Upper Stone Chest rapid at low water.","caption":"Low water Yaak","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/15277","large":"https://api.americanwhitewater.org/image/images/big/15277"}},{"id":"15274","ext":"jpeg","post_id":"7206","description":"","caption":"First half of Stone Chest","poi_name":"Stone Chest","subject":"","author":"KJK","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/15274","large":"https://api.americanwhitewater.org/image/images/big/15274"}},{"id":"15385","ext":"jpeg","post_id":"7206","description":"A guy at the put in said this was a weir made by \r\nChinese miners.  I think he was nuts.","caption":"Bad line through the \"weir\"","poi_name":"The Weir","subject":"","author":"KJK","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/15385","large":"https://api.americanwhitewater.org/image/images/big/15385"}},{"id":"15387","ext":"jpeg","post_id":"7206","description":"Top half of Good to the Last Drop; the last rapid on \r\nthe Yaak.  At low flows (like this), it is just a big \r\nboulder dodge.","caption":"Good to the Last Drop (top part)","poi_name":"Good to the Last Drop","subject":"","author":"KJK","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/15387","large":"https://api.americanwhitewater.org/image/images/big/15387"}},{"id":"15501","ext":"jpeg","post_id":"5576","description":"","caption":"Yaak","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/15501","large":"https://api.americanwhitewater.org/image/images/big/15501"}}],"detail":{"id":"1032","permitUrl":"","permitInfo":"","description":"The Yaak is one of the coolest runs in Montana. Access is easy, but the canyon has a remote feel. Green, mossy canyon walls and huge trees provide a beautiful setting.\n\nPaddlers interested in Yaak Falls can run the falls much lower than the rest of the run.  700 cfs was still plenty of water for those two drops.\n\nBelow the Falls, and after several miles, watch for a log pile on river left, just above a left turn, where the river drops out of sight. This rapid is called \"Stonechest\", and is the crux rapid on the run. Scout on river left. The water really hauls ass through this part. Most of the rapid can be seen from the top. Most of what appear to be holes from above, are actually holes. If you decide to portage, do so on river right. This rapid has been the scene of much carnage in the past, but most class IV boaters will love it. After Stonechest is about another mile of closed in canyon, then lets up to class II for three miles or so. When you see two large trees with broken out tops, side by side on the left bank, you are coming into the last drop, appropriately called \"Good To The Last Drop\". GTTLD at most levels is a fun eddy hopping class IV boulder garden. If in doubt where to be, stay right. The gauge and US 2 Hwy bridge are just below. A USFS campground is south of Hwy 2 below the bridge. There is also a small campground at the putin.\n\nTo get to the putin, go West on Hwy 2 from the takeout for several miles to Yaak River Road. Go right up the road for about eight miles to Yaak Falls (yes it has been run). Put in at the campground just below the falls. The Yaak is fun at most levels above 800 cfs, and is optimal at 2500 for most paddlers. Flood stage is 7100 cfs, and is runnable, but epic. **NOTE: At levels about 6500 CFS and above, the portage at Stonechest becomes impossible on river right, and next to impossible on river left.**","averageGradient":"40","maxGradient":"85","length":"9.1","correlations":[{"reachID":"1032","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"4.4","beginMediumRunnable":"4.8","beginHighRunnable":"5.6","endHighRunnable":"6.5"},"gaugeInfo":{"name":"Yaak River near Troy MT","gaugeSource":"USGS","gaugeSourceIdentifier":"12304500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"2260","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"5.81","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"48.5617222","longitude":"-115.9701583"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/12304500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/12304500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"high-runnable","latestReading":{"value":"5.81","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null}}],"pointOfInterestIDs":["110707","115976"],"geometry":{"type":"LineString","coordinates":[[-115.88509303938241,48.64938425847183],[-115.88512913056341,48.64920912448673],[-115.88504853056355,48.64841459115462],[-115.88511053056347,48.64794799115538],[-115.8849511305637,48.6472719911564],[-115.88480599723057,48.64681332449044],[-115.88463413056415,48.646509991157586],[-115.88433899723128,48.64548452449253],[-115.88429813056469,48.644942124493355],[-115.88435119723131,48.644608124493864],[-115.88449859723106,48.64433592449427],[-115.88482279723054,48.64414832449461],[-115.88545073056292,48.643945124494905],[-115.88645579722801,48.64371512449526],[-115.88722933056016,48.64339719116242],[-115.88761833055952,48.6430999911629],[-115.88798979722566,48.64261812449695],[-115.88851579722483,48.64159099116523],[-115.88872073055786,48.64087852449967],[-115.8888407972243,48.63983159116793],[-115.88875113055782,48.63907319116914],[-115.88892313055756,48.637193791172024],[-115.88907439722398,48.636968591172376],[-115.88958799722313,48.636831991172585],[-115.8912557305539,48.63634372450667],[-115.89194153055287,48.63606112450714],[-115.89301459721781,48.63525319117508],[-115.89407699721617,48.63422239117665],[-115.89449899721554,48.63385019117726],[-115.89522319721442,48.63336732451132],[-115.89595873054662,48.633074591178456],[-115.89641779721256,48.63298032451195],[-115.89854593054258,48.63283272451213],[-115.89888159720876,48.63265492451245],[-115.8990981972084,48.63247152451271],[-115.8991995305416,48.63219272451312],[-115.89918979720824,48.631940191180206],[-115.89859633054249,48.63025052451616],[-115.89869413054237,48.62996872451657],[-115.89899039720852,48.62958339118387],[-115.8992417305