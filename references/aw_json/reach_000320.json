[{"result":{"data":{"json":{"id":"320","stub":{"id":"320","section":"2. Hobo Gulch Campground to EF NF Confluence","altname":"","river":"Trinity, North Fork","difficulty":"IVtoV","states":["USA-CAL"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"273","dateTime":"2026-05-11T21:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Put in at the Hobo Gulch Campground. To get there from Highway 299, turn at the sign for Helena and go approximately 3 miles on East Fork Road to the Hobo Gulch Road (34N07Y). Continue on Hobo Gulch Road for 12 miles to the campground.\n\nThe campground has 10 tent-pnly spaces and a restroom. As of January 2022 it is free of charge.","id":"109997","location":{"latitude":"40.928066","longitude":"-123.154879"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"Take out at the East Fork Road bridge immediately above the confluence of the NF Trinity and the EF NF Trinity. This is an easy access dispersed camping area. You will drive past the take-out on the way to the put-in.","id":"115249","location":{"latitude":"40.783346","longitude":"-123.129548"},"name":"Take Out","distance":"14.12","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"320","permitUrl":null,"permitInfo":null,"description":"The North Fork Trinity River is considered one of the best difficult whitewater runs in Northern California. At 14 miles in length and containing at least 100 rapids, it makes for a full day. The scenery and water quality are superb, the rapids are numerous and demanding, and odds are you'll have the entire place to yourself. River gradient ranges from 75 to 200 feet per mile.The entire run is on the Shasta-Trinity National Forest and it emerges clean and pristine from the Trinity Alps Wilderness Area. It may not be known to many but the NF Trinity is a world-class run, just be sure you're up for this kind of adventure before putting in.\n\nThe action starts almost right away below the put-in at Hobo Gulch Campground (free tent camping with a vault toilet but no other amenities). The first two miles are action-packed and will give you a good sense of the run and the respect it demands. After this, the river goes in and out of several mini gorges with lots of rapids. Be on top of your boat scouting and boofing and always be ready to punch sticky holes.\n\nOnce you're on the river, there is no practical way out except by boat. You will pass one cabin on river left after the first gorge; this is the only easy evacuation route so if there first two miles took a toll on you, this is the place to pull the plug and get out.\n\nThe road to the put-in can be blocked by snow after storms and in good snow years it might not be accessible until May. It's not a bad idea to bring a saw and shovel in case you need to do a little work to make the road passable.","averageGradient":null,"maxGradient":null,"length":"14","correlations":[{"reachID":"320","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"666","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"2000"},"gaugeInfo":{"name":"No. Trinity At Helena","gaugeSource":"DREAM","gaugeSourceIdentifier":"811","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"273","dateTime":"2026-05-11T21:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":null,"location":{"latitude":"30","longitude":"30"},"externalSourceLinks":{"sourceLink":{"url":"https://www.dreamflows.com/graphs/day.811.php","text":"Dream Flows"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"273","dateTime":"2026-05-11T21:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["109997","115249"],"geometry":{"type":"LineString","coordinates":[[-123.155215,40.928082],[-123.155215,40.928],[-123.155268,40.927829],[-123.155268,40.92774],[-123.155322,40.927635],[-123.155397,40.927392],[-123.155537,40.9271],[-123.155612,40.927019],[-123.155698,40.926889],[-123.156059,40.926631],[-123.156059,40.926631],[-123.156266,40.926484],[-123.15647,40.926314],[-123.156513,40.926232],[-123.156534,40.926159],[-123.156524,40.926087],[-123.156438,40.925916],[-123.156363,40.925689],[-123.156363,40.925479],[-123.156416,40.925357],[-123.156545,40.925179],[-123.156588,40.925081],[-123.15662,40.924968],[-123.15661,40.924879],[-123.156642,40.92479],[-123.156695,40.924717],[-123.157146,40.924546],[-123.157243,40.92449],[-123.157307,40.924433],[-123.157307,40.924417],[-123.157307,40.924417],[-123.157328,40.924392],[-123.157339,40.924271],[-123.157328,40.924206],[-123.157264,40.924125],[-123.15691,40.923898],[-123.15661,40.923776],[-123.156309,40.923695],[-123.156223,40.923647],[-123.156148,40.923574],[-123.156041,40.923387],[-123.155934,40.923095],[-123.155762,40.922803],[-123.15559,40.922633],[-123.155537,40.922495],[-123.15544,40.922349],[-123.155322,40.922268],[-123.155043,40.922131],[-123.1547,40.921904],[-123.154464,40.921701],[-123.153938,40.92119],[-123.153713,40.920898],[-123.153402,40.920444],[-123.153112,40.920104],[-123.15294,40.919982],[-123.152329,40.91948],[-123.152221,40.919285],[-123.152189,40.919155],[-123.152082,40.919001],[-123.152039,40.918718],[-123.151985,40.918531],[-123.1519,40.918418],[-123.151642,40.918288],[-123.15146,40.918223],[-123.151385,40.918118],[-123.151063,40.917891],[-123.150913,40.917737],[-123.150848,40.917591],[-123.150848,40.917469],[-123.150923,40.917234],[-123.150945,40.917096],[-123.150923,40.916942],[-123.150848,40.916666],[-123.150955,40.916237],[-123.151052,40.9