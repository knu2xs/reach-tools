[{"result":{"data":{"json":{"id":"323","stub":{"id":"323","section":"2. Floriston (or Farad) to Verdi, NV ","altname":"","river":"Truckee","difficulty":"III","states":["USA-CAL","USA-NEV"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"1300","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Put-in at the Floriston Exit 199 on the upstream river right side of the Interstate 80 Bridge. Put in downstream of Bronco Rapid or walk up to run it if you want to start your run with this challenging rapid.","id":"112685","location":{"latitude":"39.394358","longitude":"-120.024156"},"name":"Floriston Exit 199 Put In","distance":"0","photoID":"9P47JtgmVoGNbK8vKq29d","difficulty":"N/A","approximate":false},{"type":"rapid","description":"Rapid at the former site of the Farad diversion dam, a 15' high and 200' wide earth and gravel-filled diversion dam that diverted river flow to the Farad Powerhouse and was damaged in the 1997 floods.","id":"VSiQSVpX31bbJxE6DhLI6","location":{"latitude":"39.396489","longitude":"-120.024661"},"name":"Blowout Rapid","distance":"0.19","difficulty":"III","approximate":false,"photoID":"SWxAGdpTEhzZDREPKXbir"},{"type":"other","description":"The Farad Hydropower Project (FERC P-4161) was constructed in 1899 by the Truckee River General Electric Company as the first hydropower project on the Truckee River to provide power for the local silver mines. It contained two generating units with a combined capacity of 2.5 megawatts. The Sierra Pacific Power Company operated the project until a 1997 flood severely damaged the project rendering it inoperable. Truckee Meadows Water Authority assumed control of the facility but in 2017 determined that reconstruction of the project was not financially viable.","id":"KnjK0uanINtKjkF9DM13j","location":{"latitude":"39.419969","longitude":"-120.031283"},"name":"Farad Hydropower Plant","di