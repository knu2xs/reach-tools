[{"result":{"data":{"json":{"id":"748","stub":{"id":"748","section":"2. Savage Dam to North Branch Potomac River","altname":"Site of 1989 World Championships","river":"Savage","difficulty":"IIItoIV","states":["USA-MRY"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"63","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Instead of crossing the bridge over the savage, you can hike up the river left side. Go past the gate, then through the field. Stay to the left at the top of the field. This puts you below the spillway on the river left channel a little upstream of the joining of the two channels. Provides you some bonus class 3 boogie. Generally considered not worth the hike.","id":"107322","location":{"latitude":"39.50339137","longitude":"-79.13008696"},"name":"Upper put-in","distance":"-0.35","photoID":"0","difficulty":"N/A","approximate":false},{"type":"put-in","description":"Typical put in location, just upstream of the Savage River Rd bridge (second when going upstream) by the camping and parking area. USGS gauge is located at the end of rapid below the putin and above the bridge","id":"107321","location":{"latitude":"39.50248053","longitude":"-79.12386558"},"name":"Bridge Put-in","distance":"0.05","photoID":"0","difficulty":"N/A","approximate":false},{"type":"access","description":"As things calm down you come to the first (when driving upstream) bridge (metal bridge). Right above this is a very small low head dam type feature. Easy to run river left as it has been broken down on that side. On river right it is retentive and potentially makes a surf spot depending on levels. Small amount of parking here, can potentially be used as a take out. Aaron run comes in from river left just below the bridge. There is a large strip mine upstream in the Aaron run watershed, which results in a great deal of erosion and fallen trees in the Savage below the confluence with the creek.","id":"107325","location":{"latitude":"39.48634281","longitude":"-79.08308347"},"name":"Metal Bridge","distance":"3.25","photoID":"893169","difficulty":"N/A","approximate":true},{"type":"takeout","description":"Just upstream of the bridge over the Savage at MD-135, on river left, immediately above the NB Potomac confluence is the takeout parking area. During releases, paddle under the bridge and down the right channel and then slightly upstream to take out by the abandoned bridge on the North Branch.","id":"107328","location":{"latitude":"39.48100055","longitude":"-79.06803917"},"name":"Release Takeout","distance":"4.34","photoID":"0","difficulty":"N/A","approximate":true}],"alerts":[{"id":"Ix2NO8cT7xqkWBwsQtzg9","title":"9/28/24 Release Cancelled","post_date":"2024-09-19 16:02:25+00","detail":"The Upper Potomac River Commission has decided to cancel the September 28th 2024 Savage WW release. They are canceling due to the lack of water resources in the reservoir, and are currently at levels that put local and downstream water supply at risk for the remainder of the year. They have not received significant inflow to the project since April.","user":{"name":"Kevin Colburn"}},{"id":"XQIYYBmnWkMw9gOEyq5yG","title":"July 7th release shortened 10-2","post_date":"2024-06-28 12:31:09+00","detail":"Due to current warm dry conditions dam managers are going to shorten the duration of the July 7th Savage Whitewater release. They plan to do a 4 hour release at 1000 cfs, which is 2 hours shorter than normal. Start time will be the same as in the past, so the July 7th event will run from 10:00 am until 2:00 pm.","user":{"name":"Kevin Colburn"}},{"id":"J5IlYNmXDV3XdGQbYMkd0","title":"September 2022 Release is ON","post_date":"2022-09-21 16:14:46+00","detail":"After re-evaluating current conditions, the September 24th, 2022 whitewater release from Savage River Dam will be held as originally scheduled. The release will be 1,000 cfs from 10am to 4pm. Additional details regarding ramping times and post-event flows will be posted on the North Branch Potomac forecast page (http://www.nab-wc.usace.army.mil/northBranch.html) later this week which also includes three-day projections for release rates for Jennings Randolph Lake and Savage River Dam.","user":{"name":"Kevin Colburn"}},{"id":"AYJ5m5TFf5zMZEL2VcDof","title":"September 2022 Release a Maybe","post_date":"2022-09-08 15:01:21+00","detail":"Warmer than normal water temperatures may lead to the 9/24/22 release being cancelled. We will report back up to 3 days prior with the decision. Cooler temps or rainfall could improve the situation.","user":{"name":"Kevin Colburn"}},{"id":"jfQlpwYRYidZrStQgBDbY","title":"2022 release update","post_date":"2021-09-15 21:19:50+00","detail":"See the full article below for release details, and be sure to: Park Only in the Official Put In and Take Out, Drive Respectfully, Respect Private Property, and Paddle Wise.","user":{"name":"Kevin Colburn"}},{"id":"101251622","title":null,"post_date":"2015-04-26 04:00:00+00","detail":"Ran it at 260cfs and it actually wasn't that scrapy, the stretch from the Putin to corner rapid could probably be run even lower, like 200cfs.\n\nThere's a log most of the way across at memorial rock. Probably underwater at full release, but it'd be dangerous to a swimmer","user":{"name":"CHRIS PREPERATO"}}],"photos":[{"id":"4264","ext":"jpeg","post_id":"2445","description":"From the photographer:<br>\r\nI own property on the Savage River in Maryland, below the dam. This is a popular whitewater river. Last night a very large tree fell into the river, taking a second tree with it. The river is completely blocked. I took the attached picture this morning (5/25). <br>\r\nThis is two miles above the junction of the Savage River and the North Branch of the Potomac at Bloomington, MD.<br>\r\nI thought you might want to get the word out to all potential kayakers.<br>\r\nIf the situation changes, I will let you know.","caption":"Savage Strainer","poi_name":"","subject":"","author":"Lawrence Belkin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/4264","large":"https://api.americanwhitewater.org/image/images/big/4264"}},{"id":"8300","ext":"jpeg","post_id":"7313","description":"Everyone was surprised how runnable the Savage is at 350.  If this was a natural flow river, we would probably consider 350-400 the normal level, and the release level of 100-1200 as high water.","caption":"Savage in the race course","poi_name":"","subject":"","author":"Bill Kirby","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8300","large":"https://api.americanwhitewater.org/image/images/big/8300"}},{"id":"10801","ext":"jpeg","post_id":"7314","description":"This was the big water Savage race, with the dam running at full capacity and water coming over the spillway.  Only the brave raced that day.","caption":"John Hefti at the Savage Races, 1973","poi_name":"","subject":"John Hefti","author":"Bill Kirby","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10801","large":"https://api.americanwhitewater.org/image/images/big/10801"}},{"id":"8292","ext":"jpeg","post_id":"7550","description":"This is the dam about 1/2 mile below the putin.  The river right slot (not visible in pic) has a pretty gnarly hole that looks hungry for boaters.  Most people portage river left.","caption":"Dam!","poi_name":"","subject":"","author":"Chris B","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8292","large":"https://api.americanwhitewater.org/image/images/big/8292"}},{"id":"881213","ext":"jpeg","post_id":"883726","description":"They insisted on running the old piedmont dam.  What a great thing to share with your family.","caption":"Life long memories","poi_name":"old Peidmont Dam","subject":"Mason, Jared, and Patch","author":"Karen Alden","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/881213","large":"https://api.americanwhitewater.org/image/images/big/881213"}},{"id":"8399","ext":"jpeg","post_id":"7314","description":"The Savage at 3000 is something else.  Big bouncy ride through big waves and holes, but you better not swim; look at the trees.","caption":"Savage at 3000 cfs","poi_name":"Just above Piedmont dam","subject":"Tim Myers","author":"Bill Kirby","poi_id":"107328","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8399","large":"https://api.americanwhitewater.org/image/images/big/8399"}},{"id":"SaXdbAPi0rZXJpBmQzufR","ext":"jpg","post_id":"Wi9LqUCWwT4N5i8OUNbcw","description":"This is Memorial Rock. It can not be viewed from the road. Private homes are on river left.\n\nMemorial Rock is the third drop of the \"Triple Drop\" series.\n\nThe first drop, where the river turns to the right, away from the road and into the mini-gorge, is known as Crisscross or Double Hole (the first drop is not Memorial).","caption":"Memorial Rock","poi_name":null,"subject":"Marcy Fleeharty","author":"Jeff Macklin","poi_id":"107320","photo_date":"2022-07-21T22:16:32.000Z","updated_at":"2022-07-21T22:16:32.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/SaXdbAPi0rZXJpBmQzufR","large":"https://api.americanwhitewater.org/image/images/big/SaXdbAPi0rZXJpBmQzufR"}},{"id":"892075","ext":"jpg","post_id":"895975","description":null,"caption":null,"poi_name":"Hutch's Demise","subject":"Hutch's Demise","author":"Bill Durr","poi_id":"107324","photo_date":null,"updated_at":"2023-05-09T17:46:18.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/892075","large":"https://api.americanwhitewater.org/image/images/big/892075"}},{"id":"8293","ext":"jpeg","post_id":"7550","description":"Mark D stylin' through one of the many good drops.","caption":"Great fun!","poi_name":"","subject":"Mark D.","author":"Chris B","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8293","large":"https://api.americanwhitewater.org/image/images/big/8293"}},{"id":"9511","ext":"jpeg","post_id":"7315","description":"","caption":"Carrie Ashton, Savage Races, 1974","poi_name":"","subject":"Carrie Ashton","author":"Bill Kirby","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/9511","large":"https://api.americanwhitewater.org/image/images/big/9511"}},{"id":"880921","ext":"jpeg","post_id":"882166","description":"Piedmont Dam, unknown paddler","caption":"Slalom ca. 1973","poi_name":null,"subject":null,"author":"Bill Kirby","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880921","large":"https://api.americanwhitewater.org/image/images/big/880921"}},{"id":"8294","ext":"jpeg","post_id":"7550","description":"One of many similar drops on this creek.","caption":"Yet another great drop.","poi_name":"","subject":"","author":"Chris B","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8294","large":"https://api.americanwhitewater.org/image/images/big/8294"}},{"id":"549","ext":"jpeg","post_id":"1286","description":"","caption":"Savage 89 Worlds Dana Chaldek","poi_name":"","subject":"Dana Chladek","author":"Bob Combs","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/549","large":"https://api.americanwhitewater.org/image/images/big/549"}},{"id":"9504","ext":"jpeg","post_id":"7315","description":"","caption":"Charlie Walbridge, Savage Races, 1973","poi_name":"","subject":"Charlie Walbridge"