[{"result":{"data":{"json":{"id":"500","stub":{"id":"500","section":"Lower Roswell Rd to Chattahoochee River","altname":"","river":"Sope Creek","difficulty":"IIItoIVstandoutV","states":["USA-GEO"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"16","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"110104","location":{"latitude":"33.9556999206543","longitude":"-84.4431991577148"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":"Your basic riverwide ledge. Run on river right at low flows. At moderate to high flows the ledge forms a big nasty riverwide hole.","id":"706","location":{"latitude":"0","longitude":"0"},"name":"First Big Ledge","distance":"1","difficulty":"III+","approximate":false,"photoID":"2808"},{"type":"access","description":"The rapid directly under Paper Mill Bridge. Class 3 at low flows, Class 5 at high flows. The hole downstream of the bridge becomes a keeper when the water is high. When the water is _really_ high a riverwide hole forms on the upstream side of the bridge. Its worth a look from the bridge before you put on.","id":"279","location":{"latitude":"0","longitude":"0"},"name":"Paper Mill Rapid","distance":"1.3","photoID":"655","difficulty":"III+","approximate":false},{"type":"takeout","description":null,"id":"115361","location":{"latitude":"33.904899597168","longitude":"-84.4429016113281"},"name":"Take Out","distance":"2.5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"654","ext":"jpeg","post_id":"1347","description":"The rapid on the north side of the Paper Mill Bridge at low to moderate flow.","caption":"Sope Creek","poi_name":"","subject":"Brad Roberts","author":"Will Reeves","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/654","large":"https://api.americanwhitewater.org/image/images/big/654"}},{"id":"6077","ext":"jpeg","post_id":"4628","description":"If these holes look this big when you go over the bridge your in for an epic trip.","caption":"Hole above bridge - river right","poi_name":"Paper Mill Rapid","subject":"","author":"Micheal Stephenson","poi_id":"279","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6077","large":"https://api.americanwhitewater.org/image/images/big/6077"}},{"id":"655","ext":"jpeg","post_id":"1345","description":"Brad Roberts Punching a hole on Sope Creek.","caption":"Sope Creek - 2","poi_name":"","subject":"Brad Roberts","author":"Will Reeves","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/655","large":"https://api.americanwhitewater.org/image/images/big/655"}},{"id":"39746","ext":"jpeg","post_id":"1346","description":"SOPE CREEK AT PAPER MILL RD","caption":"SOPE CREEK","poi_name":"PAPER MILL RD","subject":"SOPE CREEK","author":"GREG SIMPSON","poi_id":"279","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/39746","large":"https://api.americanwhitewater.org/image/images/big/39746"}},{"id":"2808","ext":"jpeg","post_id":"1348","description":"Probably about 350 cfs in the gorge.","caption":"First ledge on Sope Creek","poi_name":"First big ledge","subject":"Jim Strickland","author":"Brad Roberts","poi_id":"706","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/2808","large":"https://api.americanwhitewater.org/image/images/big/2808"}},{"id":"6075","ext":"jpeg","post_id":"4627","description":"Believe it or not there is a open boat in the hole in this picture.  The hole is about 80ft wide and the boil line is about 20 ft back at these levels.  ","caption":"First Ledge- HIGH water, HUGE hole","poi_name":"First Ledge","subject":"","author":"Micheal Stephenson","poi_id":"706","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6075","large":"https://api.americanwhitewater.org/image/images/big/6075"}},{"id":"6076","ext":"jpeg","post_id":"4628","description":"If these holes look this big when you go over the bridge your in for an epic trip.","caption":"Hole above bridge- river left","poi_name":"Paper Mill Rapid","subject":"","author":"Micheal Stephenson","poi_id":"279","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6076","large":"https://api.americanwhitewater.org/image/images/big/6076"}},{"id":"6078","ext":"jpeg","post_id":"4628","description":"High water.  Big, bad hole.  Before the run Milt told he had his worst beatdown here.  We never made it that far.","caption":"Paper Mill Rapid- BIG hole below bridge","poi_name":"Paper Mill Rapid","subject":"","author":"Micheal Stephenson","poi_id":"279","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6078","large":"https://api.americanwhitewater.org/image/images/big/6078"}}],"detail":{"id":"500","permitUrl":null,"permitInfo":null,"description":"Gauge Description:\n\nThe gauge is on river left at the put-in. It reads in feet.\n\nLast checked the USGS put-in gauge had been washed away in a recent flood. There is still a spray painted gauge on the Lower Roswell Road bridge pilings.\n\nA visual check of the stream from the Paper Mill Road bridge is strongly recommended before putting on. There is more stream flow info in the text below.\n\nUser Comments\n\nBrad Roberts 2001-04-01 21:41:24\n\nSope Creek is one of the best whitewater runs in Metro Atlanta.\n\n**At high flows, around 1100 cfs or above 8 feet Sope Creek can turn into a solid class 5 run.** At moderate flows its a class 3-4 run. At all flows the water quality is nasty. Sope is very polluted due to street runoff.\n\nFrom the put-in on Lower Roswell Road there is about a mile of mostly flatwater. At higher flows there are two small surf waves and a good splat rock in this stretch. Eventually you will round a bend and the bottom will drop out.\n\nThe meat of Sope runs over a series of bedrock ledges. These ledges make for a series of fairly deep sticky holes. Sometimes they are punchable, sometimes they are not. The best way to get an idea of how Sope is running is to do a visual check from the bridge at Paper Mill Rd. If the hole immediatly past the bridge is the only thing that looks nasty, then the river is at a moderate level. If the hole has formed immediately above the bridge pilings, then you had better be on top of your game before putting on. Generally the hole above the bridge does not form until about 9 feet on the USGS gauge. I think that correlates to about 1500 cfs in a 65 foot wide ditch. 500 to 1000 cfs make much more sense in a streambed this size.\n\nAt high water the 4 ledges down to Paper Mill Road can form riverwide keeper hydralics. The top one recently held a boat for over a half an hour at high flows. The one below the bridge once held a 55 gallon drum for a couple of days.\n\nBelow the Paper Mill Rd bridge the rapids continue most of the way to the hooch. Its class 3 at normal flows, and class 3+ with no eddies at higher flows. Below the bridge at higher flows, dropping holes sideways so you can scout and surf at the same time is not unusual.\n\n\nSope Creek is also noted for a variety of large strainers that tend to relocate with every flood. Toward the end of the run are two pipes and one bridge that must be dealt with. At lower flows you can go under the pipes, sometimes you can go over them, and sometimes they are clogged with wood. Same with the Columns Drive bridge.\n\nSope only runs after a hard rain, and usually holds its water for less than a day. Be aware that the water level can go up over 1000 cfs in less than 30 minutes during a good rain. This recently caught a group by surprise. Read the story in the comments section at the bottom of the page.\n\n_Updated June 2003_\n\n**Logistics:**\n\n\nPut-in below the bridge on Lower Roswell Road. About 100 yards east of the creek is a small side street and a semi-legal place to park.\n\nThe usual take out is the [Metro Hooch](http://www.americanwhitewater.org/rivers/id/474/\n) put-in. Taking out at Columns Drive is a good way to get your car towed. They are serious about those no parking signs in front of the multi-million dollar homes.\n\nFor more adrenaline, about a quarter mile past the bridge on Paper Mill is a micro creek coming in on river left. If you feel like breaking your boat, carry up and run the falls by a putting green on the Atlanta Country Club. Its a back tweaker... but its been run by a couple of people.\n\nSope Creek runs about 2.5 miles between Lower Roswell Rd and Columns Drive.\n\nThe paddle out from Columns Drive to Powers Island is about another 2.5 miles.\n\n[Rottenwood creek](http://www.americanwhitewater.org/rivers/id/497/), less than 5 miles away, can usually be run the same day that Sope runs.\n\n[National Park Service Map of Sope Creek](http://www.nps.gov/chat/ppmaps/c%5Fs%5Fp%2Epdf).\n\n\n**Sope Creek Feet to CFS correlation:**\n\nFeet CFS 2.0??2.5593.01043.51574.02204.53005.03905.54856.05906.57257.08307.59708.011008.513009.015009.5172510.02000","averageGradient":"39","maxGradient":"120","length":"4.7","correlations":[{"reachID":"500","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"300","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"1500"},"gaugeInfo":{"name":"SOPE CREEK NEAR MARIETTA, GA","gaugeSource":"USGS","gaugeSourceIdentifier":"