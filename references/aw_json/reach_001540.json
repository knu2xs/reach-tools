[{"result":{"data":{"json":{"id":"1540","stub":{"id":"1540","section":"2. Gold Ray Dam to Gold Hill Boat Ramp (up to 5.5 miles)","altname":"Nugget Falls Run","river":"Rogue","difficulty":"IItoIV","states":["USA-ORE"]},"primaryGaugeStatus":{"status":"medium-runnable","latestReading":{"value":"2150","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"No more dam but there is a rapid at the site. Put in on river left. Located at USGS river mile 125.8.","id":"5343","location":{"latitude":"42.435636","longitude":"-122.985922"},"name":"Gold Ray Dam Rapid Put-in","distance":"0.15","photoID":"880146","difficulty":"II+","approximate":false},{"type":"access","description":"Access point on river left with a boat ramp. The site is the common put-in used by outfitters.","id":"1Dc08Q41QAhmWrVdoSx2L","location":{"latitude":"42.44054","longitude":"-122.99822"},"name":"Fishers Ferry","distance":"0.35","photoID":"GCoVMUz068vMKH71aTmgi","difficulty":"N/A","approximate":false},{"type":"rapid","description":"Rapid located at USGS river mile 123.7.","id":"100764","location":{"latitude":"42.456186","longitude":"-123.003488"},"name":"Hardy Riffle","distance":"2.25","difficulty":"II","approximate":false,"photoID":"27yE7bCHg3SAF2GsIS7gm"},{"type":"rapid","description":"A fun rapid with a couple of playspots. Located at USGS river mile 123.5.","id":"5344","location":{"latitude":"42.459416","longitude":"-123.005277"},"name":"Bitterman Falls","distance":"2.5","difficulty":"II+","approximate":false,"photoID":"19554"},{"type":"playspot","description":"You will find a fun surf wave or two in this rapid. Located at USGS river mile 122.8.","id":"5345","location":{"latitude":"42.461561","longitude":"-123.014236"},"name":"Lyman Falls (aka Dowden Falls or Doughton Falls)","distance":"3.12","difficulty":"II+","approximate":false,"photoID":"19555"},{"type":"access","description":"This access provides a put-in for the biggest drops on the run with a short shuttle on river right. The site is administered by the State of Oregon primarily as a fishing access and has a locked gate but a key has been available for regular users of the site. Walk in access to the site is also permitted. Located at USGS river mile 122.7.","id":"5346","location":{"latitude":"42.460563","longitude":"-123.016095"},"name":"Lyman Falls Fishing Access","distance":"3.24","photoID":"19556","difficulty":"N/A","approximate":false},{"type":"rapid","description":"An old weir diverts flow to river right where a fun play spot forms. Located at USGS river mile 122.3.","id":"5347","location":{"latitude":"42.458719","longitude":"-123.021021"},"name":"Broken Weir","distance":"3.54","difficulty":"II","approximate":false,"photoID":"19558"},{"type":"rapid","description":"A great drop. Follow the tongue down the left side, skirt the holes or punch them for a fun ride. Located at USGS river mile 122.2.","id":"5348","location":{"latitude":"42.457993","longitude":"-123.025253"},"name":"Nugget (or Dillon) Falls","distance":"3.79","difficulty":"III+","approximate":false,"photoID":"19559"},{"type":"rapid","description":"The diversion weir is now gone and there are a few riffles where it was. Located at USGS river mile 120.9.","id":"5349","location":{"latitude":"42.446085","longitude":"-123.042322"},"name":"Gold Hill Dam Site","distance":"5.08","difficulty":"N/A","approximate":false,"photoID":"41947"},{"type":"rapid","description":"The biggest drop on the run, also known as Powerhouse Falls. A popular line is down the center through the hole. You can also do the boof line to the left. Alternatively there is a bit of a sneak down the right. This rapid is hard to scout as the channel divides giving you a few different options and vegetation obscures the view.","id":"5350","location":{"latitude":"42.444149","longitude":"-123.041863"},"name":"Ti’lomikh Falls","distance":"5.22","difficulty":"IV","approximate":false,"photoID":"19563"},{"type":"takeout","description":"Take out on river right in the park.","id":"USIpxjUWDkmbar30nKsSr","location":{"latitude":"42.437325","longitude":"-123.042381"},"name":"Rogue Gold Sports Park Take-out","distance":"5.69","photoID":"Na5TsyJJmiPUnvDIWsEF2","difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"880147","ext":"jpeg","post_id":"881254","description":"","caption":"Gold Ray Dam site","poi_name":"","subject":"","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":"2011-08-20T06:53:09.000Z","updated_at":"2024-06-03T06:53:10.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880147","large":"https://api.americanwhitewater.org/image/images/big/880147"}},{"id":"17468","ext":"jpeg","post_id":"1767","description":"Gold Ray Dam is a former hydropower project on \r\nthe Rogue River (river mile 125.9) just upstream of \r\nthe town of Gold Hill. Construction of the first dam \r\nbegan in 1902 and started producing power in \r\n1904. When powerplant was decommissioned in \r\n1972 the generation capacity was 1250 kw. While \r\nthe dam no longer produces hydropower it \r\ncontinues to negatively impact fish and represents \r\na barrier to river navigation. It has a fish ladder but \r\nit is not maintained and flows on the river are \r\ntypically higher than the design flow for the ladder.","caption":"Gold Ray Dam","poi_name":"","subject":"","author":"Thomas O'Keefe В©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17468","large":"https://api.americanwhitewater.org/image/images/big/17468"}},{"id":"19557","ext":"jpeg","post_id":"1765","description":"Dropping into the rapid formed by an old diversion weir that directs all the flow to river right.","caption":"Broken Weir, top","poi_name":"","subject":"Amy Brown","author":"Thomas O'Keefe В©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/19557","large":"https://api.americanwhitewater.org/image/images/big/19557"}},{"id":"19562","ext":"jpeg","post_id":"1765","description":"A raft lines it up for the center chute at Ti’lomikh Falls.","caption":"Powerhouse Rapid, Center Chute","poi_name":"Ti’lomikh Falls","subject":"","author":"Thomas O'Keefe ©","poi_id":"5350","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/19562","large":"https://api.americanwhitewater.org/image/images/big/19562"}},{"id":"rSu8MuYLw0Rvo1oYS06FD","ext":"jpg","post_id":"kCOlraWPZqaVxqi7FJqkG","description":"","caption":"Nugget Run","poi_name":null,"subject":"","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":null,"photo_date":"2006-12-27T06:12:33.000Z","updated_at":"2024-06-03T06:12:33.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/rSu8MuYLw0Rvo1oYS06FD","large":"https://api.americanwhitewater.org/image/images/big/rSu8MuYLw0Rvo1oYS06FD"}},{"id":"19560","ext":"jpeg","post_id":"1765","description":"Access on river right just downstream of Nugget Falls.","caption":"BLM Access","poi_name":"","subject":"","author":"Thomas O'Keefe В©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/19560","large":"https://api.americanwhitewater.org/image/images/big/19560"}},{"id":"19556","ext":"jpeg","post_id":"1765","description":"An alternate access for this run that puts you in just above the two big drops and avoids the warm-up.","caption":"Alternate Access","poi_name":"","subject":"","author":"Thomas O'Keefe В©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/19556","large":"https://api.americanwhitewater.org/image/images/big/19556"}},{"id":"19553","ext":"jpeg","post_id":"1765","description":"The put-in on river left at the base of Gold Ray Dam.","caption":"Put-in Below Gold Ray Dam","poi_name":"","subject":"Amy Brown","author":"Thomas O'Keefe В©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/19553","large":"https://api.americanwhitewater.org/image/images/big/19553"}},{"id":"19561","ext":"jpeg","post_id":"1765","description":"This old diversion dam, a hazard for navigation and migrating fish, is scheduled for removal soon.","caption":"Gold Hill Dam, Powerhouse Rapids","poi_name":"","subject":"","author":"Thomas O'Keefe В©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/19561","large":"https://api.americanwhitewater.org/image/images/big/19561"}},{"id":"19554","ext":"jpeg","post_id":"1765","description":"The first fun set of class II rapids after paddling down from Gold Ray Dam.","caption":"Bitterman Falls","poi_name":"Bitterman Falls","subject":"Amy Brown","author":"Thomas O'Keefe В©","poi_id":"5344","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/19554","large":"https://api.americanwhitewater.org/image/images/big/19554"}},{"id":"19563","ext":"jpeg","post_id":"1765","description":"Taking the boof line down river left on Ti’lomikh Falls.","caption":"Ti’lomikh Falls, Boof Line","poi_name":"Ti’lomikh Falls","subject":"Amy Brown","author":"Thomas O'Keefe ©","poi_id":"5350","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/19563","large":"https://api.americanwhitewater.org/image/images/big/19563"}},{"id":"19558","ext":"jpeg","post_id":"1765","description":"An old concrete weir that directs flow over to river right.","caption":"Broken Weir","poi_name":"Broken Weir","subject":"","author":"Thomas O'Keefe В©","poi_id":"5344","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/19558","large":"https://api.americanwhitewater.org/image/images/big/19558"}},{