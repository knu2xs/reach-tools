[{"result":{"data":{"json":{"id":"1865","stub":{"id":"1865","section":"02. Price Canyon (Picnic area above Price Canyon to Castle Gate)","altname":"","river":"Price","difficulty":"IIItoIV","states":["USA-UTA"]},"primaryGaugeStatus":{"status":"stale","latestReading":{"value":"37","dateTime":"2003-10-01T05:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"112627","location":{"latitude":"39.826","longitude":"-110.947998"},"name":"Put In","distance":"0","photoID":"Mq2b2JeO0zEEFBNleouQM","difficulty":"N/A","approximate":false},{"type":"rapid","description":"This is a lite sample of bigger stuff on the second half of this river.","id":"euqrRkiNtjyMq8fDcFTnb","location":{"latitude":"39.825805","longitude":"-110.94405"},"name":"Putin rapid","distance":"0.23","difficulty":"III-","approximate":false,"photoID":"kSONAeP2MolgTyy8BbE8w"},{"type":"access","description":"6.2 road miles. A popular takeout with lots of parking room on the south side of the road in an old turnout. Avoids a diversion drop that is said to have metal in it, down lower.","id":"105760","location":{"latitude":"39.762001037597656","longitude":"-110.89399719238281"},"name":"bridge takeout","distance":"7.5","photoID":"0","difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"117913","location":{"latitude":"39.730999","longitude":"-110.869003"},"name":"Take Out","distance":"8.5","photoID":"XHqX7HnjrXSwgQYr2sV6A","difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"kSONAeP2MolgTyy8BbE8w","ext":"jpg","post_id":"GScHe3iaVZYWOca5i0qVE","description":"","caption":"Putin rapid","poi_name":null,"subject":"","author":"Evan Christensen","poi_id":"euqrRkiNtjyMq8fDcFTnb","photo_date":"2024-06-02T01:00:24.000Z","updated_at":"2024-06-02T01:00:24.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/kSONAeP2MolgTyy8BbE8w","large":"https://api.americanwhitewater.org/image/images/big/kSONAeP2MolgTyy8BbE8w"}},{"id":"878688","ext":"jpeg","post_id":"879128","description":"","caption":"Price Canyon","poi_name":"","subject":"","author":"Thomas O'Keefe","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/878688","large":"https://api.americanwhitewater.org/image/images/big/878688"}},{"id":"Mq2b2JeO0zEEFBNleouQM","ext":"jpg","post_id":"RBDKdJUELYRuJolhSzkUN","description":"","caption":"","poi_name":null,"subject":"","author":"Evan Christensen","poi_id":null,"photo_date":"2024-06-02T01:04:04.000Z","updated_at":"2024-06-02T01:04:04.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/Mq2b2JeO0zEEFBNleouQM","large":"https://api.americanwhitewater.org/image/images/big/Mq2b2JeO0zEEFBNleouQM"}},{"id":"XHqX7HnjrXSwgQYr2sV6A","ext":"jpg","post_id":"UrRVykDP6zMS8LqeHQMBb","description":"","caption":"","poi_name":null,"subject":"","author":"Evan Christensen","poi_id":null,"photo_date":"2024-06-02T01:07:29.000Z","updated_at":"2024-06-02T01:07:29.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/XHqX7HnjrXSwgQYr2sV6A","large":"https://api.americanwhitewater.org/image/images/big/XHqX7HnjrXSwgQYr2sV6A"}},{"id":"4dkWP7YZDIcP1iobzrAAi","ext":"jpg","post_id":"CtDyabvsTDxnKk7rOZqQY","description":"","caption":"One of the endless rapids in the second half","poi_name":null,"subject":"","author":"Evan Christensen","poi_id":null,"photo_date":"2024-06-02T01:17:17.000Z","updated_at":"2024-06-02T01:17:17.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/4dkWP7YZDIcP1iobzrAAi","large":"https://api.americanwhitewater.org/image/images/big/4dkWP7YZDIcP1iobzrAAi"}},{"id":"Ok7RkHYLvP45s014DzEBB","ext":"jpg","post_id":"9dJHLYiGZaTRs7uHXpQt9","description":"","caption":"","poi_name":null,"subject":"","author":"Evan Christensen","poi_id":null,"photo_date":"2024-06-02T18:06:48.000Z","updated_at":"2025-02-15T18:06:48.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/Ok7RkHYLvP45s014DzEBB","large":"https://api.americanwhitewater.org/image/images/big/Ok7RkHYLvP45s014DzEBB"}},{"id":"Wx6RsccklVSmw7loiofyt","ext":"jpg","post_id":"aj3kuvjr67J1Zl3GhvbcI","description":"Only manmade hazard before MP 227","caption":"Barrier drop","poi_name":null,"subject":"","author":"Evan Christensen","poi_id":"112627","photo_date":"2025-02-15T18:24:44.000Z","updated_at":"2025-02-15T18:24:45.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/Wx6RsccklVSmw7loiofyt","large":"https://api.americanwhitewater.org/image/images/big/Wx6RsccklVSmw7loiofyt"}}],"detail":{"id":"1865","permitUrl":"","permitInfo":"","description":"The Price is generally a low water run with several manmade and natural hazards. The river is primarily roadside, although it is down considerably from the road, so hiking out would be a pain. Scouting can be done from the road for the most part; check for wood.  The majority of the river consists of rocky drops and small ledges. Most of these are in general straight forward in their lines. The major dangers on the Price are the possibilities of strainers, human debris (rebar), and some dams near the end of the run. The water can be gray or white from upstream runoff.\n\nThere is an initial rapid right below the putin, then some class II, with a scenic meander away from the road. After crossing under an underpass that puts you back along route 6 (although well below it), the pace picks up with fun drops that get busier as you go. The difficulty increases and stays in the IV range for several miles.  If its not scrapy-low then you will have a few miles of great rapids and drops. A big culvert is on the left a ways before the crux, although it can be missed, since there are a few miles that kinda look the same. There are not big eddies above the crux, so if you want to bank scout or portage, be sure you know where it is. To bank scout, around MP225 look for a turnout either upstream or downstream of the crux (MP 226), and walk a hundred yards to see it.\n\nFrom the putin it is about a 6.5 mile drive to mile post 227 for the takeout. This is about an 7.5 mile river float.\n\nThe bridge over the river at MP 227 is a good spot to takeout. There is a large turnout across the road for parking.\n\nIn 2024, I ran this section 4-5 times and did the takeout at MP 227. I saw one manmade hazard that could potentially be a problem. Scouted it the first time and never an issue after knowing how to proceed. The water heading into this hazard is slow with a big eddie and it marks the transistion into more challenging water. I will post a photo in the gallery. No other rebar or other manmade hazards seen.  This is a super fun and challenging section of Price River.  200 CFS on the Heiner gauge is the minimum and you will scrape some. CFS of 225 was my favorite (as a beginnger). 250 was good and definately more challenging.\n\nFebuary 13, 2025 update on paddling below MP 227. I walked the railroad tracks downstream of the takeout bridge at MP 227 inspecting the river bed of the rumored hazards such as rebar. I found a few hazards. Aprox .5 miles downstream of this takeout is a large boulder with a metal bar sticking out of it. Immeadiately after the river passes under the tracks (aprox .75 miles) there is a man-made barrier that will likely catch a lot of debris and potentially create a river wide strainer or a perfect narrow channel to boof a small drop. Aprox .25 miles below this is the diversion/drop/treatment structure along the river. There are some metal hazards in this spot, probably nothing that would give you any trouble however. I think the takeout bridge at MP 227 is perfect spot to end this float.","averageGradient":null,"maxGradient":null,"length":"7.5","correlations":[{"reachID":"1865","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"0","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"100000"},"gaugeInfo":{"name":"PRICE RIVER NEAR HEINER, UTAH","gaugeSource":"USGS","gaugeSourceIdentifier":"09313000","gaugeFetchStatus":"ARCHIVED","latestFlowReading":{"value":"37","dateTime":"2003-10-01T05:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":null,"location":{"latitude":"39.71885199","longitude":"-110.8659946"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/09313000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/09313000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"stale","latestReading":{"value":"37","dateTime":"2003-10-01T05:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["112627","euqrRkiNtjyMq8fDcFTnb","105760","117913"],"geometry":{"type":"LineString","coordinates":[[-110.944794,39.826325],[-110.9445,39.826237],[-110.944181,39.826035],[-110.943887,39.825629],[-110.943665,39.825274],[-110.943623,39.824808],[-110.943761,39.824306],[-110.944103,39.824107],[-110.944175,39.823305],[-110.943353,39.822374],[-110.941972,39.821457],[-110.941468,39.820811],[-110.941372,39.820179],[-110.939907,39.818617],[-110.938527,39.81834],[-110.937854,39.817883],[-110.937458,39.817441],[-110.93738,39.817021],[-110.937464,39.814836],[-110.937298,39.814265],[-110.936097,39.813168],[-110.934688,39.812686],[-110.934437,39.812448],[-110.934485,39.81209],[-110.934688,39.811539],[-110.934903,39.811415],[-110.935208,39.811503],[-110.935399,39.81176],[-110.935512,39.811902],[-110.936181,39.811971],[-110.936456,39.811934],[-110.936665,39.811805],[-110.937585,39.81215],[-110.938051,39.81215],[-110.938606,39.811883]