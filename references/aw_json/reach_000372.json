mericanwhitewater.org/image/images/medium/885294","large":"https://api.americanwhitewater.org/image/images/big/885294"}},{"id":"22","ext":"jpeg","post_id":"2413","description":"Photo courtesy of and copyright by <a href=\"http://www.allaboutrivers.com\"target=\"newlink\">www.allaboutrivers.com</a>.","caption":"Filter Plant","poi_name":"Mad Dog","subject":"Mad Dog Rapid at 3.5 feet","author":"Brad Goettemoeller (www.allaboutrivers.com)","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/22","large":"https://api.americanwhitewater.org/image/images/big/22"}},{"id":"884684","ext":"jpeg","post_id":"887398","description":"","caption":"","poi_name":null,"subject":null,"author":"Nathan Fey","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/884684","large":"https://api.americanwhitewater.org/image/images/big/884684"}},{"id":"10723","ext":"jpeg","post_id":"4978","description":"","caption":"Filter Plant Run","poi_name":"","subject":"Christine Eyestone","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10723","large":"https://api.americanwhitewater.org/image/images/big/10723"}},{"id":"40675","ext":"jpeg","post_id":"5601","description":"","caption":"Glade Reservoir Site","poi_name":"","subject":"Northern Integrated Supply Project","author":"NCWCD","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/40675","large":"https://api.americanwhitewater.org/image/images/big/40675"}},{"id":"885296","ext":"jpeg","post_id":"888000","description":"~3700cfs (5') 6/6/15","caption":"Cache La Poudre","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/885296","large":"https://api.americanwhitewater.org/image/images/big/885296"}}],"detail":{"id":"372","permitUrl":null,"permitInfo":null,"description":"This is the beginner run on the Poudre, named for the old Fort Collins water filtration plant at what is now Gateway Natural Area. There are only a few named rapids with swift moving water in between. In the low water season of late summer, this is a popular tubing destination. It's wider and shallower than the sections upstream, giving it a shorter boating season.\n\nFilter Plant sits between two diversion dams, making it hard to measure its flow. The Pineview Rock gauge is above the Northern Poudre Supply Canal diversion (upstream of the put-in), and the Canyon Mouth gauge (shown on this page) is below the Poudre Valley Canal diversion (downstream of the takeout). Hey, all river beta is guesswork anyway, right?\n\nSee *Colorado Rivers and Creeks II*, by Banks and Eckardt *(The Bible)*, for info on this and most of the other Colorado runs. See also: [Big South](http://www.americanwhitewater.org/content/River/view/river-detail/365/) (Class V/VI), [Joe Wright Creek](http://www.americanwhitewater.org/content/River/view/river-detail/2859/) (Class V), [Spencer Heights](http://www.americanwhitewater.org/content/River/view/river-detail/369/) (Class V/VI), [South Fork](http://www.americanwhitewater.org/content/River/view/river-detail/374/) (Class IV/V), [White Mile Run/Upper Rustic](http://www.americanwhitewater.org/content/River/view/river-detail/367/) (Class III), [Grandpa's Gorge/Lower Rustic](http://www.americanwhitewater.org/content/River/view/river-detail/368/) (Class III/IV), [The Narrows](http://www.americanwhitewater.org/content/River/view/river-detail/370/) (Class IV/V/V+), [Upper Mishawaka](http://www.americanwhitewater.org/content/River/view/river-detail/371/) (Class III/IV), [Lower Mishiwaka](http://www.americanwhitewater.org/content/River/view/river-detail/3368/) (Class III), [Poudre Park](http://www.americanwhitewater.org/content/River/view/river-detail/3369/) (Class IV), [Bridges](http://www.americanwhitewater.org/content/River/view/river-detail/3370/) (Class III/IV), [Upper North Fork](http://www.americanwhitewater.org/content/River/view/river-detail/373/) (Class IV/V), [Lower North Fork](http://www.americanwhitewater.org/content/River/view/river-detail/2822/) (Class II/III), and [Filter Plant](http://www.americanwhitewater.org/content/River/view/river-detail/372/) (Class III).","averageGradient":"44","maxGradient":null,"length":"3.2","correlations":[{"reachID":"372","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":"\t\tLow-boatable flow.\r\n\r\n\r\n","mediumRunnableRangeComment":"Moderate flow.","highRunnableRangeComment":"High-boatable flow.","aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"190","beginMediumRunnable":"700","beginHighRunnable":"1300","endHighRunnable":"2500"},"gaugeInfo":{"name":"CACHE LA POUDRE AT CANYON MOUTH NEAR FORT COLLINS","gaugeSource":"COLORADO_DEPARTMENT_OF_WATER_RESOURCES","gaugeSourceIdentifier":"CLAFTCCO","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"373","dateTime":"2026-05-11T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.68","dateTime":"2026-05-11T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"40.66451","longitude":"-105.224188"},"externalSourceLinks":null},"migrationErrorExplanation":null,"comment":"Gauge (1055 sq.mi.drainage) lies on this run, so will accurately portray flows.","status":{"status":"low-runnable","latestReading":{"value":"373","dateTime":"2026-05-11T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["WgRg5UVJv3a5MGs8Oegf3","107735","gt736wcYIqs6NSmntW0s7","DYs0cQTTixRCMO3FS85fr","9Nzs3x9iOkzXf3hQPJNAH","kH0CdUGPImUAwnupYhqh8","zwY73Mk4PK6nz57v3pEVK","fW9CRxLn8PNk8Cep4NCUG","112974","8ZvLn0cLfCpGA7oKciCow"],"geometr