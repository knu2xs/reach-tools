[{"result":{"data":{"json":{"id":"1631","stub":{"id":"1631","section":"2) Ligonier, PA to Above Kingston Dam","altname":"","river":"Loyalhanna Creek","difficulty":"ItoII","states":["USA-PEN"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"193","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Parking area next to Creek behind Giant Eagle on US 30.","id":"111006","location":{"latitude":"40.191387","longitude":"-79.255836"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"Take-out above Kingstown Dam, Kingstown, PA","id":"116272","location":{"latitude":"40.321945","longitude":"-79.381111"},"name":"Take Out","distance":"7.3","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"7183","ext":"jpeg","post_id":"6334","description":"Buttermilk Falls is the first and \"largest\" rapid on this section of river at this 3.3ft level. There is a boulder garden below Buttermilk that could present more challenge at extremely high flows.","caption":"Top of Buttermilk Falls","poi_name":"Buttermilk Falls","subject":"helmet-less 8-(  tandem canoers","author":"Jeff Macklin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/7183","large":"https://api.americanwhitewater.org/image/images/big/7183"}},{"id":"7184","ext":"jpeg","post_id":"6334","description":"Second ledge comes after the eddy catching practice in the \"boulder garden\". Jamie is running the tongue on river left.","caption":"Second ledge","poi_name":"Second Ledge","subject":"Jamie Burkitt","author":"Jeff Macklin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/7184","large":"https://api.americanwhitewater.org/image/images/big/7184"}},{"id":"7182","ext":"jpeg","post_id":"6334","description":"This section of river is a good place for novice whitewater training. Just upstream of the Darlington put-in bridge (behind Idlewild Amusement Park), there is moving \"flat water\" with relatively few obstructions,,, a good place to learn the basics of boat control. Downstream of this put-in bridge there are many places to practice on “light to moderate” eddy lines. The photo above is from a training run conducted by Three Rivers Paddling Club (based in Pittsburgh Pa).","caption":"Practicing On Eddy Lines","poi_name":"","subject":"Liz Jacobs","author":"Jeff Macklin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/7182","large":"https://api.americanwhitewater.org/image/images/big/7182"}}],"detail":{"id":"1631","permitUrl":null,"permitInfo":null,"description":"Lat / Longitude data are _very_ approximate.\n\n3.55 miles from Put-in to Darlington Inn.  3.72 miles from Darlington Inn to above Kingstown Dam\n\nZachary Frederick shared:\n\nStart near the Darlington Inn, below Idlewild Park. Portage the causeway near Sleepy Hollow Tavern. Takeout before Kingston Dam. If you don't waste any time, this run should take about 1.5 hours.\n\nThere are 2 ledges/wateralls not long after you put-in (Buttermilk Falls?). Various other small rapids throughout. Not too much flatwater.","averageGradient":null,"maxGradient":null,"length":"7.3","correlations":[{"reachID":"1631","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"400","beginMediumRunnable":"500","beginHighRunnable":"2500","endHighRunnable":"5000"},"gaugeInfo":{"name":"Loyalhanna Creek at Kingston, PA","gaugeSource":"USGS","gaugeSourceIdentifier":"03045