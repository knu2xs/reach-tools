[{"result":{"data":{"json":{"id":"706","stub":{"id":"706","section":"US Rte 29 (Burnt Mills)  to Riggs Road (Adelphi Mill)","altname":"","river":"Anacostia, Northwest Branch","difficulty":"ItoIVstandoutVplus","states":["USA-MRY"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"5","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"A 20 ft. high dam that is surprisingly easy to run. A little lip\nkicks you out at the bottom and keeps you from pitoning and instead you ski out\nover the pool. Amazing fun!","id":"107170","location":{"latitude":"0","longitude":"0"},"name":"Burnt Mills Dam","distance":"0","photoID":"891292","difficulty":"III","approximate":false},{"type":"takeout","description":"Easy take out in the park by the playground. If you continue\non, the reported dam at Ager Rd. seems to be gone but nonetheless keep an eye\nout.","id":"107176","location":{"latitude":"0","longitude":"0"},"name":"Adelphi Mill","distance":"3.5","photoID":"0","difficulty":"N/A","approximate":true}],"alerts":[],"photos":[{"id":"17875","ext":"jpeg","post_id":"9573","description":"","caption":"","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17875","large":"https://api.americanwhitewater.org/image/images/big/17875"}},{"id":"17869","ext":"jpeg","post_id":"9573","description":"dropo after the crux. (the water couldve been a little higher for this)","caption":"","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17869","large":"https://api.americanwhitewater.org/image/images/big/17869"}},{"id":"17876","ext":"jpeg","post_id":"9574","description":"Running one of the drops below the route 29 or colesville road bridge. More water is needed. way too low","caption":"Low Flow","poi_name":"","subject":"George Brewer","author":"John Brewer","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17876","large":"https://api.americanwhitewater.org/image/images/big/17876"}},{"id":"891299","ext":"jpg","post_id":"895198","description":null,"caption":"Use the corner to avoid the hole.","poi_name":null,"subject":null,"author":"Beginning of Crusher","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891299","large":"https://api.americanwhitewater.org/image/images/big/891299"}},{"id":"891302","ext":"jpg","post_id":"895201","description":null,"caption":" on Anacostia, Northwest Branch @US Rte 29 (Burnt Mills)  to Riggs Road (Adelph","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891302","large":"https://api.americanwhitewater.org/image/images/big/891302"}},{"id":"891327","ext":"jpg","post_id":"895226","description":null,"caption":"Crusher junior","poi_name":null,"subject":null,"author":"About 200 cfs","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891327","large":"https://api.americanwhitewater.org/image/images/big/891327"}},{"id":"17868","ext":"jpeg","post_id":"9573","description":"Best if run to the left or about where I am. The lip at the bottom kicks you out. I ran this three times. ","caption":"Colesville Road dam","poi_name":"Colesville Road Dam","subject":"George","author":"Mike","poi_id":"107172","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17868","large":"https://api.americanwhitewater.org/image/images/big/17868"}},{"id":"17877","ext":"gif","post_id":"9574","description":"fun. im coming back when the waters higher. ","caption":"Running one of the drops","poi_name":"unknown","subject":"George Brewer","author":"John Brewer","poi_id":"107171","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17877","large":"https://api.americanwhitewater.org/image/images/big/17877"}},{"id":"891292","ext":"jpg","post_id":"895191","description":null,"caption":null,"poi_name":"Burnt Mills Dam","subject":null,"author":null,"poi_id":"107170","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891292","large":"https://api.americanwhitewater.org/image/images/big/891292"}},{"id":"891295","ext":"jpg","post_id":"895194","description":null,"caption":null,"poi_name":"Teddy's After Party","subject":null,"author":null,"poi_id":"107173","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891295","large":"https://api.americanwhitewater.org/image/images/big/891295"}},{"id":"891297","ext":"jpg","post_id":"895196","description":null,"caption":"Unknown","poi_name":"Colesville Crusher","subject":null,"author":"Unknown","poi_id":"107174","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891297","large":"https://api.americanwhitewater.org/image/images/big/891297"}},{"id":"891326","ext":"jpg","post_id":"895225","description":null,"caption":null,"poi_name":"Countdown","subject":null,"author":null,"poi_id":"107171","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891326","large":"https://api.americanwhitewater.org/image/images/big/891326"}}],"detail":{"id":"706","permitUrl":null,"permitInfo":null,"description":"This description is for the section from Burnt Mills to Adelphi Mill. The first, short section is III-IV (V+) and then there are 3miles of I-II (III).  Many paddlers just do laps on some/all of the first few rapids. The creek can also be run belowand above this section; both parts are class I. See [Ettinger’sguide book](https://www.amazon.com/Capital-Canoeing-Kayaking-Whitewater-Washington/dp/1478317752/) for more details.\n\nAlso note that Montgomery County Parks has rules against paddling any of its waterways without permits and there is no system for getting permits. Park police have been seen at the put-in and have, on occasion, prevented paddlers from putting on. So this description is for reference only.\n\nThe main gauge is the Colesville gauge which is a few miles upstream so keep that in mind when watching realtime flow data. The non-USGS gauge at Adelphi Mill was at the take-out but seems to be offline. The introrapids (the dam to Crusher junior) are runnable from about 50 cfs but most paddlers will want at least around 80 cfs. It's said that the Crusher (V+) is best at atleast 200 cfs. Below that, there are too many F-U rocks and exposed sieves.  High flows is obviously a judgement call for those capable of running V+. Most paddlers would probably want at least 200 cfs for the run down after After Party.","averageGradient":"25","maxGradient":null,"length":"3.6","correlations":[{"reachID":"706","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":"IVstandoutVplus","beginLowRunnable":"50.5","beginMediumRunnable":"200","beginHighRunnable":"500","endHighRunnable":"5000"},"gaugeInfo":{"name":"Northwest Branch Anacostia River nr Colesville, MD","gaugeSource":"USGS","gaugeSourceIdentifier":"01650500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"5","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.49","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"39.06552778","longitude"