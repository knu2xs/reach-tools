es/big/891987"}},{"id":"891988","ext":"jpg","post_id":"895888","description":null,"caption":"Paul Hubbard","poi_name":"Sheit Bird Alley","subject":null,"author":"Bett Adams","poi_id":"1694","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891988","large":"https://api.americanwhitewater.org/image/images/big/891988"}},{"id":"891989","ext":"jpg","post_id":"895889","description":null,"caption":"Paul Hubbard","poi_name":"Road Construction","subject":null,"author":"Bett Adams","poi_id":"1690","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891989","large":"https://api.americanwhitewater.org/image/images/big/891989"}}],"detail":{"id":"1789","permitUrl":null,"permitInfo":null,"description":"This run was pioneered by Ron Stewart.\n\nSuck gets run fairly frequently by those who possess the appropriate skills. It's not a run to be taken lightly. A boater pinned and died here in Feb. 1987. 'http://www.americanwhitewater.org/content/Accident/detail/id/41/'>See this account in the Accident Database for more info.\n\nThe river bed changes more often than Madonna changes her image.\n\nSieves, Concrete, Road Blast, Metal Debris and Logs are common hazards on this run.\n\nPlease Scout and proceed cautiously after every big rain.\n\nSee description of South Suck for information about the steeper upper section first pioneered by Clay Wright.\n\nThis run is pool/ drop yet it has a continuous feel to it.","averageGradient":"250","maxGradient":"295","length":"2","correlations":[],"pointOfInterestIDs":["112470","8201","1689","1690","8202","1691","1492","1693","1694","8198","1695","1696","8199","8200","117755"],"geometry":null,"bannerPhotoID":"7867","editedAt":"2024-04-12T04:17:19.000Z"},"updatedAt":1778556659},"meta":{"values":{"pointOfInterests.0.location.latitude":[["custom","decimal.js"]],"pointOfInterests.0.location.longitude":[["custom","decimal.js"]],"pointOfInterest