[{"result":{"data":{"json":{"id":"1700","stub":{"id":"1700","section":"4 - Lake Murray Dam to Broad/Congaree confluence","altname":"Saluda Shoals County Park to Senate Street Boat ramp off US #1","river":"Saluda","difficulty":"ItoIIIplusstandoutIV","states":["USA-SCR"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"780","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Upper run put-in. Saluda Shoals is on river left, Hope Ferry is on the South side of the river, river right.","id":"1013","location":{"latitude":"34.04563","longitude":"-81.191373"},"name":"Hope Ferry Landing / Saluda Shoals Regional Park","distance":"0","photoID":null,"difficulty":null,"approximate":false},{"type":"put-in","description":"Public Put In","id":"1014","location":{"latitude":"34.043568","longitude":"-81.163571"},"name":"Gardendale (Dominion Evergy) Put-In","distance":"1.7","photoID":null,"difficulty":null,"approximate":false},{"type":"rapid","description":"","id":"1016","location":{"latitude":"34.010563","longitude":"-81.081092"},"name":"Ocean Boulevard Rapids","distance":"7.39","difficulty":"II","approximate":false,"photoID":null},{"type":"rapid","description":"","id":"1015","location":{"latitude":"34.01054","longitude":"-81.08106"},"name":"Oh Brother Rapids","distance":"7.43","difficulty":"I+","approximate":false,"photoID":null},{"type":"rapid","description":"Creekline is the far river right rapid across from Millrace. It is only runnable over 4k CFS, and has a shallow hole at lower levels. There are two slots on either side of a brick column, each with a small slide/ledge drop. At levels above 12,000, the right slot becomes gnarly and the hole on the left slot becomes pretty retentive, so skirt to the left corner of it or boof hard. There is often wood downstream of the slides so keep on the lookout in case of a swim at one of the holes","id":"ts2Q7T8thV0JB9pOFIrth","location":{"latitude":"34.010465","longitude":"-81.080951"},"name":"Creekline","distance":"7.44","difficulty":"IV-","approximate":false,"photoID":null},{"type":"hazard","description":"When the water is above about 800 cfs it's a class III (technical). The water can be as high as 20,000 cfs. At that point, it's a monster and I'd seriously think twice about running it. It's easily a class IV. The problem with millrace is that it's an old dam that was dynamited years back and is rumored to have rebar (steel rods that reinforced the concrete) all through the area.\n\nLines here are very much open to your discretion, not a whole lot of consequence and very easy to practice eddy hopping at normal levels. Anything center right all the way to river left is usally ok.\n\nMillrace is often park and hucked, using the riverwalk on the river left side at the bottom of the rapid.","id":"1018","location":{"latitude":"34.011767","longitude":"-81.080707"},"name":"Mill Race Rapids","distance":"7.45","photoID":"xli4MnjHoJe0jyMWCEj0N","difficulty":"III","approximate":false},{"type":"rapid","description":"Take the right fork. Run the rapid on river right. A straight shot, with a decent hole and a side surfing wave at some levels.","id":"1020","location":{"latitude":"34.009336","longitude":"-81.077532"},"name":"Shandon Rapids","distance":"7.71","difficulty":"II","approximate":false,"photoID":null},{"type":"playspot","description":"Awesome surf ledge just above Mill Race.","id":"1024","location":{"latitude":"34.009343","longitude":"-81.077521"},"name":"Blast o'matic","distance":"7.71","difficulty":"III-","approximate":false,"photoID":null},{"type":"playspot","description":"Moderate sized riverwide ledge. Good holes at some levels, good waves at higher levels.","id":"1017","location":{"latitude":"34.009304","longitude":"-81.077515"},"name":"Stacy's Ledge","distance":"7.71","difficulty":"II+","approximate":false,"photoID":"jeWXyC2yQRCTfFyrgsfaG"},{"type":"rapid","description":"A riverwide shoal type rapid with lots of playable waves and holes. Run just left of the rocks in the middle of the river.","id":"1021","location":{"latitude":"34.00935","longitude":"-81.077642"},"name":"White House Rapids","distance":"7.71","difficulty":"II+","approximate":false,"photoID":null},{"type":"playspot","description":"Good down to 300 cfs. Munchy from 2500-3500 cfs. Optimal at 4000-4500 cfs, above that it turns into a wave and then quickly washes out.","id":"1019","location":{"latitude":"34.009349","longitude":"-81.077528"},"name":"Pop Up Hole/Mosh Pit","distance":"8","difficulty":"II+","approximate":false,"photoID":"3236"},{"type":"takeout","description":"Standard Take Out","id":"SCfiU3xLCtTUIktC3tMuu","location":{"latitude":"33.994742","longitude":"-81.0531"},"name":"West Columbia Amphitheater Take Out","distance":"8.55","photoID":null,"difficulty":"N/A","approximate":false},{"type":"access","description":"Below Gervais Street Bridge. Off of Gist Street Downtown Columbia, SC.","id":"1023","location":{"latitude":"33.995781","longitude":"-81.048028"},"name":"Senate Street Landing","distance":"8.55","photoID":"1GDWoQB4af6pLPcSdLajd","difficulty":"N/A","approximate":false},{"type":"rapid","description":null,"id":"1022","location":{"latitude":"0","longitude":"0"},"name":"Hampton Street Rapids","distance":"10","difficulty":"II","approximate":false,"photoID":null}],"alerts":[],"photos":[{"id":"723664","ext":"jpeg","post_id":"723653","description":":)","caption":"Fast!","poi_name":"Gervais St Wave","subject":"Matthew Cooper","author":"Anthony Bell","poi_id":"1014","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/723664","large":"https://api.americanwhitewater.org/image/images/big/723664"}},{"id":"3236","ext":"jpeg","post_id":"5253","description":"","caption":"The Loop","poi_name":"The Mosh Pit","subject":"Jeff Wilson","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"http