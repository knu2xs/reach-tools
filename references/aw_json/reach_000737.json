[{"result":{"data":{"json":{"id":"737","stub":{"id":"737","section":"Brangels Rd./Arrington Rd. to Marriottsville Rd.","altname":"","river":"Piney Run (Patapsco trib.)","difficulty":"ItoIIIstandoutIV","states":["USA-MRY"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"8","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Put In - Brangels Rd.","id":"112307","location":{"latitude":"39.374595","longitude":"-76.93131"},"name":"Put In - Brangels Rd.","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"put-in","description":"Put-in - Arrington Rd","id":"GOLpAUyM4Tv6LpCgp0hFp","location":{"latitude":"39.366276","longitude":"-76.911584"},"name":"Put-in - Arrington Rd","distance":"1.85","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"Take Out - Marriottsville Rd.","id":"117589","location":{"latitude":"39.353381","longitude":"-76.897306"},"name":"Take Out - Marriottsville Rd.","distance":"3.11","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"887386","ext":"jpeg","post_id":"890121","description":"The main drop of Piney run is a 2' drop that requires a left boof stroke. You won't piton if you don't make your stroke but you land better if you do. Right after the drop you can stay far left or cut hard right between two more rocks and continue down. Lots of rocks to avoid broaching on. This is a fun micro creek best run after a big rain with the gauge reading at least 90 cfs and rising. Below 90 cfs is serious boat abuse. Over 200 cfs becomes more padded and pushy. Only micro eddies available. Parking is available at Arrington road and Marriottsville Rd. 2 or roadside on river left just below the main drop. You can easily park and run this several times.  https://www.youtube.com/watch?v=PKDtQHg6hiM ","caption":"Main drop on Piney run Below Arrington Rd.","poi_name":"","subject":"","author":"Andrew Froom","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887386","large":"https://api.americanwhitewater.org/image/images/big/887386"}},{"id":"891013","ext":"jpg","post_id":"894932","description":null,"caption":" on Piney Run @Arrington Road to Marriottsville","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891013","large":"https://api.americanwhitewater.org/image/images/big/891013"}},{"id":"891015","ext":"jpg","post_id":"894934","description":null,"caption":"Andrew Froom","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891015","large":"https://api.americanwhitewater.org/image/images/big/891015"}},{"id":"14576","ext":"jpeg","post_id":"4238","description":"","caption":"Dan running the Piney","poi_name":"Z Drag","subject":"Dan Anderson","author":"John Pramik","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/14576","large":"https://api.americanwhitewater.org/image/images/big/14576"}},{"id":"14575","ext":"jpeg","post_id":"4238","description":"Rained 1.05 inches the night before","caption":"Before work paddling","poi_name":"Z Drag","subject":"John Pramik","author":"Dan Anderson","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/14575","large":"https://api.americanwhitewater.org/image/images/big/14575"}}],"detail":{"id":"737","permitUrl":null,"permitInfo":null,"description":"This is, without doubt, the hardest run in the Patapsco basin. Suddenly, as Piney Run crosses Arrington Road and begins to follow Marriottsville Road No. 2, with just a mile and a third left to its life, it becomes a whitewater terror, dropping 60 feet in a third of a mile. Scout this section carefully from alongside the road before putting on, looking especially at the first quarter mile, down to the second gravel parking area. It accelerates quickly from class II to class II+, and then has a short class III drop followed by a complex class IV+ (probably best entered through the second chute from the left, and finished on the far left, but I have not seen anyone run it). Many paddlers will want to eddy out on the left above the main drop, for a brief portage, or even to skip the class III just above (as we did) to be on the safe side.\n\nAfter the big drop come several more class III rapids in quick succession. The second of these is very tricky on the right side (down to the drop right next to the huge boulder on the bank), but may not have enough water to run the left side. Then the gradient eases up, to class II+, II and then I. There tend to be strainers above the confluence with the South Branch, by the intersection of Marriottsville Road and Marriottsville Road No. 2, so you might want to take out alongside the road higher up.","averageGradient":"70","maxGradient":"200","length":"3.1","correlations":[{"reachID":"737","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"50","beginMediumRunnable":"90","beginHighRunnable":"200","endHighRunnable":"300"},"gaugeInfo":{"name":"BEAVER RUN NEAR FINKSBURG, MD","gaugeSource":"USGS","gaugeSourceIdentifier":"01586210","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"8","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"0.52","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"39.48944444","longitude":"-76.90294444"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/01586210","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/01586210/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"8","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["112307","GOLpAUyM4Tv6LpCgp0hFp","117589"],"geometry":{"type":"LineString","coordinates":[[-76.93131,39.374595],[-76.931211,39.374585],[-76.930942,39.374513],[-76.930765,39.374392],[-76.930638,39.374239],[-76.930496,39.37414],[-76.930128,39.373964],[-76.929959,39.37381],[-76.929845,39.373646],[-76.929782,39.373525],[-76.929761,39.37336],[-76.929775,39.373283],[-76.929916,39.373168],[-76.929923,39.373091],[-76.929853,39.372987],[-76.929626,39.372833],[-76.929569,39.37269],[-76.92952,39.372394],[-76.929598,39.372273],[-76.929626,39.372163],[-76.929619,39.372086],[-76.929492,39.371866],[-76.929499,39.37179],[-76.929456,39.371718],[-76.929449,39.371581],[-76.929485,39.371389],[-76.929485,39.371114],[-76.929308,39.370724],[-76.929159,39.370538],[-76.928968,39.370175],[-76.928876,39.370076],[-76.928721,39.369977],[-76.928544,39.36995],[-76.928388,39.369961],[-76.928056,39.370109],[-76.927688,39.370192],[-76.927532,39.370246],[-76.927433,39.37029],[-76.927221,39.370439],[-76.927129,39.370483],[-76.926924,39.370494],[-76.926796,39.370466],[-76.926499,39.370301],[-76.926414,39.370224],[-76.926344,39.370093],[-76.9264,39.369846],[-76.926584,39.369599],[-76.926627,39.369505],[-76.926584,39.369401],[-76.926414,39.369297],[-76.926337,39.36928],[-76.925976,39.369324],[-76.925813,39.36928],[-76.925664,39.369165],[-76.925601,39.369049],[-76.925523,39.368967],[-76.925353,39.368863],[-76.925219,39.368813],[-76.925063,39.368802],[-76.924766,39.368731],[-76.924617,39.3686