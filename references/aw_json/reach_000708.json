[{"result":{"data":{"json":{"id":"708","stub":{"id":"708","section":"U.S. 219 to Youghiogheny River at Friendsville","altname":"","river":"Bear Creek","difficulty":"IV","states":["USA-MRY"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"40","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"110337","location":{"latitude":"39.657","longitude":"-79.3403"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"115600","location":{"latitude":"39.667","longitude":"-79.4034"},"name":"Take Out","distance":"7","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"101250219","title":null,"post_date":"2013-05-13 04:00:00+00","detail":"Paddled Bear on 5/11/13...level of about 500-525cfs. Putting in at the church, there were no required portages, but, we did have to bounce over one river-wide log about 2-300yds down from the put-in. A few inches less water and you'd have to portage it. There were also several branches all over early on in the run, though, it was largely clear of wood after the South Branch comes in.\n\nSounds like putting in above the church requires multiple portages, and I imagine any future high water events will shift some wood around, so, keep your eyes open","user":{"name":"CHRIS PREPERATO"}}],"photos":[{"id":"41633","ext":"jpeg","post_id":"9576","description":"This photo gives you a general idea of how wide the creek is in the upper half.  Its a great run, I have done it as high as 1,800.  Over 1,000 I recommend a very solid class V crew even though its still a class IV run.  Very continuous and swims could be henously long.","caption":"Bear Creek low water","poi_name":"Dry","subject":"Bear Creek Dry","author":"USGS","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/41633","large":"https://api.americanwhitewater.org/image/images/big/41633"}},{"id":"874591","ext":"jpeg","post_id":"874592","description":"The first larger class IV on the run. level was around 500 cfs","caption":"Sean on Bear ","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/874591","large":"https://api.americanwhitewater.org/image/images/big/874591"}},{"id":"874605","ext":"jpeg","post_id":"874606","description":"some boogie water, level was around 500 cfs","caption":"Mark Z. on Bear","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/874605","large":"https://api.americanwhitewater.org/image/images/big/874605"}},{"id":"17831","ext":"jpeg","post_id":"9546","description":"","caption":"John sliding down Bear Creek","poi_name":"","subject":"John G","author":"Art Barket","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17831","large":"https://api.americanwhitewater.org/image/images/big/17831"}},{"id":"41648","ext":"jpeg","post_id":"9577","description":"See You on the River","caption":"41648.jpeg","poi_name":"Accident-Friendsville Bridge","subject":"View downstream of Bear Creek from Accident Friendsville Bridge","author":"Mark Zakutansky","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/41648","large":"https://api.americanwhitewater.org/image/images/big/41648"}},{"id":"41647","ext":"jpeg","post_id":"9577","description":"The view looking up Bear Creek.  We ran Bear at this level and had a great time.  The upper half above where the photo was taken was a bit sketchy with wood but mostly good to go.  I recommend around 1,000 cfs for a first time.","caption":"View Upstream from the Accident-Friendsville Bridge","poi_name":"","subject":"View upstream of Bear Creek from Accident Friendsville Bridge","author":"Mark Zakutansky","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/41647","large":"https://api.americanwhitewater.org/image/images/big/41647"}}],"detail":{"id":"708","permitUrl":"","permitInfo":"","description":"A quality trout stream which usually only runs when the Upper Yough is over 3 feet. The meat of the run is from Freedom Chapel downtream to Friendsville. It includes a few slides and boulder drops mixed into continuous boogie water, with a 1/4 mile long wave train in the artificially narrowed banks in town. Wood tends to form log jams between Route 219 and the Chapel, and with each high water event some of these strainers move downstream, so be on guard for new wood. Also be aware, at levels over 1200cfs the low metal bridge (above the horshoe curve in the road) becomes a portage due to low clearance.\n\n**Directions:** follow Bear Creek road out of Friendsville. One good putin is at a roadside pulloff just upstream of a horseshoe curve in the road, past a small metal bridge, but there are other pulloffs along the road, mainly used for fishing access. The takeout is at the confluence with the Yough, at the park in Friendsville.\n\nEd Evangelidi testifies:\n\nFirst half of the run has easier whitewater (Class III) but often has more wood in the stream. With more water, the south branch is also runnable.","averageGradient":"84","maxGradient":"100","length":"4.8","correlations":[{"reachID":"708","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":"Gets very pushy at 1000 cfs. Few Eddies.","aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"240","beginMediumRunnable":"295","beginHighRunnable":"1000","endHighRunnable":"2000"},"gaugeInfo":{"name":"BEAR CREEK AT FRIENDSVILLE, MD","gaugeSource":"USGS","gaugeSourceIdentifier":"03076600","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"40","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.7","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"39.65613889","longitude":"-79.39411111"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/03076600","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/03076600/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":" ","status":{"status":"below-recommended","latestReading":{"value":"40","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["110337","115600"],"geometry":{"type":"LineString","coordinates":[[-79.34027749,39.65685458],[-79.34043499,39.65683021],[-79.34075479,39.65676721],[-79.34103199,39.65666301],[-79.34105332,39.65665427],[-79.34114512,39.65656101],[-79.34118072,39.65647601],[-79.34121632,39.65629627],[-79.34130152,39.65614427],[-79.34145052,39.65603841],[-79.34153559,39.65601247],[-79.34219692,39.65602201],[-79.34279332,39.65599901],[-79.34300659,39.65600647],[-79.34302792,39.65599781],[-79.34392312,39.65606461],[-79.34428572,39.65607427],[-79.34441312,39.65607607],[-79.34538612,39.65602687],[-79.34574872,39.65603661],[-79.34598359,39.65605341],[-79.34600452,39.65606267],[-79.34606132,39.65606347],[-79.34622472,39.65608387],[-79.34649452,39.65613727],[-79.34672212,39.65618561],[-79.34676452,39.65620867],[-79.34712019,39.65629027],[-79.34747552,39.65642147],[-79.34771012,39.65654647],[-79.34796532,39.65671681],[-79.34807972,39.65677687],[-79.34832079,39.65687047],[-79.34858359,39.65694181],[-79.34868379,39.65695667],[-79.34885412,39.65696361],[-79.34903859,39.65