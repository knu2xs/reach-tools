[{"result":{"data":{"json":{"id":"1889","stub":{"id":"1889","section":"1. Bath County Pumped Storage Facility (Rt. 600) to Mountain Grove (Rt. 39)","altname":"","river":"Back Creek (Jackson trib)","difficulty":"II","states":["USA-VRG"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"75","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Put in just below the culverts on the Rt. 600 bridge.","id":"112747","location":{"latitude":"38.192234","longitude":"-79.811794"},"name":"Put In","distance":"0","photoID":"880620","difficulty":"N/A","approximate":false},{"type":"takeout","description":"Upper Back Creek can be run from the bridge with culverts off of Rt. 600, about 6 miles above the Hwy. 39 turnoff, down to the confluence with Little Back Creek with potential parking at the Mountain Grove Community Center on Hwy. 39.","id":"102222","location":{"latitude":"38.097364","longitude":"-79.886509"},"name":"Take Out - Little Back Creek Confluence","distance":"8.82","photoID":"0","difficulty":"N/A","approximate":true}],"alerts":[],"photos":[{"id":"880620","ext":"jpeg","post_id":"881827","description":"This bridge with culverts makes a good put-in and is about 6 miles upstream from Hwy. 39.","caption":"Upper Back Creek (above Hwy. 39)","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880620","large":"https://api.americanwhitewater.org/image/images/big/880620"}},{"id":"880622","ext":"jpeg","post_id":"881829","description":"Level was 4.9/1200 cfs at Mountain Grove","caption":"Upper Back Creek (above Hwy. 39)","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880622","large":"https://api.americanwhitewater.org/image/images/