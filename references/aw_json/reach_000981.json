[{"result":{"data":{"json":{"id":"981","stub":{"id":"981","section":"2. Monarch to Riceville","altname":"","river":"Belt Creek","difficulty":"IItoIII","states":["USA-MNT"]},"primaryGaugeStatus":{"status":"low-runnable","latestReading":{"value":"265","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"There is a small unmarked parking area where 4-8 cars can squeeze in. The put in is on the tiny Dry Fork and then paddlers enter Belt Creek in 50 feet or so. Be respectful of the very-close neighbors.","id":"108328","location":{"latitude":"47.096156","longitude":"-110.836379"},"name":"Put In","distance":"0.09","photoID":null,"difficulty":"N/A","approximate":false},{"type":"put-in","description":"Alternate Put In","id":"dY2QgB1ZmhHXzPJQZqYDB","location":{"latitude":"47.13565","longitude":"-110.943282"},"name":"Logging Creek Mid-Point Access","distance":"8.33","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"113568","location":{"latitude":"47.211899","longitude":"-110.933296"},"name":"Take Out","distance":"14","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"Dr0yqANclCLuzUZ42VdgO","title":"Belt Creek Alert","post_date":"2026-05-02 18:06:43+00","detail":"","user":{"name":"Dan Sandberg"}},{"id":"ha5GrbgR7nIlxLZw5yv0G","title":"Rebar at Loggers Cr bridge","post_date":"2024-06-30 15:08:58+00","detail":"At the bridge at Logger's Creek (approx 7 miles into float) the right side of the bridge has a large concrete block with rebar sticking out. Tore the bottom of a packraft out and nearly our friend's leg at 300cfs. Recommend left side of the pier for any floaters at low water.\n\nOther hazards may include woody debris. Large snowstorm and wind event tore down lots of trees in this area this spring, currently most are passable but there is a lot more woody debris in the river than average.","user":{"name":"Daniel Armstrong"}},{"id":"101246874","title":null,"post_date":"2010-05-16 04:00:00+00","detail":"May 16, 2010- Monarch to Logging creek bridge was clear (except for fence and one strainer) Below logging creek encountered numerous green trees sheared by last weeks storm, many of these bound to end up in the water downstream. Approximately 1/4 way down from the start of the \"box\"\nencountered one passable log jam and another which was impassable after the 2nd entrance rapid. Scouting revealed at LEAST one more complete jam. Due to rising levels, many new greens will make their way down to current jams and clearing these could be difficult.","user":{"name":"Dustin Prinzing"}},{"id":"100846725","title":null,"post_date":"2009-05-25 04:00:00+00","detail":"Had a friend who was planning on floating Belt Creek this past weekend but they heard that it is currently not runnable due to two log-jams.","user":null}],"photos":[{"id":"874659","ext":"jpeg","post_id":"874660","description":"Sluice box","caption":"","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/874659","large":"https://api.americanwhitewater.org/image/images/big/874659"}},{"id":"883173","ext":"jpeg","post_id":"885882","description":"","caption":"Big Sandstone wall","poi_name":null,"subject":null,"author":"D. Amman","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/883173","large":"https://api.americanwhitewater.org/image/images/big/883173"}},{"id":"883174","ext":"jpeg","post_id":"885883","description":"","caption":"Bob droppin'","poi_name":null,"subject":null,"author":"D. Amman","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/883174","large":"https://api.americanwhitewater.org/image/images/big/883174"}},{"id":"41128","ext":"jpeg","post_id":"10002","descr