[{"result":{"data":{"json":{"id":"1357","stub":{"id":"1357","section":"2. Oakland Valley to US Route 209","altname":"","river":"Neversink","difficulty":"IItoIII","states":["USA-NYO"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"630","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"109233","location":{"latitude":"41.5046","longitude":"-74.6475"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"114471","location":{"latitude":"41.4586","longitude":"-74.6032"},"name":"Take Out","distance":"5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"1357","permitUrl":"","permitInfo":"","description":"Neversink Gorge light. This stretch starts where the gorge section ends, and is mostly easy class 1 to 2, but has a couple of short spots that will probably be class 3, but very straightforward. The first half is alongside the road, but there's generally not much traffic. The second half is away from the road and mosty undeveloped.\n\nJust downstream from the takeout the Neversink meets the Bashakill, which drains a very large wetland. This means that as levels drop the gauge reading  may reflect the water draining the wetland more than this stretch of the Neversink. The minimum is probably around 1200 cfs at Godeffroy, but 1500 and up is probably better. At high water you can expect to find some big water class 3.\n\nThe take out is immediately upstream of the route 209 bridge (be sure to leave room around the white pipe at the back of the lot; it's for filling fire department trucks), or about 1/4 mile upstream at the Neversink Valley Museum on Hoag Rd.\n\nThis Google Map shows the useful locations: [http://tinyurl.com/neversink-gorge](http://tinyurl.com/neversink-gorge)\n\n**Downstate New York Area Reaches**\n\n[Beer Kill](https://www.americanwhitewater.org/content/River/detail/id/394/) [Beer Kill, W. Branch](https://www.americanwhitewater.org/content/River/detail/id/1250/)\n\n[Callicoon Creek, E. Branch](https://www.americanwhitewater.org/content/River/detail/id/1267/) [Callicoon Creek, N. Branch](https://www.americanwhitewater.org/content/River/detail/id/1268/)\n\n[Coxing Kill](https://www.americanwhitewater.org/content/River/detail/id/4100/)[Croton](https://www.americanwhitewater.org/content/River/detail/id/5015/)\n\n[Delaware (1.)](https://www.americanwhitewater.org/content/River/detail/id/1291/) [Delaware (2. Mongaup Wave)](https://www.americanwhitewater.org/content/River/detail/id/3797/)\n\n[Delaware (3.)](https://www.americanwhitewater.org/content/River/detail/id/1291/) [Fishkill Creek](https://www.americanwhitewater.org/content/River/detail/id/4168/)\n\n[Mombaccus Creek](https://www.americanwhitewater.org/content/River/detail/id/4302/)[Mongaup](https://www.americanwhitewater.org/content/River/detail/id/1349/)\n\n[Moodna Creek](https://www.americanwhitewater.org/content/River/detail/id/1350/) [Neversink (1.)](https://www.americanwhitewater.org/content/River/detail/id/1356/)\n\n[Neversink (2.)](https://www.americanwhitewater.org/content/River/detail/id/1357/) [Neversink, E. Branch](https://www.americanwhitewater.org/content/River/detail/id/1358/)\n\n[Peters Kill](https://www.americanwhitewater.org/content/River/detail/id/4304/) [Pocantico](https://www.americanwhitewater.org/content/River/detail/id/5060/)\n\n[Popolopen Brook](https://www.americanwhitewater.org/content/River/detail/id/3830/) [Ramapo](https://www.americanwhitewater.org/content/River/detail/id/1384/)\n\n[Rochester Creek](https://www.americanwhitewater.org/content/River/detail/id/1390/) [Rondout Creek (1.)](https://www.americanwhitewater.org/content/River/detail/id/1394/)\n\n[Rondout Creek (2.)](https://www.americanwhitewater.org/content/River/detail/id/1395/) [Rondout Creek (3.)](https://www.americanwhitewater.org/content/River/detail/id/1396/)\n\n[Sandburg Creek](https://www.americanwhitewater.org/content/River/detail/id/1408/) [Stony Brook (1.)](https://www.americanwhitewater.org/content/River/detail/id/5139/)\n\n[Stony Brook (2.)](https://www.americanwhitewater.org/content/River/detail/id/5677/)[Wallkill](https://www.americanwhitewater.org/content/River/detail/id/1451/)\n\n[Wappinger Creek](https://www.americanwhitewater.org/content/River/detail/id/1452/)\n\n**[Google Map of New York Whitewater](https://www.google.com/maps/d/edit?mid=zjdnDE8H0TLg.kJnMWGapL4xk)**\n\n**[New York Whitewater Paddlers Facebook Group](https://www.facebook.com/groups/108070075877312/)**","averageGradient":null,"maxGradient":null,"length":"4.5","correlations":[{"reachID":"1357","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":"Steve McLuckie says: \"The minimum is probably around 1200 or so at Godeffroy, but I'd want at least 1500.\"","mediumRunnableRangeComment":"Steve McLuckie says: \"At (1990) this was mostly class 2, but some of the wave trains were fairly big and pushy.\" Upper limit for the \"Medium\" range is a rough ","highRunnableRangeComment":"The \"High\" range is a rough guess. If you've run it above 2000--if you have a good idea of the max level for sane paddling--please post a comment.","aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":"III","beginLowRunnable":"1200","beginMediumRunnable":"1500","beginHighRunnable":"2500","endHighRunnable":"4000"},"gaugeInfo":{"name":"NEVERSINK RIVER AT GODEFFROY NY","gaugeSource":"USGS","gaugeSourceIdentifier":"01437500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"630","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"4.14","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"41.44127778","longitude":"-74.60183333"},"externalSource