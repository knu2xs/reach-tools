de":"-93.91390228271484"},"name":"Edgar's Suprise","distance":"4.3","photoID":"0","difficulty":"III","approximate":false},{"type":"rapid","description":"The river turns to the left and drops through a rapid with several holes and rocks to dodge","id":"919","location":{"latitude":"34.344398498535156","longitude":"-93.92120361328125"},"name":"Big Hole","distance":"5","difficulty":"III","approximate":false,"photoID":"0"},{"type":"takeout","description":null,"id":"115806","location":{"latitude":"34.3116264343262","longitude":"-93.8999633789062"},"name":"Take Out","distance":"8.5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"50868","ext":"jpeg","post_id":"235817","description":"","caption":"Close-up of Pinball Rapids","poi_name":"Pinball Rapid/a.k.a. Eye of the Needle","subject":"Pinball Rapids ","author":"Candice Dunn","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/50868","large":"https://api.americanwhitewater.org/image/images/big/50868"}},{"id":"50880","ext":"jpeg","post_id":"235856","description":"At the end of Winding Stairs Rapids there's these huge boulders that you can climb. You'll find small, cool caves and the Winding Stairs Creek at this special spot. There's also a small waterfall too. ","caption":"View from Winding Stairs Rapids Boulders","poi_name":"","subject":"Garrick","author":"Candice Dunn","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/50880","large":"https://api.americanwhitewater.org/image/images/big/50880"}},{"id":"50877","ext":"jpeg","post_id":"235856","description":"At the end of Winding Stairs Rapids there's these huge boulders that you can climb. You'll find small, cool caves and the Winding Stairs Creek at this special spot. There's also a small waterfall too. ","caption":"View from Winding Stairs Rapids Boulders","poi_name":"","subject":"","author":"Candic