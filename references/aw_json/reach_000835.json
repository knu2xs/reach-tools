[{"result":{"data":{"json":{"id":"835","stub":{"id":"835","section":"Millinocket Lake to Shad Pond","altname":"","river":"Millinocket Stream (E.Br.Penobscot trib)","difficulty":"ItoIIstandoutIII","states":["USA-MAI"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"111736","location":{"latitude":"45.741699","longitude":"-68.733704"},"name":"Put In Millinocket Lake Dam","distance":"0","photoID":"2QLmNLSLIaAPhRBydFQfv","difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"117008","location":{"latitude":"45.6316986083984","longitude":"-68.6844024658203"},"name":"Take Out","distance":"10","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"cTmw9ES0LkijA4UHoHvk7","ext":"jpg","post_id":"aFo9Ku6hXqK6vigSpQWpA","description":"","caption":"pools","poi_name":null,"subject":"","author":"Christopher Howe","poi_id":null,"photo_date":"2022-04-24T20:16:10.000Z","updated_at":"2022-04-24T20:16:10.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/cTmw9ES0LkijA4UHoHvk7","large":"https://api.americanwhitewater.org/image/images/big/cTmw9ES0LkijA4UHoHvk7"}},{"id":"2QLmNLSLIaAPhRBydFQfv","ext":"jpg","post_id":"aFo9Ku6hXqK6vigSpQWpA","description":"Millinocket Lake Dam","caption":"put in","poi_name":null,"subject":"","author":"Christopher Howe","poi_id":"111736","photo_date":"2022-04-24T20:16:10.000Z","updated_at":"2022-04-24T20:16:10.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/2QLmNLSLIaAPhRBydFQfv","large":"https://api.americanwhitewater.org/image/images/big/2QLmNLSLIaAPhRBydFQfv"}},{"id":"aZ3BPIiEy7rXJQ3H2aROM","ext":"jpg","post_id":"aFo9Ku6hXqK6vigSpQWpA","description":"a typical rapid","caption":"kayakers","poi_name":null,"subject":"","author":"Christopher Howe","poi_id":null,"photo_date":"2022-04-24T20:16:10.000Z","updated_at":"2022-04-24T20:16:10.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/aZ3BPIiEy7rXJQ3H2aROM","large":"https://api.americanwhitewater.org/image/images/big/aZ3BPIiEy7rXJQ3H2aROM"}}],"detail":{"id":"835","permitUrl":null,"permitInfo":null,"description":"Ron Canter, 12602 Turkey Branch Pkwy, Rockville,\n\nThis section is 7.4 miles from Millinocket Lake Dam to Kermit Crandall Park in Millinocket. Millinocket Stream is a drop pool stream with many interesting and busy class II/II+ rapids during the first 4 miles. They come at you at a consistent and comfortable pace. After the first road bridge is a snowmobile bridge that is often a portage. About mile 4, paddlers will experience the grand finale of Turtle Pit Rapids. A 3/4 mile long class II/III rapid that requires navigation and river reading skills as there are mid-stream boulders and pour overs. Optional portage on river right. After Turtle Pit Rapids the river calms all the way into downtown Millinocket. To shorten the run you can take out not far from the run out of Turtle Pit at the ITS 85snowmobile bridge that is just off the Staceyville Rd maybe a mile up from The Sawmill Bar and Grill, or even more, put in on the uppermost bridge on the Staceyville Rd. Live flows are available at [https://safewaters.com/facility/millinocket-lake](https://safewaters.com/facility/millinocket-lake).","averageGradient":null,"maxGradient":null,"length":"9.4","correlations":[],"pointOfInterestIDs":["111736","117008"],"geometry":{"type":"LineString","coordinates":[[-68.73335,45.742094],[-68.733278,45.74203],[-68.732861,45.741466],[-68.732827,45.740935],[-68.732809,45.740899],[-68.732756,45.740832],[-68.732664,45.740706],[-68.732559,45.740638],[-68.732156,45.740497],[-68.732329,45.74024],[-68.73234,45.740097],[-68.732417,45.740039],[-68.732464,45.739971],[-68.732466,45.739877],[-68.732187,45.739502],[-68.731804,45.739172],[-68.73155,45.739052],[-68.73156,45.73879],[-68.731569,45.738768],[-68.731549,45.738664],[-68.731502,45.738543],[-68.731469,45.738417],[-68.731439,45.738349],[-68.731299,45.738213],[-6