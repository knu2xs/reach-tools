[{"result":{"data":{"json":{"id":"192","stub":{"id":"192","section":"Virgilia to Belden","altname":"","river":"Feather, N. Fork, E. Branch","difficulty":"IIItoV","states":["USA-CAL"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"288","dateTime":"2026-05-11T22:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Put-in at the large pool just downstream of the town of Virgilia. Parking exists in the small turnout downstream of the passing lane on highway 70. There is a short carry down the trail to the river.\n\nThis is the put in for the Class IV Virgilia run. About 5 miles downstream the class III run, Richbar, begins.","id":"112856","location":{"latitude":"40.024926","longitude":"-121.116553"},"name":"Virgilia Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":"The run kicks off with a 5 foot drop on river left. This one is often ran by boofing a flake on the right side of the drop. At flows below 1200cfs, run down the middle.\n\nEasily scoutable on an island just right of the drop.","id":"JO7LaZTI5MlVkgCshH9aX","location":{"latitude":"40.024548","longitude":"-121.11758"},"name":"Entrance Drop","distance":"0.06","difficulty":"IV","approximate":false,"photoID":null},{"type":"rapid","description":"Some boogie water leads you to Rush Creek. The line on this one is left moving right. To successfully make this move, catch an eddy behind some willows in the center of the river. This will keep you from washing into shallow covered rocks downstream. From here, peel out and coninue moving right.","id":"AtyaQWIPPRoqlhPtuebsW","location":{"latitude":"40.025625","longitude":"-121.12409"},"name":"Rush Creek","distance":"0.51","difficulty":"IV","approximate":false,"photoID":null},{"type":"rapid","description":"Fun surf wave with eddy service on river right.","id":"0qcEnQAi52oHMDNYZ0mfP","location":{"latitude":"40.028757","longitude":"-121.127108"},"name":"Surf Wave","distance":"0.84","difficulty":"III","approximate":false,"photoID":null},{"type":"rapid","description":"The best Class III in Plumas County.","id":"S9FoqdCsuKxxqIZJwJqJY","location":{"latitude":"40.027626","longitude":"-121.136189"},"name":"Best in Plumas","distance":"1.41","difficulty":"III","approximate":false,"photoID":null},{"type":"rapid","description":"A Class III lead in with great surf opportunity leads to Drain Pipe. You'll know you're there when you see a large culvert coming out from under the railroad that hangs high above the river. Difficult to scout once you're on the water but easily scouted from the highway.\n\nDrain Pipe has 3 doors to choose from. The right drop is the most straight forward, where you punch through a small hole. The center drop is the most difficult, it's a tall boof with a dynamic hole at the bottom. The left drop is a left-to-right move, punching a couple small holes.","id":"wjKdiq6PMG0T963eGCjuI","location":{"latitude":"40.026081","longitude":"-121.14014"},"name":"Drain Pipe","distance":"1.65","difficulty":"IV","approximate":false,"photoID":null},{"type":"access","description":"Alternate access point at Rich Bar.","id":"qqPwLccaMsksOKCYw7OSY","location":{"latitude":"40.00937225","longitude":"-121.19290912"},"name":"Rich Bar Access","distance":"5.19","photoID":null,"difficulty":"N/A","approximate":false},{"type":"other","description":"Location of the NOAA East Branch Gage.","id":"baks4u5QKxd1jdr0NCmJq","location":{"latitude":"40.01100199","longitude":"-121.21682534"},"name":"East Branch Gage Location","distance":"7.62","photoID":null,"difficulty":"N/A","approximate":false},{"type":"other","description":"Confluence where the East Branch joins the North Fork Feather River.","id":"ERSd533RK2iyzuVqLUB1o","location":{"latitude":"40.014015","longitude":"-121.225799"},"name":"Confluence","distance":"8.27","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"Take out in Belden on the North Fork Feather.","id":"118135","location":{"latitude":"40.00569916","longitude":"-121.24500275"},"name":"Belden Take-Out","distance":"10","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"192","permitUrl":"","permitInfo":"","description":"This reach is boatable every year on natural flows.\n\nA GUIDE TO THE BEST WHITEWATER IN THE STATE OF CALIFORNIA, HOLBEK & STANLEY, 1988","averageGradient":null,"maxGradient":null,"length":"9.7","correlations":[{"reachID":"192","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"600","beginMediumRunnable":"1250","beginHighRunnable":"1700","endHighRunnable":"3000"},"gaugeInfo":{"name":"Feather River at East Branch","gaugeSource":"NOAA","gaugeSourceIdentifier":"nfec1","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"288","dateTime":"2026-05-11T22:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"5.92","dateTime":"2026-05-11T22:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"40.0111111111111","longitude":"-121.216944444444"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/nfec1","text":"NOAA Gauge Details"}}},"migrationErrorExplanation":null,"comment":"This is the flow NOAA reports for the East Branch Feather. As a secondary check on levels, take a look at Indian Creek and Spanish Creek. They join together to form the East Branch of the Feather approximately 10 miles upstream of the put-in. As a result, the flow on the East Branch will at least be the sum of Indian Creek and Spanish Creek.","status":{"status":"below-recommended","latestReading":{"value":"288","dateTime":"2026-05-11T22:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","