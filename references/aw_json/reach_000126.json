[{"result":{"data":{"json":{"id":"126","stub":{"id":"126","section":"02 (Rye Creek to Gun Creek)","altname":"Rye Creek/ The Box","river":"Tonto Creek","difficulty":"IIIplus","states":["USA-ARZ"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"3","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"access","description":"Rye Creek entering river right with Tonto Creek","id":"1898","location":{"latitude":"0","longitude":"0"},"name":"canyon put in","distance":"0","photoID":"0","difficulty":"N/A","approximate":false},{"type":"put-in","description":null,"id":"112662","location":{"latitude":"34","longitude":"-111.303001403809"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"hazard","description":"The rapid known to some as the Gauntlet appears after powerlines cross overhead. Eddy left usually and scout the pinch of the river and its unusual hydraulics.","id":"106838","location":{"latitude":"0","longitude":"0"},"name":"Pinchers","distance":"3","photoID":"0","difficulty":"N/A","approximate":true},{"type":"takeout","description":null,"id":"117947","location":{"latitude":"33.9720001220703","longitude":"-111.313003540039"},"name":"Take Out","distance":"5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"889809","ext":"jpeg","post_id":"892333","description":"Tonto Creek AZ","caption":"inner gorge tightness","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/889809","large":"https://api.americanwhitewater.org/image/images/big/889809"}},{"id":"881545","ext":"jpeg","post_id":"884118","description":"Igneous rock is beautiful throughout the lower half of the run.  Not suggested above 2k??  This flow is 700cfs.  We did bring a 14 foot raft that just fit through the slot near the end.  ","caption":"Twice as Gneiss Rye Creek to Gun Crk","poi_name":null,"subject":null,"author":"Brady Black","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/881545","large":"https://api.americanwhitewater.org/image/images/big/881545"}},{"id":"889811","ext":"jpeg","post_id":"892335","description":"The unique geology of Tonto Creek is easy on the eyes","caption":"Gorgeous Gorgeness","poi_name":null,"subject":null,"author":"Craig Irwin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/889811","large":"https://api.americanwhitewater.org/image/images/big/889811"}},{"id":"881548","ext":"jpeg","post_id":"884121","description":"Rye Creek Put-In is an easy shuttle.  The Rancher at the mouth has put a corral right over the creek complete with wire so you will have to lift it up and go under but he doesn't care as long as you are nice:)  There are some immediate strainers you might as well portage around to begin and one more down after a short paddle.  Portage on river right across the cobble bar.","caption":"Rye Creek Put-In","poi_name":null,"subject":null,"author":"Brady Black","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/881548","large":"https://api.americanwhitewater.org/image/images/big/881548"}},{"id":"881546","ext":"jpeg","post_id":"884119","description":"For the first half of the Class III run from Rye Creek to Gun Creek takeout you will paddle a beautiful open Verde style river with easy Class II-III rapids and saguaros abound.  The second half will close in and making scouting difficult but not impossible depending on flows and ability.  Class III tight.  It's been suggested to not run above 2K cfs because of the tightness of Canyon.","caption":"3-4 miles into the run","poi_name":null,"subject":null,"author":"Brady Black","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/881546","large":"https://api.americanwhitewater.org/image/images/big/881546"}},{"id":"10645","ext":"jpeg","post_id":"5332","description":"","caption":"Tonto Creek","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10645","large":"https://api.americanwhitewater.org/image/images/big/10645"}},{"id":"889808","ext":"jpeg","post_id":"892332","description":"Tonto Creek","caption":"Gorgeous AZ day","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/889808","large":"https://api.americanwhitewater.org/image/images/big/889808"}},{"id":"881547","ext":"jpeg","post_id":"884120","description":"Beautiful Gorge at the end run","caption":"Rye Creek to Gun Creek ","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/881547","large":"https://api.americanwhitewater.org/image/images/big/881547"}},{"id":"881544","ext":"jpeg","post_id":"884117","description":"Kayak with a combat roll can easily eddy jump above and below rapids for a boat scout.  Class III @ 700 cfs.","caption":"Gem","poi_name":null,"subject":null,"author":"Brady Black","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/881544","large":"https://api.americanwhitewater.org/image/images/big/881544"}},{"id":"889807","ext":"jpeg","post_id":"892331","description":"Tonto Creek AZ upper third","caption":"upper 1/3","poi_name":"","subject":"","author":"Craig Irwin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/889807","large":"https://api.americanwhitewater.org/image/images/big/889807"}},{"id":"889810","ext":"jpeg","post_id":"892334","description":"about 2/3 the way into the run at +/- 450 CFS \r\nJohn Rivers on the tail of a monsoonal flow","caption":"Monsoon","poi_name":"","subject":"","author":"Craig Irwin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/889810","large":"https://api.americanwhitewater.org/image/images/big/889810"}},{"id":"889813","ext":"jpeg","post_id":"892337","description":"about 8' across and this shot was taken at +/- 450 CFS","caption":"ELF Gauntlet","poi_name":"Pinchers","subject":"Gauntlet","author":"Craig Irwin","poi_id":"106838","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/889813","large":"https://api.americanwhitewater.org/image/images/big/889813"}},{"id":"889806","ext":"jpeg","post_id":"892330","description":"when you are hiking in on Rye Creek passing some dikes","caption":"Hiking in Rye Creek","poi_name":null,"subject":null,"author":"Craig Irwin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/889806","large":"https://api.americanwhitewater.org/image/images/big/889806"}},{"id":"889814","ext":"jpeg","post_id":"892338","description":"This is where you git out","caption":"Tonto Creek Takeout","poi_name":null,"subject":null,"author":"Craig Irwin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/889814","large":"https://api.americanwhitewater.org/image/images/big/889814"}},{"id":"889812","ext":"jpeg","post_id":"892336","description":"Brady paddling the Mini-Me out of the Tonto Gorge","caption":"Leaving the canyon","poi_name":null,"subject":null,"author":"Craig Irwin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/889812","large":"https://api.americanwhitewater.org/image/images/big/889812"}}],"detail":{"id":"126","permitUrl":"","permitInfo":"n/a","description":"Tonto Creek is an Arizona classic gorge! Runoff dependent.\n\nMinimum flow: 400 CFS / Maximum flow: +/- 6000 CFS\n\nTonto Creek makes for an interesting ramble through the desert into a colorful gorge.\n\nPutting in at Rye Creek confluence with Tonto Creek is the easiest way to do a day section of this unique Arizona rain offering. Leave Flagstaff in the morning and be home for dinner. Willows, big boulders in the river and colorful mini gorges. Pretty fun! Makes a fine bike shuttle.\n\n[Video: Packrafting Tonto Creek at 400cfs](https://youtu.be/g7rwMdHr46w?si=fD1RAlbd7tmRQP4h)\n\nOriginal Write Up:\n\nTHE RUN: The put-in for this run starts on Rye Creek. From the start it's shallow and overrun with brush, then becomes a micro creek with bedrock, and often covered with cattle fences, so take caution. This is a fun run when it is running.\n\nUsually doesn't run unless it is in the monsoon season (fall) or in a heavy run-off. This is a classic Class III run with a creekboat feel. At high water this is a class 5 and pretty demanding. In 1993 Wesley Hall died here, after a long swim, and the creek was flooding (extremely high).\n\nThere are a bunch of boulder gardens, and a few strainers hanging over the shoreline that you have to look out for. About halfway through this run powerlines cross overhead, and it is a good idea to eddy-out river left to scout the biggest drop on the creek. The drop, often called The Gauntlet or Pinrock, is about an 8-ft. tounge that is very constricted, with a sticky hole at the bottom. The drop kind of goes in this narrow canal and is very aerated, lots of fun, and you go deep!\n\nAbout a mile before the takeout, it's worth stopping on river right to check out Gold Creek and take a short hike up to an amazing waterfall.\n\nAfter that there are your usual boulder drops and a few sticky pourovers, that always surprises the unaware boater. Overall definitely worth doing, especially if you are an AZ ELF BOATER. (Extremely Low Flow).\n\n-Cody Howard","averageGradient":"38","maxGradient":"50","length":"3","correlations":[{"reachID":"126","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":"Optimal flow range (flows based on AW's 2014 Colorado Basin Flow Study). ","highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"400","beginMediumRunnable":"800","beginHighRunnable":"1000","endHighRunnable":"2000"},"gaugeInfo":{"name":"TONTO CREEK ABOVE GUN CREEK, NEAR ROOSEVELT, AZ","gaugeSource":"USGS","gaugeSourceIdentifier":"09499000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"3","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.81","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"33.98005443","longitude":"-111.30348355"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/09499000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/09499000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"3","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["1898","112662","106838","117947"],"geometry":{"type":"LineString","coordinates":[[-111.30329025,33.9994882],[-111.30315467,33.99941168],[-111.30292687,33.99931308],[-111.30266687,33.99926861],[-111.3017892,33.99909941],[-111.30125847,33.99905561],[-111.30073827,33.99894868],[-111.3004024,33.99887741],[-111.300164,33.99884188],[-111.29982827,33.99882461],[-111.2994492,33.99880748],[-111.29922167,33.99877201],[-1