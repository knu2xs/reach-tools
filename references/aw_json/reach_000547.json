[{"result":{"data":{"json":{"id":"547","stub":{"id":"547","section":"01. Forest service Trail 504 Hike and Huck","altname":"","river":"Needle Creek","difficulty":"V","states":["USA-COL"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"takeout","description":null,"id":"117897","location":{"latitude":"37.6277","longitude":"-107.698"},"name":"Take Out","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"put-in","description":null,"id":"112611","location":{"latitude":"37.6177","longitude":"-107.678"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"15146","ext":"jpeg","post_id":"3122","description":"","caption":"Needle Creek","poi_name":"","subject":"Josh Sandage","author":"Gordon Dalton","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/15146","large":"https://api.americanwhitewater.org/image/images/big/15146"}},{"id":"15145","ext":"jpeg","post_id":"3122","description":"","caption":"Needle Creek","poi_name":"","subject":"Harris Haynie","author":"Gordon Dalton","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/15145","large":"https://api.americanwhitewater.org/image/images/big/15145"}},{"id":"15239","ext":"jpeg","post_id":"3121","description":"","caption":"Harris at Eye of the Needle","poi_name":"Eye of the Needle","subject":"Harris Haynie","author":"Gordon Dalton","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/15239","large":"https://api.americanwhitewater.org/image/images/big/15239"}},{"id":"15140","ext":"jpeg","post_id":"3122","description":"","caption":"Sliding down Needle Creek","poi_name":"Needle Marks","subject":"Gordon Dalton","author":"Josh Sandage","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/15140","large":"https://api.americanwhitewater.org/image/images/big/15140"}},{"id":"15141","ext":"jpeg","post_id":"3122","description":"","caption":"Needle Creek","poi_name":"","subject":"G Dalton","author":"J Sandage","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/15141","large":"https://api.americanwhitewater.org/image/images/big/15141"}},{"id":"15142","ext":"jpeg","post_id":"3122","description":"","caption":"\"Eye of the Needle\"","poi_name":"","subject":"Gordon Dalton","author":"Josh Sandage","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/15142","large":"https://api.americanwhitewater.org/image/images/big/15142"}},{"id":"15144","ext":"jpeg","post_id":"3122","description":"","caption":"\"Needle Marks\"","poi_name":"Needle Marks","subject":"Josh Sandage","author":"Gordon Dalton","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/15144","large":"https://api.americanwhitewater.org/image/images/big/15144"}},{"id":"15147","ext":"jpeg","post_id":"3122","description":"","caption":"View from the top","poi_name":"","subject":"Josh Sandage, Harris Haynie","author":"Gordon Dalton","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/15147","large":"https://api.americanwhitewater.org/image/images/big/15147"}},{"id":"15143","ext":"jpeg","post_id":"3122","description":"One of the last main rapids on Needle. This is a nice little boof along the left bank, with a shallow but friendly landing and runout.","caption":"Needle Creek","poi_name":"","subject":"Gordon Dalton","author":"Josh Sandage","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/15143","large":"https://api.americanwhitewater.org/image/images/big/15143"}}],"detail":{"id":"547","permitUrl":null,"permitInfo":null,"description":"Needle Creek is a small tributary of the Upper Animas River. The creek drains the fourteen-thousand foot Needle Mountains; Sunlight Peak, Mount Eolus, and Windom Peak. Accessing Needle can require some creativity - this is the Weminuche Wilderness and it is definitely not roadside. On our exploratory run, we enjoyed an overnight trip down the [Upper Animas](http://www.americanwhitewater.org/content/River/detail/id/346/) with the probing of Needle Creek as the highlight. Another option could involve a train ride straight to Needleton.\n\nForest service trail 504 parallels Needle Creek from the Animas River all the way up to Chicago Basin and beyond. Hike up the trail to access the top of Needle Creek, putting on whenever you are tired of hiking and ready for hucking.\n\nThere will be wood in the creek, but on our run I was surprised at how little wood was in the way. All of the main drops were free of wood; there was only wood in some of the flatter \"boogie-water\" sections and it was possible to get around or under most of that. I was also surprised at how quality most of the drops actually were. There are some nice granite cascades and slides like \"Needle Tracks,\" to spice up the continual rock gardens. One of the more complex drops, \"Eye of the Needle,\" starts with a boof over a wood dam leading into a tight, twisting slot move with a fairly sticky hole at the bottom.\n\nCombined with the [Upper Animas](http://www.americanwhitewater.org/content/River/detail/id/346/) and the [Rockwood Box](http://www.americanwhitewater.org/content/River/detail/id/347/), this makes for a variety of boating styles in one trip: from micro-creeking to big-water in one day. Oh yeah, save some energy for the hike-out to Rockwood Depot.\n\nGordon Dalton","averageGradient":"400","maxGradient":"0","length":"1.5","correlations":[],"pointOfInterestIDs":["117897","112611"],"geometry":{"type":"LineString","coordinates":[[-107.6780068073893,37.61806541393578],[-107.6781466766356,37.618062808275965],[-107.67836060996859,37.61801327494271],[-107.67859540996824,37.61793647494278],[-107.6787196099681,37.6178980082762],[-107.67888527663445,37.617848674942934],[-107.67915447663404,37.61798587494275],[-107.67939607663368,37.61814520827579],[-107.67972047663318,37.618342808275486],[-107.6801484766325,37.61865027494168],[-107.68063167663179,37.618990808274475],[-107.68108027663106,37.61923227494077],[-107.68166020996352,37.619578208273595],[-107.68215727662937,37.61983627493987],[-107.68250927662882,37.61997360827297],[-107.68283380996166,37.62005587493951],[-107.68319267662781,37.62009987493946],[-107.68366207662706,37.62016567493936],[-107.68402800995983,37.620253474939204],[-107.68417980995957,37.62035240827237],[-107.6842280766262,37.62045667493891],[-107.68426267662615,37.62052807493876],[-107.68430407662606,37.62061600827195],[-107.68435927662597,37.62067087493858],[-107.68444207662584,37.62073120827182],[-107.6845456766257,37.620764208271744],[-107.68467000995884,37.62080807493834],[-107.68482187662528,37.62084107493831],[-107.68505660995822,37.62086300827161],[-107.68528440995789,37.620912474938166],[-107.68554660995744,37.620994808271405],[-107.68571927662384,37.621044208271314],[-107.68584347662369,37.621044208271314],[-107.6859470766235,37.62102220827137],[-107.68605060995668,37.62098380827143],[-107.68625080995639,37.62097827493807],[-107.68646487662272,37.620989208271396],[-107.68665120995577,37.62107700827124],[-107.6868030099555,37.62117587493776],[-107.68707920995507,37.621329608270855],[-107.68743820995451,37.621543674937186],[-107.68778340995397,37.62173040827025],[-107.68801120995363,37.6218182749368],[-107.68808020995351,37.621845674936765],[-107.68819760995336,37.62187320827002],[-107.68833567661983,37.62185120827007],[-107.68851507661952,37.62181267493679],[-107.68862560995268,37.621724874936945],[-107.68870840995254,37.62165340827039],[-107.688922276