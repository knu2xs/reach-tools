[{"result":{"data":{"json":{"id":"218","stub":{"id":"218","section":"3) Johnsondale Bridge to Powerhouse #3","altname":"Upper Kern","river":"Kern, N. Fork","difficulty":"IIItoV","states":["USA-CAL"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"945","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"110024","location":{"latitude":"35.9688","longitude":"-118.487"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"access","description":"Brush Creek enters from the left near the end of a class 3 rapid.  There is also a very large parking area and river access here.","id":"100836","location":{"latitude":"35.966102600097656","longitude":"-118.48011016845703"},"name":"Brush Creek","distance":"0.7","photoID":"0","difficulty":"III","approximate":false},{"type":"takeout","description":"There is roadside parking and river access at the upper end of the Fairview impoundment.","id":"100839","location":{"latitude":"35.94919967651367","longitude":"-118.48100280761719"},"name":"Fairview take out","distance":"2.4","photoID":"0","difficulty":"N/A","approximate":true},{"type":"portage","description":"Marks the end of the Limestone section. Southern California Edison diverts up to 600 cfs from the river for the powerhouse near Kernville. All the runs between Fairview and the powerhouse, have shorter seasons and lower flows because of the diversion. Since relicensing, Edison reduces the diversion on weekends under certain conditions to benefit whitewater recreation.","id":"100834","location":{"latitude":"35.945899963378906","longitude":"-118.47699737548828"},"name":"Fairview Dam","distance":"2.6","photoID":"0","difficulty":"N/A","approximate":true},{"type":"access","description":"From below Fairview dam to Calkins Flat is a bit less than 3 miles. This is one of easiest sections to float on the upper Kern. The put-in is downstream of the dam.","id":"100841","location":{"latitude":"35.943599700927734","longitude":"-118.4800033569336"},"name":"Fairview put-in","distance":"3","photoID":"0","difficulty":"III","approximate":false},{"type":"access","description":"Use this primitive camping area as a take out for the easier upstream run or as a put in for the very pretty, but difficult Chamise Gorge section.","id":"100842","location":{"latitude":"35.91740036010742","longitude":"-118.48999786376953"},"name":"Calkins Flat Access","distance":"5.8","photoID":"0","difficulty":"N/A","approximate":true},{"type":"portage","description":"Upper and lower Salmon Falls are very steep and congested rapids.  They are comparable to rapids found on the Cataracts of the Kern.  This rapid has a bad sieve in the main channel that has resulted in a number of fatalities. Expert paddlers do run Salmon falls if they feel like it, but they are mostly portaged.   The consequences of mistakes in these rapids are lost boats and bodily injury.","id":"100840","location":{"latitude":"35.892398834228516","longitude":"-118.46499633789062"},"name":"Salmon Falls","distance":"8","photoID":"0","difficulty":"V","approximate":false},{"type":"access","description":"Alternate put-in access for the Gold Ledge run that gives you another mile of whitewater.","id":"105015","location":{"latitude":"35.88534927368164","longitude":"-118.45844268798828"},"name":"Ant Canyon Primitive Area","distance":"9.4","photoID":"0","difficulty":"N/A","approximate":false},{"type":"access","description":"Access point below the Chamise Gorge.","id":"105005","location":{"latitude":"35.87329864501953","longitude":"-118.45800018310547"},"name":"Gold Ledge Camgpround","distance":"10.3","photoID":"0","difficulty":"N/A","approximate":false},{"type":"access","description":"An alternate put-in access for the Camp 3 and Powerhouse runs.","id":"105009","location":{"latitude":"35.80694580078125","longitude":"-118.45328521728516"},"name":"Camp 3 Campground Access","distance":"16.6","photoID":"0","difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"hS7W8pUfqgbe4jJCg7GmC","ext":"jpg","post_id":"CT1GiyQC1ZVx6cB6zJq1B","description":"","caption":"Limestone at ~500 CFS","poi_name":null,"subject":"Limestone at ~500 CFS","author":"Kyle Pierce","poi_id":"100837","photo_date":"2022-04-03T02:30:56.000Z","updated_at":"2025-06-10T02:30:56.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/hS7W8pUfqgbe4jJCg7GmC","large":"https://api.americanwhitewater.org/image/images/big/hS7W8pUfqgbe4jJCg7GmC"}},{"id":"41233","ext":"jpeg","post_id":"7369","description":"Macy Burnham cleaning the troublesomely serious Upper Salmon Falls (V+), between Chemise and Ant Canyon","caption":"Upper Salmon Falls, NF Kern","poi_name":"Upper Salmon Falls","subject":"Macy Burnham","author":"Ian Buckley","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/41233","large":"https://api.americanwhitewater.org/image/images/big/41233"}},{"id":"2959","ext":"mov","post_id":"5435","description":"","caption":"Brush Creek Rapid","poi_name":"Brush Creek Rapid","subject":"Lucian Whitman","author":"Andrew Goldstein","poi_id":"105000","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/2959","large":"https://api.americanwhitewater.org/image/images/big/2959"}},{"id":"4052","ext":"mov","post_id":"5436","description":"","caption":"Limestone Rapid","poi_name":"Limestone","subject":"Andrew Goldstein and Carlos Torres","author":"Andrew Goldstein and Carlos Torres","poi_id":"100835","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/4052","large":"https://api.americanwhitewater.org/image/images/big/4052"}},{"id":"41234","ext":"jpeg","post_id":"7369","description":"Keith Kishiyama boofing into the meltdown, Lower Salmon Falls, NF Kern","caption":"Keith Kishayama, Lower Salmon Falls, NF Kern","poi_name":"Lower Salmon Falls","subject":"Keith Kishayama","author":"Ian Buckley","poi_id":"100835","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/41234","large":"https://api.americanwhitewater.org/image/images/big/41234"}},{"id":"cvWXxWKTnRc7SaBB2fVOA","ext":"jpg","post_id":"QOQB28pRlxsyM5Ipo2t4r","description":"Joes Diner at ~500 CFS","caption":"Joes Diner at ~500 CFS","poi_name":null,"subject":"Joes Diner","author":"Kyle Pierce","poi_id":"100838","photo_date":null,"updated_at":"2022-04-04T13:12:00.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/cvWXxWKTnRc7SaBB2fVOA","large":"https://api.americanwhitewater.org/image/images/big/cvWXxWKTnRc7SaBB2fVOA"}}],"detail":{"id":"218","permitUrl":"http://www.fs.usda.gov/detail/sequoia/passes-permits/recreation/?cid=fsbdev3_059515","permitInfo":"A Kern River Use Permit is required year round and is valid from May 1 through April 30 each year. Permits are issued on a first-come, first-served basis and are free of charge. A permit is required for EACH craft. Group size cannot exceed 18 people on the river at one time. To obtain a permit, fill out an application IN PERSON at Forest Service offices in Kernville, Lake Isabella, Springville or Bakersfield. Applications will not be mailed out or left in office drop boxes. Upon completion of your application, a waterproof permit may be issued.","description":"The excellent variety of whitewater below Johnsondale bridge provides several different options for boaters. Some of it easily rivals the Forks in quality and difficulty, but with more convenient access. The Forks beats this segment for scenery but not by a lot, and when you are staring at the next horizon line, who needs scenery! The river is commonly considered as several distinct sections, especially since Fairview dam forces a portage and then diverts up to 600 CFS of the flow from the river.\n\n*1) Johnsdale Bridge to Fairview Dam: Limestone Run (2.4 miles, class III-IV)*\n\nThis segment of the run is free flowing so check the flows for the Kern above the Fairview Dam to get an accurate reading for this segment. Because flows are not impacted by a diversion, this section is typically an option when the powerhouse is diverting flow out of the segments below Fairview Dam. The main rapids are Brush Creek (3), Limestone (4), Joe's Diner (4), and Betty's Bakery (3). The scenery of this dramatic canyon is excellent with numerous limestone walls with small caves and dripping water. This runs down to about 450-500cfs.\n\n*2) Fairview Dam to Calkins Flat: Calkins Flat Run/Fairview (2.8 miles, class III)*\n\nThis segment is signifcantly less difficult than the sections upstream or downstream. It's serves as a short intermediate run by itself or a warm up to the Chamise Gorge. Southern California Edison diverts up to 600 cfs from the river for the powerhouse near Kernville. All the runs between Fairview Dam and the KR3 Powerhouse, have shorter seasons and lower flows because of the diversion. Since relicensing, Edison reduces the diversion on weekends under certain conditions to benefit whitewater recreation (check the flow tab for more information on how to interpret the gages and determine if the river is running).\n\n*3) Calkins Flat to Gold Ledge Campgound: Chamise Gorge (4.5 miles, class IV/V)*\n\nThe segment begins with Entrance Rapid. Satan's Slot is another named rapid that comes up just before the river cascades through Salmon Falls. An altnerate access provides a take-out option above Salmon Falls. Flows for this segment are also impacted by the Southern California Edison diversion dam.\n\n*3) Ant Canyon (class IV)*\n\n*4) Gold Ledge Campground to Thunderbird: Gold Ledge Run/Thunder Run (class V)*\n\nThis section is the most difficult on the Upper Kern with named drops that include Squashed Paddler, Sock 'Em Dog, The Flume, Fender Bender, etc\n\n*5) Thunderbird Campground to KR3 Powerhouse: Cables (class IV)*\n\n*Cables rapid, The Wall, Tombstone, Buzzard's Perch, Tequila Chute (left) or Pepsi Challenge (right) and Powerhouse. Flows for this segment are also impacted by the Southern California Edison diversion dam.*\n\n**Logistics:**\n\nThe Johnsondale Bridge put-in has a large parking area with developed river access on the west side (river right) of the bridge. It is located about about 25 minutes north of Kernville and about one hour and 40 minutes from Bakersfield. If coming from the north it is faster to turn off of highway 99 at Earlimart to go through Ducor and California Hot Springs. Allow about one hour and 20 minutes from Earlimart. Sometimes people drive through Springville and up through the Tule River Canyon, but this is a slow drive due to the narrow, windy road. Allow an hour and a half just from Springville, not counting stops for gawking at the Tule canyon.\n\nThe Powerhouse take-out is just north of Kernville on river left on the downstream side of the Southern California Edison KR3 Powerhouse. Take Sierra Way (Hwy 521) north out of town to reach the take-out.\n\nMountain Highway 99 serves as the shuttle route along river left as it parallels the entire run. Along the way there are alternate access points depending on flows and the level of difficulty you are seeking. Intermediate access points include Fairview Dam (take-out above and put-in below), Calkins Flat, above Salmon Falls, Ant Canyon Primitive Area, Gold Ledge Campground, and Camp 3 Campground. Click the map tab to view the location of rapids and these alternate access points.\n\n**Other Information Sources:**\n\nEdison's Kern River flow phone: **877 537 6356**\n\n[Upper Kern Guide Book](https://www.kernriverrafting.com/kern-river-guide/upper-kern/)\n\n[Camping](http://www.kernvalley.com/news/kerncamp.htm)\n\n[Wikipedia](http://en.wikipedia.org/wiki/Kern_River)\n\n[Kern River Festival](http://www.kvrc.org/festival.htm)\n\n[Kern River Alliance](http://www.kernriver.org/)\n\n[Kern Valley River Council](http://www.kvrc.org/)\n\n[Sequoia National Forest](http://www.fs.fed.us/r5/sequoia/) Kernville office phone # 760-376-3781\n\n[Sierra South store](http://www.sierrasouth.com/nfkern.htm#Forks)\n\n[Cacreeks.com](http://www.cacreeks.com/kern-nf.htm)\n\nCassady &amp; Calhoun, Holbek &amp; Stanley, Martin, Alan Baty","averageGradient":null,"maxGradient":null,"length":"18.4","correlations":[{"reachID":"218","isPrimary":false,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"500","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"2500"},"gaugeInfo":{"name":"No. Kern Above Fairview Dam","gaugeSource":"DREAM","gaugeSourceIdentifier":"681","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"1523","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":null,"location":{"latitude":"30","longitude":"30"},"externalSourceLinks":{"sourceLink":{"url":"https://www.dreamflows.com/graphs/day.681.php","text":"Dream Flows"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"migration-runnable","latestReading":{"value":"1523","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}},{"reachID":"218","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"500","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"3000"},"gaugeInfo":{"name":"No. Kern Below Fairview Dam","gaugeSource":"DRE