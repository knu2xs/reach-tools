[{"result":{"data":{"json":{"id":"461","stub":{"id":"461","section":"Upper","altname":"Goshen Church Road to Highway 53","river":"Amicalola Creek","difficulty":"IItoIII","states":["USA-GEO"]},"primaryGaugeStatus":{"status":null,"latestReading":{"value":"97","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Great put in. Stairs lead directly to the river. This is the second put in down.","id":"106497","location":{"latitude":"34.485952","longitude":"-84.236413"},"name":"Put in for six mile/ camp ground","distance":"1.8","photoID":"lJM0DoBHgNwNBtMhhPsur","difficulty":"N/A","approximate":false},{"type":"hazard","description":"A five foot river wide ledge. Best line is typically right of center. This is a mandatory scout due to the possible presence of wood. Scout from the left bank.","id":"1156","location":{"latitude":"0","longitude":"0"},"name":"The Ledge","distance":"4.75","photoID":"kGac5g4lmD3KatM1PJiK9","difficulty":"II+","approximate":false},{"type":"playspot","description":"Believe it or not, there is actually park and play in North GA. This hole consists of a II+ wave hole with good eddy access from the river right side. The hole is playable from 0.6-1.5. Above 1.5 the hole moves upstream about 10 ft. and forms more of a wave. If you can get on it, it's a great ride. At this higher level, up to about 3.0, some great standing waves also develop behind this hole. To get to the hole, take the upstream dirt road to the east of the GA53 bridge. Park at the end of the road and walk approximately 100yards up the trail. This is also a great place to sit an watch the local sit-on-top carnage.","id":"1157","location":{"latitude":"0","longitude":"0"},"name":"The Play Hole","distance":"9.5","difficulty":"II+","approximate":false,"photoID":"883403"},{"type":"takeout","description":"Take out on right left by Hwy 53","id":"116494","location":{"latitude":"34.426242","longitude":"-84.212571"},"name":"Take Out","distance":"10.68","photoID":"LLh6cEfkK1izWrg2NuESq","difficulty":"N/A","approximate":false}],"alerts":[{"id":"G1E8yJpwYAo3L9xAHXT9s","title":"1-13-24","post_date":"2024-01-15 20:48:43+00","detail":"Lindsey Ford to Hwy 53 is completely clear of wood.","user":{"name":"Seth Scott"}},{"id":"101251557","title":null,"post_date":"2015-04-02 04:00:00+00","detail":"Ran with two person Canoe 3/29/15. Level was at .9. About 10 trees have fallen between Six Mile to Steel Bridge. A small handsaw would take care of a couple trees to create path to go under. Trees must have fallen in the recent Ice storms. 2-3 trees will require more man power to take care of so be prepared to go over or have to pull boat out of water to get pass the trees. The level is about as low that I would run between Six Mile and Steel Bridge. After Steel Bridge to HWY 53 no trees across the water. Great ride with only fishermen seen at Steel Bridge and Hwy 53 exit. Took 4 hours to go between Six Mile and HWY 53 with short rest at Steel Bridge.","user":{"name":"Patrick Honan"}},{"id":"101250744","title":null,"post_date":"2013-12-31 05:00:00+00","detail":"Between the 6 mile/DNR campground put-in and The Ledge, there are two new large trees across the river that require portage, regardless of level. These are new since July 2013. We portaged both on river left. They are easily visible before you get to them, so they should not be a surprise.","user":{"name":"Jim Tebbel"}},{"id":"101249399","title":null,"post_date":"2012-05-24 04:00:00+00","detail":"Put-in/take-out at GA53 under construction. Looks like they are renovating a big retention wall and repaving the upper parking lot. Can't access with car. Did Steele Bridge to GA53 at 0.83 on GA53 gauge. The gauge didn't seem to be reacting to thunderstorms in area or 45min of heavy rain received after we got out. Beautiful trip w/ enough water.","user":{"name":"Douglas Fantz"}}],"photos":[{"id":"1894","ext":"jpeg","post_id":"3528","description":"The Falls consist of a river wide ledge,about 4',with a shallow pool below.","caption":"cinco de Mayo","poi_name":"The Falls","subject":"Allen Hedden","author":"C. McLoughlin","poi_id":"1156","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1894","large":"https://api.americanwhitewater.org/image/images/big/1894"}},{"id":"9026","ext":"jpeg","post_id":"7487","description":"","caption":"The Ledge","poi_name":"The Ledge","subject":"Greg Simpson","author":"Jimmy Lowe","poi_id":"107488","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/9026","large":"https://api.americanwhitewater.org/image/images/big/9026"}},{"id":"1897","ext":"jpeg","post_id":"3528","description":"Gabriella cuttin through with a light touch and tight line!","caption":"Twice the Paddler","poi_name":"","subject":"Gabriella Schlidt","author":"C. McLoughlin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1897","large":"https://api.americanwhitewater.org/image/images/big/1897"}},{"id":"1896","ext":"jpeg","post_id":"3528","description":"I've heard this section of river can be run as low as .5","caption":"Smooth Run","poi_name":"The Falls","subject":"Tennent","author":"Chris McLoughlin","poi_id":"1156","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1896","large":"https://api.americanwhitewater.org/image/images/big/1896"}},{"id":"1898","ext":"jpeg","post_id":"3528","description":"Pat drops over another typical ledge on the Upper A.","caption":"Canoe Canoe?","poi_name":"","subject":"Pat Hagan","author":"C. McLoughlin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1898","large":"https://api.americanwhitewater.org/image/images/big/1898"}},{"id":"1895","ext":"jpeg","post_id":"3528","description":"This small creek has several smaller type drops which makes for excellant training. ","caption":"Typical Amicalola Creek rapid","poi_name":"","subject":"Pat Hagan","author":"Chris McLoughlin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1895","large":"https://api.americanwhitewater.org/image/images/big/1895"}},{"id":"10453","ext":"jpeg","post_id":"4898","description":"This is the rapid below The Ledge","caption":"\"Triple Drop\"","poi_name":"\"Triple Drop\"","subject":"","author":"Chuck Spornick","poi_id":"1157","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10453","large":"https://api.americanwhitewater.org/image/images/big/10453"}},{"id":"10452","ext":"jpeg","post_id":"4898","description":"","caption":"Alan boofing the Ledge","poi_name":"The Ledge","subject":"Alan Hecht","author":"Chuck Spornick","poi_id":"107488","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10452","large":"https://api.americanwhitewater.org/image/images/big/10452"}},{"id":"10451","ext":"jpeg","post_id":"4899","description":"Last ledge before the Steel Bridge","caption":"Ledge before Steel Bridge","poi_name":"Last Ledge","subject":"Scott Houser","author":"Chuck Spornick","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10451","large":"https://api.americanwhitewater.org/image/images/big/10451"}},{"id":"883403","ext":"jpeg","post_id":"886091","description":"","caption":"Surfs Up","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/883403","large":"https://api.americanwhitewater.org/image/images/big/883403"}},{"id":"17792","ext":"jpeg","post_id":"9569","description":"","caption":"The Play Hole","poi_na