[{"result":{"data":{"json":{"id":"275","stub":{"id":"275","section":"1) Box Canyon Dam to Dunsmuir","altname":"Box Canyon","river":"Sacramento","difficulty":"IIItoIV","states":["USA-CAL"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":"Hike downstream on a trail on river left till you see a clearing.  Find a rope system leading down to the water.\n\nIf the dam is spilling, some rafters drop their empty rafts in the reservoir and let them go over the spillway rather than lower them down the ropes.  Of course people have to be waiting below to catch the rafts.","id":"101521","location":{"latitude":"0","longitude":"0"},"name":"Put in","distance":"0","photoID":"18823","difficulty":"N/A","approximate":false},{"type":"access","description":"This is an alternate put in and access location on river right.   This access point is probably more suitable for rafts than the roped descent close to the dam.","id":"101524","location":{"latitude":"41.269100189208984","longitude":"-122.31700134277344"},"name":"Neys Springs Fishing Access","distance":"1","photoID":"0","difficulty":"N/A","approximate":true},{"type":"access","description":"Boaters sometimes run laps from the put in to here, making a short and quick run.","id":"101522","location":{"latitude":"41.26548385620117","longitude":"-122.30963134765625"},"name":"Cantera Loop Road","distance":"3","photoID":"0","difficulty":"N/A","approximate":true},{"type":"takeout","description":null,"id":"115264","location":{"latitude":"41.2201","longitude":"-122.276"},"name":"Take Out","distance":"7.5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"18824","ext":"jpeg","post_id":"9733","description":"","caption":"18824.jpeg","poi_name":"","subject":"Scott Yoder","author":"Darin McQuoid","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/18824","large":"https://api.americanwhitewater.org/image/images/big/18824"}},{"id":"18823","ext":"jpeg","post_id":"9733","description":"","caption":"Good flows","poi_name":"","subject":"","author":"Darin McQuoid","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/18823","large":"https://api.americanwhitewater.org/image/images/big/18823"}},{"id":"888488","ext":"jpeg","post_id":"891230","description":"Ropes anchored into the bedrock aide the descent into the canyon.","caption":"Box Canyon Access Anchor","poi_name":"","subject":"","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888488","large":"https://api.americanwhitewater.org/image/images/big/888488"}},{"id":"888484","ext":"jpeg","post_id":"891230","description":"","caption":"Box Canyon Dam","poi_name":"","subject":"","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888484","large":"https://api.americanwhitewater.org/image/images/big/888484"}},{"id":"888486","ext":"jpeg","post_id":"891230","description":"","caption":"Box Canyon Dam","poi_name":"","subject":"","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888486","large":"https://api.americanwhitewater.org/image/images/big/888486"}},{"id":"888487","ext":"jpeg","post_id":"891230","description":"","caption":"Box Canyon Access","poi_name":"","subject":"Megi Morishita","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888487","large":"https://api.americanwhitewater.org/image/images/big/888487"}},{"id":"888485","ext":"jpeg","post_id":"891230","description":"Siskiyou Reservoir held back by Box Canyon Dam and the start of the run on the Upper Sacramento.","caption":"Siskiyou Reservoir","poi_name":"","subject":"","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888485","large":"https://api.americanwhitewater.org/image/images/big/888485"}},{"id":"888489","ext":"jpeg","post_id":"891230","description":"A ladder for aides the descent down the final few feet into the canyon at the put-in.","caption":"Box Canyon Access Ladder","poi_name":"","subject":"Megi Morishita","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888489","large":"https://api.americanwhitewater.org/image/images/big/888489"}},{"id":"888490","ext":"jpeg","post_id":"891230","description":"Down in Box Canyon at low water.","caption":"Box Canyon Low Water","poi_name":"","subject":"","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888490","large":"https://api.americanwhitewater.org/image/images/big/888490"}}],"detail":{"id":"275","permitUrl":"","permitInfo":"","description":"This run is a class 4 classic.   Beautiful rapids are set in a deep, impressive box canyon of high cliffs.  In several areas, curtains of water cascade down the cliffs from large springs.\n\nIt's just off I-5 and if you're driving though in season it makes for a fun paddling diversion. It is tough to figure out if it's running by using the Sacramento @ Delta gauge as a guide as that gauge is close to 40 miles downstream from the put-in. There are too many variables to come up with a simple formula using that gauge as a guide, but there is a good rule of thumb.  As the season progresses the flow in box canyon will be an ever increasing percentage of the total flow at the gauge. In season paddlers will often post the height of the Cantara Gauge on Dreamflows.com (The Cantara guage is the stick gauge at the end of Box Canyon on river left). It's a good bet that Box will have boatable flows from late March thru May.\n\n**Take out:** Beneath the Dunsmir Avenue bridge in Dunsmir.\n\n**Put in:**  The furthest upstream put in requires the use of ropes to descend to the river.  From the left side of the dam, hike downstream a short ways to a clearing, then look for an improvised system of ropes and ladders leading down to the river.  Alternative put ins are at: Ney Springs Fishing Access, Stink Creek and Cantera Loop.\n\n**Other Information Sources:**\n\n[A Wet State: Box Canyon](http://www.awetstate.com/SacBox.html)\n\n[Jefferson State: Box Canyon](http://darinm.blogspot.com/2006/05/box-canyon-of-sacramento-iv-box-canyon.html)\n\n[Ca Creekin: Box Canyon](http://cacreeks.com/sac-box.htm)\n\n[Oregon Rafting](http://oregonrafting.org/sacramento_box_canyon.html)\n\n[Dreamflows Bulletin Board: Box Canyon page](http://www.dreamflows.com/forums/flowTopics.php?river=38&name=Sacramento%20-%20Below%20Box%20Canyon%20Dam)\n\n[Syskiyou County Flood Control and Water Conseration District](http://www.co.siskiyou.ca.us/GS/flood.aspx)  -  Phone - 530-842-8250\n\nCassady & Calhoun, Holbek & Stanley, Schwind, Gerald Meral","averageGradient":null,"maxGradient":null,"length":"7.7","correlations":[],"pointOfInterestIDs":["101521","101524","101522","115264"],"geometry":{"type":"LineString","coordinates":[[-122.32701001027421,41.27921593598668],[-122.32649158723179,41.2791542025932],[-122.32643332056523,41.27916520259316],[-122.32636778723194,41.279176202593135],[-122.32630232056539,41.27921466925978],[-122.32626592056546,41.27926406925968],[-122.32617858723228,41.27933546925959],[-122.32612032056569,41.27941240259281],[-122.32603312056585,41.2795222025926],[-122.32575652056626,41.279703469259005],[-122.3256254538998,41.27973006925896],[-122.32556718723322,41.27974186925894],[-122.3254653205667,41.27976386925895],[-122.32529792056698,41.279769469258895],[-122.3251669205672,41.279742002592286],[-122.325050