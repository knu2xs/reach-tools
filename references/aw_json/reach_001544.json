[{"result":{"data":{"json":{"id":"1544","stub":{"id":"1544","section":"2. Lolo Pass Road (Zigzag) to Marmot Dam site","altname":"","river":"Sandy","difficulty":"IItoIII","states":["USA-ORE"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"639","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"112077","location":{"latitude":"45.3563995361328","longitude":"-121.935997009277"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"117354","location":{"latitude":"45.4000015258789","longitude":"-122.13200378418"},"name":"Take Out","distance":"13.5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"877530","ext":"jpeg","post_id":"877819","description":"","caption":"Alder Creek","poi_name":"Alder Creek","subject":"Ray Capone","author":"Thomas O'Keefe","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/877530","large":"https://api.americanwhitewater.org/image/images/big/877530"}},{"id":"877531","ext":"jpeg","post_id":"877819","description":"A restored river where the reservoir behind Marmot Dam once buried the river bed.","caption":"Marmot Dam former reservoir","poi_name":"","subject":"Matt Moreland","author":"Thomas O'Keefe","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/877531","large":"https://api.americanwhitewater.org/image/images/big/877531"}}],"detail":{"id":"1544","permitUrl":"","permitInfo":"","description":"The section from Lolo Pass to Marmot (Sleepy Hollow Bridge) is boulder filled and changes year to year. It is mostly class II with some class III areas at regular flows. The run becomes fun class III-IV at high flows, but wood is sometimes present . At very high water (rocks heard rolling along the bottom) the confluence with the Salmon gets turbulent and the rest of the run is a flush down the middle with large waves and some holes that can sneak up on you. Rescue can be difficult.\n\nThe most distinct rapid are the class IV- Alder Creek Rapids, near an A-framed house on the left. Scout this rapid from the bedrock on the right. From here to the old Marmot Dam site is class II-III with a sneaky hole at the end of a long straight away a mile or so below Alder Creek.","averageGradient":"70","maxGradient":"0","length":"13.9","correlations":[{"reachID":"1544","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"700","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"2000"},"gaugeInfo":{"name":"SANDY RIVER NEAR MARMOT, OR","gaugeSource":"USGS","gaugeSourceIdentifier":"14137000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"639","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"690.38","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"45.3995642","longitude":"-122.1373068"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/14137000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/14137000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"639","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["112077","117354"],"geometry":{"type":"LineString","coordinates":[[-121.93606098,45.35670631],[-121.93633999,45.35664813