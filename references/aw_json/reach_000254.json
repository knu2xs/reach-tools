[{"result":{"data":{"json":{"id":"254","stub":{"id":"254","section":"2. Below Salt Springs Reservoir to Tiger Creek Afterbay","altname":"Devil's Nose","river":"Mokelumne, N. Fork","difficulty":"IIItoV","states":["USA-CAL"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"1073","dateTime":"2026-05-11T23:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"112880","location":{"latitude":"38.4794","longitude":"-120.269"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"portage","description":"Portage right or run the very right edge.   At high flows scout high on right from above previous rapid.  Both rapids run together at high flows.","id":"101435","location":{"latitude":"38.44612503051758","longitude":"-120.48494720458984"},"name":"Mokelumne Falls","distance":"14","photoID":"0","difficulty":"V","approximate":true},{"type":"portage","description":"A low dam blocks the river.  Portage on river right.","id":"101434","location":{"latitude":"38.4468994140625","longitude":"-120.49043273925781"},"name":"Gauging Weir","distance":"14.7","photoID":"0","difficulty":"N/A","approximate":true},{"type":"takeout","description":null,"id":"118159","location":{"latitude":"38.4481","longitude":"-120.494"},"name":"Take Out","distance":"15","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"hFZgvOmTlwBQmoaMqpVJP","title":"2026 Devil’s Nose Recreation Flows (CA)","post_date":"2026-04-16 17:10:22+00","detail":"2026 Recreational releases for the Devil’s Nose section of the North Fork Mokelumne River are anticipated to occur April 18th and 19th. Additional opportunistic boating may be possible on the tail-end of spill at Salt Springs. PG&amp;E has informed American Whitewater that Salt Springs Road will not be accessible as a shuttle road and that paddlers should get to put-in via Highway 88 and Ellis Road. PG&amp;E’s hydrologist indicates that “Flow at M11 during the Devil’s Nose Rec Flows this weekend are currently forecasted to be between 800-1200cfs depending on the weather. M38 flows will be higher due to snowmelt, sideflow, and outflow from Lower Bear(currently contributing 300-500cfs to the NFMR).” M11 is the gauge below salt springs and will reflect flows near the top of the reach while M38 is the gauge near the bottom of the reach and reflects additional accretion and sideflows.","user":{"name":"Jeff Venturino"}}],"photos":[],"detail":{"id":"254","permitUrl":"","permitInfo":"","description":"The Mokelumne from Salt Springs dam to Tiger Creek powerhouse is a very scenic section of river that is slowly getting greater recognition with scheduled releases and dependable flow information. The miles from Devil's Nose to Tiger Creek Powerhouse are compared to the most scenic runs in California.\n\nFrom the dam past Calaveras Dome, the river is very steep and congested as it drops through a terminal morraine. Expect difficulty to be class 5 to class 6. We have no information on boaters paddling in this section or any specific details. From the campgrounds to the Bear River confluence there are a number of class 3 and 4 rapids and possibly a borderline class 5 rapid. From Bear River down to Devil's Nose, the run is mostly class 2 and 3 with a few class 4 rapids. Starting around Devils Nose the last few miles to the Tiger Creek powerhouse contain many class 5 rapids. Many of the rapids are long and will require scouting. Mokelumne Falls is a serious drop near the end with a committing rapid immediately upstream. The very last obstacle is a gauging weir that is an easy portage.\n\nScheduled boating releases occur on weekends in the Spring of most years.\n\nThe recreational release flows on the Moke are a minimum; water year type and accretion from Cole Creek, the Bear River, and Tiger Creek proper can cause the flow observed on the North Fork Mokelumne to be greater than that number. Flows will be closer to the 700cfs or 900cfs release volume in dry years or particularly cold Springs. Please make sure you check recent flows before committing to a run!\n\n**Getting There:** The take out at Tiger Creek Powerhouse is about 20 miles or 30 minutes drive up Highway 88 from Jackson. Coming from Sacramento, drive about an hour up highway 16 to Highway 49 to Jackson. Take Highway 12 out of Lodi, or Highway 88 out of Stockton with similar distances and driving times. Turn down Tiger Creek Road to the powerhouse. The drive between the take out and put in is about 21 miles on Tiger Creek road, but will take about an hour. Alternatively you can drive back up to Highway 88, east to Ellis Road, then down Ellis Road to Tiger Creek Road. Ellis road is not plowed in winter.\n\n**Put In:** Boaters will normally launch at a developed put in just upstream of Mokelumne Campground. Boaters can launch even further upstream since the road follows the river in this area. Near Calaveras dome the gradient is steep and very bouldery with rapids of class 5 or harder difficulty. Inspect the river carefully if you choose to launch higher than the normal put in.\n\n**Take Out:** PG&amp;E asks that boaters take out upstream of the powerhouse, on river right at a picnic area. There should be a sign facing upstream warning boaters to take out. From the picnic area it is a short level walk past the powerhouse, across the creek to the parking area. Park in designated recreation spots near the powerhouse.\n\n**Other information sources:**\n\n[NF Mokelume (Devil's nose, IV-V)](http://ca49rivers.blogspot.com/2006/01/nf-mokelume-devils-nose-iv-v.html) Blog by CA49rivers\n\n[Ca-Creeks NF Moke](http://www.cacreeks.com/mok-nf.htm) description\n\n[A Wet State, trip report](http://www.awetstate.com/NMokDN.html)\n\n[John Yost Trip Report part 1](http://www.ledger-dispatch.com/sports/sportsview.asp?c=256961) in Ledger Dispatch\n\n[John Yost Trip Report part 2](http://www.ledger-dispatch.com/sports/sportsview.asp?c=257199) in Ledger Dispatch\n\nCassady &amp; Calhoun, Holbek &amp; Stanley, Martin\n\n[Foothill Conservancy](http://www.foothillconservancy.org/pages/northforkmokelumneriver.cgi)\n\n[Ecoangler.com](http://www.ecoangler.com/habitat/North_Fork_Mokelumne_River.html)\n\n[El Dorado Nat. Forest](http://www.fs.fed.us/r5/eldorado/)\n\n**FERC information:**\n\nThe entire upper Mokelumne Watershed PG&amp;E hydroelectric system is under a single FERC license, number P-137 A new license was issued on October 11, 2001 and will expire in 30 years from that date.\n\n[Text of whitewater boating monitoring plan.](http://elibrary.ferc.gov/idmws/common/opennat.asp?fileID=9793363)","averageGradient":"60","maxGradient":"110","length":"14.6","correlations":[{"reachID":"254","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"500","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"2000"},"gaugeInfo":{"name":"NF MOKELUMNE R BL SALT SPRINGS DAM","gaugeSource":"CDEC","gaugeSourceIdentifier":"M11","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"1073","dateTime":"2026-05-11T23:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":null,"location":{"latitude":"38.49361","longitude":"-120.220001"},"externalSourceLinks":{"sourceLink":{"url":"https://cdec.water.ca.gov/dynamicapp/QueryF?s=M11","text":"California Data Exchange - Station Log"},"secondaryLink":{"url":"https://cdec.water.ca.gov/cdecplotter/JspPlotAll?staid_id=M11","text":"California Data Exchange - Data Plot"}}},"migrationErrorExplanation":"Previous Flowbands: \nRange of Boatable Flows (R0-R9): 500 - 2000 cfs  Comment: Please report on actual flow range.\n\nMigration Errors: \nSingle range is valid but doesn't provide low/medium/high runnable\nThere is one comment for all of low/medium/high runnable.","comment":null,"status":{"status":"migration-runnable","latestReading":{"value":"1073","dateTime":"2026-05-11T23:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}},{"reachID":"254","isPrimary":false,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"700","beginMediumRunnable":"900","beginHighRunnable":"2000","endHighRunnable":"4000"},"gaugeInfo":{"name":"NF MOKELUMNE R AB TIGER CREEK","gaugeSource":"CDEC","gaugeSourceIdentifier":"M38","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"1354","dateTime":"2026-05-11T23:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":null,"location":{"latitude":"38.446667","longitude":"-120.489166"},"externalSourceLinks":{"sourceLink":{"url":"https://cdec.water.ca.gov/dynamicapp/QueryF?s=M38","text":"California Data Exchange - Station Log"},"secondaryLink":{"url":"https://cdec.water.ca.gov/cdecplotter/JspPlotAll?staid_id=M38","text":"California Data Exchange - Data Plot"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"medium-runnable","latestReading":{"value":"1354","dateTime":"2026-05-11T23:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["112880","101435","101434","118159"],"geometry":{"type":"LineString","coordinates":[[-120.268468,38.478894],[-120.268517,38.478842],[-120.2688,38.478229],[-120.26891,38.477949],[-120.269114,38.477713],[-120.269703,38.477522],[-120.270379,38.477466],[-120.27051,38.477472],[-120.271143,38.477502],[-120.271829,38.47756],[-120.272254,38.477666],[-120.272479,38.477804],[-120.272599,38.477861],[-120.27265,38.477864],[-120.272755,38.47787],[-120.272904,38.477777],