[{"result":{"data":{"json":{"id":"1362","stub":{"id":"1362","section":"3.  Normansville to Route 32","altname":"","river":"Normans Kill","difficulty":"IIstandoutV","states":["USA-NYO"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"90","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"waterfall","description":"Read and run shale slide.  No major holes until very high water.","id":"102236","location":{"latitude":"42.63307571411133","longitude":"-73.79786682128906"},"name":"Put-in Slide","distance":"0","difficulty":"III","approximate":false,"photoID":"0"},{"type":"waterfall","description":"Either a slide on river right, or a jumbly drop on river left. Be wary of the \"decapitator\" rock on the extreme right end of the drop as it could cause injury or a pin. Scout and portage on river left.","id":"102237","location":{"latitude":"42.6254997253418","longitude":"-73.7770004272461"},"name":"The Meat","distance":"0","difficulty":"V","approximate":false,"photoID":"0"},{"type":"put-in","description":null,"id":"108895","location":{"latitude":"42.6349","longitude":"-73.8002"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"114131","location":{"latitude":"42.6199","longitude":"-73.7668"},"name":"Take Out","distance":"3","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"1362","permitUrl":"","permitInfo":"","description":"This run takes a large rain to pop up and doesn't last long, but it is easy to get to for an after work paddle. Bring shoulder pads and a full face if you plan to run the main event, it is a sharp shale shelf.\n\nPut in at either of the river parks upstream of Delaware Ave/443.  Take out at the Rt.32 bridge in the parking lot on river right.\n\nWater quality is decent, but expect to see a lot of debris from the Irene flood towar