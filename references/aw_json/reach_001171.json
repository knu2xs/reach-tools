[{"result":{"data":{"json":{"id":"1171","stub":{"id":"1171","section":"Route 16 to Jackson Golf Course","altname":"","river":"Ellis","difficulty":"IIItoIV","states":["USA-NHM"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"3.3","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"112006","location":{"latitude":"44.186738","longitude":"-71.227261"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"117283","location":{"latitude":"44.110185","longitude":"-71.183676"},"name":"Take Out","distance":"6","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"301","ext":"jpeg","post_id":"2639","description":"","caption":"In the Heart of Ellis Gorge","poi_name":"Ellis Gorge","subject":"Ginger Cox","author":"Mike Gatewood","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/301","large":"https://api.americanwhitewater.org/image/images/big/301"}},{"id":"299","ext":"jpeg","post_id":"2639","description":"","caption":"Entrance to Ellis River Gorge","poi_name":"Ellis Gorge","subject":"Ginger Cox","author":"Mike Gatewood","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/299","large":"https://api.americanwhitewater.org/image/images/big/299"}},{"id":"300","ext":"jpeg","post_id":"2639","description":"","caption":"At The Crux of Ellis River Gorge","poi_name":"Ellis Gorge","subject":"Ginger Cox","author":"Mike Gatewood","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/300","large":"https://api.americanwhitewater.org/image/images/big/300"}}],"detail":{"id":"1171","permitUrl":"","permitInfo":"","description":"From Mike Gatewood:\n\nThe river is narrow (15' - 30') for most of the run. It was very creek-like, with lots of rocks to avoid, quick decisions to be made, and 2-3' and higher drops everywhere. The upper section called Crazy Rapids is solid class V even at low levels. From the put-in, Commencement Rapids (class IV-V) starts out with a bang. I actually put-in just below Commencement Rapids where the river becomes more class III-IVish. After about 0.5 miles there is a small class V gorge. (See photos.)\n\nAfter this rapid, the river continues for about 5 miles and is full of class III-IV drops. At the low level that we ran at, the river was not pushy, therefore less intimidating to me, and was pretty scratchy most of the way. There is one short section of class II scraping about half way down the run. You can take out at the Jackson Golf Course or continue for another 0.5 miles or so to the dam. Overall, I really enjoyed this river. Last fall, my girlfriend and I mountain biked along some trails that follow the river and were able to scout some of it, in the winter we cross-country skied along the river, in the spring we finally got to run it. The Ellis is very hard to catch at a paddleable level. We caught a window were the river ran for a couple of days; when we went back the following weekend, it was too low. If there is a few inches of rain the river will run for a day or two at the most, and spring running depends upon the melt from Mt. Washington.\n\nI kind of see it as three put-ins for the Ellis depending upon how much class V you want to do. [Lessels' and Gabler's guide](http://www.amazon.com/exec/obidos/ISBN=1878239635/thenortheastpaddA/) lists the start of the run at Commencement Rapids. The putin for Commencement Rapids (class IV-V) is about 1 mile after the Dana Place Inn on Rt. 16 N, there is a paved pull-off/picnic area with trails down to the river. If you want to avoid Commencement Rapids you can put-in at the bridge 0.5 miles past Dana Place; this is where I put in. Or if you want the full dose of the Ellis you can put in ~1.8 miles past Dana Place where the gauge is and Run Crazy Rapids (class V) as well as Commencement Rapids.\n\n**Flow Info:**\n\nThe old USGS gage was located approx. 1.3 miles past the bridge after the Dana Place Inn. There is a large orange dot on the guardrail to locate the trail to the gage hut. The new correlation is based on the Saco readings on days with good flows. 4.5 and rising should be runnable. 5 ft is likely the cut off when the gauge is falling. If you run this section please leave a comment with more beta.\n\nThere is a painted paddlers gage on the upstream stide of the center bridge abutment of the Route 16 bridge in Jackson.  A level on 1' is supposed to correspond to 2.2' on the USGS gage (which is recommended minimum paddling level).\n\nThe general consensus of our group was that 1.4' on the painted gauge is medium (not medium low or medium high).","averageGradient":"0","maxGradient":"0","length":"7.3","correlations":[{"reachID":"1171","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"4.5","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"7.5"},"gaugeInfo":{"name":"SACO RIVER AT RIVER STREET, AT BARTLETT, NH","gaugeSource":"USGS","gaugeSourceIdentifier":"010642505","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"252","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.3","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"44.08388889","longitude":"-71.2855556"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/010642505","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/010642505/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":"Previous Flowbands: \nToo Low to Boat (L0-L9): 0 - 4.49 levelFT  Comment: \nRange of Boatable Flows (R0-R9): 4.5 - 7.5 levelFT  Comment: This is an estimate based on user observations\n\nMigration Errors: \nSingle range is valid but doesn't provide low/medium/high runnable\nThere is one comment for all of low/medium/high runnable.","comment":null,"status":{"status":"below-recommended","latestReading":{"value":"3.3","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null}}],"pointOfInterestIDs":["112006","117283"],"geometry":{"type":"LineString","coordinates":[[-71.22759513890901,44.18674976435481],[-71.22760819988082,44.186378798080625],[-71.22772993321394,44.18597119808123],[-71.2280035998802,44.18542573141543],[-71.22836179987962,44.18480659808307],[-71.2285825998793,44.18452759808349],[-71.22882639987893,44.18409979808416],[-71.2288643332122,44.18361733141825],[-71.22884079987887,44.182861531419405],[-71.22878733321232,44.182623998086456],[-71.2287333332124,44.182453998086714],[-71.22854233321272,44.181989531420754],[-71.22853519987939,44.18185473142097],[-71.22856499987932,44.18175513142114],[-71.22871013321242,44.18152713142149],[-71.22875533321235,44.181089531422174],[-71.22873999987905,44.18083333142255],[-71.22864813321252,44.18057413142293],[-71.22838113321296,44.18008413142371],[-71.22806093321344,44.17982933142412],[-71.22752679988093,44.17937599809147],[-71.22709213321497,44.17919999809175],[-71.22676393321547,44.17911619809189],[-71.22649739988255,44.17900893142536],[-71.22636039988276,44.17892159809219],[-71.22541459988423,44.17821979809327],[-71.22520799988456,44.17799873142695],[-71.22500979988484,44.177736998094026],[-71.22470473321863,44.177184798094856],[-71.22467373321871,44.17668579809566],[-71.22465839988541,44.176496931429256],[-71.22472673321863,44.17571693143049],[-71.224832933218