[{"result":{"data":{"json":{"id":"1531","stub":{"id":"1531","section":"2. Hwy 22 to Hwy 18","altname":"","river":"Mill Creek","difficulty":"II","states":["USA-ORE"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"104","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"111634","location":{"latitude":"44.9922","longitude":"-123.426"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"116907","location":{"latitude":"45.0897","longitude":"-123.446"},"name":"Take Out","distance":"7","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"VbrNvZ74lEPjDuZq2pdlN","ext":"jpg","post_id":"cnF7Wnb9YgFdFSpu85t0U","description":"<p>This is the largest wave on the run, and has decent eddy service. The eddy was complicated by the branches seen next to the wave leaning over the eddy.</p>","caption":"Largest Wave","poi_name":null,"subject":"","author":"Jacob Cruser","poi_id":null,"photo_date":"2026-03-14T16:26:16.000Z","updated_at":"2026-03-17T16:26:17.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/VbrNvZ74lEPjDuZq2pdlN","large":"https://api.americanwhitewater.org/image/images/big/VbrNvZ74lEPjDuZq2pdlN"}},{"id":"tOPiYcRPvKLQDFfAafFGM","ext":"jpg","post_id":"cnF7Wnb9YgFdFSpu85t0U","description":"<p>Log portage one, taken from the log we hopped out onto before wading or paddling over to shore.</p>","caption":"Portage 1","poi_name":null,"subject":"","author":"Jacob Cruser","poi_id":null,"photo_date":"2026-03-14T16:26:17.000Z","updated_at":"2026-03-17T16:26:17.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/tOPiYcRPvKLQDFfAafFGM","large":"https://api.americanwhitewater.org/image/images/big/tOPiYcRPvKLQDFfAafFGM"}},{"id":"Xhm2ffDXJHVjqmmgazj6P","ext":"jpg","post_id":"cnF7Wnb9YgFdFSpu85t0U","description":"<p>Having fun surfing on Mill Creek</p>","caption":"","poi_name":null,"subject":"","author":"Jacob Cruser","poi_id":null,"photo_date":"2026-03-14T16:26:17.000Z","updated_at":"2026-03-17T16:26:17.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/Xhm2ffDXJHVjqmmgazj6P","large":"https://api.americanwhitewater.org/image/images/big/Xhm2ffDXJHVjqmmgazj6P"}},{"id":"hnrnr6HAvvgIsCG1vP3g7","ext":"jpg","post_id":"cnF7Wnb9YgFdFSpu85t0U","description":"<p>Fun series of surf waves along an short, eroding cliff.</p>","caption":"Cliff side waves","poi_name":null,"subject":"","author":"Jacob Cruser","poi_id":null,"photo_date":"2026-03-14T16:26:17.000Z","updated_at":"2026-03-17T16:26:17.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/hnrnr6HAvvgIsCG1vP3g7","large":"https://api.americanwhitewater.org/image/images/big/hnrnr6HAvvgIsCG1vP3g7"}},{"id":"9PhpRLBx0QWVyx14cmOFd","ext":"jpg","post_id":"cnF7Wnb9YgFdFSpu85t0U","description":"<p>An easy portage on the right.</p>","caption":"Log two","poi_name":null,"subject":"","author":"Jacob Cruser","poi_id":null,"photo_date":"2026-03-14T16:26:16.000Z","updated_at":"2026-03-17T16:26:17.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/9PhpRLBx0QWVyx14cmOFd","large":"https://api.americanwhitewater.org/image/images/big/9PhpRLBx0QWVyx14cmOFd"}}],"detail":{"id":"1531","permitUrl":null,"permitInfo":null,"description":"This is a friendly class II run with an easy shuttle that has a spattering of friendly surf waves, and a couple nice wave trains at medium flows. The creek flows through agricultural land, but is incised enough that it is not typically visible. The run can be extended by putting in a few miles upstream (44.994338009959556, -123.42063733950958) at a roadside pull out out, or by continuing downstream on the South Fork Yamhill into Sheridan. Do not put in at Mill Creek Park unless you are interested in the class V rapid just downstream. There is often wood present on the run, but don't be surprised if no portages are needed.\n\nThere is a painted gauge at the Hwy 22 bridge, 3.5 is a medium flow. Below 2 the run will probably feel low. There is no upper limit, but at 7 feet the eddies are small and the wood is a concern. It's probably too stressfull at 7 for paddlers who would normally enjoy this run. 2,000-4,000 cfs in the South Yamhill @ Willamina is probably a good medium range to shoot for if you don't already know the run (but that's not a hard-set rule).\n\nThe following video at about 3.5 covers most of the run just below the class V rapid mentioned above to just below the confluence with a swollen South Yamhill:\n\n[Mill Creek (Yamhill) SUP](https://www.youtube.com/watch?v=oTuV7i4njVU)","averageGradient":"0","maxGradient":"0","length":"6.4","correlations":[{"reachID":"1531","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1500","beginMediumRunnable":"2000","beginHighRunnable":"4000","endHighRunnable":"7000"},"gaugeInfo":{"name":"South Yamhill River near Willamina","gaugeSource":"NOAA","gaugeSourceIdentifier":"wlao3","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"104","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"2.14","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"45.047222222222","longitude":"-123.50277777778"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/wlao3","text":"NOAA Gauge Details"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"104","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty