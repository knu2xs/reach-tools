[{"result":{"data":{"json":{"id":"1361","stub":{"id":"1361","section":" Stittville to Feeder Canal","altname":"","river":"Ninemile Creek","difficulty":"II","states":["USA-NYO"]},"primaryGaugeStatus":{"status":"stale","latestReading":{"value":"164","dateTime":"2024-10-02T15:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"110409","location":{"latitude":"43.2235","longitude":"-75.2896"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"115671","location":{"latitude":"43.1784","longitude":"-75.3368"},"name":"Take Out","distance":"6","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"885001","ext":"jpeg","post_id":"887685","description":"Put in at high level. ","caption":"Put In","poi_name":"","subject":"","author":"Brennan Riolo","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/885001","large":"https://api.americanwhitewater.org/image/images/big/885001"}},{"id":"884997","ext":"jpeg","post_id":"887679","description":"Spring at low water","caption":"Spring 2015","poi_name":"","subject":"","author":"Brennan Riolo","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/884997","large":"https://api.americanwhitewater.org/image/images/big/884997"}},{"id":"884996","ext":"jpeg","post_id":"887678","description":"2 miles before take out. This is at low water.","caption":"Spring 2015","poi_name":"","subject":"","author":"Brennan Riolo","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/884996","large":"https://api.americanwhitewater.org/image/images/big/884996"}}],"detail":{"id":"1361","permitUrl":"","permitInfo":"","description":"Paddled this today. Nearby Fish Creek was at 2500 and this was more than plenty of water for the Ninemile. There is a large strainer halfway down river that requires a portage river left. Big eddy makes this very easy to avoid. The description is not correct, it should read Stittville to Canal Feeder. Put in is on Mill Street off Main Street in Stittville but others recommend putting in at Trenton on John Street. It took about an hour and 15 minutes at high water. Definitely a II-II+ at higher levels. Not a lot of eddys but plenty of big waves. I would use the Fish creek Taberg NY gauge as a guide. If Fish Creek is at 1500 or higher this is runnable\n\n**Mohawk Valley Area Reaches**\n\n[Canajoharie Creek](https://www.americanwhitewater.org/content/River/detail/id/10885/) [Caroga Creek](https://www.americanwhitewater.org/content/River/detail/id/1272/) [Cincinnati Creek](https://www.americanwhitewater.org/content/River/detail/id/3568/)\n\n[East Canada Creek](https://www.americanwhitewater.org/content/River/detail/id/1294/) [Fish Creek, E. Branch](https://www.americanwhitewater.org/content/River/detail/id/1306/) [Ninemile Creek](https://www.americanwhitewater.org/content/River/detail/id/1361/)\n\n[North Chuctanunda Creek](https://www.americanwhitewater.org/content/River/detail/id/10884/) [Nowadaga Creek](https://www.americanwhitewater.org/content/River/detail/id/5034/) [Mohawk (1.)](https://www.americanwhitewater.org/content/River/detail/id/1348/)\n\n[Oriskany Creek (Clinton)](https://www.americanwhitewater.org/content/River/detail/id/10867/)[Oriskany Creek (Oriskany Falls)](https://www.americanwhitewater.org/content/River/detail/id/10630/) [Schoharie Creek](https://www.americanwhitewater.org/content/River/detail/id/1419/)\n\n[Sprite Creek (Upper)](https://www.americanwhitewater.org/content/River/detail/id/1425/) [Sprite Creek (Lower)](https://www.americanwhitewater.org/content/River/detail/id/5062/) [Spruce Creek](https://www.americanwhitewater.org/content/River/detail/id/1426/)\n\n[Timmerman Creek](https://www.americanwhitewater.org/content/River/detail/id/408/) [West Canada Creek](https://www.americanwhitewater.org/content/River/detail/id/1453/)\n\n**[Google Map of New York Whitewater](https://www.google.com/maps/d/edit?mid=zjdnDE8H0TLg.kJnMWGapL4xk)**\n\n**[New York Whitewater Paddlers Facebook Group](https://www.facebook.com/groups/108070075877312/)**","averageGradient":null,"maxGradient":null,"length":"6.5","correlations":[{"reachID":"1361","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1500","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"4000"},"gaugeInfo":{"name":"EAST BRANCH FISH CREEK AT TABERG NY","gaugeSource":"USGS","gaugeSourceIdentifier":"04242500","gaugeFetchStatus":"ARCHIVED","latestFlowReading":{"value":"164","dateTime":"2024-10-02T15:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"4.5","dateTime":"2024-10-02T15:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"43.3011111","longitude":"-75.6214722"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/04242500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/04242500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":"Previous Flowbands: \nToo Low to Boat (L0-L9): 0 - 1500 cfs  Comment: \nRange of Boatable Flows (R0-R9): 1500 - 4000 cfs  Comment: Upper limit was estimated.\n\nMigration Errors: \nSingle range is valid but doesn't provide low/medium/high runnable\nThere is one comment for all of low/medium/high runnable.","comment":null,"status":{"status":"stale","latestReading":{"value":"164","dateTime":"2024-10-02T15:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}