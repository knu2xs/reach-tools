m/6405","large":"https://api.americanwhitewater.org/image/images/big/6405"}},{"id":"6406","ext":"jpeg","post_id":"5659","description":"Milt Aitken running one of the 20 or so Class III rapids on Town Creek.","caption":"(RM) Town Creek - 6","poi_name":"","subject":"Milt Aitken","author":"Rob Maxwell","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6406","large":"https://api.americanwhitewater.org/image/images/big/6406"}},{"id":"6408","ext":"jpeg","post_id":"5659","description":"Brian McAnnally and Milt Aitken running one of the 20 or so Class III rapids on Town Creek.","caption":"(RM) Town Creek - 8","poi_name":"","subject":"Brian McAnnally & Milt Aitken","author":"Rob Maxwell","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6408","large":"https://api.americanwhitewater.org/image/images/big/6408"}},{"id":"6409","ext":"jpeg","post_id":"5659","description":"Milt Aitken running the last of the rapids before the 1.5 mile lake paddle and the 0.5 mile uphill hike out. Yipeee!","caption":"(RM) Town Creek - 9","poi_name":"","subject":"Milt Aitken","author":"Rob Maxwell","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6409","large":"https://api.americanwhitewater.org/image/images/big/6409"}},{"id":"884610","ext":"jpeg","post_id":"887318","description":"Looking back upstream at the rapid immediately before Blockage.  ","caption":"The rapid above blockage","poi_name":"Rapid before Blockage","subject":"","author":"A Dover","poi_id":"103451","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/884610","large":"https://api.americanwhitewater.org/image/images/big/884610"}},{"id":"884609","ext":"jpeg","post_id":"887317","description":"One of the many class IIIs on Town Creek","caption":"Rapid on Town Creek","poi_name":"","subject":"","author":"A Dover","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/884609","large":"https://api.americanwhitewater.org/image/images/big/884609"}},{"id":"881178","ext":"png","post_id":"883688","description":"Mat Todhunter runs Blockage in an OC-1 ","caption":"Blockage from the bottom","poi_name":null,"subject":"Mat Todhunter","author":"Will Reeves","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/881178","large":"https://api.americanwhitewater.org/image/images/big/881178"}},{"id":"881177","ext":"png","post_id":"883687","description":"Akira Fujino runs Blockage near 600 cfs ","caption":"Kayaking Blockage","poi_name":null,"subject":"Akira Fujino","author":"Will Reeves","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/881177","large":"https://api.americanwhitewater.org/image/images/big/881177"}},{"id":"881179","ext":"png","post_id":"883689","description":"Helmet Cam view of Blockage from the top","caption":"Blockage from the top","poi_name":null,"subject":"Will Reeves","author":"Will Reeves","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/881179","large":"https://api.americanwhitewater.org/image/images/big/881179"}},{"id":"6399","ext":"jpeg","post_id":"5659","description":"","caption":"(RM) High Falls at 480 cfs","poi_name":"High Falls","subject":"","author":"Rob Maxwell","poi_id":"1176","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6399","large":"https://api.americanwhitewater.org/image/images/big/6399"}}],"detail":{"id":"81","permitUrl":"","permitInfo":"","description":"**PUT IN INFORMATION**\n\nPut in at High Falls Park just below the Falls.  The park is only open from 10am-4pm so be mindful when planning your trip. High Falls website: [http://www.seehighfalls.com/index.htm](http://www.seehighfalls.com/index.htm)\n\n**RIVER DESCRIPTION**\n\nTown Creek is a nice introduction to creeking for aspiring Alabama Creekers. The put-in is just below High Falls (class 5), a 30- 35 foot near-vertical falls, which has been run on occasion.  This would be a much more popular run if the access to the put in and take out were better and less strenuous.\n\nThe action starts quickly and continues all the way to the lake. There are class 3 rapids galore, some of which may have a few interesting slots and moves, though most are fairly straightforward. The canyon is heavily forested with large cliff bands up above.\n\nAbout two-thirds of the way down the river lies the Blockage - a big class 5 that is normally portaged. There is always a bit of apprehension because the approach to the Blockage does not look that different from the entrances of many of the class 3 rapids crowding the run. Be aware of a larger than normal horizon line and get out and scout or portage on **river right**.   The blockage is a steep rock bound series of chutes with some badly placed undercuts. An open boater was killed here a few years ago when he fell into the river and was washed into the rapid as he prepared to portage. It is often run by hardcore creekers who may be spending the day slumming on Town with less able friends.\n\nBelow the Blockage there are more class 3 rapids to the lake. The lake paddle is mild compared to some of the other Guntersville runs but there is a short hike up a hill at the take-out. This run is well worth doing especially for boaters who are not up to the tougher runs in the area. Then again, if you run High Falls and the Blockage, you've turned it into a pretty tough run.\n\n**IDENTIFYING BLOCKAGE**\n\nThere is a large house on the ridge line on river left which, will be seen before you get to Blockage. After a good rain there will also be a waterfall on river left.  Locals say Blockage is clearly marked, however besides one tree on river right with a white band of paint around it, we didn't see many markings until we got halfway through the portage - which was about mid rapid.  There are also two large boulders on river right just above the portage point.\n\n**FINDING THE TAKEOUT FROM THE LAKE**\n\nCars are not visible from the lake so here is a description of how to find the trail to the cars from the lake:\n\nThe lake paddle is about 1.5 miles, about a third of the way in there is a large wooded island on the right side of the channel. At about 1.3 miles there is a second small island in the middle of the channel with 4 or 5 trees growing on it. The trail is just beyond this island. Begin heading to the right shore. There is a small fishing shack. About 50 yards past the shack is a small creek coming into the lake, follow old road bed up along creek to AL 227.\n\nNOTE: DO NOT USE THIS TAKEOUT:  This historic takeout  is initially on State Park lands however landowners have contacted AW to let us know that the trail promptly enters and crosses private, posted lands that are leased for hunting.  The landowners have asked that paddlers NOT USE this takeout, which requires use of private land.  Paddlers should find a new takeout and post it to this site as soon as possible.\n\n**NEWER TAKEOUT INFORMATION**\n\nThe newer takeout is about 100 yards down the shoreline, past the small creek (Duvall Branch) coming into the lake.  There is a steep, but somewhat short, hike up to a horse trail.  Turn right and follow the horse trail. You will come out by an old cemetery, Smith Cemetery, on the side of County Road 227.  \\*\\*This does cross a small piece of non-State Park land, just use caution\\*\\*\n\nWhitewater Sourcebook, by Richard Penny (Menasha Ridge Press; 1989)\n\nSee also [www.alabamawhitewater.com](http://www.alabamawhitewater.com/guide/guide_files2/townlow.htm)","averageGradient":"44","maxGradient":"80","length":"7.3","correlations":[{"reachID":"81","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"250","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"2000"},"gaugeInfo":{"name":"TOWN CREEK NEAR GERALDINE AL","gaugeSource":"USGS","gaugeSourceIdentifier":"03572900","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"105","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.54","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"34.37846153","longitude":"-85.9902429"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/03572900","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/03572900/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"105","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["1176","103450","114626"],"geometry":{"type":"LineString","coordinates":[[-86.06797303669387,34.40005533538764],[-86.06802217684555,34.400079279937586],[-86.06803791017882,34.40008787993753],[-86.06816751017863,34.4001592132708],[-86.06841557684493,34.400306079937195],[-86.06869051017782,34.40053627993683],[-86.06872557684443,34.4005578799368],[-86.06898177684407,34.40069507993661],[-86.06905737684389,34.40073107993658],[-86.06911397684382,34.400765479936524],[-86.06916877684375,34.40082147993638],[-86.06920091017702,34.40084561326972],[-86.06923657684365,34.400866479936326],[-86.06934457684349,34.400926813269564],[-86.06982857684272,34.401170279935855],[-86.07006017684233,34.4012706