[{"result":{"data":{"json":{"id":"1000","stub":{"id":"1000","section":"4) Hwy 287 Bridge to Missouri R.","altname":"","river":"Dearborn","difficulty":"IItoIII","states":["USA-MNT"]},"primaryGaugeStatus":{"status":"medium-runnable","latestReading":{"value":"306","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"109450","location":{"latitude":"47.1987991333008","longitude":"-112.096298217773"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":"As you enter into steep canyon walls, JDR involves a few moves through a boulder garden followed by a move to river right in order to catch the main tongue. Pulling over river right before this stretch gives a great scouting option. Scouting is not necessary but recommended at lower water levels to avoid a flat pin with a heavier boat.","id":"UqygyLuRBduHJjFOJv2oq","location":{"latitude":"47.192638","longitude":"-112.008597"},"name":"Janice Dearborn's Revenge","distance":"6.74","difficulty":"II+","approximate":false,"photoID":"887886"},{"type":"rapid","description":"The Garden is a straightforward read a run section that at low water provides many opportunites to get stuck in shallow spots. As you enter this section, you can pick any line that looks deep enough but you want to end up river right to catch the main tongue that pushes from river right to river center.\n\nScouting option on river left when entering the boulder garden section, it's notable for the amount of exposed rocks you'll see in comparison to the rest of the river.","id":"SUSFcZgrsIzNeMd5Y3p8X","location":{"latitude":"47.167846","longitude":"-111.971818"},"name":"The Garden","distance":"12.95","difficulty":"II+","approximate":false,"photoID":"ldl8LF0w3WlfgkfOqvbcZ"},{"type":"takeout","description":null,"id":"114694","location":{"latitude":"47.1269989013672","longitude":"-111.909599304199"},"name":"Take Out","distance":"16","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"rmh75fA3iKjGmC3CIh355","title":"New Fence at Hwy 287","post_date":"2023-05-23 17:55:19+00","detail":"There are reports of a new dangerous barbed wire fence very close to and just upstream of Highway 287.","user":{"name":"Kevin Colburn"}}],"photos":[{"id":"887886","ext":"jpeg","post_id":"890691","description":"Packrafting the Dearborn. ","caption":"Dearborn Canyon ","poi_name":null,"subject":null,"author":"Tim Kelley","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887886","large":"https://api.americanwhitewater.org/image/images/big/887886"}},{"id":"42433","ext":"jpeg","post_id":"9134","description":"between Flat Cr and Sullivan Cr","caption":"below Flat Creek","poi_name":"","subject":"D-man","author":"Dave Amman","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/42433","large":"https://api.americanwhitewater.org/image/images/big/42433"}},{"id":"17571","ext":"jpeg","post_id":"9349","description":"","caption":"Dearborn put in","poi_name":"","subject":"lower canyon put in","author":"Chris Goble","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17571","large":"https://api.americanwhitewater.org/image/images/big/17571"}},{"id":"17572","ext":"jpeg","post_id":"9349","description":"","caption":"start of canyon","poi_name":"","subject":"start of canyon","author":"Chris Goble","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17572","large":"https://api.americanwhitewater.org/image/images/big/17572"}},{"id":"17574","ext":"jpeg","post_id":"9348","description":"This is the open area after the first canyon and \r\nbefore the narrow winding final canyon.","caption":"opening between canyons","poi_name":"","subject":"","author":"Chris Goble","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17574","large":"https://api.americanwhitewater.org/image/images/big/17574"}},{"id":"17575","ext":"jpeg","post_id":"9349","description":"This is looking back up at the only really \r\nsubstantial rapid.  It is a shallow boulder garden \r\ntha begins around the bend to the right and ends \r\nwith some Class 2 wave holes.  It could be \r\nchallenging for canoes.","caption":"Rapids","poi_name":"","subject":"","author":"Chris Goble","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17575","large":"https://api.americanwhitewater.org/image/images/big/17575"}},{"id":"17573","ext":"jpeg","post_id":"9349","description":"","caption":"more canyons","poi_name":"","subject":"","author":"Chris Goble","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17573","large":"https://api.americanwhitewater.org/image/images/big/17573"}},{"id":"887211","ext":"jpeg","post_id":"889911","description":"","caption":"Dearborn overnight! ","poi_name":null,"subject":null,"author":"Kevin Colburn","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887211","large":"https://api.americanwhitewater.org/image/images/big/887211"}},{"id":"ldl8LF0w3WlfgkfOqvbcZ","ext":"jpg","post_id":"UNgTft2ckbTfglJKikILH","description":"The Garden section as it begins to present more and more exposed rock.","caption":"The Garden ","poi_name":null,"subject":"","author":"Ethan Bowen","poi_id":"SUSFcZgrsIzNeMd5Y3p8X","photo_date":"2025-05-11T20:20:48.000Z","updated_at":"2025-05-13T20:20:48.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/ldl8LF0w3WlfgkfOqvbcZ","large":"https://api.americanwhitewater.org/image/images/big/ldl8LF0w3WlfgkfOqvbcZ"}},{"id":"PopTWUFAOSqk0bWXgpt38","ext":"jpg","post_id":"Uw2vcwZCQRsnKwvqYILlD","description":"","caption":"Colin Burdsall Loving the Sunshine","poi_name":null,"subject":"Colin Burdsall","author":"Ethan Bowen","poi_id":null,"photo_date":"2025-05-11T20:04:54.000Z","updated_at":"2025-05-13T20:04:54.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/PopTWUFAOSqk0bWXgpt38","large":"https://api.americanwhitewater.org/image/images/big/PopTWUFAOSqk0bWXgpt38"}},{"id":"lBNUCMpVUwZqUDEKi6mFp","ext":"jpg","post_id":"UNgTft2ckbTfglJKikILH","description":"Ethan Bowen running the far right line in The Garden at 160cfs. sneak lines and creativity encouraged to catch the main tongue at this level","caption":"Low Flow Sneak Lines","poi_name":null,"subject":"Ethan Bowen","author":"Ethan Bowen","poi_id":"SUSFcZgrsIzNeMd5Y3p8X","photo_date":"2025-05-11T20:20:48.000Z","updated_at":"2025-05-13T20:20:48.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/lBNUCMpVUwZqUDEKi6mFp","large":"https://api.americanwhitewater.org/image/images/big/lBNUCMpVUwZqUDEKi6mFp"}}],"detail":{"id":"1000","permitUrl":null,"permitInfo":null,"description":"chris goble shared:\n\nMost of the river is Class I+. The challenge is mainly to keep from hitting the cliff walls that the run goes by. There are 3 rapids that I can remember. The first two are easy II and the last is a shallow boulder garden that runs for a 100m or so before a turn and some medium sized waves. Class II+ or III-. This is one of the prettiest rivers I have seen. There is a small playspot for kayaks about 50m below the put in bridge. The majority of the run is distinguished by the spectacular canyons it goes through. The first canyon is fairly wide open with fairly low walls. Another section has extremely tall cliffsbut is still fairly open. The last section reminds me of a flooded slot canyon in Utah. It is very windy with cliffs extending right into the river.",