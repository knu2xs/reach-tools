[{"result":{"data":{"json":{"id":"1154","stub":{"id":"1154","section":"3. Bretton Woods to Twin Mountain","altname":"","river":"Ammonoosuc","difficulty":"IItoIII","states":["USA-NHM"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"2.35","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"takeout","description":null,"id":"117026","location":{"latitude":"44.2700996398926","longitude":"-71.5408020019531"},"name":"Take Out","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"put-in","description":null,"id":"111754","location":{"latitude":"44.2545013427734","longitude":"-71.4376983642578"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":"A harder rapid on this reach. At 3.8ft it was a Class III+. While none of the moves were especially difficult, they were stacked up for almost 200yds making a thorough scout hard, recovery difficult and swims unpleasant.","id":"si6ogDhr3iICDgbJXRaGN","location":{"latitude":"44.267356","longitude":"-71.527448"},"name":"Roadside Rapid","distance":"6.24","difficulty":"III+","approximate":false,"photoID":"ScMVmvi7fp48kQ89unC6v"}],"alerts":[],"photos":[{"id":"DK2sr0dfh0V25PqFHLE59","ext":"jpg","post_id":"vP4okfkJRrxuJS5qHDKJ7","description":"","caption":"","poi_name":null,"subject":"","author":"Samuel Bernstein","poi_id":null,"photo_date":"2021-05-02T16:11:16.000Z","updated_at":"2025-04-03T16:11:16.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/DK2sr0dfh0V25PqFHLE59","large":"https://api.americanwhitewater.org/image/images/big/DK2sr0dfh0V25PqFHLE59"}},{"id":"ScMVmvi7fp48kQ89unC6v","ext":"jpg","post_id":"vP4okfkJRrxuJS5qHDKJ7","description":"","caption":"","poi_name":null,"subject":"","author":"Samuel Bernstein","poi_id":null,"photo_date":"2021-05-02T16:11:16.000Z","updated_at":"2025-04-03T16:11:16.000Z","u