[{"result":{"data":{"json":{"id":"691","stub":{"id":"691","section":"W Hartland Rd (Granville State Park) to Rt 20","altname":"Hubbard Brook","river":"Hubbard","difficulty":"V","states":["USA-MSS"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"1.05","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"109367","location":{"latitude":"42.064","longitude":"-72.9658"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"waterfall","description":null,"id":"6SWx6HfsRPlFlXK53F3Uz","location":{"latitude":"42.058781","longitude":"-72.965269"},"name":"Seven Foot Falls","distance":"0.38","difficulty":"III","approximate":false,"photoID":null},{"type":"rapid","description":null,"id":"SffME8Qr4zzrPG9o1mpEf","location":{"latitude":"42.0544","longitude":"-72.96206"},"name":"Bow Pin","distance":"0.75","difficulty":"IV","approximate":false,"photoID":null},{"type":"takeout","description":null,"id":"114608","location":{"latitude":"42.0374","longitude":"-72.9391"},"name":"Take Out","distance":"2.65","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"885886","ext":"jpeg","post_id":"888648","description":"","caption":"Hubbard 3","poi_name":null,"subject":null,"author":"Benjamin Trister","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/885886","large":"https://api.americanwhitewater.org/image/images/big/885886"}},{"id":"885884","ext":"jpeg","post_id":"888646","description":"","caption":"Hubbard 2","poi_name":null,"subject":null,"author":"Benjamin Trister","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/885884","large":"https://api.americanwhitewater.org/image/images/big/885884"}},{"id":"885881","ext":"jpeg","post_id":"888643","description":"","caption":"Hubbard Splat","poi_name":null,"subject":null,"author":"Benjamin Trister","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/885881","large":"https://api.americanwhitewater.org/image/images/big/885881"}},{"id":"885882","ext":"jpeg","post_id":"888644","description":"","caption":"Hubbard Slide","poi_name":null,"subject":null,"author":"Benjamin Trister","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/885882","large":"https://api.americanwhitewater.org/image/images/big/885882"}},{"id":"885885","ext":"jpeg","post_id":"888647","description":"First decent was by Jim Michaud","caption":"Michaud Falls","poi_name":"","subject":"","author":"Benjamin Trister","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/885885","large":"https://api.americanwhitewater.org/image/images/big/885885"}},{"id":"885883","ext":"jpeg","post_id":"888645","description":"","caption":"Hubbard","poi_name":null,"subject":null,"author":"Benjamin Trister","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/885883","large":"https://api.americanwhitewater.org/image/images/big/885883"}},{"id":"5718","ext":"jpeg","post_id":"6425","description":"","caption":"Hubbard Brook","poi_name":"Michaud Falls","subject":"James Sullivan","author":"Owen Callahan","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5718","large":"https://api.americanwhitewater.org/image/images/big/5718"}}],"detail":{"id":"691","permitUrl":"","permitInfo":"","description":"The usual put-in is at the head of the rapid just above the bridge. If you’re not comfortable with this rapid it is suggested that you take out now because the river gets more difficult downstream.  After Bridge Rapid it’s class III boogie water until you get to a large boulder on river left. Right behind the boulder is Seven Foot Falls which is a near vertical drop into a large pool. It’s best to stay right as you go over the drop.\n\nShortly after Seven Foot Falls is Bow Pin Rapid which is worth scouting. In the old days 13-foot boats use to pin their bows if they ran straight over the drop. The best plan is to angle your boat to the right as you go over or cut hard left and bounce over the rocks.\n\nRight after Bow Pin is Bumpy Slide which is pretty bumpy. There’s no problem with it unless you’re paddling a pointy boat. Who uses pointy boats in a creek now-a-days anyhow?\n\nNext up is a couple of river wide ledges about six feet high that should be scouted. If you run them wrong you could get recirculated. Right after the second ledge is a short, tight rapid that ends right above Michaud Falls. At the top of Michaud Falls there’s a ledge outcropping on the left and a giant boulder in the center making the entrance only a few feet wide. The water drops several feet and lands on a steep slope that’s full of rooster tails and holes. If you run straight over the drop you will be pushed left and slammed against some rocks. The preferred route is to enter the narrow slot from the left and just miss the boulder as you go right. You’re now over half way down the river.\n\n**Hazard Warning:** Around 100 yards or so below Michaud Falls is a low ledge on river right that’s almost river wide with an easy passage on the left. This ledge has a very serious hydraulic.  It claimed the life of a very skilled paddler who knew the run well. [Click here](http://www.americanwhitewater.org/content/Accident/detail/accidentid/3294/) for the accident report.\n\nBelow here the river gets steeper and tighter almost all the way to the end. Near the end, the river opens up a bit and gets a bit easier.  Near the start of this section are two short, shallow slides that have keepers at the bottom. Many people have been trapped there and had to exit their boats.\n\nAfter the easy section is the last major rapid which is to the right of an island and is very steep. The route is to enter on the right and get left as soon as you can. Below here there’s a class III rapid which ends at the gaging station which is the take-out.\n\nDO NOT paddle below the gaging station. The property belongs to the Connecticut MDC Water District for a water supply and is part of their watershed. They don’t object to our paddling the river as long as we don’t paddle past the gaging station. Please don’t blow it for the rest of us by paddling any farther.\n\nDaniel Holzman shared in 2002:\n\nThis is a remote, very beautiful run through a mature coniferous forest. Recommended absolute minimum level is 2.7 on the gage at the takeout dam, although I have banged down it at 2.3 on the gage. The river below the dam is posted off-limits by Connecticut because it is a water supply. It isn't worth the extra 150 feet of whitewater to run the dam and risk alienating the authorities.","averageGradient":"130","maxGradient":null,"length":"2.6","correlations":[{"reachID":"691","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"3","beginMediumRunnable":"3.5","beginHighRunnable":"4.25","endHighRunnable":"4.75"},"gaugeInfo":{"name":"HUBBARD RIVER NEAR WEST HARTLAND, CT","gaugeSource":"USGS","gaugeSourceIdentifier":"01187300","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"16","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.05","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"42.0375","longitude":"-72.93932778"},"externalSourceLinks":{"so