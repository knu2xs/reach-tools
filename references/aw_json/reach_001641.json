[{"result":{"data":{"json":{"id":"1641","stub":{"id":"1641","section":"T318 to Harney Road","altname":"","river":"Middle Creek (Toms Creek trib.)","difficulty":"IIplus","states":["USA-MRY","USA-PEN"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"41","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"112262","location":{"latitude":"39.7468","longitude":"-77.309"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"117545","location":{"latitude":"39.7067","longitude":"-77.2958"},"name":"Take Out","distance":"6.3","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"1641","permitUrl":"","permitInfo":"","description":"The first 4.2 miles is class I, so many paddlers only do the final 2.1 miles, starting at Shorbs Mill Road (39.73262°,-77.29755°).\n\nEd Evangelidi shared:\n\nThis is a good creek to combine with a [Marsh Creek](http://www.americanwhitewater.org/rivers/id/1634/) paddle, only do it first as it drops faster. This creek has longer but easier rapids than Marsh Creek and the longest and hardest rapid is at the end and is hardest at low water. Strainers seem to fortunately fall in the slower water sections generally. There is a good visual gauge at the takeout road. Look at the downstream right side. There is a groove in the concrete and the groove equals 3 inches of usable water. Make sure you take out above the dam. There is another small dam just below the takeout that is easy to run but is hard on boats.\n\nFor more information, see _Keystone Canoeing_ by Gertler, E.","averageGradient":"18","maxGradient":"50","length":"3.7","correlations":[{"reachID":"1641","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeCo