[{"result":{"data":{"json":{"id":"134","stub":{"id":"134","section":"Bloomsbury to Delaware River","altname":"","river":"Musconetcong","difficulty":"II","states":["USA-NJR"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"154","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"This run has lot's of choices for put-ins and take-outs. We usually put in at the Bloomsbury bridge (upstream,  river right) and take-out a few hunderd yards after the factory on Milford-Warren Glen Rd. on river right.\n\nYou can also paddle all the way to the Delaware and take out on the River left parking area.","id":"108936","location":{"latitude":"40.658848","longitude":"-75.080232"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"portage","description":"If you have a whitewater boat and can roll it consistently, this is a fun slide into a big pool. Go down the middle. If you can't roll, and/or you're in a rec kayak, you probably won't have as much fun. You may end up taking a painful swim into the ledgy rapids that follow the dam.","id":"22uOmj1tov1ktJJGrqpmL","location":{"latitude":"40.636237","longitude":"-75.120432"},"name":"Dam Slide","distance":"2.86","photoID":"YIcVwPoilgqpAKrbcBYLm","difficulty":"III+","approximate":false},{"type":"takeout","description":null,"id":"114173","location":{"latitude":"40.592377","longitude":"-75.188634"},"name":"Take Out","distance":"8.48","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"887996","ext":"jpeg","post_id":"890814","description":"","caption":"","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887996","large":"https://api.americanwhitewater.org/image/images/big/887996"}},{"id":"887997","ext":"jpeg","post_id":"890815","description":"","caption":"","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887997","large":"https://api.americanwhitewater.org/image/images/big/887997"}},{"id":"887995","ext":"jpeg","post_id":"890813","description":"Gorge dam","caption":"","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887995","large":"https://api.americanwhitewater.org/image/images/big/887995"}},{"id":"50861","ext":"jpeg","post_id":"230566","description":"","caption":"","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/50861","large":"https://api.americanwhitewater.org/image/images/big/50861"}},{"id":"YIcVwPoilgqpAKrbcBYLm","ext":"jpg","post_id":"iOzhdGuu6Wsv5fSFIDLfI","description":"a big fun water slide after paddling across a pond. take out on the right in the mud to scout.","caption":"Musconetcong Dam","poi_name":null,"subject":"Ricky Strange","author":"Stephen W. Strange","poi_id":null,"photo_date":"2023-09-10T14:36:52.000Z","updated_at":"2023-09-10T14:36:52.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/YIcVwPoilgqpAKrbcBYLm","large":"https://api.americanwhitewater.org/image/images/big/YIcVwPoilgqpAKrbcBYLm"}}],"detail":{"id":"134","permitUrl":null,"permitInfo":null,"description":"Luke Kornbluh contributes:\n\nRan this section on July 26, 2009 with the Bloomsbury gauge at 1.5 feet. The water was very low but we had some conflicting beta and decided to try it anyway. We scraped over a lot of stuff, but as some in our group were novices without full gear it made an appropriate destination. The mile or so following the second pair of railroad tunnels contains the most action. Experienced whitewater paddlers will be underwhelmed. Although the 200-yard rock garden at the heart of this section would be delightful at higher levels, it is all too short and doesn't justify the long flat sections before and after. It would probably be more accurate to say that this run is Class C to I with maybe two or three very short Class-II drops. This run appears to get none of the traffic of the popular flatwater rivers in the Pine Barrens.\n\n**Other Information Sources:**\n\n**https://www.musconetcong.org/** Muscenotcong Watershed Association","averageGradient":null,"maxGradient":null,"length":"8.5","correlations":[{"reachID":"134","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"100","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"400"},"gaugeInfo":{"name":"Musconetcong River near Bloomsbury NJ","gaugeSource":"USGS","gaugeSourceIdentifier":"01457000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"154","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.58","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"40.67222222","longitude":"-75.06083333"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/01457000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/01457000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":"Previous Flowbands: \nLow Runnable (R0-R4): 100 - 250 cfs  Comment: \t\t\r\n\r\n\r\n\nHigh Runnable (R6-R9): 250 - 400 cfs  Comment: Beware of low bridges at flows above 250 cfs.\t\r\n\r\n\r\n\n\nMigration Errors: \nFor two ranges, R0 to R9 is not covered exactly","comment":null,"status":{"status":"migration-runnabl