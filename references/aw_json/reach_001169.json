[{"result":{"data":{"json":{"id":"1169","stub":{"id":"1169","section":"Last half mile before Middle Fork Boise River","altname":"","river":"Sheep Creek (MF Boise trib)","difficulty":"IIItoIV","states":["USA-IDA"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"111682","location":{"latitude":"43.6896018981934","longitude":"-115.658699035645"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"116956","location":{"latitude":"43.6967010498047","longitude":"-115.660202026367"},"name":"Take Out","distance":"0.5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"1169","permitUrl":null,"permitInfo":null,"description":"From Dave Garrity:\n\nPut-in: carry up until there are too many logs\n\nTake-out: Middle Fork Boise River\n\nThe run is a quarter mile long rapid that is pretty much a fast slant\ndownhill that ends in an eddy next to the wall. I forgot to mention to hit\nthe tree partway down to the far left with your head down and paddle\nlongways to avoid an ugly crash and burn. At the eddy, there's portage\naround a log and then the remaining slide to the Middle Boise. It's a highly\namusing 10 minutes. No one that I had talked to had ever heard of it being\ndone, but I'm sure some of the Boise-area boaters had done the run before I\ndid. No real carnage occurred.","averageGradient":"160","maxGradient":null,"length":"0.6","correlations":[],"pointOfInterestIDs":["111682","116956"],"geometry":{"type":"LineString","coordinates":[[-115.65922073091406,43.68909919885249],[-115.65945719758038,43.68929379885219],[-115.65960213091347,43.689411998851995],[-115.65973193091328,43.68958373218504],[-115.65990739757969,43.68983919885136],[-115.66001419757947,43.690060532184305],[-115.66008279757938,43.69019779885076],[-115.66008293091274,43.69041153218376],[-115.66010573091268,43.69067473218337],[-115.66014393091262,43.69087