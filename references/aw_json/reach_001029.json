[{"result":{"data":{"json":{"id":"1029","stub":{"id":"1029","section":"S. Fork Tenderfoot to Smith R.","altname":"","river":"Tenderfoot Creek","difficulty":"IItoIIIplusstandoutIV","states":["USA-MNT"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"109451","location":{"latitude":"46.950001","longitude":"-111.150002"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"114695","location":{"latitude":"46.941898","longitude":"-111.293297"},"name":"Take Out","distance":"11","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"1029","permitUrl":null,"permitInfo":null,"description":"Tenderfoot has three distinct sections:\n\nAbove the ranch bridge (near the put in shown on the map), is good to around Fischer Creek or a hair above, where the volume is marginal and the wood gets out of hand.  This stretch is class II++ fast and narrow with IV decision making.\n\nThe ~1/3 mile below the ranch bridge drops into a very cool, quite narrow, 100 foot deep gorge with a number of small drops and rapids, culminating in a 12 foot waterfall.  IVish with wood potential and difficult scouting at times.  Portage on the north side if needed!\n\nBelow the waterfall to the Smith is awesome, scenic II/II+.  Wood potential but tends to be fairly clean.  The last 1/4 mile goes through Wilkes Bros land, but at all but the highest flows it is possible to wade back upstream within the high water mark if you are not set to continue downstream on the Smith.","averageGradient":null,"maxGradient":null,"length":"9.2","correlations":[],"pointOfInterestIDs":["109451","114695"],"geometry":{"type":"LineString","coordinates":[[-111.149962,46.950089],[-111.150038,46.950123],[-111.150222,46.950303],[-111.150341,46.950366],[-111.150499,46.950384],[-111.15063,46.95033],[-111.150774,46.950167],[-111.150865,46.949942],[-111.15097,46.949717],[-111.151074,