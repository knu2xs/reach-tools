icanwhitewater.org/image/images/medium/884671","large":"https://api.americanwhitewater.org/image/images/big/884671"}},{"id":"11279","ext":"jpeg","post_id":"8663","description":"Adam going big at Sticky hole","caption":"Air adam","poi_name":"Sticky Hole","subject":"Adam Kennon","author":"Clint Wall","poi_id":"103306","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/11279","large":"https://api.americanwhitewater.org/image/images/big/11279"}},{"id":"3436","ext":"jpeg","post_id":"5616","description":"A view of the pot hole and sieve in the bottom of the drop at extremely low water. ","caption":"Pot hole in left line","poi_name":"Falls / Left Line","subject":"","author":"Van Atkins","poi_id":"103261","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3436","large":"https://api.americanwhitewater.org/image/images/big/3436"}},{"id":"3440","ext":"mpg","post_id":"5616","description":"Mitch shows how to flip in Sticky Hole.","caption":"Flip at sticky hole","poi_name":"Sticky Hole","subject":"Mitch Holla","author":"Van Atkins","poi_id":"103261","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3440","large":"https://api.americanwhitewater.org/image/images/big/3440"}},{"id":"19382","ext":"jpeg","post_id":"9708","description":"River left line,","caption":"Tallapoosa falls- Left line","poi_name":"the Falls","subject":"Charlie Simmons","author":"Charlie Simmons","poi_id":"103262","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/19382","large":"https://api.americanwhitewater.org/image/images/big/19382"}},{"id":"884672","ext":"jpeg","post_id":"887386","description":"","caption":"Roller Coaster","poi_name":"Roller Coaster","subject":"D Farmer","author":"A Dover","poi_id":"103260","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/884672","large":"https://api.americanwhitewater.org/image/images/big/884672"}},{"id":"884520","ext":"jpeg","post_id":"887219","description":"Some play spots begin to form at 5000 cfs","caption":"Powerline shoals 5000 cfs","poi_name":"Powerline Shoals","subject":"D Farmer","author":"A Dover ","poi_id":"103258","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/884520","large":"https://api.americanwhitewater.org/image/images/big/884520"}},{"id":"884576","ext":"jpeg","post_id":"887281","description":"Tyler runs the left line at Tallapoosa Falls","caption":"Running the left line at the Falls","poi_name":"Tallapoosa Falls","subject":"Tyler Poole","author":"A Dover ","poi_id":"103262","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/884576","large":"https://api.americanwhitewater.org/image/images/big/884576"}}],"detail":{"id":"79","permitUrl":"","permitInfo":"","description":"The Tallapoosa is a short, dam-release whitewater river. The put in resembles a lake and some boaters have mistaken it as the wrong river. The takeout is a public boat ramp below the Falls. The river was once similar to Great Falls of the Potomac but now most of the gradient is under a lake. Portions of the Class V+ at the base of Thurlow Dam (as well as the dam) have been run.\n\nThis is one of the few Alabama rivers that is runnable all year long.  Alabama power maintains a minimum flow of 1270 cfs (1 turbine on Thurlow Dam), which makes for a technical, but doable run.  If you run the Falls at this level your main option is boofing 'The Finger.'  Half the art and science of catching bigger water runs on Tallapoosa can be figured out by watching for releases on Yates Dam, which is just upstream of Thurlow.  A one turbine release on Yates (for more than 1 hour) = 5,000 cfs+ (or more) on Tallapoosa.  Two turbines on Yates (for more than 1 hour) = 10,000 cfs+ on Tallapoosa.  Alabama power changes the schedule daily, so it's best to check both Yates and Thurlow before you head out: [https://apcshorelines.com/our-lakes/](https://apcshorelines.com/our-lakes/)\n\n**River Levels**\n\n1277 cfs. - Scrapy, not a lot of play.  Falls are still fun, but use caution.  Good, forgiving level for beginners.\n\n5000-7000 cfs - Some play spots develop.  Good for intermediate level paddlers\n\n10000 cfs - Big holes and wave trains develop.  Play spots start to get good.  Having a reliable roll, good ferrying skills and the ability to read water is a must at this level and up.\n\n11000-13000 cfs - Excellent play spots and surf waves.\n\nThe Tallapoosa starts off as flat water and quickly hits the fall line. The river has numerous good play spots that are playable at various water levels. Most of the Tallapoosa is an easy class II+ run on a big open river. About ¼ mile from the dam look for Sticky Hole on the left 1/3 of the river. If you get stuck in one of the large holes above the falls and swim it would be very bad. After the waves let up for about 200 yards look for Big O a wave/hole near the right bank.\n\nThe major point of difficulty is Tallapoosa Falls or the Falls. After a ride or two at Big O work left around the first island or ferry right and get ready for the falls. There are good lines at the falls on the right of the second island and at the river right. Avoid the middle at all costs unless you really know where you are going. If you run the falls on the right, carry plenty of speed. Below the falls at 12,500 cfs and up you may find the Bionic Wave. The Falls are technically easy but are full of potholes, caves, pinning spots and other hazards. Most boaters take the run down the left side of the island and miss the Falls.\n\n_(Modified from a description by Bill Patterson and Will Reeves)._\n\nSee also [www.alabamawhitewater.com](http://www.alabamawhitewater.com/guide/guide_files2/tallapoosa.htm).","averageGradient":"19","maxGradient":"60","length":"1.6","correlations":[{"reachID":"79","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"2","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"10"},"gaugeInfo":{"name":"TALLAPOOSA RIVER AT MILSTEAD AL","gaugeSource":"USGS","gaugeSourceIdentifier":"02419500","gaugeFetchStatus":"ACTIVE","latestFlowReading":null,"latestStageReading":{"value":"2.8","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"32.44902654","longitude":"-85.897458"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/02419500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/02419500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"migration-runnable","latestReading":{"value":"2.8","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null}}],"pointOfInterestIDs":["103257","103306","103262","103263"],"geometry":{"type":"LineString","coordinates":[[-85.88844605777592,32.53196081367816],[-85.88903417712334,32.52793001617687],[-85.88901611045668,32.527070016178186],[-85.88924871045634,32.52601288284649],[-85.88928691045629,32.52511741618122],[-85.88971657712227,32.52418121618268],[-85.88991591045533,32.5235578828503],[-85.89002271045513,32.523100616184365],[-85.89020631045486,32.52160241618668],[-85.89052577712101,32.52040308285518],[-85.89050977712105,32.519616682856395],[-85.89067337712078,32.51907121619058],[-85.8908123104539,32.517873882859135],[-85.89082117712059,32.517407816193156],[-85.8906977104541,32.5167344828609],[-85.89030617712137,32.51552481619609],[-85.8