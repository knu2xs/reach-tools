[{"result":{"data":{"json":{"id":"338","stub":{"id":"338","section":"1. Wild Plum Campground to Downieville","altname":"Wild Plum","river":"Yuba, North","difficulty":"IVtoV","states":["USA-CAL"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"681","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Loves Falls are a series of pool-drop cascades that vary considerably with volume. This area is just below Salmon Creek coming down from the Sierra Buttes.","id":"2486","location":{"latitude":"0","longitude":"0"},"name":"Loves Falls","distance":"0","photoID":"9001","difficulty":"V","approximate":false},{"type":"put-in","description":"Travel HWY 49 North East from Downieville for 12 miles to Sierra City. Continue uphill through Sierra City and turn right following signs to Wild Plum Campground. Put-in is available at first bridge crossing 1/2 mile from HWY 49.","id":"2497","location":{"latitude":"0","longitude":"0"},"name":"Put-In","distance":"0","photoID":null,"difficulty":null,"approximate":false},{"type":"waterfall","description":"This rapid begins with a quick shelf that slides river right up against an undercut wall. Different levels can make this rapid a portage for some boaters.","id":"2496","location":{"latitude":"0","longitude":"0"},"name":"Whorehouse","distance":"2.4","difficulty":"IV","approximate":false,"photoID":null},{"type":"portage","description":"this dam should be scouted\nthe hole can get retentive and the dam debris downstream is a hazard","id":"2487","location":{"latitude":"0","longitude":"0"},"name":"Gillespie Dam","distance":"2.9","photoID":null,"difficulty":"IV","approximate":false},{"type":"access","description":"the first view of HWY49 from the creek","id":"2488","location":{"latitude":"0","longitude":"0"},"name":"Highway Rapid","distance":"5.1","photoID":null,"difficulty":"IV","approximate":false},{"type":"waterfall","description":"Scout this rapid from the road on the way up.\nOr, scout river left.\nCaution: higher flows cause Ladies Canyon hole to be riverwide. This is a hole that you want to be upright after hitting because you are headed directly into action.","id":"2489","location":{"latitude":"0","longitude":"0"},"name":"Ladies Canyon Rapid","distance":"6.5","difficulty":"V","approximate":false,"photoID":null},{"type":"access","description":"This campground is typically used by rafters running commercial trips.","id":"2492","location":{"latitude":"0","longitude":"0"},"name":"Union Flat Campground","distance":"7","photoID":null,"difficulty":"III","approximate":false},{"type":"waterfall","description":"Moss Canyon is away from the road and becomes a section of this run not to forget at high water. This beautiful, tight canyon packs rapids with big holes behind big rocks. Lots of twisting rapids with momentum-stopper holes.","id":"2490","location":{"latitude":"0","longitude":"0"},"name":"Moss Canyon","distance":"9.1","difficulty":"V","approximate":false,"photoID":null},{"type":"waterfall","description":"The big daddy hole in Moss Canyon","id":"2491","location":{"latitude":"0","longitude":"0"},"name":"Boss Moss","distance":"9.2","difficulty":"V","approximate":false,"photoID":null},{"type":"waterfall","description":"One of several good rapids with constrictions and stomper holes that finish off the Moss Canyon.","id":"2493","location":{"latitude":"0","longitude":"0"},"name":"Floss Moss","distance":"9.3","difficulty":"IV","approximate":false,"photoID":null},{"type":"access","description":"The river bends from right to left, Jim Crow Creek enters river left, the Shangri-La resort has stone walls at the river and a bridge crossing the North Fork Yuba.","id":"2495","location":{"latitude":"0","longitude":"0"},"name":"Shangri-La","distance":"10.5","photoID":null,"difficulty":"III","approximate":false},{"type":"takeout","description":"When you see Downie Creek enter river right, you are in Downieville. Cross under the first bridge and takeout river right.","id":"2494","location":{"latitude":"0","longitude":"0"},"name":"Downie Creek","distance":"12.9","photoID":null,"difficulty":"III","approximate":false}],"alerts":[],"photos":[{"id":"9032","ext":"jpeg","post_id":"2942","description":"This is the first drop after the put-in for Love's Falls. Many drops after this one increase in complexity and committedness. After crossing under the Pacific Trail bridge, two more significant falls occur, then the river twists and constricts into a very committing but relatively short canyon.","caption":"Loves Falls first drop","poi_name":"Loves Falls","subject":"Pete Giordano","author":"Gabe Flock","poi_id":"2489","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/9032","large":"https://api.americanwhitewater.org/image/images/big/9032"}},{"id":"9001","ext":"jpeg","post_id":"2941","description":"this section is just above the PCT bridge, the large boulder at the top of the picture represents a big drop below many others","caption":"Loves Falls above Wild Plum","poi_name":"Lower Loves Falls","subject":"Loves Falls North Fork Yuba River","author":"Craig Irwin","poi_id":"2486","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/9001","large":"https://api.americanwhitewater.org/image/images/big/9001"}}],"detail":{"id":"338","permitUrl":"","permitInfo":"","description":"The Sierra City run.\n\nWild Plum canyon is one of the uppermost regions within the North Fork Yuba River.\n\nThe only creeking above this point is 40 degree gradient on mixture of sharp granite substrates that few salmon can make it past.\n\nWe dubb this the Sierra City run.\n\nSikbird note: This run can be notched up considerably by adding the Love Falls section above the Pacific Crest Trail bridge.\n\nSeasonal rain and snow events frequently bump this run up quickly.\n\nThis run offers clear and cold water, beautiful and challenging rapids in steep gradient with real consequences for the uninitiated.\n\nReference: \"California Whitewater, Third Edition\" Jim Cassady & Fryar Calhoun","averageGradient":"108","maxGradient":"120","length":"14.5","correlations":[{"reachID":"338","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"250","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"2500"},"gaugeInfo":{"name":"N YUBA R BL GOODYEARS BAR CA","gaugeSource":"USGS","gaugeSourceIdentifier":"11413000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"681","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.93","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"39.52487147","longitude":"-120.9379749"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/11413000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/11413000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"migration-runnable","latestReading":{"value":"681","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["2486","2497","2496","2487","2488","2489","2492","2490","2491","2493","2495","2494"],"geometry":{"type":"LineString","coordinates":[[-120.613936,39.567945],[-120.614162,39.567919],[-120.614337,39.567902],[-120.614361,39.5679],[-120.614635,39.567897],[-120.615116,39.567929],[-120.615482,39.568013],[-120.615696,39.568063],[-120.616001,39.568109],[-120.61623,39.568128],[-120.616833,39.56809],[-120.617573,39.568083],[-120.61