oto_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888017","large":"https://api.americanwhitewater.org/image/images/big/888017"}},{"id":"891889","ext":"jpg","post_id":"895800","description":null,"caption":null,"poi_name":"Dam rapid","subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891889","large":"https://api.americanwhitewater.org/image/images/big/891889"}},{"id":"h0cL7os0RjYxUC9saUFNV","ext":"jpg","post_id":"mUwQloQ5n67Cr8rnnYmLv","description":null,"caption":"Madison @3) Beartrap Canyon: Madison Dam to Route 84","poi_name":null,"subject":null,"author":"JackMcNeil5","poi_id":null,"photo_date":null,"updated_at":"2021-10-11T19:49:34.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/h0cL7os0RjYxUC9saUFNV","large":"https://api.americanwhitewater.org/image/images/big/h0cL7os0RjYxUC9saUFNV"}},{"id":"ZbFqQNE8GHMDixtv3OUt6","ext":"jpg","post_id":"1nwCZ2HdLEUAl0FscPfqD","description":"Josh getting swallowed in double drop","caption":null,"poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":"2021-10-10T19:56:53.000Z","updated_at":"2021-10-11T19:56:53.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/ZbFqQNE8GHMDixtv3OUt6","large":"https://api.americanwhitewater.org/image/images/big/ZbFqQNE8GHMDixtv3OUt6"}}],"detail":{"id":"1012","permitUrl":"","permitInfo":"","description":"Beartrap Canyon is a highly scenic whitewater run through the Lee Metcalf Wilderness with a reasonable road shuttle. The run features some great technical Class II and III rapids leading up to Kitchen Sink, a standout powerful class IV rapid that may be class V at high flows located approximately halfway down the 10 mile run. Below Kitchen sink more fun rapids await before the gradient eases and the takeout is reached.\n\nThe run begins immediately downstream of the dam that forms Ennis Lake. During times of high inflows the section between the dam and the powerhouse contain some great Class III technical rapids, including a double drop rapid in a relatively narrow pinch, class IV at high flows. When flows drop the dam is capable of rendering this section too low to paddle for some rafts. Below the powerhouse flows are more likely to be found, but the dam does pulse flows so be aware that flows may change dramatically.  Healmets, PFD's, Pin kit, First aid and layers highly reccomended.  This is a modorate wilderness trip in a shallow river.  No cell service, help is at least 3-4 hours away depending where you are in the canyon or who your cell provider is.  If your are unsure about a rapid please error on the side of scouting.","averageGradient":null,"maxGradient":null,"length":"12","correlations":[{"reachID":"1012","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"600","beginMediumRunnable":"1000","beginHighRunnable":"2500","endHighRunnable":"4000"},"gaugeInfo":{"name":"Madison River bl Ennis Lake nr McAllister MT","gaugeSource":"USGS","gaugeSourceIdentifier":"06041000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"1370","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.98","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"45.49023056","longitude":"-111.6345056"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/06041000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/06041000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"medium-runnable",