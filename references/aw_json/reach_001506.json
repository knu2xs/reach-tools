itewater.org/image/images/medium/HHJdFkQhYrzeB8nOM3KYc","large":"https://api.americanwhitewater.org/image/images/big/HHJdFkQhYrzeB8nOM3KYc"}},{"id":"889374","ext":"jpeg","post_id":"Q10IxoQM8lQw98Nn51EHk","description":"","caption":"Rockafella 1","poi_name":"","subject":"","author":"Thomas O'Keefe ©","poi_id":"102568","photo_date":"2017-03-26T22:00:05.000Z","updated_at":"2023-02-25T22:00:06.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/889374","large":"https://api.americanwhitewater.org/image/images/big/889374"}},{"id":"3FXD50wMoegvCERcQXOBt","ext":"jpg","post_id":"gIyHiXpgwrdEjuD0fuHL7","description":"","caption":"Bottom of Rockafella 2","poi_name":null,"subject":"Megi Morishita","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":"102569","photo_date":"2017-03-27T22:00:47.000Z","updated_at":"2023-02-25T22:00:47.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3FXD50wMoegvCERcQXOBt","large":"https://api.americanwhitewater.org/image/images/big/3FXD50wMoegvCERcQXOBt"}},{"id":"7zriQhvgViN5QDrBKsiQZ","ext":"jpg","post_id":"Q10IxoQM8lQw98Nn51EHk","description":"The bridge marks the start of Rockafella 1.","caption":"Archie Briggs Rd Bridge","poi_name":null,"subject":"","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":"102568","photo_date":"2017-03-26T22:00:05.000Z","updated_at":"2023-02-25T22:00:06.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/7zriQhvgViN5QDrBKsiQZ","large":"https://api.americanwhitewater.org/image/images/big/7zriQhvgViN5QDrBKsiQZ"}},{"id":"889371","ext":"jpeg","post_id":"Q10IxoQM8lQw98Nn51EHk","description":"Shredder run through Ogre on Riverhouse.","caption":"Riverhouse","poi_name":"Ogre","subject":"","author":"Thomas O'Keefe ©","poi_id":"102573","photo_date":"2017-03-26T22:00:05.000Z","updated_at":"2023-02-25T22:00:06.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/889371","large":"https://api.americanwhitewater.org/image/images/big/889371"}},{"id":"JsYVM8naaqVWGR68efIse","ext":"jpg","post_id":"gIyHiXpgwrdEjuD0fuHL7","description":"Setting up for the boof at Flumes of Doom.","caption":"Flumes of Doom","poi_name":null,"subject":"Megi Morishita","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":"102571","photo_date":"2017-03-27T22:00:47.000Z","updated_at":"2023-02-25T22:00:47.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/JsYVM8naaqVWGR68efIse","large":"https://api.americanwhitewater.org/image/images/big/JsYVM8naaqVWGR68efIse"}},{"id":"882484","ext":"jpeg","post_id":"885174","description":"T Rex","caption":"","poi_name":"","subject":"","author":"George Cocores","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/882484","large":"https://api.americanwhitewater.org/image/images/big/882484"}},{"id":"882485","ext":"jpeg","post_id":"885175","description":"The Wright Stuff.  Sam is running the more difficult boof line.  The normal line is in between him and the boulder.","caption":"","poi_name":"","subject":"","author":"Matt Deacon","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/882485","large":"https://api.americanwhitewater.org/image/images/big/882485"}},{"id":"882483","ext":"jpeg","post_id":"885173","description":"Rockafella 1","caption":"","poi_name":"","subject":"","author":"Matt Deacon","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/882483","large":"https://api.americanwhitewater.org/image/images/big/882483"}},{"id":"882503","ext":"jpeg","post_id":"885195","description":"Rockafella 2 at high water- 1200 cfs","caption":"","poi_name":null,"subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/882503","large":"https://api.americanwhitewater.org/image/images/big/882503"}}],"detail":{"id":"1506","permitUrl":"","permitInfo":"","description":"SEASON: This reach is dewatered during the summer irrigation season and it gets pretty cold in the winter here. Riverhouse typically flows from late October to mid April.\n\nPUT IN:  Sawyer Park.  OB Riley Rd.  If flows are between 600 and 800, you can put in about a mile up stream and run the ~30 ft spillway.  Its very fun.  Just don't flip over.\n\nTAKEOUT:  Just downstream of Tumalo State Park.  There is a dirt parking lot on thr river side of the road.\n\nDESCRIOPTION:\n\nRiverhouse is a class IV run, within the Bend city limits, that flows reliably throughout the winter.  Because of the cold water, jagged rocks, and other hazards, Riverhouse is not a great step up run for aspiring Class IV boaters.  For solid class IV paddlers, it is a worthwhile and convenient run with some very fun rapids.\n\nI would say minimum enjoyable flow is 600, although people run it down to about 450 in low water years.  Best first time level is 600- 900; Most of the rocks are covered up, but it's not too pushy.  When Riverhouse is above 1000cfs, it is a fantastic Class IV- IV+ run with lots of great boofs.","averageGradient":"57","maxGradient":null,"length":"5.5","correlations":[{"reachID":"1506","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"500","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"1500"},"gaugeInfo":{"name":"Deschutes River Below Bend, OR","gaugeSource":"USBR","gaugeSourceIdentifier":"debo","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"91","dateTime":"2026-05-11T19:30:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.6","dateTime":"2026-05-11T19:30:00.000Z","qualifier":"N