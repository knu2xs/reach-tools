[{"result":{"data":{"json":{"id":"469","stub":{"id":"469","section":"US Route 281 to US Route 172","altname":"","river":"Broad","difficulty":"ItoIIstandoutIII","states":["USA-GEO"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"494","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"This is the put-in for The Sandbar outfitters ,it cuts out all the flatwater at the beginning of this run and puts you at the top of the first ledge.","id":"2544","location":{"latitude":"0","longitude":"0"},"name":"The Sandbar put-in","distance":"1.5","photoID":null,"difficulty":null,"approximate":false},{"type":"playspot","description":"Large shoal with a small island in the middle. Last checked there were the remains of a coleman canoe wrapped on a rock at the bottom left.At low water run left side of island.4ft and above there are lines everywhere with a nice wave train at the end.","id":"1121","location":{"latitude":"0","longitude":"0"},"name":"First Ledge","distance":"1.7","difficulty":"II","approximate":false,"photoID":"18459"},{"type":"rapid","description":"A left to right move.","id":"1231","location":{"latitude":"0","longitude":"0"},"name":"Lunch Stop Rock","distance":"3.3","difficulty":"II","approximate":false,"photoID":"18458"},{"type":"waterfall","description":"A five foot tall vertical ledge is on the right side of the island. There are 3 lines you can take.Far right has a piton rock so hug far right bank as much as you can.Center line opens up around 4 feet, make sure you have speed because the lip is very shallow.At levels over 6 feet a keeper hole developes on the center line.The left line is a fun slide . On the left side of the island are some class 2 shoals. There is an easy to avoid undercut in this rapid.","id":"1116","location":{"latitude":"0","longitude":"0"},"name":"3 Falls","distance":"4.3","difficulty":"II+","approximate":false,"photoID":"18460"},{"type":"rapid","description":"Skull Shoal comes in below the waterfall on the right.","id":"1117","location":{"latitude":"0","longitude":"0"},"name":"Skull Shoal Creek","distance":"4.4","difficulty":null,"approximate":false,"photoID":null},{"type":"playspot","description":"Roostertail is a riverwide broken ledge shoal. Its best run on the right,punch the wave and watch out for the pillowing rock. You will be able to see the Hwy 172 bridge below.","id":"1118","location":{"latitude":"0","longitude":"0"},"name":"Roostertail Rapid","distance":"5","difficulty":"II+","approximate":false,"photoID":null},{"type":"access","description":"There is another ledge under the bridge. At some levels there is surfing on the left.Avoid the rock island with the tree there is rebar here from an old bridge.","id":"1119","location":{"latitude":"0","longitude":"0"},"name":"Hwy 172 bridge","distance":"5.5","photoID":null,"difficulty":"I","approximate":false},{"type":"takeout","description":"Look for the steps on river right, a little past the island.","id":"1120","location":{"latitude":"0","longitude":"0"},"name":"Broad River Outpost takeout","distance":"6.5","photoID":null,"difficulty":null,"approximate":false},{"type":"takeout","description":"Right at the Sandbar take out is a nice long sloping ledge. At low levels run river right then take-out on the left at the Sandbar outfitters. At higher levels lines open up everywhere.","id":"2545","location":{"latitude":"0","longitude":"0"},"name":" Moores' ledge","distance":"6.75","photoID":null,"difficulty":"II+","approximate":false}],"alerts":[{"id":"101249990","title":null,"post_date":"2013-02-06 05:00:00+00","detail":"Use caution, a large logjam strainer has appeared since last high water event, just downstream of Horseshoe Rapid, the first significant drop, located far river left. The logjam spans the river left ledge downstream of the first drop, which has been referred to by some as First Ledge, and obstructs passage through the ledge drop in that series of rapids, which is usually run to the left of a large rock in the middle of the river. Passage is bony to the right of the large rock.","user":{"name":"Ryan Hines"}}],"photos":[{"id":"GAWbzLnh4pNWSXU4qOKeR","ext":"jpg","post_id":"5r1GK9VvqMVrP03tYhTFx","description":"","caption":"Higher water","poi_name":null,"subject":"","author":"Taylor Crump","poi_id":"1118","photo_date":"2024-01-17T02:15:58.000Z","updated_at":"2024-01-17T02:15:58.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/GAWbzLnh4pNWSXU4qOKeR","large":"https://api.americanwhitewater.org/image/images/big/GAWbzLnh4pNWSXU4qOKeR"}},{"id":"5057","ext":"jpeg","post_id":"5261","description":"Truckstop hole, at dusk. Spencer and John. Another of many large surf features that forms on the Broad at high water. See more pictures of the Broad at high water at <a href=\" http://www.alexjharvey.com/georgia.htm#Broad River \"> http://www.alexjharvey.com/georgia.htm#Broad River </a>.\r\n","caption":"Truckstop hole","poi_name":"Pipeline","subject":"John and Spencer","author":"Alex Harvey","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5057","large":"https://api.americanwhitewater.org/image/images/big/5057"}},{"id":"5058","ext":"jpeg","post_id":"5261","description":"See more pictures of the Broad at high water at <a href=\" http://www.alexjharvey.com/georgia.htm#Broad River \"> http://www.alexjharvey.com/georgia.htm#Broad River </a>.","caption":"Another shot of first wave, Ashely","poi_name":"Below First Ledge","subject":"Ashely Young","author":"Alex Harvey","poi_id":"1120","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5058","large":"https://api.americanwhitewater.org/image/images/big/5058"}},{"id":"18461","ext":"jpeg","post_id":"7221","description":"This rapid looks fairly easy but is very dangerous at higher levels . The whole ledge is undercut and actually forms a cave under this waterfall and at higher levels a keeper hole feeds into it .At this level it is too shallow at the lip to run . Hit it between 4 and 7 feet .","caption":"Center line at 3 Falls","poi_name":"3 Falls","subject":"","author":"Eddy Hicks","poi_id":"1116","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/18461","large":"https://api.americanwhitewater.org/image/images/big/18461"}},{"id":"18459","ext":"jpeg","post_id":"7221","description":"","caption":"1st ledge","poi_name":"1st ledge","subject":"","author":"Eddy Hicks","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/18459","large":"https://api.americanwhitewater.org/image/images/big/18459"}},{"id":"19235","ext":"bmp","post_id":"9798","description":"the \"waterfall\" it was more of a slide","caption":"19235.bmp","poi_name":"","subject":"alex brantley","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/19235","large":"https://api.americanwhitewater.org/image/images/big/19235"}},{"id":"18458","ext":"jpeg","post_id":"7221","description":"","caption":"Lunch Island Rock","poi_name":"Lunch Island Rock","subject":"","author":"Eddy Hicks","poi_id":"1231","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/18458","large":"https://api.americanwhitewater.org/image/images/big/18458"}},{"id":"5056","ext":"jpeg","post_id":"5261","description":"This is a wave that forms at high water, it is on river left, below the first major rapid, First Ledge. See more pictures of the Broad at high water at <a href=\" http://www.alexjharvey.com/georgia.htm#Broad River \"> http://www.alexjharvey.com/georgia.htm#Broad River </a>.","caption":"First wave on the Broad","poi_name":"Below First Ledge","subject":"Ashely and John","author":"Alex Harvey","poi_id":"1120","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5056","large":"https://api.americanwhitewater.org/image/images/big/5056"}},{"id":"18460","ext":"jpeg","post_id":"7221","description":"","caption":"Side view of 3 Falls","poi_name":"3 Falls","subject":"","author":"Eddy Hicks","poi_id":"1116","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/18460","large":"https://api.americanwhitewater.org/image/images/big/18460"}},{"id":"13479","ext":"jpeg","post_id":"7220","description":"This is the far left line at 3 falls at low water.","caption":"3 falls at low water","poi_name":"3 falls","subject":"Eddy Hicks","author":"","poi_id":"1116","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/13479","large":"https://api.americanwhitewater.org/image/images/big/13479"}},{"id":"19234","ext":"jpeg","post_id":"9797","description":"","caption":"19234.jpeg","poi_name":"roostertail","subject":"alex brantley","author":"","poi_id":"1120","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/19234","large":"https://api.americanwhitewater.org/image/images/big/19234"}},{"id":"19233","ext":"bmp","post_id":"9799","description":"surfin rooster tail","caption":"19233.bmp","poi_name":"roostertail","subject":"alex brantley","author":"","poi_id":"1120","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/19233","large":"https://api.americanwhitewater.org/image/images/big/19233"}}],"detail":{"id":"469","permitUrl":"","permitInfo":"","description":"The gauge is located in Carlton GA, 18 miles south of Hwy 281. It will take the water 6 to 12 hours to hit the gauge.\n\n2 foot is the minimum for this run. 3-4 foot is optimal for beginners. Levels above 6 foot the river takes on a totally different character and is better suited for more advanced paddlers.\n\nAround 7 or 8 feet the outpost start shutting down trips, and the surfing starts to get nice!\n\nAt levels above 15 feet or so, large surf waves and holes abound, some have good eddies, many are caught on the fly. Roostertail Rapid at the end is an incredible sight and fairly intimidating with large standing waves and holes. At these levels, come with a bombproof roll or you will be looking for your boat in Augusta...(Alex Harvey, 2003)\n\nThe river has been run upwards of 20 feet or 17,000 cfs.\n\nThere are two outfitters available on this run. One is located at the put-in and the other is located at the take-out.\n\nThe Broad River Outpost is located at the put-in. They have a large parking area, and charge $5 for parking and shuttle. According to the BRO website, there are 7 rapids in this stretch. At flood stage, Roostertail Rapid makes a huge 10 foot tall surfing wave.\n\nA note from the BRO Owners:\n\n> \"I own and operate the Broad River Outpost on Hwy. On our gage at the put-in, we tried to 'mimic' the USGS gage' at Carlton. It's similar at low levels but gets progressively lower at the high water levels.\n>\n>  In the years past we had a painted gage on the bridge itself. Like our new gage, the Bridge Gage has a proportionally lower reading than the gage at the 72 bridge . . . wider channel, steep gradient, etc ???? We should do a mathematical comparison / curve . . . maybe one day.\"\n>\n> _The following is an approx comparison of the gage heights._\n>\n>  -2 foot on the bridge is about 2 foot on the usgs and our new gage at the put-in.\n>\n>  2.5 feet on the bridge is 64\" on our new gage which is approx 6'. Our new gage stops at 6 foot.\n>\n>  12 foot on the bridge is about 21 on the usgs.\n>\n>  16 feet on the 281 bridge was approx 27 at the USGS site - the highest I've seen.\n>\n>  There are many old paddlers who've run the Broad River at the high water levels - it turns into a wonderful 'big water' class 3-4 run. We thought an update on the gage system would be helpful. We do get calls from confused older boaters . . . but then it could be our age.\n>\n>  Thanks\n>\n>  Michael Moody\n\nFor more info: [Broad River Outpost](http://www.broadriveroutpost.com).\n\nThe other outfitter for this section of river is The Sandbar. They are located about 1 mile past the bridge on river left.  Driving directions if you're coming from Athens on Hwy 172 go over the bridge for the Broad and about 1/2 mile on the right is a dirt road King Hall Mill road.  Go about 1 mile look for their sign on the right. Their shuttle service costs $5 and puts you in right above the first ledge. It also cuts out a mile and a half of flatwater.\n\nIf you are into creeking, and the Broad is too high for mere mortals, a 2 mile run that opens up is Mill Shoal Creek which is a class 3 run where the owner of the Sandbar, Gerald Carey, owns all of the land on river right and will arrange shuttle. Or if you do your own shuttle, the owner does not mind as long as you notify them. They will give you directions to the put-in and take-out.\n\nFor more information call (706) 245-4163 or visit the website for [the Sandbar](http://www.thesandbarbroadriver.com/index.htm).","averageGradient":"9","maxGradient":"0","length":"5.8","correlations":[{"reachID":"469","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"300","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"20000"},"gaugeInfo":{"name":"BROAD RIVER ABOVE CARLTON, GA","gaugeSource":"USGS","gaugeSourceIdentifier":"02191300","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"494","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading"