[{"result":{"data":{"json":{"id":"93","stub":{"id":"93","section":"Falling Water Falls to Richland Campground (7 miles)","altname":"","river":"Falling Water Creek","difficulty":"IItoIIIplusstandoutIV","states":["USA-ARK"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"2.24","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Put-in above the falls. Park in the pull-out above the falls or at the primitive campsites above the falls","id":"2888","location":{"latitude":"0","longitude":"0"},"name":"Put-in","distance":"0","photoID":null,"difficulty":null,"approximate":false},{"type":"waterfall","description":"Can't miss this roadside drop. Drop is straight forward. Can plug, boof or freewheel. Watch the hydraulic at higher flows. Easy to carry up and run multiple times.\n\n![](http://www.americanwhitewater.org/photos/archive/medium/42877.jpg)","id":"2889","location":{"latitude":"35.721900939941406","longitude":"-92.94930267333984"},"name":"Falling Water Falls","distance":"0.1","difficulty":"III","approximate":false,"photoID":"0"},{"type":"hazard","description":"Most difficult and potentially dangerous rapid on the creek. Most portage. Main flow is down the right with an undercut and pin-rocks to deal with.","id":"2890","location":{"latitude":"35.7223014831543","longitude":"-92.94930267333984"},"name":"Falls run-out","distance":"0.1","photoID":"0","difficulty":"IV","approximate":false},{"type":"rapid","description":"Below the falls, the creek drops away from the road into a 1 mile long section of fun technical class II-III drops with a remote feel.","id":"2891","location":{"latitude":"35.72370147705078","longitude":"-92.94840240478516"},"name":"Upper Gorge","distance":"0.2","difficulty":"III","approximate":false,"photoID":"0"},{"type":"access","description":"Alternate access below the upper gorge is available near the confluence with Bailey Cole Creek via some primative camp sites along the road. Some nice surf spots are located below here.","id":"2892","location":{"latitude":"0","longitude":"0"},"name":"Bailey Cole Confluence","distance":"2","photoID":null,"difficulty":null,"approximate":false},{"type":"access","description":"Alternate access point.","id":"2893","location":{"latitude":"0","longitude":"0"},"name":"Low-water Bridge","distance":"3","photoID":null,"difficulty":null,"approximate":false},{"type":"playspot","description":"Below the low-water bridge, the creek runs through a 0.75 mile long section of bedrock which forms numerous ledges and with lots of surfing spots. Beware of some of the hydraulics at high water levels. The bedrock ends at 6-Finger Falls.","id":"2894","location":{"latitude":"35.75320053100586","longitude":"-92.93800354003906"},"name":"Bedrock Gorge","distance":"3.1","difficulty":"III","approximate":false,"photoID":"0"},{"type":"waterfall","description":"Six foot tall steep slide/falls with several chutes to chose from. The right side contains a boulder at the bottom to deal with.","id":"2895","location":{"latitude":"35.761600494384766","longitude":"-92.9375991821289"},"name":"Six Finger Falls","distance":"3.8","difficulty":"III","approximate":false,"photoID":"0"},{"type":"access","description":"Alternate access point. Below here the creek drops below and away from the road on its way to Richland Creek.","id":"2896","location":{"latitude":"0","longitude":"0"},"name":"Lower Campsite","distance":"4.6","photoID":null,"difficulty":null,"approximate":false},{"type":"rapid","description":"2-mile section that drops below and away from the road. Similar remote gorge feel as the upper gorge, but rapids aren't as tight. The Grotto awaits near the bottom with a shallow but grabby hydrauic. Watch for wood in the willowy sections.","id":"2897","location":{"latitude":"35.7681999206543","longitude":"-92.93360137939453"},"name":"Lower Gorge","distance":"4.6","difficulty":"III","approximate":false,"photoID":"0"},{"type":"rapid","description":"Main drop of the lower gorge. A shallow grabby hole awaits at the bottom.","id":"2898","location":{"latitude":"35.79159927368164","longitude":"-92.93379974365234"},"name":"The Grotto","distance":"6.2","difficulty":"III","approximate":false,"photoID":"0"},{"type":"access","description":"Confluence with Richland Creek at the campground. Take out here or continue through one more rapid to the campground bridge.","id":"2899","location":{"latitude":"0","longitude":"0"},"name":"Richland Creek Campground","distance":"6.8","photoID":null,"difficulty":null,"approximate":false},{"type":"takeout","description":null,"id":"2900","location":{"latitude":"0","longitude":"0"},"name":"Campground Bridge","distance":"7","photoID":null,"difficulty":null,"approximate":false}],"alerts":[{"id":"100325140","title":null,"post_date":"2008-05-14 04:00:00+00","detail":"Downed timber still blocks road.","user":null},{"id":"100292388","title":null,"post_date":"2008-04-02 04:00:00+00","detail":"Falling Water Road is closed by a large landslide and downed timber about 2 miles below the Falling Water Creek Bridge. Must access the Richland Creek Campground via the north side of the Richland Creek (LONG SHUTTLE). Lowest access point availble above the landslide is the primitive campground at mile 4.6, 1.6 miles below the bridge.","user":{"name":"Lance Jones"}}],"photos":[{"id":"548249","ext":"jpeg","post_id":"548248","description":"","caption":"Springtime ","poi_name":"","subject":"","author":"Pat Caple","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/548249","large":"https://api.americanwhitewater.org/image/images/big/548249"}},{"id":"548535","ext":"jpeg","post_id":"548532","description":"","caption":"","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/548535","large":"https://api.americanwhitewater.org/image/images/big/548535"}},{"id":"881940","ext":"jpeg","post_id":"884601","description":"","caption":"Falling Water Falls","poi_name":"","subject":"Laramy Ridley","author":"Photo by: Jimbo Martin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/881940","large":"https://api.americanwhitewater.org/image/images/big/881940"}},{"id":"548533","ext":"jpeg","post_id":"548532","description":"","caption":"","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/548533","large":"https://api.americanwhitewater.org/image/images/big/548533"}},{"id":"548536","ext":"jpeg","post_id":"548532","description":"","caption":"","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/548536","large":"https://api.americanwhitewater.org/image/images/big/548536"}},{"id":"548534","ext":"jpeg","post_id":"548532","description":"","caption":"","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/548534","large":"https://api.americanwhitewater.org/image/images/big/548534"}},{"id":"8046","ext":"jpeg","post_id":"4070","description":"","caption":"Falling Water Falls","poi_name":"Falling Water Falls","subject":"Lance Jones","author":"Jesse Scribner","poi_id":"2889","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8046","large":"https://api.americanwhitewater.org/image/images/big/8046"}},{"id":"8045","ext":"jpeg","post_id":"4070","description":"","caption":"Falling Water Falls","poi_name":"Falling Water Falls","subject":"Jessica Robinson","author":"Jesse Scribner","poi_id":"2889","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8045","large":"https://api.americanwhitewater.org/image/images/big/8045"}},{"id":"893594","ext":"jpg","post_id":"897130","description":null,"caption":"Falling Water Falls","poi_name":"Falling Water Falls","subject":null,"author":"Phil Riggins","poi_id":"2890","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/893594","large":"https://api.americanwhitewater.org/image/images/big/893594"}},{"id":"42877","ext":"jpeg","post_id":"10212","description":"boofin @ falling water falls","caption":"42877.jpeg","poi_name":"falling water falls","subject":"joe c","author":"","poi_id":"2890","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/42877","large":"https://api.americanwhitewater.org/image/images/big/42877"}}],"detail":{"id":"93","permitUrl":"","permitInfo":"","description":"**Note:** The combination of steep banks and lots of dead red oak trees (thanks to the borer beetle infestation) tend to clog the creek with wood from time to time, so keep a look out.\n\n**Put-in:** Go East on Hwy 16 from Ben Hur for 1.5 miles and turn onto Upper Falling Water Road (NFS 1205) and following to the Falls on the side of the road. There is limited parking along the road and several primitive camping/parking spots upstream a few hundred feet.\n\n**Take-out:** Continue downstream to the NFS Richland Creek Campground. This road will parallel Falling Water Creek most of the way. Multiple access points are available along the road. This road can also be reached by taking Falling Water Road(NFS 1313) farther East off Hwy 16. Or from Searcy County Road 265 (NFS 1219) from Hwy 16 near Witts Spring.\n\nFalling Water road will cross the creek about halfway between the Falls and the campground. At lower levels, many opt to just run from the bridge down.\n\nThe Falls are the highlight (10-12 feet) with the rapid immediately below being the most difficult. It offers an undercut on the right and tight slots for pinning elsewhere. The other significant rapids include the shoals below the bridge, which can develop powerful hydraulics and 'The Grotto' just before reaching the campground.\n\nAt medium to high water levels, the shoals (especially below the bridge half-way down) offer some fun play.","averageGradient":"50","maxGradient":"60","length":"7.2","correlations":[{"reachID":"93","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"3.5","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"6"},"gaugeInfo":{"name":"Richland Creek near Witts Spring, AR","gaugeSource":"USGS","gaugeSourceIdentifier":"07055875","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"210","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"2.24","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"35.7972222","longitude":"-92.9288889"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/07055875","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/07055875/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"2.24","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null}}],"pointOfInterestIDs":["2888","2889","2890","2891","2892","2893","2894","2895","2896","2897","2898","2899","2900"],"geometry":{"type":"LineString","coordinates":[[-92.94912841759295,35.72129138236895],[-92.94927109949776,35.72195387788577],[-92.94931843283103,35.7