[{"result":{"data":{"json":{"id":"467","stub":{"id":"467","section":"Chubbtown Bridge to Lyons Bridge","altname":"Glenridiculous Run","river":"Big Cedar Creek","difficulty":"IIplus","states":["USA-GEO"]},"primaryGaugeStatus":{"status":"stale","latestReading":{"value":"88.1","dateTime":"2025-03-12T14:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"After the put-in at the Chubbtown Chapel, go under the bridge and head down toward the confluence with Big Cedar. Depending on the water level, this micro-creek is quick and can contain some strainers. Watch out for the yappy dogs, too.","id":"742","location":{"latitude":"0","longitude":"0"},"name":"Chubbtown Creek Rapid","distance":"0","photoID":null,"difficulty":"II","approximate":false},{"type":"rapid","description":"The first rapid on Big Cedar Creek is a fun, splashy, Class II+ rapid with lots of eddies, nice surfing holes, and is always lots of fun for beginners.","id":"743","location":{"latitude":"0","longitude":"0"},"name":"First Rapid","distance":"0.2","difficulty":"II+","approximate":false,"photoID":null},{"type":"playspot","description":"This is the best playspot on the creek. Depending on the water level, cartwheels are possible in the hole on river left and enders possible in the middle channel. Be careful in the river left hole because there's a submerged rock to the right of the hole that has nicked a few shoulders. Still, good to go. Eddy right.","id":"744","location":{"latitude":"0","longitude":"0"},"name":"Triple Rock","distance":"0.3","difficulty":"II+","approximate":false,"photoID":null},{"type":"playspot","description":"Easy-to-miss, but great little pourover on river left. Look for a strong eddyline and eddy left for decent play.","id":"745","location":{"latitude":"0","longitude":"0"},"name":"Secret Spot","distance":"1.2","difficulty":"II","approximate":false,"photoID":null},{"type":"takeout","description":null,"id":"114363","location":{"latitude":"34.1653","longitude":"-85.3427"},"name":"Take Out","distance":"1.6","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"100349341","title":null,"post_date":"2008-06-07 04:00:00+00","detail":"if gauge on 411 bridge reads normal then its runable if not stay out","user":null},{"id":"100188702","title":null,"post_date":"2008-03-01 05:00:00+00","detail":"There is no \"getting friendly\" with the land owner.........What part of KEEP OUT do you not get??","user":null}],"photos":[],"detail":{"id":"467","permitUrl":null,"permitInfo":null,"description":"The Glenridiculous Run is reportedly a fun little stretch of whitewater near Cave Spring and Rome. Paddlers have historically put in on small tributary creek by the Chubbtown Chapel.\n\nThere, paddlers enter the \"Narrows\" of Big Cedar Creek. At higher water, several decent playspots form here. The action is short.  Several more good rapids exist immediately upstream of this section.\n\nPrivate landowners claim the river is not navigable and oppose public access to this reach.","averageGradient":"25","maxGradient":"25","length":"11","correlations":[{"reachID":"467","isPrimary":true,"correlationDetails":null,"migrationErrorExplanation":null,"gaugeInfo":{"name":"CEDAR CREEK NEAR CEDARTOWN, GA","gaugeSource":"USGS","gaugeSourceIdentifier":"02397500","gaugeFetchStatus":"ARCHIVED","latestFlowReading":{"value":"88.1","dateTime":"2025-03-12T14:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.05","dateTime":"2025-03-12T14:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"34.06019444","longitude":"-85.3135556"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/02397500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/02397500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"comment":null,"status":{"status":"stale","latestReading":{"value":"88.1","dateTime":"2025-03-12T14:45:00.000Z","