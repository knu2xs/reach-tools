[{"result":{"data":{"json":{"id":"1475","stub":{"id":"1475","section":"McCoppin Mill Rd (below Rocky Fk Lake Dam) to Paint Creek","altname":"","river":"Rocky Fork Creek","difficulty":"II","states":["USA-OHI"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"12","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"hazard","description":"The old mill and dam is just upstream of the put in.","id":"101931","location":{"latitude":"39.183292388916016","longitude":"-83.43807220458984"},"name":"McCoppin Mill Dam","distance":"-0.05","photoID":"0","difficulty":"N/A","approximate":false},{"type":"put-in","description":"There appears to be a large turnout on river left, where boaters can park and access the river.  The land may be private, though public land surrounding the reservoir extends very close to here.","id":"101982","location":{"latitude":"39.183067321777344","longitude":"-83.4372329711914"},"name":"McCoppin Mill Road","distance":"0","photoID":"0","difficulty":"N/A","approximate":false},{"type":"portage","description":"As you pass under the bridge for Hwy 753, stay close to shore and prepare to portage a dam.","id":"101928","location":{"latitude":"39.177799224853516","longitude":"-83.41519927978516"},"name":"Hwy.753 bridge & mill dam","distance":"1.36","photoID":"0","difficulty":"N/A","approximate":false},{"type":"put-in","description":"Be prepared to portage a dam just beyond Barrett Mill Road.  This is also a common put in spot.  Park on river left and launch below the dam.","id":"101929","location":{"latitude":"39.201900482177734","longitude":"-83.38829803466797"},"name":"Barrett Mill Road bridge & mill dam","distance":"4.56","photoID":"478527","difficulty":"N/A","approximate":false},{"type":"access","description":"Alternate acccess.   Check with the Highlands Conservancy about parking here.  Leave plenty of space for hiking groups to park.","id":"101932","location":{"latitude":"39.21849822998047","longitude":"-83.3855972290039"},"name":"Browning Road","distance":"6.11","photoID":"0","difficulty":"N/A","approximate":false},{"type":"takeout","description":"Boaters can take out on river right under the bridge or just downstream.  Carry up to parking next to the highway.","id":"101983","location":{"latitude":"39.230995178222656","longitude":"-83.34635162353516"},"name":"Highway 50 Bridge","distance":"8.96","photoID":"0","difficulty":"N/A","approximate":false},{"type":"takeout","description":"The old rest area is now private property but the land owners continue to allow public access from the river.  Be considerate and ask permission.","id":"101986","location":{"latitude":"39.23152160644531","longitude":"-83.32756805419922"},"name":"Old Rest Area take out","distance":"10.18","photoID":"0","difficulty":"N/A","approximate":false}],"alerts":[{"id":"101254807","title":null,"post_date":"2020-06-02 04:00:00+00","detail":"Downed tree blocking the \"eye\".\nLevels above 250 may bump over but river right chute is clear and run able.","user":{"name":"andy creighton"}}],"photos":[{"id":"880682","ext":"jpeg","post_id":"881904","description":"There is one side stream to the Rocky Fork that has some nice waterfalls.  This does get enough water to boat when it rains.","caption":"Side stream with potential","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880682","large":"https://api.americanwhitewater.org/image/images/big/880682"}},{"id":"12332","ext":"jpeg","post_id":"6608","description":"Rapids never get above class 1 or easy 2 at this level, but wow it's gorgeous.  ","caption":"Rocky Fork, typical view 2","poi_name":"7 caves area","subject":"","author":"Sean O'Malley","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/12332","large":"https://api.americanwhitewater.org/image/images/big/12332"}},{"id":"o2mRGBDojFGhwQBqQ9GGn","ext":"jpg","post_id":"pjFcBwAZfIg04ARale8vf","description":"Last section of the Paint Creek Chutes","caption":null,"poi_name":null,"subject":"Paint Creek Chutes","author":"MikeEmmons9","poi_id":"101985","photo_date":"2021-07-31T12:45:09.000Z","updated_at":"2021-08-14T12:45:09.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/o2mRGBDojFGhwQBqQ9GGn","large":"https://api.americanwhitewater.org/image/images/big/o2mRGBDojFGhwQBqQ9GGn"}},{"id":"14240","ext":"jpeg","post_id":"8897","description":"USGS reporting for Ohio was offline this day.  Bridge gauge on Browning Road was around 5'.","caption":"Nice Day for a Surf","poi_name":"","subject":"Dan Beckman","author":"Bob Ellstrom","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/14240","large":"https://api.americanwhitewater.org/image/images/big/14240"}},{"id":"463540","ext":"jpeg","post_id":"463524","description":"","caption":"","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/463540","large":"https://api.americanwhitewater.org/image/images/big/463540"}},{"id":"12335","ext":"jpeg","post_id":"6608","description":"","caption":"Looking up from the eddy","poi_name":"7 caves - the arch","subject":"","author":"Sean O'Malley","poi_id":"101928","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/12335","large":"https://api.americanwhitewater.org/image/images/big/12335"}},{"id":"463619","ext":"jpeg","post_id":"463524","description":"","caption":"","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/463619","large":"https://api.americanwhitewater.org/image/images/big/463619"}},{"id":"12331","ext":"jpeg","post_id":"6608","description":"Nothing more than a few class 2ish wave trains at this level, but the scenery is worth it.","caption":"Rocky Fork typical view 1","poi_name":"7 caves area","subject":"","author":"Sean O'Malley","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/12331","large":"https://api.americanwhitewater.org/image/images/big/12331"}},{"id":"12333","ext":"jpeg","post_id":"6608","description":"There's miles of stuff like this.  ","caption":"Rocky Fork, typical view 3","poi_name":"7 caves area","subject":"","author":"Sean O'Malley","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/12333","large":"https://api.americanwhitewater.org/image/images/big/12333"}},{"id":"478527","ext":"jpeg","post_id":"478509","description":"","caption":"","poi_name":"put in","subject":"","author":"Timothy Kling","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/478527","large":"https://api.americanwhitewater.org/image/images/big/478527"}},{"id":"462507","ext":"jpeg","post_id":"462498","description":"","caption":"","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/462507","large":"https://api.americanwhitewater.org/image/images/big/462507"}},{"id":"4414","ext":"bmp","post_id":"1309","description":"The Creek actually goes under an arch - almost a cave, before opening up to the high cliffs of the 7 caves region of Rocky Fork","caption":"The Arch","poi_name":"Entering the 7 caves","subject":"Susan Shultz","author":"Tom Uhlman","poi_id":"101984","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/4414","large":"https://api.americanwhitewater.org/image/images/big/4414"}},{"id":"12334","ext":"jpeg","post_id":"6608","description":"Shot upstream from eddy inside the natural arch.  ","caption":"Upstream Under the Arch","poi_name":"7 caves - \"The Arch\"","subject":"","author":"Sean O'Malley","poi_id":"101928","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/12334","large":"https://api.americanwhitewater.org/image/images/big/12334"}},{"id":"12336","ext":"jpeg","post_id":"6608","description":"One of the prettiest spots to paddle through in OH, if you ask me.","caption":"The Arch again","poi_name":"7 caves - the Arch","subject":"","author":"Sean O'Malley","poi_id":"101928","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/12336","large":"https://api.americanwhitewater.org/image/images/big/12336"}},{"id":"12337","ext":"jpeg","post_id":"6608","description":"Random paddler going through the arch, to give a sense of proportion.","caption":"Arch w/paddler","poi_name":"7 caves - the Arch","subject":"","author":"Sean O'Malley","poi_id":"101928","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/12337","large":"https://api.americanwhitewater.org/image/images/big/12337"}}],"detail":{"id":"1475","permitUrl":"","permitInfo":"","description":"This lovely class I-II stream is a gem of central Ohio. The stream is mostly flat in the upper stretches, but with swift current. Be on the lookout for strainers. I am not very familiar with this upper stretch, as many boaters put on below at Barret's Mill Road or at Browning Road.\n\nIf paddling the upper stretches, there are two old mill dams that **must** be portaged. The first is just downstream of the Highway 753 bridge and the second is just downstream of Barretts Mill Road.  Check them out first on the map and from the road!\n\nA good put in is on river left, just below the bridge on Browning Road. The landowner (Highlands Nature Sanctuary) has been very kind and co-operative with paddlers, allowing them to park on his property on the downstream side of the bridge. _**It is critical that paddlers be considerate!**_ Do not park on any cultivated land, don't block the driveway or any cars and do not litter. Be as low key as possible. Such kindly land owners are our best friends!  Please leave as few vehicles here as possible as this area is frequently used for hikes for patrons of the sanctuary.  Permission can usually be gained to park here at the office near the old 7 caves off cave road.  Be aware that it's a privilege extended to us to use this site and not a right.\n\nFrom Browning road, the stream continues to be fast moving with small ripples. Many places exist for the newer paddler to practice eddy turns and ferries, but again, be on the lookout for strainers. Shortly after the put in there is a small ledge which can provide beginners with surfing practice. After this ledge the gradient begins to pick up slightly and the scenery changes from low banks and pasture land to higher banks and eventually limestone cliffs. In the region of the 7 caves the cliffs are spectacular, rising sharply a hundred feet or more over the river. Most folks won't believe they are still in Ohio. Bring a camera.\n\nThere are a couple of minor rapids leading into and out of this section where the beginner paddler can practice surfing and other techniques, but the water through the most beautiful section is flat, allowing for maximum appreciation of the beauty.\n\nAfter the 7 caves area, the cliff receed and the stream starts to return to pastoral scenery. Most new paddlers will take out on river right below the Rt 50 bridge. Again, be aware you are crossing private land! More experienced paddlers will continue on to the Confluence with Paint Creek a few hundred yards below, attempt the class II-III Paint Creek chutes and take out at the old primitive roadside rest area on Rt. 50. The rest area is now private property but permission has been attained to park on the creek side of the loop, do not park on the inside of the loop. For details about Paint Creek, see [Paint Creek Information](http://www.americanwhitewater.org/rivers/id/1473/)\n\n**Other Information Sources:**\n\n[Rocky Fork State Park](http://www.dnr.state.oh.us/parks/parks/rockyfrk/tabid/784/Default.aspx)\n\n[Highlands Nature Conservancy](http://arcofappalachia.org/visit/highlands-nature-sanctuary.html)\n\n[Seven Caves](http://arcofappalachia.org/visit/seven-caves.html)  Hikers are allowed in the area but not within the caves.  This is to allow restoration and prevent the spread of white nose disease in bats.","averageGradient":"10","maxGradient":"10","length":"9","correlations":[{"reachID":"1475","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"250","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"1000"},"gaugeInfo":{"name":"Rocky Fork near Barretts Mills OH","gaugeSource":"USGS","gaugeSourceIdentifier":"03232500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"12","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.68","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"39.21839888","longitude":"-83.3854695"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/03232500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/03232500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":"Previous Flowbands: \nHigh Runnable Range (R5-R9): 600 - 1000 cfs Adjusted Difficulty: IItoIII Comment: Well-experienced whitewater boaters only. Strainers will have increased danger at these flows.\nLow Runnable Range (R0-R5): 250 - 600 cfs  Comment: Suitable for class 1-2 boaters and for a scenic float.\n\nMigration Errors: \nFor two ranges, R0 to R9 is not covered exactly","comment":null,"status":{"status":"below-recommended","latestReading":{"value":"12","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["101931","101982","101928","101929","101932","101983","101986"],"geometry":{"type":"LineString","coordinates":[[-83.43747447909642,39.18277406335461],[-83.43676351426309,39.182393472514434],[-83.43639191426365,39.18223427251468],[-83.4363985809303,39.18214780584816],[-83.43623598093058,39.182109805848256],[-83.43586998093116,39.18174400584877],[-83.43530938093204,39.1815984725157],[-83.43498851426585,39.181448005849234],[-83.43457198093319,39.18108340584985],[-83.434257914267,39.180765672517],[-83.43393811426745,39.18064460585049],[-83.43247331426977,39.180272272517755],[-83.43192478093727,39.180106872518024],[-83.43176411427083,39.18016587251793],[-83.43167038093765,39.180053205851436],[-83.43119958093837,39.179945205851595],[-83.43052611427277,39.17982167251847],[-83.43000438094026,39.17970480585194],[-83.42920658094147,39.179633005852054],[-83.42817571427645,39.17976260585186],[-83.42761438094398,39.17996107251821],[-83.42713298094469,39.179912072518334],[-83.42634038094593,39.17962400585208],[-83.42616318094622,39.17962220585207],[-83.42612078094629,39.17948120585231],[-83.42567898094694,39.1791170058529],[-83.42543638094736,39.178670005853576],[-83.42502091428133,39.17833467252075],[-83.42432198094906,39.17783840585486],[-83.42360911428352,39.17766640585512],[-83.4227987142848,39.17759487252192],[-83.42262231428504,39.177464205855415],[-83.4223873142854,39.177543805855294],[-83.42182558095294,39.177384072522216],[-83.42078031428792,39.17697287252287],[-83.4198095809561,39.17671347252327],[-83.41906791429057,39.1767108725233],[-83.41841991429158,39.176733405856574],[-83.4