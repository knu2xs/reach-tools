[{"result":{"data":{"json":{"id":"1229","stub":{"id":"1229","section":"02. Rio Lucio to Rio Grande Confluence","altname":"","river":"Rio Pueblo de Taos","difficulty":"IItoV","states":["USA-NME"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"108204","location":{"latitude":"36.199","longitude":"-105.71"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"1229","permitUrl":"","permitInfo":"","description":"For information, see _New Mexico Whitewater_, by NM State Parks & [_Rivers of The Southwest_](http://www.amazon.com/Rivers-Southwest-Boaters-Colorado-Arizona/dp/0871086077), by Anderson and Hopkinson.\n\nPreviously, this was described as \"Rio Lucio to Rio Grande Confluence.\" However, Rio Pueblo does not flow to the Rio Grande; it flows to [Embudo Creek](http://americanwhitewater.org/content/River/detail/id/3592/), which in turn runs to the Rio Grande. Looking at the topo maps, it looks as though all the good stuff on El Rio Pueblo is upstream of Rio Lucio, maybe from Tres Ritos (36.12800, -105.50967) downstream. Anyone with better beta on this run is invited to share it by adding a comment.\n\nClass: II-VI","averageGradient":null,"maxGradient":null,"length":"13","correlations":[],"pointOfInterestIDs":["108204"],"geometry":{"type":"LineString","coordinates":[[-105.730705,36.199023],[-105.73107,36.199179],[-105.731231,36.199222],[-105.731435,36.199205],[-105.731885,36.19898],[-105.732186,36.198962],[-105.732422,36.198997],[-105.732658,36.198936],[-105.732679,36.198921],[-105.732679,36.198921],[-105.732679,36.198921],[-105.733044,36.198651],[-105.733291,36.198538],[-105.733677,36.198495],[-105.733892,36.19853],[-105.734149,36.198495],[-105.734254,36.198447],[-105.734254,36.198447],[-105.73445,36.198356],[-105.734578,36.198278],[-105.734578,36.198278],[-105.734718,36.198209],[-105.735018,36.198157],[-105.73519,36.198105],[-105.735544,36.19788],[-105.73