[{"result":{"data":{"json":{"id":"1800","stub":{"id":"1800","section":"Catoosa Road to Daddy's Creek","altname":"","river":"Yellow Creek (Daddy's Crk. trib/Cumberland Co.)","difficulty":"IIItoIVplus","states":["USA-TNN"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"43","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Parking upstream river right 30 feet 80 feet from bridge","id":"2538","location":{"latitude":"0","longitude":"0"},"name":"Yellow Creek Bridge","distance":"0","photoID":null,"difficulty":null,"approximate":false},{"type":"hazard","description":"Pay attention here, that's all.   There is wood and undercut banks.","id":"2533","location":{"latitude":"0","longitude":"0"},"name":"With Teeth","distance":"0.2","photoID":"0","difficulty":"IV","approximate":false},{"type":"portage","description":"Its easy to blow right into this one, and its the hardest rapid on the run.  Enter center then right, catching an eddy behind a boulder in the middle.  From this micro-eddy you can see the line clearly.  Left of center all the way down, knifing through an undercut notch.  There is a drain sieve on the right in the hanging eddy halfway down.  Don't mess with it.  You may or may not be able to see a whirlpool sucking water down, but there is room for more in there.","id":"2534","location":{"latitude":"0","longitude":"0"},"name":"Pretty Hate Machine","distance":"0.3","photoID":"39449","difficulty":"IV","approximate":false},{"type":"hazard","description":"Tight and fun. You will miss the entrance channel on river left your first time, but can launch in off a rock for the final drop, or ferry back upstream and enter the channel at the top.","id":"2536","location":{"latitude":"0","longitude":"0"},"name":"Downward Spiral","distance":"0.4","photoID":"0","difficulty":"IV","approximate":false},{"type":"hazard","description":"Boat scoutable, just boof off right into the hanging eddy to see what the deal is","id":"2535","location":{"latitude":"0","longitude":"0"},"name":"Broken","distance":"0.5","photoID":"0","difficulty":"III+","approximate":false},{"type":"rapid","description":"Water colume increase, Water quality decrease","id":"2537","location":{"latitude":"0","longitude":"0"},"name":"Confluence with Daddy's Creek","distance":"1.3","difficulty":null,"approximate":false,"photoID":null},{"type":"takeout","description":null,"id":"115326","location":{"latitude":"36.0286","longitude":"-84.8089"},"name":"Take Out","distance":"1.3","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"101252762","title":null,"post_date":"2016-12-27 05:00:00+00","detail":"Watch for submerged wood at the bottom of the drop in Downward Spiral. There is a large 4\"-6\" diameter piece of wood wedged at the bottom of the drop. Visible only if you get out and look for it. Currently presents a serious pinning hazard.","user":{"name":"David Walton"}},{"id":"101249915","title":null,"post_date":"2012-12-21 05:00:00+00","detail":"The log across the river is still there above Pretty Hate Machine. It's high enough that little guys can squeeze under it. I chose to portage.","user":{"name":"Brandon Hughett"}},{"id":"101093476","title":null,"post_date":"2009-09-27 04:00:00+00","detail":"There is a large strainer right about Pretty Hate Machine. Right after the put in you make a couple of moves down to the left where the large boulder is right before Pretty Hate Macine. A log spans the entire channel.","user":{"name":"John Guthrie"}}],"photos":[{"id":"39451","ext":"jpeg","post_id":"8676","description":"","caption":"Pretty Hate Machine","poi_name":"","subject":"John Guthrie","author":"Kemper Begley","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/39451","large":"https://api.americanwhitewater.org/image/images/big/39451"}},{"id":"39447","ext":"jpeg","post_id":"8676","description":"","caption":"First Hard Rapid","poi_name":"Pretty Hate Machine","subject":"John Guthrie","author":"Kemper Begley","poi_id":"2533","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/39447","large":"https://api.americanwhitewater.org/image/images/big/39447"}},{"id":"39449","ext":"jpeg","post_id":"8676","description":"","caption":"Entrance - Pretty Hate Machine","poi_name":"Pretty Hate Machine","subject":"John Guthrie","author":"Kemper Begley","poi_id":"2533","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/39449","large":"https://api.americanwhitewater.org/image/images/big/39449"}},{"id":"39452","ext":"jpeg","post_id":"8676","description":"","caption":"Pretty Hate Machine","poi_name":"Pretty Hate Machine","subject":"John Guthrie","author":"Kemper Begley","poi_id":"2533","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/39452","large":"https://api.americanwhitewater.org/image/images/big/39452"}}],"detail":{"id":"1800","permitUrl":null,"permitInfo":null,"description":"This run is smaller than [Island](http://americanwhitewater.org/content/River/view/river-detail/1755/), pretty similar in size to [Little Clear Creek](http://americanwhitewater.org/content/River/view/river-detail/2658/). It is not as quality as either, but is still a pristine and tiny plateau creek worth checking out.\n\nThe run starts with some easy 2-3 bedrock and then goes off a nice 6-foot sliding drop. After this is a set of crappy drops with wood and undercuts, With Teeth. Be on guard, especially at levels above 1 foot. After a tight bend to the right in this set, quickly get out and scout the next one for wood. This is the big rapid on the run, Pretty Hate Machine. It is a class-4 rapid with a nasty sieve on the right and a tight undercut passage on the left. You'll want to understeer this one on the left, lest you end to end in the slot. 2/3 of the time it is choked full of wood and getting out above it can be risky for the less than competent, or for anyone in there at high water. For the most part this drop sucks.\n\nAfter this, the quality steps back up with plenty of read and run class 3 microcreeking. A hundred yards or more below the big one is Downward Spiral, a cool drop that needs to be entered on a channel on the left by ducking through some brush. Once into the groove, a nice shoulder boof high on the right will prevent an unpleasant pocket beat-down on the left. Set safety here if at all in doubt.\n\nNext is Broken, a fun drop where you boof right off a center rock into an eddy, then ferry in behind the boof with all the flow, which slams into an undercut on the river left wall. You are heading towards the undercut, but if you drive right too soon or angle too hard right, you will hit a fan rock that will most likely deflect you hard into the undercut. Patience, grasshopper!\n\nThe problem with this run you will see, is it's not long enough. After downward spiral there is a little more boogie, with a neat slot against the right wall and another with a cool undercut cave on river right. This marks the end of the goods and the beginning of the class-2 paddle out.\n\nThis run is cool, but really is just a better putin option for [Daddy's](http://americanwhitewater.org/content/River/view/river-detail/1740/) anytime it is going. Like most plateau microcreeks, the scenery is beyond description. Beautiful evergreen mixed with hardwood and pine, beautiful clear and green water, and intimacy make up for any lack of rapids quality or consistency.\n\nOne more thing to remember is you will be dumped into Daddy's half a mile above the canyon. If Daddy's is between 1.5 and 2.5 this will not be a problem, but if above 2.5-3 feet, be ready for continuous class 4 and dangerous conditions. If Daddy's is above 4 feet, Yellow would likely be too high anyway, but consider other options if not up for class 5 big water. I have run the combo when Yellow was 1.2 and Daddy's was 1.5. I have also done it when Yellow was 0.5 and Daddy's was 2.7. Bottom line is: find out where the rain fell. Streamflow gauges tell but one side of the story","averageGradient":"100","maxGradient":"150","length":"3.6","correlations":[{"reachID":"1800","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"900","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"3000"},"gaugeInfo":{"name":"DADDYS CREEK NEAR HEBBERTSBURG, TN","gaugeSource":"USGS","gaugeSourceIdentifier":"03539600","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"43","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.75","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"35.99766528","longitude":"-84.8224946"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/03539600","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/03539600/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"43","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["2538","2533","2534","2536","2535","2537","115326"],"geometry":{"type":"LineString","coordinates":[[-84.784408,36.002097],[-84.784486,36.002298],[-84.784601,36.002545],[-84.784722,36.002743],[-84.78481,36.002847],[-84.784884,36.002897],[-84.784966,36.002935],[-84.785108,36.002963],[-84.785304,36.002957],[-84.785432,36.002925],[-84.786298,36.002655],[-84