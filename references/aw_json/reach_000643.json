[{"result":{"data":{"json":{"id":"643","stub":{"id":"643","section":"Teton Dam site to Teton Forks","altname":"","river":"Teton","difficulty":"IItoIII","states":["USA-IDA"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"110803","location":{"latitude":"43.9097213745117","longitude":"-111.538330078125"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"116069","location":{"latitude":"43.9122009277344","longitude":"-111.616302490234"},"name":"Take Out","distance":"6.3","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"10715","ext":"jpeg","post_id":"1134","description":"The works at the base of the dam are now flooded; the flow has taken on a violent character. Most observers must have known at this point that there would be no saving the new dam. Photo used with permission from the <a href=\"http://www.geol.ucsb.edu/faculty/sylvester/Teton%20Dam/welcome_dam.html\">Teton Dam Failure site</a>.","caption":"The leak increases","poi_name":"","subject":"","author":"Mrs. Eunice Olson","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10715","large":"https://api.americanwhitewater.org/image/images/big/10715"}},{"id":"10716","ext":"jpeg","post_id":"1134","description":"As the leak grew, it reached the crest of the dam. Photo used with permission from the <a href=\"http://www.geol.ucsb.edu/faculty/sylvester/Teton%20Dam/welcome_dam.html\">Teton Dam Failure site</a>.","caption":"Breach of Teton Dam","poi_name":"","subject":"","author":"Mrs. Eunice Olson","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10716","large":"https://api.americanwhitewater.org/image/images/big/10716"}},{"id":"10717","ext":"jpeg","post_id":"1134","description":"Everything's flooded. Your tax dollars at work!<br>\r\nPhoto used with permission from the <a href=\"http://www.geol.ucsb.edu/faculty/sylvester/Teton%20Dam/welcome_dam.html\">Teton Dam Failure site</a>.","caption":"Teton Dam Failure","poi_name":"","subject":"","author":"Mrs. Eunice Olson","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10717","large":"https://api.americanwhitewater.org/image/images/big/10717"}},{"id":"1560","ext":"jpeg","post_id":"1134","description":"For the full-sized version of this picture, <a href=\"http://www.americanwhitewater.org/photos/?photoid=10716\">click here</a>.<br>\r\nPhoto used with permission from the <a href=\"http://www.geol.ucsb.edu/faculty/sylvester/Teton%20Dam/welcome_dam.html\">Teton Dam Failure site</a>.","caption":"Breach of Teton Dam","poi_name":"","subject":"","author":"Mrs. Eunice Olson","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1560","large":"https://api.americanwhitewater.org/image/images/big/1560"}},{"id":"10714","ext":"jpeg","post_id":"1134","description":"The brown streak running down the river-right part of the dam is the harbinger of a failure to come. It took about an hour from the time this photo was taken until the dam was breached. Photo used with permission from the <a href=\"http://www.geol.ucsb.edu/faculty/sylvester/Teton%20Dam/welcome_dam.html\">Teton Dam Failure site</a>.","caption":"Leak in Teton Dam","poi_name":"","subject":"","author":"Mrs. Eunice Olson","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10714","large":"https://api.americanwhitewater.org/image/images/big/10714"}}],"detail":{"id":"643","permitUrl":null,"permitInfo":null,"description":"Data from Pacific NW Rivers Study, Stan Allen, Idaho Coordinator\n\nThe Teton Dam is a famous study of poor civil engineering feeding pork-barrel politics. As the project was reaching completion and the reservoir was being filled, a large leak formed...and, on June 5, 1976, the developing project came to an abrupt, and tragic, end. Two bulldozers were used in trying to stem the developing leak; they both were swallowed by the flood. Fourteen people downstream lost their lives. The project is described in Marc Reisner's excellent book, _[Cadillac Desert](http://www.amazon.com/exec/obidos/ASIN/0140178244/americanwhite-20)_. [Click here for a recriminating description of the failed project](http://www.idahoptv.org/outdoors/shows/bofr/teton/brown.html); [click here for a more academic description](http://www.geol.ucsb.edu/faculty/sylvester/Teton%20Dam/narrative.html), complete with [some excellent pictures](http://www.geol.ucsb.edu/faculty/sylvester/Teton%20Dam/FrameSet.htm) by Mrs. Eunice Olson.\n\nPut in just above the old spillway.","averageGradient":null,"maxGradient":null,"length":"6.9","correlations":[],"pointOfInterestIDs":["110803","116069"],"geometry":{"type":"LineString","coordinates":[[-111.540446,43.908501],[-111.540312,43.908267],[-111.540175,43.907823],[-111.540087,43.907492],[-111.540007,43.907306],[-111.539826,43.907076],[-111.53984,43.906919],[-111.540019,43.90685],[-111.540135,43.906821],[-111.540296,43.906786],[-111.540418,43.90677],[-111.540471,43.906754],[-111.540585,43.906721],[-111.540714,43.906671],[-111.540888,43.906605],[-111.541056,43.906529],[-111.541253,43.906441],[-111.541314,43.906413],[-111.541367,43.90638],[-111.541427,43.906348],[-111.541496,43.906304],[-111.541557,43.90626],[-111.54161,43.906227],[-111.541663,43.906188],[-111.541716,43.906139],[-111.541838,43.90604],[-111.541921,43.905958],[-111.541997,43.905881],[-111.542027,43.905837],[-111.542088,43.905738],[-111.542119,43.905695],[-111.542149,43.905662],[-111.542172,43.90564],[-111.542202,43.905623],[-111.54224,43.905601],[-111.542301,43.905568],[-111.542377,43.905535],[-111.542453,43.905497],[-111.542604,43.905431],[-111.542855,43.905332],[-111.542969,43.90528