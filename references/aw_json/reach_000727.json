[{"result":{"data":{"json":{"id":"727","stub":{"id":"727","section":"Barrelville to Wills Creek","altname":"","river":"Jennings Run","difficulty":"IIIplus","states":["USA-MRY"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"66","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"109965","location":{"latitude":"39.7004013061523","longitude":"-78.8431015014648"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"115217","location":{"latitude":"39.6946983337402","longitude":"-78.7863998413086"},"name":"Take Out","distance":"3.5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"727","permitUrl":null,"permitInfo":null,"description":"This is one of the few creeks for which you should ignore Gertler's description because it has been transformed since he ran it. The rapids are pretty continuous, and a few of them reach class III+. Stop and scout when you reach a big ledge, a little more than midway. Even at moderate levels, the hole at the bottom of the central tongue can be sticky, so you might want to stay near the right side of the creek instead. The gradient finally eases up in the final mile. On my three runs, we never encountered any creek-wide strainers, but that could change, of course.\n\nOne could also start 2 miles higher up, at Mt. Savage (put in by the Volunteer Fire Department), with 115 ft/mile gradient, and get a nice 5-mile run.  That needs somewhat more water, but is otherwise probably pretty similar (I have run the second mile of this part, but not the first).  Check for strainers from the road near the start.\n\nEd Evangelidi testifies:\n\nThis creek has suffered much past abuse but recent improvements have removed sewage, strainers and other man made trash. Just the nice rapids remain for your enjoyment.\n\nLat/longitude coords are approximate, from TopoZone.","averageGradient":"75","maxGradient":"0","length":"3.4","correlations":[{"reachID":"727","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"700","beginMediumRunnable":"800","beginHighRunnable":"1500","endHighRunnable":"3000"},"gaugeInfo":{"name":"Wills Creek below Hyndman, PA","gaugeSource":"USGS","gaugeSourceIdentifier":"01601000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"66","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.92","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"39.81202897","longitude":"-78.7164072"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/01601000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/01601000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"66","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["109965","115217"],"geometry":{"type":"LineString","coordinates":[[-78.84306950254935,39.70110300131034],[-78.84290438806033,39.70109547170932],[-78.84267692139406,39.701062605042694],[-78.84247778806099,39.701073605042666],[-78.84232152139458,39.7010682050427],[-78.84155372139577,39.70077187170983],[-78.84121252139632,39.700684071709986],[-78.84044492139748,39.70057447171013],[-78.8400255880648,39.700580005043435],[-78.83944272139905,39.70061860504342],[-78.8393787880658,39.700596605043415],[-78.83936452139915,39.70055827171018],[-78.8392863213993,3