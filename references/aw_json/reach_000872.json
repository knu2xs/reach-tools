[{"result":{"data":{"json":{"id":"872","stub":{"id":"872","section":"Oakes Bog to Blanchard","altname":"","river":"Piscataquis, W. Branch","difficulty":"IVtoV","states":["USA-MAI"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"111609","location":{"latitude":"45.3153991699219","longitude":"-69.6877975463867"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"116880","location":{"latitude":"45.2675018310547","longitude":"-69.5843963623047"},"name":"Take Out","distance":"9","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"883693","ext":"jpeg","post_id":"886390","description":"Hell Hole drop on the West Piscataquis.  Looks far uglier in person than it does in the picture.","caption":"West Pis Hell Hole","poi_name":null,"subject":null,"author":"Nathan Warren","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/883693","large":"https://api.americanwhitewater.org/image/images/big/883693"}},{"id":"883692","ext":"jpeg","post_id":"886389","description":"West Piscataquis Put-in.","caption":"West Pis Put In","poi_name":null,"subject":null,"author":"Nathan Warren","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/883692","large":"https://api.americanwhitewater.org/image/images/big/883692"}}],"detail":{"id":"872","permitUrl":"","permitInfo":"","description":"River info provided by Nate Warren:\n\nDIRECTIONS: Takeout at the bridge over the Piscataquis in the center of Blanchard, the same spot as the East Piscataquis takeout.  As an alternate to the Crossover Road put-in, follow West Rd. westbound out of Shirley.  This will turn into CCC road.  If you can make it to the junction of CCC road and Clouse Allen Road (where gates & snow may hinder you), you are near the put in.  Hike west down hill on CCC road until you find the bridge across the river.  This upper put-in would also be a great place to camp.  From here, enjoy the flatwater, birds and scenery as you meander through miles of Quebec-esque wilderness.  [Use this GoogleMap as a reference.](https://www.google.com/maps/dir/45.3549265,-69.685849/45.2675945,-69.5832794/@45.3169298,-69.7025628,12z/data=!4m9!4m8!1m5!3m4!1m2!1d-69.538917!2d45.3320052!3s0x4cb0693db65a72f1:0xc56f2c84c5e16570!1m0!3e1)\n\nDESCRIPTION: The West Branch of the Piscataquis is a long river run with epic flat sections, long, continuous class 3 sections, a few class four rapids thrown in for fun, and one very solid class 5 (Hell Hole), about 3/4 of the way down.  Hell hole is a 10 foot ledge funneling into a very deep and violent hole.  Scout or portage on the left.  Just below is a IV-V double ledge drop, then more continuous boogie water down to the confluence with the East Pis above Blanchard.  Though not as challenging as the East Pis, this is a great wilderness river run with a few fun and challenging rapids.\n\nPut-in & Takeout coordinate info from John Porterfield","averageGradient":null,"maxGradient":null,"length":"10","correlations":[],"pointOfInterestIDs":["111609","116880"],"geometry":{"type":"LineString","coordinates":[[-69.68763080227114,45.31559999632782],[-69.68747546893809,45.3155155296613],[-69.68737186893821,45.31542159632812],[-69.68723966893845,45.315300929661646],[-69.6871452689386,45.31521592966175],[-69.68704540227208,45.31516312966181],[-69.68778486893757,45.314570796329406],[-69.68797286893732,45.31435779632978],[-69.68803500227051,45.31418592966338],[-69.68791146893739,45.314074329663526],[-69.68756746893791,45.31392199633041],[-69.68708480227203,45.3133813296646],[-69.6868436022724,45.3129939963319],[-69.68661346893941,45.312860796332075],[-69.68648086893961,45.312552529665886],[-69.68650486893956,45.31248339633265],[-69.68675226893919,45.31237332966617],[-69.68716526893854,45.312472529666024],[-69.