[{"result":{"data":{"json":{"id":"590","stub":{"id":"590","section":"2. McCall to Hartsell Bridge above Cascade Reservoir","altname":"","river":"Payette, N. Fork","difficulty":"IItoIII","states":["USA-IDA"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"1050","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"112111","location":{"latitude":"44.911646","longitude":"-116.118986"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"access","description":"Division point between the class III section (upstream) and the class II (downstream).","id":"106714","location":{"latitude":"44.891203","longitude":"-116.109727"},"name":"Sheep Creek Bridge","distance":"0","photoID":"0","difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"117389","location":{"latitude":"44.790488","longitude":"-116.140901"},"name":"Take Out","distance":"9","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"a7Dtz2rIA2SB1mH6d3ICw","title":"Town stretch is mostly clear of strainers","post_date":"2026-05-06 23:59:02+00","detail":"With an IDWR permit in hand, volunteers have removed the most hazardous strainers from Lardo Bridge to Deinhard bridge. The strainers have all floated downriver to … somewhere. Be on the lookout for them in the Deinhard to Cascade reservoir sections of the river.","user":{"name":"Jim Pace"}},{"id":"oEpIiUw1BH95BMYzIKESj","title":"Log jams in the town stretch","post_date":"2026-04-12 14:13:01+00","detail":"As of 4/12/26, there are a half dozen serious navigational hazard log jams in the town stretch (Lardo bridge to Deinhard bridge). 2 logs require boaters to portage. Until an IDWR stream alteration permit is issued to remove the jams, I highly recommend avoiding this section.","user":{"name":"Jim Pace"}}],"photos":[],"detail":{"id":"590","permitUrl":"","permitInfo":"","description":"Starting in McCall, the first 2.5 miles of the run down to Sheep Bridge has been a training ground for local paddlers for many years during the spring. One class III rapid is approximatley a mile downstream of the McCall Fish Hatchery. Flows of 1000 to 3500 cfs are ideal for this reach.\n\nDownstream of Sheep Bridge, the river river meanders back and forth across this lush valley just downstream of McCall and makes for a good day trip. This lower reach can be run at lower flows (above 200 cfs) as a float trip through the summer.","averageGradient":"2","maxGradient":"0","length":"15.6","correlations":[{"reachID":"590","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"200","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"4000"},"gaugeInfo":{"name":"NF PAYETTE RIVER AT MCCALL ID","gaugeSource":"USGS","gaugeSourceIdentifier":"13239000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"1050","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"4.44","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"44.9072222","longitude":"-116.1191667"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/13239000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/13239000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"migration-runnable","latestReading":{"value":"1050","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["112111","106714","117389"],"geometry":{"type":"Li