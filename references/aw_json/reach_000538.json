[{"result":{"data":{"json":{"id":"538","stub":{"id":"538","section":"Blaine Bridge to Moonstone Landing","altname":"","river":"Camas Creek (Snake trib)","difficulty":"III","states":["USA-IDA"]},"primaryGaugeStatus":{"status":null,"latestReading":{"value":"14","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"109760","location":{"latitude":"43.3344459533691","longitude":"-114.588607788086"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"115010","location":{"latitude":"43.3227767944336","longitude":"-114.417221069336"},"name":"Take Out","distance":"7","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"538","permitUrl":null,"permitInfo":null,"description":"The put in is at the Blaine bridge and the take out, Moonstone Landing. The run starts off slow, but picks up about 2 miles below the put in at Macon Sheep Bridge.  Downstream from Macon Sheep bridge, there are a handful of straight forward, fun class 3 rapids in a scenic canyon.  The last 0-1 miles is  flatwater across a reservoir depending on how full it is.\n\nIt is advantageous to paddle the run after it has been flowing for a few days to let the cow pasture runoff and grey water from Fairfield get flushed through.  It was runnable class three at both 500 and 1800 cfs.","averageGradient":null,"maxGradient":null,"length":"10.8","correlations":[{"reachID":"538","isPrimary":true,"correlationDetails":null,"migrationErrorExplanation":null,"gaugeInfo":{"name":"CAMAS CREEK NR BLAINE ID","gaugeSource":"USGS","gaugeSourceIdentifier":"13141500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"14","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"2.37","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"43.