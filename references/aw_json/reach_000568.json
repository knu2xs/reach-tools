[{"result":{"data":{"json":{"id":"568","stub":{"id":"568","section":"1 - Powell to White Pine (Indian Grave Creek)","altname":"","river":"Lochsa","difficulty":"IItoIII","states":["USA-IDA"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"6.8","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Access on river right in the campground. The easiest access point requires walking through a campsite. It would be beneficial to have a dedicated river access and day-use site here.","id":"110964","location":{"latitude":"46.50652","longitude":"-114.686003"},"name":"White Sand Campground Put In","distance":"0.28","photoID":"GQHxp2tS9aB6pQQrzSlOl","difficulty":"N/A","approximate":false},{"type":"rapid","description":"River valley narrows following a gravel bar island that marks the approach to this rapid that is approximately 1/4 mile of fun waves and holes you can scout from a pull out along the highway. Highway Mile 157.1.","id":"102284","location":{"latitude":"46.5077018737793","longitude":"-114.79499816894531"},"name":"Cold Storage","distance":"6.77","difficulty":"III","approximate":false,"photoID":"884801"},{"type":"rapid","description":"Large waves but a straight shot. Highway Mile 155.2.","id":"102285","location":{"latitude":"46.495601654052734","longitude":"-114.8489990234375"},"name":"Unnamed","distance":"9.71","difficulty":"II","approximate":false,"photoID":"884802"},{"type":"rapid","description":"Straightforward rapid. Highway Mile 151.0.","id":"102286","location":{"latitude":"46.473899841308594","longitude":"-114.8949966430664"},"name":"Jerry Johnson","distance":"13.27","difficulty":"II","approximate":false,"photoID":"884803"},{"type":"access","description":"Dispersed camp site at Colgate with a good river access point at Highway 12 mile 147.7.","id":"102289","location":{"latitude":"46.46879959106445","longitude":"-114.9440002441406