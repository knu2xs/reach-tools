[{"result":{"data":{"json":{"id":"1525","stub":{"id":"1525","section":"Blodgett to Philomath","altname":"","river":"Marys","difficulty":"ItoII","states":["USA-ORE"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"113","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"108080","location":{"latitude":"44.5812","longitude":"-123.508"},"name":"Harris Road Bridge Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"access","description":"Access point at the covered bridge.","id":"kqOZaPJOnKVSv4OnI7vMS","location":{"latitude":"44.580076","longitude":"-123.460232"},"name":"Harris Road Covered Bridge Access","distance":"5.1","photoID":null,"difficulty":"N/A","approximate":false},{"type":"access","description":"Access at the Highway 20 Bridge across the river.","id":"101361","location":{"latitude":"44.593663","longitude":"-123.440094"},"name":"Wren Access, Hwy 20 Bridge","distance":"9.23","photoID":"0","difficulty":"N/A","approximate":false},{"type":"access","description":"Access at the Kings Valley High Bridge where it crosses the river near the junction with Priest Road.","id":"58XX4wbyDcxcUmuaf9Cft","location":{"latitude":"44.596328","longitude":"-123.425728"},"name":"Kings Valley Hwy 223 Bridge Access","distance":"10.41","photoID":null,"difficulty":"N/A","approximate":false},{"type":"access","description":null,"id":"113323","location":{"latitude":"44.539977","longitude":"-123.386853"},"name":"Alsea Highway 34 Bridge Access","distance":"18.71","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"Take at the park on river left.","id":"drnqd4IR33Yi0OpQlKWlL","location":{"latitude":"44.534413","longitude":"-123.373028"},"name":"Marys River Park Take Out","distance":"18.74","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"1525","permitUrl":null,"permitInfo":"","description":"A coast range river that runs in the rainy season.  Almost no significant whitewater except a blind drop just below the Harris Covered Bridge west of Wren and a blown-out weir at the end of  Mustang Lane just west of Philomath between the US Highway 20 and Oregon Highway 34 bridges.  There are a couple other class II- rapids along the way.  Always be alert for wood; even though the gradient is low and the rapids are relatively tame, blind corners can hide log jams.  Banks can be muddy, steep, and covered with blackberries making portage around log jams an experience in Type Two Fun.\n\nAccess is difficult for the upper stretches and usually involve dragging your boat down or up a muddy slope under a road bridge, usually with blackberries and/or poison oak.  Such fun.  There are slightly easier accesses along Harris Road.  There is an easier access at Marys River Park in Philomath.  There is an access with a long carry at Avery Park in Corvallis.  There used to be an access at Pioneer Boat Basin near the confluence with the Willamette River, but the City of Corvallis has failed to maintain this access for so many years few people remember being able to paddle right up to the dock.  The easiest take-out is a mile downstream on the Willamette at Aqua-enthusiast Park, locally known as Michael's Landing.  A more difficult take-out can be had by paddling a half mile upstream to Willamette Park at the Crystal Lake Boat Ramp.\n\nA description of the run is published in the Willamette Kayak & Canoe Club's guide, 'Soggy Sneakers' through the fifth (current) edition.  In thFifth Edition, it is Run Number 95 on page 174.  This description is from Wren to Philomath.  The Second Edition had a description of the river above Wren up to Blodget.  No description is published from Philomath to the confluence with the Willamette.  Below Philomath there is no whitewater, but there can for sure be obstructions.","averageGradient":"5","maxGradient":"20","length":"20","correlations":[{"reachID":"1525","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"500","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"900"},"gaugeInfo":{"name":"MARYS RIVER NEAR PHILOMATH, OR","gaugeSource":"USGS","gaugeSourceIdentifier":"14171000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"113","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.51","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"44.525","longitude":"-123.334"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/14171000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/14171000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"113","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["108080","kqOZaPJOnKVSv4OnI7vMS","101361","58XX4wbyDcxcUmuaf9Cft","113323","drnqd4IR33Yi0OpQlKWlL"],"geometry":{"type":"LineString","coordinates":[[-123.507605,44.581217],[-123.507893,44.581153],[-123.508086,44.581069],[-123.508086,44.581069],[-123.508333,44.580962],[-123.508644,44.580717],[-123.508601,44.580282],[-123.50855,44.580216],[-123.508547,44.580217],[-123.508135,44.579686],[-123.506652,44.578558],[-123.504868,44.577702],[-123.504222,44.577299],[-123.503879,44.576896],[-123.503801,44.576599],[-123.503987,44.576301],[-123.504325,44.576084],[-123.504965,44.575838],[-123.505305,44.575782],[-123.506473,44.575372],[-123.507489,44.574881],[-123.50