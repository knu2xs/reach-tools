[{"result":{"data":{"json":{"id":"1959","stub":{"id":"1959","section":"Wardell (Route 19) to Clinch River","altname":"","river":"Little (Clinch R. trib)","difficulty":"ItoII","states":["USA-VRG"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"279","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"The put-in is on river right, north of Rt. 19 along Rt. 609. If driving west on Rt. 19, turn right on Rt. 609 at the light and you'll see a gravel pull-out with great access in less than a quarter mile.\n\nAnother possibility is south of Rt. 19 (upstream) at the intersection of Wardell Rd. (Rt. 609) and Ascue Rd. (Rt. 770), on the river right downstream side of the bridge, with limited parking.\n\nThere's also a park and ride on the south side of the Rt. 19 bridge over the Little, but that is probably the least convenient option.","id":"110495","location":{"latitude":"37.040515","longitude":"-81.798144"},"name":"Put In","distance":"0.02","photoID":"h66JGlJPH3EZwGdFAy2YF","difficulty":"N/A","approximate":false},{"type":"access","description":"Possible but difficult/steep access on the river right upstream side of the Kents Ridge Rd. bridge (Rt. 636) with tight parking on the other side of the road.","id":"asOPwuuLM8MDZUHqCQT6j","location":{"latitude":"37.012647","longitude":"-81.904264"},"name":"Access point - Kents Ridge Rd","distance":"13.8","photoID":"tN3hnTfTLRMdxKIqZRot9","difficulty":"N/A","approximate":false},{"type":"takeout","description":"Take out river left just after entering the Clinch River. Limited parking. From Rt. 80, turn on to Clifton Farm Rd. (Rt. 640) and drive 1.2 miles to the confluence. Clifton Farm Rd. continues to follow the river for about a mile upstream, so other access points might be possible (but tight in regard to parking).\n\nAlternatively, the developed Blackford Bridge access on the Clinch is 3 miles downstream just before the Rt. 80 bridge, river right.","id":"115759","location":{"latitude":"37.001399","longitude":"-81.925987"},"name":"Take Out - Clinch confluence","distance":"17.14","photoID":"T3aj5cf36jzs9MD6X2BBi","difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"T3aj5cf36jzs9MD6X2BBi","ext":"jpg","post_id":"3Fjg1x0xU0ghYqmRDMR7b","description":"","caption":"Takeout - Little/Clinch confluence","poi_name":null,"subject":"Takeout","author":"Philip Young","poi_id":"115759","photo_date":"2025-02-11T12:59:14.000Z","updated_at":"2025-04-22T12:59:14.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/T3aj5cf36jzs9MD6X2BBi","large":"https://api.americanwhitewater.org/image/images/big/T3aj5cf36jzs9MD6X2BBi"}},{"id":"KGAggt0uC4647b0HewqgO","ext":"jpg","post_id":"3Fjg1x0xU0ghYqmRDMR7b","description":"","caption":"","poi_name":null,"subject":"","author":"Philip Young","poi_id":null,"photo_date":"2025-02-11T12:59:14.000Z","updated_at":"2025-04-22T12:59:14.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/KGAggt0uC4647b0HewqgO","large":"https://api.americanwhitewater.org/image/images/big/KGAggt0uC4647b0HewqgO"}},{"id":"h66JGlJPH3EZwGdFAy2YF","ext":"jpg","post_id":"3Fjg1x0xU0ghYqmRDMR7b","description":"","caption":"Little River put-in, Rt. 609","poi_name":null,"subject":"Put-in","author":"Philip Young","poi_id":"110495","photo_date":"2025-02-11T12:59:14.000Z","updated_at":"2025-04-22T12:59:14.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/h66JGlJPH3EZwGdFAy2YF","large":"https://api.americanwhitewater.org/image/images/big/h66JGlJPH3EZwGdFAy2YF"}},{"id":"tN3hnTfTLRMdxKIqZRot9","ext":"jpg","post_id":"3Fjg1x0xU0ghYqmRDMR7b","description":"","caption":"Kents Ridge Rd. access (Rt. 636)","poi_name":null,"subject":"","author":"Philip Young","poi_id":"asOPwuuLM8MDZUHqCQT6j","photo_date":"2025-02-11T12:59:14.000Z","updated_at":"2025-04-22T12:59:14.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/tN3hnTfTLRMdxKIqZRot9","large":"https://api.americanwhitewater.org/image/images/big/tN3hnTfTLRMdxKIqZRot9"}}],"detail":{"id":"1959","permitUrl":null,"permitInfo":null,"description":"This is a long, isolated section of river offering intermittent mild whitewater, good scenery, and plenty of solitude. After putting in at Wardell, there is no public access until the Kents Ridge bridge (Rt. 636) about 14 miles downstream. The first few miles are mostly flat, although the current moves along well. After this, there are only a few rapids qualifying as class II, although there are many long, enjoyable sections of riffles. The largest class II is at a bend to the left and can be heard well before it's seen. The banks are almost all forested, with occasional cliffs, and the middle of this section is the most attractive. Lots of turtles and bird life. Hazards mostly involve tree strainers, though the Little is wide enough that most fallen trees are not able to span the entire stream. No portages were needed as of mid-2025. Near the end, with a pasture on river left, watch for a wire across the stream with loose wires hanging down, with a second one shortly afterward. Decked boats can duck under but it might be a problem for canoes. Taking out at the Kents Ridge bridge is difficult but doable, and parking is tight. In another 2 miles (making it 16 miles total), Clifton Farm road is alongside on river left with better access options both upstream of and at the Clinch confluence.\n\nThere is also a section of the Little upstream of Wardell that is paddleable, described in Gertler's guide.\n\nSee Also:\n\n*Virginia Whitewater*, Roger Corbett (2000 ed.), p. 407.\n\n*Exploring Virginia's Waterways*, Ed Gertler (2022 ed.), p. 370.","averageGradient":"12","maxGradient":null,"length":"17","correlations":[{"reachID":"1959","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1200","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"20000"},"gaugeInfo":{"name":"CLINCH RIVER AT CLEVELAND, VA","gaugeSource":"USGS","gaugeSourceIdentifier":"03524000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"279","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"2.05","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"36.9448295","longitude":"-82.1548569"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/03524000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/03524000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"279","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["110495","asOPwuuLM8MDZUHqCQT6j","115759"],"geometry":{"type":"LineString","coordinates":[[-81.798284,37.040502],[-81.79832,37.040594],[-81.798631,37.040937],[-81.798839,37.041039],[-81.798839,37.041039],[-81.799468,37.041348],[-81.799768,37.041553],[-81.799886,37.041708],[-81.800315,37.042889],[-81.800551,37.043336],[-81.800551,37.043336],[-81.800572,37.043375],[-81.80089,37.04362],[-81.801245,37.043603],[-81.80155,37.043458],[-81.801842,37.043101],[-81.802012,37.04255],[-81.802075,37.041628],[-81.802146,37.041351],[-81.802275,37.041123],[-81.802807,37.040553],[-81.802986,37.040227],[-81.803039,37.040017],[-81.803065,37.03952],[-81.803005,37.038942],[-81.802504,37.037176],[-81.802538,37.03693],[-81.802784,37.036594],[-81.80298,37.036448],[-81.803275,37.036366],[-81.803995,37.036369],[-81.804391,37.036437],[-81.804623,37.036544],[