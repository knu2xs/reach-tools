[{"result":{"data":{"json":{"id":"1790","stub":{"id":"1790","section":"1. Trout Hatchery to Bridge above Bald River","altname":"","river":"Tellico","difficulty":"IItoIII","states":["USA-TNN"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"1.12","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"109321","location":{"latitude":"35.2874984741211","longitude":"-84.0954971313477"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"114563","location":{"latitude":"35.3222007751465","longitude":"-84.1658020019531"},"name":"Take Out","distance":"8","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"101250067","title":null,"post_date":"2013-04-05 04:00:00+00","detail":"Ran the last 4 miles of this section of river on 4.2.2013 at 2.1', from the foot bridge over the Tellico upstream of North River down to the bridge above Bald River (the usual put-in for the Tellico Ledges run). Great class 2+ read and run boogie water at that level with no hazards. Ran this entire 7 mile section of river again on 4.3.2013 at 1.9', started at the Trout Hatchery and that water level was definitely too low, especially for the first 1.5 miles down to the community of Green Cove. The gauge is about 18 miles downstream from the Trout Hatchery so look for at least 2.2' for a minimum on the Upper Tellico. There were two river-wide strainers requiring portage, the first about 3/4 mi. downstream of the Trout Hatchery and the second was at the rapid immediately upstream of Green Cove, visible from the motel. Although this is a class 2+/3 run, depending on water level, there is one 1/4 mile section of river that warrants class 4 rating, especially at levels above 3'. That section is immediately upstream of the foot bridge that crosses the Tellico, and is visible from the road. I ran this section of Upper Tellico on river left most of the way down, over 4 distinct rapids, the first three being ledges about 5' high, each separated by about 50 yards or less in distance, and the final big drop being 10'+. For the first three drops, there were alternate routes on the river right side that were less vertical, but for the final drop, there was only one route, starting from river left and riding the main chute of the big drop to river right. Any paddlers who are not comfortable on the main Tellico Ledges section should scout and portage along the road.","user":{"name":"Matt Wells"}}],"photos":[{"id":"9513","ext":"jpeg","post_id":"6796","description":"","caption":"Back flippin' da  Baby","poi_name":"Baby Falls","subject":"","author":"Ken Strickland","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/9513","large":"https://api.americanwhitewater.org/image/images/big/9513"}},{"id":"18007","ext":"jpeg","post_id":"2321","description":"The sun had set below the canyon rim, the rain was falling, and all that stood between my bicycle at the take-out and where I sat was 208 vertical feet of fun.  Need I say more.","caption":"Friday afternoon fun","poi_name":"Baby Falls","subject":"John E Sunshine","author":"Jes Patch","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/18007","large":"https://api.americanwhitewater.org/image/images/big/18007"}},{"id":"7703","ext":"jpeg","post_id":"3238","description":"","caption":"Too much fun!","poi_name":"Jared's Knee","subject":"Terry Newlon","author":"Paul Taylor","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/7703","large":"https://api.americanwhitewater.org/image/images/big/7703"}},{"id":"8769","ext":"jpeg","post_id":"5910","description":"A beautiful Septmber day on the Tellico!","caption":"Bridge Rapid","poi_name":"Bridge Rapid","subject":"unknown hand paddler","author":"James Locke","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8769","large":"https://api.americanwhitewater.org/image/images/big/8769"}},{"id":"6961","ext":"mov","post_id":"7066","description":"The Jet-Boil superstar boofing the Baby. ","caption":"Spanking Baby Boone","poi_name":"Baby Falls","subject":"Chris Boone","author":"Will White","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6961","large":"https://api.americanwhitewater.org/image/images/big/6961"}},{"id":"16860","ext":"jpeg","post_id":"8455","description":"","caption":"Johnathan Wurl hucking the Baby","poi_name":"Baby Falls","subject":"Johnathan Wurl","author":"Kathleen Burress","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/16860","large":"https://api.americanwhitewater.org/image/images/big/16860"}},{"id":"16855","ext":"tiff","post_id":"8455","description":"","caption":"10 yr. old Lauren Burress on Tellico River ","poi_name":"Baby Falls","subject":"Lauren Burress","author":"Kathleen Burress","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/16855","large":"https://api.americanwhitewater.org/image/images/big/16855"}},{"id":"16859","ext":"jpeg","post_id":"8455","description":"","caption":"Jamie on Tellico","poi_name":"Tellico ledges","subject":"Jamie ?","author":"Kathleen Burress","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/16859","large":"https://api.americanwhitewater.org/image/images/big/16859"}},{"id":"16861","ext":"jpeg","post_id":"8455","description":"","caption":"Johnathan Wurl hucking the Baby","poi_name":"Baby Falls","subject":"Johnathan Wurl","autho