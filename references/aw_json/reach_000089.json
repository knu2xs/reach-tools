[{"result":{"data":{"json":{"id":"89","stub":{"id":"89","section":" 2) Boxley to Ponca (6.1 miles)","altname":"","river":"Buffalo","difficulty":"II","states":["USA-ARK"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"107","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Park on either side of the highway, on the North of the Bridge. Make sure to leave room for vehicles to pass down Cave Mountain Road to the Southwest. Parking on the shoulder of Cave mountain is cleaner on the vehicles, but launching a boat is easier on the Northeast side. If you're launching a raft you pretty well have to be on the Northeast side.","id":"111704","location":{"latitude":"35.960999","longitude":"-93.404404"},"name":"Put In - Boxley Bridge","distance":"0","photoID":"oJL7hND1coLEZq25G7B7v","difficulty":"N/A","approximate":false},{"type":"other","description":"The Class V Beech Creek enters the Buffalo here, roughly half a mile downstream from the Boxley Bridge.","id":"6BZau1fFrKNu9uMXDVoyH","location":{"latitude":"35.966557","longitude":"-93.403842"},"name":"Beech Creek","distance":"0.44","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":"The first of 2 notable rapids: At 1.35 miles the river forks around an island into a clearer right channel, and a willow and wood choked left channel. Take the right channel. Go another .10 miles and you'll see a large boulder river right, easily go around it to the left, and you'll notice a large \"Cave\" river right that most of the water goes into. Get into the flow and ride it down under the overhanging rock (Catch the eddy in the Cave for bonus point, then peel back out into the flow) then back to the left again as you exit the cave and miss all the rock piles at the bottom of the turn. Start turning back right again, ride the flow into a series of small fun holes as the left fork of the river comes back together with the right. With a slice boat, practice stern squirts on the well defined eddy lines where the 2 flows come together.","id":"XUhtQqPD5jgXtunaJT6Cl","location":{"latitude":"35.978412","longitude":"-93.396998"},"name":"Cave Rapid","distance":"1.54","difficulty":"II","approximate":false,"photoID":"DNL9SjUEu3VyB4hmuHVSX"},{"type":"rapid","description":"Second Rapid of Note: Just a nice series of riverwide (or near riverwide holes) followed by a wave train. All are surfable, and all will flip you if hit them sideways at medium water and up. Good gravel bar river left to pick up stuff. 1st hole is strong top river left, 2nd hole is the biggest, but as of Spring 2025 has a 'wedge' shape to it, so it's very hard to surf and nearly impossible to get kept in. After that a series of small green waves, almost all of which are surfable. Great practice and play spot, and easy drag up river left. Eddy service to the middle 'wedge' hole on river right, along the bank.","id":"q4JVybj2xqrkqP1J6Gnlt","location":{"latitude":"35.997234","longitude":"-93.386484"},"name":"The Ledges","distance":"3.14","difficulty":"II+","approximate":false,"photoID":"NVe3WHDrto6Lwdd5JJYTu"},{"type":"takeout","description":"Low Water Bridge at Ponca. If water is high enough to be running Boxley, there's a good chance the LWB will be covered. Make sure to get well to river left BEFORE you get to the bridge. On river left the bridge is more of a 'causeway' with no space to allow current to pass underneath it.   \n  \n  \nDO NOT UNDER ANY CIRCUMSTANCE GO RIGHT-MIDDLE as that's where the channel goes, and the bridge has a hole there to let the river thru at low water. It has been known to suck boaters underneath in this spot if they get too close. Don't be one of these boaters.","id":"116978","location":{"latitude":"36.021301","longitude":"-93.354599"},"name":"Take Out","distance":"6.1","photoID":"vrb9nFdsQ9SUQO3V966Xn","difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"884661","ext":"jpeg","post_id":"887374","description":"","caption":"Boxley Valley","poi_name":"","subject":"Laramy Ridley","author":"Laramy Ridley ","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/884661","large":"https://api.americanwhitewater.org/image/images/big/884661"}},{"id":"884662","ext":"jpeg","post_id":"887375","description":"","caption":"Boxley Valley Waterfall","poi_name":"","subject":"Laramy Ridley, Jimbo Martin","author":"Laramy Ridley ","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/884662","large":"https://api.americanwhitewater.org/image/images/big/884662"}},{"id":"8EIGWpPxGXkwTcTxlUEFj","ext":"jpg","post_id":"8EIGWpPxGXkwTcTxlUEFj","description":"We ran Boxley to Ponca on 12/14/2022. It paddles well and was @ 0 air space at the low water bridge. Lots of wave trains, holes and surf spots.","caption":"Gotta love a wild river!","poi_name":null,"subject":"Gotta love a wild river!","author":"SoloBoater13","poi_id":null,"photo_date":"2022-12-14T18:45:02.000Z","updated_at":"2022-12-15T00:47:25.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8EIGWpPxGXkwTcTxlUEFj","large":"https://api.americanwhitewater.org/image/images/big/8EIGWpPxGXkwTcTxlUEFj"}},{"id":"NVe3WHDrto6Lwdd5JJYTu","ext":"jpg","post_id":"AWbNuI1u2W44sxvs2rkfe","description":"","caption":"The Ledges","poi_name":null,"subject":"","author":"David Swanson","poi_id":null,"photo_date":"2025-05-19T23:20:46.000Z","updated_at":"2025-05-19T23:20:46.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/NVe3WHDrto6Lwdd5JJYTu","large":"https://api.americanwhitewater.org/image/images/big/NVe3WHDrto6Lwdd5JJYTu"}},{"id":"vrb9nFdsQ9SUQO3V966Xn","ext":"jpg","post_id":"AWbNuI1u2W44sxvs2rkfe","description":"","caption":"Ponca LWB","poi_name":null,"subject":"","author":"David Swanson","poi_id":null,"photo_date":"2025-05-19T23:20:46.000Z","updated_at":"2025-05-19T23:20:46.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/vrb9nFdsQ9SUQO3V966Xn","large":"https://api.americanwhitewater.org/image/images/big/vrb9nFdsQ9SUQO3V966Xn"}},{"id":"oJL7hND1coLEZq25G7B7v","ext":"jpg","post_id":"AWbNuI1u2W44sxvs2rkfe","description":"","caption":"Boxley Bridge","poi_name":null,"subject":"","author":"David Swanson","poi_id":null,"photo_date":"2025-05-19T23:20:46.000Z","updated_at":"2025-05-19T23:20:46.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/oJL7hND1coLEZq25G7B7v","large":"https://api.americanwhitewater.org/image/images/big/oJL7hND1coLEZq25G7B7v"}},{"id":"DNL9SjUEu3VyB4hmuHVSX","ext":"jpg","post_id":"AWbNuI1u2W44sxvs2rkfe","description":"","caption":"Cave Rapid","poi_name":null,"subject":"","author":"David Swanson","poi_id":null,"photo_date":"2025-05-19T23:20:46.000Z","updated_at":"2025-05-19T23:20:46.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/DNL9SjUEu3VyB4hmuHVSX","large":"https://api.americanwhitewater.org/image/images/big/DNL9SjUEu3VyB4hmuHVSX"}}],"detail":{"id":"89","permitUrl":null,"permitInfo":null,"description":"Information may be found at the National Park Service website for [Buffalo National River](http://www.nps.gov/buff/)\n\nShort Fun Class II/II+ Run. Only comes up after a large rain and only will remain runnable for a day or two. Top 1/3rd of the Run is willows, a couple of solid II+ rapids in the middle, followed by some wave trains at higher waters then a run out to the Ponca Low Water Bridge. Super short easy shuttle straight down the highway, big access points at put-in and take-out, what's not to love.\n\nAt low water (200cfs to 350cfs) it's a great run step up level if you feel like Ponca to Kyle's landing isn't exciting enough. Things will happen faster here than the Ponca run, and you need to be on your toes. This is not the Buffalo you're probably used too.\n\nAt Medium Runnable (350cfs to 1500cfs) hazards will come at you quite fast, and you need to have some whitewater skills and whitewater specific craft. This includes helmets, PFDs that are worn, and flotation in canoes. The waves are big enough at this level open boats \\*will\\* take on water and get swamped if they don't have flotation and bailing &amp; pump setups.   \n  \nWith High water (1500+ CFS) the river run thru Boxley becomes a bullet train.. dodge the trees and ride the waves, most of the holes start to wash out and are replaced with big tall haystacks. You'll also be done in under an hour, so you can lap it over and over all afternoon while the big water is up. This is not a level for anyone except skilled whitewater boaters with proper craft.   \n  \nIf things go totally sideways on your run, get out river left and walk thru the fields or the many access roads to the nearby highway 21 and flag someone down to get help or a ride. Private property does exist alongside National Park Land thru this area which should be avoided if at all possible, but in a true emergency getting off the river thru here is quite easy.","averageGradient":"0","maxGradient":"0","length":"6.1","correlations":[{"reachID":"89","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":"At 7k CFS Water starts going over the highway","lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"200","beginMediumRunnable":"350","beginHighRunnable":"1500","endHighRunnable":"6500"},"gaugeInfo":{"name":"Buffalo River near Boxley, AR","gaugeSource":"USGS","gaugeSourceIdentifier":"07055646","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"107","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"2.56","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"35.93888889","longitude":"-93.405"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/07055646","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/07055646/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"107","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["111704","6BZau1fFrKNu9uMXDVoyH","XUhtQqPD5jgXtunaJT6Cl","q4JVybj2xqrkqP1J6Gnlt","116978"],"geometry":{"type":"LineString","coordinates":[[-93.404203,35.960785],[-93.404161,35.960825],[-93.404099,35.960877],[-93.404068,35.960902],[-93.404038,35.960929],[-93.403979,35.960982],[-93.40395,35.961009],[-93.40392,35.961036],[-93.403885,35.961058],[-93.403851,35.961081],[-93.403819,35.961106],[-93.403788,35.961132],[-93.403757,35.961157],[-93.403695,35.961209],[-93.403665,35.961235],[-93.403575,35.961315],[-93.403488,35.961395],[-93.403401,35.961476],[-93.403371,35.961502],[-93.40334,35.961527],[-93.403312,35.961556],[-93.403272,35.961618],[-93.403259,35.961652],[-93.403205,35.961747],[-93.403187,35.96178],[-93.403167,35.961812],[-93.403122,35.961911],[-93.403078,35.96201],[-93.403048,35.962077],[-93.403035,35.962111],[-93.403013,35.96218],[-93.402997,35.96225],[-93.402992,35.962285],[-93.402988,35.96232],[-93.402998,35.962355],[-93.403071,35.962523],[-93.403103,35.96259],[-93.403119,35.962623],[-93.403168,35.962723],[-93.403216,35.962822],[-93.403264,35.962922],[-93.403313,35.963022],[-93.403361,35.963122],[-93.403393,35.963188],[-93.403409,35.963222],[-93.403441,35.963288],[-93.403458,35.963322],[-93.40349,35.963388],[-93.403506,35.963421],[-93.403522,35.963455],[-93.403553,35.963522],[-93.4036,35.963622],[-93.403612,35.963656],[-93.403632,35.963725],[-93.40365,35.963795],[-93.403666,35.963865],[-93.403684,35.963934],[-93