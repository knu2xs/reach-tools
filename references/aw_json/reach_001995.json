[{"result":{"data":{"json":{"id":"1995","stub":{"id":"1995","section":"Route 619 to Dumfries (Route 627)","altname":"","river":"Quantico Creek, S. Branch","difficulty":"ItoIII","states":["USA-VRG"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"3.03","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Put In - VA Rt 619","id":"108996","location":{"latitude":"38.58717459","longitude":"-77.42854515"},"name":"Put In - VA Rt 619","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"access","description":"River Access - Parking Lot A, Prince William Forest Park","id":"dssUpAsxjew3wbicF97ky","location":{"latitude":"38.56821635","longitude":"-77.36529392"},"name":"River Access - Parking Lot A, Prince William Forest Park","distance":"5.68","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"Take Out - Dumfries (Batestown Rd., VA Route 627)","id":"114231","location":{"latitude":"38.56767483","longitude":"-77.33463961"},"name":"Take Out - Dumfries (VA Route 627)","distance":"8.3","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"1995","permitUrl":null,"permitInfo":null,"description":"Stephen J. Ettinger sez:\n\nIf you just want to run the good whitewater, put in at parking area A in Prince William Park, for a 2.6 mile run down to Dumfries. After 1.5 miles of fast class I, with quite a few strainers, comes a 4 foot ledge (class III-), best run left to right. Then comes a quarter mile of class I-II and the confluence with the (smaller) main stem (called the \"North Branch\" in Corbett). Shortly thereafter starts the exciting descent of the fall line, starting with the toughest rapid -- a complex class IV- chute, dropping about 8 feet, which can be portaged on the right. Below that are a pair of class III- rapids, and then some easier ledges.\n\nEd Evangelidi testifies:\n\nPark Police may or may not take kindly to you being on the creek through the park. Expect many strainers and a portage around a dam. This creek has been buttressed with wire-encased stone in part to keep the banks from eroding. Unfortunately this spoils the view.","averageGradient":null,"maxGradient":null,"length":"8.3","correlations":[{"reachID":"1995","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"3.1","beginMediumRunnable":"3.5","beginHighRunnable":"4.25","endHighRunnable":"5"},"gaugeInfo":{"name":"S F QUANTICO CREEK NEAR INDEPENDENT HILL, VA","gaugeSource":"USGS","gaugeSourceIdentifier":"01658500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"3","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.03","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"38.5873427","longitude":"-77.4285958"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/01658500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/01658500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"3.03","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null}}],"pointOfInterestIDs":["108996","dssUpAsxjew3wbicF97ky","114231"],"geometry":{"type":"LineString","coordinates":[[-77.42854515,38.58717459],[-77.42847562,38.58717232],[-77.42833614,38.58718909],[-77.42818594,38.58727296],[-77.42808938,38.58737359],[-77.42778897,38.5875497],[-77.42755247,38.58761419],[-77.42754907,38.58760658],