-IV)\n\n[Stony Gorge](http://www.americanwhitewater.org/rivers/id/2847/) (IV)\n\n[Roaring Fork](http://www.americanwhitewater.org/rivers/id/2829/) (IV)\n\n[Shade Creek](http://www.americanwhitewater.org/rivers/id/1659/) (III-IV)\n\n[Paint Creek](http://www.americanwhitewater.org/rivers/id/2844/) (V)\n\n[Dark Shade Creek](http://www.americanwhitewater.org/rivers/id/1604/) (IV-V)\n\n[Clear Shade Creek](http://www.americanwhitewater.org/rivers/id/1593/) (III)\n\n[Conemaugh River](http://www.americanwhitewater.org/rivers/id/1596/) (I-II)","averageGradient":null,"maxGradient":null,"length":"5.1","correlations":[{"reachID":"1654","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":"During Quemahoning Reservoir releases, subtract the release amount from Ferndale total.","highRunnableRangeComment":"Upper Level Limits are uncertain. Please help your fellow boaters with comments.","aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"4.5","beginMediumRunnable":"5","beginHighRunnable":"7.5","endHighRunnable":"10"},"gaugeInfo":{"name":"Stonycreek River at Ferndale, PA","gaugeSource":"USGS","gaugeSourceIdentifier":"03040000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"407","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.14","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"40.28563049","longitude":"-78.9205806"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/03040000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/03040000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"3.14","dateTime":"2026-05-12T02:15:00.000Z","qual