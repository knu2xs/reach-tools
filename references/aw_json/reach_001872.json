[{"result":{"data":{"json":{"id":"1872","stub":{"id":"1872","section":"01. Fuller Bottom to San Rafael Campground (Little Grand Canyon)","altname":"","river":"San Rafael","difficulty":"ItoII","states":["USA-UTA"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"0","dateTime":"2026-05-12T03:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Put-in on river left at the trailhead.","id":"108333","location":{"latitude":"39.118543","longitude":"-110.855385"},"name":"Fullers Bottom Trailhead Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"Take-out at the bridge where San Rafael Bridge Campground, also known as Swinging Bridge Campground is located. This is a good place to camp the night before a trip.","id":"113572","location":{"latitude":"39.080866","longitude":"-110.666973"},"name":"San Rafael Bridge Recreation Site Take Out","distance":"17.41","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"EBqxEotZZdOzayEoDSdCa","title":null,"post_date":"2024-06-15 22:33:31+00","detail":"There is a river-wide tree at mile 4.1 from FB put in. It’s after a blind right hand bend, just before the Sorrel mine beach. At 900 cfs, boaters were reportedly floating over it. At 650 cfs today, it was a mandatory portage and several boats hit it with some paddlers flushed under. Emery County SO/SAR is aware and will work on removal.","user":{"name":"Todd Taylor"}},{"id":"OuhA4dH2IRksqliWvduhr","title":"Almost total river wide Strainer","post_date":"2023-06-18 05:08:30+00","detail":"In the first hour of the float there is a strainer. It is on a blind left hand bend in the river. The very large cottonwood tree fell over last eve. There is a two foot window on the left(the tree came from the right bank and was undercut with the high water). Today a group lost a canoe and never found it once it went under the tree. There several people who almost drowned in several groups getting caught in the tree going too wide into the corner. This was the only issue of concern on the river today. This strainer will be completely river wide as the level falls. There is no barbed wire anywhere across the river","user":{"name":"Daniel Cottam"}}],"photos":[{"id":"nNHdp9hp68tl4BxEjmvTy","ext":"jpg","post_id":"HNa3mBGFqYGcFLjFwhZl1","description":"","caption":"","poi_name":null,"subject":"","author":"Robin Thomas","poi_id":null,"photo_date":"2023-04-19T02:52:49.000Z","updated_at":"2023-04-19T02:52:49.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/nNHdp9hp68tl4BxEjmvTy","large":"https://api.americanwhitewater.org/image/images/big/nNHdp9hp68tl4BxEjmvTy"}},{"id":"TKzGjHGWIZ3MpjOG0nh7L","ext":"jpg","post_id":"HNa3mBGFqYGcFLjFwhZl1","description":"","caption":"","poi_name":null,"subject":"","author":"Robin Thomas","poi_id":null,"photo_date":"2023-04-19T02:52:49.000Z","updated_at":"2023-04-19T02:52:49.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/TKzGjHGWIZ3MpjOG0nh7L","large":"https://api.americanwhitewater.org/image/images/big/TKzGjHGWIZ3MpjOG0nh7L"}},{"id":"891542","ext":"jpg","post_id":"895433","description":null,"caption":"Entering Little Grand Canyon","poi_name":null,"subject":null,"author":"Sam Morrison","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891542","large":"https://api.americanwhitewater.org/image/images/big/891542"}},{"id":"891543","ext":"jpg","post_id":"895434","description":null,"caption":" on San Rafael @01. Fuller Bottom to San Rafael Campground (Little Grand Canyon","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891543","large":"https://api.americanwhitewater.org/image/images/big/891543"}},{"id":"891547","ext":"jpg","pos