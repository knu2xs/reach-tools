[{"result":{"data":{"json":{"id":"697","stub":{"id":"697","section":"Lucy Stone Park in Warren to Route 67","altname":"","river":"Quaboag","difficulty":"IItoIII","states":["USA-MSS"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"3.35","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"111254","location":{"latitude":"42.2173004150391","longitude":"-72.1930999755859"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":null,"id":"uRFYmgVs4pnt6ueEnPcAa","location":{"latitude":"42.215465","longitude":"-72.220382"},"name":"Mouse Hole","distance":"1.8","difficulty":"III","approximate":false,"photoID":null},{"type":"put-in","description":"Putting in at West Warren below the dam for the mill cuts out the portage. There is a seal launch next to a small building off of South St. The lot next to the put in is marked as a tow away lot so be mindful and park back at the lot where South St and Main St intersect.","id":"jfsxHEby42sHAvJTD7j0M","location":{"latitude":"42.210574","longitude":"-72.234996"},"name":"Alternate Put In","distance":"2.73","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":"A crumbling dam that creates a river wide horizion line. It's boat scoutable and run slightly left of center. Look for where the flake from the dam extends slightly away from the hole.","id":"1Fit4OUbbc6rB6ScQvjQ3","location":{"latitude":"42.209896","longitude":"-72.24353"},"name":"Broken Dam","distance":"3.28","difficulty":"III","approximate":false,"photoID":"GBdYLHZ38DHaegej5ceYD"},{"type":"rapid","description":null,"id":"t0CzjXqIFPFDFoFoFtx97","location":{"latitude":"42.207922","longitude":"-72.250808"},"name":"Angel's Field","distance":"3.72","difficulty":"III+","approximate":false,"photoID":null},{"type":"rapid","description":"Last larger rapid on the river. Starts out by tightening up to a gorge. The entrance has a nice series of surf waves. The eddy river left above the boulder that forms the constriction is a good spot to catch the top wave. The boulder also forms a great eddy that provides service to all three waves. Below the surf spot is some boogie water then a river wide ledge. Easiest line is far right down the slope or boofing into the eddy. Center right has a boof over a sticky hole. There are other lines through as well.","id":"ldZ1wuDxngkhBbm8Tq09S","location":{"latitude":"42.207267","longitude":"-72.25829"},"name":"Devil's Gorge","distance":"4.22","difficulty":"III","approximate":false,"photoID":"afOYxVZd9jjiIB3pxBsPh"},{"type":"takeout","description":"Nice circular pull off along the road. Easy to see your cars from the river with a nice eddy that makes it easy to get out. No cell service","id":"116524","location":{"latitude":"42.19329","longitude":"-72.263944"},"name":"Take Out","distance":"5.28","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"i1RjfpcT5PRf8C8Z2p5DQ","title":"Strainers","post_date":"2024-01-13 02:40:18+00","detail":"There is a new strainer after Angel Field where the river splits. The right channel has a river wide tree across it - many branches. Some pruning would make it passable.\n\nAlso be careful of the strainer in second half of the gorge on river right. It is hard to see at this level 5.56.","user":{"name":"Mary Durr"}},{"id":"LaEJNLzimuMAnemP5ZDlF","title":"Stainers","post_date":"2023-01-02 14:42:24+00","detail":"There are 2 large trees down after the Gorge and after after the island split. One has many branches sticky out and is about 80% across the river starting from river right. You can get by on the left (right of island). Just get over soon enough to avoid getting caught.","user":{"name":"Mary Durr"}},{"id":"101249459","title":null,"post_date":"2012-06-04 04:00:00+00","detail":"I went to the Quabog yesterday with 2 friends. Level was 4.06 and dropped to 4.04 by the time we got to the take out. Watch out for strainers! The level was pretty low, so getting around the trees was not hard, and spotting them was not hard, but if the current were any pushier, I think they will become less avoidable and the potential for getting swept into them definitely increases. 4.06 is pretty low, and we got beached on rocks quite often. After Devils Gorge, there are a LOT more trees. We walked around one of them. It was a fun run, but I won't run it again at a higher level until the trees are gone.","user":{"name":"Hana Skirkey"}},{"id":"101084390","title":null,"post_date":"2009-09-18 04:00:00+00","detail":null,"user":null}],"photos":[{"id":"41611","ext":"jpeg","post_id":"5249","description":"Running the river left side of the old dam after the Factory/Unrunnable damn","caption":"Old Broken Dam on Quaboag","poi_name":"Broken Dam after Portage","subject":"Gregory Wallace","author":"David Hubelbank","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/41611","large":"https://api.americanwhitewater.org/image/images/big/41611"}},{"id":"882968","ext":"jpeg","post_id":"885650","description":"4/7/13 4.5ft","caption":"Dave at the mouse hole","poi_name":null,"subject":null,"author":"Andrew","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/882968","large":"https://api.americanwhitewater.org/image/images/big/882968"}},{"id":"880923","ext":"jpeg","post_id":"882168","description":"","caption":"\"Sweeper\" on Mouse Hole Drop","poi_name":"Mouse Hole","subject":"\"Sweeper\" on Mouse Hole Drop","author":"Hana Skirkey","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880923","large":"https://api.americanwhitewater.org/image/images/big/880923"}},{"id":"879132","ext":"jpeg","post_id":"879565","description":"Swimming the Devil's Gourge.  Went sunny side up about a quarter mile from the gourge, couldn't eddy out.","caption":"Surfs Up!","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/879132","large":"https://api.americanwhitewater.org/image/images/big/879132"}},{"id":"40019","ext":"jpeg","post_id":"8052","description":"","caption":"Quabog Drop","poi_name":"Quabog Drop","subject":"","author":"Riverken","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/40019","large":"https://api.americanwhitewater.org/image/images/big/40019"}},{"id":"41609","ext":"jpeg","post_id":"5250","description":"","caption":"Mousehole Drop on the Quaboag","poi_name":"Mouse Hole Drop","subject":"Laura Corman","author":"David Hubelbank","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/41609","large":"https://api.americanwhitewater.org/image/images/big/41609"}},{"id":"41610","ext":"jpeg","post_id":"5250","description":"","caption":"Mouse Hole Drop on Quaboag","poi_name":"Mouse Hole Drop","subject":"Laura Corman","author":"David Hubelbank","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/41610","large":"https://api.americanwhitewater.org/image/images/big/41610"}},{"id":"40933","ext":"jpeg","post_id":"9191","description":"","caption":"Quaboag Portage","poi_name":"Portage","subject":"Unrunnable?","author":"Andy Stuart","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/40933","large":"https://api.americanwhitewater.org/image/images/big/40933"}},{"id":"41899","ext":"jpeg","post_id":"9191","description":"","caption":"Randy Sneaks left","poi_name":"Quaboag Drop","subject":"Randy Noble","author":"Andy Stuart","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/41899","large":"https://api.americanwhitewater.org/image/images/big/41899"}},{"id":"40932","ext":"jpeg","post_id":"9191","description":"","caption":"Dropping In","poi_name":"Quabog Drop","subject":"Lauren","author":"Andy Stuart","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/40932","large":"https://api.americanwhitewater.org/image/images/big/40932"}},{"id":"40923","ext":"jpeg","post_id":"9191","description":"","caption":"Punching the Hole","poi_name":"Quabog Drop","subject":"Dustin","author":"Andy Stuart","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/40923","large":"https://api.americanwhitewater.org/image/images/big/40923"}},{"id":"41903","ext":"mpg","post_id":"9191","description":"","caption":"Quaboag Seal Launch","poi_name":"Put in","subject":"Dustin","author":"Andy Stuart","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/41903","large":"https://api.americanwhitewater.org/image/images/big/41903"}},{"id":"41900","ext":"jpeg","post_id":"9191","description":"Nice boof.","caption":"The Gorilla Line","poi_name":"Quaboag","subject":"","author":"Andy Stuart","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/41900","large":"https://api.americanwhitewater.org/image/images/big/41900"}},{"id":"afOYxVZd9jjiIB3pxBsPh","ext":"jpg","post_id":"zuFHlBsjGcjRbQFPsqeXl","description":"","caption":"","poi_name":null,"subject":"","author":"Bill Durr","poi_id":"ldZ1wuDxngkhBbm8Tq09S","photo_date":"2024-01-01T02:06:40.000Z","updated_at":"2024-01-02T02:06:40.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/afOYxVZd9jjiIB3pxBsPh","large":"https://api.americanwhitewater.org/image/images/big/afOYxVZd9jjiIB3pxBsPh"}},{"id":"882970","ext":"jpeg","post_id":"885654","description":"4/7/13 4.5ft","caption":"Brett in the Gorge","poi_name":null,"subject":null,"author":"Andrew","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/882970","large":"https://api.americanwhitewater.org/image/images/big/882970"}},{"id":"882969","ext":"jpeg","post_id":"885653","description":"4/7/13 4.5ft","caption":"Jamie at Broken Dam","poi_name":"","subject":"","author":"Andrew","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/882969","large":"https://api.americanwhitewater.org/image/images/big/882969"}},{"id":"GBdYLHZ38DHaegej5ceYD","ext":"jpg","post_id":"zuFHlBsjGcjRbQFPsqeXl","description":"","caption":"","poi_name":null,"subject":"","author":"Bill Durr","poi_id":"1Fit4OUbbc6rB6ScQvjQ3","photo_date":"2024-01-01T02:06:40.000Z","updated_at":"2024-01-02T02:06:40.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/GBdYLHZ38DHaegej5ceYD","large":"https://api.americanwhitewater.org/image/images/big/GBdYLHZ38DHaegej5ceYD"}}],"detail":{"id":"697","permitUrl":"","permitInfo":"","description":"The Quaboag starts at the Lucy Stone Park as a class II river for almost half of the run then turns into a class III pool drop river with one carry around a dam. This is often referred to as the \"Class IV Portage\", because it involves descending a steep bank lined with riprap to access the water below the dam.\n\nPutting on at Lucy Stone Park, the first significant drop you come to is Mouse Hole, a short but abrupt III. It is located where Main St intersects with Cross Rd in Warren, and it is recommended to scout it for wood while you are driving by on your shuttle.\n\nThe next notable drop is after the portage, upstream of the Gilbert Rd bridge in Warren. This is Broken Dam, which presents itself as a somewhat intimidating river-wide horizon line. Paddling up to the lip, though, you find that it's boat-scoutable and not so bad. Most run just left of center.\n\nAs you pass the wastewater treatment plant and the famous outhouse on river right, the next railroad bridge signals the start of Angel's Field, the rowdiest rapid on the river. It's a III+ with a hole at the bottom, into which the boater in the cover photo above is dropping into.\n\nFurther downstream you will enter Devil's Gorge, which despite its name is only a III. It does contain a 4-foot-tall river-wide ledge, which can be easily run on extreme river right if you just want to get past it, or you can be more adventurous and experiment with other lines.\n\nCaution:  Be on a constant lookout for downed trees.  There are a lot of beavers in the area and they're all on steroids.  They've been knocking down huge trees that have spanned the entire river. [This video](https://www.youtube.com/watch?v=7IuN7xBWmKo), recorded 3/22/2014, is one scary example.\n\nFor a complete description refer to the guidebook \"Classic Northeastern Whitewater Guide\" by Bruce Lessels.","averageGradient":"0","maxGradient":"0","length":"5.3","correlations":[{"reachID":"697","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"4","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"6.5"},"gaugeInfo":{"name":"QUABOAG RIVER AT WEST BRIMFIELD, MA","gaugeSource":"USGS","gaugeSourceIdentifier":"01176000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"175","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.35","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"42.18231566","longitude":"-72.263691"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/01176000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/01176000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"3.35","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null}}],"pointOfInterestIDs":["111254","uRFYmgVs4pnt6ueEnPcAa","jfsxHEby42sHAvJTD7j0M","1Fit4OUbbc6rB6ScQvjQ3","t0CzjXqIFPFDFoFoFtx97","ldZ1wuDxngkhBbm8Tq09S","116524"],"geometry":{"type":"LineString","coordinates":[[-72.1930927183461,42.21741010278012],[-72.19345493171494,42.21743406780348],[-72.19355179838148,42.21743746780345],[-72.19364873171463,42.2174346011368],[-72.1937751983811,42.217326201136984],[-72.19381273171439,42.217303401136974],[-72.1938717317143,42.217246601137106],[-72.19389773171429,42.21721620113715],[-72.19393113171424,42.2171904011372],[-72.1940347983807,42.21712086780394],[-72.19406579838068,42.21698006780417],[-72.19407753171402,42.21694526780425],[-72.19417459838053,42.21674380113785],[-72.19423253171374,42.21660766780474],[-72.1943105983803,42.21636480113847],[-72.19437579838018,42.21619266780539],[-72.19445859838004,42.215878067805875],[-72.19446673171336,42.21577106780603],[-72.19446433171339,42.21559306780631],[-72.19441639838016,42.21534666780673],[-72.19439213171353,42.215278201140165],[-72.19437579838018,42.21520800114024],[-72.19438053171353,42.2151726011403],[-72.19437339838021,42.215102067807095],[-72.19437473171354,42.21506660114045],[-72.1943785983802,42.21503140114055],[-72.19439373171349,42.21496100114064],[-72.19450493171331,42.21472566780767],[-72.19461439837983,42.21456726780792],[-72.19500633171253,42.21395526780884],[-72.19507053171247,42.213859467809016],[-72.19511999837903,42.21379846780911],[-72.19523073171217,42.213640067809365],[-72.19541113