cout. There are more class III rapids as you continue downstream.\n\nAt the end of the run you can take out above Nehalem Falls or run it to finish out the day. It's not a true waterfall but heavy class IV hydraulics form as the flows increase.","averageGradient":null,"maxGradient":null,"length":"7.1","correlations":[{"reachID":"1535","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"2000","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"8000"},"gaugeInfo":{"name":"NEHALEM RIVER NEAR FOSS, OR","gaugeSource":"USGS","gaugeSourceIdentifier":"14301000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"487","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"2.93","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"45.7039986","longitude":"-123.755405"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/14301000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/14301000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"487","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["109713","100633","114966"],"geometry":{"type":"LineString","coordinates":[[-123.652913,45.749976],[-123.653,45.750019],[-123.653179,45.750098],[-123.653493,45.750312],[-123.653623,45.7504],[-123.653761,45.750377],[-123.653792,45.750345],[-123.653885,45.750322],[-123.654163,45.750239],[-123.654389,45.750179],[-123.654519,45.750152],[-123.654715,45.750128],[-123.654786,45.750119],[