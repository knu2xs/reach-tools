a Bridge","caption":"Four Doors","poi_name":"Four Dours","subject":"","author":"Dave Steindorf","poi_id":"100300","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/614747","large":"https://api.americanwhitewater.org/image/images/big/614747"}},{"id":"614808","ext":"jpeg","post_id":"614766","description":"Slot Drop on the Poe Reach","caption":"Upsteam from Bardees Bar","poi_name":"Slot","subject":"Roland McNutt","author":"Dave Steindorf","poi_id":"107308","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/614808","large":"https://api.americanwhitewater.org/image/images/big/614808"}},{"id":"614775","ext":"jpeg","post_id":"614766","description":"Toboggan Rapid at 700cfs","caption":"Toboggan","poi_name":"Toboggan","subject":"","author":"","poi_id":"100613","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/614775","large":"https://api.americanwhitewater.org/image/images/big/614775"}},{"id":"614786","ext":"jpeg","post_id":"614766","description":"Dave Steindorf in the Sticky Wicket","caption":"Sticky Wicket","poi_name":"Sticky Wicket","subject":"Dave Steindorf","author":"","poi_id":"100299","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/614786","large":"https://api.americanwhitewater.org/image/images/big/614786"}},{"id":"791696","ext":"jpeg","post_id":"791695","description":"","caption":"Spoil Pile rapid","poi_name":"Spoil Pile","subject":"Matt Donnelly","author":"Dave Steindorf","poi_id":"100611","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/791696","large":"https://api.americanwhitewater.org/image/images/big/791696"}},{"id":"791701","ext":"jpeg","post_id":"791695","description":"","caption":"Spoil Pile rapid","poi_name":"Spoil Pile","subject":"Bruce Hicks","author":"Dave Steindorf","poi_id":"100611","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/791701","large":"https://api.americanwhitewater.org/image/images/big/791701"}},{"id":"891999","ext":"jpg","post_id":"895900","description":null,"caption":"Owen Cross","poi_name":"Peace Out","subject":null,"author":"Dave Steindorf","poi_id":"107308","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891999","large":"https://api.americanwhitewater.org/image/images/big/891999"}},{"id":"892000","ext":"jpg","post_id":"895901","description":null,"caption":null,"poi_name":"Tinky Winky","subject":null,"author":"Dave Steindorf","poi_id":"100613","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/892000","large":"https://api.americanwhitewater.org/image/images/big/892000"}},{"id":"5RjIJ28wHkaEsND7y4yd0","ext":"jpg","post_id":"GU15mWN3zjVb3ihfDFeKP","description":"","caption":"Pow Powerhouse","poi_name":null,"subject":"","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":"116559","photo_date":"2017-11-13T22:43:07.000Z","updated_at":"2023-09-02T22:43:07.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5RjIJ28wHkaEsND7y4yd0","large":"https://api.americanwhitewater.org/image/images/big/5RjIJ28wHkaEsND7y4yd0"}},{"id":"wjSnhbYupN57xVyLhD1Pw","ext":"jpg","post_id":"GU15mWN3zjVb3ihfDFeKP","description":"","caption":"Pow Powerhouse Access","poi_name":null,"subject":"","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":"116559","photo_date":"2017-11-13T22:43:07.000Z","updated_at":"2023-09-02T22:43:07.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/wjSnhbYupN57xVyLhD1Pw","large":"https://api.americanwhitewater.org/image/images/big/wjSnhbYupN57xVyLhD1Pw"}},{"id":"5U7TqrXB6gYQImKTB9dMi","ext":"jpg","post_id":"GU15mWN3zjVb3ihfDFeKP","description":"","caption":"Pow Powerhouse Access","poi_name":null,"subject":"","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":"116559","photo_date":"2017-11-13T22:43:07.000Z","updated_at":"2023-09-02T22:43:07.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5U7TqrXB6gYQImKTB9dMi","large":"https://api.americanwhitewater.org/image/images/big/5U7TqrXB6gYQImKTB9dMi"}},{"id":"I4dAJJzpTmHdwy0eBLHL8","ext":"jpg","post_id":"zr0b3E1oVF1GL2aTHslwo","description":"","caption":"Looking Downstream at Poe Reach","poi_name":null,"subject":"","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":null,"photo_date":"2017-11-07T06:07:19.000Z","updated_at":"2023-09-03T06:07:19.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/I4dAJJzpTmHdwy0eBLHL8","large":"https://api.americanwhitewater.org/image/images/big/I4dAJJzpTmHdwy0eBLHL8"}},{"id":"888456","ext":"jpeg","post_id":"zr0b3E1oVF1GL2aTHslwo","description":"","caption":"Poe Dam","poi_name":"","subject":"","author":"Thomas O'Keefe","poi_id":"111291","photo_date":"2017-11-07T06:07:23.000Z","updated_at":"2023-09-03T06:07:24.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888456","large":"https://api.americanwhitewater.org/image/images/big/888456"}}],"detail":{"id":"198","permitUrl":"","permitInfo":"","description":"The Poe Run is the lowermost run on the North Fork Feather above the high water mark of Lake Oroville. This seven-mile-long reach comnprises two distinctly different reaches: Poe Canyon and Bardees Bar. The first four miles (the Poe Canyon) are continuous class IV/V and the second four miles (Bardees Bar) are class III/IV. Fortunately there is an access road at the mid-point at Bardees Bar where the character of the run changes. This enables padders to do the just the class V reach or the lower class III/IV reach, or both.\n\n**Put-in:** On Highway 70, look for a location called Sandy Beach. It is about a half-mile downstream of the Poe Dam and just downstream from a Caltrans station.\n\n**Bardees Bar access:** There are two ways to get to Bardees Bar. Take the turn out off Highway 70 where the power lines cross the highway for the quickest route. Take the dirt road to the right. This road is quite steep in places, so high clearance 4-wheel drive vehicle is recommended. Driving time is about 15 minutes. This road should not be used if there has been much rain. Regular autos should take the Big Bend Road to Bardees Bar Road. Figure about 40 minutes driving time on this route.\n\n**Take-out:** From Highway 70, take the Big Bend turn off. Follow Big Bend Road until you see Bardees Bar Road on the right. This gravel road will lead to the Poe Powerhouse in about 4.3 miles. At 1.3 miles, there is a hairpin turn in the road, here Bardees Bar Road leaves to the left to go to Bardees Bar. Stay right to go to the powerhouse. After you leave your shuttle vehicle at the Poe Powerhouse, you can stay on Bardees Bar Road all the way to the Bardees Bar put-in.\n\n**Poe Canyon Run**\n\nThe run starts out with a few easy warm-up rapids before the Highway 70 bridge. After the bridge things pick up quickly. After several class IV rapids a class V+ rapid that was dubbed Four Doors during the flow study. While this rapid is potentially runnable, no one during the flow study ran this rapid in its entirety. Most used the portage route on the left side, which requires some technical rock climbing. Immediately below the Four Doors is a short rapid with a sticky hole at the bottom. Named Sticky Wicket, this was the site of several extended surfs during the flow study. Next up is a long rapid named Toboggan. This rapid became substantially harder at flow levels above 500 cfs. A number of fun class IV rapids occur over the next mile. Patchin's Passion, the only named rapid in the classic Holbeck/Stanley guidebook, is an impressive 12-15 foot drop that is difficult to come out of right side up. There is one more long class IV+ rapid before you reach Bardees Bar.\n\n**Bardees Bar Run**\n\nBelow Bardees Bar, the river mellows considerably and flows through a delightful part of the North Fork Feather Canyon that is away from Highway 70. This section contains several class III+ rapids. The class IV rapid that begins immediately below the put-in can be a little junky at low flows. Several long class III + rapids follow with one IV- that is just above the bridge leading to the Poe Powerhouse. Bald eagles are regulars to this reach, so be sure to look up while padding this section of river. American Whitewater has been leading an effort to develop a hiking trail along the river right in this section, and PG&amp;E is required by their Poe Hydroelectric Project federal license to construct the trail.\n\n[Cresta](http://www.americanwhitewater.org/content/River/view/river-detail/197/) is the next run upstream.\n\n[Big Bend](http://www.americanwhitewater.org/content/River/view/river-detail/4682/) is the next run downstream. Big Bend is in the Oroville Lake bottoms and is only available when the reservoir is very low.\n\n**Other Information Sources:**\n\nA GUIDE TO THE BEST WHITEWATER IN THE STATE OF CALIFORNIA, HOLBEK &amp; STANLEY, 1988","averageGradient":"70","maxGradient":"120","length":"7.2","correlations":[{"reachID":"198","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"400","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"7000"},"gaugeInfo":{"name":"NORTH FORK FEATHER RIVER AT PULGA","gaugeSource":"CDEC","gaugeSourceIdentifier":"NFP","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"442","dateTime":"2026-05-11T23:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":null,"location":{"latitude":"39.794","longitude":"-121.451"},"externalSourceLinks":{"sourceLin