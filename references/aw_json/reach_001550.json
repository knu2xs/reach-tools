[{"result":{"data":{"json":{"id":"1550","stub":{"id":"1550","section":"1. Bruno Mt. Rd. Bridge to Detroit Reservoir","altname":"","river":"Santiam, N.","difficulty":"IIItoIV","states":["USA-ORE"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"599","dateTime":"2026-05-12T03:10:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"111776","location":{"latitude":"44.691391","longitude":"-121.98763"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"117048","location":{"latitude":"44.707875","longitude":"-122.109775"},"name":"Take Out","distance":"7.39","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"882495","ext":"jpeg","post_id":"885186","description":"Dave Eveland surfing the takeout wave- 3200 cfs","caption":"","poi_name":null,"subject":"","author":"Joel Metcalfe","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/882495","large":"https://api.americanwhitewater.org/image/images/big/882495"}},{"id":"891602","ext":"jpg","post_id":"895488","description":null,"caption":" on Santiam, N. @1. Bruno Mt. Rd. Bridge to Detroit Reservoir","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891602","large":"https://api.americanwhitewater.org/image/images/big/891602"}}],"detail":{"id":"1550","permitUrl":"","permitInfo":"","description":"The Bruno Mt. section of the North Santiam is a great run, as long as the skill level of your group matches up with the flow.  I would say the minimum enjoyable flow is around 1,400 cfs.  At this level, most of the run consists of fairly technical class III.  Between 1,800 and 2,500 cfs, this is a great III+ run, with good sized waves and LOTS of play.  As the river rises over 3,000 cfs, it becomes a non- stop big water run with some big holes and an abundance of catch on the fly surf waves.  It's still not very difficult at this level, but eddies are very scarce, so a swim could last a very long time.  This section never really washes out.  It just keeps getting bigger and faster.\n\nIn the Summer, it can be run by desperate locals down to 400 cfs or so.  At that flow it is more a training run and shorter sections should be bitten off so it doesn't take all day.  It's more II-III at that flow with lots of rocks, but also some clean lines and loads of small features to practice in.\n\n**Additional References** Full description in [Soggy Sneakers](http://www.americanwhitewater.org/library/bgnw/).","averageGradient":"67","maxGradient":null,"length":"7.4","correlations":[{"reachID":"1550","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1000","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"2500"},"gaugeInfo":{"name":"NO SANTIAM R BLW BOULDER CRK, NR DETROIT, OR","gaugeSource":"USGS","gaugeSourceIdentifier":"14178000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"599","dateTime":"2026-05-12T03:10:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.05","dateTime":"2026-05-12T03:10:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"44.7067885","longitude":"-122.1011859"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/14178000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/14178000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommend