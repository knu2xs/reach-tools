[{"result":{"data":{"json":{"id":"1533","stub":{"id":"1533","section":"2) Table Rock Fork to Glen Avon Bridge (3 Bears)","altname":"","river":"Molalla","difficulty":"IIItoIV","states":["USA-ORE"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"304","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"access","description":"There are a couple of spots upstream from the bridge where it's easier to get to the water than at the bridge.","id":"100342","location":{"latitude":"44.980202","longitude":"-122.482002"},"name":"Turner Bridge","distance":"-35","photoID":"0","difficulty":"N/A","approximate":false},{"type":"access","description":"Baby Bear is a single drop between a large block of basalt and the left bank.  At lower flows it has a sticky pocket hole on the right.  It's roadside and easy to scout on the ride up. At higher flows you can run it down the left side or sneak it by going to the right of the basalt block.","id":"100516","location":{"latitude":"45.014","longitude":"-122.484001"},"name":"Baby Bear","distance":"-32.1","photoID":"wpwITTIbkw5WFei2Ruh2j","difficulty":"III+","approximate":false},{"type":"takeout","description":null,"id":"115015","location":{"latitude":"45.0774993896484","longitude":"-122.485000610352"},"name":"Take Out","distance":"13","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"0rzApkdoEpEtCUWAKZBna","title":"New Logjam (01/26/26)","post_date":"2026-01-27 00:38:54+00","detail":"I wanted to let you know about a major logjam on the Molalla River, just downstream of the Horse Creek Bridge. It's huge, and completely blocks the river channel for well over 50 meters. per: Dean Reese, Outdoor Recreation Planner for the BLM","user":{"name":"Bethany Overfield"}},{"id":"DtfB4NBXim5R1DC9wjdyj","title":"Wood in Goldilocks","post_date":"2025-12-20 07:29:31+00","detail":"There are two logs in the left channel in Goldilocks.","user":{"name":"Kekoa Bancroft"}},{"id":"qwduJethpmyQ2R5I9TgOA","title":"Logjam on Horse Creek Canyon section","post_date":"2025-02-17 23:37:29+00","detail":"There is currently a dangerous logjam upstream of Turner Bridge on the Horse Creek Canyon section of the Molalla. It is in the middle of Horse Creek Canyon Rapid and while there is a portage eddy available on the right, it is a strong intermediate move to catch the eddy and missing this eddy would be very dangerous.","user":{"name":"Pete Giordano"}}],"photos":[{"id":"OQEIWK5pbySFtfFPMwiNJ","ext":"jpg","post_id":"o56vep3Gw1p7NQTA9yi9x","description":"","caption":"","poi_name":null,"subject":"","author":"Pete Giordano","poi_id":"100564","photo_date":"2025-02-17T23:37:22.000Z","updated_at":"2025-02-17T23:37:22.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/OQEIWK5pbySFtfFPMwiNJ","large":"https://api.americanwhitewater.org/image/images/big/OQEIWK5pbySFtfFPMwiNJ"}},{"id":"Ma4teJluVYfDllJDr5B5n","ext":"jpg","post_id":"o56vep3Gw1p7NQTA9yi9x","description":"","caption":"Horse Creek Canyon logjam","poi_name":null,"subject":"","author":"Pete Giordano","poi_id":"100564","photo_date":"2025-02-17T23:37:22.000Z","updated_at":"2025-02-17T23:37:22.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/Ma4teJluVYfDllJDr5B5n","large":"https://api.americanwhitewater.org/image/images/big/Ma4teJluVYfDllJDr5B5n"}},{"id":"d5yCHREomfoiNUlQVeMhD","ext":"jpg","post_id":"4ayBEMNJFuEHwJvNUXP1p","description":"","caption":"","poi_name":null,"subject":"","author":"Pete Giordano","poi_id":null,"photo_date":"2005-12-19T00:49:28.000Z","updated_at":"2024-11-19T00:49:28.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/d5yCHREomfoiNUlQVeMhD","large":"https://api.americanwhitewater.org/image/images/big/d5yCHREomfoiNUlQVeMhD"}},{"id":"rAeUNf1JM73sAHRa3KprE","ext":"jpg","post_id":"4ayBEMNJFuEHwJvNUXP1p","description":"","caption":"","poi_name":null,"subject":"Papa Bear Rapid","author":"Pete Giordano","poi_id":null,"photo_date":"2005-12-19T00:49:28.000Z","updated_at":"2024-11-19T00:49:28.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/rAeUNf1JM73sAHRa3KprE","large":"https://api.americanwhitewater.org/image/images/big/rAeUNf1JM73sAHRa3KprE"}},{"id":"82614ZUdxPv99UxjpdbvD","ext":"jpg","post_id":"oNVfgLHptvbGwMMxftywh","description":"","caption":"","poi_name":null,"subject":"","author":"Kekoa Bancroft","poi_id":null,"photo_date":"2025-12-20T07:24:41.000Z","updated_at":"2025-12-20T07:24:41.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/82614ZUdxPv99UxjpdbvD","large":"https://api.americanwhitewater.org/image/images/big/82614ZUdxPv99UxjpdbvD"}},{"id":"U1q3dPQj4XfS51PAJxf50","ext":"jpg","post_id":"oNVfgLHptvbGwMMxftywh","description":"","caption":"","poi_name":null,"subject":"","author":"Kekoa Bancroft","poi_id":null,"photo_date":"2025-12-20T07:24:41.000Z","updated_at":"2025-12-20T07:24:41.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/U1q3dPQj4XfS51PAJxf50","large":"https://api.americanwhitewater.org/image/images/big/U1q3dPQj4XfS51PAJxf50"}},{"id":"wpwITTIbkw5WFei2Ruh2j","ext":"jpg","post_id":"EXj1JtvJkJkNvAuAfVZSd","description":"rafting baby bear rapid, molalla river","caption":"","poi_name":null,"subject":"Baby Bear Rapid","author":"Pete Giordano","poi_id":null,"photo_date":"2007-03-14T00:59:09.000Z","updated_at":"2024-11-19T00:59:09.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/wpwITTIbkw5WFei2Ruh2j","large":"https://api.americanwhitewater.org/image/images/big/wpwITTIbkw5WFei2Ruh2j"}},{"id":"752939","ext":"jpeg","post_id":"752927","description":"","caption":"Mama Bear","poi_name":"Mama Bear","subject":"Megi Morishita","author":"Thomas O'Keefe ©","poi_id":"100518","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/752939","large":"https://api.americanwhitewater.org/image/images/big/752939"}},{"id":"752942","ext":"jpeg","post_id":"752927","description":"Entering the spectacular basalt canyon in Mama Bear.","caption":"Mama Bear","poi_name":"Mama Bear","subject":"Megi Morishita","author":"Thomas O'Keefe ©","poi_id":"100518","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/752942","large":"https://api.americanwhitewater.org/image/images/big/752942"}}],"detail":{"id":"1533","permitUrl":"","permitInfo":"","description":"This section of the Upper Molalla River is popular with intermediate boaters and offers a variety of trip lengths and difficulties. The middle section from Turner Bridge to a mile below Baby Bear is the most popular section and includes the 3 biggest rapids. Above and below this section the river is generally a half class easier and has longer easier stretches between rapids. Usually boaters looking for more than a half day trip will add either the upper or lower sections to the middle section. Rarely are all 3 sections run in the same trip.\n\nThe upper portion of this section begins with a put-in on the Table Rock Fork (just above the confluence with the main Molalla River). After .3 miles, the Table Rock Fork joins the main Molalla. The rapids in this part of the river mainly consist of interesting, playful Class 2 rapids with an occassional Class 3 rapid. The biggest rapid on this part of the river is .25 miles downstream from Horse Creek Bridge and consists of increasingly large waves ending in a turbulent, narrow slot in a short gorge. After the entrance of the gorge, there is a good recovery pool. More fun Class 2-3 rapids continue after Horse Creek Canyon Rapid all the way to the beginning of the middle section at Turner Bridge.\n\nTurner Bridge marks the start of what is known as the 3 Bears Run. In this section, the river consists of some larger rapids set in a beautiful basalt canyon. About .7 miles downstream of Turner Bridge is Papa Bear Rapid. Papa Bear starts with a fast ramp down the right side of the rapid with several line options. After a very short pause, the second half of the rapid is generally run down the middle and then finishing on the right or left at the bottom. A mile below Papa Bear is the biggest rapid on this section, Mama Bear. Mama Bear starts on a sharp right turn before plunging through a powerful hole in between 2 large boulders in the middle of the river. Below these boulders, the river plunges down into a beautiful, narrow basalt gorge with some big waves but no real hazards. Take time to enjoy this special place. Below Mama Bear, the rapids calm down a bit although there can still be some surprises. The last of the big 3 rapids, Baby Bear, is the second drop once the river comes back next to the road. Baby Bear contains a powerful hole on the right up against a large, mid-stream boulder. Boaters generally run left of center with speed to reach the pool below the hole. The next half mile has a couple other fun rapids before flattening out. There are a couple small access spots that can be used for a take-out.\n\nIf boaters decide to continue down to Glen Avon Bridge, they will have a chance to run Goldilocks and Porridge Bowl rapids. These come after several miles of river easier rapids. Godilocks is recognized by a sharp left turn with a steep drop through some waves quickly followed by an island that splits the river. Most boaters take the left channel although the right channel is possible at some flows. The left channel ends on a sharp right turn with a narrow slot on the left and a somewhat larger slot on the right past several large boulders. It is vital to know that these slots are not blocked by wood before committing. The right channel avoids these slots but is often shallower. Porridge Bowl Rapid consists of some powerful waves that lead into a headwall with eddies on both sides. A short, beautiful section of river takes boaters down to a small take-out on the right where the river comes close to the road above Glen Avon Bridge.\n\nFor an additional description and pictures of the run see [Upper Molalla (Three Bears)](http://www.oregonkayaking.net/rivers/mollala/mollala.html).","averageGradient":null,"maxGradient":null,"length":"13","correlations":[{"reachID":"1533","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":"Difficulty increases one level above recommended flows.","lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":"IV","beginLowRunnable":"1000","beginMediumRunnable":"1300","beginHighRunnable":"3000","endHighRunnable":"6000"},"gaugeInfo":{"name":"MOLALLA RIVER NEAR CANBY, OR","gaugeSource":"USGS","gaugeSourceIdentifier":"14200000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"304","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"9.63","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"45.24391667","longitude":"-122.6874444"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/14200000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/14200000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"304","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}},{"reachID":"1533","isPrimary":false,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"3.4","beginMediumRunnable":"4