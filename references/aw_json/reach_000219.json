[{"result":{"data":{"json":{"id":"219","stub":{"id":"219","section":"3.5) Powerhouse #3 to Riverside Park ","altname":"Powerhouse Run","river":"Kern","difficulty":"IItoIII","states":["USA-CAL"]},"primaryGaugeStatus":{"status":"medium-runnable","latestReading":{"value":"1501","dateTime":"2026-05-12T01:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"111050","location":{"latitude":"35.7758","longitude":"-118.436"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"access","description":"Kernville Park is a good meeting place and is the site of the first whitewater course in the US.   Slalom races and other events are held regularly.","id":"101640","location":{"latitude":"35.75443649291992","longitude":"-118.42347717285156"},"name":"Kernville Park","distance":"1.9","photoID":"0","difficulty":"N/A","approximate":false},{"type":"takeout","description":"This is a common take out for boaters who continue past Kernville park.","id":"101638","location":{"latitude":"35.720367431640625","longitude":"-118.43433380126953"},"name":"Cemetary Take Out","distance":"4.7","photoID":"0","difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"639","ext":"jpeg","post_id":"2396","description":"Check out many more of Scott's excellent photos <a href=\"http://community.webshots.com/user/sostrem1\">here</a>.","caption":"Kern River Park","poi_name":"Riverside Park","subject":"Dennis Ostrem","author":"Scott Ostrem","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/639","large":"https://api.americanwhitewater.org/image/images/big/639"}}],"detail":{"id":"219","permitUrl":"","permitInfo":"","description":"Kernville park is the perfect place to meet other boaters, compare notes, paddle the play features, watch others paddle the play features and just enjoy a great place.   Kernville itself is a nice town with lots of great restaurants,  motels and campgrounds.     Sierra South store has whitewater and outdoor equipment along with river news and good advice.\n\nThe river from Powerhouse #3 to Kernville is a popular section that is especially good for teaching and for anyone to practice their skills.   Since it is below the powerhouse this section contains the full flow of the river.    Overall, the run contains mostly riffles and waves, but there are two significant rapids, The Wall and Ewing's.\n\nLocal boaters are working to restore and improve [Kernville Riverside Park](http://kernvilleriversidepark.com/index.htm).\n\n**Getting There:**   Kernville is at the upstream end of Lake Isabella [google map](http://maps.google.com/maps?q=35.7528,+-%20118.42416+%28Kernville+Park%29&hl=en&ie=UTF8&z=17&ll=35.7528,-%20118.42416&spn=0.00376,0.010632&t=h&om=1).   From Bakersfield, take Highway 178 up through the Kern Canyon, around Lake Isabella.\n\n**Guidebooks:**\n\nCassady & Calhoun, Holbek & Stanley, Martin, Alan Baty\n\n```\n\n```\n\n**Other information sources:**\n\n```\nCamping\n```\n\n[Upper Kern Guidebook and Map](https://www.kernriverrafting.com/kern-river-guide/upper-kern/)\n\n[Wikipedia](http://en.wikipedia.org/wiki/Kern_River)\n\n[Kern River Festival](http://www.kvrc.org/festival.htm)\n\n[Kern River Alliance](http://www.kernriver.org/)\n\n[Kern Valley River Council](http://www.kvrc.org/)\n\n[Audubon, Kern River Preserve](http://kern.audubon.org/bioregion.htm)\n\nWild and Scenic Kern\n\n[River at Kernville Webcam](http://www.furface.com/webcams)\n\n[Restore Riverside Park](http://kernvilleriversidepark.com/index.htm)","averageGradient":null,"maxGradient":null,"length":"2","correlations":[{"reachID":"219","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjusted