[{"result":{"data":{"json":{"id":"1710","stub":{"id":"1710","section":"Route 86 to Route 113","altname":"","river":"Tyger, South","difficulty":"IItoIII","states":["USA-SCR"]},"primaryGaugeStatus":{"status":"stale","latestReading":{"value":"4.19","dateTime":"2026-02-11T18:45:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"108496","location":{"latitude":"34.78277","longitude":"-81.971873"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"113733","location":{"latitude":"34.734525","longitude":"-81.890322"},"name":"Take Out","distance":"9.85","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"IbApK8NTlB1hqVefoEM4o","title":"Wrong gauge.  Use Woodruff, not Delta.","post_date":"2024-09-26 23:05:10+00","detail":"https://waterdata.usgs.gov/monitoring-location/02159500/#parameterCode=00065&period=P30D&showMedian=false","user":{"name":"Jonathan Gerst"}}],"photos":[{"id":"2915","ext":"jpeg","post_id":"5049","description":"","caption":"Bottom of the dog","poi_name":"Sting M Dog","subject":"Kevin Miller","author":"Will Reeves","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/2915","large":"https://api.americanwhitewater.org/image/images/big/2915"}},{"id":"2914","ext":"jpeg","post_id":"5050","description":"","caption":"Sting M Dog","poi_name":"Sting M Dog","subject":"Will Reeves","author":"Kevin Miller","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/2914","large":"https://api.americanwhitewater.org/image/images/big/2914"}}],"detail":{"id":"1710","permitUrl":null,"permitInfo":null,"description":"Instructions to the Put-In\n\nTake Exit 35 (Woodruff & Walnut Grove) from I-26. This exit is between Clinton and Spartanburg. This will put you on the S J Workman Highway (Highway 50). Turn whichever direction and go to the CitGo station. From the main sign at the CitGo station, head West toward Woodruff along the S J Workman Highway. Go 0.2 miles and turn right on Price House Road (Highway 86) (the turn is just past the Kingdom Hall of Jehovah's Witnesses). At 1.5 miles, you will cross [Ferguson Creek](http://www.topozone.com/map.asp?z=17&n=3847612&e=411785&s=25) that feeds into the South Tyger which can be seen to the right. At 2.7 miles, you will cross the South Tyger at [Price Bridge](http://www.topozone.com/map.asp?z=17&n=3849207&e=411043&s=25).It looks like you could launch at either place. Have not run this reach yet.\n\nInstructions to the Take-Out\n\nGo about 1.6 miles from the Ferguson Creek Crossing or 0.4 miles form the South Tyger crossing to a stop sign at the intersection with Hobbysville Road (SC Road # S42-229). Turn right. Continue down Hobbysville Road. At 0.7 miles, bear left onto Morris Bridge Road (South Carolina Road # S 42-231). At 0.9 miles from stop sign at the intersection with Hobbysville Road you will cross I-20 and at 1.1 miles you will reach the put-in for the [Route 231 to Route 113 reach of the North Tyger](http://www.americanwhitewater.org/rivers/id/3555/). Continue 1.1 miles from the North Tyger put-in until you reach Hatchett Road. Turn right on Hatchett Road and go 2.3 miles until you reach Walnut Grove Road (S 42-50). Turn right and go .8 miles until Old Hlls Bridge Road.\\* After about 1 mile, go right following Road 113. The take out is another 2.1 miles.\n\n\n\n\\\\* If you continue on Walnut Grove Road for 2.4 miles, you will cross the Tyger on Highway 50. You can see a lot of the rapids here. There are also very visible and unfriendly no trespassing signs. I have not ever put in or taken out here because to do so will cause you to miss a lot of the whitewater. There appears to be access at the bridge, but I do not its ownership status.\n\nIntersection With the North Tyger\n\nThe South Tyger Intersects with the North Tyger [(See AWA Reach Number 3555)](http://www.americanwhitewater.org/rivers/id/3555/) to form the [Tyger](http://www.topozone.com/map.asp?z=17&n=3846546&e=414680&s=25&u=1)\n\nabout two miles below the Ferguson Creek crossing and about four miles below the the Highway 86 crossing. From this intersection, you are about about 0.3 miles above the Highway 50 crossing.\n\nPick Up Some Local Paddlers\n\nTwo sites to post a planned trip on or to request information are [Carolina Paddlers Assembly](http://clubs.yahoo.com/clubs/carolinapaddlersassembly) and [Upstate Paddling](http://groups.yahoo.com/group/upstatepaddling). You will have to join these groups to post but they are open to the public. You may pick up some local paddlers as well as the North Tyger is a popular local reach when it is running. You may also want to check the [Palmetto Paddlers](http://www.midnet.sc.edu/paddler) and their [Scheduled Trips](http://www.midnet.sc.edu/paddler/trips.html) to see if anything is planned. There are additional photos of the North Tyger in the Palmetto Paddlers photo album at Carolina Paddlers Assembly.","averageGradient":null,"maxGradient":null,"length":"9.8","correlations":[{"reachID":"1710","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"3.6","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"10"},"gaugeInfo":{"name":"TYGER RIVER NEAR DELTA, SC","gaugeSource":"USGS","gaugeSourceIdentifier":"02160105","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"333","dateTime":"2026-02-11T18:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"4.19","dateTime":"2026-02-11T18:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"34