[{"result":{"data":{"json":{"id":"662","stub":{"id":"662","section":"State HWY 626 to Morgantown Rd (2.75 miles)","altname":"","river":"Gasper River","difficulty":"II","states":["USA-KEN"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":"The putin only has room for three to four cars max.  Do not park in front of the metal stake in the ground.  It marks the private property line and the land owner is notorious for hassling boaters.","id":"101505","location":{"latitude":"37.02180099487305","longitude":"-86.60759735107422"},"name":"State HWY 626","distance":"0","photoID":"0","difficulty":"N/A","approximate":false},{"type":"playspot","description":"Shortly after the putin rapid the river will bend to the right.  Immediately after this bend eddy out to surf.  Depending on the level there will be one or two surfing waves.","id":"101508","location":{"latitude":"0","longitude":"0"},"name":"Surfers","distance":"0.4","difficulty":"II","approximate":false,"photoID":"17227"},{"type":"playspot","description":"This is the longest and most defined wave train on the run.  Look for a wave/hole located left of center about 2/3rds the way down the rapid.  Depending on the river level you can eddy out and surf or catch it on the fly.  The rapid is named after the Catholic Retreat Center located on river left.","id":"101509","location":{"latitude":"0","longitude":"0"},"name":"Retreat","distance":"0.6","difficulty":"II","approximate":false,"photoID":"0"},{"type":"playspot","description":"Shortly after Retreat rapid the river takes a sharp left hand turn.  This is Barking Dog rapid.  Look for a small catch on the fly play hole in the center of the river.","id":"101510","location":{"latitude":"0","longitude":"0"},"name":"Barking Dog","distance":"0.8","difficulty":"II","approximate":false,"photoID":"0"},{"type":"takeout","description":"There is a large parking area on the side of the road.  Please pull into the area turn around and park next to the road barrier so that other boats do not get blocked in.","id":"101513","location":{"latitude":"37.052799224853516","longitude":"-86.59590148925781"},"name":"Morgantown Rd","distance":"2.75","photoID":"0","difficulty":"N/A","approximate":true}],"alerts":[],"photos":[{"id":"17228","ext":"jpeg","post_id":"9195","description":"Making It look easy!","caption":"Easy Rider","poi_name":"Surfer's","subject":"Seth Odell","author":"Parson","poi_id":"101508","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17228","large":"https://api.americanwhitewater.org/image/images/big/17228"}},{"id":"17227","ext":"jpeg","post_id":"9196","description":"Hey Mom!","caption":"Surfers","poi_name":"Surfers","subject":"Patrick Parson","author":"Seth Odell","poi_id":"101508","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17227","large":"https://api.americanwhitewater.org/image/images/big/17227"}},{"id":"17229","ext":"jpeg","post_id":"9196","description":"Opps!","caption":"Opps!","poi_name":"Surfer's","subject":"Mark Warren","author":"Seth Odell","poi_id":"101508","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17229","large":"https://api.americanwhitewater.org/image/images/big/17229"}}],"detail":{"id":"662","permitUrl":"","permitInfo":"","description":"This section of Gasper River features rock walls on alternating banks that creates a mini-gorge in the middle of farm country. The mini-gorge is roughly a mile long and consists of serveral wave trains with moving pools of flatwater in-between. There are numerous catch-on-the-fly surfing waves.  The remaining 1.75 miles are flat with some current. If you live in the Bowling Green area this is a great quick fix of whitewater.\n\n_Watch this video of Retreat Rapid at 2.5 ft on 3-2-11 by S. Truman_","averageGradient":"0","maxGradient":"0","length":"3.3","correlations":[],"pointOfInteres