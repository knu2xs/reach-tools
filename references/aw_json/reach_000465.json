[{"result":{"data":{"json":{"id":"465","stub":{"id":"465","section":"Hwy 129 pull off by bridge to Canyon View Rd takeout","altname":"Cloudland Canyon","river":"Bear Creek","difficulty":"V","states":["USA-GEO"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"138","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"112357","location":{"latitude":"34.8281","longitude":"-85.4593"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"portage","description":"From Daniel Talley:\n\"That one picture with the tree in it is from\nSurrealistic Pillow. This is after Edward\nScissor Hands and the first large rapid that\nyou come to. We run the far right crack that\nends with a ten foot drop, which is what the\npicture shows.\" Center line blocked by log\nand undercut, left too rocky. Often portaged\nwhen low - pins in right crack happen.","id":"52","location":{"latitude":"0","longitude":"0"},"name":"Surrealistic Pillow","distance":"0.1","photoID":"370","difficulty":"V","approximate":false},{"type":"hazard","description":"3-step 45' drop with the 2nd step 15'er landing on flat rock. Super-fun but back and rib injuries common. Head injuries when people flip, too. A common story you hear about Stairway is that people scout the drop and say \"no way am I running that!\". At which point they start to look at the portage. Then the hapless boater quietly gets back in their boat and starts to psyche up. Walk up and out river left to Cloudland Canyon picnic area if needed.","id":"41","location":{"latitude":"0","longitude":"0"},"name":"Stairway to Heaven","distance":"0.3","photoID":"7358","difficulty":"V+","approximate":false},{"type":"hazard","description":"This used to be a mandatory portage but is\nnow commonly run against the river right\nbank with boof as shown. The landing area\nis very shallow.\nOnly portage is to jump off river left into pool.","id":"43","location":{"latitude":"0","longitude":"0"},"name":"Big Bang","distance":"0.6","photoID":"8789","difficulty":"V+","approximate":false},{"type":"hazard","description":"Big easy boof above 13\" ; nasty f-up flake\nin channel when low. Memorable piton to\nskirt-pop to right wall overhung rock grovel\nmove when boof gets blown.","id":"54","location":{"latitude":"0","longitude":"0"},"name":"Momentary Lapse of Reason","distance":"0.8","photoID":"369","difficulty":"V","approximate":false},{"type":"rapid","description":null,"id":"270","location":{"latitude":"0","longitude":"0"},"name":"Armageddon","distance":"0.9","difficulty":"V","approximate":false,"photoID":"7338"},{"type":"takeout","description":null,"id":"117640","location":{"latitude":"34.8611","longitude":"-85.4858"},"name":"Take Out","distance":"3","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"367","ext":"jpeg","post_id":"1325","description":"","caption":"Stairway to Heaven","poi_name":"Stairway to Heaven","subject":"Daniel Talley","author":"Chris Young","poi_id":"41","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/367","large":"https://api.americanwhitewater.org/image/images/big/367"}},{"id":"8788","ext":"jpeg","post_id":"1570","description":"","caption":"Big Bang","poi_name":"Big Bang","subject":"","author":"Matt Theiling","poi_id":"43","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8788","large":"https://api.americanwhitewater.org/image/images/big/8788"}},{"id":"5909","ext":"jpeg","post_id":"6468","description":"","caption":"Revelation","poi_name":"Revelation","subject":"Eric McCloud","author":"Crispin Del Nero","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5909","large":"https://api.americanwhitewater.org/image/images/big/5909"}},{"id":"369","ext":"jpeg","post_id":"1324","description":"The boulder drops just below Momentary Lapse of reason on Bear Creek, Ga.","caption":"Just below Momentary Lapse of Reason","poi_name":"Just below Momentary Lapse of Reason","subject":"John","author":"Daniel Talley","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/369","large":"https://api.americanwhitewater.org/image/images/big/369"}},{"id":"368","ext":"jpeg","post_id":"1325","description":"","caption":"Big Bang","poi_name":"Big Bang","subject":"Nathan Helms","author":"Chris Young","poi_id":"43","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/368","large":"https://api.americanwhitewater.org/image/images/big/368"}},{"id":"370","ext":"jpeg","post_id":"1324","description":"From Daniel Talley:\r\n\"That one picture with the tree in it is from Surrealistic Pillow. This is \r\nafter Edward Scissor Hands and the first large rapid that you come to. We run the far right crack that ends with a ten foot drop, which is what the picture shows.\"\r\n","caption":"Surrealistic Pillow","poi_name":"Surrealistic Pillow","subject":"","author":"Daniel Talley","poi_id":"270","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/370","large":"https://api.americanwhitewater.org/image/images/big/370"}},{"id":"1168","ext":"jpeg","post_id":"2426","description":"","caption":"Stairway to Heaven","poi_name":"Stairway to Heaven","subject":"Todd Scott","author":"","poi_id":"41","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1168","large":"https://api.americanwhitewater.org/image/images/big/1168"}},{"id":"42320","ext":"jpeg","post_id":"9889","description":"","caption":"Top of Stairway","poi_name":"Stairway to Heaven","subject":"David Cohen","author":"Taylor","poi_id":"41","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/42320","large":"https://api.americanwhitewater.org/image/images/big/42320"}},{"id":"7358","ext":"jpeg","post_id":"6817","description":"Stairway run, \"back in the day\". (get those old-schooler arms down, Jascomb). ","caption":"Another Stairway View","poi_name":"Stairway To Heaven","subject":"Jerry Jascomb","author":"Scott Shoup","poi_id":"41","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/7358","large":"https://api.americanwhitewater.org/image/images/big/7358"}},{"id":"7338","ext":"bmp","post_id":"6817","description":"The river left channel is now clear of trees, but back when it wasn't this was the only line in center. Boulder on right is severely undercut.","caption":"Armageddon","poi_name":"Armageddon","subject":"Jerry Jascomb","author":"Scott Shoup","poi_id":"270","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/7338","large":"https://api.americanwhitewater.org/image/images/big/7338"}},{"id":"42321","ext":"jpeg","post_id":"9889","description":"","caption":"Middle of Stairway","poi_name":"Stairway to Heaven","subject":"David Cohen","author":"Talor","poi_id":"41","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/42321","large":"https://api.americanwhitewater.org/image/images/big/42321"}},{"id":"891971","ext":"jpg","post_id":"895871","description":null,"caption":"Paul Hubbard","poi_name":"Stairway to Heaven","subject":null,"author":"Nick Murphy","poi_id":"41","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891971","large":"https://api.americanwhitewater.org/image/images/big/891971"}}],"detail":{"id":"465","permitUrl":null,"permitInfo":null,"description":"Gauge Description:\n\nThe local gauge on the bridge upstream from the put-in - downstream river right side. 9\" min, 12\"--18\" optimim, 20\"-2' high but commonly run (watch fishbowl and revelations).\n\nThe cfs gauge listing is for Lookout Creek, just downstream of Trenton, Ga. Bear drains into lookout creek. The gauge is less than two miles from the Bear takeout.\n\nInformation from local expert, Ron Stewart, Box 1337, Chatanooga, TN 3740\n\nBear was first run by Ron Stewart and Doug Wellman in the early 90s.\n\n**Significant rapids are:**\n\n1\\. Edward Scissorhands - constriction with sharp shelf off right (get up on left)\n\n2\\. Surreal Pillow - right sneak at med flows, portage best when low - trees block channel\n\n3\\. Fishbowl - hidden piton center of 1st ledge, big hole below over 20\"\n\n4\\. Snakepit\n\n5\\. Knockin on heavens door - leads into\n\n6\\. Stairway to Heaven - faster than you may think. Eddy left and early to scout. Portage\nby walking IN FLOW down left (slick above waterline). Numerous accidents here -\ncompressed vertabrae, skull fractures, broken ribs, elbows, etc. Big fun, big bounce.\n\n7\\. Cosmic trigger - watch for new logs, run right\n\n8\\. Big Bang - Far right boof to shallows - hard to line up launch pad w/o scouting. Far left\nrun at very high flows or portage river left by jumping into pool.\n\n9\\. Reveleation: 3 drops - big hole and pile-ups at high flows. Set spotter or space out.\n\n10\\. Momentary Lapse of Reason: big boof! Sketch crack w/ piton at low flows\n\n11\\. Armageddon: watch for trees in runout, super-technical but by now . . .\n\n**[Daniel's Creek](http://www.americanwhitewater.org/rivers/id/3574/)** enters from river left - hike up river left trail1/2 mi for 4-5\nadditional drops when levels are over 15\" and logs permit. 30'er has not been run.\n\n12\\. Pinball Wizard - Mucho technical drop with changing log configurations. Bottom right\nslot pretty nasty w/ pin danger at low flows.\n\n13\\. Gargoyle - scout at low flows\n\n14\\. Omega - dangerous seive just downstream on left (1/2 river dissappears). Very\ncontinuous lead-in for 1/2 mile at high flows. Don't leave your 1st timer buddies and\nblaze in blind!!! Rapids fine, but the seive warrants consideration.\n\nAbout a third of the way down the run Daniel Creek will enter on river left.\n\nAccording to the topo maps from the confluence down the creek becomes Sitton Gulch\nCreek. Eventually the creek drains into Lookout Creek in Trenton, Ga.","averageGradient":"270","maxGradient":"475","length":"3.8","correlations":[{"reachID":"465","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1000","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"5000"},"gaugeInfo":{"name":"LOOKOUT CREEK NEAR NEW ENGLAND, GA","gaugeSource":"USGS","gaugeSourceIdentifier":"03568933","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"138","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"4.46","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"34.8968611","longitude":"-85.4635278"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/03568933","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/03568933/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"138","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["112357","52","41","43","54","270","117640"],"geometry":{"type":"LineString","coordinates":[[-85.45928612584359,34.8281776830855],[-85.45966871112313,34.828246012606314],[-85.45986871112285,34.82822367927298],[-85.460