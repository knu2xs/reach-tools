[{"result":{"data":{"json":{"id":"1750","stub":{"id":"1750","section":"Hot Springs (NC) to Highway 107 at Del Rio","altname":"","river":"French Broad","difficulty":"ItoIII","states":["USA-TNN"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"109319","location":{"latitude":"35.8936","longitude":"-82.8222"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"114561","location":{"latitude":"35.9254","longitude":"-83.0208"},"name":"Take Out","distance":"18","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"886768","ext":"jpeg","post_id":"889499","description":"The second railroad trestle over the French Broad at Weaver's Bend.  This is the main line between Knoxville and Asheville, and it is fairly active.  ","caption":"lower twin bridge","poi_name":null,"subject":null,"author":"Forrest Easterly","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/886768","large":"https://api.americanwhitewater.org/image/images/big/886768"}},{"id":"886767","ext":"jpeg","post_id":"889498","description":"The first railroad trestle you will encounter while paddling downstream on section 10.  Low water, early-November 2014.  ","caption":"Upper twin bridge","poi_name":"","subject":"","author":"Forrest Easterly","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/886767","large":"https://api.americanwhitewater.org/image/images/big/886767"}},{"id":"886764","ext":"png","post_id":"889495","description":"The majority of the rapids on section 10 are from Paint Rock, TN/NC, down to the Wolf Creek Bridge (upper HWY 25/70 bridge in TN).  They are separated by long deep pools of gently flowing water, making for a great place to take beginners.  ","caption":"Ledges on section 10","poi_name":"","subject":"","author":"Forrest Easterly","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/886764","large":"https://api.americanwhitewater.org/image/images/big/886764"}},{"id":"886765","ext":"jpeg","post_id":"889496","description":"Bluffs on the French Broad just inside TN, just upstream of Weaver's Bend.  ","caption":"Bluffs downstream of Paint Rock","poi_name":"","subject":"","author":"Forrest Easterly","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/886765","large":"https://api.americanwhitewater.org/image/images/big/886765"}},{"id":"883301","ext":"jpeg","post_id":"885958","description":"George surfing near the end of the river.","caption":"Surfing","poi_name":"","subject":"","author":"Simon Krzych","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/883301","large":"https://api.americanwhitewater.org/image/images/big/883301"}}],"detail":{"id":"1750","permitUrl":"","permitInfo":"","description":"Listed in Canoeing and Kayaking Guide to the Streams of Tennessee, B. Sehlinger.\n\nWonderful day-long canoe trip with mild rapids. Popular spot for rented canoes, but also a wonderful float. Can be floated all the way through the next section down for a wonderful long canoe trip. Some camping spots along the way -- not sure how legal they are, so check out access to public areas first.  Weaver's Bend is part of the Cherokee National Forest and has primitive camping options. Can be combined with the next section below Del Rio for a wonderfully long summer day or overnighter (or two, if you take it really slow). We used to guide NC Outward Bound trips down this section. Great place to learn kayaking/canoeing","averageGradient":null,"maxGradient":null,"length":"17.8","correlations":[],"pointOfInterestIDs":["109319","114561"],"geometry":{"type":"LineString","coordinates":[[-82.822323