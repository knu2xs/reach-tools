s://api.americanwhitewater.org/image/images/medium/880735","large":"https://api.americanwhitewater.org/image/images/big/880735"}},{"id":"880734","ext":"jpeg","post_id":"881963","description":"Larger surfing hole","caption":"Fish or Swim 1","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880734","large":"https://api.americanwhitewater.org/image/images/big/880734"}},{"id":"42642","ext":"jpeg","post_id":"10191","description":"Smashing through a hole on a cold saturday morning in march, Green monster or one of the ledges, i'm not sure, but it was AWESOME!!!!!","caption":"Jackie & joe Raftin the Toh'","poi_name":"Green monster","subject":"","author":"joe dematteo","poi_id":"102005","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/42642","large":"https://api.americanwhitewater.org/image/images/big/42642"}},{"id":"859","ext":"jpeg","post_id":"3699","description":"","caption":"Charlie Walbridge","poi_name":"","subject":"Tohickon Creek- Point Pleasant, PA ","author":"Julie Black","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/859","large":"https://api.americanwhitewater.org/image/images/big/859"}},{"id":"12863","ext":"mov","post_id":"9149","description":"me and johny having a time.  umlike the release we had the river to ourselves, woo hoo!!","caption":"tohickon creek runs","poi_name":"","subject":"some how tos some how not tos","author":"seth","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/12863","large":"https://api.americanwhitewater.org/image/images/big/12863"}},{"id":"8455","ext":"jpeg","post_id":"6451","description":"","caption":"Big Loop","poi_name":"Green Monster","subject":"Eli Landis","author":"Mysel Landis","poi_id":"102005","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8455","large":"https://api.americanwhitewater.org/image/images/big/8455"}},{"id":"96","ext":"jpeg","post_id":"2272","description":"","caption":"The Green Monster","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/96","large":"https://api.americanwhitewater.org/image/images/big/96"}},{"id":"615738","ext":"jpeg","post_id":"615737","description":"ledges action shot!","caption":"bucks county big air ","poi_name":"1st ledge- i think","subject":"big air","author":"coach Bruce","poi_id":"102009","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/615738","large":"https://api.americanwhitewater.org/image/images/big/615738"}}],"detail":{"id":"1672","permitUrl":"","permitInfo":"The state wishes to sell day permits at the put-in during the release.  You probably won't need this if your boat is stickered with the PA fish and boat commission yearly permit.  The takeout parking (Bucks County River Country) has been $10 for one day and goes to the local fire department.  Running shuttle to the lot has been free in the past.  Overnight camping and porta-potties are available there also.","description":"Typically releases are scheduled for March & November. Hope to see you there! The Tohickon is a jewel to us locals. It offers some great play, scheduled releases, and lots of activity after heavy rains. It is a good Class III run that can be viewed as a stepping stone for novice and intermediates or as a fun play creek for intermediate and advanced paddlers. There is a fun play hole that serves up some great surfing and verticality to those that are patient. There are at least six challenging rapids in this 3.75 mile stretch that will keep anyones attention. **Scheduled two day releases are generally the third weekend in March and the first weekend in November.** [Ralph Stover State Park](http://www.dcnr.state.pa.us/stateparks/findapark/ralphstover/index.htm). Some changes the state is making is to require launch permits, either daily permits sold at the park on release days,or state fishing/boating permits. Actual implementation of this is still in progress. For more information, see Keystone Canoeing by Gertler","averageGradient":"42","maxGradient":"70","length":"3.4","correlations":[{"reachID":"1672","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":"IItoIII","highRunnableAdjustedDifficulty":"IIItoIV","beginLowRunnable":"200","beginMediumRunnable":"500","beginHighRunnable":"885","endHighRunnable":"1750"},"gaugeInfo":{"name":"Tohickon Creek near Pipersville, PA","gaugeSource":"USGS","gaugeSourceIdentifier":"01459500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"42","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.62","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"40.4337151","longitude":"-75.1165609"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/01459500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/01459500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"42","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["102003","102004","102005","102006","102007","102008","102009","102011","102012","102013"],"geometry":{"type":"LineString","coordinates":[[-75.097145,40.434805],[-75.097028,40.434719],[-75.09659,40.434519],[-75.096076,40.4