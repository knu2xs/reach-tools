[{"result":{"data":{"json":{"id":"146","stub":{"id":"146","section":"4. Peavine Ridge Road to Forebay Road","altname":"Golden Gate","river":"American, South Fork","difficulty":"IVtoVstandoutVplus","states":["USA-CAL"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"740","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"111376","location":{"latitude":"38.7685012817383","longitude":"-120.497001647949"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"116645","location":{"latitude":"38.7929992675781","longitude":"-120.625"},"name":"Take Out","distance":"9.4","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"248","ext":"jpeg","post_id":"2388","description":"Photo courtesy of and copyright by Brett Valle. Check out his excellent stuff in <a href=\"http://www.boof.com/\"target=\"newlink\">Boof.com</a>.","caption":"Taco Bell","poi_name":"Taco Bell","subject":"Paul Roberston","author":"Brett Valle","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/248","large":"https://api.americanwhitewater.org/image/images/big/248"}},{"id":"880494","ext":"jpeg","post_id":"881651","description":"","caption":"","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880494","large":"https://api.americanwhitewater.org/image/images/big/880494"}},{"id":"880495","ext":"jpeg","post_id":"881652","description":"","caption":"F-111 @ 4,000 cfs","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880495","large":"https://api.americanwhitewater.org/image/images/big/880495"}},{"id":"18954","ext":"jpeg","post_id":"9726","description":"","caption":"Fun boulder garden","poi_name":"","subject":"Ben Stookesberry","author":"Darin McQuoid","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/18954","large":"https://api.americanwhitewater.org/image/images/big/18954"}},{"id":"18953","ext":"jpeg","post_id":"9726","description":"Rather high water level, we guessed between 1500-2000cfs.","caption":"One of the first major rapids on Golden Gate.","poi_name":"","subject":"Jared Johnson","author":"Darin McQuoid","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/18953","large":"https://api.americanwhitewater.org/image/images/big/18953"}}],"detail":{"id":"146","permitUrl":null,"permitInfo":null,"description":"Golden Gate of the South Fork of the American River is a one day run composed of miles upon miles of steep boulder gardens of the finest quality.   \nFive larger rapids are in the mix with no mandatory portages. (Several of the five rapids of note are often portaged.)  \nThis section is considered a step-up for Sierra boating and going with a regular is advised as woody debris and levels are fickle.\n\nThe Golden Gate section runs during the late winter and spring.\n\nTo be satisfying for the Class V boater Golden Gate needs adequate flows with 1000 generally considered near optimal.\n\n***Whats in a name?*** The name Golden Gate has little to do with the character of the run other than the steepness.   \nGolden Gate is an ironic reference to an early prediction that the section was unrunnable.   \nCharles Martin wrote in the 1974 'Sierra Whitewater' guidebook, 'This run would be a novel substitute for jumping off the Golden Gate Bridge.'   \nWhile Charles was no slouch he could not predict the development of 2025 designs, plastic boats and sky jumping/boofing techniques.  \n(Remember, his world was wool and fiberglass, flat, long boats bro ... )\n\n**Getting There:** Take Highway 50 from Sacramento or Placerville and go East to Pollock Pines.\n\n**Take out:** In Pollock Pines take the Sly Park exit and go North.   \nAt Pony Express Trail turn left, then immediately turn right onto Forebay Road.   \nFollow Forebay Road all the way to a bridge over the South Fork of the American River or about 8 miles.   \nThere appears to be easy river access on the north side of the river just downstream of the bridge.\n\n**Put in:** Continue on Highway 50 past Pollock Pines a few miles to Pacific House and turn North.   \nHead right on Peavine Ridge Road. It turns to dirt and leads to a bridge across the river.   \nAlternatively, continue on Highway 50 till it is close enough to the river to provide access.\n\nThere is camping nearby on Ice House Road. Groceries and gasoline are available in Pollock Pines. Meals are available at many locations along Highway 50.  \n  \nFresh Pond Ravine is the first canyon followed by Grays Canyon.\n\nSoldier Creek and Brush Canyon enter the river from the North just before Randolph Canyon begins.  \nRandolph Canyon has some of the more formidable drops.  \nFor bonus miles/fun, use the Bridal Veil Picnic Area for a chill put in (not by the side of HWY 50) and take on a few miles more of the beautiful South Fork of the American River by picking up the Brockliss Canyon.\n\nLatitude, Longitude: 38.763540, -120.505511\n\n**Other information Sources:**\n\n[Jefferson State Creeking](http://darinm.blogspot.com/2006/06/south-fork-american-golden-gate-v-v.html)  \n  \nGold Country Paddlers and El Dorado County locals who frequent this section.\n\n'A GUIDE TO THE BEST WHITEWATER IN THE STATE OF CALIFORNIA', HOLBEK &amp; STANLEY, 1998\n\n'Sierra Whitewater', Charles Martin, 1974","averageGradient":"117","maxGradient":"200","length":"9.3","correlations":[{"reachID":"146","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"600","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"2000"},"gaugeInfo":{"name":"So. American Below Kyburz","gaugeSource":"DREAM","gaugeSourceIdentifier":"184","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"740","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.87","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"30","longitude":"30"},"externalSourceLinks":{"sourceLink":{"url":"https://www.dreamflows.com/graphs/day.184.php","text":"Dream Flows"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"migration-runnable","latestReading":{"value":"740","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["111376","116645"],"geometry":{"type":"LineString","coordinates":[[-120.497025,38.768345],[-120.497377,38.768397],[-120.497691,38.768434],[-120.498025,38.768474],[-120.498496,38.768373],[-120.498943,38.768178],[-120.499219,38.768038],[-120.499744,38.767541],[-120.500359,38.766806],[-120.500765,38.766242],[-120.501032,38.765998],[-120.501587,38.765659],[-120.50229,38.765323],[-120.502909,38.764985],[-120.503408,38.764616],[-120.504099,38.764082],[-120.504787,38.763636],[-120.505415,38.76332],[-120.506368,38.763041],[-120.506431,38.763018],[-120.506841,38.762875],[-120.507602,38.762738],[-120.508658,38.762709],[-120.509252,38.762846],[-120.509749,38.763093],[-120.509977,38.763206],[-120.511259,38.76395],[-120.512408,38.764749],[-120.513047,38.765149],[-120.513194,38.765241],[-120.513394,38.765334],[-120.513805,38.76545],[-120.515251,38.765594],[-120.516037,38.765682],[-120.517164,38.766035],[-120.518272,38.766424],[-120.519217,38.766736],[-