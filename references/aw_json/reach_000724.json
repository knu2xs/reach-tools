[{"result":{"data":{"json":{"id":"724","stub":{"id":"724","section":"1) Essex Rd. near Liberty Rd. to Purnell Dr. off Forest Park Ave.","altname":"","river":"Gwynns Falls","difficulty":"II","states":["USA-MRY"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"13","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"112309","location":{"latitude":"39.346308","longitude":"-76.734242"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"117591","location":{"latitude":"39.321918","longitude":"-76.71188"},"name":"Take Out","distance":"3.2","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"724","permitUrl":null,"permitInfo":null,"description":"Lat/longitude coords are approximate, from TopoZone.\n\n This short, pleasant trip straddles the beginning of the fall line. The put in is a little north of Liberty Road (Md. 26), half a mile above the USGS Villa Nova gauge at Essex Road (which is not quite as convenient a put in). The initial mile has good current but is pretty flat, with the first serious riffle coming as you approach Liberty Road (which is too heavily trafficked to be an ideal put in). After a little more flat water comes a series of five long class II- and class II rock gardens, spread out over about three-fourths of a mile, with the final one as you approach the bridge in Woodlawn Cemetery, where you meet the backwater from the first weir. Take out in about 200 yards, after paddling between tombstones and then exiting the cemetery; you might park in the St. Phillips Baptist Church lot, off Woodlawn Drive. The alternative is to portage or run the first (3-foot) weir and paddle a further half mile of backwater to the larger (8-foot) weir, which you must portage. From there, a half mile of class I water brings you to the start of Section 2.","averageGradient":"22","maxGradient":"55","length":"3.2","correlations":[{"reachID":"724","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":"Upper limit for best boatability uncertain. Please help your fellow boaters with a comment or report.\r\n\r\n\r\n\r\n\r\n\r\n","aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"150","beginMediumRunnable":"200","beginHighRunnable":"450","endHighRunnable":"500"},"gaugeInfo":{"name":"GWYNNS FALLS AT VILLA NOVA, MD","gaugeSource":"USGS","gaugeSourceIdentifier":"01589300","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"13","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"0.84","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"39.34588889","longitude":"-76.73319444"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/01589300","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/01589300/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"13","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["112309","117591"],"geometry":{"type":"LineString","coordinates":[[-76.734242,39.346308],[-76.733676,39.346122],[-76.733472,39.34603],[-76.73299,39.345756],[-76.732625,39.345582],[-76.732324,39.345508],[-76.73211,39.345483],[-76.731713,39.345466],[-76.73152,39.345483],[-76.731015,39.34569],[-76.730608,39.345889],[-76.73005,39.346296],[-76.729964,39.346379],[-76.729835,39.346545],[-76.729599,39.347018],[-76.729599,39.347018],[-76.729363,39.347159],[-76.728956,39.3