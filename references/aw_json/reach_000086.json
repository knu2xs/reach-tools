[{"result":{"data":{"json":{"id":"86","stub":{"id":"86","section":"Ed Banks Road to Weyerhauser Road 52200 (3 miles)","altname":"","river":"Baker Creek","difficulty":"IIItoIV","states":["USA-ARK"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"2.27","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"109568","location":{"latitude":"34.3320007324219","longitude":"-94.1849975585938"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"waterfall","description":"Main Drop:  Aim for the launch pad and fly!\n\nBeware of the hydraulics at high water levels.  Beware of pitons at low water levels","id":"5750","location":{"latitude":"34.33219909667969","longitude":"-94.17949676513672"},"name":"Baker Creek Falls","distance":"0.3","difficulty":"III+","approximate":false,"photoID":"3390"},{"type":"waterfall","description":"Main line 1/4 way off right bank.  Alternate line on left with right angle.","id":"5755","location":{"latitude":"34.32929992675781","longitude":"-94.18060302734375"},"name":"Second Ledge","distance":"0.5","difficulty":"III+","approximate":false,"photoID":"9819"},{"type":"takeout","description":null,"id":"114815","location":{"latitude":"34.2974014282227","longitude":"-94.1605987548828"},"name":"Take Out","distance":"3","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"9819","ext":"jpeg","post_id":"4063","description":"","caption":"Baker Creek","poi_name":"Second ledge","subject":"Lance Jones","author":"Ray Skinner","poi_id":"5755","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/9819","large":"https://api.americanwhitewater.org/image/images/big/9819"}},{"id":"3390","ext":"jpeg","post_id":"4064","description":"","caption":"Baker Creek Falls","poi_name":"Baker Creek Falls","subject":"Lance Jones","author":"","poi_id":"5750","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3390","large":"https://api.americanwhitewater.org/image/images/big/3390"}},{"id":"42883","ext":"jpeg","post_id":"10210","description":"","caption":"1st ledge","poi_name":"","subject":"joe c","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/42883","large":"https://api.americanwhitewater.org/image/images/big/42883"}},{"id":"548211","ext":"jpeg","post_id":"548210","description":"","caption":"Falls","poi_name":"","subject":"","author":"Pat Caple","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/548211","large":"https://api.americanwhitewater.org/image/images/big/548211"}},{"id":"548545","ext":"jpeg","post_id":"548544","description":"","caption":"","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/548545","large":"https://api.americanwhitewater.org/image/images/big/548545"}},{"id":"548547","ext":"jpeg","post_id":"548546","description":"","caption":"","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/548547","large":"https://api.americanwhitewater.org/image/images/big/548547"}},{"id":"40139","ext":"mov","post_id":"4968","description":"","caption":"1st drop","poi_name":"1st drop","subject":"Robert","author":"Robert","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/40139","large":"https://api.americanwhitewater.org/image/images/big/40139"}}],"detail":{"id":"86","permitUrl":"","permitInfo":"","description":"**Take-out:** Main one is on Weyerhauser road 52200, the first road to the left East of the Hwy 278 bridge over Baker Creek. Take-out at Hwy 278 is possible, but parking is very limited.\n\n**Put-in:** Reached by continuing across the low-water bridge at the take-out and follow the signs to the Ed-Banks Access for the Cossatot. If low-water bridge is not crossable, return to Hwy and take first road West of the Hwy 278 bridge over Baker Creek. Once reaching the intersection for Ed Banks access to the left (West) and Hwy 246 straight ahead (North), There will be a gated road to the right (East). State Park Ranger reportedly will unlock the gate on days the Cossatot is above 5 ft. This is timber land leased to two different hunting clubs. The Park Ranger is working with the paddlers, timber company and hunting clubs to help open the access more regularly. Hopefully a better system will be worked out soon.\n\nOptional put-in for higher water if gate is locked is from Hwy 246. Water needs to be over the take-out bridge for this option. First half mile will be small and brushy until several tributaries add to the volume. This adds another 3.7 miles to the run. Several good fun class III drops in this section of continuous rock gardens and ledges.\n\nThe main rapids are in the first mile below the main put-in.\n\nA couple short steep rock-jumble rapids lead into the first big drop below the main put-in bridge. The creek makes a sharp right hand bend as a small cascade enters on the left.  Scout/portage on the right. Watch the hydraulic at the bottom of the big drop at high water levels, it has nearly killed on some high water runs. At optimum levels, aim for the launching pad for a sweet boof. Watch for piton rocks at lower levels.\n\nSeveral more steep/tight class III/IV rapids follow in quick succession. Pins can be common at lower levels and sticky holes are the norm at higher levels. These consist of tight rock jumbles and small ledges, including a 6-ft ledge requiring a good boof.\n\nThe creek tames below here, but still offers good class II/III rapids and several nice surf holes.\n\nWatch out for one especially stickly ledge hole about half-way down.\n\nIf you're not quite ready for Baker Creek, check out other runs in the area when the Cossatot is running big. [Camp/Flat Creek](http://www.americanwhitewater.org/rivers/id/2719/), [Brushy Creek](http://www.americanwhitewater.org/rivers/id/2566/), [Upper Cossatot](http://www.americanwhitewater.org/rivers/id/3880/), [Little Missouri](http://www.americanwhitewater.org/rivers/id/100/).","averageGradient":"50","maxGradient":"70","length":"4","correlations":[{"reachID":"86","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"5","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"10"},"gaugeInfo":{"name":"Cossatot River near Vandervoort, AR","gaugeSource":"USGS","gaugeSourceIdentifier":"07340300","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"30","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"2.27","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"34.38","longitude":"-94.2363889"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/07340300","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/07340300/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"2.27","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null}}],"pointOfInterestIDs":["109568","5750","5755","114815"],"geometry":{"type":"LineString","coordinates":[[-94.18497661006255,34.331900767501025],[-94.185