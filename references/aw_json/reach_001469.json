[{"result":{"data":{"json":{"id":"1469","stub":{"id":"1469","section":"2. Ridgely Tract to Dillon Falls","altname":"","river":"Licking","difficulty":"II","states":["USA-OHI"]},"primaryGaugeStatus":{"status":"low-runnable","latestReading":{"value":"4.13","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":"ItoII"},"pointOfInterests":[{"type":"put-in","description":null,"id":"109202","location":{"latitude":"39.99","longitude":"-82.076"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"114442","location":{"latitude":"39.952","longitude":"-82.025"},"name":"Take Out","distance":"4.2","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"1224","ext":"jpeg","post_id":"3260","description":"Dillon Falls at the lowest enjoyable level.  This is the second ledge from the bottom and is a 3ft drop.  A left line prepares paddlers for the 4ft drop at the 3rd ledge near the bottom","caption":"Dillon Falls (2nd Ledge) - Licking River OH","poi_name":"Dillon Falls Rapid","subject":"Anthony Small","author":"N/A","poi_id":"106246","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1224","large":"https://api.americanwhitewater.org/image/images/big/1224"}},{"id":"1225","ext":"jpeg","post_id":"3259","description":"Todd Mitchell surfing the 3rd ledge at river left.  The prefered line is river-left at all levels.","caption":"Dillon Falls (3rd Ledge) - Licking River, OH","poi_name":"Dillon Falls Rapid","subject":"Todd Mitchell","author":"N/A","poi_id":"106246","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1225","large":"https://api.americanwhitewater.org/image/images/big/1225"}},{"id":"1606","ext":"jpeg","post_id":"3260","description":"See the larger version of this picture by clicking <a href=\"http://www.americanwhitewater.org/photos/?photoid=1224\">here</a>.","caption":"Dillon Falls","poi_name":"Dillon Falls","subject":"Anthony Small","author":"","poi_id":"106246","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1606","large":"https://api.americanwhitewater.org/image/images/big/1606"}},{"id":"815","ext":"jpeg","post_id":"3261","description":"This photo was taken at 2,800 CFS.  At this level, Dillon Falls reaches Class III, with 4ft waves lining up below two of the ledges.  A couple of recirculating holes form below the ledges and the river is nearly 200ft wide at this spot; thus, throw bags are not very effective.  There are public parking lots and launch points at the top and the bottom of the drop ( both on river-right), but in-between are private lots on both banks.  Be sure to ask permission before trespassing (this is necessary to scout the drops).  ","caption":"Dillon Falls - Licking River, OH","poi_name":"Dillon Falls","subject":" View of ledges from river left","author":"Steve Kreim","poi_id":"106246","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/815","large":"https://api.americanwhitewater.org/image/images/big/815"}}],"detail":{"id":"1469","permitUrl":"","permitInfo":"","description":"Dillon Falls is a 1/4-mile, Class I-II rapid consisting of many 6-12\" ledges, finishing with three ledges of 2ft, 3ft, and a river-left 4ft drop. The usual line is river-left.\n\nThe American Canoe Association holds Whitewater Rescue Recertification courses during the Spring, when releases of 1,900 CFS, or 7.0 ft on the USGS gauge, are scheduled. (Consult the ODNR web page for release dates).\n\nAt that level and higher, Dillon Falls becomes a legitimate Class III. Levels of 9.50 feet on the USGS gauge translates into a flow of 5,000+ CFS. This occurs several times a year after periods of heavy rain. The three aforementioned ledges produce very powerful river-wide hydraulics and paddlers should exercise good judgment.","averageGradient":null,"maxGradient":null,"length":"4.4","correlations":[{"reachID":"1469","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":"230-375 cfs; Minimal levels. (Runnable, but tame.)","mediumRunnableRangeComment":"375-1900 cfs; Enjoyable levels.","highRunnableRangeComment":"1900-5000 cfs; High runnable flows","aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":"ItoII","highRunnableAdjustedDifficulty":"IItoIII","beginLowRunnable":"4","beginMediumRunnable":"4.4","beginHighRunnable":"7","endHighRunnable":"9.5"},"gaugeInfo":{"name":"Licking River bl Dillon Dam near Dillon Falls OH","gaugeSource":"USGS","gaugeSourceIdentifier":"03147500","gaugeFetchStatus":"ACTIVE","latestFlowReading":null,"latestStageReading":{"value":"4.13","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"39.98840049","longitude":"-82.0804166"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/03147500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/03147500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":"Previous Flowbands: \nHigh Runnable (R6-R9): 7 - 9.5 levelFT Adjusted Difficulty: IItoIII Comment: 1900-5000 cfs; High runnable flows\nMedium Runnable (R4-R6): 4.4 - 7 levelFT Adjusted Difficulty: II Comment: 375-1900 cfs; Enjoyable levels.\nLow Runnable (R0-R4): 4 - 4.4 levelFT Adjusted Difficulty: ItoII Comment: 230-375 cfs; Minimal levels. (Runnable, but tame.)\n\nMigration Errors: \nRecieved an adjusted reach that cannot be migrated","comment":null,"status":{"status":"low-runnable","latestReading":{"value":"4.13","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":"ItoII"}}],"pointOfInterestIDs":["109202","114442"],"geometry":{"type":"LineString","coordinates":[[-