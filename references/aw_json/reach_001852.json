,"caption":" on Green @01. Flaming Gorge to Lodore (CO)","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891924","large":"https://api.americanwhitewater.org/image/images/big/891924"}},{"id":"LyZgsTrqulXQDP4Nf2GU4","ext":"jpg","post_id":"vrMmzqyaZPd6x1FTDGcpB","description":null,"caption":"Green @Green - 01. Flaming Gorge to Lodore (CO) ","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":"2021-10-01T20:34:02.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/LyZgsTrqulXQDP4Nf2GU4","large":"https://api.americanwhitewater.org/image/images/big/LyZgsTrqulXQDP4Nf2GU4"}},{"id":"2rRRl3gx4e3GF8PUnttRG","ext":"jpg","post_id":"4eoJgX4d6mnjkiflziXoO","description":"","caption":"Spillway Boat Launch","poi_name":null,"subject":"","author":"Russ Kemp","poi_id":null,"photo_date":"2024-06-25T23:10:30.000Z","updated_at":"2024-06-25T23:10:30.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/2rRRl3gx4e3GF8PUnttRG","large":"https://api.americanwhitewater.org/image/images/big/2rRRl3gx4e3GF8PUnttRG"}}],"detail":{"id":"1852","permitUrl":null,"permitInfo":null,"description":"Known as the A, B, and C sections of the Green River this section can be run in parts as day floats or linked together as a casual multiday. Endowed with year-round water suply thanks to the up-river Flaming Gorge Resevoir, these sections can be busy when other rivers are no longer flowing. World class fishing is available throughout the run, along with spectacular bird watching, wildlife and canyon views. With few rapids of note and pleanty of camping, the ABCs are a great late-season fix for river junkies.\n\nFloat maps of the rivers sections are available in the gallery.\n\nThe Flaming Gorge Resort provides shuttles to the Flaming Gorge Dam put-in and pickups from Little Hole or Indian Crossing as well as raft and ducky rentals.  They can also provide transport to and from the airport.\n\nSection A has Class I and II rapids that are perfect for the duckys and takes about two hours to float.","averageGradient":null,"maxGradient":null,"length":"47.5","correlations":[{"reachID":"1852","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"200","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"5000"},"gaugeInfo":{"name":"GREEN RIVER NEAR GREENDALE, UT","gaugeSource":"USGS","gaugeSourceIdentifier":"09234500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"6760","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"13.35","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"40.90829296","longitude":"-109.422914"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/09234500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/09234500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"above-recommended","latestReading":{"value":"6760","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["110876","YF19TfuuCXWUIXU4ljbIV","Ls7u5AAuEVeyGkaHjSc8B","104634","QE8q9LsfttCpi3Qj0aHSU","wX0iCmk5Je6bb9X7CZrzq","116144"],"geometry":{"type":"LineString","coordinates":[[-109.422515,40.909039],[-109.422538,40.908733],[-109.422161,40.907895],[-109.420682,40.907254],[-109.418888,40.90707],[-109.41725,40.90719],[-109.415425,40.907324],[-109.414214,40.907166],[-109.411921,40.90639],[-109.410157,40.905922],[-109.408898,40.905834],[-