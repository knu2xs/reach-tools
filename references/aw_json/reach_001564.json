[{"result":{"data":{"json":{"id":"1564","stub":{"id":"1564","section":"3. Wamic-White River Bridge to Tygh Valley","altname":"Lower White, Canyon Run","river":"White","difficulty":"IItoIII","states":["USA-ORE"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"135","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Put-in at the bridge where White River Crossing Road crosses the river.","id":"109826","location":{"latitude":"45.159545","longitude":"-121.312563"},"name":"Wamic-White River Bridge Put-In","distance":"0.02","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"Take out where the Tygh Valley Road Bridge crosses the river.","id":"115078","location":{"latitude":"45.234718","longitude":"-121.160962"},"name":"Tygh Valley Take-Out","distance":"11.25","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"pdksmyt7-OFT7uro9hOYR","title":"Fires of 2020 impacted the White River drainage.","post_date":"2020-12-01 03:46:59+00","detail":"The upper reaches of this watershed burned in September 2020. This lower section is in a less-forested biome but still it will be impacted by the wood flushing downstream. Hopefully someone from the Bend area will get in here and let us know how it looks.","user":{"name":"Teresa Gryder"}}],"photos":[{"id":"881021","ext":"jpeg","post_id":"883494","description":"","caption":"somewhere in the last III+ sequence","poi_name":"","subject":"","author":"Brian Vogt","poi_id":null,"photo_date":"2012-07-09T14:59:30.000Z","updated_at":"2022-05-16T14:59:30.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/881021","large":"https://api.americanwhitewater.org/image/images/big/881021"}},{"id":"881020","ext":"jpeg","post_id":"883494","description":"","caption":"White River Wood","poi_name":"","subject":"","author":"Brian Vogt","poi_id":null,"photo_date":null,"updated_at":"2022-05-16T15:00:05.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/881020","large":"https://api.americanwhitewater.org/image/images/big/881020"}},{"id":"881019","ext":"jpeg","post_id":"883494","description":"The run is chock full of great ponderosa camping benches.","caption":"Liquid Lounge!","poi_name":"","subject":"","author":"Brian Vogt","poi_id":null,"photo_date":null,"updated_at":"2022-05-16T14:59:54.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/881019","large":"https://api.americanwhitewater.org/image/images/big/881019"}},{"id":"881018","ext":"jpeg","post_id":"883494","description":"Nick Borelli in the heart of the White River's gorge","caption":"White River Canyon","poi_name":"","subject":"","author":"Brian Vogt","poi_id":null,"photo_date":null,"updated_at":"2022-05-16T15:00:13.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/881018","large":"https://api.americanwhitewater.org/image/images/big/881018"}},{"id":"881026","ext":"jpeg","post_id":"883494","description":"This is the drop mentioned in the guidebooks as a IV that often collects wood.  It is just below a volcanic soil eroded wall on the right, a kinda of buff or dun color.  Only wall like that on the river.","caption":"The first IV","poi_name":null,"subject":null,"author":"Brian Vogt","poi_id":null,"photo_date":null,"updated_at":"2022-05-16T15:00:22.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/881026","large":"https://api.americanwhitewater.org/image/images/big/881026"}}],"detail":{"id":"1564","permitUrl":"","permitInfo":"","description":"This little-run section of river is one of the beauties of the Deschutes drainge.  Launching from Victor bridge it takes less than a mile to be in a lovely steep-walled canyon.  The whitewater is fast but easy in the top part which is good because I'm always gaping at the scenery.  There is one rapid (we call it landslide) that feels class IVish and below there several good class III's before the end.  There is always a fair bit of wood in this section and after the fires of 2020 the wood situation will probably get worse.\n\nThere are some lovely campsites alongside this section, and an overnighter can be delightful.\n\nThe shuttle can be run on either side of the river.  The river left shuttle is more paved and direct.\n\n[Description and photos](http://www.oregonkayaking.net/rivers/whitelower/whitelower.html) at Oregon Kayaking.","averageGradient":null,"maxGradient":null,"length":"11.3","correlations":[{"reachID":"1564","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"400","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"2000"},"gaugeInfo":{"name":"WHITE RIVER BELOW TYGH VALLEY, OR","gaugeSource":"USGS","gaugeSourceIdentifier":"14101500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"135","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.69","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"45.241722","longitude":"-121.095139"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/14101500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/14101500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"135","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["109826","115078"],"geometry":{"type":"LineString","coordinates":[[-121.312279,45.15931],[-121.31