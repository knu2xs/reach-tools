[{"result":{"data":{"json":{"id":"343","stub":{"id":"343","section":"4. Washington to Edwards Crossing","altname":"","river":"Yuba, South","difficulty":"IV","states":["USA-CAL"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"698","dateTime":"2026-05-12T01:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"110017","location":{"latitude":"39.3608","longitude":"-120.794"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"portage","description":"The portage is about one quarter mile below Humbug Creek, which enters on river right. Portage over the granite slabs on river left.","id":"100881","location":{"latitude":"39.33541142","longitude":"-120.94184345"},"name":"Waterfall Portage","distance":"10.08","photoID":"MGeAFwhABNETtXVuYPGmZ","difficulty":"VI","approximate":true},{"type":"rapid","description":"**At 1000 CFS**  \nWe entered center or center-left, then moved right. There are two whirlpools to dodge in this section. Going too far right risks getting flipped by a pour-over or pulled into a whirlpool. Too far left, and you might end up in another whirlpool that has an underwater channel connecting to the next eddy downstream.\n\nWe were able to scout the rapid from the right bank a bit upstream. The portage on the left bank is also doable, though it’s a bit sketchy.","id":"iEOQFfB5ITea6f2vaPhW9","location":{"latitude":"39.33563512","longitude":"-120.94221438"},"name":"Whirlpools","distance":"10.1","difficulty":"IV+","approximate":false,"photoID":"rjyOWqHuP0UFwuOdEgPAh"},{"type":"takeout","description":"The take out is just before the bridge at Edwards. There is a small pool for a few kayaks in the willows. It is a bit hard to see.","id":"115273","location":{"latitude":"39.3307","longitude":"-120.982"},"name":"Take Out","distance":"14","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"rjyOWqHuP0UFwuOdEgPAh","ext":"jpg","post_id":"P09Pq7B9pY7339NMHmN9w","description":"<p>Dropping in at Whirlpools.</p>","caption":"Dropping in at Whirlpools","poi_name":null,"subject":"Dropping in at Whirlpools","author":"Leo Qiu","poi_id":"iEOQFfB5ITea6f2vaPhW9","photo_date":"2025-06-08T15:28:58.000Z","updated_at":"2025-06-08T15:28:59.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/rjyOWqHuP0UFwuOdEgPAh","large":"https://api.americanwhitewater.org/image/images/big/rjyOWqHuP0UFwuOdEgPAh"}},{"id":"84A3dpg8ZguJTokL6ml1W","ext":"jpg","post_id":"ZoxH33x6fb5rGcLCrDYL3","description":"Avoid the hole mid-rapid on the right and the whirlpool eddy immediately after on river left. Enter left, exit right. ","caption":"Whirlpool Rapid ","poi_name":null,"subject":"Avoid the hole on the right","author":"Michael","poi_id":null,"photo_date":"2024-05-14T06:23:40.000Z","updated_at":"2024-05-14T06:23:40.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/84A3dpg8ZguJTokL6ml1W","large":"https://api.americanwhitewater.org/image/images/big/84A3dpg8ZguJTokL6ml1W"}},{"id":"r4opArM2gIquopYnmpsgr","ext":"jpg","post_id":"P09Pq7B9pY7339NMHmN9w","description":"","caption":"Gorges","poi_name":null,"subject":"","author":"Leo Qiu","poi_id":null,"photo_date":"2025-06-08T15:28:58.000Z","updated_at":"2025-06-08T15:28:59.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/r4opArM2gIquopYnmpsgr","large":"https://api.americanwhitewater.org/image/images/big/r4opArM2gIquopYnmpsgr"}},{"id":"878444","ext":"jpeg","post_id":"878860","description":"","caption":"","poi_name":"","subject":"","author":"Dave Steindorf","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/878444","large":"https://api.americanwhitewater.org/image/images/big/878444"}},{"id":"MGeAFwhABNETtXVuYPGmZ","ext":"jpg","post_id":"3eNr2AWHxxjvQwRq0Ecy2","description":"","caption":"","poi_name":null,"subject":"","author":"Michael","poi_id":"100881","photo_date":"2023-06-20T03:17:25.000Z","updated_at":"2024-05-14T03:17:25.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/MGeAFwhABNETtXVuYPGmZ","large":"https://api.americanwhitewater.org/image/images/big/MGeAFwhABNETtXVuYPGmZ"}}],"detail":{"id":"343","permitUrl":"","permitInfo":"","description":"Washington to Edwards is a Class IV run that is 14 miles long and passes through a forested river canyon. Once outside of the small town of Washington, there are few houses and no public road access. There is a trail that parallels the run high on river right. Due to the length and remote location of the run, it is generally considered to be more advanced than Edwards to Purdons, although the rapids may be a little easier. **There is one portage.**\n\nIn general, the river is fairly wide and the rapids may be boat scouted. The run starts off with a bang (III/IV-). After 2 miles it eases off till mile 9, though there are plenty of horizon lines to be engaging. The rapids get steeper in the middle third and culminate in a portage at mile 10.5. The portage is about one quarter mile below Humbug Creek. Humbug Creek (could be dry) enters on river right and is very muddy if it has been raining and the river is high. Portage over the granite slabs on river left. This is a nice place to have lunch and debate the merits of potential lines through the rapid.\n\nWhile you are on shore, you can scout the next series of rapids. Just downriver from the portage is a rapid with a small chute on river left. It may be scouted from a funky little eddy on river right (or from high on the bank on the left during a lunchtime hike/portage). At low flows, the eddy just downstream of the chute is a bad place to swim. An underwater channel connects it to the next eddy downstream. Weaker paddlers having a 'bad day' will want to exercise care in this region. At higher flows, the nasty eddy washes out and is not as much of a problem.\n\nOverall, the rapids are small, but fun with lots of waves and holes for entertainment.\n\n**Shuttle:** The shuttle is long (45 minutes each way), but entirely on pavement. To get to the take out (Edwards), take Highway 49 north from Nevada City. Go 0.3 miles past the split with Highway 20 and turn right at the fire station onto North Bloomfield Road. Follow North Bloomfield 0.6 miles to a 'T' intersection. Turn right at the 'T' and go about 6 miles down to the river. Park on the right before you cross the bridge and locate the small trail in the bushes that goes down to the river. If you just 'have to' run the rapid under the bridge at the end of the day, you can also take out on river right below the bridge.\n\nTo get to the put in (Washington), drive back out the way you came and turn left on Highway 49. Turn left (east) on Highway 20 and follow it 13 miles to Washington Road. Turn left on Washington Road and follow it 6 miles down to the town of Washington. Go through the town to the river. Park off the road and put in under the bridge.\n\nWhen driving through Washington, the speed limit is **15 mph**. Please respect this limit, as there has already been some tension due to people speeding through the narrow streets. Let’s help maintain a good relationship with the community by driving slowly and considerately.\n\n**Local Info:** The South Yuba River received Wild and Scenic status January 2001. This was due to the outstanding efforts of [SYRCL](http://www.syrcl.org), the local river conservation group. Their site has nice photos of the South Yuba and information on local river issues. Become a member and you'll get praise from the river gods.\n\n**Camping/Motels:** Local camping is limited. If you stay on someone's land without permission, you may get shot. The South Yuba Campground is near the take out, but is only officially open during the summer. To get there from Edwards, cross the bridge and go north on the dirt road about 1 mile, then follow North Bloomfield Road toward the right. The campground is a half mile down the road. There are a number of motels in the Nevada City/Grass Valley area. [The Outside Inn](http://www.outsideinn.com) is nice, relatively inexpensive (for Nevada City) and has some kitchen units. There are restaurants within walking distance and it caters to mountain bikers and other atheletes.\n\n**California Boating Bible:** Lars Holbek and Chuck Stanley; 'The Best Whitewater in California'\n\n**Other California Boating Sites:** [Dream Flows](http://www.dreamflows.com), [Sierra Whitewater](http://www.boof.com), [California Creekin](http://creekin.net)","averageGradient":"46","maxGradient":null,"length":"13.6","correlations":[{"reachID":"343","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"300","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"2500"},"gaugeInfo":{"name":"YUBA RIVER AT JONES BAR","gaugeSource":"CDEC","gaugeSourceIdentifier":"JBR","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"698","dateTime":"2026-05-12T01:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"5.58","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"39.292","longitude":"-121.104"},"externalSourceLinks":{"sourceLink":{"url":"https://cdec.water.ca.gov/dynamicapp/QueryF?s=JBR","text":"California Data Exchange - Station Log"},"secondaryLink":{"url":"https://cdec.water.ca.gov/cdecplotter/JspPlotAll?staid_id=JBR","text":"California Data Exchange - Data Plot"}}},"migrationErrorExplanation":"Previous Flowbands: \nRange of Boatable Flows (R0-R9): 500 - 2500 cfs  Comment: \nRange of Boatable Flows (R0-R9): 300 - 2500 cfs  Comment: \n\nMigration Errors: \nDiffe