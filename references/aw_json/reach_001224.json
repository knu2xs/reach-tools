[{"result":{"data":{"json":{"id":"1224","stub":{"id":"1224","section":"03. Chiflo Campground to Little Arsenic Trail","altname":"Upper Taos Box","river":"Rio Grande","difficulty":"V","states":["USA-NME"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"100","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"The hike is what is rated class IV, a 350 foot descent down Chiflo Trail. The whitewater is going to be mostly pools with scattered Class III for the next 1.5 miles.","id":"1358","location":{"latitude":"36.74148868","longitude":"-105.68042705"},"name":"Chiflo Trail Put-in","distance":"0.06","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":"The first major rapid, directly under the powerlines spanning the gorge.","id":"1359","location":{"latitude":"0","longitude":"0"},"name":"Powerline Rapid","distance":"1.5","difficulty":"IV+","approximate":false,"photoID":null},{"type":"hazard","description":"A steep entrance drop that pushes left, into multiple sieves, in the runout. It is possible to set safety to prevent someone from getting stuffed.","id":"1360","location":{"latitude":"0","longitude":"0"},"name":"NCO","distance":"2","photoID":"7100","difficulty":"V","approximate":false},{"type":"hazard","description":"A large ledge with a large undercut rock center right, and the main current pushing hard left into a mean sieve. Safety is very difficult to set.","id":"1361","location":{"latitude":"0","longitude":"0"},"name":"Hell Hole","distance":"2.25","photoID":"7097","difficulty":"V+","approximate":false},{"type":"rapid","description":"Long and technical boulder dodging, sieves but not as bad as the previous rapids.","id":"1362","location":{"latitude":"0","longitude":"0"},"name":"Long Rapid","distance":"2.5","difficulty":"V","approximate":false,"photoID":null},{"type":"rapid","description":"Highly fun boofs to be had in the center and right channel.","id":"1364","location":{"latitude":"0","longitude":"0"},"name":"Pleasure Plunge","distance":"3.5","difficulty":"IV+","approximate":false,"photoID":"7101"},{"type":"rapid","description":"Long stretch of placid river","id":"1365","location":{"latitude":"0","longitude":"0"},"name":"The Great Calm","distance":"4","difficulty":"I","approximate":false,"photoID":null},{"type":"rapid","description":"Long and technical boulder dodging, keep an eye out for those sieves!","id":"1363","location":{"latitude":"0","longitude":"0"},"name":"Boulder Fan Rapid","distance":"4.5","difficulty":"V","approximate":false,"photoID":null},{"type":"rapid","description":"Big wave train leading into a large hole, boof hole on left side.","id":"1897","location":{"latitude":"0","longitude":"0"},"name":"Freight Train","distance":"4.8","difficulty":"IV+","approximate":false,"photoID":null},{"type":"hazard","description":"Sieves, mank, and steepness. Mandatory scout","id":"1366","location":{"latitude":"0","longitude":"0"},"name":"Big Arsenic Rapid","distance":"5","photoID":null,"difficulty":"V+","approximate":false},{"type":"hazard","description":"Long and technical boulder dodging with an abundance of sieves.","id":"1367","location":{"latitude":"0","longitude":"0"},"name":"Little Arsenic Rapid","distance":"5.5","photoID":"7099","difficulty":"V","approximate":false},{"type":"hazard","description":"Long and technical boulder dodge rapid, with the infamous \"Room of Doom\" seive.","id":"1368","location":{"latitude":"0","longitude":"0"},"name":"Little Arsenic Rapid Junior","distance":"5.75","photoID":"7102","difficulty":"V","approximate":false},{"type":"takeout","description":"The takeout for Little Arsenic Trail is notoriously ambiguous. The whitewater will obviously mellow out, look for the trail on river left, takeout about a 1/4 mile after when the trail climbs up and on top of a bench and is no longer next to the river. I look for a large dead tree with the top broken off, it's probably about 40' tall, it has been dead for a while and has no bark. The hike to the rim is 750 foot up in .8 miles and will take about 45 minutes. Your only other option is to paddle 9 miles of Class I. The pain is unavoidable.","id":"1369","location":{"latitude":"36.66573369","longitude":"-105.68068734"},"name":"Little Arsenic Trail Take-out","distance":"6.32","photoID":null,"difficulty":"III","approximate":false}],"alerts":[],"photos":[{"id":"878328","ext":"jpeg","post_id":"878722","description":"","caption":"January Box","poi_name":"","subject":"Ted Werre","author":"Lee Timmons","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/878328","large":"https://api.americanwhitewater.org/image/images/big/878328"}},{"id":"886420","ext":"jpeg","post_id":"889198","description":"Kayaker: Pablo\r\nFlow: 670 cfs","caption":"Hell Hole","poi_name":null,"subject":null,"author":"Kaelan Hendrickson","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/886420","large":"https://api.americanwhitewater.org/image/images/big/886420"}},{"id":"7100","ext":"jpeg","post_id":"3192","description":"","caption":"NCO Brian","poi_name":"NCO","subject":"Brian Adkins","author":"Craig Cardella","poi_id":"1360","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/7100","large":"https://api.americanwhitewater.org/image/images/big/7100"}},{"id":"7099","ext":"jpeg","post_id":"3190","description":"Hard to tell, but the bottom 3/4 of this rapid sieves out.  The only line is a small spout on the right.","caption":"Little Arsenic Rapid","poi_name":"Little Arsenic Rapid","subject":"","author":"Craig Cardella","poi_id":"1368","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/7099","large":"https://api.americanwhitewater.org/image/images/big/7099"}},{"id":"7102","ext":"jpeg","post_id":"3191","description":"This is one small part of the maze of sieves on the river left side of Little Arsenic Junior","caption":"Room of Doom","poi_name":"Little Arsenic Rapid Junior","subject":"Natural Born Killer","author":"Craig Cardella","poi_id":"1368","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/7102","large":"https://api.americanwhitewater.org/image/images/big/7102"}},{"id":"7101","ext":"jpeg","post_id":"3192","description":"Last drop before the great calm","caption":"Pleasure Plunge","poi_name":"Pleasure Plunge","subject":"Max Sullivan","author":"Craig Cardella","poi_id":"1363","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/7101","large":"https://api.americanwhitewater.org/image/images/big/7101"}},{"id":"7098","ext":"jpeg","post_id":"3193","description":"Current pushes hard into this sieve, I have been told that a Wavesport Lazer went into this and has never come out.","caption":"Hell Hole Sieve","poi_name":"Hell Hole","subject":"Natural Born Killer","author":"Craig Cardella","poi_id":"1361","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/7098","large":"https://api.americanwhitewater.org/image/images/big/7098"}},{"id":"7097","ext":"jpeg","post_id":"3193","description":"Not the preferred line!  A little farther river left would have been better.","caption":"Hell Hole","poi_name":"Hell Hole","subject":"Brian Adkins","author":"Craig Cardella","poi_id":"1361","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/7097","large":"https://api.americanwhitewater.org/image/images/big/7097"}},{"id":"7096","ext":"jpeg","post_id":"3193","description":"This is the crux move of NCO, you want to stay right and be in control, the current pushes hard left into multiple sieves.","caption":"NCO","poi_name":"NCO","subject":"Jered Johnson","author":"Craig Cardella","poi_id":"1360","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/7096","large":"https://api.americanwhitewater.org/image/images/big/7096"}}],"detail":{"id":"1224","permitUrl":null,"permitInfo":null,"description":"This is truly one of the classic runs in the west. The Taos Box is actually where the Rio Grande has fallen into one of the largest rifts on earth. The entire Taos Box is almost 100 miles long. The Upper Box refers to the 6 mile Class V run from the Chiflo Trail to the Little Arsenic Trail. There is no access at all in between these two points so make sure to bring spare paddles and rescue gear as a hike out in the middle is not an option.\n\nThe one major thing you have to watch out for on this run are the sieves, they are **everywhere**! Some are much worse than others. Don't be fooled by the gradient. This river is the definition of pool-drop and doesn't waste any of its' gradient on easy rapids in between the big rapids. In general the rapids are long technical boulder gardens with lots of sieves. The riverbed is composed of large angular basalt rocks that have fallen from the cliffs above. Keep in mind that this is **not** Gore Canyon, keep the playboat at home! In fact, this run is always a good solid grade higher in difficulty that Gore at similar levels. The 3 mandatory scouts are NCO, Hell Hole, and Big Arsenic. These rapids have big drops at the entrance, and currents that push hard into sieves below. Swimming is **not** recommended! Fortunately there is ample opportunity to scout and portage as the cliffs are located high up on the rim, not at river level.\n\nFor many the run is defined by the takeout. You have 2 less than appealing options. You can float out on 9 miles of flat water, or take a 45 minute hike to the rim at Little Arsenic Trail. Although the Little Arsenic takeout is by far preferred, it does climb 750 feet up in .8 miles. The best camping is at the end of the takeout trail.\n\nThe reaches of the Taos Box area are...\n\n[Ute Mountain](http://www.americanwhitewater.org/rivers/id/1222/) (Class II),\n\n[Razors](http://www.americanwhitewater.org/rivers/id/1223/) (Class III/IV),\n\n[Upper Box](http://www.americanwhitewater.org/rivers/id/1224/) (Class V/V+),\n\n[Lower Box](http://www.americanwhitewater.org/rivers/id/1227/) (Class III/IV),\n\n[Pilar](http://www.americanwhitewater.org/rivers/id/1228/) (Class III/IV),\n\n[Otowi Bridge](http://www.americanwhitewater.org/rivers/id/1225/) (Class III),\n\n[Red River](http://www.americanwhitewater.org/rivers/id/3594/) (Class IV),\n\n[Rio Pueblo](http://www.americanwhitewater.org/rivers/id/3598/) (Class V+), and\n\n[Rio Embudo](http://www.americanwhitewater.org/rivers/id/3592/) (Class V+).","averageGradient":"69","maxGradient":null,"length":"7.8","correlations":[{"reachID":"1224","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"300","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"3000"},"gaugeInfo":{"name":"RIO GRANDE NEAR CERRO, NM","gaugeSource":"USGS","gaugeSourceIdentifier":"08263500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"100","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.75","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"36.74001667","longitude":"-105.6834417"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/08263500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/08263500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"100","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["1358","1359","1360","1361","1362","1364","1365","1363","1897","1366","1367","1368","1369"],"geometry":{"type":"LineString","coordinates":[[-105.682251,36.74307],[-105.682324,36.742981],[-105.682441,36.742828],[-105.68248,36.742764],[-105.682524,36.742663],[-105.682597,36.742422],[-105.682666,36.742252],[-105.682701,36.742186],[-105.68276,36.742091],[-105.682775,36.742058],[-105.682851,36.741854],[-105.68292,36.741611],[-105.682963,36.741437],[-105.683037,36.741194],[-105.68317,36.740856],[-105.683228,36.74076],[-105.683364,36.740576],[-105.683425,36.740524],[-105.68348,36.740468],[-105.683537,36.740376],[-105.683545,36.740341],[-105.683621,36.740133],[-105.683671,36.740034],[-105.683691,36.740002],[-105.68372,36.739935],[-105.683774,36.739762],[-105.683833,36.739591],[-105.683849,36.739558],[-105.683917,36.739448],[-105.683951,36.739383],[-105.684038,36.739258],[-105.684089,36.7392],[-105.684147,36.739146],[-105.684168,36.739114],[-105.684282,36.738921],[-105.684383,36.738762],[-105.684411,36.738734],[-105.684505,36.738657],[-105.68454,36.738635],[-105.684565,36.738605],[-105.684603,36.738541],[-105.684626,36.738473],[-105.684628,36.738437],[-105.684648,36.738332],[-105.684666,36.738262],[-105.684713,36.738162],[-105.684834,36.737972],[-105.685021,36.737729],[-105.685204,36.737403],[-105.685439,36.73702],[-105.685483,36.736958],[-105.685602,36.736807],[-105.68562,36.736775],[-105.685657,36.736636],[-105.685673,36.736566],[-105.685773,36.736257],[-105.685819,36.735939],[-105.685821,36.735903],[-105.685813,36.735726],[-105.685788,36.735442],[-105.68575,36.735159],[-105.685696,36.734663],[-105.685691,36.734592],[-105.685681,36.734521],[-105.685667,36.734451],[-105.685602,36.734207],[-105.685541,36.733962],[-105.685488,36.733671],[-105.685435,36.733353],[-105.685428