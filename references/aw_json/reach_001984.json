[{"result":{"data":{"json":{"id":"1984","stub":{"id":"1984","section":"1.) The \"Big Piney\" (Alhambra to VA. 827 ['Perkins Mill Rd'] Woodson)","altname":"","river":"Piney River (Nelson County)","difficulty":"IIItoIV","states":["USA-VRG"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"39","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Put-in - Drive around 4 miles upstream from the take-out. You can park at the National Forest sign. We somtimes like to go slightly higher up and put in at the base of Shotgun rapid, which is the final big rapid on the class 5 South Fork section. Putting in just below shotgun rapid makes a 4.57 mile run.","id":"110683","location":{"latitude":"37.78649","longitude":"-79.104261"},"name":"Put In - US Forest Service sign above Alhambra, VA","distance":"0","photoID":"b1OZ4hdxacLrlehR7AWys","difficulty":"N/A","approximate":false},{"type":"rapid","description":"Corner Rapid is the most distinct rapid on the run. This picturesque drop is recognizable by the little creek coming in from river left adjacent to the rapid. It comes after passing under the Alhambra bridge, and a few houses on the riverbank. Grab the little eddy on the left just past the waterfall flowing into the river, then run the meat of the rapid down river left.","id":"298F8oVkllQB6Y50h9Ubx","location":{"latitude":"37.788006","longitude":"-79.08971088"},"name":"Corner Rapid","distance":"0.94","difficulty":"IV","approximate":false,"photoID":"873246"},{"type":"other","description":"The first of the two low water bridges. get out on the right and take a look. Can usually run on the right if the level is reasonable. Avoid the nasty culvert in the middle.","id":"qs42WByru0NA9LlhbkyOV","location":{"latitude":"37.78534708","longitude":"-79.08504873"},"name":"first low water bridge","distance":"1.3","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":"\"Bridge\" rapid is the \"last bigger rapid,\" according to Ethan Harris. In the photo of Ethan, the level is around zero on the take-out bridge gauge. Grab a couple of eddys as you make your way to a river left eddy just above the final chute on the left. Watch out for the hole along the right wall in the runout.","id":"vSAUvMzvlFKV2RZmD8rB2","location":{"latitude":"37.77849332","longitude":"-79.07295076"},"name":"Bridge Rapid","distance":"2.56","difficulty":"IV-","approximate":false,"photoID":"873248"},{"type":"takeout","description":"","id":"115953","location":{"latitude":"37.767753","longitude":"-79.068782"},"name":"Take Out - VA. 827 ('Perkins Mill Rd')","distance":"3.54","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"101253606","title":null,"post_date":"2018-05-23 04:00:00+00","detail":"As of 5/22/2018 we were able to paddle this section without portages. There was wood after each of the two low-water bridges, but both were passable.","user":{"name":"Gordon Dalton"}}],"photos":[{"id":"40298","ext":"jpeg","post_id":"3134","description":"","caption":"Upper Piney","poi_name":"","subject":"Wendy Dalton","author":"Gordon Dalton","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/40298","large":"https://api.americanwhitewater.org/image/images/big/40298"}},{"id":"873248","ext":"jpeg","post_id":"873249","description":"<p>This is the last bigger rapid (Bridge). It comes just after going under a bridge. Level was 0 on the bridge. Minimum flow.</p>","caption":"Bridge rapid - Ethan","poi_name":null,"subject":"Ethan Harris","author":"","poi_id":"vSAUvMzvlFKV2RZmD8rB2","photo_date":"2009-04-04T13:52:26.000Z","updated_at":"2025-12-29T13:52:27.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/873248","large":"https://api.americanwhitewater.org/image/images/big/873248"}},{"id":"873246","ext":"jpeg","post_id":"873247","description":"<p>This is the 1st bigger rapid (Corner). You can recognize it by the beautiful waterfall coming in just above the drop on river left. Level was 0 on the bridge...minimum flow.</p>\n","caption":"Corner Rapid - Ethan","poi_name":null,"subject":"Ethan Harris","author":"","poi_id":"298F8oVkllQB6Y50h9Ubx","photo_date":"2008-05-15T01:39:40.000Z","updated_at":"2025-11-03T01:39:40.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/873246","large":"https://api.americanwhitewater.org/image/images/big/873246"}},{"id":"b1OZ4hdxacLrlehR7AWys","ext":"jpg","post_id":"96ZEE9965Kv3NQo3M8Rf5","description":"Gordon, Harris, and friends at the Forest Service access, Piney River, VA.","caption":"U.S. National Forest Sign, Big Piney River, VA","poi_name":null,"subject":"Boaters gather for a run on a section of the Piney River, VA","author":"Gordon Dalton","poi_id":"110683","photo_date":"2025-07-06T21:11:22.000Z","updated_at":"2025-07-06T21:11:23.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/b1OZ4hdxacLrlehR7AWys","large":"https://api.americanwhitewater.org/image/images/big/b1OZ4hdxacLrlehR7AWys"}}],"detail":{"id":"1984","permitUrl":"","permitInfo":"","description":"**'The Big Piney:'** This gem of a whitewater stream is the uppermost section of the Piney River, below the confluence of its North and South forks. Big Piney could very well be one of Virginia's nicest whitewater rivers. Cold, clear mountain water tumbles down a narrow, steep, valley shaded by tall pines and hemlocks. The whitewater is conistent technical class III+ to IV- boulder garden. The heavily wooded scenery is interrupted only by a few scattered homes along the river, even though the run is almost entirely roadside. The consistent mid-grade whitewater, cool vibe, and roadside access make the Big Piney a great introduction to light 'creeking' / technical river running for intermediate paddlers with precautions taken for possible wood in the riverbed and the low-water bridges described below.\n\n*'There ain't no cold like the Big Piney river. Hottest day of summer it'll still make you shiver.' -* lyrics from 'Cannonball,' on Nelson County singer/songwriter, Byron Massie's album 'I still Think Of You.'\n\n**Warnings:** There are several low-water bridges in this stretch that form lethal hydraulics or hazards at high water! Take care around the low-water bridges at all levels. At least one has dangerous culvert pipes *under* the bridge that have trapped at least one boater, resulting in a close call and a lost boat. Scout these bridges on your shuttle ride upriver. With appropriate precautions these bridges don't really interrupt the flow of a paddling trip down this wonderful stream.\n\nThis river section has a history of landowner/visitor conflicts going back to the 1980's. Shots have been fired. Currently everyone is getting along fine, so let's keep it that way. Please be respectful, quiet, and discrete as possible when in this area. Drive slowly and stay off of people's land. Please don't change clothes in public. Let's not give anyone reason to be hostile toward boaters. Put-in within the National Forest. Take-out below the bridge near Woodson.\n\n**Shuttle:** *Take-out:* Park about 75 yards downstream of the intersection of Rte. 666 ('Woodson Rd' or 'Dickie Rd') and Rte. 827 ('Perkins Mill Rd'). There is a small grass pull-in spot on the south side of the road beside the river. Please be discreet, clean, quiet, and respectful of the people who live nearby.\n\n*\\*\\*There aren't many eddies near the take-out so most folks eddy-out on the river-right above the bridge and climb over the guardrail, then walk downstream to the parking area.\\*\\* Respect No Trespassing signs at all times.*\n\n*Put-in*: Drive around 4 miles upstream from the take-out. You can park at the large U.S. National Forest sign in the pullout across the road from the river. Another option is to continue driving upriver as far as you'd like but you will then be venturing into the steeper and more difficult [South Fork Piney ](content/River/view/river-detail/3884/main)section.","averageGradient":"130","maxGradient":"260","length":"3.5","correlations":[{"reachID":"1984","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":"400 to 500 is a good guide to minimum flow. ","mediumRunnableRangeComment":null,"highRunnableRangeComment":"The upper range of flow will, of course, vary depending on individual groups' skill level and disposition","aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"400","beginMediumRunnable":"600","beginHighRunnable":"1300","endHighRunnable":"2500"},"gaugeInfo":{"name":"PINEY RIVER AT PINEY RIVER, VA","gaugeSource":"USGS","gaugeSourceIdentifier":"02027500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"39","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"2.46","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"37.7023625","longitude":"-79.0275254"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/02027500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/02027500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":" Look for at least 400-450 or more for minimum flow in the Big Piney. This correlates to somewhere around 0-1' on the gauge painted on the takeout bridge. The upper limit of flow will vary by individual skill level.","status":{"status":"below-recommended","latestReading":{"value":"39","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["110683","298F8oVkllQB6Y50h9Ubx","qs42WByru0NA9LlhbkyOV","vSAUvMzvlFKV2RZmD8rB2","115953"],"geometry":{"type":"LineString