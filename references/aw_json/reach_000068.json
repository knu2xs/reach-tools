[{"result":{"data":{"json":{"id":"68","stub":{"id":"68","section":"3. Eberhart Point (Chairlift) to Canyon Mouth Campground","altname":"Chairlift","river":"Little","difficulty":"IItoIIIplusstandoutIV","states":["USA-ALB"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"248","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"111245","location":{"latitude":"34.358","longitude":"-85.669"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":"Ledge rapid. Usually run by skirting the hole on the right.","id":"1004","location":{"latitude":"0","longitude":"0"},"name":"Bottleneck","distance":"2","difficulty":"IV","approximate":false,"photoID":"3402"},{"type":"takeout","description":null,"id":"116515","location":{"latitude":"34.293","longitude":"-85.692"},"name":"Take Out","distance":"6","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"101251472","title":null,"post_date":"2015-01-17 05:00:00+00","detail":"Reports are coming in that USGS has corrected the previous issue with the gauge reading low. Apparently the reading is now accurate.","user":{"name":"David Bazemore"}},{"id":"101251461","title":null,"post_date":"2015-01-04 05:00:00+00","detail":"A change has been made to the gauge. As of now if the gauge is showing around 400 cfs it will be more similar to the 800 - 900 cfs range. I am not certain how the changes to the physical gauge will alter all the other levels. More info from other paddlers at various levels would be appreciated.","user":{"name":"David Bazemore"}}],"photos":[{"id":"5995","ext":"jpeg","post_id":"5655","description":"Sometimes when you run a good line, you should just paddle down river. This paddler was so pleased with himself, he decided to do it again. The river gods weren't as generous the second time around.","caption":"(RM) Bottle Neck - A Good Line","poi_name":"Bottle Neck","subject":"","author":"Rob Maxwell","poi_id":"1004","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5995","large":"https://api.americanwhitewater.org/image/images/big/5995"}},{"id":"3103","ext":"jpeg","post_id":"3520","description":"","caption":"Looking back at Bottleneck","poi_name":"Bottleneck","subject":"Bottleneck","author":"C. McLoughlin","poi_id":"1004","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3103","large":"https://api.americanwhitewater.org/image/images/big/3103"}},{"id":"3102","ext":"jpeg","post_id":"3520","description":"Tim made this rapid look easy by catching all the eddies","caption":"Bottleneck","poi_name":"Bottleneck","subject":"Tim","author":"C. McLoughlin","poi_id":"1004","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3102","large":"https://api.americanwhitewater.org/image/images/big/3102"}},{"id":"1987","ext":"jpeg","post_id":"4223","description":"","caption":"Bottleneck at 700 cfs","poi_name":"Bottleneck","subject":"None","author":"Mike Stephenson","poi_id":"1004","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1987","large":"https://api.americanwhitewater.org/image/images/big/1987"}},{"id":"3402","ext":"jpeg","post_id":"4224","description":"Not the best line, but a good pic.","caption":"Chad at Bottleneck","poi_name":"Bottleneck","subject":"Chad Spangler","author":"Mike Stephenson","poi_id":"1004","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3402","large":"https://api.americanwhitewater.org/image/images/big/3402"}},{"id":"2840","ext":"jpeg","post_id":"4962","description":"","caption":"Blue Hole Memorial","poi_name":"Blue Hole Memorial","subject":"Will Reeves","author":"Ed Ditto","poi_id":"1004","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/2840","large":"https://api.americanwhitewater.org/image/images/big/2840"}},{"id":"2839","ext":"jpeg","post_id":"4962","description":"","caption":"Eddyhop","poi_name":"Bottle Neck","subject":"Will Reeves","author":"Ed Ditto","poi_id":"1004","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/2839","large":"https://api.americanwhitewater.org/image/images/big/2839"}},{"id":"5253","ext":"jpeg","post_id":"6224","description":"","caption":"Chris @ Bottleneck","poi_name":"Bottleneck","subject":"Chris Winslett","author":"Tony D.","poi_id":"1004","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5253","large":"https://api.americanwhitewater.org/image/images/big/5253"}},{"id":"877870","ext":"jpeg","post_id":"878185","description":"Good picture of the crux of eddy hop.  Main line is to go to the right of the big rock in the center left (optional eddy with green boat) then down the center (orange boat).\r\n\r\nNote:  Do not run on the left side of picture.  It can go into an undercut.  ","caption":"Crux of Eddy Hop","poi_name":"Eddy Hop","subject":"Garth Brown & Dane White","author":"Chuck Kirk","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/877870","large":"https://api.americanwhitewater.org/image/images/big/877870"}},{"id":"13443","ext":"jpeg","post_id":"4963","description":"","caption":"Eddy Hopp","poi_name":"Eddy Hopp","subject":"Will Reeves","author":"Ed Ditto","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/13443","large":"https://api.americanwhitewater.org/image/images/big/13443"}},{"id":"10215","ext":"jpeg","post_id":"5755","description":"","caption":"Gary at Bottleneck","poi_name":"Bottleneck","subject":"Gary Lambert","author":"Stu Thompson","poi_id":"1004","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10215","large":"https://api.americanwhitewater.org/image/images/big/10215"}},{"id":"10213","ext":"jpeg","post_id":"5755","description":"","caption":"Ted at Bottleneck","poi_name":"Bottleneck","subject":"Ted Jean","author":"Stu Thompson","poi_id":"1004","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10213","large":"https://api.americanwhitewater.org/image/images/big/10213"}},{"id":"10214","ext":"jpeg","post_id":"5755","description":"","caption":"Carnage at Bottleneck","poi_name":"Bottleneck","subject":"I'll never tell","author":"Stu Thompson","poi_id":"1004","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10214","large":"https://api.americanwhitewater.org/image/images/big/10214"}},{"id":"9189","ext":"jpeg","post_id":"6806","description":"This is a shot of Bottleneck looking downstream.  There are some approach rapids you can't see from this shot","caption":"Bottleneck","poi_name":"Bottleneck","subject":"Bottleneck looking downstream","author":"James Graham","poi_id":"1004","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/9189","large":"https://api.americanwhitewater.org/image/images/big/9189"}}],"detail":{"id":"68","permitUrl":"","permitInfo":"","description":"It is being reported that USGS has corrected the gauge issue and the gauge now is accurate.\n\na Class III run, with two (2) class IV. Most rapids are straight ahead. Both Class IV can be portaged on river right. The first, Blue Hole Memorial, is just after the second big bend to the left. Scout on right. This rapid is followed by a 150 yd continuous wave train. At the bottom of the wave train is a large hole, but not a keeper. The next is the Alabama classic Bottleneck.This beautiful rapid would be right at home nestled in the Suicide section ,but is somehow stuck all alone way down here. Water on the far right side of the river flows into a pool, from which you can scout the main drop. Thinking about running this one, catch the first big eddy on the right, just after some water has gone far right. From here on the rapids are fast and straight. Everything is runnable and there are only a few places that are shallow. This section is a move up from the Locust Fork, or Nantahala River, particularly the two Class IV's and the long wave train.\n\nTo get to the take out, take Hwy 35 from Interstate 59 east to AL hwy 273. Go south (turn right) until you cross Little River. The next hard top road to the right, approximately 1/4 mile, goes to Canyon Mouth Park. Now operated by the National Park Service, it doesn't open until 8:00 am. There are bath rooms only. You'll see the USGS gauge station behind the bath house. To get to the put in, on your way out of the park you'll see a steep road off to the right. Turn right, at the top of the hill, (fire tower) turn right and follow the road until you pass over Johnny's creek. Up the steep hill (50 degree) the canyon rim roads turns right, this is the long way to the put in. To shorten the distance, turn left. Pass Black Oak Church and intersect with AL hwy 176. Turn right and you will eventually pass the old amusement park, on the left. Just before the road biforcates (splits) there is a locked gate on the right. Here is a grass covered road down to the put in, approximately 1/2 mile.\n\nIf you are staying overnight, the best camping is at Desota State Park off hwy 35 on hwy 89. Primitive camping is available for $8/night for two people. Improved camping with heated bathrooms and hot showers is $15/night, two night min on weekends.\n\nNote: Some cars and trucks were broken into on 11-13-04 at Canyon Mouth Park","averageGradient":"0","maxGradient":"0","length":"5.7","correlations":[{"reachID":"68","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"250","beginMediumRunnable":"400","beginHighRunnable":"3500","endHighRunnable":"10000"},"gaugeInfo":{"name":"LITTLE RIVER NEAR BLUE POND AL","gaugeSource":"USGS","gaugeSourceIdentifier":"02399200","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"248","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.33","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"34.2889813","longitude":"-85.6805204"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/02399200","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/02399200/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"248","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["111245","1004","116515"],"geometry":{"type":"LineString","coordinates":[[-85.66867289377744,34.357866787553526],[-85.66867817746538,34.35785381333642],[-85.66873537746528,34.357682213336716],[-85.66881017746516,34.35744041333709],[-85.66883931079849,34.3573000133373],[-85.66884897746515,34.35722961333738],[-85.66887691079842,34.3570890133376],[-85.66888991079838,34.35698268000448],[-85.66890871079835,34.35634261333877],[-85.66890631079838,34.356199813339],[-85.66888717746508,34.35598628000599],[-85.66887591079842,34.355915813339436],[-85.66886011079845,34.35577381333968],[-85.66884731079847,34.355703080006435],[-85.66877451079858,34.355423813340224],[-85.6687591107986,34.35535348000701],[-85.66871177