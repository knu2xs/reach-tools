[{"result":{"data":{"json":{"id":"604","stub":{"id":"604","section":"2. W. Br. Upper Priest River to Priest River Town","altname":"","river":"Priest","difficulty":"IItoIII","states":["USA-IDA"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"3480","dateTime":"2026-05-12T03:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"108190","location":{"latitude":"48.4146","longitude":"-116.9216"},"name":"Put In","distance":"0","photoID":"kdMLP0nkoW04ks5qLBEh1","difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"113435","location":{"latitude":"48.1801986694336","longitude":"-116.891799926758"},"name":"Take Out","distance":"23","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"kdMLP0nkoW04ks5qLBEh1","ext":"jpg","post_id":"zQM4JzVtXvEuxTfVSqwSw","description":"","caption":"Put in","poi_name":null,"subject":"","author":"Kipp Dixon","poi_id":null,"photo_date":"2022-10-24T05:09:08.000Z","updated_at":"2022-10-24T05:09:08.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/kdMLP0nkoW04ks5qLBEh1","large":"https://api.americanwhitewater.org/image/images/big/kdMLP0nkoW04ks5qLBEh1"}},{"id":"28zWTPDLvu9UQCurzZFI7","ext":"jpg","post_id":"28zWTPDLvu9UQCurzZFI7","description":"","caption":"Put-in","poi_name":null,"subject":"Put-in","author":"","poi_id":null,"photo_date":"2022-10-23T22:14:38.000Z","updated_at":"2022-10-24T05:14:54.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/28zWTPDLvu9UQCurzZFI7","large":"https://api.americanwhitewater.org/image/images/big/28zWTPDLvu9UQCurzZFI7"}},{"id":"l71OUV1hKsi9IJpDLxi4x","ext":"jpg","post_id":"l71OUV1hKsi9IJpDLxi4x","description":"","caption":"","poi_name":null,"subject":"","author":"","poi_id":null,"photo_date":"2022-10-23T22:15:19.000Z","updated_at":"2022-10-24T05:15:23.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/l71OUV1hKsi9IJpDLxi4x","large":"https://api.americanwhitewater.org/image/images/big/l71OUV1hKsi9IJpDLxi4x"}}],"detail":{"id":"604","permitUrl":null,"permitInfo":null,"description":"The main whitewater section is the four miles from below the outlet dam at Priest Lake to Dickensheet campground.\n\nThere is great parking at the put-in as well as a raft ramp leading down into a large eddy. Take-out parking is 7$ for day use at Dickensheet campground or have an Idaho State Parks pass.\n\nRunnable flow range is 900cfs up with the best between 1200cfs and 1600cfs. Most of the run is class II swiftwater with one class III where Binarch Creek enters from river right. A great step up for boaters comming off the upper Spokane. Water quality is alway great and this area is beautiful. Many small play waves. Run takes about an hour so laps are easy.\n\nThere is also a great class III section in a gorge about 15 miles up from the town of Priest River. However, getting there sucks. It's miles and miles of lazy river oxbow bends on both sides of the class III section.\n\nFor more information, contact Ed Grove, 2420 N. George Mason Dr., Arl. VA 22207","averageGradient":null,"maxGradient":null,"length":"35.3","correlations":[{"reachID":"604","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"200","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"9000"},"gaugeInfo":{"name":"Priest River near Priest River, ID","gaugeSource":"USGS","gaugeSourceIdentifier":"12395000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"3480","dateTime":"2026-05-12T03:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"4.32","dateTime":"2026-05-12T03:15:00.000Z","quali