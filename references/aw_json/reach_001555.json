[{"result":{"data":{"json":{"id":"1555","stub":{"id":"1555","section":"1) Elk Creek to Moonshine Park","altname":"","river":"Siletz","difficulty":"IIItoIV","states":["USA-ORE"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"315","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"hazard","description":"Unrunnable falls upstream of the put-in. Located at USGS river mile 64.8.","id":"100817","location":{"latitude":"44.86285104","longitude":"-123.73299575"},"name":"Valsetz Falls","distance":"-1.5","photoID":"890354","difficulty":"N/A","approximate":false},{"type":"put-in","description":"Access on river right just upstream of the Elk Creek confluence.","id":"108430","location":{"latitude":"44.852664","longitude":"-123.75085312"},"name":"Elk Creek Put-In","distance":"0","photoID":"887480","difficulty":"N/A","approximate":false},{"type":"access","description":"The Buck Creek access at the bridge across the Siletz near the Buck Creek confluence provides convenient access for those looking for a shorter run. It can serve as a take-out for those just doing a short intermediate run or a put-in for those who want a warm-up before running the stretch with Silache. It is located at USGS river mile 58.8.","id":"100816","location":{"latitude":"44.81734788","longitude":"-123.78072186"},"name":"Buck Creek Access","distance":"4.49","photoID":"0","difficulty":"N/A","approximate":false},{"type":"access","description":"A take-out for those who want to exit the river before Silache or a put-in for those who want a short run that takes in the biggest whitewater. A well-worn trail downstream of the bridge on river left provides access. Located at USGS river mile 57.0.","id":"100815","location":{"latitude":"44.80156534","longitude":"-123.78363322"},"name":"Access above Silache","distance":"6.34","photoID":"0","difficulty":"N/A","approximate":false},{"type":"rapid","description":"A long rapid which can range from class III to solid class IV depending on flows. As you are traveling down river, the rapid is just past a bridge and can be scouted from the road on river left. It is located at USGS river mile 56.9.","id":"100793","location":{"latitude":"44.8015624","longitude":"-123.78428165"},"name":"Silache","distance":"6.36","difficulty":"IV+","approximate":false,"photoID":"873418"},{"type":"rapid","description":"A rapid where the river squeezes through a short and narrow rock gorge. Located at USGS river mile 55.0.","id":"101357","location":{"latitude":"44.7855547","longitude":"-123.79590542"},"name":"Quarry","distance":"8.23","difficulty":"III+","approximate":false,"photoID":"887481"},{"type":"takeout","description":"At Highway 411 mile post 7.8 in Logsden (15 miles from Nashville or 8 miles from Siletz) turn on to Moonshine Park Road which heads up along river left. At mile 3.5 on Moonshine Park Road the county maintained road ends but you can turn down to the left which is 0.2 mile paved entrance road to Moonshine County Park with a boat ramp just before entering the park.","id":"113665","location":{"latitude":"44.77892411","longitude":"-123.83264756"},"name":"Moonshine County Park Take-Out","distance":"10.52","photoID":"A4hEJWLk8anBLLTyos8ix","difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"873418","ext":"jpeg","post_id":"lOm88GSpKpHdJ8579keCf","description":"","caption":"Silache Rapid","poi_name":"Silache","subject":"Evan Durland","author":"Thomas O'Keefe","poi_id":"100793","photo_date":"2010-04-03T23:26:49.000Z","updated_at":"2025-06-04T23:26:50.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/873418","large":"https://api.americanwhitewater.org/image/images/big/873418"}},{"id":"A4hEJWLk8anBLLTyos8ix","ext":"jpg","post_id":"lOm88GSpKpHdJ8579keCf","description":"","caption":"Take Out","poi_name":null,"subject":"","author":"Thomas O'Keefe","poi_id":null,"photo_date":"2010-04-03T23:26:49.000Z","updated_at":"2025-06-04T23:26:50.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/A4hEJWLk8anBLLTyos8ix","large":"https://api.americanwhitewater.org/image/images/big/A4hEJWLk8anBLLTyos8ix"}},{"id":"873420","ext":"jpeg","post_id":"lOm88GSpKpHdJ8579keCf","description":"","caption":"Silache Rapid","poi_name":"Silache","subject":"Kathleen O'Malley","author":"Thomas O'Keefe","poi_id":"100793","photo_date":"2010-04-03T23:26:49.000Z","updated_at":"2025-06-04T23:26:50.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/873420","large":"https://api.americanwhitewater.org/image/images/big/873420"}},{"id":"873687","ext":"jpeg","post_id":"873688","description":"Photo of Joe Dietrich (foreground cartwheel), Kathleen O'Malley (skirting right side of Quarry Drop), and Megi Morishita (running sweep).  Photo taken by Debbie Steele.\n","caption":"Quarry Drop","poi_name":null,"subject":null,"author":null,"poi_id":"101357","photo_date":"2010-01-10T00:11:08.000Z","updated_at":"2025-06-05T00:11:10.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/873687","large":"https://api.americanwhitewater.org/image/images/big/873687"}},{"id":"887482","ext":"jpeg","post_id":"890242","description":"","caption":"On the fly play wave","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887482","large":"https://api.americanwhitewater.org/image/images/big/887482"}},{"id":"887484","ext":"jpeg","post_id":"890244","description":"","caption":"Silache","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887484","large":"https://api.americanwhitewater.org/image/images/big/887484"}},{"id":"887481","ext":"jpeg","post_id":"890241","description":"","caption":"Quarry Drop","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887481","large":"https://api.americanwhitewater.org/image/images/big/887481"}},{"id":"887480","ext":"jpeg","post_id":"890240","description":"","caption":"Put in at Elk Creek","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887480","large":"https://api.americanwhitewater.org/image/images/big/887480"}},{"id":"890354","ext":"jpeg","post_id":"892709","description":"Valsetz Falls overlook 1.1miles above Elk Creek Put-In. 5' @ Siletz","caption":"Valsetz Falls","poi_name":null,"subject":null,"author":"Sam Morrison","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/890354","large":"https://api.americanwhitewater.org/image/images/big/890354"}},{"id":"887483","ext":"jpeg","post_id":"890243","description":"","caption":"Quarry Drop","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887483","large":"https://api.americanwhitewater.org/image/images/big/887483"}},{"id":"887485","ext":"jpeg","post_id":"890245","description":"","caption":"Just below Silache","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887485","large":"https://api.americanwhitewater.org/image/images/big/887485"}},{"id":"887486","ext":"jpeg","post_id":"890246","description":"","caption":"Read and run rapid below Silache","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887486","large":"https://api.americanwhitewater.org/image/images/big/887486"}},{"id":"887487","ext":"jpeg","post_id":"890247","description":"","caption":"","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887487","large":"https://api.americanwhitewater.org/image/images/big/887487"}}],"detail":{"id":"1555","permitUrl":"","permitInfo":"","description":"The Siletz is an Oregon Coast Range classic with easy roadside access providing a few different options from one long run to shorter runs that can be matched to the skill level of the group. The run is only available on weekends as the private timber road that provides access is closed to the public during the week.\n\nElk Creek to Buck Creek (4.5 miles)\n\nA good intermediate run with the two most challenging rapids in the first mile.\n\nBuck Creek to Moonshine Park (6.5 miles)\n\nThis run serves up some great whitewater with Silache a long rapid which can range from class III to solid class IV depending on flows. It can be easily seen from the road as you run your shuttle. There are more fun rapids, notably Quarry Drop where the river squeezes through a short and narrow rock gorge.\n\nLogistics: At Highway 411 mile post 7.8 in Logsden (15 miles from Nashville or 8 miles from Siletz) turn on to Moonshine Park Road which heads up along river left. At mile 3.5 on Moonshine Park Road the county maintained road ends but you can turn down to the left which is 0.2 mile paved entrance road to Moonshine County Park with a boat ramp just before entering the park. To reach the put-in continue up the private gravel road (only open on weekends) and for the first few miles you have several options for roadside access. At mile mile 3.4 you will see Silache Rapid, the major rapid on the run which is easy to scout from the road. You will cross the bridge at mile 3.7 which marks the start of Silache Rapid and can serve as an alternate access point. After you cross this bridge the river climbs away from the river. At mile 5.2 you will cross Buck Creek staying to the right as you cross the bridge. You immediately come to Y in the road: take the right fork for the 0.4 mile descent down to the bridge that serves as the lower put-in at Buck Creek, or continue up the left fork to mile 11.6 and the put-in at Elk Creek. Well-worn boater trails can be found at both of these access points.","averageGradient":"30","maxGradient":null,"length":"10.5","correlations":[{"reachID":"1555","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1000","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"4500"},"gaugeInfo":{"name":"SILETZ RIVER AT SILETZ, OR","gaugeSource":"USGS","gaugeSourceIdentifier":"14305500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"315","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.04","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"44.7151172","longitude":"-123.8873348"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/14305500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/14305500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"315","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["100817","108430","100816","100815","100793","101357","113665"],"geometry":{"type":"LineString","coordinates":[[-123.75073677152983,44.852212332571526],[-123.75122231835365,44.851994730380795],[-123.75141258502003,44.851907330380925],[-123.75163251835302,44