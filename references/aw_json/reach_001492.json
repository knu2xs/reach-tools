[{"result":{"data":{"json":{"id":"1492","stub":{"id":"1492","section":"1. June Creek Br. to Collawash River","altname":"","river":"Clackamas","difficulty":"IIItoIV","states":["USA-ORE"]},"primaryGaugeStatus":{"status":"low-runnable","latestReading":{"value":"1080","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Latlong for where we actually launched on 5/3/26: Lat 45.017295 Lon -121.921806\n\nThis location is nice because it gives you 1/4 mile of easy water to get your boat under you before it gets insanely technical.","id":"111778","location":{"latitude":"45.01723097","longitude":"-121.92060645"},"name":"Put In","distance":"0.06","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":"A steep, often technical drop on a sharp left turn. Often has wood in the preferred line and more challenging at lower water. Also known as Corner Pocket.","id":"PCnQpfx23QiRVqLQOYqdX","location":{"latitude":"45.02635935","longitude":"-121.97409879"},"name":"Wall Shot","distance":"3.09","difficulty":"III","approximate":false,"photoID":"891140"},{"type":"rapid","description":"A fun rapid where the river narrows into a small gorge. Scout from the road for wood and line choice. Also known as Hat Grabber, this rapid gets intense at medium-high water.","id":"UcciCqyH1Dpi5qVwgMh5v","location":{"latitude":"45.01976538","longitude":"-121.98084111"},"name":"Whoop-de-do","distance":"3.66","difficulty":"III","approximate":false,"photoID":"h5lbGMAVL4BBNZrxKB7wx"},{"type":"access","description":"This is a good take-out, particarly at lower water or when there is wood between here and the confluence. There are two small eddies directly below the rapid and a trail up to the road.","id":"T5EVZqiLuXHgSLrFWJMb5","location":{"latitude":"45.03123269","longitude":"-122.05322927"},"name":"Aternate take-out","distance":"7.69","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"There is an old road on the left upstream of the bridge that leads up to the road. Generally this is easier than taking out directly at the confluence.","id":"117050","location":{"latitude":"45.03161364","longitude":"-122.06007647"},"name":"Take Out","distance":"8.03","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"dO1n3g2HgmdQAZKPzUdEX","title":"The Road is Open and the June Creek area forest DID NOT BURN","post_date":"2023-05-07 13:32:23+00","detail":"Delightfully this section was spared in the 2020 wildfire because the wind was from the east and the blaze traveled down the drainage instead of up. The forest is intact along this section, but downed wood in the river is still commonplace.","user":{"name":"Teresa Gryder"}},{"id":"yaeNrIuDxXw1sdfelxaA3","title":"Wildfire Impacted Sept 2020","post_date":"2020-12-01 03:54:15+00","detail":"A campfire got away during a period of extreme dryness and high winds out of the east which drove the fire downstream through the bottom part of this run and on down the Clackamas. Road closures and wood blockages are to be expected for some time.","user":{"name":"Teresa Gryder"}}],"photos":[{"id":"h5lbGMAVL4BBNZrxKB7wx","ext":"jpg","post_id":"5gUmYx0f1FhfxSGZat1ak","description":"","caption":"Boaters running Whoop-de-do rapid","poi_name":null,"subject":"","author":"Pete Giordano","poi_id":"UcciCqyH1Dpi5qVwgMh5v","photo_date":"2025-06-03T03:38:35.000Z","updated_at":"2025-06-03T03:38:35.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/h5lbGMAVL4BBNZrxKB7wx","large":"https://api.americanwhitewater.org/image/images/big/h5lbGMAVL4BBNZrxKB7wx"}},{"id":"yMcyMjuwHW7rmAftOT7pe","ext":"jpg","post_id":"1BZsU5huXrUu3ombfuphV","description":"","caption":"Monolith Rapid","poi_name":null,"subject":"Priscilla Macy","author":"Jacob Cruser","poi_id":"107150","photo_date":"2024-03-16T19:03:11.000Z","updated_at":"2026-04-01T19:03:11.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/yMcyMjuwHW7rmAftOT7pe","large":"https://api.americanwhitewater.org/image/images/big/yMcyMjuwHW7rmAftOT7pe"}},{"id":"EfJuUz7OnigiJ2E3VPMv4","ext":"jpg","post_id":"r4bvr2Bx4yVGzEDtcvRUb","description":"","caption":"Logs above Austin May 3, 2026","poi_name":null,"subject":"Barely duckable in kayaks at 1300cfs.","author":"Teresa Gryder","poi_id":null,"photo_date":"2026-05-03T00:00:00.000Z","updated_at":"2026-05-04T21:55:31.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/EfJuUz7OnigiJ2E3VPMv4","large":"https://api.americanwhitewater.org/image/images/big/EfJuUz7OnigiJ2E3VPMv4"}},{"id":"891138","ext":"jpg","post_id":"895047","description":null,"caption":" on Clackamas @1. June Creek Br. to Collawash River","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891138","large":"https://api.americanwhitewater.org/image/images/big/891138"}},{"id":"13331","ext":"jpeg","post_id":"8572","description":"","caption":"","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/13331","large":"https://api.americanwhitewater.org/image/images/big/13331"}},{"id":"891139","ext":"jpg","post_id":"895048","description":null,"caption":"June Creek Clackamas Put-In","poi_name":null,"subject":null,"author":"Sam Morrison","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891139","large":"https://api.americanwhitewater.org/image/images/big/891139"}},{"id":"891140","ext":"jpg","post_id":"895049","description":null,"caption":"Corner Rapid on Clackamas R.","poi_name":null,"subject":null,"author":"Sam Morrison","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891140","large":"https://api.americanwhitewater.org/image/images/big/891140"}},{"id":"891142","ext":"jpg","post_id":"895051","description":null,"caption":"Austin Hot Springs Clackamas R.","poi_name":null,"subject":null,"author":"Sam Morrison","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891142","large":"https://api.americanwhitewater.org/image/images/big/891142"}},{"id":"18629","ext":"jpeg","post_id":"1741","description":"Clackamas River upstream of the Collawash \r\nconfluence.","caption":"Clackamas above the Collawash","poi_name":"","subject":"","author":"Thomas O'Keefe В©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/18629","large":"https://api.americanwhitewater.org/image/images/big/18629"}},{"id":"891141","ext":"jpg","post_id":"895050","description":null,"caption":"Monolith Rapid Clackamas R.","poi_name":"Monolith Rapid","subject":null,"author":"Sam Morrison","poi_id":"107150","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891141","large":"https://api.americanwhitewater.org/image/images/big/891141"}}],"detail":{"id":"1492","permitUrl":null,"permitInfo":null,"description":"The June Creek section of the Clackamas contains nearly continuous intermediate rapids, beautiful scenery, clear water and a pleasant riverside hot springs. This is a great run for boaters looking to make the transition from rivers to creeks because it is roadside; if you get fed up with the rockfest it's easy to climb out.\n\nFrom the June Creek Bridge the action picks up quickly with two or three stand-out drops. There is usually wood on the right at the first sharp right turn which can complicate things at lower water. One of the steeper and more technical drops, 'Wall Shot Rapid', is about 3.1 miles into the run and is scoutable from the road. It is has sharp bend to the left along a wall with a couple boulder entrances along the river right at normal flows.\n\nShortly after Wall Shot be on the lookout for another steep drop through a mid-stream hole where the river narrows. A second short gorge is further downstream. Both are worth scouting from the road on the drive upstream.\n\nDuring the pandemic and after the USFS installed fish habitat log jams in the area upstream and downstream of Monolith, and as of May 2026 at least one of them had collected channel-spanning wood. More wood accumulation is expected in this area.\n\nThe most difficult rapid, Monolith (IV), lies about a half mile below the hot springs and is also scoutable from the road at milepost 6. Be sure to scout both the lead-in and run-out for wood as it tends to collect here. Once through Monolith the rapids diminish in difficulty and spread out. When you see the beautiful, tall cliff wall rising up on your right you are right above the last big rapid, Boulder Garden (IV). Boulder is roughly a quarter mile long series of holes, boulders, and waves depending on the flow with multiple line options. The take-out is shortly after this, just above the Collawash confluence and the NF-63 bridge on river left or take-out just below the rapid after Boulder Garden on the right.\n\nFor a highwater description of the run (10,000cfs @ 3 Lynx) see the [June Creek Section](http://www.oregonkayaking.net/floodstage/clack_high.html) at [Oregonkayaking.net](http://www.oregonkayaking.net).","averageGradient":null,"maxGradient":null,"length":"8.1","correlations":[{"reachID":"1492","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1000","beginMediumRunnable":"2000","beginHighRunnable":"6000","endHighRunnable":"10000"},"gaugeInfo":{"name":"CLACKAMAS RIVER ABOVE THREE LYNX CREEK, OR","gaugeSource":"USGS","gaugeSourceIdentifier":"14209500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"1080","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.02","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"45.1248432","longitude":"-122.0734137"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/14209500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/14209500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":"Has been run as low as 300 cfs.","status":{"status":"low-runnable","latestReading":{"value":"1080","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["111778","PCnQpfx23QiRVqLQOYqdX","UcciCqyH1Dpi5qVwgMh5v","T5EVZqiLuXHgSLrFWJMb5","117050"],"geometry":{"type":"LineString","coordinates":[[-121.92063529,45.01675006],[-121.9207871,45.01672026],[-121.92117333,45.01672784],[-121.92182779,45.01697812],[-121.92218184,45.01703121],[-121.92376971,45.01699329],[-121.92466021,45.01713739],[-121.92466021,45.01713739],[-121.92501219,45.01729158],[-121.92501257,45.01729115],[-121.925418,45.017468],[-121.926151,45.017637],[-121.926468,45.017826],[-121.926995,45.01814],[-121.927263,45.01839],[-121.927567,45.018749],[-121.927608,45.018828],[-121.927868,45.019328],[-121.928211,45.019724],[-121.928295,45.019803],[-121.928327,45.019844],[-121.928458,45.019993],[-121.928461,45.019997],[-121.928497,45.020135],[-121.928544,45.020268],[-121.928672,45.020596],[-121.928693,45.020672],[-121.928806,45.021258],[-121.92886,45.021411],[-121.928878,45.021483],[-121.928956,45.021719],[-121.929065,45.02197],[-121.929066,45.021972],[-121.929332,45.022303],[-121.929523,45.022445],[-121.929715,45.022554],[-121.929983,45.022584],[-121.9303,45.022632],[-121.930797,45.0225