uthor":"Dup Crosson","poi_id":null,"photo_date":"2023-02-15T22:39:31.000Z","updated_at":"2023-12-31T22:39:31.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/rB6osaIjC6lVfCVHZtRLP","large":"https://api.americanwhitewater.org/image/images/big/rB6osaIjC6lVfCVHZtRLP"}},{"id":"CwzjPWLYY1n8Kd9kEHwsR","ext":"jpg","post_id":"oFWfXpgpo5CyoAKlU9JqC","description":"Lower section","caption":"","poi_name":null,"subject":"","author":"Dup Crosson","poi_id":null,"photo_date":"2023-02-15T22:39:31.000Z","updated_at":"2023-12-31T22:39:31.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/CwzjPWLYY1n8Kd9kEHwsR","large":"https://api.americanwhitewater.org/image/images/big/CwzjPWLYY1n8Kd9kEHwsR"}},{"id":"5a2amcavs2hNz5l9W3lLz","ext":"jpg","post_id":"oFWfXpgpo5CyoAKlU9JqC","description":"The creek is beautiful at top! But the water quality quickly changes to muddy brown-green at the confluence with Duncan Creek just 200yds downstream.","caption":"","poi_name":null,"subject":"","author":"Dup Crosson","poi_id":"112867","photo_date":"2023-02-15T22:39:30.000Z","updated_at":"2023-12-31T22:39:31.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5a2amcavs2hNz5l9W3lLz","large":"https://api.americanwhitewater.org/image/images/big/5a2amcavs2hNz5l9W3lLz"}},{"id":"Vb9sFYaLC5t51eSNG21HV","ext":"jpg","post_id":"oFWfXpgpo5CyoAKlU9JqC","description":"Dam","caption":"","poi_name":null,"subject":"","author":"Dup Crosson","poi_id":null,"photo_date":"2023-02-15T22:39:31.000Z","updated_at":"2023-12-31T22:39:31.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/Vb9sFYaLC5t51eSNG21HV","large":"https://api.americanwhitewater.org/image/images/big/Vb9sFYaLC5t51eSNG21HV"}}],"detail":{"id":"171","permitUrl":null,"permitInfo":null,"description":"A relatively calm and very brushy overnight trip through oak woodlands and cottonwoods, similar to Putah or Grindstone Creeks. There is a lot of private farmland along the way, so be aware of where you choose to put in, take out, and sleep. Expect cows and Class I-II paddling for most of the way, with some braided, tree-choked portages along the way, and especially for the middle 8mi. The views on the way to the put-in, which show the Yolla Bolly Wilderness in full glory against the valley geology in the forefront, are kind of the best part of this run.\n\n**Additional Information:**\n\n[California Creeks](http://creekin.net/coton-mf.htm)\n\nSCHWIND GUIDEBOOK\n\nBureau of Land Management (BLM) has reinitiated public scoping for its Northern California Integrated Plan (NCIP), which will determine the future management of 382,000 acres of public land in northcentral and northwest California. Protections for all of the forks of Cottonwood Creek are on the table; they were originally included in the BLM’s Arcata region study in 1995, but not in the 2018 inventory. Learn more at [www.calwild.org.](https://www.calwild.org/ncip-fewer-wsr-miles-more-segments/)","averageGradient":"29","maxGradient":null,"length":"24.8","correlations":[{"reachID":"171","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1125","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"2250"},"gaugeInfo":{"name":"COTTONWOOD CREEK AUXILIARY GAGE","gaugeSource":"CDEC","gaugeSourceIdentifier":"CWA","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"334","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.05","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"40.3870964050293","longitude":"-122.238609313965"},"externalSourceLinks":{"sourceLink":{"url":"https://cdec.water.ca.gov/dynamicapp/QueryF?s=CWA","tex