[{"result":{"data":{"json":{"id":"720","stub":{"id":"720","section":"Maryland Rte. 36 (Midland) to N. Branch Potomac River","altname":"","river":"Georges Creek","difficulty":"IIItoIV","states":["USA-MRY"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"2.18","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"112343","location":{"latitude":"39.5913009643555","longitude":"-78.9481964111328"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"","id":"117625","location":{"latitude":"39.483933","longitude":"-79.046201"},"name":"Take Out","distance":"11.91","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"720","permitUrl":null,"permitInfo":null,"description":"Gertler, Ed; Maryland and Delaware Canoe Trails\n\nLat/longitude coords are approximate, from TopoZone.\n\nEd Evangelidi testifies:\n\nThis is a polluted version of the Savage. Lots of mine drainage has destroyed the quality of this poor stream. Paddle this stream for the rapids, as it often is up when the Savage may be too high or too low (Savage is partly dam controlled). Also note that because trees have been substantially removed from this valley, strainers are usually not evident except where railroad abutments are right in the middle of the creek and catch stuff. However, there are a number of blind turns where one should still be alert for possible strainers, both trees and junk that might have been pushed into the stream. There is a big dam about 2/3 of the way down the run with a small pool in slightly fast water and a very nasty hydraulic at the bottom. Carry on the left but make sure you don't drift too far downstream in the eddy. Georges Creek at Franklin should be around 4.6' or higher.","averageGradient":null,"maxGradient":null,"length":"11.9","c