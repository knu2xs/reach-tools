[{"result":{"data":{"json":{"id":"449","stub":{"id":"449","section":"2. Falls Village Hydro 13.2 mi to Swifts Bridge,  9.3 mi to Kent","altname":"","river":"Housatonic","difficulty":"IItoIII","states":["USA-CNN"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"1000","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"111425","location":{"latitude":"41.9581","longitude":"-73.3706"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"116694","location":{"latitude":"41.8072","longitude":"-73.3917"},"name":"Take Out","distance":"22.5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"7262","ext":"mpg","post_id":"5769","description":"","caption":"Cover Bridge Slalom race","poi_name":"","subject":"?","author":"cyclingstuff.50megs.com","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/7262","large":"https://api.americanwhitewater.org/image/images/big/7262"}},{"id":"7258","ext":"mpg","post_id":"5769","description":"","caption":"Race at Cover Bridge","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/7258","large":"https://api.americanwhitewater.org/image/images/big/7258"}},{"id":"7257","ext":"mpg","post_id":"5769","description":"","caption":"Cover Bridge Slalom race","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/7257","large":"https://api.americanwhitewater.org/image/images/big/7257"}},{"id":"3931","ext":"jpeg","post_id":"5866","description":"","caption":"Last drop on Rattlesnake rapid","poi_name":"Rattlesnake","subject":"Bob Spooner","author":"Paul Griese","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3931","large":"https://api.americanwhitewater.org/image/images/big/3931"}}],"detail":{"id":"449","permitUrl":null,"permitInfo":null,"description":"[Info on slalom races](http://www.bestweb.net/~keech/a-bridge.htm) on the Housatonic.\n\nScott Barnes contributes:\n\nSwift's Bridge is a small set of rips because the river is constricted by old bridge abutments. At super high levels there is a world-class wave/hole that forms, but I've only seen it twice in my boating career. Normally, the clan from Clarke Outdoors go down there to surf a very small wave and do some squirts in the summer, when the water is really low.\n\n**Directions** to the Swift's Bridge play, also courtesy of Scott Barnes:\n\nDirections: In Cornwall Bridge, CT, at the intersection of Routes 7 and 4 there is a road on the NORTH side of the road bridge that will take you under the bridge. Drive down that road (once you go under the bridge for a little bit. The road will bear right to go up a hill. You want to park near the trailhead that is at that point. You'll notice where the road used to cross the river (until the flood of 1955) and that is where the wave is. Regarding the existing bridge and the intersection of Routes 4 and 7: Baird's General Store and Northwest Hardware are on the WRONG side of the bridge. There is a gas station on the CORRECT side of the bridge. Just to make sure people get it right because roads go down to the water and under the big bridge on both sides of the river at that intersection.\n\nReleases depend on how much water is around, so the best bet is to call Clarke Outdoors, (860) 672-6365.\n\nCheck out [this article](http://www.americanwhitewater.org/oldawa/awa/journal/jpre95/ct89.html) from the AW _Journal_ archives. Also check out the [Rattlesnake](http://www.americanwhitewater.org/rivers/id/1050) and [Bull's Bridge](http://www.americanwhitewater.org/rivers/id/448) sections.","averageGradient":null,"maxGradient":null,"length":"12.9","correlations":[{"reachID":"449","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1200","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"10000"},"gaugeInfo":{"name":"HOUSATONIC RIVER AT FALLS VILLAGE, CT","gaugeSource":"USGS","gaugeSourceIdentifier":"01199000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"1000","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.26","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"41.95720801","longitude":"-73.36926235"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/01199000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/01199000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":"Previous Flowbands: \nRange of Boatable Flows (R0-R9): 1200 - 10000 cfs  Comment: Best boatable levels uncertain. Help us out with a comment or report.\n\nMigration Errors: \nSingle range is valid but doesn't provide low/medium/high runnable\nThere is one comment for all of low/medium/high runnable.","comment":null,"status":{"status":"below-recommended","latestReading":{"value":"1000","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["111425","116694"],"geometry":{"type":"LineString","coordinates":[[-73.37055939661019,41.95816319202297],[-73.37007912988861,41.95785460153974],[-73.36976092988908,41.95732080154056],[-73.36974499655577,41.95698006820777],[-73.36989839655554,41.9568792682079],[-73