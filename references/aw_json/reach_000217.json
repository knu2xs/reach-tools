[{"result":{"data":{"json":{"id":"217","stub":{"id":"217","section":"2) Forks of the Kern to Johnsondale Bridge","altname":"","river":"Kern","difficulty":"IIItoV","states":["USA-CAL"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"1523","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"112869","location":{"latitude":"36.1306","longitude":"-118.438004"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"118148","location":{"latitude":"35.968102","longitude":"-118.485001"},"name":"Take Out","distance":"16.8","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"100031265","title":null,"post_date":"2007-08-15 04:00:00+00","detail":"Peter Wiechers reports that the forest service is planning to charge a $10 reservation fee to all paddling groups on the Forks of the Kern. A public meeting is being held on Thursday, August 16, 2007 at the Senior Center in Lake Isabella from 4-6pm to discuss aspects of this and other new fees being planned for forest visitors.\n\nThe unneeded reservation system for one day trips on the Forks is already an annoyance. A new fee will add injury to the irritation.","user":{"name":"Paul Martzen"}}],"photos":[{"id":"255","ext":"jpeg","post_id":"1428","description":"Dave on the Forks - Just before a swim","caption":"Forks of the Kern -Westwall","poi_name":"Westwall or Confusion","subject":"Dave Priem","author":"Robert King  KHCC","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/255","large":"https://api.americanwhitewater.org/image/images/big/255"}},{"id":"640","ext":"jpeg","post_id":"2395","description":"You can see Scott and Gilbert behind the curtain. Check out much more of Scott's excellent photo album <a href=\"http://community.webshots.com/user/sostrem1\">here</a>.","caption":"Peppermint Falls","poi_name":"Side hike off of the Forks","subject":"Scott Ostrem & Gilbert Siegel","author":"Robert Henry","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/640","large":"https://api.americanwhitewater.org/image/images/big/640"}}],"detail":{"id":"217","permitUrl":"http://www.fs.usda.gov/detail/sequoia/passes-permits/recreation/?cid=fsbdev3_059515","permitInfo":"On the Forks Run, the Forest Service operates an advance reservation service in an effort to give boaters a more equal chance of obtaining a permit. The Forks Run is limited to 15 people per day. Permits are required from May 15 through September 15 each year. To obtain a reservation, there is a $10.00 fee to enter the selection process. Applications for a reservation will be made through the mail beginning March 15 each year. The final deadline to submit an application is April 15. Applications will be separated by requested put-in dates, and a drawing will occur for those dates which have an excess of requests. You must notify the Kernville Ranger Station within 7 days of your scheduled trip, if you need to cancel your reservation or if your party size changes.","description":"**The Forks of the Kern** is a classic class V section with outstanding scenery. It is a popular kayak run and also supports commercial rafting trips. Kayakers tend to do the run in a single day while the commercial companies stretch it into two or even three days to allow their customers to savor the experience.\n\n**Getting There:** Johnsondale Bridge is about 25 minutes north of Kernville and about one hour and 40 minutes from Bakersfield. If coming from the north it is faster to turn off of highway 99 at Earlimart to go through Ducor and California Hot Springs. Allow about one hour and 20 minutes from Earlimart. Sometimes people drive through Springville and up through the Tule River Canyon, but this is a slow drive due to the narrow, windy road. Allow an hour and a half just from Springville, not counting stops for gawking at the Tule canyon.\n\n**Take-out:** Johnsondale bridge. [topozone map](http://www.topozone.com/map.asp?lat=35.9691&lon=-118.4868&datum=nad27&u=5&layer=DRG&size=m&s=25), [google map](http://maps.google.com/maps?q=35.9691,+-%20118.4868+(Johnsondale+Bridge+river+access)&hl=en&ie=UTF8&z=17&ll=35.9691,-%20118.4868&spn=0.00376,0.010632&t=h&om=1).\n\n**Put-in:** Forks of the Kern trail. From Johnsondale bridge drive west about 4 miles then turn left and follow signs to the Forks trailhead. This road is closed in the winter and opens back up in the spring. The gate is about 3 miles past the junction, just past Camp Whitsett, near Dry Meadow Creek. Call the Kernville office at (760)-376-3781 to find out if the road is open or not. [topozone map](http://www.topozone.com/map.asp?lat=36.1338&lon=-118.4373&datum=nad27&u=5&layer=DRG&size=m&s=25), [google map](http://maps.google.com/maps?q=36.1338,+-%20118.4373+(Forks+of=the+Kern)&hl=en&ie=UTF8&z=17&ll=36.1338,-%20118.4373&spn=0.00376,0.010632&t=h&om=1).\n\n**Other Information Sources:**\n\n[Sequoia Forest: Forks info](http://www.fs.fed.us/r5/sequoia/recreation/river_info/forks.html)\n\n[Forks of the Kern guidebook and map](https://www.kernriverrafting.com/kern-river-guide/forks-of-the-kern/)\n\n[Sequoia National Forest](http://www.fs.fed.us/r5/sequoia/) Kernville office phone # 760-376-3781\n\n[Cacreeks.com](http://www.cacreeks.com/kern-fks.htm)\n\nCassady & Calhoun, Holbek & Stanley, Alan Baty","averageGradient":null,"maxGradient":null,"length":"14.6","correlations":[{"reachID":"217","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"400","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"5000"},"gaugeInfo":{"name":"No. Kern Above Fairview Dam","gaugeSource":"DREAM","gaugeSourceIdentifier":"681","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"1523","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":null,"location":{"latitude":"30","longitude":"30"},"externalSourceLinks":{"sourceLink":{"url":"https://www.dreamflows.com/graphs/day.681.php","text":"Dream Flows"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"migration-runnable","latestReading":{"value":"1523","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["112869","118148"],"geometry":{"type":"LineString","coordinates":[[-118.43814919206295,36.130556138313956],[-118.43805872660073,36.130256677251964],[-118.43810399326738,36.13010107725222],[-118.43825179326713,36.12952181058648],[-118.43824992660046,36.12939967725333],[-118.43824119326712,36.12930227725349],[-118.43817279326727,36.1290758772538],[-118.43812499326731,36.128974877253995],[-118.43805079326745,36.12883221058752],[-118.43802652660082,36.128740477254325],[-118.43802499326745,36.12866287725444],[-118.43803699326749,36.12852487725468],[-118.43802512660079,36.128293677255044],[-118.43817219326723,36.12788387725567],[-118.4382577932671,36.127741077255905],[-118.43833779326701,36.12766847725601],[-118.43846539326678,36.127620810589406],[-118.4385993932666,36.127618410589434],[-118.4391105265991,36.127630677256036],[-118.43938339326537,36.12767267725599],[-118.43960539326503,36.127733610589246],[-118.44000919326442,36.1277820772558],[-118.44001352659774,36.127782477255835],[-118.44041892659709,36.12778521058914],[-118.44119699326258,36.12781861058909],[-118.4413051265957,36.12787141058902],[-118.44162092659519,36.12784761058907],[-118.44222812659429,36.12802507725547],[-118.44313319325954,36.12781487725579],[-118.44340699325907,36.1276522