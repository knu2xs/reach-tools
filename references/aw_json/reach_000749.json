ages/big/wWXmkTFZtQot0THtpFuar"}},{"id":"O0f60TyrXgF1PVUN4zARn","ext":"jpg","post_id":"7a6rm6OxxgqNnKUAidiX1","description":"Sideling Hill Creek 6-1-2025","caption":"Sideling Hill Creek 6-1-2025","poi_name":null,"subject":"Sideling Hill Creek 6-1-2025","author":"Tony Allred","poi_id":null,"photo_date":"2025-06-01T20:01:02.000Z","updated_at":"2025-06-02T20:01:02.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/O0f60TyrXgF1PVUN4zARn","large":"https://api.americanwhitewater.org/image/images/big/O0f60TyrXgF1PVUN4zARn"}},{"id":"N5OjJSoxXzc1XGv2ED1ir","ext":"jpg","post_id":"7a6rm6OxxgqNnKUAidiX1","description":"Sideling Hill Creek 6-1-2025","caption":"Sideling Hill Creek 6-1-2025","poi_name":null,"subject":"Sideling Hill Creek 6-1-2025","author":"Tony Allred","poi_id":null,"photo_date":"2025-06-01T20:01:02.000Z","updated_at":"2025-06-02T20:01:02.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/N5OjJSoxXzc1XGv2ED1ir","large":"https://api.americanwhitewater.org/image/images/big/N5OjJSoxXzc1XGv2ED1ir"}},{"id":"gj9yWOwQDtdXj7WGB07Vf","ext":"jpg","post_id":"7a6rm6OxxgqNnKUAidiX1","description":"Sideling Hill Creek 6-1-2025 (cropped)","caption":"Sideling Hill Creek 6-1-2025","poi_name":null,"subject":"Sideling Hill Creek 6-1-2025","author":"Tony Allred","poi_id":null,"photo_date":"2025-06-01T20:01:02.000Z","updated_at":"2025-06-02T20:01:02.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/gj9yWOwQDtdXj7WGB07Vf","large":"https://api.americanwhitewater.org/image/images/big/gj9yWOwQDtdXj7WGB07Vf"}},{"id":"tTKy7FrFymb93XDxe47l2","ext":"jpg","post_id":"7a6rm6OxxgqNnKUAidiX1","description":"<p>Sideling Hill Creek 6-1-2025</p>","caption":"Sideling Hill Creek 6-1-2025","poi_name":null,"subject":"Sideling Hill Creek 6-1-2025","author":"Tony Allred","poi_id":null,"photo_date":"2025-06-01T20:01:02.000Z","updated_at":"2025-06-02T20:01:02.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/tTKy7FrFymb93XDxe47l2","large":"https://api.americanwhitewater.org/image/images/big/tTKy7FrFymb93XDxe47l2"}}],"detail":{"id":"749","permitUrl":null,"permitInfo":null,"description":"This is not to be confused with the other [Sideling Hill Creek](http://rapids.americanwhitewater.org/content/River/view/river-detail/1661), which hangs out in Pennsylvania.\n\nEd Evangelidi testifies:\n\nYou can spend a lovely day above I-68 or below. Your choice. The stretch above the interstate is mostly private land but has little development and the stretch below the interstate is partly in government hands. Both have lovely rugged hills and bouncy but tame rapids. The next bridge down from the interstate makes a good putin or takeout and has a painted gauge that should read at least 2 feet. The takeout area is presently in a state of flux, with bridge work and a major bike construction project. But there is access that might change from time to time. Exercise caution in hunting season.\n\nThe following info. is from John Duke. [Email me](mailto:dukejohn999@aol.com) with any questions!\n\n**Camping areas**\n\nThe best is [Greenridge state Forest](http://www.dnr.state.md.us/publiclands/western/greenridge.html), having 100 campsites spaced out between Sideling Hill Creek and Town Creek.One site(#85) is right on the banks of Sideling. You must register at the headquarters before camping.\n\n**Access Points**\n\nMile 0.0--Robinsonville road bridge (sr 2011) has good access over the West Branch,it also has a painted gauge on downstream river left.\n\nMile 0.4--Sideling hill road (tr 330) has decent access over the TINY East Branch.\n\nMile 3.0--Try putting in on the rt.26 bridge over Piney creek for a 1 mile ride with a 50 foot drop to the confluence.\n\nMile 4.3--Silver Mills road bridge (tr319) - Has good parking but you will have to push through some stickers!\n\nMile 7.5--Rt.484 bridge - has good parking but there are cows and fences around.\n\nMile 8.8--Dirt road ford off of rt.484. This looks like a pretty good access point.\n\nMile 13.4--High Germany road bridge. The Nature Conservancy owns 2000 feet of Land on river left with good parking.\n\nMile 13.9--Old National Road/US. 40 bridge. This is the most used access on this stream, separating what is considered the upper and lower sections.\n\nMile 19.1--Harry Norris road ford - fantastic access on Nature Conservancy land.\n\nMile 22.3--Cliff Road - there is very good access at Greenridge State Forest campsite #85. It seems to me that the county does not plow or care for this skinny little class 3 road.\n\nMile 24.4--Zeigler road bridge is open. There is good roadside parking with a steep carry at this bridge.\n\nMile 26.0--Confluence with the Potomac - I don't think there is access near the confluence,but you can go on down the Potomac a mile or so and make a long carry up to woodmont rd.! **NOTE:** The conditions near the confluence are different every time I go there!\n\n2.12' = 251 cfs; 2.5' = 400 cfs; 2.88' = 546 cfs; 3.01' = 605 cfs; 4.2' = 1,300 cfs; 5.0' = 1,800 cfs; 5.7' = 2,500 cfs; 6.6' = 3,000 cfs.","averageGradient":"15","maxGradient":null,"length":"24","correlations":[{"reachID":"749","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1.9","beginMediumRunnable":"2.2","beginHighRunnable":"5","endHighRunnable":"6.6"},"gaugeInfo":{"name":"SIDELING HILL CREEK NEAR BELLEGROVE, MD","gaugeSource":"USGS","gaugeSourceIdentifier":"01610155","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"20","dateTime":"2026-05-12T03:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"0.77","dateTime":"2026-05-12T03:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"39.64952778","longitude":"-78.344138