[{"result":{"data":{"json":{"id":"1849","stub":{"id":"1849","section":"01. to Millsite Reservoir","altname":"","river":"Ferron Creek, lower","difficulty":"IItoIV","states":["USA-UTA"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"37","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"112628","location":{"latitude":"39.12","longitude":"-111.252"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"access","description":"After the sharp left turn, is a possible takeout if you want to keep the run to class 2+/3-. The rapids pick up after here.","id":"102956","location":{"latitude":"39.10533142089844","longitude":"-111.2281265258789"},"name":"easier takeout","distance":"1.8","photoID":"0","difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"117914","location":{"latitude":"39.104","longitude":"-111.218"},"name":"Take Out","distance":"2.4","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"882085","ext":"jpeg","post_id":"884764","description":"Good times on Ferron Creek, photo by Becky Margraf. ","caption":"","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/882085","large":"https://api.americanwhitewater.org/image/images/big/882085"}}],"detail":{"id":"1849","permitUrl":"","permitInfo":"","description":"Another nice desert creek, worth doing if its over 300. Can be bank scouted a short walk from the road, like at the concrete dip in the road. Take a look for wood the first time down in the spring. A touch easier than Cottonwood Creek, but can still pack a punch at higher water, and, although its less forested than Huntington, wood will move after a high water event. IV- above 350.\n\nPutting in as high as possible before the road turns away from the creek, at Stevens Creek on the map, is possible, but rarely done because there is usually riverwide wood, and comparatively flat water for the first 1.5 miles. Putting in at a paved bridge makes for a nice 2.4 mile run, and that is what is shown now on the map. Putting in at Stevens Creek would make the run 4.0 miles (measured on the road). You can run all the way down to the reservoir, but expect a more muddy, buggy takeout.","averageGradient":"72","maxGradient":"0","length":"2.8","correlations":[{"reachID":"1849","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":"IItoIIIplus","highRunnableAdjustedDifficulty":null,"beginLowRunnable":"250","beginMediumRunnable":"300","beginHighRunnable":"500","endHighRunnable":"1000"},"gaugeInfo":{"name":"FERRON CREEK (UPPER STATION) NEAR FERRON, UT","gaugeSource":"USGS","gaugeSourceIdentifier":"09326500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"37","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"6.02","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"39.1049972","longitude":"-111.2289917"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/09326500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/09326500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":"Gauge (138 sq.mi. drainage) is at the take-out for this reach, thus should accurately show actual flow in this reach.","status":{"status":"below-recommended","latestReading":{"value":"37","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["112628","102956","