[{"result":{"data":{"json":{"id":"220","stub":{"id":"220","section":"4) Slippery Rock to Miracle (Jungle Run)","altname":"","river":"Kern","difficulty":"IItoIII","states":["USA-CAL"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"111358","location":{"latitude":"35.639198","longitude":"-118.484001"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":null,"id":"5756","location":{"latitude":"35.62289810180664","longitude":"-118.48999786376953"},"name":"Wallow Rock","distance":"1","difficulty":null,"approximate":false,"photoID":"0"},{"type":"rapid","description":null,"id":"5757","location":{"latitude":"35.60029983520508","longitude":"-118.49700164794922"},"name":"Dilly / Nippopotamus","distance":"2.5","difficulty":"III","approximate":false,"photoID":"0"},{"type":"rapid","description":null,"id":"5758","location":{"latitude":"35.59980010986328","longitude":"-118.50199890136719"},"name":"Oscar's Nightmare","distance":"3","difficulty":"III","approximate":false,"photoID":"0"},{"type":"access","description":"River Access","id":"5759","location":{"latitude":"35.58190155029297","longitude":"-118.5270004272461"},"name":"Sandy Flat","distance":"6","photoID":"0","difficulty":null,"approximate":false},{"type":"other","description":"Borel Powerhouse (FERC P-382). This hydropower plant has an installed capacity of 12 MW and predates the construction of Isabella Dam. At the time Isablla Dam was constructed, SCE modified the Borel Canal and added a new intake structure.","id":"Yf9uwzcaFAmelmVyS310G","location":{"latitude":"35.587878","longitude":"-118.524868"},"name":"Borel Powerhouse","distance":"6.83","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":null,"id":"5760","location":{"latitude":"35.57509994506836","longitude":"-118.52899932861328"},"name":"Hobo Rapid","distance":"7","difficulty":"III","approximate":false,"photoID":"0"},{"type":"takeout","description":null,"id":"116627","location":{"latitude":"35.575802","longitude":"-118.531998"},"name":"Take Out","distance":"8","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"39649","ext":"jpeg","post_id":"2772","description":"Lake Isabella stores the spring runoff and then releases water for irrigation throughout the summer.  A minimum \"fish\" flow of 25 to 50 cfs is released into the natural channel from the main dam, which is about one kilometer from this picture.  The next 600 cfs is released through the auxiliary dam into the Borel Canal, both pictured here.    This canal delivers water to the Borel Powerhouse and then back into the natural river channel, bypassing the 6 miles of river between the main dam and the powerhouse.  Once releases exceed the 600 cfs capacity of the powerhouse, the excess is released into the river  from the main dam.   There is also  a small powerhouse at the main dam operated by a separate company which generates power from the fish release and larger releases.  ","caption":"Borel Canal","poi_name":"","subject":"","author":"Paul Martzen","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/39649","large":"https://api.americanwhitewater.org/image/images/big/39649"}},{"id":"39654","ext":"jpeg","post_id":"2772","description":"View south from the keysville put-in launching area.   ","caption":"Keysville view","poi_name":"","subject":"","author":"Paul Martzen","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/39654","large":"https://api.americanwhitewater.org/image/images/big/39654"}},{"id":"39653","ext":"jpeg","post_id":"2771","description":"Map of the river from the dam to Miracle Hot Springs.   This one is posted at the Keysville put in.  ","caption":"39653.jpeg","poi_name":"","subject":"","author":"Paul Martzen","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/39653","large":"https://api.americanwhitewater.org/image/images/big/39653"}},{"id":"39651","ext":"jpeg","post_id":"2772","description":"Rock formations near the start of section.  ","caption":"39651.jpeg","poi_name":"","subject":"","author":"Paul Martzen","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/39651","large":"https://api.americanwhitewater.org/image/images/big/39651"}},{"id":"39652","ext":"jpeg","post_id":"2772","description":"Rock formations near the put-in.","caption":"Kern; rock formations-2","poi_name":"","subject":"","author":"Paul Martzen","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/39652","large":"https://api.americanwhitewater.org/image/images/big/39652"}}],"detail":{"id":"220","permitUrl":"","permitInfo":"","description":"This section of the lower Kern is easier than the downstream [Miracle  to Democrat](https://www.americanwhitewater.org/content/River/detail/id/221/) section and equally scenic. The river flows past low granite cliffs in a narrow but deep bedrock channel. There are long sections of flatwater paddling, broken up by some class 2 rapids, but there are also several serious class 3 to 3+ rapids.\n\n**Other Information Sources:**\n\n[Dreamflows guides:  Kern - Jungle Run](http://www.dreamflows.com/guides/Kern/JungleRun/index.php)\n\n[Camping](http://www.kernvalley.com/news/kerncamp.htm)\n\n[Wikipedia](http://en.wikipedia.org/wiki/Kern_River)\n\n[Kern River Festival](http://www.kvrc.org/festival.htm)\n\n[Kern River Alliance](http://www.kernriver.org/)\n\n[Kern Valley River Council](http://www.kvrc.org/)\n\n[Audubon, Kern River Preserve](http://kern.audubon.org/bioregion.htm)\n\n[Wild and Scenic Kern](http://www.americanwhitewater.org/content/River/detail/content/River_detail_id_219_)\n\n[Sequoia National Forest](http://www.fs.fed.us/r5/sequoia/) Kernville office phone # 760-376-3781\n\n[Lower Kern Guide Book - Jungle Run Section](https://www.kernriverrafting.com/kern-river-guide/lower-kern/#junglerun)\n\nCassady & Calhoun, Martin, Alan Baty\n\n**Links to important documents:**\n\n[Extension of Time for boating release agreement.](http://elibrary.ferc.gov/idmws/nvcommon/NVViewer.asp?Doc=11116993:0)\n\n[Objections of Kern Water Users to boating flows](http://elibrary.ferc.gov/idmws/nvcommon/NVViewer.asp?Doc=11065085:0)\n\n[New license doucument, Granted May 17, 2008](http://elibrary.ferc.gov/idmws/file_list.asp?document_id=4405003)\n\n[Army Corp objections to boating releases](http://elibrary.ferc.gov/idmws/nvcommon/NVViewer.asp?Doc=10565686:0)\n\n[Comments by American Whitewater and Sierra Club](http://elibrary.ferc.gov/idmws/nvcommon/NVViewer.asp?Doc=10564666:0)\n\nThe 2006 Order requires a minimum instream fish release ranging from 25 cubic feet per second (cfs) to 60 cfs, depending upon the time of year. However, because the original intake works of the Borel Project have been inundated by the storage in the Isabella Reservoir, the fish releases from Isabella Reservoir are under the control of the Corps and the Isabella Partners Hydro Project (FERC Project No. 8377), located at the base of the Isabella main dam. Therefore, these flow releases are made on behalf of the licensee by an agreement signed by the licensee and the Corps on April 23, 1999, as amended on September 1, 2006, and by Isabella Partners (IP) under the direction of the Corps.","averageGradient":null,"maxGradient":null,"length":"8.1","correlations":[{"reachID":"220","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"300","beginMediumRunnable":"600","beginHighRunnable":"1500","endHighRunnable":"4000"},"gaugeInfo":{"name":"Kern Above Borel Powerhouse","gaugeSource":"DREAM","gaugeSourceIdentifier":"473","gaugeFetchStatus":"ARCHIVED","latestFlowReading":null,"latestStageReading":null,"location":{"latitude":"30","longitude":"30"},"externalSourceLinks":{"sourceLink":{"url":"https://www.dreamflows.com/graphs/day.473.php","text":"Dream Flows"}}},"migrationErrorExplanation":null,"comment":null,"status":null}],"pointOfInterestIDs":["111358","5756","5757","5758","5759","Yf9uwzcaFAmelmVyS310G","5760","116627"],"geometry":{"type":"LineString","coordinates":[[-118.48391840319475,35.63877063905519],[-118.4840289265294,35.63874927801493],[-118.4845247931953,35.63887401134804],[-118.48465479319509,35.638848811348055],[-118.48496692652795,35.638972278014535],[-118.48518352652759,35.63893041134793],[-118.48531499319402,35.63875787801487],[-118.48526279319414,35.63858427801517],[-118.48504772652778,35.63847881134865],[-118.48479092652822,35.638234478015704],[-118.48469692652833,35.63792181134954],[-118.48482839319485,35.63774941134977],[-118.48491072652803,35.637108678017455],[-118.48543672652721,35.6364188780185],[-118.48565792652686,35.63593507801926],[-118.4860419265263,35.63538301135344],[-118.48651332652555,35.63523367802037],[-118.48694479319153,35.635178211353775],[-118.48703819319137,35.63516467802049],[-118.48747572652405,35.63519741135377],[-118.48793359319002,35.63521927802037],[-118.48803732652318,35.6352168780204],[-118.48805680568985,35.63520536656205],[-118.48812332652307,35.63517067802047],[-118.48821459318957,35.63510967802057],[-118.48823912652284,35.63506847802063],[-118.48823239318955,35.634992478020706],[-118.48815219318965,35.63488221135424],[-118.48812719318973,35.63479907802105],[-118.48812552652304,35.63473467802112],[-118.48815939318966,35.63464421135461],[-118.48856199318902,35.634160678022],[-118.48869652652218,35.63369361135608],[-118.48896992652173,35.633383478023234],[-118.48916559318809,35.