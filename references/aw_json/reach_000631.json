[{"result":{"data":{"json":{"id":"631","stub":{"id":"631","section":"E) Murtaugh Bridge to Twin Falls Reservoir - (The Murtaugh)","altname":"","river":"Snake","difficulty":"IIItoIVstandoutV","states":["USA-IDA"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"110831","location":{"latitude":"42.499175","longitude":"-114.151901"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"116098","location":{"latitude":"42.587581","longitude":"-114.352948"},"name":"Take Out","distance":"13","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"14953","ext":"jpeg","post_id":"9381","description":"","caption":"","poi_name":"Unknown","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/14953","large":"https://api.americanwhitewater.org/image/images/big/14953"}},{"id":"1439","ext":"jpeg","post_id":"3957","description":"","caption":"Paradise","poi_name":"Paradise","subject":"Dave Garrity","author":"Pete Sholander","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1439","large":"https://api.americanwhitewater.org/image/images/big/1439"}},{"id":"14955","ext":"jpeg","post_id":"9380","description":"","caption":"Let's Make A Deal","poi_name":"Let's Make A Deal","subject":"","author":"Paul Abraszewski","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/14955","large":"https://api.americanwhitewater.org/image/images/big/14955"}},{"id":"14954","ext":"jpeg","post_id":"9381","description":"","caption":"","poi_name":"Misty Falls","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/14954","large":"https://api.americanwhitewater.org/image/images/big/14954"}},{"id":"889774","ext":"jpeg","post_id":"892284","description":"Chad Maxwell and John Dewell avoid the retainer on river right","caption":"Duck Blind","poi_name":"Duck Blind","subject":"","author":"Eric Simon","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/889774","large":"https://api.americanwhitewater.org/image/images/big/889774"}},{"id":"887588","ext":"jpeg","post_id":"890370","description":"Toilet Hole in the Connection Rapid. 21,000 cfs. Easy to miss. Great eddy service on this feature for catching big air, until you time it wrong.\n\nUpdated map with pins for the Murtaugh: https://www.google.com/maps/d/edit?mid=1UDNGqpXG4ZJ3p9U_2kRn57qMkZGsddk&usp=sharing","caption":"21,000 cfs","poi_name":null,"subject":null,"author":"Justin Smith","poi_id":null,"photo_date":"2017-04-15T01:07:07.000Z","updated_at":"2024-03-04T01:07:07.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887588","large":"https://api.americanwhitewater.org/image/images/big/887588"}},{"id":"887589","ext":"jpeg","post_id":"890371","description":"Updated map with pins for the Murtaugh: https://www.google.com/maps/d/edit?mid=1UDNGqpXG4ZJ3p9U_2kRn57qMkZGsddk&usp=sharing\n\nLet's Make A Deal at 19,000 cfs. The \"doors\" are the lower 5 channels in between the 4 rock pillars. The two large upstream islands (bottom of the photo) are not part of the \"doors.\" Numbers start counting from the left. Door 1 is always a no go. Channel wide sticky hole at most flows. Door 2 is always the safest option when there is enough water. Door 3 can be run if you miss the bus sized hole below it. Door 4 also contains a channel wide sticky hole. Could be possibly run at lower flows. Door 5 is the farthest right run. It is the only option when flows get under approximately 4,000 or 5,000 cfs and is run within feet of the right shore. The rapid can be scouted from the top of fantasy island (The big island above the rapid in the center of the river). Land on the gravel bar on the upstream side of the island and climb to the top. The safest high water line is just to the right of fantasy island (not too close, there's a hole) and over into door 2. The red line in the photo shows this line starting from the scout location.","caption":"Let's Make A Deal-19,000 cfs.","poi_name":"","subject":"","author":"Justin Smith","poi_id":null,"photo_date":"2017-04-15T17:00:49.000Z","updated_at":"2024-04-02T17:00:49.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887589","large":"https://api.americanwhitewater.org/image/images/big/887589"}}],"detail":{"id":"631","permitUrl":"","permitInfo":"","description":"The Murtaugh Canyon, a classic run on the Snake River, featuring Pair-A-Dice, Let's Make a Deal and Idaho Connection.\n\nThis is a big desert river with ledge drops, big waves and holes. Idaho Connection features some of the best surfing anywhere.\n\nThe river gets very rocky, and steep below 5,500 cfs, but kayakers can run it lower down to around 1,200 cfs. It has been survived above 36,000 cfs.\n\nThe character of the river and lines through the rapids change dramatically with flows. In fact, Murtaugh is often described as three rivers in one, because of its three inner canyons that are either exposed or inundated as flows change.\n\nThere are many dangerous ledge holes throughout this run. All are easy to avoid if you know where they are.\n\nThe locals refer to the Milner combined gauge on the Idaho Power website.","averageGradient":null,"maxGradient":null,"length":"13.3","correlations":[{"reachID":"631","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1000","beginMediumRunnable":"3500","beginHighRunnable":"7700","endHighRunnable":"27000"},"gaugeInfo":{"name":"Snake At Milner Total Flow","gaugeSource":"DREAM","gaugeSourceIdentifier":"153","gaugeFetchStatus":"ARCHIVED","latestFlowReading":null,"latestStageReading":null,"location":{"latitude":"30","longitude":"30"},"externalSourceLinks":{"sourceLink":{"url":"https://www.dreamflows.com/graphs/day.153.php","text":"Dream Flows"}}},"migrationErrorExplanation":null,"comment":null,"status":null}],"pointOfInterestIDs":["110831","116098"],"geometry":{"type":"LineString","coordinates":[[-114.152042,42.498973],[-114.152143,42.499043],[-114.152389,42.499142],[-114.152874,42.4992],[-114.153597,42.499532],[-114.153893,42.499914],[-114.154199,42.500375],[-114.154893,42.500956],[-114.155047,42.501305],[-114.155583,42.501632],[-114.155868,42.50189],[-114.156892,42.502668],[-114.157248,42.503242],[-114.15748,42.503718],[-114.157964,42.504263],[-114.159216,42.505643],[-114.160171,42.507015],[-114.160357,42.507584],[-114.161166,42.508451],[-114.162362,42.509171],[-114.163563,42.509797],[-114.16481,42.510361],[-114.165851,42.510763],[-114.166595,42.511189],[-114.168464,42.512051],[-114.16949,42.512797],[-114.171559,42.514856],[-114.172589,42.516449],[-114.172881,42.517492],[-114.172928,42.517869],[-114.17344,42.518729],[-114.174193,42.520849],[-114.174536,42.522645],[-114.174743,42.523685],[-114.174871,42.524598],[-114.174972,42.525196],[-114.174994,42.525636],[-114.175071,42.525826],[-114.175673,42.527503],[-114.176155,42.528111],[-114.176542,42.528936],[-114.176947,42.529353],[-114.177801,42.530629],[-114.179261,42.532108],[-114.179997,42.532722],[-114.181272,42.5336],[-114.182341,42.534348],[-114.184128,42.535144],[-114.185291,42.535706],[-114.185788,42.535969],[-114.186907,42.53653],[-114.188534,42.537134],[-114.189448,42.537565],[-114.18974,42.537666],[-114.190568,42.538125],[-114.191314,42.53852],[-114.192024,42.538757],[-114.193138,42.539443],[-114.194842,42.540237],[-114.196871,42.541322],[-1