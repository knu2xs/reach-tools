Ki5QXjGLfbfYrdVT","description":"","caption":"","poi_name":null,"subject":"","author":"Dave Steindorf","poi_id":null,"photo_date":"2019-12-03T01:32:05.000Z","updated_at":"2022-05-03T01:32:06.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/0fkBlrL51n5OHj5WWrUdM","large":"https://api.americanwhitewater.org/image/images/big/0fkBlrL51n5OHj5WWrUdM"}},{"id":"WWQNh0t1IyPAtRNTVTDjw","ext":"jpg","post_id":"EKkXdKi5QXjGLfbfYrdVT","description":"","caption":"","poi_name":null,"subject":"","author":"Dave Steindorf","poi_id":null,"photo_date":"2019-12-03T01:42:40.000Z","updated_at":"2022-05-03T01:42:40.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/WWQNh0t1IyPAtRNTVTDjw","large":"https://api.americanwhitewater.org/image/images/big/WWQNh0t1IyPAtRNTVTDjw"}},{"id":"LV6WFZf02TRLblgGtqKjf","ext":"jpg","post_id":"EKkXdKi5QXjGLfbfYrdVT","description":"The scenery on this run is truly unique.","caption":"Castles and Towers","poi_name":null,"subject":"Dave Steindorf","author":"Dave Steindorf","poi_id":null,"photo_date":"2019-12-03T01:42:40.000Z","updated_at":"2022-05-03T01:42:40.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/LV6WFZf02TRLblgGtqKjf","large":"https://api.americanwhitewater.org/image/images/big/LV6WFZf02TRLblgGtqKjf"}},{"id":"QqeggwDDxaC7kKQJMyCa2","ext":"jpg","post_id":"EKkXdKi5QXjGLfbfYrdVT","description":"Miles of this kind of thing.","caption":"Typical Fun Deer Creek Whitewater","poi_name":null,"subject":"Martin Roland","author":"Dave Steindorf","poi_id":null,"photo_date":"2019-12-03T01:42:40.000Z","updated_at":"2022-05-03T01:42:40.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/QqeggwDDxaC7kKQJMyCa2","large":"https://api.americanwhitewater.org/image/images/big/QqeggwDDxaC7kKQJMyCa2"}},{"id":"pXuXocJNTlaH8B5O12LNC","ext":"jpg","post_id":"9Y6B3jkddDTuvQ3RSsjSv","description":"Longer rapid in this Class IV series at the top","caption":"Amazing Race","poi_name":null,"subject":"","author":"Dave Steindorf","poi_id":"107200","photo_date":"2022-04-23T20:43:43.000Z","updated_at":"2022-05-04T20:43:43.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/pXuXocJNTlaH8B5O12LNC","large":"https://api.americanwhitewater.org/image/images/big/pXuXocJNTlaH8B5O12LNC"}},{"id":"HEH8i2SRKIwTEQyLja7tr","ext":"jpg","post_id":"9Y6B3jkddDTuvQ3RSsjSv","description":"Fun single move drop.  Hug the boulder on the right and it is all good.","caption":"Hoodoo You Love","poi_name":null,"subject":"Tessa Coffee","author":"Dave Steindorf","poi_id":null,"photo_date":"2022-04-23T20:43:43.000Z","updated_at":"2022-05-04T20:43:43.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/HEH8i2SRKIwTEQyLja7tr","large":"https://api.americanwhitewater.org/image/images/big/HEH8i2SRKIwTEQyLja7tr"}}],"detail":{"id":"176","permitUrl":"","permitInfo":"","description":"Deer Creek has the lore of the Ishi Wilderness hemmed in by basalt and poison oak. The rapids are tasty and the window on this run is limited which is best enjoyed as a multi-day expedition. Deer Creek flows through the land of the Yahi Yana people cutting into some beautiful remote areas with thick chaparral vegetation and mini-canyons. Deer Creek sits in the Lassen National Forest and holds some unique geology and whitewater.\n\nThis lower section of Deer Creek starts off with a bang, with several Class IV rapids that start about a half mile below the bridge. After the first mile and a half of Class IV you will find miles of boat-scoutable class III and easy IVs.  The one exception is the Black Tower.  This rapid has changed over the years and has become a jumbled up mess that is notorious for collecting wood. There are several incidents of boats being pinned in this rapid  (see reports below). The rapid is very recognizable by the large black lava rock tower in the river.\n\nThe crux of the run is Ishi Falls at river mile 8. A straight forward slot is just above Ishi Falls.  Be careful not to get tempted into the falls before scouting. From here to the take-out are miles of very pleasant, mostly boat-scoutable class III and IV rapids.  One rock jumble, Camp Rapid, is often run on the right, but even that line is junky.\n\nGradually, the run transitions into an open lava-cliffed canyon, with several narrow lava channels. The cliffs build until you break out into the valley. The hour and a half of flat braided channels in the valley is not the best part of the run, but a small price to pay for an amazing experience.\n\nBe advised that most of the lower part of this river runs through private property.  Please be respectful.  Also be advised that an  easement allows public access on either side of the Leininger Road bridge.  Paddlers have been challenged when using this access in the past.  Be polite but clear that you have the right to exit the river at that location.","averageGradient":null,"maxGradient":null,"length":"23.7","correlations":[{"reachID":"176","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"400","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"1000"},"gaugeInfo":{"name":"DEER C NR VINA CA","gaugeSource":"USGS","gaugeSourceIdentifier":"11383500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"269","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.59","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"40.0140214","longitude":"-121.9482872"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/11383500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/11383500/#parameterC