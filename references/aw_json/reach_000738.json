[{"result":{"data":{"json":{"id":"738","stub":{"id":"738","section":"0.8 Potoma Wayside, VA or Weverton, MD to Point of Rocks MD","altname":"","river":"Potomac","difficulty":"ItoII","states":["USA-MRY","USA-VRG"]},"primaryGaugeStatus":{"status":"low-runnable","latestReading":{"value":"1.39","dateTime":"2026-05-12T02:55:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Potoma Wayside, located on the Virginia side of the Potomac Rt. 340 bridge.","id":"112030","location":{"latitude":"39.321135","longitude":"-77.713626"},"name":"Put In - Potomac Wayside","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"access","description":"'Weverton' is roughly 2 miles of flat and moving water downstream from the US 340  bridge on the Maryland side.  This take-out is hard to see from the river and requires a long walk through the woods and down the tow-path, but it does have an authorized on foot at-grade railroad crossing.","id":"B9mMTXAEtuwWkNgAJ262y","location":{"latitude":"39.327749","longitude":"-77.68068"},"name":"Weverton river access","distance":"2.17","photoID":null,"difficulty":"N/A","approximate":false},{"type":"access","description":"The Brunswick river access on the Maryland side (on the river side of the railroad tracks under the Brunswick Bridge) has considerable parking and is 5 miles down from Potomac Wayside.","id":"7FkWMjQn3jxDP32wXdPSA","location":{"latitude":"39.310868","longitude":"-77.630678"},"name":"Brunswick River Access","distance":"5.27","photoID":null,"difficulty":"N/A","approximate":false},{"type":"access","description":"The next landing is at Lander Road, roughly 4 miles below Brunswick and 9 miles below Potomac Wayside which is also just below the mouth of the Maryland Catoctin Creek.","id":"UI7kGNSvhKaNcHJhqUh8X","location":{"latitude":"39.305247","longitude":"-77.560706"},"name":"Lander Road Access","distance":"9.22","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"The take-out of this section is at Point of Rocks, MD, 12 miles below Potoma Wayside.","id":"117307","location":{"latitude":"39.272924","longitude":"-77.541716"},"name":"Take Out - Point of Rocks","distance":"11.89","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"880134","ext":"jpeg","post_id":"881243","description":"The shot is the Potomac below the confluence.  It's the first rapid you come to in the section above White Horse Rapid. ","caption":"Coming off the little wave just past the confluence","poi_name":"","subject":"Shawn Duffy","author":"Laura Duffy","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880134","large":"https://api.americanwhitewater.org/image/images/big/880134"}},{"id":"14566","ext":"jpeg","post_id":"9353","description":"","caption":"Steve enjoying the Virginia Chute","poi_name":"Virginia Chute","subject":"Rob Naeser","author":"Rob Naeser","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/14566","large":"https://api.americanwhitewater.org/image/images/big/14566"}}],"detail":{"id":"738","permitUrl":"","permitInfo":"","description":"The putin is at Potoma Wayside, located on the Virginia side of the Potomac Rt. 340 bridge. This popular access point is very busy.  This is a mild whitewater section of the Potomac that can be combined with either the [Needles section of the Potomac](http://www.americanwhitewater.org/content/River/view/river-detail/3289/) or the [Millville/Bull Falls/Staircase](http://www.americanwhitewater.org/content/River/view/river-detail/2441/) sections of the Shenandoah for a longer run.  The Brunswick river access on the Maryland side has considerable parking and is 5 miles down from Potomac Wayside.  The next landing is at Lander Road, roughly 4 miles below Brunswick and 9 miles below Potomac Wayside which is also the mouth of the Maryland Catoctin Creek.  About  1/3 mile below Lander Road (9.3 miles below Potoma Wayside), is the Bald Eagle Island C&O hiker/biker campground.  The take-out of this section is at Point of Rocks, MD, 12 miles below Potoma Wayside.","averageGradient":null,"maxGradient":null,"length":"12","correlations":[{"reachID":"738","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"0.5","beginMediumRunnable":"1.7","beginHighRunnable":"4.6","endHighRunnable":"8.6"},"gaugeInfo":{"name":"POTOMAC RIVER AT POINT OF ROCKS, MD","gaugeSource":"USGS","gaugeSourceIdentifier":"01638500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"2730","dateTime":"2026-05-12T02:55:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.39","dateTime":"2026-05-12T02:55:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"39.2735833","longitude":"-77.5431111"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/01638500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/01638500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":" ","status":{"status":"low-runnable","latestReading":{"value":"1.39","dateTime":"2026-05-12T02:55:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null}}],"pointOfInterestIDs":["112030","B9mMTXAEtuwWkNgAJ262y","7FkWMjQn3jxDP32wXdPSA","UI7kGNSvhKaNcHJhqUh8X","117307"],"geometry":{"type":"LineString","coordinates":[[-77.713626,39.321135],[-77.713627,39.321135],[-77.713723,39.321218],[-77.713723,39.321218],[-77.71382,39.3216],[-77.713798,39.322289],[-77.713798,39.322289],[-77.712994,39.322961],[-77.712994,39.32296