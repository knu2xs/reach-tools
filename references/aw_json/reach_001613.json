[{"result":{"data":{"json":{"id":"1613","stub":{"id":"1613","section":" SR 1059 to Susquehanna R.","altname":"","river":"Harveys Creek","difficulty":"IItoIV","states":["USA-PEN"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"112287","location":{"latitude":"41.263599395752","longitude":"-76.0339965820312"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"117569","location":{"latitude":"41.2196006774902","longitude":"-76.0160980224609"},"name":"Take Out","distance":"6.5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"101248712","title":null,"post_date":"2011-09-08 04:00:00+00","detail":"We just ran Harveys creek yesterday 9/7/11 as it was rising into the flood stage level. Very fun run even at high water levels for more experienced kayakers , however i wanted to leave a note stating that there are several strainers. The most recent one and of the more dangerous one's that required us to portage around, was just down river of what we call \"the third drop\" ( the one right after/near a cement Patio with a hand railing on river left). There also was a second serious strainer down river where it begins to narrow and parallel the road. See ya out there.","user":{"name":"David Barachie"}}],"photos":[{"id":"873574","ext":"jpeg","post_id":"873575","description":"Eric Sorenson boofing double drop... photo by Mark Z.","caption":"Double Drop lower water","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/873574","large":"https://api.americanwhitewater.org/image/images/big/873574"}},{"id":"873579","ext":"jpeg","post_id":"873580","description":"Lowish water, but still good...the large slab at the top of the slide forms a pretty bad sieve...enter the slide on FAR river left.","caption":"Dave M. surfing the hole below the