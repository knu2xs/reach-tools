[{"result":{"data":{"json":{"id":"518","stub":{"id":"518","section":"Big Creek Airstrip to Cache Bar, Middle Fork of Salmon","altname":"","river":"Big Creek (Tributary of Middle Fork Salmon River)","difficulty":"IIItoIV","states":["USA-IDA"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"109792","location":{"latitude":"45.1306","longitude":"-115.32"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"115044","location":{"latitude":"45.291401","longitude":"-114.609001"},"name":"Take Out","distance":"54","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"101251464","title":null,"post_date":"2017-06-30 04:00:00+00","detail":"A rain-on-snow event in early 2014 created multiple avalanches that delivered hundreds of logs into the channel in the upper reaches between Smith Creek and Beaver Creek. The past jams are visible in Google Earth but were remobilized in early 2017, currently channel-spanning at the Beaver Creek confluence. Though the wood poses a hazard in this reach at this time, the pulse of wood will continue to mobilize downstream (potentially reforming jams or single spanners) in the next few years. The good news is that portaging these sections is easily done using the riverside trail. Be careful.\n\nAlso, note that in the lower reaches of Big Creek downstream of Cabin Creek, just below Rush Creek there is a large pontoon-based fish screw located in the center of the channel. There are warning signs as you approach. --Ben Crosby","user":{"name":"Benjamin Crosby"}}],"photos":[{"id":"11537","ext":"jpeg","post_id":"7707","description":"","caption":"Big Creek","poi_name":"","subject":"Brian Lee","author":"Anthony Smith","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/11537","large":"https://api.americanwhitewater.org/image/images/big/11537"}},{"id":"1