[{"result":{"data":{"json":{"id":"1999","stub":{"id":"1999","section":"2. Remington (Route 15/29) to Kellys Ford","altname":"","river":"Rappahannock","difficulty":"IIplus","states":["USA-VRG"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"3.06","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"There is a new Remington Rappahannock access, on the north side of the river, downstream from the \"old\" put-in and upstream from the railroad bridge.  It is very easy to access the new put-in, from business 15 south, bear left on River road, just past the Andes store.  The put-in is at the end of the road.","id":"110029","location":{"latitude":"38.529061","longitude":"-77.812775"},"name":"Put In - Remington","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":"'Sandy Beach' Rapids is the largest rapid (Class II+) on this section of the river.  This rapid can be bank scouted on river right.  The actual sandy beach is posted no trespassing and located below the rapid on river left.","id":"VPEqKf4Q3OrZ9MJmyZkkB","location":{"latitude":"38.488246","longitude":"-77.785718"},"name":"Sandy Beach Rapid","distance":"3.52","difficulty":"II+","approximate":false,"photoID":"10535"},{"type":"rapid","description":"As you go through 'Piggly Wiggly' rapid, the Kellys Ford bridge swings into view.","id":"jvezAXUMGcuj41Mb26Xne","location":{"latitude":"38.481493","longitude":"-77.780658"},"name":"Piggly Wiggly Rapid","distance":"4.27","difficulty":"II+","approximate":false,"photoID":"634139"},{"type":"takeout","description":"The take-out is at Kelly's Ford on river right at the public boat ramp parking lot","id":"115284","location":{"latitude":"38.477151","longitude":"-77.780758"},"name":"Take Out - Kelly's Ford","distance":"4.59","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"10534","ext":"jpeg","post_id":"8439","description":"","caption":"RR waves","poi_name":"Sandy Beach","subject":"Otter","author":"Chris B","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10534","large":"https://api.americanwhitewater.org/image/images/big/10534"}},{"id":"43002","ext":"jpeg","post_id":"8342","description":"","caption":"Sandy at 3'","poi_name":"sandy Beach","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/43002","large":"https://api.americanwhitewater.org/image/images/big/43002"}},{"id":"3136","ext":"jpeg","post_id":"3078","description":"David Colby runs Sandy Beach Rapids, one of the larger drops on this section of the Rappahannock. ","caption":"Sandy Beach Rapids","poi_name":"Sandy Beach Rapids","subject":"David Colby","author":"RC Forney","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3136","large":"https://api.americanwhitewater.org/image/images/big/3136"}},{"id":"10535","ext":"jpeg","post_id":"8439","description":"","caption":"Waves on RR","poi_name":"Sandy Beach","subject":"Otter","author":"Chris B","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10535","large":"https://api.americanwhitewater.org/image/images/big/10535"}},{"id":"10533","ext":"jpeg","post_id":"8439","description":"about 10 feet infront of me is the hole.","caption":"Wave train, bottom of rr sandy beach","poi_name":"Sandy Beach","subject":"Otter","author":"Chris B","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10533","large":"https://api.americanwhitewater.org/image/images/big/10533"}},{"id":"634139","ext":"jpeg","post_id":"634137","description":"","caption":"Piggly Wiggly Rapid","poi_name":"","subject":"Piggly Wiggly Rapid","author":"Matthew Mens","poi_id":"jvezAXUMGcuj41Mb26Xne","photo_date":null,"updated_at":"2024-10-05T23:02:13.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/634139","large":"https://api.americanwhitewater.org/image/images/big/634139"}},{"id":"634063","ext":"jpeg","post_id":"634057","description":"","caption":"Rapids above the bridge @ Kellys Ford","poi_name":"","subject":"'Piggly Wiggly\" rapid","author":"Matthew Mens","poi_id":"jvezAXUMGcuj41Mb26Xne","photo_date":null,"updated_at":"2024-10-06T00:15:32.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/634063","large":"https://api.americanwhitewater.org/image/images/big/634063"}},{"id":"634110","ext":"jpeg","post_id":"634109","description":"above Kellys Ford takeout -play spot","caption":"","poi_name":"","subject":"","author":"Matthew Mens","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/634110","large":"https://api.americanwhitewater.org/image/images/big/634110"}},{"id":"886825","ext":"jpeg","post_id":"889584","description":"Might be Sandy Beach rapids at low water. I don't recall perfectly.\r\n\r\nTaken from river left on what is likely private property.","caption":"Rapids Above Kelly's Ford","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/886825","large":"https://api.americanwhitewater.org/image/images/big/886825"}},{"id":"10532","ext":"jpeg","post_id":"8439","description":"This hole burried me up to my chest. It is RR below the drop at sandy beach you will see a little boil right befor you get to it. Higher levels it might put you in over your head.","caption":"Otter getting in hole","poi_name":"Sandy Beach","subject":"Otter X","author":"Chris b","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10532","large":"https://api.americanwhitewater.org/image/images/big/10532"}}],"detail":{"id":"1999","permitUrl":"","permitInfo":"","description":"This one is fire and ice. It starts with 3 miles of moving flatwater through pastoral countryside, then ends with just over a mile of Class II+ whitewater at the end.  There is a new Remington Rappahannock put-in that is described below under River Features.  The first minor rapid, Railroad Rapids, can be seen 150 yards downstream.  The next three miles are flat but pretty, with 10 ft banks shielding you from the surrounding farmland.  On my last trip here I saw herons, turtles and a bald eagle.\n\nThe action starts after a gas pipeline crosses the river.  There is a very small drop here, and vegetation is partially cleared on both banks.  After a minor rock garden, you will approach 'Sandy Beach' Rapids, the largest rapid (Class II+) on this section of the river.  This rapid can be bank scouted on the right.  The actual sandy beach is posted and located below the rapid on river left.  You then pass through a succession of rock gardens as well as two more Class II rapids and one Class II+ ('Piggly Wiggly' rapid).  As you go through 'Piggly Wiggly' rapid, the Kellys Ford bridge swings into view.  Take out on river right at the public boat launch parking lot.  The adventurous can run the boat launch itself, a Class II move.\n\nBoth the putin and takeout were the scenes of minor Civil War skirmishes.  The Rappahannock served as a de facto border between the North and South during the war, and springtime flooding of the river complicated many a Northern general's plans.\n\n\\*An Alternative put-in exists 0.85 miles north of the take-out, on Kelly's Ford Road at the Wildlife Management Access.  This access involves a 0.45 mile walk down a gravel road, then take a left at the civil war monument and follow a 200 yard faint trail system down to the river. This will put you on  river right above Sandy Beach Rapid\n\n\\*Another alternative put-in exists - 0.48 miles north of the take-out on Summerduck road - at the Handi-cap Hunting Access.  This involves a 0.25 mile hike on winding trails down to the river.  This puts you at the river below Sandy Beach rapid, but a 0.25 hike/attain up the river will get you to Sandy Beach Rapid. River left, at and for a bit below Sandy beach, is private property, so ferry across to the Wildlife Management and walk if you don't want to attain.","averageGradient":"12","maxGradient":"12","length":"4.6","correlations":[{"reachID":"1999","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":"Below 3.8 feet it gets progressively boney in places.","mediumRunnableRangeComment":null,"highRunnableRangeComment":"The upper limit is a guess. Rapids are starting to wash out at these levels.","aboveRecommendedRangeComment":"At high levels, the rapids become big wave trains.","lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":"IItoIII","beginLowRunnable":"3.5","beginMediumRunnable":"3.85","beginHighRunnable":"5.5","endHighRunnable":"6.5"},"gaugeInfo":{"name":"RAPPAHANNOCK RIVER AT REMINGTON, VA","gaugeSource":"USGS","gaugeSourceIdentifier":"01664000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"185","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.06","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"38.5305957","longitude":"-77.8135912"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/01664000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/01664000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"3.06","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"le