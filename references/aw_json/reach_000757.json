[{"result":{"data":{"json":{"id":"757","stub":{"id":"757","section":"Allagash Lake to Chamberlain Lake","altname":"","river":"Allagash Stream","difficulty":"ItoII","states":["USA-MAI"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"108688","location":{"latitude":"46.334418","longitude":"-69.495496"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"113924","location":{"latitude":"46.312199","longitude":"-69.418602"},"name":"Take Out","distance":"5.5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"757","permitUrl":"","permitInfo":"\t\tPermits not required, but you will need to pay an access fee to the North Maine Woods Company.\t\t\r\n\r\n\r\n\r\n\r\n\r\n","description":"Allagash Stream has approximately 3 miles of scenic flatwater/Class I from Allagash Lake to Little Round Pond. As the river leaves Little Round Pond it flows over Little Allagash Falls (IV+), which is generally portaged by canoe trippers on river left. Little Allagash Falls looks runnable....should you find yourself deep in the AWW with a creek boat and some friends with throw bags.\n\nBelow Little Allagash Falls are 3 Class II ledge drops and a large standing wave. Most of the Class II whitewater is concentrated into a mile between Little Allagash Falls and a bridge that crosses the stream. Below the bridge Allagash Stream flattens out down to Churchill Lake.","averageGradient":null,"maxGradient":null,"length":"5.5","correlations":[],"pointOfInterestIDs":["108688","113924"],"geometry":{"type":"LineString","coordinates":[[-69.49552293498103,46.334507581509904],[-69.49536480256961,46.33455512807956],[-69.49511860256996,46.33468512807934],[-69.49487160257036,46.334910128079],[-69.4947190025706,46.334927528078936],[-69.49457480257081,46.334888528079034],[-69.4943318025712,46.334708128079285],[-69.49372080257217,46.3343509947465],[-69.49