[{"result":{"data":{"json":{"id":"1278","stub":{"id":"1278","section":"Zoar Bridge to Gowanda (Zoar Valley)","altname":"","river":"Cattaraugus Creek","difficulty":"IItoIII","states":["USA-NYO"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"2.84","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"111944","location":{"latitude":"42.4559","longitude":"-78.8118"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"playspot","description":"Three delicious playholes at the confluence with the S. Branch.","id":"101527","location":{"latitude":"42.43891143798828","longitude":"-78.89373016357422"},"name":"Curley, Larry, and Moe","distance":"5.6","difficulty":"II+","approximate":true,"photoID":"0"},{"type":"takeout","description":null,"id":"117218","location":{"latitude":"42.4652","longitude":"-78.9359"},"name":"Take Out","distance":"10","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"101249404","title":null,"post_date":"2012-05-25 04:00:00+00","detail":"Zoar Valley Rd from Springville to the put-in has reopened as of November 2011. Zoar Valley Rd now starts off of rt 39 just west of the 219 interchange in Springville.","user":{"name":"Jeff Wood"}},{"id":"100840369","title":null,"post_date":"2012-04-06 04:00:00+00","detail":"Is farmers field rapid still there? Is zoar valley road passable to gowanda Now. Any help\nZoar Valley Rd has been closed for going on 2 years, from a point just east of N. Otto Rd to a point just west of Hammond Hill rd., following the big flood which washed out a section. The only way I found in or out of the N Otto rd. put in was from Gowanda on the section of the Zoar Valley rd that was still open. Even N Otto rd was cut off by a bridge wash out, but may be open again now.\n\nAnyone heading over to Catt Creek? Do me a favor & drop me a line: caputi.bill@gmail.com. Thanks\n\nN Otto is bridge is open, 2.5 mi east from N Otto & ZVR is where the collapse is road is closed there.","user":null}],"photos":[{"id":"10878","ext":"jpeg","post_id":"1144","description":"","caption":"Crowd on Cattaraugus Creek","poi_name":"","subject":"","author":"Ron Turney","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10878","large":"https://api.americanwhitewater.org/image/images/big/10878"}},{"id":"10877","ext":"jpeg","post_id":"1144","description":"","caption":"Winter on Cattaraugus Creek","poi_name":"","subject":"","author":"Ron Turney","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10877","large":"https://api.americanwhitewater.org/image/images/big/10877"}},{"id":"50707","ext":"jpeg","post_id":"173950","description":"","caption":"Taking a break in the Gorge","poi_name":"","subject":"Harry Steele","author":"Rand McFarland (KHCC)","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/50707","large":"https://api.americanwhitewater.org/image/images/big/50707"}},{"id":"10001","ext":"jpeg","post_id":"1144","description":"For the full-sized version of this photo, <a href=\"http://www.americanwhitewater.org/photos/?photoid=10880\">click here</a>.","caption":"Winter on Cattaraugus Creek","poi_name":"","subject":"","author":"Ron Turney","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10001","large":"https://api.americanwhitewater.org/image/images/big/10001"}},{"id":"11614","ext":"jpeg","post_id":"7894","description":"","caption":"map of Cattaraugus Creek","poi_name":"","subject":"map","author":"Jonathan Janicki","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/11614","large":"https://api.americanwhitewater.org/image/images/big/11614"}},{"id":"10879","ext":"jpeg","post_id":"1144","description":"","caption":"Surfing on Cattaraugus Creek","poi_name":"","subject":"","author":"Ron Turney","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10879","large":"https://api.americanwhitewater.org/image/images/big/10879"}},{"id":"10880","ext":"jpeg","post_id":"1144","description":"","caption":"Winter on Cattaraugus Creek","poi_name":"","subject":"","author":"Ron Turney","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10880","large":"https://api.americanwhitewater.org/image/images/big/10880"}},{"id":"50706","ext":"jpeg","post_id":"173950","description":"","caption":"Waterfall in the Gorge","poi_name":"","subject":"","author":"H. Steele","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/50706","large":"https://api.americanwhitewater.org/image/images/big/50706"}}],"detail":{"id":"1278","permitUrl":"","permitInfo":"","description":"**Cattaraugus Creek** is a seasonal creek in the Lake Erie basin that flows through the magnificent 400-foot deep [Zoar Valley Gorge](http://members.dandy.net/~getchris/zoar/main.htm). This wild, isolated area contains the largest tract of old growth forest in New York outside of the Adirondack Mountains. The Zoar Valley has been opened to logging. Visit the [Friends of Zoar Valley](http://environment-buffalo.org/zoar/) for more information.\n\n**Directions**\n\nTo the putin:\n\nGo to Springville; head South on Rte. 219 to the traffic signal past McDonald's.\n\nTurn right at the signal onto Zoar Valley Road. (ZV Road has some steep ups and downs, but is paved.) Take this road to the second bridge over the creek (approx. 8 miles).\n\nTurn Left over the bridge; you will see a state fishing access area.\n\nThe trail is flat to the creek. This is the usual put in for the raft companies. Getting your boat from the putin lot to the creek is a very easy, wide, flat path, lined with large rocks.\n\nTo the takeout:\n\nGo back over the bridge; turn Left on Zoar Valley Road. Head toward Gowanda.\n\nYou will come to a fork; bear Left and follow the road past the Harley shop to Gowanda.\n\nYou will go over a railroad as you come into town; go left, then quick right.\n\nThis will take you to Main St.\n\nPark behind the super market (directly across Main St.). You'll see a park along the creek with a bike path. Take out on River Right, along the park. The bank at the takeout is slippery, a very short walk to the car.\n\n_(Directions adapted from a post by Dave Meyer on the [FLOW Massage Board](http://www.flowpaddlers.org/cgi-bin/yabb/YaBB.pl?board=news)._\n\n**Western New York Area Reaches**\n\n[Beaver Meadow Creek](https://www.americanwhitewater.org/content/River/detail/id/5749/) [Canadaway Creek (1.)](https://www.americanwhitewater.org/content/River/detail/id/6205/) [Canadaway Creek (2.)](https://www.americanwhitewater.org/content/River/detail/id/6246/)\n\n[Canaseraga Creek](https://www.americanwhitewater.org/content/River/detail/id/1270/) [Cattaraugus Creek](https://www.americanwhitewater.org/content/River/detail/id/1278/) [Cattaraugus Creek, S. Branch](https://www.americanwhitewater.org/content/River/detail/id/1277/)\n\n[Cazenovia Creek, W. Branch (1.)](https://www.americanwhitewater.org/content/River/detail/id/1279/)[Cazenovia Creek, W. Branch (2.)](https://www.americanwhitewater.org/content/River/detail/id/3987/) [Chautauqua Creek](https://www.americanwhitewater.org/content/River/detail/id/1283/)\n\n[Clear Creek, N. Br.](https://www.americanwhitewater.org/content/River/detail/id/5753/) [Conesus Creek](https://www.americanwhitewater.org/content/River/detail/id/5203/) [Eighteenmile Creek](https://www.americanwhitewater.org/content/River/detail/id/1299/)\n\n[Eighteenmile Creek, S. Br.](https://www.americanwhitewater.org/content/River/detail/id/5051/) [Ellicott Creek](https://www.americanwhitewater.org/content/River/detail/id/10882/) [Genesee (Letchworth)](https://www.americanwhitewater.org/content/River/detail/id/1308/)\n\n[Honeoye Creek](https://www.americanwhitewater.org/content/River/detail/id/1319/) [Keshequa Creek](https://www.americanwhitewater.org/content/River/detail/id/1331/) [Little Chautauqua Creek](https://www.americanwhitewater.org/content/River/detail/id/6245/)\n\n[Murder Creek](https://www.americanwhitewater.org/content/River/detail/id/4292/) [Niagara](https://www.americanwhitewater.org/content/River/detail/id/1360/) [Oak Orchard Creek](https://www.americanwhitewater.org/content/River/detail/id/1364/)\n\n[Oatka Creek](https://www.americanwhitewater.org/content/River/detail/id/1365/) [Rushford Lake Outlet](https://www.americanwhitewater.org/content/River/detail/id/1397/) [Sugar Creek](https://www.americanwhitewater.org/content/River/detail/id/2702/)\n\n[Twentymile Creek](https://www.americanwhitewater.org/content/River/detail/id/1447/)\n\n**[Google Map of New York Whitewater](https://www.google.com/maps/d/edit?mid=zjdnDE8H0TLg.kJnMWGapL4xk)**\n\n**[New York Whitewater Paddlers Facebook Group](https://www.facebook.com/groups/108070075877312/)**","averageGradient":"20","maxGradient":"0","length":"9.5","correlations":[{"reachID":"1278","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"2.55","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"7"},"gaugeInfo":{"name":"CATTARAUGUS CREEK AT GOWANDA NY","gaugeSource":"USGS","gaugeSourceIdentifier":"04213500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"1050","dateTime":"2026-05-12T02:15:00.