[{"result":{"data":{"json":{"id":"1690","stub":{"id":"1690","section":"3: River Front Park North to Granby Park (Congaree River)","altname":"","river":"Broad","difficulty":"ItoIIstandoutIII","states":["USA-SCR"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"1790","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"At the end of the parking lot, take the path over the canal and down to the river bank.  Put-in rapid is a wave train at the end of the dam overflow.","id":"112280","location":{"latitude":"34.033319","longitude":"-81.069667"},"name":"Put-In","distance":"0","photoID":null,"difficulty":"II","approximate":false},{"type":"rapid","description":"After a long stretch of flat/Class I water is the 2nd Bridge (I-126).  Read and run Class II.  Just after the bridge is a large group of islands, stay to the right channel for an easier attainment up the Saluda to Shandon Rapid.","id":"HQZuhwkfpFhGs9ERgirSa","location":{"latitude":"34.009486","longitude":"-81.060495"},"name":"2nd Bridge","distance":"1.84","difficulty":"II","approximate":false,"photoID":null},{"type":"other","description":"Confluence with the Saluda River forms the Congaree River.  Get all the way over to river right for some cool-water relief and a short paddle up to Shandon Rapid.","id":"sw4Ctu0bMDLYLszbeZcgN","location":{"latitude":"34.008186","longitude":"-81.061458"},"name":"Confluence","distance":"1.94","photoID":null,"difficulty":"I","approximate":false},{"type":"rapid","description":"Paddle up the Saluda to the base of the rapid.  Walk to the top on river right.  A straight shot, with a decent hole and a side surfing wave at some levels.","id":"RArp7P015WRMW3iriQ0SF","location":{"latitude":"34.00737","longitude":"-81.06657"},"name":"Shandon Rapid","distance":"2.04","difficulty":"II","approximate":false,"photoID":null},{"type":"rapid","description":"A riverwide shoal type rapid with lots of playable waves and holes. Run just left of the rocks in the middle of the river.","id":"VW9U37Gm8hA0r42IzmtDw","location":{"latitude":"34.004249","longitude":"-81.061697"},"name":"White House Rapids","distance":"2.21","difficulty":"II","approximate":false,"photoID":null},{"type":"takeout","description":"On river left just after Gervais St. bridge.  Senate Street take-out closed for now.","id":"117562","location":{"latitude":"33.995429","longitude":"-81.049163"},"name":"Senate Street Take-Out","distance":"3.15","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"River Left after Blossom St. bridge.","id":"pavD2RM1pz9yzJvsmxnLO","location":{"latitude":"33.984072","longitude":"-81.04561"},"name":"Granby Park Take-Out","distance":"3.9","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"1690","permitUrl":null,"permitInfo":null,"description":"Nice warm-water beginner run through the heart of Columbia, SC.  Very wide river with many islands and several Class II rapids.  Late spring, early summer the Spider Lilies are in bloom.  The run starts on the Broad River just below the Columbia Reservior dam.  The standard take-out is at the Senate Street landing on river left just after the Gervais Street bridge.  However, the landing is closed for the next several years as Dominion works to remove coal tar from the river bed.  The new take-out is at Granby Park on river left below the US 321 bridge.\n\n**Directions:**\n\n**Take-out:**\n\nFrom I-126 take the Huger St. exit.  Continue on Huger St. for about 1.5 miles.  Take a right on Catawba St.  and continue to the end to Granby Park.  From the parking lot there is a trail that leads down to the river.\n\n**Put-in:**\n\nFrom the take-out follow Catawba St. to Huger St.  Turn left on Huger Street and follow to I-126 W.  Once on I-126 W take the Greystone Blvd exit.  Turn right on Greystone Blvd.  Follow Greystone Blvd for about a mile then turn right on Broad River Rd.  Take the first left just as you cross the Broad River and Columbia Canal.  Follow the dirt road to parking lot at the end.  The put-in is on the Three Rivers Greenway after you cross the diversion dam.","averageGradient":null,"maxGradient":null,"length":"3.9","correlations":[{"reachID":"1690","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"500","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"60000"},"gaugeInfo":{"name":"BROAD RIVER AT ALSTON, SC","gaugeSource":"USGS","gaugeSourceIdentifier":"02161000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"1790","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.8","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"34.24320335","longitude":"-81.319541"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/02161000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/02161000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"migration-runnable","latestReading":{"value":"1790","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["112280","HQZuhwkfpFhGs9ERgirSa","sw4Ctu0bMDLYLszbeZcgN","RArp7P015WRMW3iriQ0SF","VW9U37Gm8hA0r42IzmtDw","117562","pavD2RM1pz9yzJvsmxnLO"],"geometry":{"type":"LineString","coordinates":[[-81.070676,34.033079],[-81.070572,34.032168],[-81.070518,34.031278],[-81.070518,34.031101],[-81.070583,34.030309],[-81.07054,34.029811],[-81.070561,34.029278],[-81.070551,34.028736],[-81.070518,