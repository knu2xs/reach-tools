[{"result":{"data":{"json":{"id":"1022","stub":{"id":"1022","section":"0. Upper Stillwater Lake to Lower Stillwater Lake (near Whitefish)","altname":"","river":"Stillwater","difficulty":"IIItoIV","states":["USA-MNT"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"110863","location":{"latitude":"48.581","longitude":"-114.647"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"116130","location":{"latitude":"48.532","longitude":"-114.573"},"name":"Take Out","distance":"3","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"1022","permitUrl":null,"permitInfo":null,"description":"Very interesting section of river with interspersed lakes. About half way between the lakes is one class 3 slide rapid at moderate flows, which could become class 4 at high water. The rapid features a 3-4' drop which might form a full-river hole at high water or could be a great surf wave. This reach is a beautiful, fun, 4 hour packraft run from upper to lower lake. Despite being near the highway and the train, the feeling is remote and spectacular. Bear spray recommended!","averageGradient":null,"maxGradient":null,"length":"5.5","correlations":[],"pointOfInterestIDs":["110863","116130"],"geometry":{"type":"LineString","coordinates":[[-114.647267,48.581512],[-114.647412,48.581437],[-114.647654,48.581156],[-114.647766,48.580765],[-114.647919,48.580524],[-114.647716,48.57901],[-114.647794,48.578542],[-114.647195,48.577496],[-114.646912,48.577232],[-114.646539,48.577027],[-114.644767,48.57644],[-114.643731,48.575757],[-114.64278,48.575227],[-114.641696,48.574235],[-114.6414,48.57389],[-114.641174,48.573743],[-114.640652,48.573455],[-114.640047,48.57331],[-114.639685,48.573155],[-114.638943,48.572537],[-114.638887,48.572177],[-114.639041,48.571717],[-114.639026,48.571536],[-114.638857,48.571079],[-114.63854,48.570744],[-114.638099,48.57