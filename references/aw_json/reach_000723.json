age/images/medium/cpFfZnxQzpvcvUc7GYXQm","large":"https://api.americanwhitewater.org/image/images/big/cpFfZnxQzpvcvUc7GYXQm"}},{"id":"39693","ext":"jpeg","post_id":"9789","description":"BIll Adn steve messing around at Pot Rocks","caption":"Pot Rocks","poi_name":"Pots Rock","subject":"BIll Dermota","author":"Not Sure","poi_id":"107110","photo_date":null,"updated_at":"2022-12-17T19:09:25.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/39693","large":"https://api.americanwhitewater.org/image/images/big/39693"}},{"id":"vEOVjpd3aLIpl981mX3XF","ext":"jpg","post_id":"EgAoGt8jDhMU7yC7tRDce","description":"I-95 - Lower Gunpowder","caption":"I-95 - Lower Gunpowder","poi_name":null,"subject":"I-95 - Lower Gunpowder","author":"Bill Despeaux","poi_id":"107112","photo_date":"2022-05-02T23:49:58.000Z","updated_at":"2023-05-02T23:49:58.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/vEOVjpd3aLIpl981mX3XF","large":"https://api.americanwhitewater.org/image/images/big/vEOVjpd3aLIpl981mX3XF"}},{"id":"X2M2AwSZukfldCAqqHyHJ","ext":"jpg","post_id":"CWNYqEsehKEzWqMEedNLk","description":"BBQ Grill Ledge - Lower Gunpowder","caption":"BBQ Grill Ledge - Lower Gunpowder","poi_name":null,"subject":"BBQ Grill Ledge - Lower Gunpowder","author":"Bill Despeaux","poi_id":"f8l8KOd2OacVttM9buIkn","photo_date":"2022-05-02T23:50:27.000Z","updated_at":"2023-05-02T23:50:27.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/X2M2AwSZukfldCAqqHyHJ","large":"https://api.americanwhitewater.org/image/images/big/X2M2AwSZukfldCAqqHyHJ"}},{"id":"39695","ext":"jpeg","post_id":"9790","description":"Steve and Bill meesing around in Pot Rocks","caption":"Pot Rocks","poi_name":"Pots Rock","subject":"Bill and Steve","author":"Bill Dermota","poi_id":"107110","photo_date":null,"updated_at":"2022-12-17T19:09:55.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/39695","large":"https://api.americanwhitewater.org/image/images/big/39695"}}],"detail":{"id":"723","permitUrl":"","permitInfo":"","description":"The typical put-in for the Lower GunPowder is at the US1/Belair Road Bridge. There is a really nice gravel parking lot with easy access to the river on river left. The take out at Jones Road has been closed permanently.  Currently the only available take-out is at Mariner Point Park which increases the length of the run from 3.4 miles to 7.5 miles.\n\nFor more information about this run, see:  1) [http://www.baltimorecanoeclub.org/index.php/en/paddling-resources/2013-10-02-01-22-40/2013-10-02-01-46-11](http://www.baltimorecanoeclub.org/index.php/en/paddling-resources/2013-10-02-01-22-40/2013-10-02-01-46-11); 2) _Maryland and Delaware Canoe Trails_, Ed Gertler.\n\nJohn Berg relates:  This is a great run if you can catch it after a rain when Loch Raven Reservoir is full. At lower levels there are not too many playspots. I have not run the upper sections. I usually put in at the Belair Road (Hwy 1) bridge for a shorter but more action-packed run.\n\nEd Evangelidi relates:\n\nThere has been some theft problems at the Jones Rd. takeout, so don't leave your boat or gear unattended or leave anything of value visible in your car. Use the hiking trails (river right is usually best) to scout any rapids that you are unfamiliar with.","averageGradient":"20","maxGradient":"40","length":"7.5","correlations":[{"reachID":"723","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":"Loch Raven Reservoir has to be full for this calculation to work\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n","mediumRunnableRangeComment":"\t\t\t\t\t\t\t\t\t\tLoch Raven Reservoir has to be full for this calculation to work\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n","highRunnableRangeComment":"\t\t\t\t\t\t\t\t\t\tUpper Level Limits are uncertain. Please help your fellow boaters with a comment or report.\r