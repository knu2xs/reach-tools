[{"result":{"data":{"json":{"id":"723","stub":{"id":"723","section":"6 - Route 1 to U.S.40 or Mariner Point","altname":"Lower Gunpowder","river":"Gunpowder Falls","difficulty":"IItoIII","states":["USA-MRY"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"139.91666666666666667","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"The typical put-in for the Lower GunPowder is at the US1/Belair Road Bridge. There is a really nice gravel parking lot with easy access to the river on river left.","id":"107117","location":{"latitude":"39.427622","longitude":"-76.4435"},"name":"US1/Belair Road Bridge Put-in","distance":"0","photoID":"cpFfZnxQzpvcvUc7GYXQm","difficulty":"N/A","approximate":false},{"type":"rapid","description":"Lead in to\" Fall Line\" - (Mile 2.44) - This series of rapids begins right after you go under the MD 7 (Philadelphia Rd) bridge. It starts with a short series of back-and-forth lines that culminate in a large staging eddy on river right.  From this staging eddy the next rapid (\"Fall Line\" rapid) can be easily land scouted or portaged from the paved trail on river right or boat scouted from the eddy.","id":"5V9gnr6vStJwP4iph0SHM","location":{"latitude":"39.413946","longitude":"-76.405039"},"name":"Lead in to \"Fall Line\"","distance":"2.44","difficulty":"III-","approximate":false,"photoID":null},{"type":"takeout","description":"\"Jones Rd.\" Take-out (Mile 3.4)\n\n**The Jones Rd. Takeout and parking area has been closed permanently.  Also, US 40 in the vicinity of the river has been marked 'No Parking, No Standing, No Stopping' by the Baltimore County Police.**\n\n\\[Old description:  _The take out is at Jones Road, just before the US 40 bridge across the Gunpowder (if coming from the East) or just after (if coming from the west).  Because of overuse and trash accumulations over the last few summers, the Jones Road take-out will be closed from Memorial Day weekend through Labor Day weekend (inclusive).\\]_","id":"107116","location":{"latitude":"39.409378","longitude":"-76.390158"},"name":"US 40/Jones Rd. Take-out","distance":"3.4","photoID":"Ems6Dy0jYMGFGLEjrbzCt","difficulty":"N/A","approximate":false},{"type":"takeout","description":"\"Mariner Point Park\" Take-out (Mile 7.4).\n\nTo get to Mariner Point Park, continue on US 40 east until you cross the Little Gunpowder (Harford County line). Immediately after the Little Gunpowder is a stoplight at Joppa Farms road, turn right at the stoplight onto Joppa Farms Road and go 1.7 miles, then turn right onto Kerney Drive. Go 0.6 miles on Kerney Drive to Mariner Point Park.","id":"107118","location":{"latitude":"39.400582","longitude":"-76.350628"},"name":"Mariner Point Park Take-out","distance":"7.47","photoID":null,"difficulty":"N/A","approximate":true}],"alerts":[],"photos":[{"id":"WriOeppjTNqeIrSHdEV5w","ext":"jpg","post_id":"FeGrwtTzd8lCU14ccx5fY","description":"","caption":"Pots_2","poi_name":null,"subject":"Rapid below Pot Rocks called Pots_2","author":"Tony Allred","poi_id":"107111","photo_date":"2022-05-09T01:15:48.000Z","updated_at":"2022-05-09T01:15:48.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/WriOeppjTNqeIrSHdEV5w","large":"https://api.americanwhitewater.org/image/images/big/WriOeppjTNqeIrSHdEV5w"}},{"id":"892609","ext":"jpg","post_id":"896465","description":null,"caption":"Gumpowder Falls - Fall Line","poi_name":"\"Fall Line\"","subject":null,"author":"Tony Allred Jr","poi_id":"107113","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/892609","large":"https://api.americanwhitewater.org/image/images/big/892609"}},{"id":"9326","ext":"jpeg","post_id":"7040","description":"couple from lancaster paddling the fall line of the gunpowder","caption":"Lower Gunpowder in Nov","poi_name":"","subject":"paddlers from lancaster","author":"steve f",