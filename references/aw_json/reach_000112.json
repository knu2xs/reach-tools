[{"result":{"data":{"json":{"id":"112","stub":{"id":"112","section":"01. Blue Crossing to Juan Miller Crossing","altname":"","river":"Blue","difficulty":"III","states":["USA-ARZ"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"109683","location":{"latitude":"33.525856","longitude":"-109.205579"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"114936","location":{"latitude":"33.272","longitude":"-109.198"},"name":"Take Out","distance":"24","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"112","permitUrl":null,"permitInfo":null,"description":"The Blue River gives boaters access to the last Primitive Area in the United States. The few who boat this say it is a worthwhile experience. You might consider continuing past Juan Miller Crossing to complete the Dos Rios run (additional 10 miles) to the San Francisco River + 17 miles to take-out in Clifton.  **Caution:** 1) a portage is required just below the last ford on FR 281, due to a Class V/VI boulder garden and waterfall; ~ 1/2 mile of Class IV below waterfall.  You can bypass this by launching from the end of FR281, near private locked gate, 2) a 4-wire barbed wire fence, to mark this property line, is often remains up and presents a hazard and 3) section is known to have strainers (wood hazards)\n\nAccess:\n\nPut-in: From Alpine Arizona take US 180 east to Luna Lae then south 23 miles on FR 281 to Blue Crossing and 14 miles to the end of the road where few people have run this river put in. Note: this does require driving 3-4 river fords, whcih may not be passable when flows exceed 600 cfs; requiring a launch closer to the township of Blue (maybe standing fences in this section)..\n\nTakeout: Drive north 21 miles from Morenci on US 666, then east on FR 475 to Juna Miller Crossing.","averageGradient":"30","maxGradient":null,"length":"23","correlations":[{"reachID":"112","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"150","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"10000"},"gaugeInfo":{"name":"BLUE RIVER NEAR CLIFTON, AZ.","gaugeSource":"USGS","gaugeSourceIdentifier":"09444200","gaugeFetchStatus":"ACTIVE","latestFlowReading":null,"latestStageReading":{"value":"4.21","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"33.29089456","longitude":"-109.1961832"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/09444200","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/09444200/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":null}],"pointOfInterestIDs":["109683","114936"],"geometry":{"type":"LineString","coordinates":[[-109.205579,33.525856],[-109.205604,33.52544],[-109.205775,33.52519],[-109.206505,33.524546],[-109.206891,33.524081],[-109.207149,33.523365],[-109.207749,33.522399],[-109.207792,33.521791],[-109.207792,33.521791],[-109.207749,33.521576],[-109.207835,33.521254],[-109.208264,33.520861],[-109.208436,33.520789],[-109.208436,33.520789],[-109.209166,33.520109],[-109.209166,33.520109],[-109.21011,33.519286],[-109.210367,33.518463],[-109.210367,33.51832],[-109.210024,33.517784],[-109.209895,33.517497],[-109.209809,33.517104],[-109.209809,33.516674],[-109.209638,33.516317],[-109.209509,33.516138],[-109.209294,33.515601],[-109.209466,33.515029],[-109.209852,33.51442],[-109.21011,33.513633],[-109.210067,33.513096],[-109.209638,33.512953],[-109.209466,33.512846],[-109.209423,33.512739],[-109.209423,33.512739],[-109.209337,33.512524],[-109.209337,33.512059],[-