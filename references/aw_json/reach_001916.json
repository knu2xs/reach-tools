[{"result":{"data":{"json":{"id":"1916","stub":{"id":"1916","section":"2. Pucketts Hole to Nash Ford","altname":"Clinch River Gorge","river":"Clinch","difficulty":"ItoIII","states":["USA-VRG"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"279","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Put in at Puckett's Hole, a Virginia Department of Wildlife Resources access point on river right. From Chestnut Rd. (Rt. 652), turn into the narrow, gravel Shepard Hollow Rd. which can be a little rough but not quite 4WD territory. Parking but no facilities. Rapid/playspot at upstream end of access area.","id":"109316","location":{"latitude":"36.969915","longitude":"-82.01374"},"name":"Put In - Puckett's Hole","distance":"0","photoID":"eJW0pUMwxM7Er2IaLpNF9","difficulty":"N/A","approximate":false},{"type":"other","description":"Big Cedar Creek confluence, river left.","id":"GJ1UfXQaItgpA8v6fxkT4","location":{"latitude":"36.965116","longitude":"-82.051046"},"name":"Big Cedar Creek confluence","distance":"5.72","photoID":"5lKcSSuw9ajBjeBZEwP2F","difficulty":"N/A","approximate":false},{"type":"rapid","description":"Double Ledges is a two-part rapid in quick succession, with an overall drop of about 6 feet. The ledges are at an angle to the flow, with the left side further downstream and generally having more water. It can be difficult to match up a good route on the upper ledge with one on the lower ledge. The easiest route may be along the right bank. Class II or III depending on water level and your route. This is the last significant rapid before the takeout.","id":"8HJaS4TOPPqFBDXnYOCgh","location":{"latitude":"36.9639","longitude":"-82.061037"},"name":"Double Ledges","distance":"6.95","difficulty":"III-","approximate":false,"photoID":"7swC1xYAvpIdUDs3hou8P"},{"type":"takeout","description":"Take out at Nash Ford, a developed access on river left upstream of the bridge. From New Garden Rd. (Rt. 645) turn onto the gravel River Front Dr. (Rt. 798) at the church and drive upstream a short distance. Parking but no facilities.","id":"114558","location":{"latitude":"36.965298","longitude":"-82.077571"},"name":"Take Out - Nash Ford","distance":"8.07","photoID":"c96yDXhurn3uw4eF2LKTi","difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"RewtKYqcyiFNhNq21itCV","ext":"jpg","post_id":"Py5InouTuNdwHYE26qOhp","description":"","caption":"Clinch River - Puckett's Hole","poi_name":null,"subject":"","author":"Philip Young","poi_id":"109316","photo_date":"2025-03-18T16:57:16.000Z","updated_at":"2025-04-24T16:57:16.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/RewtKYqcyiFNhNq21itCV","large":"https://api.americanwhitewater.org/image/images/big/RewtKYqcyiFNhNq21itCV"}},{"id":"eJW0pUMwxM7Er2IaLpNF9","ext":"jpg","post_id":"Py5InouTuNdwHYE26qOhp","description":"","caption":"Pucketts Hole","poi_name":null,"subject":"","author":"Philip Young","poi_id":"109316","photo_date":"2025-03-18T16:57:16.000Z","updated_at":"2025-04-24T16:57:16.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/eJW0pUMwxM7Er2IaLpNF9","large":"https://api.americanwhitewater.org/image/images/big/eJW0pUMwxM7Er2IaLpNF9"}},{"id":"5lKcSSuw9ajBjeBZEwP2F","ext":"jpg","post_id":"Py5InouTuNdwHYE26qOhp","description":"","caption":"Big Cedar Creek confluence","poi_name":null,"subject":"","author":"Philip Young","poi_id":"GJ1UfXQaItgpA8v6fxkT4","photo_date":"2025-03-18T16:57:16.000Z","updated_at":"2025-04-24T16:57:16.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5lKcSSuw9ajBjeBZEwP2F","large":"https://api.americanwhitewater.org/image/images/big/5lKcSSuw9ajBjeBZEwP2F"}},{"id":"c96yDXhurn3uw4eF2LKTi","ext":"jpg","post_id":"Py5InouTuNdwHYE26qOhp","description":"","caption":"Nash Ford","poi_name":null,"subject":"","author":"Philip Young","poi_id":"114558","photo_date"