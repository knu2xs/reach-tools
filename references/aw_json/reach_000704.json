[{"result":{"data":{"json":{"id":"704","stub":{"id":"704","section":"1. Becket to Chester","altname":"","river":"Westfield, W. Branch","difficulty":"IIItoIV","states":["USA-MSS"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"114","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"111252","location":{"latitude":"42.3321","longitude":"-73.083397"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":"After passing under a railroad bridge there will be a large flat rock on river left with an eddy behind it before the river starts to drop. Take out on left here to walk down and scout. The rapid is run down the left side. When you get to the main drop you will be on the far left and drive to the center. You aim for a roostertail that is in the drop. There is then a small pool where Coles Brook enters and the river bends right. As it turns right there is another drop with a hole at the bottom of it. At certain levels the hole is retentive. The easy line is on the right side. There is also a good boof on the left side next to the boulder on the left side.","id":"hpsR7RQOBEoWNX288RLpX","location":{"latitude":"42.320208","longitude":"-73.041303"},"name":"Coles Brook","distance":"2.61","difficulty":"IV","approximate":false,"photoID":null},{"type":"rapid","description":"This is a gorged section with two ledge drops. There is a decent eddy above it to prepare on river right. The first drop is run down center or left. If there is enough water the left line is easiest. The center is a V hole that can be punched. The second drop is run down the left as the hole is very retentive on the right.","id":"drxisrKfG0O1TNY5z2gYF","location":{"latitude":"42.3051","longitude":"-73.00568"},"name":"Double Drop","distance":"5.37","difficulty":"III+","approximate":false,"photoID":null},{"type":"takeout","description":null,"id":"116522","location":{"latitude":"42.299999","longitude":"-72.983902"},"name":"Take Out","distance":"8","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"1086","ext":"jpeg","post_id":"3789","description":"","caption":"West Branch of Westfield","poi_name":"","subject":"Joanne Grogan","author":"Mark Schappert","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1086","large":"https://api.americanwhitewater.org/image/images/big/1086"}},{"id":"680","ext":"jpeg","post_id":"3250","description":"","caption":"","poi_name":"","subject":"Jim Michaud","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/680","large":"https://api.americanwhitewater.org/image/images/big/680"}},{"id":"681","ext":"jpeg","post_id":"3251","description":"","caption":"","poi_name":"","subject":"Tad Martin","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/681","large":"https://api.americanwhitewater.org/image/images/big/681"}},{"id":"1087","ext":"jpeg","post_id":"3789","description":"","caption":"West Branch of Westfield","poi_name":"","subject":"Joanne Grogan","author":"Mark Schappert","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1087","large":"https://api.americanwhitewater.org/image/images/big/1087"}},{"id":"1107","ext":"jpeg","post_id":"3790","description":"","caption":"West Branch of Westfield","poi_name":"","subject":"Mark Schappert","author":"Joanne Grogan","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1107","large":"https://api.americanwhitewater.org/image/images/big/1107"}}],"detail":{"id":"704","permitUrl":"","permitInfo":"","description":"The river is class III boogie water all the way from the put-in to the sixth railroad bridge. After the bridge there’s a short calm stretch where you can gather up the troops. Right after the next left turn is a short class IV rapid which is best run on the far left. After the rapid there’s a short calm stretch then a second class IV rapid ending at the next railroad bridge. Run this one on the far left also.\n\nAfter the class IV rapids there is a pool where you should take out on the left and walk down to the next drop to scout. Here there is a vertical drop into a hole which is best run on the right edge. At the bottom of the drop Coles Brook enters from the left.\n\nAfter Coles Brook it’s all boogie water again until the Bancroft Road Bridge which is the end of the upper section and the start of the lower section.\n\nThe lower section is easy paddling until Factory Book enters from the left. Below here the river splits. The left channel is usually blocked near the bottom so the right channel is the way to go. This is a short powerful class IV rapid with holes on the right. The rapid changed after Hurricane Irene so the best line now is down the center left. This short section ends with a steep chute in the center then is immediately followed by a class III-IV rapid.\n\nThe next rapid is a long, complex class III-IV rapid ending at the next railroad bridge. After the bridge the river is mostly class II-III until you get to a river wide ledge called Double Drop. You can’t see the ledge until you’re committed to the rapid so the best way to know where you are is to observe where the river turns. The ledge is located where the river turns left-right for the second time. Enter the rapid on the extreme left and eddy out in a long eddy on river left just above the ledge. Coming out of the eddy punch through a small hole and run the ledge on the far left.\n\nFrom here to the take-out the river is mostly class II. The take-out is located on river left just below the Middlefield Road Bridge.\n\n[Westfield River (Huntington)](http://srvrdcthrt.er.usgs.gov/rt-cgi/gen_stn_pg?station=01181000) U.S.G.S. gage","averageGradient":"66","maxGradient":"90","length":"7.9","correlations":[{"reachID":"704","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"800","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"9000"},"gaugeInfo":{"name":"WEST BRANCH WESTFIELD RIVER AT HUNTINGTON, MA","gaugeSource":"USGS","gaugeSourceIdentifier":"01181000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"114","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.87","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"42.23731169","longitude":"-72.895654"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/01181000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/01181000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"114","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["111252","hpsR7RQOBEoWNX288RLpX","drxisrKfG0O1TNY5z2gYF","116522"],"geometry":{"type":"LineString","coordinates":[[-73.083219,42.332001],[-73.083174,42.332082],[-73.082989,42.332322],[-73.08282,42.332482],[-73.082727,42.332619],[-73.082527,42.332831],[-73.082527,42.332882],[-73.082157,42.332945],[-73.081726,42.333071],[-73.08114,42.333197],[-73.080154,42.333266],[-73.079815,42.333317],[-73.079414,42.333466],[-73.078489,42.333655],[-73.077734,42.333735],[-73.076794,42.33376