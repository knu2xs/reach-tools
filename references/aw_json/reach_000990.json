[{"result":{"data":{"json":{"id":"990","stub":{"id":"990","section":"4. Boulder Falls to highway (Boulder Falls Canyon)","altname":"","river":"Boulder","difficulty":"Vplus","states":["USA-MNT"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"2.71","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"109463","location":{"latitude":"45.549099","longitude":"-110.207397"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"114707","location":{"latitude":"45.5602","longitude":"-110.200401"},"name":"Take Out","distance":"1","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"17981","ext":"jpeg","post_id":"6634","description":"","caption":"Shiloh below Boulder Falls","poi_name":"Put-in for Boulder Falls Canyon","subject":"Shiloh","author":"David Schroeder","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17981","large":"https://api.americanwhitewater.org/image/images/big/17981"}},{"id":"876268","ext":"jpeg","post_id":"876269","description":"","caption":"Boulder Falls Canyon","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/876268","large":"https://api.americanwhitewater.org/image/images/big/876268"}}],"detail":{"id":"990","permitUrl":null,"permitInfo":null,"description":"Boulder Falls Canyon is a sight no one should miss and is a hell of an exciting run to boot. The Boulder river charges down a great looking class V-V+ drop before plumetting into an enormous hole that happens to drain most of the river through the now collapsed \"Natural Bridge\". The entire river goes through this hole at lower flows and comes shooting out of the cliffs below into the Boulder Falls Canyon. Needless to say, don't run the section above the falls... At medium and high flows, the river actually reaches the lip of the 105' falls creating an incredible scene to behold. I finally hiked down in there last year with some friends and really enjoyed the stretch of whitewater that runs below the falls through a striking limestone canyon. There are a few major sieves in the canyon that you should be wary of, for there is no return from getting sucked in. They are enormous. Fortunately, you can put in at the base of the falls, paddle to just above the first rapid and scout the entire canyon on river right. It felt like V+ or 5.1 at 3500 cfs on the downstream gauge. Definitely manageable, but with very little room for error in a couple places, and a fairly large pucker factor involved throughout. If you're up for it, try it out. It is a fantastic view from river level and a Sunday afternoon you won't soon forget.","averageGradient":null,"maxGradient":null,"length":"0.98","correlations":[{"reachID":"990","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"4.2","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"6.5"},"gaugeInfo":{"name":"Boulder River at Big Timber MT","gaugeSource":"USGS","gaugeSourceIdentifier":"06200000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"811","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"2.71","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"45.8337944","longitude":"-109.9387056"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/06200000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usg