[{"result":{"data":{"json":{"id":"1974","stub":{"id":"1974","section":"02.0 Fries Dam to Byllesby Dam","altname":"","river":"New","difficulty":"ItoIII","states":["USA-VRG"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"674","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"The best access (pictured) is at the New River Trail parking area in Fries, river left not far below Fries Dam. There's a parking fee at the NRT access. However, it's also possible to put in at the adjacent Fries River Park just upstream (near the red caboose). Ample parking, toilets at both parks.","id":"109207","location":{"latitude":"36.714733","longitude":"-80.976814"},"name":"Put In","distance":"0.38","photoID":"i1UnJoaDF83yVTfrbkBGo","difficulty":"N/A","approximate":false},{"type":"takeout","description":"The Byllesby Pool Access is on river right after a little less than 2 miles of flatwater/lake. It's at the end of River Hill Rd. (Rt. 736). Signage to this access was missing in April 2025. Ramp and parking, no facilities. It's a somewhat long shuttle that's not really bikeable.\n\nThere appears to be a Byllesby Dam access on river left another mile down the lake, which would enable a bike shuttle along the New River Trail.","id":"114447","location":{"latitude":"36.773568","longitude":"-80.936244"},"name":"Take Out","distance":"7.47","photoID":"giYfxo0sKfT7wrTaPDgyk","difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"891237","ext":"jpg","post_id":"895140","description":null,"caption":"New River Trail","poi_name":null,"subject":null,"author":"Dallas Hoffman","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891237","large":"https://api.americanwhitewater.org/image/images/big/891237"}},{"id":"891235","ext":"jpg","post_id":"895138","description":null,"caption":" on New @02.0 Fries Dam to Byllesby Dam","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891235","large":"https://api.americanwhitewater.org/image/images/big/891235"}},{"id":"891236","ext":"jpg","post_id":"895139","description":null,"caption":" on New @02.0 Fries Dam to Byllesby Dam","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891236","large":"https://api.americanwhitewater.org/image/images/big/891236"}},{"id":"891238","ext":"jpg","post_id":"895141","description":null,"caption":"New @02.0 Fries Dam to Byllesby Dam","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891238","large":"https://api.americanwhitewater.org/image/images/big/891238"}},{"id":"HDuBLsDz1v4oNRUIIIDDh","ext":"jpg","post_id":"FPs7SyKBCYu8qAu6ri3mw","description":"","caption":"New - Fries to Byllesby","poi_name":null,"subject":"","author":"Philip Young","poi_id":null,"photo_date":"2025-04-19T12:47:12.000Z","updated_at":"2025-04-22T12:47:12.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/HDuBLsDz1v4oNRUIIIDDh","large":"https://api.americanwhitewater.org/image/images/big/HDuBLsDz1v4oNRUIIIDDh"}},{"id":"PDYuIvqvzZGnez059KcLa","ext":"jpg","post_id":"FPs7SyKBCYu8qAu6ri3mw","description":"","caption":"New - Fries to Byllesby","poi_name":null,"subject":"","author":"Philip Young","poi_id":null,"photo_date":"2025-04-19T12:47:12.000Z","updated_at":"2025-04-22T12:47:12.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/PDYuIvqvzZGnez059KcLa","large":"https://api.americanwhitewater.org/image/images/big/PDYuIvqvzZGnez059KcLa"}},{"id":"AB0s0LbpgvTqCYcE0zfb8","ext":"jpg","post_id":"FPs7SyKBCYu8qAu6ri3mw","description":"","caption":"New - Fries to Byllesby","poi_name":null,"subject":"","author":"Philip Young","poi_id":null,"photo_date":"2025-04-19T12:47:12.000Z","updated_at":"2025-04-22T12:47:12.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/AB0s0LbpgvTqCYcE0zfb8","large":"https://api.americanwhitewater.org/image/images/big/AB0s0LbpgvTqCYcE0zfb8"}},{"id":"i1UnJoaDF83yVTfrbkBGo","ext":"jpg","post_id":"FPs7SyKBCYu8qAu6ri3mw","description":"<p>Access from the New River Trail parking area (parking fee).</p>","caption":"Fries put-in","poi_name":null,"subject":"","author":"Philip Young","poi_id":null,"photo_date":"2025-04-19T12:47:12.000Z","updated_at":"2025-04-22T12:47:12.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/i1UnJoaDF83yVTfrbkBGo","large":"https://api.americanwhitewater.org/image/images/big/i1UnJoaDF83yVTfrbkBGo"}},{"id":"giYfxo0sKfT7wrTaPDgyk","ext":"jpg","post_id":"FPs7SyKBCYu8qAu6ri3mw","description":"<p>At the end of River Hill Rd., Rt. 736.</p>","caption":"Byllesby Pool Access","poi_name":null,"subject":"","author":"Philip Young","poi_id":null,"photo_date":"2025-04-19T12:47:12.000Z","updated_at":"2025-04-22T12:47:12.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/giYfxo0sKfT7wrTaPDgyk","large":"https://api.americanwhitewater.org/image/images/big/giYfxo0sKfT7wrTaPDgyk"}}],"detail":{"id":"1974","permitUrl":null,"permitInfo":null,"description":"David Sichi shared:\n\nRan Fries to Byllesby Dam. Nice run 2 miles of rapids class 2-3 depending on level. This run is approx. half rapids, half flatwater. Great place to teach people how to read water; good defined features with little worry about a bad swim. The shuttle is a little long but worth the trip. Taking out at Byllesby Dam shortened the trip to 8 miles. The takeout at Byllesby Dam is overgrown; take out approx. 1 mile earlier and carry to vehicle following the New River Trail, which runs parallel to the river for the entire run. Take a bike for solo shuttle; the trail is very easy and fast on bike.\n\nDonald Gurkin commented: A very fun run especially for novice. We ran it in open canoes with camping gear and in whitewater kayaks. At higher levels there are many holes and waves to play on, but nothing so big as to get a novice in trouble. Great two- or three-day camping trip.\n\nRichie Hughes suggested:\n\nWhen one gets to Byllesby Reservoir, there is a takeout on the right after 2 miles of lake paddling. This is a Virginia state boat launch ramp. To get to this takeout, check the Virginia gazetteer. There are brown info signs leading you to this takeout. Bike shuttle is not possible when taking out on the right since the New River Trail is on the other side of the lake. First 2 miles below Fries is flatwater. Next 2.5 miles is delightful class 2 and low 3. Then 2 miles or more of lake.\n\nSee Also:\n\n[New River Outdoor Adventures](https://newriveroutdooradventures.com/), rentals, shuttles, camping.\n\n[New River](https://dwr.virginia.gov/waterbody/new-river/#maps) - maps and directions from Virginia DWR.\n\n*Classic Virginia Rivers,* Ed Grove (1992 ed), p. 306.\n\n*Virginia Whitewater*, Roger Corbett (2000 ed.), p. 471.\n\n*Exploring Virginia's Waterways*, Ed Gertler (2022 ed.), p. 339.","averageGradient":"11","maxGradient":"0","length":"7.2","correlations":[{"reachID":"1974","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1200","beginMediumRunnable":"1500","beginHighRunnable":"3000","endHighRunnable":"10000"},"gaugeInfo":{"name":"NEW RIVER NEAR GALAX, VA","gaugeSource":"USGS","gaugeSourceIdentifier":"03164000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"674","dateTime":"2026-05-12T02:30:00.000Z","qualifier"