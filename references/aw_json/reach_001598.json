[{"result":{"data":{"json":{"id":"1598","stub":{"id":"1598","section":"Narrows","altname":"West Conewago Narrows","river":"Conewago Creek (West)","difficulty":"IIIplusstandoutIV","states":["USA-PEN"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"69","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"108959","location":{"latitude":"39.94624","longitude":"-77.340217"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"114193","location":{"latitude":"39.932657","longitude":"-77.312241"},"name":"Take Out","distance":"2.17","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"GAOFyhl21PKNXlgONV6SL","ext":"jpg","post_id":"otlcCY1zQHiHRRrPPsbAB","description":"Hand paddling the crux move in 1993 or 94. ","caption":"The crux move on the Conewago Narrows","poi_name":null,"subject":"Kevin Colburn","author":null,"poi_id":null,"photo_date":null,"updated_at":"2021-08-25T19:31:56.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/GAOFyhl21PKNXlgONV6SL","large":"https://api.americanwhitewater.org/image/images/big/GAOFyhl21PKNXlgONV6SL"}}],"detail":{"id":"1598","permitUrl":null,"permitInfo":null,"description":"The Conewago Narrows is a pretty 2-mile creek-boating run on an otherwise long flatwater river. It runs fairly often in the winter and spring, often for a day or two following a significant rain event. The run quickly picks up in difficulty after paddling under the 234 bridge by the campground and rounding the bend, with a few warmup rapids prior to the crux move. The crux used to be called Surrealistic Pillow (named after a very different rapid on the Bear in GA). It has changed with high flows, but is usually a very tight move requiring a good boof followed by a couple nice little ledge drops. From here the rapids ease to fun class III to the takeout.\n\nMost of the surrounding land is heavily posted by a club that leases the private lands surrounding the creek for trout fishing. Its been reported that the landowners apparently do not mind boaters as long as you let them know ahead of time and the river is high. Others have had no problem responsibly enjoying the stream at high flows. Respect private property in this area. You can peek at much of the run while driving down the road.\n\nThere are two Conewago Creeks, on opposite sides of the Susquehanna River. [Click here](http://www.americanwhitewater.org/content/River/view/river-detail/1597) for Conewago (East).\n\nFor more information, see _Keystone Canoeing_ by Gertler, E.","averageGradient":null,"maxGradient":null,"length":"2.2","correlations":[{"reachID":"1598","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1400","beginMediumRunnable":"1500","beginHighRunnable":"2500","endHighRunnable":"10000"},"gaugeInfo":{"name":"West Conewago Creek at East Berlin, PA","gaugeSource":"USGS","gaugeSourceIdentifier":"01573825","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"69","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"2.95","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"39.9412222","longitude":"-76.99"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/01573825","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/01573825/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"69","