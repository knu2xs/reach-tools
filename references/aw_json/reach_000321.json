americanwhitewater.org/image/images/medium/jk42yhvC2Sb2zV3d99lYO","large":"https://api.americanwhitewater.org/image/images/big/jk42yhvC2Sb2zV3d99lYO"}},{"id":"4tc2XzYqsr3tSLUNbgyTm","ext":"jpg","post_id":"SSIlKQTjDhS8rOmoPS9fW","description":"View from the road","caption":"","poi_name":null,"subject":"","author":"Dup Crosson","poi_id":null,"photo_date":"2023-01-27T21:30:43.000Z","updated_at":"2023-12-31T21:30:43.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/4tc2XzYqsr3tSLUNbgyTm","large":"https://api.americanwhitewater.org/image/images/big/4tc2XzYqsr3tSLUNbgyTm"}},{"id":"ImJiuEB9s2T2KmukHjDNH","ext":"jpg","post_id":"SSIlKQTjDhS8rOmoPS9fW","description":"Before the rush.","caption":"","poi_name":null,"subject":"","author":"Dup Crosson","poi_id":"112841","photo_date":"2023-01-27T21:30:43.000Z","updated_at":"2023-12-31T21:30:43.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/ImJiuEB9s2T2KmukHjDNH","large":"https://api.americanwhitewater.org/image/images/big/ImJiuEB9s2T2KmukHjDNH"}},{"id":"2KuMTugvHwN7WaGOocitk","ext":"jpg","post_id":"SSIlKQTjDhS8rOmoPS9fW","description":"Assessing","caption":"","poi_name":null,"subject":"","author":"Dup Crosson","poi_id":null,"photo_date":"2023-01-27T21:30:43.000Z","updated_at":"2023-12-31T21:30:43.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/2KuMTugvHwN7WaGOocitk","large":"https://api.americanwhitewater.org/image/images/big/2KuMTugvHwN7WaGOocitk"}},{"id":"sFf4pTAvPXgDIi1E0exP6","ext":"jpg","post_id":"SSIlKQTjDhS8rOmoPS9fW","description":"Tom Brown and Robin Levick","caption":"","poi_name":null,"subject":"","author":"Dup Crosson","poi_id":"112841","photo_date":"2023-01-27T21:30:43.000Z","updated_at":"2023-12-31T21:30:43.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/sFf4pTAvPXgDIi1E0exP6","large":"https://api.americanwhitewater.org/image/images/big/sFf4pTAvPXgDIi1E0exP6"}}],"detail":{"id":"321","permitUrl":null,"permitInfo":null,"description":"The Three Bears refer to three class IV rapids below Surprise Creek, which are all boulder gardens. All three can be portaged if necessary. Boaters typically take out at the Broken Bridge (mile 5.5).\n\nMay be boatable at higher flows.\n\nYou can combine this with the [Lower SF Trinity Run](main) (class II) that ends at either Sandy Bar or the Trinity River confluence.\n\n**Logistics**\n\n_Put-in_\n\nTo get to the put-in from the take-out, head back uphill toward Escot Farms and turn right onto South Fork Road/Forest Service Road 5N03 that heads in the upriver direction. Go five miles then stay left at the sign for Todd Ranch. Continue two more miles to a Y, then turn right to descend a steep road to the river at Surprise Falls.\n\n_Take-out_\n\nThe take-out for this run is also the put-in for the downstream [Lower SF Trinity Run](main) at the broken bridge/low water bridge. To get there from Highway 299 at the east side of the the bridge over the South Fork, turn south onto South Fork Road and begin heading upriver. After four miles, turn right to stay on South Fork Road where Hennessy Road splits off straight ahead. After 1.3 miles, bear right again to stay on South Fork Road and heading in the upriver direction. Continue until you see a peach-colord sign for Escot Farms, about eight miles from Highway 299. Turn right here then stay left to descend to the river. Because the bridge over the river is 'broken' aka missing, there's a gate that blocks vehicle access at the end and you'll need to carry a short ways down to the water on the old roadbed.\n\n**Additional Information**\n\nThe best guidebook for this run is Dan Menten's 2016 classic _The New School Guide to Northern California Whitewater_ (p. 137).\n\nSee the [Three Bears description](http://www.cacreeks.com/trin-zs4.htm) on [cacreeks.com](http://www.cacreeks.com)\n\nSections of the SF Trinity are eligible for Wild and Scenic protections, and would be designated as such with the passage of Rep. Huffman's _Northwest California Wilderness, Recreation, and Working Forests Act_(NCWRWFA). AW is a proud supporter of this bill. Learn more at [www.calwild.org](https://www.calwild.org/campaigns/northwest/).","averageGradient":"37","maxGradient":null,"length":"5.7","correlations":[{"reachID":"321","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"750","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"4000"},"gaugeInfo":{"name":"SOUTH FORK TRINITY RIVER BELOW HYAMPOM","gaugeSource":"CDEC","gaugeSourceIdentifier":"TBH","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"471","dateTime":"2026-05-12T01:30:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.8","dateTime":"2026-05-12T01:30:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"40.6498641967773","longitude":"-123.494201660156"},"externalSourceLinks":{"sourceLink":{"url":"https://cdec.water.ca.gov/dynamicapp/QueryF?s=TBH","text":"California Data Exchange - Station Log"},"secondaryLink":{"url":"https://cdec.water.ca.gov/cdecplotter/JspPlotAll?staid_id=TBH","text":"California Data Exchange - Data Plot"}}},"migrationErrorExplanation":"Previous Flowbands: \nRange of Boatable Flows (R0-R9): 750 - 4000 cfs  Comment: Per Menten book. May be boatable at higher flows.\n\nMigration Errors: \nSingle range is valid but doesn't provide low/medium/high runnable\nThere is one comment for all of low/medium/high runnable.","comment":"Adding back – accidentally deleted because the website showed two gages after I edited the flow range, and I deleted one to clear it up. Turns out it was an ","status":{"status":"below-recommended","latestReading":{"value":"471","dateTime":"2026-05-12T01:30:00.000Z","qualif