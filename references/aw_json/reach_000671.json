[{"result":{"data":{"json":{"id":"671","stub":{"id":"671","section":"KY 746 to KY 715 (10.3 miles)","altname":"Upper Red","river":"Red","difficulty":"III","states":["USA-KEN"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"20","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"112462","location":{"latitude":"37.7987","longitude":"-83.4894"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"117747","location":{"latitude":"37.824","longitude":"-83.5818"},"name":"Take Out","distance":"10.3","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"100826292","title":null,"post_date":"2011-09-17 04:00:00+00","detail":"This is absolutely the most remote stream in Kentucky. There are very large torrents that locals have seen at an easy class iv. I have paddled the upper red four times this spring and twice it was breaking its banks. The strainers are really bad in which some you have no way around. BE EXTREMELY CAREFUL AT THE LAST BIG SECTION. The last hydraulic will takke you down if you hit it in the middle. I highly suggest this river but it needs to be way up. The lower on this one the more strainers you will have problems with. They do not call the last torrent \"The Dog Drowner\" for nothing. One of my canoes was torn in half by the beginning of it, once you get to the end the water is really pushing. All big torrents are strainer free. Remember, ONLY TEAMS OF TWO CANOES SHOULD HIT THIS RIVER FROM route 746. It is fun if your into epic hauls. Bring a Emergency Overnight Kit !!!!!!","user":null}],"photos":[{"id":"22038","ext":"jpeg","post_id":"1034","description":"Rock Amphitheater","caption":"Amphitheater","poi_name":"Amphitheater","subject":"Red River","author":"Spalding Hurst","poi_id":null,"photo_date":null,"updated_at":null,"url