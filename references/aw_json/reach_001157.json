[{"result":{"data":{"json":{"id":"1157","stub":{"id":"1157","section":"06. Avalanche Creek to B.R.B. Campground","altname":"Avalanche to BRB","river":"Crystal","difficulty":"III","states":["USA-COL"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"373","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Put-in at the road pull-out off Hwy 133 about 200 yards downstream on the Avalanche Creek Rd. bridge. Surrounding property is private so please only use the esignated access.","id":"109643","location":{"latitude":"39.254156","longitude":"-107.234085"},"name":"Put In","distance":"0.05","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"Take out is just upstream of the bridge (S Bill Creek Dr.) and the KOA campground. There is a decent sized gravel lot just off the highway. Surrounding property is private, only use designated access.","id":"114893","location":{"latitude":"39.318363","longitude":"-107.209859"},"name":"Take Out","distance":"5.08","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"1157","permitUrl":null,"permitInfo":null,"description":"The Narrows is a great addition to this run and only adds a mile to the overall length.\n\nCommonly shuttling wood and plagued with cottonwoods leaning into the riverbed below the Narrows, be on the lookout. The rapids are read and run.\n\nAlso, see _Colorado Rivers and Creeks II_, by Banks and Eckardt _(The Bible)_, for info on this and most of the other great runs of Colorado.\n\nLat/longitude coords are approximate, from TopoZone.\n\nSee also [Penny Hot Springs to Avalanche Creek](http://www.americanwhitewater.org/content/River/view/river-detail/383/) (Class IV+),\n\n[Crystal Mill Falls to before Crystal Gorge](http://www.americanwhitewater.org/content/River/view/river-detail/2718/) (Class III-IV(V)),\n\n[Redstone to Penny Hot Springs](http://www.americanwhitewater.org/content/River/view/river-detail/1737/) (Class V+),\n\n[Marble to Redstone](http://www.americanwhitewater.org/content/River/view/river-detail/2105/) (Class III-IV), and\n\n[above Beaver Lake](http://www.americanwhitewater.org/content/River/view/river-detail/1317/) (Class V+),\n\n[North Fork Crystal](http://www.americanwhitewater.org/content/River/view/river-detail/1615/) (Class V+).","averageGradient":"58","maxGradient":null,"length":"5.1","correlations":[{"reachID":"1157","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"400","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"3000"},"gaugeInfo":{"name":"CRYSTAL RIVER ABV AVALANCHE CRK, NEAR REDSTONE, CO","gaugeSource":"USGS","gaugeSourceIdentifier":"09081600","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"373","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.83","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"39.23263889","longitude":"-107.2275"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/09081600","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/09081600/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"373","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["109643","114893"],"geometry":{"type":"LineString","coordinates":[[-107.233962,39.253412],[-107.234029,39.253626],[-107.234077,39.254015],[-107.234088,39.254208],