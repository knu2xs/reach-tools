[{"result":{"data":{"json":{"id":"810","stub":{"id":"810","section":"2) Lower Kennebec: Carry Brook to the Forks","altname":"","river":"Kennebec","difficulty":"IItoIII","states":["USA-MAI"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"9040","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"rapid","description":"1\\. 1. WebbÂs Dead River Campground & Shuttle Service: Shuttles to the Dead put in, campground with showers. For shuttle service call (207) 663-2114 and ask for Karen. To book a site at Webb's campground call River Drivers to make the reservations. That phone number is: 207-663-4475. The cost is $5.00 per person, per night, plus 7% State tax.\n\n2\\. AppletonÂs restaurant: Pizza, subs, ice cream, breakfast.\n\n3\\. [River Drivers](http://www.riverdrivers.com/): Rafting, etc.\n\n4\\. Paddling shop: Dead River Outfitters\n\n5\\. BerryÂs General Store: Gas, Beer, food, supplies, pizza, subs\n\n6\\. The Ball field campground: Primitive campsites, porta-poties, no showers. Take out for Lower Kennebec.\n\n7\\. [Crab Apple](http://www.crabappleinc.com/maine_adventures.htm) Camping Rafting, hot tub, bar, food.\n\n8\\. Public Picnic area: also used as Lower Kennebec take out.\n\n9\\. The Marshall Hotel (Hotel Cocktails): Food, bar, horse shoes, pool table.\n\n10\\. Dead River takeout.\n\n11\\. [Majic Falls Rafting](http://www.magicfalls.com/): Raft trips, camping\n\n12\\. [Three Rivers Whitewater & Kelly Brook campground](http://www.threeriverswhitewater.com/)\n\n13\\. [Northern Outdoors](http://www.northernoutdoors.com/) Camping, Rafting, restaurant, hot tub, bar, entertainment\n\n14\\. [North Country Rivers](http://www.ncrivers.com/) Rafting, etc.\n\n15\\. [Professional River Runners:](http://www.proriverrunners.com/aaa/kennebec-river.htm) Rafting, etc.\n\n16\\. [New England Outdoor Center:](http://www.neoc.com/) Rafting, Paddling shop, etc.\n\n17\\. Indian Pond campground\n\n**Not on map:**\n\n[Moxie Gore cabins](http://cmoxiegore.com/): : $30 per night\n\n[Moxie Outdoor Outfitters](http://www.wild-rivers.com/): 866-663-2646 Large cabins $75 per night","id":"486","location":{"latitude":"0","longitude":"0"},"name":"Map Key","distance":"0","difficulty":null,"approximate":false,"photoID":null},{"type":"put-in","description":null,"id":"481","location":{"latitude":"0","longitude":"0"},"name":"Map of the Forks Maine","distance":"0","photoID":"2042","difficulty":null,"approximate":false},{"type":"rapid","description":"This is the biggest rapid on this section. The route is easily boat scouted. Waves can be large at 4800 cfs release levels and huge at 6000+ cfs.","id":"484","location":{"latitude":"0","longitude":"0"},"name":"Big Black Brook Rapid","distance":"0.5","difficulty":"III","approximate":false,"photoID":null}],"alerts":[],"photos":[{"id":"3748","ext":"jpeg","post_id":"5762","description":"","caption":"Z-Turn","poi_name":"Z-Turn","subject":"Nate Stewart","author":"Andrew Kittredge","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3748","large":"https://api.americanwhitewater.org/image/images/big/3748"}},{"id":"3749","ext":"jpeg","post_id":"5763","description":"","caption":"Surfing Z-Turn","poi_name":"Z-Turn","subject":"Andrew Kittredge","author":"Nate Stewart","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3749","large":"https://api.americanwhitewater.org/image/images/big/3749"}},{"id":"6135","ext":"jpeg","post_id":"5762","description":"Check out the full-sized version of this photo by <a href=\"http://www.americanwhitewater.org/photos/?photoid=3748\">clicking here</a>.","caption":"Z-Turn","poi_name":"Z-Turn","subject":"Nate Stewart","author":"Andrew Kittredge","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6135","large":"https://api.americanwhitewater.org/image/images/big/6135"}}],"detail":{"id":"810","permitUrl":null,"permitInfo":null,"description":"Often run as a continuation of the upper Gorge run of the Kennebec especially for larger water craft such as rafts. The put in is down a long steep staircase to the waters edge at Carry Brook. The river from this point down is generally class II and quickwater. The biggest rapid (Big Black Brook Rapid) comes shortly after the put in. Each rapid thereafter is easier to negotiate. Take out just before the bridge at the Forks on either the right or left banks. The river right takeout by the Ball field is easier.\n\n### Technical info\n\n```\nPut in elevation........706'\nTake out elevation......574'\nTotal drop..............132'\nAverage drop/mile.......17'\nDistance................7.8 miles\nRiver width average.....50'\nRiver geology...........Slate ledge\nRiver water quality.....Good, clarity good.\nScenery.................Excellent, isolated wilderness river\nWildlife................Deer, moose, osprey, eagles.\n```","averageGradient":"17","maxGradient":"30","length":"8.1","correlations":[{"reachID":"810","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"2400","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"20000"},"gaugeInfo":{"name":"Kennebec River at The Forks, Maine","gaugeSource":"USGS","gaugeSourceIdentifier":"01042500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"9040","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"6.47","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"45.3397222","longitude":"-69.9619444"},"externalSourc