[{"result":{"data":{"json":{"id":"1059","stub":{"id":"1059","section":"2. FS Rd. 475, 2nd pull off to Sycamore Flats","altname":"Lower Davidson","river":"Davidson River","difficulty":"ItoII","states":["USA-NCR"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"0.6","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"110877","location":{"latitude":"35.2915","longitude":"-82.7755"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"116145","location":{"latitude":"35.2753","longitude":"-82.7134"},"name":"Take Out","distance":"5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"889460","ext":"jpeg","post_id":"892044","description":"This is probably the most dangerous part of the run.  There is quite a bit of water that makes it through the jam so it has some pull.  \r\n\r\nYou can see this log jam easily from the road as you drive in.  Look for it after you pass Avery creek rd (driving upstream)\r\n\r\nThe large flat field on river right makes for an easy portage.\r\n\r\nWater level at 2.5’","caption":"Log jam June 2018 2.5’","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/889460","large":"https://api.americanwhitewater.org/image/images/big/889460"}},{"id":"889511","ext":"jpeg","post_id":"892078","description":"","caption":"Downstream of coontree, before shut in","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/889511","large":"https://api.americanwhitewater.org/image/images/big/889511"}},{"id":"889512","ext":"jpeg","post_id":"892079","description":"","caption":"100 yards up from sycamore flats","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/889512","large":"https://api.americanwhitewater.org/image/images/big/889512"}}],"detail":{"id":"1059","permitUrl":null,"permitInfo":null,"description":"This river is very rain dependent. It takes a good overnight rain storm to get it just up to runnable levels, but will drop about as quick as it rises. An overnight torrental ultimate unreal thunder storm will really get this river moving. At levels around 3.0-3.5 feet, it gets pumping really good. Lots of class II stuff at this level, a few surfing wave's will develop along the way, and lots of moving boogie water.\n\n* * *\n\n**Directions to Put-in:**\n\nFrom Brevard: Take US 276 along the Davidson River north past the ranger\nstation for 3 miles. Turn left on Forest Service Road 475, which takes you to the fish hatchery. We found the best place to put in is the 2nd overlook / pulloff on the left, the one with the \"Roadside Camping Only\" sign. There is a nice sandy beach right there with easy access to the river.\n\n**Directions to Take-out:**\n\nFrom Brevard: Take US 276 along the Davidson River. Go maybe a mile or so, and\nyou will see a sign for Sycamore Flats on the left. There is plenty of parking, picnic tables, and bathrooms. River runs along the back side of the park.\n\nYou can add on about another mile of river running if you take-out around the US 276 / US 76 Bridge before entering the National Forest.\n\n* * *\n\n**Hazards:**\n\nAs always be on the lookout for trees. Stay on the main path of the river or just about any path on the river's right bank. If you take some left passages, be prepared to get stuck on rocks, and even portage around trees at minimum level. Even at higher water levels, I'd stay on the rivers main path.\n\nIf running under 1.5 feet, about half way into the run, there is a large tree crossing the entire river's path. You may need to portage if you can't hop your boat over it. The tree will disapear at higher water levels. The tree's top edge at 1.5 feet is right around the same height as the river level and may not be obvious.\n\nJust past half way, and past the hazard above, you will come to a giganic tree clog. There is a tight squeeze on it's left, and some quick manuvering there after to get around some big rocks. At water levels around 1.5 feet, the right side of the river is somewhat runable around the clog, will be a bumpy ride due to being shallow and rocky, but at higher water levels no problems persists on the right side of the river and is the recomened path. You can scout this clog from roadside. It's about 2.5 miles upstream from the take-out.","averageGradient":"22","maxGradient":null,"length":"5.4","correlations":[{"reachID":"1059","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1.5","beginMediumRunnable":"3","beginHighRunnable":"5","endHighRunnable":"7.5"},"gaugeInfo":{"name":"DAVIDSON RIVER NEAR BREVARD, NC","gaugeSource":"USGS","gaugeSourceIdentifier":"03441000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"40","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"0.6","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"35.27305556","longitude":"-82.7058333"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/03441000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/03441000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"va