whitewater.org/image/images/big/888639"}},{"id":"v1FZUquMb4ryk1fSn5c9J","ext":"jpg","post_id":"jTUiWI5F8mDgIYLXai3CM","description":"","caption":"Channel-wide log in pinball","poi_name":null,"subject":"","author":"Owen Coutts","poi_id":"3Xgjg5Uav4CJQeffrl6K5","photo_date":"2024-05-22T00:00:00.000Z","updated_at":"2026-04-19T20:51:47.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/v1FZUquMb4ryk1fSn5c9J","large":"https://api.americanwhitewater.org/image/images/big/v1FZUquMb4ryk1fSn5c9J"}},{"id":"14609","ext":"jpeg","post_id":"7971","description":"","caption":"Entering Six Pin","poi_name":"Six Pin","subject":"Steve Rodgers","author":"Ben Clack","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/14609","large":"https://api.americanwhitewater.org/image/images/big/14609"}},{"id":"14611","ext":"jpeg","post_id":"7971","description":"","caption":"DDD entering Six Pin","poi_name":"Six Pin","subject":"Dangerous Dave Dalthorp","author":"Ben Clack","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/14611","large":"https://api.americanwhitewater.org/image/images/big/14611"}},{"id":"10585","ext":"jpeg","post_id":"7972","description":"","caption":"N. Fk Blackfoot above bridge","poi_name":"","subject":"","author":"Steve Rodgers","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10585","large":"https://api.americanwhitewater.org/image/images/big/10585"}},{"id":"10586","ext":"jpeg","post_id":"7973","description":"","caption":"Six Pin","poi_name":"Six Pin","subject":"","author":"Steve Rodgers","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10586","large":"https://api.americanwhitewater.org/image/images/big/10586"}},{"id":"12025","ext":"jpeg","post_id":"6538","description":"","caption":"Ben Whaley dropping 7-10","poi_name":"7-10","subject":"Ben Whaley","author":"Ben Clack","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/12025","large":"https://api.americanwhitewater.org/image/images/big/12025"}},{"id":"9648","ext":"jpeg","post_id":"6748","description":"","caption":"N.F. of the Blackfoot...","poi_name":"Below Six Pin","subject":"some guys","author":"Brian Mattingly","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/9648","large":"https://api.americanwhitewater.org/image/images/big/9648"}},{"id":"14610","ext":"jpeg","post_id":"7971","description":"","caption":"Six Pin","poi_name":"Six Pin","subject":"Steve Rodgers","author":"Ben Clack","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/14610","large":"https://api.americanwhitewater.org/image/images/big/14610"}}],"detail":{"id":"986","permitUrl":"","permitInfo":"","description":"The North Fork of the Blackfoot is a Missoula area creeking staple for those willing to hike. It offers kayakers and packrafters a long season, excellent whitewater and scenery, and a character that changes dramatically with flows.  At low flows (200-650) it offers really nice Class III/IV creek boating and ideal advanced packrafting. At medium flows (650-1200) The North Fork is creeky but powerful class IV with one V-. Flows over 1,200 result in a big water feel and it becomes a big fast wave train with some vital hole and wood dodging.  Lower water runs should watch out for abundant/excessive fly fishing traffic, who are often not on the lookout for boats.\n\nAs you hike up, the whitewater ends 1/3 of a mile above the pack bridge.  The N Fork from there to the next pack bridge just above the Dry Fork confluence is class II-.  The steep (~700 feet/mile) gorge below North Fork Falls is V/V+ and can be accessed via the steep and loose gully on the north side, just west of the side trail to the fall lookout.\n\nThe N Fork above the falls is floatable all the way to Carmichael in the late spring and early summer, and offers fast and nervous floating with lots of wood, willows, and a few beefy bedrock drops.","averageGradient":null,"maxGradient":null,"length":"5.3","correlations":[{"reachID":"986","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"350","beginMediumRunnable":"650","beginHighRunnable":"1200","endHighRunnable":"2500"},"gaugeInfo":{"name":"NF Blackfoot R ab Dry Gulch nr Ovando MT","gaugeSource":"USGS","gaugeSourceIdentifier":"12338300","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"1760","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"6.67","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"46.9794944","longitude":"-113.092186"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/12338300","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/12338300/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"high-runnable","latestReading":{"value":"1760","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["110290","3Xgjg5Uav4CJQeffrl6K5","4CJGpMIkkybmom5fD2nKg","115553"],"geometry":{"type":"LineString","coordinates":[[-112.932453,47.161376],[-112.93267,47.161186],[-112.933056,47.160726],[-112.933407,47.160418],[-112.934521,47.160028],[-112.934697,47.159902],[-112.934835,47.159803],[-112.934997,47.159567],[