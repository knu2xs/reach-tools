[{"result":{"data":{"json":{"id":"1495","stub":{"id":"1495","section":"5. River Mill Dam to Willamette River","altname":"","river":"Clackamas","difficulty":"II","states":["USA-ORE"]},"primaryGaugeStatus":{"status":"medium-runnable","latestReading":{"value":"1140","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"other","description":"The River Mill Dam is located at USGS river mile 22.3 and is the most downstream of the series of dams that make up the Clackamas Hydroelectric Project. It has five Francis turbines with a combined maximum generation capacity of 25 MW. It was originally constructed in 1911.","id":"Js7SxlGveU1yXplpBbSPk","location":{"latitude":"45.29907","longitude":"-122.350856"},"name":"River Mill Dam","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"put-in","description":"Access on river left in Milo McIver Park at the upstream end of the park at Riverside Day Use Area. It is located approximately 1/2 mile downstream of River Mill Dam. The park has toilets and a picnic area as well as a campground. The river access has a concrete ramp suitable for trailered and hand-carry craft. The site is administered by Oregon State Parks and requires a day-use fee for use.","id":"1lE01CIF78mA44Rk0UTM4","location":{"latitude":"45.299271","longitude":"-122.360289"},"name":"Milo McIver Park Riverside Upper Boat Ramp","distance":"0.58","photoID":"hhYrypwrGvFJoDMQpEM5a","difficulty":"N/A","approximate":false},{"type":"rapid","description":"Fun rapid immediately below the boat ramp. Deepest channels and best waves are on the right side but there is a sneak on the left. Waves get big and powerful at high flows.","id":"oqxbLwnrnOfhk0LOJJX9O","location":{"latitude":"45.299335","longitude":"-122.361485"},"name":"McIver Boat Ramp","distance":"0.63","difficulty":"II","approximate":false,"photoID":null},{"type":"rapid","description":"Shallow with narrow passages between rocks at low water. Multiple routes.","id":"OwkBjf9Sc42ztNYZfHRX4","location":{"latitude":"45.30097781","longitude":"-122.36883648"},"name":"Bombshelter","distance":"1.33","difficulty":"II","approximate":false,"photoID":null},{"type":"access","description":"Access on river left in Milo McIver Park at the downstream end of the park at Riverbend Day Use area. This access can be used as a take-out for the approximately 2 mile float through the park or a put-in to head downstream from the park. The park has toilets and a picnic area as well as a campground. The river access has a ramp suitable for trailered and hand-carry craft. The site is administered by Oregon State Parks and requires a day-use fee for use.","id":"109478","location":{"latitude":"45.31133","longitude":"-122.379869"},"name":"Milo McIver Park Riverbend Lower Boat Ramp","distance":"2.92","photoID":"xdAPXwykfIgxzBRpZqrjU","difficulty":"N/A","approximate":false},{"type":"access","description":"Unlike many of the other river access points, this access is not in a larger park and just a river access located on river left. This free access is managed by Clackamas County with parking for 15-20 cars and a cobble ramp.","id":"RC6ImwOa9iAJziHrAQF0p","location":{"latitude":"45.327955","longitude":"-122.382253"},"name":"Feldheimer Boat Launch","distance":"4.43","photoID":null,"difficulty":"N/A","approximate":false},{"type":"access","description":"This access is in Baker Park on river right just upstream of the SE Bakers Ferry Road Bridge. The park is managed by Clackamas County and has a day-use fee.","id":"8aMc7x1gHlLj0zI1xdFeu","location":{"latitude":"45.381173","longitude":"-122.411492"},"name":"Barton Park","distance":"9.24","photoID":"3XDMDDdkUAqNkXQPpXgkZ","difficulty":"N/A","approximate":false},{"type":"access","description":"Access is on river left at the confluence of Clear Creek with the Clackmas River and just upstream of the Carver Bridge. The park has a large paved parking area and a dedicated boat launch area with a ramp that can accommodate trailered watercraft. The park is managed by Clackamas County and has a day-use fee.","id":"pigcZEtgYzS1bu5aAlrp5","location":{"latitude":"45.392244","longitude":"-122.496291"},"name":"Carver Park Access","distance":"14.63","photoID":"5UCEUMqyOM8GGdo1Cg92J","difficulty":"N/A","approximate":false},{"type":"access","description":"Access on river right in Riverside Park.","id":"MyLSMB8ubVfEc8LxgR0q4","location":{"latitude":"45.396569","longitude":"-122.561933"},"name":"Riverside Park","distance":"19.51","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":"A park-and-play feature in Clackamette Park. It forms during periods of low flow when the Clackamas River is below 1200 cfs and the stage height of the Willamette River is under 3 ft. The wave forms two to three hours prior to low tide (less than 3 ft) and remains surfable for up to an hour later. During a normal season, this happens from late July through October/November.","id":"107305","location":{"latitude":"45.372262","longitude":"-122.603047"},"name":"Clackamette Wave","distance":"22.57","difficulty":"III","approximate":false,"photoID":"891948"},{"type":"takeout","description":"Take out on river left in Clackamette Park before the confluence with the Willamette River. This park is managed by Oregon City with no entry fee for use.","id":"114723","location":{"latitude":"45.371877","longitude":"-122.603168"},"name":"Clackamette Park Take Out","distance":"22.58","photoID":"891950","difficulty":"N/A","approximate":false},{"type":"access","description":"Access on river right at the confluence with the Willamette River. Suitable for hand-carry craft. The site is managed by the City of Gladstone and has a modest entrance fee for non-residents.","id":"vAgpAas0509h3U2NyaXhx","location":{"latitude":"45.373208","longitude":"-122.607028"},"name":"Dahi Beach Access","distance":"22.63","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":