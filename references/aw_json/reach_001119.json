/images/medium/9807","large":"https://api.americanwhitewater.org/image/images/big/9807"}},{"id":"9806","ext":"jpeg","post_id":"4241","description":"Line is where the log is jammed in. I ran line a bottom of picture. Landed on a pile of rocks.","caption":"Redneck Falls","poi_name":"Redneck Falls","subject":"Lower Rocky Broad","author":"Mike Lewis","poi_id":"102370","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/9806","large":"https://api.americanwhitewater.org/image/images/big/9806"}},{"id":"9813","ext":"jpeg","post_id":"4241","description":"Take out will be on river left. This is looking upstream. Nice open grassy area. Public area to park. Picnic tables. ","caption":"Take out","poi_name":"Take out","subject":"Lower Rocky Broad","author":"Mike Lewis","poi_id":"102387","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/9813","large":"https://api.americanwhitewater.org/image/images/big/9813"}},{"id":"9812","ext":"jpeg","post_id":"4241","description":"Put in for Lower Rocky Broad. This is looking towards Hwy 64 bridge over Rocky Broad. Post office is on the right. Gravel area is where to park. Private property to get to river when you cross the road. Please be aware of this.","caption":"Put in","poi_name":"Put in","subject":"Lower Rocky Broad","author":"Mike Lewis","poi_id":"102370","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/9812","large":"https://api.americanwhitewater.org/image/images/big/9812"}},{"id":"9803","ext":"jpeg","post_id":"4241","description":"Gauge Reads Approx. -.4 to -.6 \r\nLower Than Online Gauge","caption":"Lower Rocky Broad Gauge","poi_name":"Gauge","subject":"Gauge","author":"Mike Lewis","poi_id":"102387","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/9803","large":"https://api.americanwhitewater.org/image/images/big/9803"}},{"id":"9804","ext":"jpeg","post_id":"4241","description":"Slide. Work your way to the right.\r\nPiton rock has been moved away.","caption":"Lower Rocky Broad","poi_name":"Slide ?","subject":"1st Rapid Slide","author":"Mike Lewis","poi_id":"102387","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/9804","large":"https://api.americanwhitewater.org/image/images/big/9804"}},{"id":"9805","ext":"jpeg","post_id":"4241","description":"Major Rapid before Redneck Falls.\r\nWork your way down the center.\r\nAvoid the holes and piton rock at end.","caption":"Lead in Rapid to Redneck","poi_name":"Lead in to Redneck Falls ?","subject":"Lower Rocky Broad","author":"Mike Lewis","poi_id":"102370","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/9805","large":"https://api.americanwhitewater.org/image/images/big/9805"}},{"id":"9808","ext":"jpeg","post_id":"4241","description":"Boof 2. Try to hit fingertip for a clean Boof.","caption":"Boof 2","poi_name":"Boof 2","subject":"Lower Rocky Broad","author":"Mike Lewis","poi_id":"102382","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/9808","large":"https://api.americanwhitewater.org/image/images/big/9808"}},{"id":"12234","ext":"jpeg","post_id":"5683","description":"Redneck Falls is actually the politically correct name for the falls. It was originally named \"mouth-breathing-inbread-white-trash-redneck falls.\"","caption":"(RM) Redneck Falls","poi_name":"Redneck Falls","subject":"","author":"Rob Maxwell","poi_id":"102380","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/12234","large":"https://api.americanwhitewater.org/image/images/big/12234"}}],"detail":{"id":"1119","permitUrl":"","permitInfo":"","description":"The Rocky Broad reclaimed nearly its entire valley during Hurricane Helene in the fall of 2024, taking out roads, houses, and pretty much everything in its path. The Rocky Broad is now and will always be totally different from the Class IV-V boulder garden run that it once was. It is expected that NCDOT will be rebuilding the road through the valley until sometime late in 2027, and at some point in the interim they will be removing the temporary road and the channels they built in the riverbed. After they are done the army corps of engineers is likely to try to 'restore' parts of the river. Suffice it to say that we won't know what the future Rocky Broad is going to look like for a few years, and hopefully paddlers can help shape that future. Paddling the run in the interim is likely a poor choice given the level of construction and destruction in the area.  \n  \nDisregard the rapids listed below, which will be replaced when new beta emerges.","averageGradient":"132","maxGradient":"200","length":"2.8","correlations":[{"reachID":"1119","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"2.87","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"5"},"gaugeInfo":{"name":"Broad River at highway 9 near Chimney Rock","gaugeSource":"NOAA","gaugeSourceIdentifier":"llbn7","gaugeFetchStatus":"ACTIVE","latestFlowReading":null,"latestStageReading":{"value":"0.61","dateTime":"2026-05-12T02:40:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"35.4375","longitude":"-82.241111111111"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/llbn7","text":"NOAA Gauge Details"}}},"migrationErrorExplanation":"Previous Flowbands: \nRange of Boatable Flows (R0-R9): 2.87 - 5 levelFT  Comment: Roughly running 2.88 = 3.6 ft on the bridge gauge\n\nMigration Errors: \nSingle range is valid but doesn't provide low/medium/high runnable\nThere is one comment for all of low/medium/high runnable.","comment":"This is downstream of the bridge gauge, add about 0.7 ft to this gauge to get an approximate paddler's gauge","status":{"status":"below-recommended","latestReading":{"value":"0.61","dateTime":"2026-05-12T02:40:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null}}],"pointOfInterestIDs":["102386","102381","102387"],"geometry":{"type":"LineString","coordinates":[[-82.283442,35.449867],[-82.283242,35.449806],[-82.282916,35.449623],[-82.28232,35.449193],[-82.281604,35.448929],[-82.280775,35.448795],[-82.279335,35.448808],[-82.27772,35.448547],[-82.277475,35.44841],[-82.277175,35.448086],[-82.276718,35.447382],[-82.276662,35.447195],[-82.275948,35.446426],[-82.275321,35.445919],[-82.274549,35.445468],[-82.274248,35.445396],[-82.274172,35.445315],[-82.27333,35.445253],[-82.272418,35.44558],[-82.271664,35.445527],[-82.27095,35.444758],[-82.270372,35.444474],[-82.269134,35.444365],[-82.268393,35.444242],[-82.267325,35.443937],[-82.266798,35.443622],[-82.265789,35.442746],[-82.264779,35.442122],[-82.26373,35.441963],[-82.263183,35.442007],[-82.26283,35.442219],[-82.262704,35.442421],[-82.262106,35.442748],[-82.261552,35.442828],[-82.261112,35.442776],[-82.260987,35.442725],[-82.260799,35.442523],[-82.260378,35.442365],[-82.259933,35.442096],[-82.259664,35.441848],[-82.258754,35.441417],[-82.258534,35.441391],[-82.258458,35.44131],[-82.258069,35.441228],[-82.257736,35.441081],[-82.256367,35.440957],[-82.255827,35.440587],[-82.254949,35.440104],[-82.25461,35.439993],[-82.253906,35.43991],[-82.253239,35.440121],[-82.252735,35.440423],[-82.252559,35.440402],[-82.252308,35.440553],[-82.251534,35.440607],[-82.251138,35.440561],[-82.250636,35.440358],[-82.250073,35.43975],[-82.25,35.439736],[-82.249709,35.439562],[-82.249326,35.439445],[-82.249012,35.439192],[-82.248755,35.439126],[-82.24814,35.438801],[-82.247838,35.438