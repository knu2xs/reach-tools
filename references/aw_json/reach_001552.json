299310","ext":"jpeg","post_id":"299305","description":"","caption":"Mill City Falls","poi_name":"Mill City Falls","subject":"","author":"","poi_id":"5581","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/299310","large":"https://api.americanwhitewater.org/image/images/big/299310"}},{"id":"9ctP5NCtt376UKcoFclZE","ext":"jpg","post_id":"Cs40OHIAbvP7JS392Bo9U","description":null,"caption":"Carnivore (III) at 1000 cfs","poi_name":null,"subject":"Carnivore (III) at 1000 cfs","author":"PNWRafter","poi_id":"5579","photo_date":"2021-07-31T17:27:03.000Z","updated_at":"2021-08-02T17:27:03.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/9ctP5NCtt376UKcoFclZE","large":"https://api.americanwhitewater.org/image/images/big/9ctP5NCtt376UKcoFclZE"}},{"id":"0skGBnjUvIWQvnRKmpX6x","ext":"jpg","post_id":"0skGBnjUvIWQvnRKmpX6x","description":"","caption":"Mill City Falls","poi_name":null,"subject":"Mill City Falls","author":"nickconsole10","poi_id":null,"photo_date":"2021-09-25T10:30:00.000Z","updated_at":"2021-09-25T17:30:22.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/0skGBnjUvIWQvnRKmpX6x","large":"https://api.americanwhitewater.org/image/images/big/0skGBnjUvIWQvnRKmpX6x"}}],"detail":{"id":"1552","permitUrl":null,"permitInfo":null,"description":"One of the most popular boating trips in the state with opportunities throughout the year. Moderate flows provide a great training ground for those just learning the sport. When flows are lower boaters flock to Spencer's for park and play. At high flows this river is a fun ride for more experienced paddlers.\n\nMost of the rapids on this run are class II but with a variety of features that make it a great river for skill building and instruction. Once you pass under the bridge at Gates you are approaching Spencer's Hole. This is a fun rapid but as flows drop it becomes a very popular park and play spot providing dependable playboating opportunities through the summer and fall for paddlers from throughout the region.\n\nSoon after Spencer's you will come to Carnivore which is found in the left hand channel at an island. If you are looking to avoid it you can just take the route around the right side of the island.\n\nContinuing downstream there is some more good class II as you approach the town of Mill City. When you see the bridge come into view you are nearing the take-out. Mill City Falls is just upstream of the bridge and most scout it out before the run as it is easily visible from the take-out. You can take out on river right above the falls or line up for your run and take-out on river right downstream of the old railroad bridge.","averageGradient":"27","maxGradient":null,"length":"6.6","correlations":[{"reachID":"1552","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1000","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"9000"},"gaugeInfo":{"name":"NORTH SANTIAM RIVER AT NIAGARA, OR","gaugeSource":"USGS","gaugeSourceIdentifier":"14181500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"1240","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.13","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"44.75377778","longitude":"-122.2974444"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/14181500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/14181500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"migration-runnable","latestReading":{"value":"1240","dateTime":"20