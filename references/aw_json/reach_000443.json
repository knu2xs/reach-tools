org/image/images/medium/4212","large":"https://api.americanwhitewater.org/image/images/big/4212"}},{"id":"1038","ext":"jpeg","post_id":"3664","description":"","caption":"Bob Taylor at T'ville","poi_name":"Babylon Hole","subject":"Tariffville","author":"Michael Phelan","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1038","large":"https://api.americanwhitewater.org/image/images/big/1038"}},{"id":"10914","ext":"mpg","post_id":"7738","description":"","caption":"playing","poi_name":"t-ville hole","subject":"betheriver","author":"wavehopper","poi_id":"107228","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10914","large":"https://api.americanwhitewater.org/image/images/big/10914"}},{"id":"10916","ext":"mpg","post_id":"7738","description":"","caption":"playing 2","poi_name":"t-ville hole","subject":"?","author":"wavehopper","poi_id":"107228","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10916","large":"https://api.americanwhitewater.org/image/images/big/10916"}},{"id":"11755","ext":"mpg","post_id":"7739","description":"spawning salmon","caption":"hole jumping","poi_name":"t-ville hole","subject":"wavehopper","author":"wavehopper","poi_id":"107228","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/11755","large":"https://api.americanwhitewater.org/image/images/big/11755"}},{"id":"887576","ext":"jpeg","post_id":"890355","description":"Inquisition ledge at 5ft on the gauge. There is a tongue on river left","caption":"Inquisition","poi_name":null,"subject":null,"author":"Southgate","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887576","large":"https://api.americanwhitewater.org/image/images/big/887576"}},{"id":"15404","ext":"jpeg","post_id":"9364","description":"","caption":"Turn right at dam","poi_name":"Tville Dam","subject":"telenaut","author":"Randy J. Goat","poi_id":"107228","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/15404","large":"https://api.americanwhitewater.org/image/images/big/15404"}},{"id":"882324","ext":"jpeg","post_id":"885027","description":"Farmington River, Tariffville Gorge, gauge @3.8' ~2200cfs, old bridge piers \"the Abutments,\" most downstream (4th) pier on Tariffville (west) side, new strainer completely blocking river-right channel.  Danger persists at all levels until tree is removed.  Location: [41.905576, -72.760363]","caption":"DANGER - new strainer","poi_name":"Tville Gorge \"Abutments\"","subject":"river hazard","author":"David Su","poi_id":"107228","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/882324","large":"https://api.americanwhitewater.org/image/images/big/882324"}}],"detail":{"id":"443","permitUrl":"","permitInfo":"","description":"**Tville (as it's called by locals) contains some of the most popular and consistent whitewater in Connecticut.**\n\nYou can either run the river or park and play. Most boaters choose to park and play. To park and play, park at the end of Tunxis Ave. on the East Granby side, and walk down the dirt trail to the river. From here you can access the majority of the play features Tville has to offer, and still walk back up to your car when you're done.\n\nMost boaters that run the river put in at Tariffville Park and takeout either at Tunxis Ave. (which avoids the slightly tougher sections of the gorge) or takeout after the former location of the broken dam.\n\nMost evenings in the summer a solid crowd of friendly and inviting paddlers can be found throwing down in Tville's great play holes. Boaters from all over the area come here because there's consistent flows, year round, that provide a variety of options for play and river running. Stop by and check it out, you won't be let down.\n\n2.4 feet on the gauge is considered to be the best playboating level at the lower, main hole. It can be surfed down to about 1.5 feet, and starts to flush out around 2.7 feet. However, at 3.0+ feet, a hole above this feature called Babylon begins to form that offers some good rides.\n\nTville is, however, not without some areas for concern. There are a series of concrete bridge abutments that have been the site of a fatality due to a pinned boater. These abutments supported the bridge that connected Tunxis Ave. in East Granby to Tunxis Ave. in Tariffville. They are located on the river left and river right side of the river where it passes Tunxis Ave. They can be safely navigated down the center of the river, or for a more challenging and bumpy ride, on the river right side. They're not an overwhelming dangerous feature, but boaters should make a point to never come into physical contact with the abutments when traveling down river to avoid a pin.\n\nPreviously, there was a broken dam downstream of the main play area. However, this dam was removed in 2012. More information can be found on the [Farmington River Watershed Association's website](http://frwa.org/what-we-do/research-stewardship/habitat-study-and-restoration/dam-and-culvert-projects-fish-passage/dam-removals-and-retrofits/).\n\n**Hole to China Slide:**\n\nDescription from David Silk:\n\nAt flows above 5.8 paddle across from just above the takeout bridge to the tributary on the far shore. Hike up stream and over the highway exit ramp to the top of the slide. The slide itself is ~60ft long and drops 15ft. Put in on river left in the pool above the tunnel, and check for wood on your way up.","averageGradient":"15","maxGradient":"40","length":"1.7","correlations":[{"reachID":"443","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":"1.6 to 2.8 is a good level for playboating at &amp;quot;Enterprise,&amp;quot; the main park-n-play hole and \"Shuttlecraft\" the upper playhole.\r\n","highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":"IV","beginLowRunnable":"1.2","beginMediumRunnable":"1.6","beginHighRunnable":"4.5","endHighRunnable":"7.1"},"gaugeInfo":{"name":"FARMINGTON RIVER AT TARIFFVILLE, CT","gaugeSource":"USGS","gaugeSourceIdentifier":"01189995","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"766","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.8","dateTime":"2026-05-12T03:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"41.90828333","longitude":"-72.75935278"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/01189995","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/01189995/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"medium-runnable","latestReading":{"value":"1.8","dateTime":"2026-05-12T03:15:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null}}],"pointOfInterestIDs":["110054","100361","100360","115312"],"geometry":{"type":"LineString","coordinates":[[-72.76500407834791,41.913919770751306],[-72.76502339749442,41.91380180160809],[-72.76508879749434,41.91330200160888],[-72.76455693082846,41.912834668276275],[-72.76376379749638,41.91235960161032],[-72.7628561974978,41.911918601611035],[-72.76199433083247,41.91156306827821],[-72.76120899750038,41.91133006827857],[-72.76051399750145,41.91129226827866],[-72.76042419750155,41.91108486827898],[-72.76018819750192,41.91088686827931],[-72.76035033083502,41.91041826828001],[-72.76044133083485,41.91007440161388],[-72.76048093083483,41.90992500161411],[-72.76043693083489,41.90933140161502],[-72.76026899750184,41.909037868282155],[-72.759862797502