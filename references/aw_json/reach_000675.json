cription":"","caption":"Rat Hole 2","poi_name":"Rat Hole","subject":"Brian McAllister","author":"Spalding Hurst","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/12371","large":"https://api.americanwhitewater.org/image/images/big/12371"}},{"id":"12369","ext":"mov","post_id":"6081","description":"","caption":"Meat Grinder","poi_name":"Meat Grinder","subject":"Spalding Hurst","author":"Jay Thomas","poi_id":"107353","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/12369","large":"https://api.americanwhitewater.org/image/images/big/12369"}},{"id":"12464","ext":"jpeg","post_id":"6082","description":"","caption":"Second Drop Meat Grinder (Jay)","poi_name":"Meat Grinder","subject":"Jay Thomas","author":"Kevin Hisel","poi_id":"107353","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/12464","large":"https://api.americanwhitewater.org/image/images/big/12464"}},{"id":"12463","ext":"jpeg","post_id":"6082","description":"","caption":"Sencond Drop Meat Grinder","poi_name":"Meat Grinder","subject":"Spalding Hurst","author":"Kevin Hisel","poi_id":"107353","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/12463","large":"https://api.americanwhitewater.org/image/images/big/12463"}},{"id":"12462","ext":"jpeg","post_id":"6082","description":"","caption":"First Drop Meat Grinder","poi_name":"Meat Grinder","subject":"Spalding Hurst","author":"Kevin Hisel","poi_id":"107353","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/12462","large":"https://api.americanwhitewater.org/image/images/big/12462"}},{"id":"997","ext":"jpeg","post_id":"1229","description":"","caption":"Railroad trestle rapid on Lower Russell Fork","poi_name":"Trestle Rapid","subject":"","author":"Barry Grimes","poi_id":"107356","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/997","large":"https://api.americanwhitewater.org/image/images/big/997"}},{"id":"4306","ext":"jpeg","post_id":"3680","description":"Second drop of meatgrinder.","caption":"Meatgrinder","poi_name":"Meatgrinder","subject":"Sarah Martin","author":"Gerald DeLong","poi_id":"107353","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/4306","large":"https://api.americanwhitewater.org/image/images/big/4306"}}],"detail":{"id":"675","permitUrl":"","permitInfo":"","description":"This section contains two Class III rapids Meatgrinder and Pinball and is Class II otherwise. Intermediate paddlers may wish to run this two mile section in combination with other sections of river to gain more river miles. This river is runnable in winter/spring and begins to lose volume in late spring and early summer perhaps not worth making a trip.  During the first four weekends of October this river gets a special release to draw down a lake upstream and has guaranteed flows then.\n\nThere are multiple take-outs for this section making it 2.5, 3.5 or 6 mile runs.  The first is at Carson Island and the Pine Mountain Trail State Park eastern terminus.\n\nThere are ample spots to take out in Elkhorn City along the river left bank starting above the second abandoned steel girder bridge that you encounter on the run and extending down behind the businesses on Russell Street.  RFG Society is the best spot in town and is owned and operated by paddlers.  Coffee and food are always homemade, fresh and delicious.\n\nAnother takeout is at the railroad bridge adjacent to the Gas station on the edge of Elkhorn on Highway 80. (3.5 mile takeout)\n\nTakeouts below Elkhorn City:\n\nDownstream side of the concrete bridge crossing at Beaver Bottom. ( 4 mile takeout)\n\nDownstream of both bridges at Pond Creek Road (6 mile takeout)","averageGradient":null,"maxGradient":null,"length":"8","correlations":[{"reachID":"675","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"200","beginMediumRunnable":"500","beginHighRunnable":"2000","endHighRunnable":"5000"},"gaugeInfo":{"name":"Russell Fork Gorge","gaugeSource":"CALCULATED","gaugeSourceIdentifier":"35795407","gaugeFetchStatus":"ACTIVE","latestFlowReading":null,"latestStageReading":null,"location":{"latitude":"37.271255","longitude":"-82.302734"},"externalSourceLinks":null},"migrationErrorExplanation":null,"comment":null,"status":null}],"pointOfInterestIDs":["108989","114224","6pLOUZSptAgPYvkdMLlXi"],"geometry":{"type":"LineString","coordinates":[[-82.32365945,37.2978559],[-82.32373238,37.29782585],[-82.32431173,37.2977149],[-82.32491111,37.29745095],[-82.3249095,37.29744864],[-82.325238,37.29738],[-82.325548,37.297199],[-82.325612,37.297098],[-82.325671,37.29678],[-82.325537,37.29626],[-82.32503,37.295769],[-82.324682,37.295658],[-82.324412,37.295375],[-82.324148,37.295309],[-82.323917,37.295066],[-82.323646,37.295035],[-82.323377,37.294752],[-82.323223,37.294338],[-82.323185,37.294045],[-82.323257,37.293657],[-82.323477,37.293213],[-82.323858,37.292895],[-82.324819,37.292427],[-82.325496,37.292252],[-82.32605,37.292242],[-82.326352,37.292349],[-82.326597,37.292521],[-82.326951,37.292597],[-82.327794,37.293017],[-82.32829,37.293074],[-82.328889,37.29307],[-82.329971,37.29294],[-82.330705,37.292951],[-82.332464,37.293151],[-82.332882,37.293379],[-82.333152,37.293409],[-82.333442,37.293586],[-82.334053,37.293764],[-82.334336,37.293976],[-82.334684,37.294088],[-82.334954,37.294371],[-82.335089,37.294386],[-82.335494,37.294685],[-82.335855,37.294726],[-82.336208,37.295054],[-82.336819,37.295358],[-82.337083