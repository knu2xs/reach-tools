/6318","large":"https://api.americanwhitewater.org/image/images/big/6318"}},{"id":"6327","ext":"jpeg","post_id":"6593","description":"","caption":"Carla at Snake","poi_name":"Snake","subject":"Carla and Mike","author":"Dave Gulbrandson","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6327","large":"https://api.americanwhitewater.org/image/images/big/6327"}},{"id":"6326","ext":"jpeg","post_id":"6593","description":"","caption":"Head Waters for streamkeeper reach","poi_name":"","subject":"West Rosebud Head Waters","author":"Dave Gulbrandson","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6326","large":"https://api.americanwhitewater.org/image/images/big/6326"}},{"id":"6322","ext":"jpeg","post_id":"6594","description":"","caption":"Mike boofing at Stump","poi_name":"Stump","subject":"","author":"Dave Gulbrandson","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6322","large":"https://api.americanwhitewater.org/image/images/big/6322"}},{"id":"6325","ext":"jpeg","post_id":"6594","description":"","caption":"Ron at Boat Boy","poi_name":"Goat Boy","subject":"Ron","author":"Dave Gulbrandson","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6325","large":"https://api.americanwhitewater.org/image/images/big/6325"}},{"id":"50772","ext":"jpeg","post_id":"194072","description":"","caption":"Blue Angel","poi_name":"Snake","subject":"Ian, Barry, Orion, Wes, Ho","author":"Steve Rodgers","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/50772","large":"https://api.americanwhitewater.org/image/images/big/50772"}},{"id":"50777","ext":"jpeg","post_id":"194243","description":"","caption":"Dick Lewan","poi_name":"","subject":"","author":"Steve Rodgers","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/50777","large":"https://api.americanwhitewater.org/image/images/big/50777"}},{"id":"50773","ext":"jpeg","post_id":"194072","description":"","caption":"Boof!","poi_name":"","subject":"Orion Helms","author":"Steve Rodgers","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/50773","large":"https://api.americanwhitewater.org/image/images/big/50773"}},{"id":"50776","ext":"jpeg","post_id":"194243","description":"","caption":"Shuttle","poi_name":"","subject":"","author":"Steve Rodgers","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/50776","large":"https://api.americanwhitewater.org/image/images/big/50776"}}],"detail":{"id":"1020","permitUrl":"","permitInfo":"","description":"The West Rosebud is usually divided into two distinct sections by local paddlers. The short but fun Upper run is about two and a half miles long and contains almost continuous whitewater. The longer Lower run is more than 10 miles long, with most of that distance in a wilderness setting. Although this lower stretch begins with the two most difficult rapids on the river and ends with a mile of fun Class IV, it has long sections of scenic flat water. In combination, the West Rosebud offers a unique opportunity for a full range of creeking conditions during warm summer days.\n\nThe put-in for the Upper run is easy and beautiful--just slide into Emerald Lake and enjoy the spectacular view of the still snow-covered peaks of the Beartooth Mountains while the slowest member of the party is still struggling with boating gear. The West Rosebud ramps down quickly from the outlet of Emerald Lake. The first half-mile of the run drops at an average rate of about 150 fpm through two rapids. The first rapid, Spillway, tends to be rocky at almost any level as the river widens and sweeps around a right turn visible from the road on the way to the put-in. A big eddy on the left turn near the bottom of the rapid also marks the beginning of the more difficult second rapid, Triple Tongue. At higher water levels, this rapid can become pushy.\n\nAfter a half mile of fast and increasingly interesting water, the river enters the second steep section. This stretch, over a mile long, contains the best rapids on the Upper run. The first horizon line leads to an island and marks Snake, where the line is usually down the left channel. The hardest rapid on this run, Stump, is also marked by a horizon line and deserves a scout the first time down. At higher water levels (above 2.5 on the bridge gage), this rapid is a class V with three large, offset holes. Snag is not far below, again marked by an island, and usually run down the narrower right channel. Finally, Goat Boy is a long rapid with several large holes near the end. A partially submerged log spanning the entire creek has made the upper part of the rapid more hazardous.\n\nThe West Rosebud is much easier from Goat Boy down to the takeout at Pine Grove Campground. This run is usually done several times in one day if paddlers don't decide to continue on down the lower West Rosebud\n\nThe Lower run begins with slow, flat water with occasional logjams after leaving Pine Grove Campground. Not long after the river re-enters forested hillsides, it turns left and drops over an obvious horizon line. The West Rosebud drops over 100 feet in the next 800 yards, creating two Class V+ rapids. The first, Thorpe, presents a technical line down to a constriction against the left wall and a benign-looking hole that always seems bottomless. After a short section of flat water, the second rapid, Terminal Moraine, is almost always portaged on the right. This rapid, immediately above another island, presents the full array of hazards, including obstructions, drops and wood.\n\nThe river regains a quieter mood after Terminal Moraine. With the exception of two short canyons with Class III water, the river offers a scenic float for nearly four miles down to the second bridge that was traversed on the way up to the put-in. Below the bridge, the pace picks up again, and the West Rosebud drops 160 feet in the next mile in an exhilarating Class IV finish. Portions of this section are visible from the road on the way up to Emerald Lake, and should be checked for wood. The takeout is marked by an irrigation diversion on the right bank. A short walk from the river brings paddlers back to the shuttle vehicle parked in a small, flower-filled meadow.","averageGradient":"150","maxGradient":"200","length":"2.8","correlations":[{"reachID":"1020","isPrimary":false,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"300","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"750"},"gaugeInfo":{"name":"W Rosebud Cr at Emerald Lk Campground nr Roscoe","gaugeSource":"USGS","gaugeSourceIdentifier":"06204070","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"88","dateTime":"2026-05-12T02:50:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.69","dateTime":"2026-05-12T02:50:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"45.25438735","longitude":"-109.6998945"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/06204070","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/06204070/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":"Previous Flowbands:\nRange of Boatable Flows (R0-R9): 300 - 750 cfs Adjusted Difficulty: null Comment: NOTE: this gage indicates realtime flow in the run, but is not the gage used to trigger summer flow releases. \n\nMigration Errors:\nSingle range is valid but doesn't provide low/medium/high runnable\nThere is one comment for all of low/medium/high runnable.","comment":null,"status":{"status":"below-recommended","latestReading":{"value":"88","dateTime":"2026-05-12T02:50:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}},{"reachID":"1020","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"300","beginMediumRunnable":"400","beginHighRunnable":"550","endHighRunnable":"750"},"gaugeInfo":{"name":"West Rosebud Creek near Roscoe MT","gaugeSource":"USGS","gaugeSourceIdentifier":"06204050","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"68","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"0.81","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"45.24323889","longitude":"-109.7313028"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/06204050","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/06204050/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"68","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["110652","115921"],"geometry":{"type":"LineString","coordinates":[[-109.690781,45.257084],[-109.690719,45.257096],[-109.689217,45.257383],[-109.689174,45.257391],[-109.68853,45.25773],[-109.688208,45.257829],[-109.6875,45.257791],[-109.687253,45.257776],[-109.686513,45.257859],[-109.68