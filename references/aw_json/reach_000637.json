[{"result":{"data":{"json":{"id":"637","stub":{"id":"637","section":"2. Spruce Tree Camp to Gold Creek","altname":"","river":"St. Joe","difficulty":"III","states":["USA-IDA"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"5150","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"This campground located 12 miles up Forest Road 218 features 9 camp units, potable water, and vault toilets. Good river access is available right at the entrance to the campground (downstream of the main kiosk). This campground marks the end of Forest Road 218.","id":"110836","location":{"latitude":"47.038937","longitude":"-115.347468"},"name":"Spruce Creek Campground, Put-In","distance":"0","photoID":"CSjfB48Lwy8uxljuHywHn","difficulty":"N/A","approximate":false},{"type":"other","description":"The Red Ives Cabin located 10 miles upstream Forest Road 218 is a popular location in the Idaho Panhandle National Forests that can be reserved for overnight use. It served as the Ranger Station for the Red Ives Ranger District of the St. Joe National Forest from the 1930s to 1984. A bridge also crosses the river here.","id":"Mu8u0FTWoTFMDLsZUWJe7","location":{"latitude":"47.056389","longitude":"-115.352958"},"name":"Red Ives Ranger Station","distance":"1.87","photoID":"OZfVqNbHD0uowuWZbFs66","difficulty":"N/A","approximate":false},{"type":"other","description":"Dispersed camping is available in the vicinity of the bridge and a good access to the water is on the downstream river right side of the bridge.","id":"UjUGD4jGKzNtIxDsKO3Wt","location":{"latitude":"47.083097","longitude":"-115.355765"},"name":"Beaver Creek bridge access","distance":"4.37","photoID":null,"difficulty":"N/A","approximate":false},{"type":"other","description":"This campground located 3 miles up Forest Road 218 features 14 camp units, potable water (June-October), and vault toilets.","id":"ijJiJox37