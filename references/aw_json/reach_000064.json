[{"result":{"data":{"json":{"id":"64","stub":{"id":"64","section":"Rt. 257(County Road 41) to Walston Bridge","altname":"Camp O'Rear to Walston Bridge","river":"Blackwater Creek","difficulty":"II","states":["USA-ALB"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"127","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"110220","location":{"latitude":"33.9091","longitude":"-87.257"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"115482","location":{"latitude":"33.9047","longitude":"-87.229"},"name":"Take Out","distance":"4","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"100656431","title":null,"post_date":"2008-12-14 05:00:00+00","detail":"I just got out of this creek..... literally. My cousin and I put in at HWY 257, the flow was at 2500 CFS and it was definitely way too much for an open canoe. Water was swamping in badly. There were really big holes and waves in some spots. We flipped after .3 miles and had to swim out of the current to the bank. Might be possible in a kayak, but it would still be really difficult. Be careful!","user":null}],"photos":[{"id":"884475","ext":"jpeg","post_id":"887174","description":"","caption":"Photo from old bridge at the put-in","poi_name":"","subject":"","author":"A Dover","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/884475","large":"https://api.americanwhitewater.org/image/images/big/884475"}},{"id":"884476","ext":"jpeg","post_id":"887175","description":"","caption":"Rebar at the take out","poi_name":"","subject":"","author":"A Dover","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/884476","large":"https://api.americanwhitewater.org/image/images/big/884476"}},{"id":"884477","ext":"jpeg","post_id":"887176","description":"","caption":"Recovery Pool","poi_name":"","subject":"","author":"A Dover","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/884477","large":"https://api.americanwhitewater.org/image/images/big/884477"}},{"id":"884478","ext":"jpeg","post_id":"887177","description":"","caption":"View from the old bridge at the put-in","poi_name":"","subject":"","author":"A Dover ","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/884478","large":"https://api.americanwhitewater.org/image/images/big/884478"}}],"detail":{"id":"64","permitUrl":"","permitInfo":"","description":"Most boaters put in just off of Hwy 257, near the Boy Scout Camp.  If you're in the area and the Mulberry and Locust aren't running this is a good alternative.  It's a mellow paddle at lower levels with a few play spots.\n\nTaken from Alabama whitewater: \"Located just north of Jasper, Blackwater creek is a scenic 4-mile trip with Class II rapids and shoals. This makes a great introductory whitewater trip for the beginner and seems to run more often than many other rivers in the state. This is probably due to higher rain amounts to the west and a swamp upstream acting as a capacitor for the flow. Blackwater will go up to a level after a rain and then hold there for a day or two rather than falling off sharply.\n\nAt 500 cfs, there is a great surfing wave adjacent to a Boy Scout campground which is complete with picnic tables and shelter (a great place for lunch). There is one good, long Class II+ rapid with a good surf spot in the final drop. Ideal level is between 500 and 750 cfs. A 1500 cfs trip will be a quick run with fast water and big waves; the longest rapid may have big holes at this level. Over 500 cfs, there is a fair bit of play on several spots along the river.\"\n\nAlabama Canoe Rides and Float Trips, Foshee, John\n\nSee also [www.alabamawhitewater.com](http://www.alabamawhitewater.com/guide/guide_files2/blackwater.htm).","averageGradient":"0","maxGradient":"0","length":"4.2","correlations":[{"reachID":"64","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"300","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"1500"},"gaugeInfo":{"name":"BLACKWATER CREEK NEAR MANCHESTER AL","gaugeSource":"USGS","gaugeSourceIdentifier":"02453000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"127","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"2.93","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"33.90843985","longitude":"-87.2569514"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/02453000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/02453000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"127","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["110220","115482"],"geometry":{"type":"LineString","coordinates":[[-87.25711934061806,33.909027366351104],[-87.25697390833335,33.908788414033495],[-87.25674657500036,33.908485414033976],[-87.25670350833377,33.908423680700714],[-87.25658270833395,33.908275080700946],[-87.25645257500082,33.90809008070124],[-87.25610937500136,33.907513680702095],[-87.25593050833498,33.90718788070263],[-87.25559570833548,33.90660868070353],[-87.2555371083356,33.90651341403703],[-87.2554947083