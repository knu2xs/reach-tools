[{"result":{"data":{"json":{"id":"733","stub":{"id":"733","section":"1) Lantz to Roddy Covered Bridge","altname":"","river":"Owens Creek","difficulty":"IItoIV","states":["USA-MRY"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"20","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"112727","location":{"latitude":"39.6757011413574","longitude":"-77.4583969116211"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"118010","location":{"latitude":"39.6128005981445","longitude":"-77.359001159668"},"name":"Take Out","distance":"5.3","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"733","permitUrl":null,"permitInfo":null,"description":"Put in 300 yards west of Lantz, by the church.\n\nThere's one class IV- in about a half mile, but otherwise it's class III- until the railroad bridge alongside Md 81, at 2.4 miles.\n\nThe next 0.4 miles, down to the roadside parking area used by many fishermen, is class IV.\n\nFrom there to the Roddy covered bridge, below US 15, is class III+, with few strainers.\n\nYou can scout almost the entire run from the road.\n\nEd Evangelidi testifies:\n\nThe upper part of this run has a few wire strands across the creek that are not too noticeable but easy to negotiate. This is followed by a new private low water bridge that may cause problems. In the Class 4 section, consider that any strainer in this very fast water may cause grave bodily harm.\n\nRobert Miller further testifies:\n\n_\"The creek starts as Class 2 and builds from there. When you come upon a railroad bridge, the action is going to pick up fast. The creek steepens and goes down continuous rocky rapids, some of which come at you very fast and are pretty steep. Be on the lookout for trees! The good action continues for over a mile and has some really neat sections. At one point, the creek bumps into a rock cliff on the right with a small waterfall pouring off the cliff. It is a beautiful sight! As you approach the Rt. 550 bridge, the action starts to let up but remains continuous. This is a great run to combine with the other creeks in the area.\"_","averageGradient":"95","maxGradient":"190","length":"5.2","correlations":[{"reachID":"733","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"500","beginMediumRunnable":"700","beginHighRunnable":"1500","endHighRunnable":"5000"},"gaugeInfo":{"name":"CATOCTIN CREEK NEAR MIDDLETOWN, MD","gaugeSource":"USGS","gaugeSourceIdentifier":"01637500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"20","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.7","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"39.42725","longitude":"-77.55616667"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/01637500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/01637500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"20","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["112727","118010"],"geometry":{"type":"LineString","coordinates":[[-77.458352,39.675748],[-77.458323,39.67572],[-77.458088,39.675352],[-77.457988,39.675149],[-77.457797,39.674908],[-77.45769,39.674699],[-77.457669,39.674584],[-77.457676,39.674452],[-77.45774,39.674309],[-77.457846,39.674