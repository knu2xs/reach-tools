[{"result":{"data":{"json":{"id":"1005","stub":{"id":"1005","section":"1. Youngs Creek to Mid Creek","altname":"","river":"Flathead, South Fork","difficulty":"IIplus","states":["USA-MNT"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"10.78","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"This is the standard access for hiking in to the headwaters. If early in the season you can start your run on Young's Creek.","id":"P6YgYyXFTfyyQU1aP8NGd","location":{"latitude":"47.227345","longitude":"-113.199275"},"name":"Lodgepole Creek Trailhead - Access Trail to Put-in","distance":"0","photoID":null,"difficulty":null,"approximate":false},{"type":"put-in","description":"Another access point to hike in to the headwaters and Young's Creek. If early in the season you can start your run on Young's Creek.","id":"h6IPbszpLY8887QPo68vX","location":{"latitude":"47.259973","longitude":"-113.425296"},"name":"Pyramid Pass Trailhead - Access Trail to Put-in","distance":"0","photoID":null,"difficulty":null,"approximate":false},{"type":"other","description":"The confluence of Youngs Creek and Danaher Creek, deep in the Bob Marshall Wilderness, marks the start of the South Fork Flathead River and a potential starting point for trips. Be aware of channel-spanning log jams at the start that may require a portage over a gravel bar.","id":"fiGGpcJ58QwcqBIRZuARv","location":{"latitude":"47.445525","longitude":"-113.183741"},"name":"Youngs Creek - Danaher Creek Confluence","distance":"0.01","photoID":null,"difficulty":null,"approximate":false},{"type":"other","description":"Big Prairie is a historic Forest Service ranger station and work center established in 1904 and moved to its current location in 1912. It is recognized from the river by the pack bridge. The work center is a quarter mile up the right bank. Floaters can stop in for current river and trail conditions. This is a traditional start point for the run, for those hiking in from Holland Lake Trailhead, but you can head upstream for a higher put-in.","id":"24txG3j3KLGO2CtBKT2bt","location":{"latitude":"47.506063","longitude":"-113.243317"},"name":"Big Prairie Pack Bridge and Work Center","distance":"6.62","photoID":null,"difficulty":null,"approximate":false},{"type":"other","description":"The White River is named for the white limestone rock that lines the river bottom and represents the largest tributary to the South Fork Flathead. The lower 6 miles is navigable in in the early part of the season.","id":"JFdynXW0VaDfT48VhSQQY","location":{"latitude":"47.586753","longitude":"-113.299078"},"name":"White River confluence","distance":"16","photoID":null,"difficulty":null,"approximate":false},{"type":"other","description":"Forest Service Guard Station at Salmon Forks where the Big Salmon Creek joins the South Fork Flathead. Paddlers can enjoy a side hike up to Big Salmon Lake.","id":"jJiYYz8Buozca5wTrZhzO","location":{"latitude":"47.62609","longitude":"-113.352005"},"name":"Salmon Forks Guard Station","distance":"20.86","photoID":null,"difficulty":null,"approximate":false},{"type":"other","description":"The Black Bear Pack Bridge is one of the few river crossings. The Black Bear Guard Station is up the bank on river left. It was built in 1906 and moved to its current location in 1912.","id":"70SnfKydlnFuXv57Rz8bZ","location":{"latitude":"47.715458","longitude":"-113.372789"},"name":"Black Bear Pack Bridge and Guard Station","distance":"29.36","photoID":null,"difficulty":null,"approximate":false},{"type":"other","description":"Black Bear Creek enters on river right and marks the transition from the broad valley upstream to a canyon that continues downstream to Meadow Creek Gorge. Below this point, good campsites are more limited.","id":"3gNDbaQH3nqgdamcpVKBC","location":{"latitude":"47.743009","longitude":"-113.387787"},"name":"Black Bear Creek confluence","distance":"32.56","photoID":null,"difficulty":null,"approximate":false},{"type":"rapid","description":null,"id":"U845wSLX1q4ok4OXxh6x8","location":{"latitude":"47.763445","longitude":"-113.39479"},"name":"Rapid","distance":"34.51","difficulty":"II","approximate":false,"photoID":null},{"type":"other","description":"Mid Creek is the waypoint that marks the approach of Meadow Creek Gorge (Class IV/V). The last possible take-out above the gorge is about a mile downstream.","id":"SaEdgroa2ZL8TM5GjDmjq","location":{"latitude":"47.782993","longitude":"-113.407185"},"name":"Mid Creek confluence","distance":"36.04","photoID":null,"difficulty":null,"approximate":false},{"type":"other","description":"The actual take-out for this segment, for those who don't plan to paddle the Meadow Creek Gorge, is about a mile downstream of the Mid Creek confluence. Pull out on the gravel bar just upstream of the canyon entrance. Be alert for a sign on the rocky ledge marking the take-out on river right but don't depend on it. To reach the Meadow Creek Trailhead and your take-out vehicle, it is an approximately 3.5 hike downstream along the trail on river right paralleling the Meadow Creek Gorge.","id":"1oNCFkBulG6wPwc5zP2Dn","location":{"latitude":"47.797728","longitude":"-113.415032"},"name":"Mid Creek Take-out","distance":"37.29","photoID":null,"difficulty":null,"approximate":false},{"type":"takeout","description":"Trips end here with a hike out of the Bob Marshall Wilderness accessed from this trailhead. You can also use this as the place to start a trip if you are not doing the whole run or want to avoid the shuttle; just start your trip  by hiking upstream from the bottom.","id":"109702","location":{"latitude":"47.83237","longitude":"-113.419675"},"name":"Meadow Creek Trailhead Accessing Take-out","distance":"37.3","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"1005","permitUrl":null,"permitInfo":null,"description":"Beginning at the confluence of Youngs Creek and Danaher Creek, the South Fork Flathead continues to grow in popularity as lightweight gear and boats make this class II journey through the Bob Marshall Wilderness more accessible. Oz Hawksley explored this river during the American Whitewater summer river trip of 1964, using 30 pack horses to carry rafts, foldboats, and gear in. Boats and supplies can still be packed in over mountain passes, and there are outfitters providing this service, but smaller trips using packrafts are becoming more popular. The story of that first American Whitewater trip is recorded in the 1965 spring edition of the American Whitewater Journal. The river was designated as a segment of the [Flathead River National Wild and Scenic River](http://www.nps.gov/rivers/flathead.html) on October 12th, 1976 from its headwaters to the Hungry Horse Reservoir.\n\nThe float season is generally from mid-June through late August and the whitewater is generally class II at moderate flows with potential for wood hazards.\n\nA floater's guide, *Three Forks of the Flathead*, is available for this section of river.\n\nSadly, the river rangers spend much time cleaning up campsites from people who do not pack out their poop. With the confined traffic rivers like this get, the proper *Leave No Trace Etiquette* is to **pack out your poop** in a Wag Bag or other system. Burying poop is not ideal as it if often dug up by animals. Any sportsman store or Army surplus store will carry wagbags. Please plan ahead in regard to your *\\#2* and help keep this environment as iconic as it should be.","averageGradient":"22","maxGradient":null,"length":"37","correlations":[{"reachID":"1005","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"5","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"15"},"gaugeInfo":{"name":"S F Flathead R ab Twin C nr Hungry Horse MT","gaugeSource":"USGS","gaugeSourceIdentifier":"12359800","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"11200","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"10.78","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"47.9790972","longitude":"-113.5606833"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/12359800","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/12359800/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"migration-runnable","latestReading":{"value":"10.78","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null}}],"pointOfInterestIDs":["P6YgYyXFTfyyQU1aP8NGd","h6IPbszpLY8887QPo68vX","fiGGpcJ58QwcqBIRZuARv","24txG3j3KLGO2CtBKT2bt","JFdynXW0VaDfT48VhSQQY","jJiYYz8Buozca5wTrZhzO","70SnfKydlnFuXv57Rz8bZ","3gNDbaQH3nqgdamcpVKBC","U845wSLX1q4ok4OXxh6x8","SaEdgroa2ZL8TM5GjDmjq","1oNCFkBulG6wPwc5zP2Dn","109702"],"geometry":{"type":"LineString","coordinates":[[-113.183652,47.445481],[-113.183674,47.445482],[-113.183674,47.445482],[-113.183824,47.445577],[-113.183942,47.445729],[-113.183942,47.445729],[-113.184146,47.44599],[-113.184832,47.446527],[-113.185648,47.446919],[-113.186839,47.447391],[-113.186839,47.447391],[-113.187171,47.447674],[-113.187274,47.447922],[-113.187274,47.447922],[-113.1873,47.447986],[-113.187354,47.448305],[-113.187343,47.448559],[-113.187257,47.448762],[-113.186646,47.449379],[-113.186935,47.449952],[-113.187171,47.450097],[-113.187675,47.450177],[-113.18819,47.450365],[-113.189489,47.450909],[-113.189896,47.450996],[-113.189896,47.450996],[-113.19098,47.45112],[-113.191527,47.450989],[-113.191892,47.450975],[-113