[{"result":{"data":{"json":{"id":"721","stub":{"id":"721","section":"1 - Graves Run Rd to Prettyboy Reservoir (Gunpowder Road)","altname":"Top Gunpowder","river":"Gunpowder Falls","difficulty":"IIplus","states":["USA-MRY"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"7","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"112292","location":{"latitude":"39.6965","longitude":"-76.8068"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"117574","location":{"latitude":"39.6804","longitude":"-76.7705"},"name":"Take Out","distance":"2.5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"721","permitUrl":null,"permitInfo":null,"description":"Ed Evangelidi testifies:\n\nThis run consists of two gorges. The upper gorge is straightforward Class 1-2 and has a mill race on river right. The lower gorge is through a hemlock forest, has steeper drops and has ruins of the old paper mill at the bottom on river right. Both gorges tend to collect downed trees from time to time. The takeout is on an arm of Prettyboy Reservoir and you shouldn't be here. So be quick to drop cars and load up, be as inconspicuous as possible driving by the area and look like a fisherman rather than a boater. Also consider skipping this lovely piece of whitewater in hunting season.","averageGradient":"31","maxGradient":null,"length":"2.9","correlations":[{"reachID":"721","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"40","beginMediumRunnable":"80","beginHighRunnable":"800","en