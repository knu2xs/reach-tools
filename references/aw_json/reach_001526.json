m/lZH1MAb5CnwvpkS0SBOFW","large":"https://api.americanwhitewater.org/image/images/big/lZH1MAb5CnwvpkS0SBOFW"}},{"id":"EMmQHnuZ75XJtuAZ6HC4q","ext":"jpg","post_id":"1763","description":"Surfing in the Corsica S at Clover.","caption":"Tom at Clover","poi_name":null,"subject":"Thomas O'Keefe","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":"5801","photo_date":"2006-09-30T14:51:06.000Z","updated_at":"2025-04-14T14:51:09.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/EMmQHnuZ75XJtuAZ6HC4q","large":"https://api.americanwhitewater.org/image/images/big/EMmQHnuZ75XJtuAZ6HC4q"}},{"id":"paZaE3Wj3QJFFSWjpPVV5","ext":"jpg","post_id":"jAELkosmwY2JXy8HXjeqE","description":"<p>Leaburg Dam that diverted flow for the Leaburg Hydroelectric Project which has been offline due to damage to the canal.</p>","caption":"Leaburg Dam","poi_name":null,"subject":"","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":"5796","photo_date":"2025-04-13T16:12:10.000Z","updated_at":"2025-04-14T16:12:12.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/paZaE3Wj3QJFFSWjpPVV5","large":"https://api.americanwhitewater.org/image/images/big/paZaE3Wj3QJFFSWjpPVV5"}},{"id":"NqO5Z6GI1i6cvxPjsuauu","ext":"jpg","post_id":"jAELkosmwY2JXy8HXjeqE","description":"Access site at Finn Rock.","caption":"Finn Rock Access","poi_name":null,"subject":"","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":"5794","photo_date":"2025-04-13T16:12:10.000Z","updated_at":"2025-04-14T16:12:12.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/NqO5Z6GI1i6cvxPjsuauu","large":"https://api.americanwhitewater.org/image/images/big/NqO5Z6GI1i6cvxPjsuauu"}},{"id":"2VUAl3ClmONc3LPmUfetf","ext":"jpg","post_id":"jAELkosmwY2JXy8HXjeqE","description":"","caption":"Finn Rock Safety Sign","poi_name":null,"subject":"","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":"5794","photo_date":"2025-04-13T16:12:10.000Z","updated_at":"2025-04-14T16:12:12.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/2VUAl3ClmONc3LPmUfetf","large":"https://api.americanwhitewater.org/image/images/big/2VUAl3ClmONc3LPmUfetf"}},{"id":"3d9RGhogYZ3qxvPzyB5Tz","ext":"jpg","post_id":"jAELkosmwY2JXy8HXjeqE","description":"","caption":"Kiosk at Finn Rock","poi_name":null,"subject":"","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":"5794","photo_date":"2025-04-13T16:12:10.000Z","updated_at":"2025-04-14T16:12:12.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3d9RGhogYZ3qxvPzyB5Tz","large":"https://api.americanwhitewater.org/image/images/big/3d9RGhogYZ3qxvPzyB5Tz"}},{"id":"q0OdEjRGkqatUujLgD7ls","ext":"jpg","post_id":"jAELkosmwY2JXy8HXjeqE","description":"<p>Boat ramp on river left just upstream of the dam that is reached by crossing the dam.</p>","caption":"Leaburg Reservoir Boat Ramp","poi_name":null,"subject":"","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":"5796","photo_date":"2025-04-13T16:12:10.000Z","updated_at":"2025-04-14T16:12:12.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/q0OdEjRGkqatUujLgD7ls","large":"https://api.americanwhitewater.org/image/images/big/q0OdEjRGkqatUujLgD7ls"}},{"id":"tkig7J0e1yZS17p7jLKNP","ext":"jpg","post_id":"jAELkosmwY2JXy8HXjeqE","description":"<p>Informal Access point on river right at Clover Park, owned by Lane County. Using the access requires finding the trail through the blackberries.</p>","caption":"Clover Park Access","poi_name":null,"subject":"","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":null,"photo_date":"2025-04-13T16:12:10.000Z","updated_at":"2025-04-14T16:12:12.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/tkig7J0e1yZS17p7jLKNP","large":"https://api.americanwhitewater.org/image/images/big/tkig7J0e1yZS17p7jLKNP"}},{"id":"evvswbK7ieOAPMSic6HQ7","ext":"jpg","post_id":"jAELkosmwY2JXy8HXjeqE","description":"<p>Good Pasture access is located where the river starts to transition to a reservoir.</p>","caption":"Good Pasture Access","poi_name":null,"subject":"","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":"LjhTlSDXpqlrKUqdV14b5","photo_date":"2025-04-13T16:12:10.000Z","updated_at":"2025-04-14T16:12:12.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/evvswbK7ieOAPMSic6HQ7","large":"https://api.americanwhitewater.org/image/images/big/evvswbK7ieOAPMSic6HQ7"}},{"id":"aqcF0ugmNhUcD2lrePKqV","ext":"jpg","post_id":"jAELkosmwY2JXy8HXjeqE","description":"","caption":"Finn Rock Access","poi_name":null,"subject":"","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":"5794","photo_date":"2025-04-13T16:12:10.000Z","updated_at":"2025-04-14T16:12:12.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/aqcF0ugmNhUcD2lrePKqV","large":"https://api.americanwhitewater.org/image/images/big/aqcF0ugmNhUcD2lrePKqV"}}],"detail":{"id":"1526","permitUrl":"","permitInfo":"","description":"With a long season, convenient access to Eugene, great scenery, and a couple great playspots this is the most popular section of the river. It's a great river to learn on as those new to the sport can follow a guide down more conservative lines while experienced paddlers can enjoy a number of fun playspots.\n\n**Playboat levels:**\n\n2.4-2.9 ft is ideal for Neil's Wave, it can be caught on the fly higher, but tends to wash out, and eddy service gets lost.\n\nThe very top hole in Clover is fun when low, other waves come in below the main river right wave as the level comes up. 3.5+ always has something surfable there.\n\nThe run from Finn Rock down to Prince Helfrich Landing is a great day trip. Several access points provide a diversity of options including park and play at Clover Point. Many kayakers enjoy the Mom's Pies run which starts at the informal access at Mom's Pies just above Clover Point and takes in the best playspots on the run. The most challenging rapid on this section is Marten Rapid which is a solid class III at medium flows and the most challenging drop on the run. You can always take-out above this rapid at Ben and Kay Dorris State Park. Prince Helfrich Landing is located just after this rapid.\n\nAccess: Finn Rock is the main put-in and works well for rafts. To reach this access head to Highway 126 mile 37.9 and turn onto Quartz Creek Road which takes you across the bridge to river left. A good ramp is available on the upstream river left side of the bridge.\n\nThe take-out for the full run just below Marten Rapid is Prince Helfrich Landing. It is reached by driving to Highway 126 mile 38.5 and then turning onto Thomson Ln. which heads down to the river. You can recognize it from the river by the suspension bridge across the river. You can shorten the run by using one of several access points upstream or continue down to Leaburg Dam.","averageGradient":null,"maxGradient":null,"length":"15","correlations":[{"reachID":"1526","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":"GREAT big wave playboat range","aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":"II","highRunnableAdjustedDifficulty":"IItoIII","beginLowRunnable":"600","beginMediumRunnable":"2000","beginHighRunnable":"5000","endHighRunnable":"12000"},"gaugeInfo":{"name":"MCKENZIE RIVER NEAR VIDA, OR","gaugeSource":"USGS","gaugeSourceIdentifier":"14162500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"2650","dateTime":"2026-05-12T03:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.59","dateTime":"2026-05-12T03:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"44.1248487","longitude":"-122.47062"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/14162500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/14162500/#parameterCode=00060&period=P7D","text":"US Geologic