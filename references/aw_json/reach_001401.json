[{"result":{"data":{"json":{"id":"1401","stub":{"id":"1401","section":"2.  Moose Mountain to Route 30","altname":"Griffin Gorge","river":"Sacandaga, E. Branch","difficulty":"IIIplusstandoutV","states":["USA-NYO"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"2.86","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"110771","location":{"latitude":"43.5161","longitude":"-74.1569"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"116040","location":{"latitude":"43.4442","longitude":"-74.2518"},"name":"Take Out","distance":"7","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"13995","ext":"jpeg","post_id":"9250","description":"","caption":"Griffin Gorge Run Out","poi_name":"Gorge below Griffin Falls","subject":"","author":"Dan Davis","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/13995","large":"https://api.americanwhitewater.org/image/images/big/13995"}},{"id":"13994","ext":"jpeg","post_id":"9250","description":"","caption":"Griffin Falls","poi_name":"Griffin Falls","subject":"","author":"Dan Davis","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/13994","large":"https://api.americanwhitewater.org/image/images/big/13994"}},{"id":"13996","ext":"jpeg","post_id":"9250","description":"","caption":"Griffin Gorge First Ledge(small)","poi_name":"First Ledge","subject":"","author":"Dan Davis","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/13996","large":"https://api.americanwhitewater.org/image/images/big/13996"}},{"id":"13997","ext":"jpeg","post_id":"9250","description":"","caption":"Griffin Gorge First Ledge","poi_name":"First Ledge","subject":"","author":"Dan Davis","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/13997","large":"https://api.americanwhitewater.org/image/images/big/13997"}},{"id":"881541","ext":"jpeg","post_id":"884114","description":"Photo credit: Harry Berking and Rob Griffiths","caption":"Griffin Falls","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/881541","large":"https://api.americanwhitewater.org/image/images/big/881541"}},{"id":"881540","ext":"jpeg","post_id":"884113","description":"Photo credit: Harry Berking and Rob Grifiths","caption":"Upper Griffen Gorge Ledges","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/881540","large":"https://api.americanwhitewater.org/image/images/big/881540"}}],"detail":{"id":"1401","permitUrl":"","permitInfo":"","description":"Route 8 parallels this section, so there are numerous putin/takeout options at the various pull-outs.\n\nAbove Griffin Gorge the run is fairly mellow with a few short class-III sections. Griffin Gorge is located about 3 miles upstream of the East Branch/Middle Branch confluence. Route 8 veers away from the river and a small dirt road travels a short distance down to a bridge across the river. Upstream of the bridge is a small ledge which is easiest on the far right, with harder (class IV) lines on the left. After the bridge, look for two eddies on the right above the main drop of Griffin Gorge. These are easy to make at low water, but were definately interesting to catch around 14000 cfs. The main drop features a huge hole which may be boofable/punchable at lower flows, but take a look for yourself. Below the main drop, the runout to the gorge is fun at low flows, but features some huge holes at high water. After the gorge, there's a short reprieve before the last rapid on the run.\n\nThe last 3 miles fall around 100 fpm and are continuous bouldery class-III at low water or a huge class-IV freight train at high water (At 14000 cfs it took us 10 minutes to run the final 3 miles).  This is a classic Adirondack run and can easily be lapped multiple times.\n\n**South-Eastern Adirondack Area Reaches**\n\n[Batten Kill](https://www.americanwhitewater.org/content/River/detail/id/1245/) [Beecher Creek](https://www.americanwhitewater.org/content/River/detail/id/366/) [County Line Brook](https://www.americanwhitewater.org/content/River/detail/id/354/)\n\n[Dunning Creek](https://www.americanwhitewater.org/content/River/detail/id/3630/) [East Stony Creek](https://www.americanwhitewater.org/content/River/detail/id/1297/)[Elbow Creek](https://www.americanwhitewater.org/content/River/detail/id/3995/)\n\n[Georgia Brook](https://www.americanwhitewater.org/content/River/detail/id/4069/) [Glen Creek](https://www.americanwhitewater.org/content/River/detail/id/1309/)[Holmes Lake Outlet](https://www.americanwhitewater.org/content/River/detail/id/4103/)\n\n[Hudson (3. Riparius to the Glen)](https://www.americanwhitewater.org/content/River/detail/id/1323/) [Hudson (4.)](https://www.americanwhitewater.org/content/River/detail/id/4019/) [Hudson (5.)](https://www.americanwhitewater.org/content/River/detail/id/4020/)\n\n[Hudson (6.)](https://www.americanwhitewater.org/content/River/detail/id/4021/) [Jimmy Creek](https://www.americanwhitewater.org/content/River/detail/id/4174/) [Mill Creek (Hudson trib.)](https://www.americanwhitewater.org/content/River/detail/id/1346/)\n\n[North Creek](https://www.americanwhitewater.org/content/River/detail/id/4303/) [Pike Brook](https://www.americanwhitewater.org/content/River/detail/id/10886/) [Piseco Outlet](https://www.americanwhitewater.org/content/River/detail/id/1376/)\n\n[Roaring Branch](https://www.americanwhitewater.org/content/River/detail/id/1389/) [Sacandaga (1.)](https://www.americanwhitewater.org/content/River/detail/id/1399/) [Sacandaga (2.)](https://www.americanwhitewater.org/content/River/detail/id/1400/)\n\n[Sacandaga, E. Branch (1.)](https://www.americanwhitewater.org/content/River/detail/id/5035/) [Sacandaga, E. Branch (2.)](https://www.americanwhitewater.org/content/River/detail/id/1401/) [Sacandaga, E. Branch (3.)](https://www.americanwhitewater.org/content/River/detail/id/10873/)\n\n[Sacandaga, Middle Branch](https://www.americanwhitewater.org/content/River/detail/id/1398/) [Sacandaga, W. Branch (Upper)](https://www.americanwhitewater.org/content/River/detail/id/540/) [Sacandaga, W. Branch (Lower)](https://www.americanwhitewater.org/content/River/detail/id/1402/)\n\n[Sand Creek](https://www.americanwhitewater.org/content/River/detail/id/3871/) [Schroon (Starbuckville to Riverbank)](https://www.americanwhitewater.org/content/River/detail/id/1423/) [Schroon (Warrensburg to Thurman Station)](https://www.americanwhitewater.org/content/River/detail/id/1421/)\n\n[Stony Creek (1.)](https://www.americanwhitewater.org/content/River/detail/id/1436/) [Stony Creek (2.)](https://www.americanwhitewater.org/content/River/detail/id/10875/)[Tenant Creek](https://www.americanwhitewater.org/content/River/detail/id/4209/)\n\n[Wolf Creek](https://www.americanwhitewater.org/content/River/detail/id/4315/)\n\n**[Google Map of New York Whitewater](https://www.google.com/maps/d/edit?mid=zjdnDE8H0TLg.kJnMWGapL4xk)**\n\n**[New York Whitewater Paddlers Facebook Group](https://www.facebook.com/groups/108070075877312/)**","averageGradient":null,"maxGradient":null,"length":"8.2","correlations":[{"reachID":"1401","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty"