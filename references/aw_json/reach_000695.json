[{"result":{"data":{"json":{"id":"695","stub":{"id":"695","section":"2) Lower","altname":"Erving to Millers Falls","river":"Millers","difficulty":"IItoIIIstandoutIV","states":["USA-MSS"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"2.74","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Put on in Riverfront Park in Erving. This access point is cleaner and quieter than the one further down along Route 2 and is good for those taking rafts down","id":"108987","location":{"latitude":"42.598332","longitude":"-72.402649"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"put-in","description":"A pull off along Route 2 where there is a railroad bridge can be used as a put in to cut about a mile from the trip and start right where the visible roadside boogie is.","id":"tCQioDJEmhLc6yhWd4osq","location":{"latitude":"42.607004","longitude":"-72.415306"},"name":"Railroad Bridge Put In","distance":"0.89","photoID":"bi2MAQaSUoEIvamuBNAKL","difficulty":"N/A","approximate":false},{"type":"put-in","description":"You can put in at the Bridge St / Farley Rd bridge over the Millers to put in as close to the rapid as possible. The gauge is also located at this bridge on river right.","id":"RCuIFuJGy3mAfCxUGPWYj","location":{"latitude":"42.597747","longitude":"-72.437994"},"name":"Farley Rd / Bridge St Put In","distance":"2.4","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":"Funnel is the main event of the Lower Millers. The river constricts and picks up some gradient forming a class III rapid. It starts off with rocks forming holes as the gradient leeds to a ledgy part of the constriction which forms some good standing waves and holes. These waves are great for surfing with some decent eddy service. The water here is moving fast and and swim here can take a bit to collect as there isn't a big pool below, so boaters or gear can quiclky end up downstream.","id":"0Dvg8u7kBD24lyhvnPNBc","location":{"latitude":"42.58747","longitude":"-72.448407"},"name":"Funnel","distance":"3.39","difficulty":"III","approximate":false,"photoID":null},{"type":"takeout","description":"One can shorten the run by taking out at a rest area along Route 2. This cuts out some of the mellower water down to Millers Falls","id":"3ohTJYCxEWedMvMF5gKo6","location":{"latitude":"42.577489","longitude":"-72.463374"},"name":"Alternate Take Out","distance":"4.51","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"Shortly after the old paper mill on river right you pass under the bridge that signifies you have made it to Millers Falls. The take out is on river left immediately after the bridge abutment and makes use of the Millers Falls Riverfront Public Access.","id":"114222","location":{"latitude":"42.579397","longitude":"-72.490867"},"name":"Take Out","distance":"6.17","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"101251212","title":null,"post_date":"2014-07-04 04:00:00+00","detail":"There is a large strainer shortly after the entrance to the Funnel on the Lower Millers. It consists of two large trees coming out from river right more than half way across the river. Paddlers who normally begin their route on the right or center will need to portage the first part of the Funnel. Everyone should scout before running this rapid, stopping above the entrance to the Funnel either on the right or left.\n\nThere are other strainers in the river, but these can be easily avoided.","user":{"name":"Robert Jackson"}}],"photos":[{"id":"6986","ext":"jpeg","post_id":"6377","description":"","caption":"The Funnel","poi_name":"The Funnel","subject":"","author":"Kenny Gaines","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6986","large":"https://api.americanwhitewater.org/image/images/big/6986"}},{"id":"bi2MAQaSUoEIvamuBNAKL","ext":"jpg","post_id":"f99ZI5zkJtFXkqXjIkm14","description":"","caption":"","poi_name":null,"subject":"","author":"Bill Durr","poi_id":null,"photo_date":"2025-04-16T15:14:59.000Z","updated_at":"2025-04-16T15:14:59.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/bi2MAQaSUoEIvamuBNAKL","large":"https://api.americanwhitewater.org/image/images/big/bi2MAQaSUoEIvamuBNAKL"}}],"detail":{"id":"695","permitUrl":null,"permitInfo":null,"description":"The Lower Millers is a surprisingly scenic roadside run in Western Massachusetts along Route 2. The river is restored from its former status as a mill river, but you can see plenty of evidence of former dams along the banks as you paddle. It consists of mosly class II/III boogie water and one larger class 3 rapid, Funnel. There is plenty of on the fly surf to catch. A selection of access options gives you the choice of how long or short of a run you want it to be, ranging from 2 to 6 miles.","averageGradient":null,"maxGradient":null,"length":"6.2","correlations":[{"reachID":"695","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"3.4","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"5.44"},"gaugeInfo":{"name":"MILLERS RIVER AT ERVING, MA","gaugeSource":"USGS","gaugeSourceIdentifier":"01166500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"420","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"2.74","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"42.5975862","longitude":"-72.43786449"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/01166500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/01166500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"2.74","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null}}],"pointOfInterestIDs":["108987","tCQioDJEmhLc6yhWd4osq","RCuIFuJGy3mAfCxUGPWYj","0Dvg8u7kBD24lyhvnPNBc","3ohTJYCxEWedMvMF5gKo6","114222"],"geometry":{"type":"LineString","coordinates":[[-72.402649,42.598332],[-72.402942,42.598451],[-72.404211,42.599296],[-72.404799,42.599776],[-72.406254,42.600896],[-72.407059,42.601627],[-72.407306,42.601673],[-72.407306,42.601673],[-72.407368,42.601833],[-72.410154,42.603913],[-72.411671,42.604713],[-72.412816,42.605238],[-72.413993,42.605969],[-72.415262,42.606975],[-72.415913,42.607409],[-72.416872,42.607706],[-72.417584,42.607797],[-72.420338,42.607659],[-72.420338,42.607659],[-72.421917,42.607544],[-72.424269,42.607635],[-72.425785,42.607611],[-72.426899,42.607291],[-72.427951,42.606696],[-72.428199,42.606627],[-72.428724,42.606147],[-72.429281,42.605689],[-72.430703,42.603814],[-72.430888,42.603402],[-72.431599,42.602282],[-72.43197,42.60187],[-72.432063,42.601596],[-72.432063,42.601596],[-72.432124,42.601514],[-72.433636,42.600292],[-72.437478,42.598461],[-72.437478,42.598461],[-72.437516,42.598443],[-72.437661,42.598461],[-72.437661,42.598461],[-72.437816,42.598438],[-72.438001,42.598255],[-72.438001,42.597775],[-72.437908,42.597386],[-72.437784,42.597318],[-72.437597,42.596129],[-72.437565,42.595375],[-72.437472,42.595283],[-72.437503,42.594391],[-72.437564,42.594231],[-72.438678,42.593499],[-72.440193,42.59263],[-72.440842,42.592218],[-72.441306,42.591989],[-72.441677,42.59176],[-72.442326,42.591097],[-72.442357,42.590937],[-72.442357,42.590937],[-72.442512,42.590914],[-72.442975,42.590456],[-72.443532,42.590022],[-72.444398,