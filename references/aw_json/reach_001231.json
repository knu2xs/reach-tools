[{"result":{"data":{"json":{"id":"1231","stub":{"id":"1231","section":"01. Reserve (Lower Plaza) to US 180","altname":"","river":"San Francisco","difficulty":"IIplus","states":["USA-NME"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"17","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"108352","location":{"latitude":"33.716652","longitude":"-108.75722"},"name":"Put-in, below Lower Plaza at FR 32 ford","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"hazard","description":"1-2 standing barbed wire fences, as you approach Kelly Ranch","id":"8D8bVZbxyFZeW0k4rQaBp","location":{"latitude":"33.547738","longitude":"-108.864617"},"name":"Kelly Ranch - barbed wire fence hazard","distance":"8.72","photoID":null,"difficulty":"N/A","approximate":false},{"type":"hazard","description":"1-2 barbed wire fences are usually standing across river, as you approach Kelly Ranch property.","id":"a1BKv8hoyAIYpkeldnU77","location":{"latitude":"33.546024","longitude":"-108.865438"},"name":"Kelly Ranch - barbed wire fence hazard","distance":"8.85","photoID":null,"difficulty":"III+","approximate":false},{"type":"portage","description":"Strainers commonly collect in this area and there is ~ 100 ft. section of the main channel that has live trees growing across = mandatory portage at most flows.","id":"pzuiiZ7yo4CpPgXnlOYwc","location":{"latitude":"33.472455","longitude":"-108.89676"},"name":"Wood hazard - including live standing in-channel trees","distance":"18.46","photoID":null,"difficulty":"IV","approximate":false},{"type":"takeout","description":null,"id":"113588","location":{"latitude":"33.272042","longitude":"-108.87841"},"name":"Take-out - US 180, near old highway bridge","distance":"23","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"101252999","title":null,"post_date":"2017-05-08 04:00:00+00","detail":"We did the upper part of this run (Reserve to Iron Bridge) on two successive days--Feb. 20th & 21st, 2017. We started a few miles below Reserve on Forest Service land at 75 cfs. This flow built up to a good 150 by the time we took out half way down. This is a beautiful, scenic stretch, with few wire fence or wood problems (we did have to portage around a large log). Nice canyon scenery.\n\nThe next day we decided to finish from where we took out the day before, thinking more of the same. This was not to be. We had to dodge and portage numerous wire fences in a stretch of river absolutely ruled by beaver! Wood obstacles abounded in this oft braided channel, the worst being a small logjam I found myself holding on to, until I could crawl sideways to shore. Otherwise, this would be a stretch well worth doing again, particularly for an overnighter. Too bad. I would not recommend this river to canoes, rafts, or even hardshells (you'd have to get out of your boat all the time). If you go, go in an IK at 500 or less, and be ready to eddy out, scout, and portage because of the wood and fences.","user":{"name":"Jon Vick"}}],"photos":[],"detail":{"id":"1231","permitUrl":null,"permitInfo":null,"description":"For information, see New Mexico Whitewater, by NM State Parks & Rivers of SW, by","averageGradient":"25","maxGradient":null,"length":"23","correlations":[{"reachID":"1231","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"500","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"5000"},"gaugeInfo":{"name":"SAN FRANCISCO RIVER NEAR GLENWOOD, NM","gaugeSource":"USGS","gaugeSourceIdentifier":"09444000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"17","dateTime":"2026