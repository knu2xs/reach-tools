ain wave/drop at the end of a shallow shoal section. The main danger here is the shallowness of the entrance to the rapid. Excellent recovery eddy on river left after Radio Tower.\n\nAt flows above about 2700 cfs, a really fun, extremely fast, exploding wave develops just at the takeout at Jackson Love Bridge.","averageGradient":null,"maxGradient":null,"length":"5.4","correlations":[{"reachID":"1767","isPrimary":true,"correlationDetails":null,"migrationErrorExplanation":null,"gaugeInfo":{"name":"NOLICHUCKY RIVER AT EMBREEVILLE, TN","gaugeSource":"USGS","gaugeSourceIdentifier":"03465500","gaugeFetchStatus":"ACTIVE","latestFlowReading":null,"latestStageReading":{"value":"1.25","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"36.17824965","longitude":"-82.4551657"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/03465500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/03465500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"comment":null,"status":{"status":null,"latestReading":{"value":"1.25","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null}}],"pointOfInterestIDs":["jCSbxCkIiBoZk1aO3Df1x","qJP1SBV5fWOyqZIeY2VWc","fZD8b0zkDRmFXwWBWk9oq","z18ZSu8TBuKyxxqVpTT15","JoNsGBhrHklpP5YikOWpX","FdySaSFe0f0ZyxuvU1xWj","ICFIdJ9n0qBlfP1AtzqK5","114487"],"geometry":{"type":"LineString","coordinates":[[-82.43735392,36.09858108],[-82.43756938,36.09864181],[-82.43797492,36.09890481],[-82.43991498,36.09894641],[-82.44191192,36.09917501],[-82.44246992,36.09909448],[-82.44366812,36.09923161],[-82.44440828,36.09957171],[-82.4478972,36.10098947],[-82.4480474,36.10111083],[-82.44842291,36.10150959],[-82.44848728,36.1017003],[-82.44839072,36.10237645],[-82.44825125,36.10322596],[-82.44799376,36.10365938],[-82.44787574,36.10433551],[-82.44771481,36.10445687],[-82.44777918,36.10508098],[-82.44801521,36.10532369],[-82.447929