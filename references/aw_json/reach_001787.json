[{"result":{"data":{"json":{"id":"1787","stub":{"id":"1787","section":"Retro-Hughes Road to Leggett Rd bridge","altname":"","river":"Rock Creek (Sale Crk. trib.)","difficulty":"IIItoIVplus","states":["USA-TNN"]},"primaryGaugeStatus":{"status":"stale","latestReading":{"value":"12.1","dateTime":"2011-10-01T04:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"112788","location":{"latitude":"35.405602","longitude":"-85.232903"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"","id":"118069","location":{"latitude":"35.383196","longitude":"-85.12119"},"name":"Take Out","distance":"11.49","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"6833","ext":"jpeg","post_id":"3776","description":"This is not the best line. Notice the angle of the kayak. I made it through without any rock impacts. Watch out for the eddy at the top. Semi calm pool at the bottom.","caption":"Rock Creek","poi_name":"?","subject":"Kemper Begley","author":"Craig Rollins","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6833","large":"https://api.americanwhitewater.org/image/images/big/6833"}},{"id":"10237","ext":"jpeg","post_id":"1552","description":"A look at the gorge from on high, Towards the end of the run. ","caption":"Rock Creek Gorge","poi_name":"","subject":"Catherine","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10237","large":"https://api.americanwhitewater.org/image/images/big/10237"}},{"id":"6834","ext":"jpeg","post_id":"3776","description":"This rapid looks worse from your kayak than it does from the bank.","caption":"Rock Creek","poi_name":"?","subject":"Craig Rollins","author":"Kemper Begley","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6834","large":"https://api.americanwhitewater.org/image/images/big/6834"}}],"detail":{"id":"1787","permitUrl":null,"permitInfo":null,"description":"With origins in Bledsoe county, Rock Creek eventually finds itself in the town of Sale Creek, TN. The takeout is at the Leggett Rd bridge. A crude spray paint gauge does exist. 2.5 feet is a nice optimum level. One has several choices for a put in on this stream. One, is to actually put in on Rock Creek on Tendon Road. Another is to put in on Hall Creek, a northern tributary, off of Tendon Road as well. As of 1998, an alternative put -in was accessible too. Take the first main left road off of Leggett, some seven miles up the mountain. Follow the road for about a mile until you notice a pine plantation on the right. The trail leads 1/4 of a mile to Hall Creek. A nice man across the street actually lets you park in his yard, but make sure to ask first and be discrete in changing. This put-in cuts the trip down some three miles of basically class II. On the topo zone map, notice Clifton Bend. That's the road to Hall Creek.\n\nAt the confluence of Hall and Rock, there is an excellent playground for nearly 1/2 mile. The creek is wide and the holes (mostly shallow) are friendly making for some great play at nice levels. Several excellent class IV's and IV+'s are too be found later downstream when the creek narrows down a little. None of the rapids are officially named to my knowledge. A few of them with good water inch pretty close to class 5, and with good water this run is a considerable step above similarly rated runs like Piney River, Island Creek, and Piney Creek into Whites Creek. There are several complex boulder gardens with consequences and tricky moves. Most of the rapids you will encounter are class III-III+ though. In 1998 I spotted three bald eagles in the gorge, one mature and two juveniles. Overall this is an enjoyable stream where you can enjoy steep drops at times and good play as well.","averageGradient":"100","maxGradient":"140","length":"11.5","correlations":[{"reachID":"1787","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"800","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"1800"},"gaugeInfo":{"name":"NORTH CHICKAMAUGA CREEK NEAR MONTLAKE, TN","gaugeSource":"USGS","gaugeSourceIdentifier":"03566525","gaugeFetchStatus":"ARCHIVED","latestFlowReading":{"value":"12.1","dateTime":"2011-10-01T04:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"4.11","dateTime":"2011-10-01T04:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"35.23840184","longitude":"-85.23576419"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/03566525","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/03566525/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"stale","latestReading":{"value":"12.1","dateTime":"2011-10-01T04:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["112788","118069"],"geometry":{"type":"LineString","coordinates":[[-85.232973,35.405611],[-85.232911,35.40609],[-85.23265,35.406716],[-85.232623,35.407013],[-85.232872,35.407491],[-85.232926,35.407755],[-85.232852,35.408244],[-85.232893,35.408639],[-85.232846,35.408793],[-85.232484,35.409282],[-85.232074,35.40914],[-85.231927,35.409151],[-85.231732,35.409261],[-85.231094,35.409481],[-85.230873,35.409624],[-85.230524,35.409926],[-85.230303,35.410283],[-85.230249,35.410454],[-85.230209,35.410888],[-85.23027,35.411245],[-85.230592,35.411778],[-85.230827,35.412217