[{"result":{"data":{"json":{"id":"1066","stub":{"id":"1066","section":"B) Twisting Falls Gorge: Big Falls (Route 1306) to bridge above Stone Mtn Church (TN)","altname":"","river":"Elk","difficulty":"IVtoVstandoutVplus","states":["USA-TNN","USA-NCR"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"112537","location":{"latitude":"36.1995582580566","longitude":"-81.9691390991211"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"117824","location":{"latitude":"36.2490692138672","longitude":"-81.977165222168"},"name":"Take Out","distance":"4.8","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"101247634","title":null,"post_date":"2011-02-02 05:00:00+00","detail":"We had some hard times on the lower Elk yesterday. We tried to portage Twisting Falls on the narrow goat trail but didn't realize it was icy until we got up there. We wound up dropping our kayaks into the falls and had to hike out of the gorge. I wanted to post this in case anyone sees our kayaks or gear to let everyone know that we are ok. If you happen to find a couple of wavesport diesel kayaks (blue and citrus) or some paddles, please email me (calebbrauer@yahoo.com)","user":{"name":"Caleb Brauer"}}],"photos":[{"id":"786331","ext":"jpeg","post_id":"786330","description":"1st rapid. Double ledge best heading right, though don't get greedy.","caption":"","poi_name":"Limbo?","subject":"Chris Grindstaff","author":"Edgar Peck","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/786331","large":"https://api.americanwhitewater.org/image/images/big/786331"}},{"id":"786335","ext":"jpeg","post_id":"786330","description":"Big horizon line. Scout on right, drop off into the trough in the runout of the little top hole","caption":"","poi_name":"","subject":"Chris Grindstaff","author":"Trevyn Leighton","poi_id":