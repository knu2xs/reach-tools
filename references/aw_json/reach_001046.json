iption":"","caption":"Put in Wave","poi_name":"Put in Wave","subject":"Dennis Huntley and Andrew Lazenby","author":"Kevin Colburn","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8134","large":"https://api.americanwhitewater.org/image/images/big/8134"}},{"id":"8135","ext":"jpeg","post_id":"3431","description":"","caption":"Put in Wave","poi_name":"Put in Wave","subject":"Dennis Huntley and Andrew Lazenby","author":"Kevin Colburn","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8135","large":"https://api.americanwhitewater.org/image/images/big/8135"}},{"id":"8136","ext":"jpeg","post_id":"3431","description":"","caption":"Put in Wave at 900","poi_name":"Put in Wave","subject":"Dennis Huntley","author":"Kevin Colburn","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8136","large":"https://api.americanwhitewater.org/image/images/big/8136"}},{"id":"8138","ext":"jpeg","post_id":"4704","description":"","caption":"play hole","poi_name":"not named","subject":"Kevin Colburn","author":"Andrew Lazenby","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8138","large":"https://api.americanwhitewater.org/image/images/big/8138"}},{"id":"8139","ext":"jpeg","post_id":"4704","description":"","caption":"play hole","poi_name":"","subject":"Dennis Huntley","author":"Andrew Lazenby","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8139","large":"https://api.americanwhitewater.org/image/images/big/8139"}}],"detail":{"id":"1046","permitUrl":"","permitInfo":"","description":"The Bridgewater section of the Catawba River offers dam release Class II+ whitewater on a set schedule. The water is clear and cold! The first mile or two is similar to the Nantahala, with small waves and holes. After the whitewater section the river spreads out for a lazy float to the takeout.\n\nThe flow regime was negotiated by American Whitewater and Carolina Canoe Club, and other partners. Check out the [3-day flow forecast](http://Duke Energy provides releases on a set schedule as well as many additional days each year.) for the Bridgewater project to see what flows are on the horizon. There is also a link on the upper right of the forecast page to the calendar of scheduled releases.\n\nThis is likely an underutilized recreation opportunity in the summer when flow is scarce. Give it a try!","averageGradient":null,"maxGradient":null,"length":"5.7","correlations":[{"reachID":"1046","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"200","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"10000"},"gaugeInfo":{"name":"CATAWBA R AT SR1223 BL LK JAMES NR BRIDGEWATER, NC","gaugeSource":"USGS","gaugeSourceIdentifier":"02138520","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"91","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.59","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"35.74125","longitude":"-81.8352528"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/02138520","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/02138520/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"91","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDiffi