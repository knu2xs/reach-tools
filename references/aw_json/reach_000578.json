[{"result":{"data":{"json":{"id":"578","stub":{"id":"578","section":"Big Gulch to Robie Creek","altname":"","river":"Mores Creek","difficulty":"IItoIII","states":["USA-IDA"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"404","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Approximate","id":"107810","location":{"latitude":"43.782855","longitude":"-115.89064"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"Approximate","id":"113050","location":{"latitude":"43.629273","longitude":"-115.995632"},"name":"Take Out","distance":"13","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"101252986","title":null,"post_date":"2017-05-04 04:00:00+00","detail":"DANGER: There is a cable hanging across the creek about half way down the run. We went over it at 1200 cfs, any lower would be really sketchy. It can be seen on the shuttle drive behind an old shack marked private property on the left as you go up 21. This run begins at Grimes creek and ends at Robie creek.","user":{"name":"Dylan Lammers"}}],"photos":[],"detail":{"id":"578","permitUrl":null,"permitInfo":null,"description":"The Grimes-to-Robie section of Mores Creek is a pleasant change of pace from everything else immediately surrounding the Treasure Valley. With the put-in being less than an hour from Boise and nearly 100% roadside rapids, it is a great option for those seeking a change of pace during spring runoffs.\n\nThis Spring run features a steep gradient but few significant rapids. You can expect to be moving at a decent clip at most times, but everything is read-and-run with very few must-make moves. This is an excellent section for beginner/intermediate paddlers seeking to improve their river reading skills and to experience more technical paddling without major conseqences. The biggest hazards are man-made: at various levels, you  may have to duck under bridges, cross-river cables, or illegal rope lines at water level.\n\nThere is a wonderful surf wave halfway down the run behind a private home. The owner created a rock dam for a summer soaking pool that creates a clean river-wide green wave.\n\nIf you're looking for a change of pace or waiting for the other Treasure Valley runs to reach a more suitable flow for your skill level, grab your dry gear and enjoy this run before it dries up in April/May\n\nSee _Idaho: the Whitewater State_ by G. Amaral (Watershed Books, 1990).\n\nLat/Longitude data are _very_ approximate.","averageGradient":null,"maxGradient":null,"length":"15.7","correlations":[{"reachID":"578","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"600","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"3000"},"gaugeInfo":{"name":"MORES CREEK AB ROBIE CREEK NR ARROWROCK DAM ID","gaugeSource":"USGS","gaugeSourceIdentifier":"13200000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"404","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.41","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"43.64805556","longitude":"-115.9897222"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/13200000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/13200000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"404","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficu