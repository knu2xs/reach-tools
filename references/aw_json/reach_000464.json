[{"result":{"data":{"json":{"id":"464","stub":{"id":"464","section":"4 - Price Mill Road to Hwy 441","altname":"","river":"Apalachee","difficulty":"ItoII","states":["USA-GEO"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"87","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Put-in at Price Mill Road, just below Price Mill Shoals. There is not an established access trail or parking lot. Best option to date is to park along the road on river left (north east of the bridge). Then find the least steepest way to drag/hike the boats to the river.","id":"107894","location":{"latitude":"33.786157","longitude":"-83.472842"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"access","description":null,"id":"rQ3nXWnPz5CimhpHjwQYD","location":{"latitude":"33.787023","longitude":"-83.471324"},"name":"Parking","distance":"0.08","photoID":null,"difficulty":null,"approximate":false},{"type":"takeout","description":"There is a small parking area on river right, upstream of the bridge.","id":"113136","location":{"latitude":"33.718878","longitude":"-83.434171"},"name":"Take Out","distance":"6","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"891829","ext":"jpg","post_id":"895729","description":null,"caption":" on Apalachee @4 - Price Mill Road to Hwy 441","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891829","large":"https://api.americanwhitewater.org/image/images/big/891829"}},{"id":"32","ext":"jpeg","post_id":"2425","description":"","caption":"High Shoals","poi_name":"","subject":"Jimmy Holcombe running High Shoals","author":"Ken Strickland","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/32","large":"https://api.americanwhitewater.org/image/images/big/32"}}],"detail":{"id":"464","permitUrl":null,"permitInfo":null,"description":"Section 4 of the Apalachee is a scenic float with numerous rock outcroppings and beaches to enjoy.  Rocky shoals and small drops populate the first few miles. For the remaining miles the river flattens out and the current slows, with the occasional shoals. Watch for fallen trees crossing the river. Frequent maneuvering is required for most of the 7 miles so allow for ample time  (4-6 hrs) and resources to complete the run. Gar are frequently seen. They are not dangerous but really impressive to see.\n\nAccess is not easy but is well worth the effort. Put-in at Price Mill Road, just below Price Mill Shoals. There is not an established access trail or parking lot. Best option to date is to park along the road on river left (north east of the bridge). Then find the least steepest way to drag/hike the boats to the river. Hopefully we can establish a trail here some day.\n\nTakeout under the 441 bridge on either river right or left. On river right there is small parking area on the upstream side of the bridge that allows for a relatively short jaunt to the vehicles.\n\nRiver can be floated as low as 90 cfs at the Bostwick gage though this makes for tight lines in many of the rapids.","averageGradient":null,"maxGradient":null,"length":"6.1","correlations":[{"reachID":"464","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"100","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"8000"},"gaugeInfo":{"name":"APALACHEE RIVER NEAR BOSTWICK, GA","gaugeSource":"USGS","gaugeSourceIdentifier":"02219000","gaugeFetchStatus":"ACTIVE","latestFlowReadin