[{"result":{"data":{"json":{"id":"1570","stub":{"id":"1570","section":"Milepost 29 to Jones Creek Forest Camp","altname":"","river":"Wilson, Devil's Lake Fork","difficulty":"IIIplusstandoutIV","states":["USA-ORE"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"250","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"The launch is on creek-left just upstream from a bridge that crosses the river.","id":"111905","location":{"latitude":"45.606499","longitude":"-123.452003"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"An alternate takeout is on river left just after the bridge near Lee's Camp Store.","id":"117178","location":{"latitude":"45.587502","longitude":"-123.555"},"name":"Take Out","distance":"5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"891038","ext":"jpg","post_id":"894949","description":null,"caption":"Rapid Devil's Lake Fork","poi_name":null,"subject":null,"author":"Sam Morrison","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891038","large":"https://api.americanwhitewater.org/image/images/big/891038"}},{"id":"891024","ext":"jpg","post_id":"894941","description":null,"caption":"Wilson, Devil's Lake Fork @Milepost 29 to Jones Creek Forest Camp","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891024","large":"https://api.americanwhitewater.org/image/images/big/891024"}},{"id":"891043","ext":"jpg","post_id":"894953","description":null,"caption":"The Little One Devil's Lake Fork","poi_name":"The Little One","subject":null,"author":"Sam Morrison","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891043","large":"https://api.americanwhitewater.org/image/images/big/891043"}}],"detail":{"id":"1570","permitUrl":"","permitInfo":"","description":"This is a local favorite for up-and-coming creekers because it requires strong boat handling, but has no large drops. The 'DLF' is the Wilson tributary that highway 6 follows down from the pass. A mere quarter mile downstream from the launch the South Fork enters and the Wilson River begins. Highway 6 alongside the run has frequent pullouts and fishing trails allowing river access. Still, the highway rarely intrudes on your consciousness because the river keeps you quite busy.\n\nFrom the launch point the river immediately launches into a long, technical class III section. First time visitors are well advised to scout, especially at lower flows. If you feel good in this section, you are going to enjoy the run. If you don't, you can easily walk back up and get a car to drive to the takeout or on out to the coast for some Tillamook icecream.\n\nThe whitewater remains fast and furious with many small horizon lines, eddy hopping galore and some fun surfing spots. Four rapids of note include Elk Creek Rapid, the Mini-Gorge/Pinch, S-turn Ledge and Golf Course from upstream to downstream.\n\nElk Creek Rapid is 10-15 minutes downstream from the launch and is a swift approach to a small ledge then a swift outflow. The main ledge can be glimpsed on the shuttle, while looking upstream from a bridge. Locals sometimes stop while shuttling to scout, as this drop does catch wood. There are several line options being more conservative toward the cobble bar on river right, and more spicey over the ledge on the left. Soon after this rapid look for one of the better playholes on the run--eddy right.\n\nThe Mini-Gorge aka Pinch is likewise visible from the road, in the distance as you are headed upstream. It doesn't look like much from the highway or from the scout but it has some gradient, and the water squeezes down to a narrow channel with lateral waves and holes above, and boily swirls below.\n\nThe S-turn Ledge occurs downstream from a long class I-II section with the highway closeby on the right. From the road you see it best when you are headed downstream. The water speeds up then bends hard left, then right and drops a ledge. At low water there are eddies but at higher flows the eddies turn to boils. Depending on flows you can run the ledge anywhere but left is usually sneakier and center or right is boofier. At high flows you can cut left early (but not all the way left) to hit a sneak down the center channel above the ledge. The far left channel has been blocked by wood for a decade as of this writing.\n\nAbout 10 minutes downstream from the S-turn is Golf Course, which is a steeper section with quite a few holes, some of which are friendly and others of which you might want to go around. Generally speaking down the middle works, dodging holes as you go. This rapid is not seen from the road.\n\nThere are some great play waves and holes in the last half mile above a possible takeout on river left downstream from bridge after Lee's Camp Store. You can also continue downstream to the Jones Creek Day Use area on the right, which adds some riffles and one more good rapid.\n\nFLOWS: You want recent rains and a flow on the Wilson at Tillamook in the neighborhood of 3,500-4,500cfs. Lower gauge reading is fine if rising, higher reading fine if falling or if you have class IV or better skills.","averageGradient":"75","maxGradient":"0","length":"7.1","correlations":[{"reachID":"1570","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":"Gets terribly bony, better below the South Fork confluence.","lowRunnableRangeComment":"If you launch with it this low you want it rising or at least not falling too steeply.","mediumRunnableRangeComment":null,"highRunnableRangeComment":"Check to see if it is rising or falling because the gauge is 30 miles downstream and if it's rising you could get a big surprise.","aboveRecommendedRangeComment":"River becomes very continuous and boats get lost.  First place they are likely to stop is in the pool downstream from the footbridge access.","lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"2800","beginMediumRunnable":"3500","beginHighRunnable":"4500","endHighRunnable":"6500"},"gaugeInfo":{"name":"WILSON RIVER NEAR TILLAMOOK, OR","gaugeSource":"USGS","gaugeSourceIdentifier":"14301500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"250","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"4.07","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"45.47593996","longitude":"-123.7251209"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/14301500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/14301500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":"Gauge is ~30 miles downstream so note the flow trends (rising or falling).","status":{"status":"below-recommended","latestReading":{"value":"250","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["111905","117178"],"geometry":{"type":"LineString","coordinates":[[-123.45211033,45.60683936],[-123.45226772,45.60679],[-123.45239252,45.606722],[-123.45273652,45.60643713],[-123.45297892,45.60628313],[-123.45317419,45.6062058],[-123.45319792,45.60619673],[-123.45343232,45.60615533],[-123.45376832,45.606217],[-123.45387772,45.6062616],[-123.45436239,45.60638113],[-123.45497219,45.60646873],[-123.45506619,45.6064594],[-123.45520679,45.60649033],[-123.45592612,45.60649193],[-123.45685612,45.60642973],[-123.45730959,45.60644593],[-123.45748179,45.6064542],[-123.45751279,45.6064586],[-123.45857599,45.60661633],[-12