[{"result":{"data":{"json":{"id":"1001","stub":{"id":"1001","section":"Clearwater Crossing Ranger Station to Clark Fork River","altname":"","river":"Fish Creek","difficulty":"ItoIII","states":["USA-MNT"]},"primaryGaugeStatus":{"status":"medium-runnable","latestReading":{"value":"471","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Park and launch in the vicinity of the Ranger Station, or really anywhere along the length of Fish Creek with road access.","id":"111720","location":{"latitude":"46.9066","longitude":"-114.806"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"You can take out by hiking out on the steep trail from the confluence, paddle to one of the Clark Fork access areas, or take out before the bottom gorge at any roadside pull off.","id":"116993","location":{"latitude":"47.00309","longitude":"-114.697215"},"name":"Take Out","distance":"15.96","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"880903","ext":"jpeg","post_id":"882148","description":"","caption":"Fish Creek above Forks","poi_name":null,"subject":"","author":"Kevin Colburn","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880903","large":"https://api.americanwhitewater.org/image/images/big/880903"}},{"id":"885751","ext":"jpeg","post_id":"888542","description":"","caption":"Nathan Johnson on the West Fork of Fish Creek","poi_name":null,"subject":null,"author":"Kevin Colburn","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/885751","large":"https://api.americanwhitewater.org/image/images/big/885751"}}],"detail":{"id":"1001","permitUrl":"","permitInfo":"","description":"Fish Creek offers three whitewater runs of varying difficulty.\n\nFrom Clearwater Junction (confluence of the North and West Forks) to Forks (Confluence with the South Fork) Fish Creek is Class II/III at reasonable flows.  Expect 7 miles of nice scenery in a remote feeling valley with splashy waves and small holes.  Like on all small Montana rivers and streams, navigating this reach requires the proper skills and equipment to avoid strainers.\n\nFrom Forks to the junction of Upper and Lower Fish Creek roads expect an 8 mile Class II+ float at reasonable flows with the high likelihood of the occasional log or log-jam related portage.  This reach is closer to the road than the upstream reach and shorter runs are an option.\n\nFrom the junction of Upper and Lower Fish Creek roads to the Clark Fork, Fish Creek drops into a short whitewater canyon, that reportedly approaches Class IV at certain flows.","averageGradient":null,"maxGradient":null,"length":"16","correlations":[{"reachID":"1001","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"350","beginMediumRunnable":"450","beginHighRunnable":"600","endHighRunnable":"800"},"gaugeInfo":{"name":"Prospect Creek at Thompson Falls MT","gaugeSource":"USGS","gaugeSourceIdentifier":"12390700","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"471","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"2.87","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"47.5860611","longitude":"-115.3551"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/12390700","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/12390700/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null