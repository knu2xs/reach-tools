[{"result":{"data":{"json":{"id":"999","stub":{"id":"999","section":"2) Falls Creek to Hwy 200 Bridge","altname":"","river":"Dearborn","difficulty":"IItoIII","states":["USA-MNT"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"107905","location":{"latitude":"47.2764015197754","longitude":"-112.484001159668"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"113148","location":{"latitude":"47.2192993164062","longitude":"-112.242401123047"},"name":"Take Out","distance":"16","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"41062","ext":"jpeg","post_id":"10003","description":"","caption":"Dearborn River","poi_name":"","subject":"Dearborn Falls","author":"D. Prinzing","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/41062","large":"https://api.americanwhitewater.org/image/images/big/41062"}},{"id":"8694OiDyUBZ6CjgI1YEMi","ext":"jpg","post_id":"698k17zScXYMeo5yqBkwb","description":"","caption":"","poi_name":null,"subject":"","author":"Daniel Armstrong","poi_id":null,"photo_date":"2024-05-31T15:38:39.000Z","updated_at":"2024-06-30T15:38:39.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8694OiDyUBZ6CjgI1YEMi","large":"https://api.americanwhitewater.org/image/images/big/8694OiDyUBZ6CjgI1YEMi"}},{"id":"sQMGgJrfnCYDdAVFqzExO","ext":"jpg","post_id":"698k17zScXYMeo5yqBkwb","description":"","caption":"","poi_name":null,"subject":"","author":"Daniel Armstrong","poi_id":null,"photo_date":"2024-05-31T15:38:39.000Z","updated_at":"2024-06-30T15:38:39.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/sQMGgJrfnCYDdAVFqzExO","large":"https://api.americanwhitewater.org/image/images/big/sQMGgJrfnCYDdAVFqzExO"}}],"detail":{"id":"999","permitUrl":null,"permitInfo":null,"description":"Beautiful section to float as the river comes out of the mountains of the upper Dearborn.  The river has a few class 2-3 sections above the high bridge (Stearns-Augusta road) but is fairly small and flows mostly through cottonwood bottoms with short canyon sections.  There are a few options to put in on this section, the high bridge requires a short (200 yard) walk down to the river and there is limited parking.  The upper option has a little more room and is an easier put in (Dearborn canyon road) for bigger boats.\n\nFrom the high bridge downstream it is class 1-2 and is mostly cottonwood bottoms and somewhat open with a few cool cliff walls.  At approximately 8 miles from the Dearborn Canyon road put in, there is a large bedrock shelf that the river pours over.  It is possible to run in small craft and rafts, but a scout is recommended.  Estimated rating would be a class 3+ depending on water level.  There is a portage for this rapid on river left.\n\nDownstream of the ledge rapid is mostly class 1-2 with some easy class 3 boulder gardens.  River section is fairly open with cottonwood bottoms and foothills.  As of 2024 no barbed wire or fences across the river.","averageGradient":null,"maxGradient":null,"length":"18.8","correlations":[],"pointOfInterestIDs":["107905","113148"],"geometry":{"type":"LineString","coordinates":[[-112.484025,47.276401],[-112.484036,47.276792],[-112.484031,47.277098],[-112.484023,47.277287],[-112.483977,47.277531],[-112.483863,47.277712],[-112.483853,47.27782],[-112.483821,47.278073],[-112.483773,47.278244],[-112.483713,47.278488],[-112.483628,47.27875],[-112.4835,47.278914],[-112.483375,47.279127],[-112.483464,47.279246],[-112.483298,47.279327],[-112.483126,47.279487],[-112.482961,47.279823],[-112.4829,47.279968],[-112.482833,47.280083],[-112.482828,47.280162],[-112.482858,47.280298],[-112.482928,47.280495],[-112.48295,47.280828],[-112.482835,47.281097],[-112.482732,47.281322],[-112.482612,47.281425],[-112.482018,47.281406],[-112.481664,47.28142],[-112.481311,