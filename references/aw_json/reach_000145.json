[{"result":{"data":{"json":{"id":"145","stub":{"id":"145","section":"3. Riverton (Route 50 bridge) to Peavine Ridge Road","altname":"","river":"American, South Fork","difficulty":"IIItoIV","states":["USA-CAL"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"740","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"The standard put-in for this run is the large pullout on the north side of Hwy 50 just before the Ice House Road bridge.","id":"111239","location":{"latitude":"38.770302","longitude":"-120.447197"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"access","description":"This alternate upsteam put-in adds the bottom section of Kyburz, which is mostly Class II-III ledges and slides.","id":"Ibu2LBK5YNRlaMD4OKpTb","location":{"latitude":"38.775328","longitude":"-120.407539"},"name":"Alternate put-in","distance":"0.05","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":"After some brushy rapids and a few easy drops, the river turns left and drops through a narrow series of ledge-holes, ending with a current-splitting rock at the bottom. Scout river left. This rapid may form large hydraulics at high flows.","id":"Ux5NR1WOdGDsX16avSYrW","location":{"latitude":"38.77719","longitude":"-120.463408"},"name":"The Big One","distance":"1.13","difficulty":"IV","approximate":false,"photoID":null},{"type":"rapid","description":"When the river rounds another left bend and the Hwy 50 retaining wall comes into view on river left, you're entering \"The Long One.\" This is a long boulder garden rapid, quite different from the upstream drops. There are many eddies from which to boat scout and a few dead-end channels.","id":"j7gTbUKKUKVnP6qkCUI37","location":{"latitude":"38.769786","longitude":"-120.478112"},"name":"The Long One","distance":"2.25","difficulty":"IV","approximate":false,"photoID":null},{"type":"takeout","description":"If you don't have a 4WD vehicle and don't want to hike your boat up the lower access road, this is a viable take-out spot with nice beaches and picnic tables. However there is a fee to access this area, and it may not be open when the river is running.","id":"mEUsjAO17ocjz1dUFfFo5","location":{"latitude":"38.767605","longitude":"-120.484199"},"name":"Alternate take-out","distance":"2.74","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"The take out for this run is a rough high clearance road, and is also the put in for the downstream Golden Gate section. Needless to say, don't miss the take out. It's worth a scout from the end of the road if it's your first time, as you have to climb about 25 feet up a bank to get to the road.","id":"116509","location":{"latitude":"38.768501","longitude":"-120.497101"},"name":"Take Out","distance":"3.5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"onHsQsByrTBFnI9XdffZv","ext":"jpg","post_id":"x7fFnzwu3MTIvS6aXtixP","description":"The legendary Damon Gold shows us how to surf tiny features in massive boats on lower Kyburz. ","caption":"Surfing above the put-in","poi_name":null,"subject":"Damon Gold","author":"trentpearce","poi_id":null,"photo_date":"2019-07-10T21:57:03.000Z","updated_at":"2021-06-14T21:57:04.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/onHsQsByrTBFnI9XdffZv","large":"https://api.americanwhitewater.org/image/images/big/onHsQsByrTBFnI9XdffZv"}},{"id":"P6nWReLqUqUtNXz1jZDJ7","ext":"jpg","post_id":"Zyc2BAY6nEjr8sX9Edabp","description":"Entering The Big One. ","caption":"Entering The Big One","poi_name":null,"subject":"Shawn and Sophie","author":"trentpearce","poi_id":null,"photo_date":"2019-07-11T22:01:04.000Z","updated_at":"2021-06-14T22:01:04.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/P6nWReLqUqUtNXz1jZDJ7","large":"https://api.americanwhitewater.org/image/images/big/P6nWReLqUqUtNXz1jZDJ7"}},{"id":"2V2KXboIG0GGKcFdOPOFr","ext":"jpg","post_id":"HiwcntbUM8oevCT2iNbgB","description":null,"caption":"American, S. Fork @3. Riverton (Route 50 bridge) to Peavine Ridge Road","poi_name":null,"subject":"Katie Burch","author":"trentpearce","poi_id":null,"photo_date":null,"updated_at":"2021-06-14T21:58:40.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/2V2KXboIG0GGKcFdOPOFr","large":"https://api.americanwhitewater.org/image/images/big/2V2KXboIG0GGKcFdOPOFr"}}],"detail":{"id":"145","permitUrl":null,"permitInfo":null,"description":"This is a great run for aspiring class IV boaters looking for an introduction to the free-flowing sections of the South Fork American but who aren't ready to tackle Kyburz. After the Hwy 50 bridge, the river pulls away from the road and leaves you in a scenic middle-elevation Sierra gorge.\n\nTo make this run a bit longer, you can put-in several miles upstream at the bottom of Whitehall rapid and combine the lower part of Kyburz with this run for a fun class III+/IV- day.\n\nThe standard takeout is a high-clearance 4WD only dirt road, but you can also park at the top of that road and walk the 1/4-1/2mi. Note that the Peavine Ridge Road is on Google Maps on both sides of the river, but the access and much shorter drive is from river left/south side. You can also take out at the USFS Bridal Veil picnic ground for a small fee, although you will miss a very scenic gorge at the end and a couple of class III drops. Do not park your car on the shoulder of Hwy 50 near Bridal Veil - CHP patrols this and tickets.\n\n**Other information sources:**\n\n[CaCreeks.com](http://cacreeks.com/amer-skb.htm)\n\n[AWetState.com](http://awetstate.com/SAmericanRP.html)","averageGradient":"70","maxGradient":null,"length":"3.4","correlations":[{"reachID":"145","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"600","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"4000"},"gaugeInfo":{"name":"So. American Below Kyburz","gaugeSource":"DREAM","gaugeSourceIdentifier":"184","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"740","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.87","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"30","longitude":"30"},"externalSourceLinks":{"sourceLink":{"url":"https://www.dreamflows.com/graphs/day.184.php","text":"Dream Flows"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"migration-runnable","latestReading":{"value":"740","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["111239","Ibu2LBK5YNRlaMD4OKpTb","Ux5NR1WOdGDsX16avSYrW","j7gTbUKKUKVnP6qkCUI37","mEUsjAO17ocjz1dUFfFo5","116509"],"geometry":{"type":"LineString","coordinates":[[-120.44838,38.770342],[-120.448471,38.771006],[-120.448848,38.771441],[-120.449706,38.771766],[-120.450318,38.771874],[-120.450974,38.771953],[-120.451845,38.771934],[-120.452339,38.771879],[-120.454319,38.771787],[-120.455897,38.771736],[-120.456065,38.771784],[-120.456779,38.772033],[-120.457008,38.772118],[-120.457088,38.772159],[-120.457762,38.772508],[-120.458377,38.773064],[-120.458774,38.773466],[-120.459003,38.774002],[-120.459182,38.774115],[-120.459589,38.775315],[-120.459898,38.776796],[-120.4601,38.777128],[-120.460295,38.777451],[-120.460696,38.777584],[-120.461022,38.777587],[-120.46158,38.777592],[-120.462062,38.777466],[-120.463611,38.777125],[-120.464997,38.776804],[-120.466094,38.776522],[-120.466458,38.77645],[-120.467207,38.776172],[-120.469408,38.775453],[-120.470112,38.775214],