[{"result":{"data":{"json":{"id":"488","stub":{"id":"488","section":"Jones Mill/Bethlehem Church to Conasauga Confluence","altname":"Upper Jacks","river":"Jacks River","difficulty":"IItoV","states":["USA-GEO"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"109127","location":{"latitude":"34.9051","longitude":"-84.5219"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"114364","location":{"latitude":"34.99","longitude":"-84.6358"},"name":"Take Out","distance":"17.2","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"100679479","title":null,"post_date":"2009-01-15 05:00:00+00","detail":"Hey Brad-jus needed clarification-so you ran jacks river twice INCLUDING and thats including the falls or was that portaging it? Or has anyone out there run the falls yet or know of anyone who has? Greg Garrard","user":null}],"photos":[{"id":"17830","ext":"jpeg","post_id":"6784","description":"An 80' falls on Jacks River, just downstream from the Beech Bottoms. The river is named after a Cherokee who (farther downstream and above the confluence with the Conasauga River) sometimes carried travelers across the river on his back.","caption":"Jacks River Falls","poi_name":"Jacks River Falls (aka Beech Bottom Falls)","subject":"","author":"Ken Strickland","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17830","large":"https://api.americanwhitewater.org/image/images/big/17830"}},{"id":"1364","ext":"jpeg","post_id":"2430","description":"","caption":"Jack's River Falls","poi_name":"Jack's River Falls","subject":"","author":"Ken Strickland","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1364","large":"https://api.americanwhitewater.org/image/images/big/1364"}}],"detail":{"id":"488","permitUrl":null,"permitInfo":null,"description":"Data from local expert, Ron Stewart, Box 1337, Chatanooga, TN 37401\n\nThis run is noted for having the longest shuttle in the state. 65 miles one way. While you can do the shuttle by driving thru the Cohutta Wilderness, the standard route is to go back to Hwy 411, drive up to and past the Ocoee, back down thru Copper Hill and then come back into the Cohutta Wilderness from the Eastern side. Trust us when we say its quicker to drive the 65 paved miles vs the 30 or so miles of dirt roads in the Cohuttas.\n\nDue to the length of the run, its best to set shuttle the night before. Then do the drive in a pounding thunderstorm up to the put-in and camp there. You're going to want to put-on as the sun comes up.\n\nTo find the put in, take Watson Gap Road to Watson Gap. From there follow Jones Cemetary Road to Jones Mill/Bethlehem Church. At the put-in expect the stream to be about 10 feet wide, with just barely enough water to float a creek boat.\n\nGradient breakdown by mile.\n\n20, 20, 20, 43, 140, 263, 232, 85, 53, 100, 40, 145, 51, 70, 95, 60, 50, 75, then 60 feet in the last quarter mile (presumably skewed by the falls).","averageGradient":"90","maxGradient":"260","length":"18.4","correlations":[],"pointOfInterestIDs":["109127","114364"],"geometry":{"type":"LineString","coordinates":[[-84.521986,34.904937],[-84.522431,34.905171],[-84.522802,34.905428],[-84.523109,34.905823],[-84.523486,34.906451],[-84.523638,34.906573],[-84.525537,34.907514],[-84.526059,34.907824],[-84.526758,34.908253],[-84.52727,34.908604],[-84.527814,34.908983],[-84.527939,34.909142],[-84.528004,34.909313],[-84.527957,34.90942],[-84.527866,34.909552],[-84.527842,34.909624],[-84.528132,34.910141],[-84.528217,34.910214],[-84.528483,34.910399],[-84.528459,34.910488],[-84.528414,34.910541],[-84.52827,34.91061],[-84.528018,34.910677],[-84.527798,34.910753],[-84.52752,34.910945],[-84.527451,34.91106],[-84.527437,34.911167],[-84.527542,34.911295],[-84.527615,34.911404],[-84.527612