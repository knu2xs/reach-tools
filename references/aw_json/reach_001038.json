[{"result":{"data":{"json":{"id":"1038","stub":{"id":"1038","section":"2. NPS Campground to Confluence with Big Pigeon","altname":"Lower Big Creek","river":"Big Creek (Pigeon R. trib.)","difficulty":"IIItoIV","states":["USA-NCR"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"234","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Park at the trailhead / picnic area at the end of the road. Most paddlers put in right by the parking lot, in the vicinity of the footbridge that spans the river.","id":"112535","location":{"latitude":"35.75120864","longitude":"-83.10968321"},"name":"Big Creek Trailhead Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"Most people take out upstream of the Waterville Powerhouse and the final bridge over Big Creek, parking in the pull out by the white building. Note that there is a low head dam at the powerhouse! Its best to take out upstream of the dam.","id":"117821","location":{"latitude":"35.77219267","longitude":"-83.10105666"},"name":"Take Out","distance":"1.74","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"xkIFcrXOkWqyBpxSDLoAj","title":"Take Out Closed - No Dam Portage","post_date":"2025-08-15 14:33:55+00","detail":"Until construction is done, paddlers should not exit Big Creek anywhere in the vicinity of the Walters Hydropower plant, including using the traditional take-out at the white buildings upstream of the plant or portaging the low head dam. This means paddlers should plan to run the low head dam if they choose to run lower big creek, and take out downstream at the temporary pigeon river put in. Police will be patrolling the area to ensure compliance and may issue citations to people that leave the river and access unauthorized areas near the Walters Hydro Plant.","user":{"name":"Kevin Colburn"}}],"photos":[{"id":"5693","ext":"jpeg","post_id":"6397","description":"this is a videocapture of me running river left of second ledge. on far left at this level, the ledge is a little bit underwater.","caption":"Below Second Ledge","poi_name":"Below Second Ledge at NPS picnic area","subject":"Stuart Smith","author":"Mom","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5693","large":"https://api.americanwhitewater.org/image/images/big/5693"}},{"id":"6731","ext":"jpeg","post_id":"6398","description":"videocap of me heading for the second ledge","caption":"double drop above second ledge","poi_name":"above second ledge","subject":"stuart smith","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6731","large":"https://api.americanwhitewater.org/image/images/big/6731"}},{"id":"10344","ext":"jpeg","post_id":"8279","description":"","caption":"(MN) Lower Big Creek, right below put-in","poi_name":"???","subject":"Mike Nail","author":"Ted Cookson","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10344","large":"https://api.americanwhitewater.org/image/images/big/10344"}},{"id":"10345","ext":"jpeg","post_id":"8279","description":"","caption":"(MN) Riding through some rapids at Lower Big Creek","poi_name":"???","subject":"Scott Darby","author":"Ted Cookson","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10345","large":"https://api.americanwhitewater.org/image/images/big/10345"}},{"id":"10346","ext":"jpeg","post_id":"8279","description":"","caption":"(MN) Quality splatting at Lower Big Creek put in","poi_name":"???","subject":"Scott Darby","author":"Ted Cookson","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10346","large":"https://api.americanwhitewater.org/image/images/big/10346"}},{"id":"10347","ext":"jpeg","post_id":"8279","description":"","caption":"(MN) Boof at Lower Big Creek","poi_name":"??","subject":"Mike Nail","author":"Ted Cookson","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10347","large":"https://api.americanwhitewater.org/image/images/big/10347"}},{"id":"886210","ext":"jpeg","post_id":"888970","description":"","caption":"www.photolandmark.com","poi_name":null,"subject":null,"author":"Kyle Koeberlein | Photo Landmark","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/886210","large":"https://api.americanwhitewater.org/image/images/big/886210"}},{"id":"886209","ext":"jpeg","post_id":"888969","description":"","caption":"www.photolandmark.com","poi_name":null,"subject":null,"author":"Kyle Koeberlein | Photo Landmark","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/886209","large":"https://api.americanwhitewater.org/image/images/big/886209"}},{"id":"886211","ext":"jpeg","post_id":"888971","description":"","caption":"www.photolandmark.com","poi_name":null,"subject":null,"author":"Kyle Koeberlein | Photo Landmark","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/886211","large":"https://api.americanwhitewater.org/image/images/big/886211"}},{"id":"886213","ext":"jpeg","post_id":"888973","description":"","caption":"www.photolandmark.com","poi_name":null,"subject":null,"author":"Kyle Koeberlein | Photo Landmark","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/886213","large":"https://api.americanwhitewater.org/image/images/big/886213"}},{"id":"886212","ext":"jpeg","post_id":"888972","description":"","caption":"www.photolandmark.com","poi_name":null,"subject":null,"author":"Kyle Koeberlein | Photo Landmark","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/886212","large":"https://api.americanwhitewater.org/image/images/big/886212"}},{"id":"5690","ext":"jpeg","post_id":"6397","description":"this is the second ledge you come to (right underneath the wooden bridge at the picnic area) after the put-in at the NPS campground. the hole in the center line has potential to be a playspot at this level, with a nice eddy on river right. if you choose to play here, be confident in your roll. there are some bumpy drops just downstream.","caption":"Second Ledge Below Put-in","poi_name":"Second Ledge Below Put-in","subject":"","author":"Stuart Smith","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5690","large":"https://api.americanwhitewater.org/image/images/big/5690"}},{"id":"891241","ext":"jpg","post_id":"895144","description":null,"caption":" on Big Creek @2. NPS Campground to Confluence with Big Pigeon","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891241","large":"https://api.americanwhitewater.org/image/images/big/891241"}},{"id":"5689","ext":"jpeg","post_id":"6399","description":"this is the first ledge you come to after the put-in at the National Park Service campground. at the time this picture was taken, the water level was very low but, at runnable levels, the hole at the bottom of this approximately 3ft drop could possibly get sticky. the slide on river-right is the best line to take if you're not interested in boofing it. the drop on river-left is nearly straight down and there are two large rocks sitting down under the water.","caption":"First Ledge Below Put-In","poi_name":"First Ledge Below Put-in","subject":"","author":"Stuart Smith","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5689","large":"https://api.americanwhitewater.org/image/images/big/5689"}},{"id":"414001","ext":"jpeg","post_id":"414000","description":"","caption":"Lower Big Creek @ 5 ft.","poi_name":"","subject":"","author":"Royce Cowan","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/414001","large":"https://api.americanwhitewater.org/image/images/big/414001"}}],"detail":{"id":"1038","permitUrl":null,"permitInfo":null,"description":"Lower Big Creek is an Asheville and Knoxville area creek'in staple, and for good reason. The run offers consistently steep continuous whitewater that courses between and over time-polished boulders and bedrock ledges. The run starts off and finishes with continuous Class III+/IV- whitewater, and in the middle are a couple choice rapids that are more challenging: one that leads boaters to a mid river boof of a few feet in height, and the other a sinous S-turn rapid with pillows and holes buffetting paddlers from all sides. Swims on the run can be long because it is so continuous, and there is occasional wood in the stream to pay attention to. The lower section of Big Creek offers a great step up in steep creeking for the paddler looking to expand their horizons into more difficult runs, and a joyous place for intermediate-advanced paddlers to fly off boofs, get tossed around by pillows, and take in the beautiful scenery of Great Smoky Mountains National Park.  \n  \nThe run has a wide range of boatable flows depending on your appetites, from technical low water to high water wave trains, but its wide middle range of flows is especially high quality. There is no gauge on Big Creek, so paddlers use the Oconaluftee or Cataloochee creek gauges, and post visuals on facebook. There are a variety of paddler visual staff gauges in the lower more roadside portions of the creek as well. It takes rain, and runs fairly often for fairly short windows.\n\nThis trip can be combined with some of the hike-up water above the campground for the adventurous boater. Be aware, the 1.5 mile section above the campground is much more demanding than the lower section of Big Creek, and above that is a big step up.","averageGradient":"158","maxGradient":"165","length":"1.9","correlations":[{"reachID":"1038","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1200","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"2700"},"gaugeInfo":{"name":"OCONALUFTEE RIVER AT BIRDTOWN, NC","gaugeSource":"USGS","gaugeSourceIdentifier":"03512000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"234","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.37","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"35.46138889","longitude":"-83.3536111"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/03512000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/03512000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"234","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["112535","117821"],"geometry":{"type":"LineString","coordinates":[[-83.10899503,35.75071084],[-83.10893152,35.75077662],[-83.10844224,35.75121501],[-83.10801071,35.75149541],[-83.10754859,35.75172728],[-83.10734741,35.75186554],[-83.10716494,35.75206304],