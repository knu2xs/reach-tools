[{"result":{"data":{"json":{"id":"496","stub":{"id":"496","section":"Hwy 74 to Flint River","altname":"","river":"Potato Creek","difficulty":"IIItoIV","states":["USA-GEO"]},"primaryGaugeStatus":{"status":null,"latestReading":{"value":"0","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"","id":"108026","location":{"latitude":"32.908659","longitude":"-84.357523"},"name":"Hwy 74 Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":"The rapids that begin shortly below Hwy 74 fall 80' over 0.8 miles (100fpm)","id":"UbuoQBPYsCASSGZaAoG9y","location":{"latitude":"32.902514","longitude":"-84.363567"},"name":"Ledges below Hwy 74","distance":"0.61","difficulty":"III","approximate":false,"photoID":null},{"type":"access","description":"Optional Takeout above some slides but all of the rest of the rapids are upstream between the 74 and 36 bridge. The river to the Flint is mostly flat.","id":"1271","location":{"latitude":"0","longitude":"0"},"name":"GA 36","distance":"2.9","photoID":"5827","difficulty":null,"approximate":false},{"type":"takeout","description":"","id":"113269","location":{"latitude":"32.793422","longitude":"-84.359322"},"name":"Pobiddy Road Take Out","distance":"12.24","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"5826","ext":"jpeg","post_id":"5671","description":"Peter Horne and Tad Day chat, cuz now its the only thing to do til the take-out. ","caption":"(RM) Now things get flat","poi_name":"","subject":"Peter Horne and Tad Day","author":"Rob Maxwell","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5826","large":"https://api.americanwhitewater.org/image/images/big/5826"}},{"id":"5817","ext":"jpeg","post_id":"5671","description":"Just downsteam of the Hwy 74 bridge is the first rapid. The more challenging section of the falls can be found on river right. Mark Hicks and Peter Horne take different lines throught the falls. Of course more lines open up with more water.","caption":"(RM) Hwy 74 Put-In Falls","poi_name":"Hwy 74 Put-In Falls","subject":"Mark Hicks and Peter Horne","author":"Rob Maxwell","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5817","large":"https://api.americanwhitewater.org/image/images/big/5817"}},{"id":"5818","ext":"jpeg","post_id":"5671","description":"Just downstream of Hwy 74 on river right is a fun little ledge drop. Its not as challenging as what you'll find on far river right, but its still fun. If you do run the river right falls, paddle back to river left and do the easy hike up to run this drop. Its worth the effort.","caption":"(RM) Hwy 74 Put-In Rapid River Left","poi_name":"Hwy 74 Put-In Rapid River Left","subject":"Mark Hicks","author":"Rob Maxwell","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5818","large":"https://api.americanwhitewater.org/image/images/big/5818"}},{"id":"5823","ext":"jpeg","post_id":"5671","description":"Peter Horne side surfing one of the many playspots on Potato Creek. ","caption":"(RM) Peter Horne Side Surfing","poi_name":"","subject":"Peter Horne","author":"Rob Maxwell","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5823","large":"https://api.americanwhitewater.org/image/images/big/5823"}},{"id":"5827","ext":"jpeg","post_id":"5671","description":"Mark Hicks runs the top part of the GA 36 rapid. You can see the GA 36 bridge in the background. If you are taking out at GA 36 hike back to the bridge on river left as close to the river as possible. It is private property and the land owners have been nice so far.","caption":"(RM) GA 36 Rapid Top","poi_name":"GA 36 Rapid","subject":"Mark Hicks","author":"Rob Maxwell","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5827","large":"https://api.americanwhitewater.org/image/images/big/5827"}},{"id":"5828","ext":"jpeg","post_id":"5671","description":"Peter Horne and Mark Hicks run the middle part of the GA 36 rapid. You can see the GA 36 bridge in the background. If you are taking out at GA 36 hike back to the bridge on river left as close to the river as possible. It is private property and the land owners have been nice so far.","caption":"(RM) GA 36 Rapid Middle","poi_name":"GA 36 Rapid","subject":"Mark Hicks and Peter Horne","author":"Rob Maxwell","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5828","large":"https://api.americanwhitewater.org/image/images/big/5828"}},{"id":"5825","ext":"jpeg","post_id":"5671","description":"Peter Horne lines up to run the next rapid after Dudley's Demise. ","caption":"(RM) Rapid after Dudley's Demise","poi_name":"","subject":"Peter Horne","author":"Rob Maxwell","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5825","large":"https://api.americanwhitewater.org/image/images/big/5825"}},{"id":"40","ext":"jpeg","post_id":"1342","description":"","caption":"Potato Creek","poi_name":"","subject":"Dave Tillman","author":"Brad Roberts","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/40","large":"https://api.americanwhitewater.org/image/images/big/40"}},{"id":"5819","ext":"jpeg","post_id":"5671","description":"Peter Horne runs one of the many slides on Potato Creek.","caption":"(RM) Slides below the Hwy 74 Falls","poi_name":"","subject":"Peter Horne","author":"Rob Maxwell","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5819","large":"https://api.americanwhitewater.org/image/images/big/5819"}},{"id":"5820","ext":"jpeg","post_id":"5671","description":"Peter Horne runs one of the many small slides found on this section.","caption":"(RM) More Slides below the Hwy 74 Falls","poi_name":"","subject":"Peter Horne","author":"Rob Maxwell","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5820","large":"https://api.americanwhitewater.org/image/images/big/5820"}},{"id":"5821","ext":"jpeg","post_id":"5671","description":"Peter Horne boofing a small ledge. ","caption":"(RM) Peter Horne Boofing Small Ledge","poi_name":"","subject":"Peter Horne","author":"Rob Maxwell","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5821","large":"https://api.americanwhitewater.org/image/images/big/5821"}},{"id":"5822","ext":"jpeg","post_id":"5671","description":"This is the end of the Slides section of Potato Creek. ","caption":"(RM) End of the Slides Section","poi_name":"","subject":"Mark Hicks and Tad Day","author":"Rob Maxwell","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5822","large":"https://api.americanwhitewater.org/image/images/big/5822"}},{"id":"5824","ext":"jpeg","post_id":"5671","description":"One of the most powerful rapids on Potato Creek is Dudley's Demise. Its also one of the better play holes at lower levels. ","caption":"(RM) Mark Hicks at Dudley's Demise","poi_name":"Dudley's Demise","subject":"Mark Hicks","author":"Rob Maxwell","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5824","large":"https://api.americanwhitewater.org/image/images/big/5824"}},{"id":"5829","ext":"jpeg","post_id":"5671","description":"Tad Day runs the last drop in the GA 36 rapid. You can see the GA 36 bridge in the background. If you are taking out at GA 36 hike back to the bridge on river left as close to the river as possible. It is private property and the land owners have been nice so far.","caption":"(RM) GA 36 Rapid Bottom","poi_name":"GA 36 Rapid","subject":"Tad Day","author":"Rob Maxwell","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5829","large":"https://api.americanwhitewater.org/image/images/big/5829"}},{"id":"407918","ext":"jpeg","post_id":"407919","description":"This is the biggest drop of the river left line @ a little below 0.","caption":"74 rapid river left drop","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/407918","large":"https://api.americanwhitewater.org/image/images/big/407918"}}],"detail":{"id":"496","permitUrl":null,"permitInfo":null,"description":"David Tillman paddling a Gyra-Max on Potato Creek.\n\nPhoto courtesy Will Reeves.\n\nPhoto circa 1992...we think.\n\n_From Mark Hicks, March 2003:_\n\nAs far as Potato Creek, here is part of a recent e-mail I sent on it recently (It is located west of Thomaston, GA): Friday evening the level was an inch and we played and played right up to dark and took off the river in total darkness. You would have had a ball out there as the air and water temperature is warmer being that far south. We ended up not running the four big drops below GA Hwy 36 because all the light we were getting was mostly from star light. I was not disappointed because the slides start getting a little bony at that level and it meant we did not have to climb back up hill to get back to the bridge afterwards. I was surprised there was still good play-spots between the bridges at what I would consider a lower level run. Zero is what I consider the lowest fun level, but you can still get down at -4\" and I have even done a -6\" in my Topolino but I would not recommend it. I consider a high water run to be anything above 1' on the gauge.\n\nThe Potato Creek gauge is a painted on gauge on a center pillar of the GA Hwy 74 bridge. A water level that is even with the pillar's slab platform is considered zero. I have almost always used this bridge as the put-in. I once put on one bridge upstream at really high water/flood stage on Hannahs Mill Rd. for some class II+ fun with big waves to play, but it would be a very rare occasion that anyone would find those conditions, and most of the time it would be just a boring class II that some people could use as a warm up because the first rapid below the GA Hwy 74 bridge depending on water level is class III-IV (V or higher at high because of a keeper on the left of the island and unbelievable conditions on the right of the island). I have put on as high as US 19, but there is nothing but flat water and strainers between US 19 and Hannahs Mill Rd.\n\nThere is about a mile and a half of whitewater below the GA Hwy 74 Bridge with play-spots down to about zero on the gauge, then a mile and a half of flat water with one small rapid that can have a couple play spots in it. There are four slides below GA Hwy 36 that drop a total of about 50' in a little over a 100 yards. The last of the four slides is the blindest and most technical to run and it always has by far the biggest holes. At high water the holes could be terminal. There are some land issues on this section below the GA Hwy 36 Bridge. As a rule, never set foot on river right below the bridge as that is the side I have heard all the issues have come from. The river left side does have homes along it, but they seem to be a little friendlier, especially if you try and stay within the river's high water mark. I try and take as low a profile as I can when walking back up and give everyone a wave of the hand whenever I see someone as I don't want to loose the ability to be able use this option as the next bridge down river is way way downstream and I hear you have to paddle through swampy conditions to get there.\n\nWe normally park vehicles just west of the GA Hwy 74 Bridge right where a dirt road comes in from the north as there are no parking signs by the bridge there. We never park a vehicle on the southwest side of the GA Hwy 36 bridge, and park east of the bridge if we plan to run the slides below GA Hwy 36 and on the northwest side of the bridge if we are not running the slides because the take-out is easier there. Once when I was turning the vehicle around, I had a land/home owner that was located below the southwest side of the bridge ask me to park on the east side of the bridge which I did right away even though I knew I could park on the northwest side. I personally have had no problems at this bridge, I just have heard from a number of others that there has been issues with either a owner or owners on the river right below this bridge that date back as far back as 15-20 years ago.\n\nGlad to help,\n\nMark Hicks","averageGradient":null,"maxGradient":null,"length":"12","correlations":[{"reachID":"496","isPrimary":true,"correlationDetails":null,"migrationErrorExplanation":null,"gaugeInfo":{"name":"POTATO CREEK AT COUNTY LINE RD, NR ORCHARD HILL,GA","gaugeSource":"USGS","gaugeSourceIdentifier":"02346310","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"0","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"6.1","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"33.18741667","longitude":"-84.22663889"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/02346310","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/02346310/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"comment":"Gauge (Drainage = 8.8 sq.mi.) is 35-40 miles upstream of this reach, thus will not reflect actual flow here. Visual inspection of bridge gauge is needed.","status":{"status":null,"latestReading":{"value":"0","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["108026","UbuoQBPYsCASSGZaAoG9y","1271","113269"],"geometry":{"type":"LineString","coordinates":[[-84.357523,32.908659],[-84.357069,32.907795],[-84.358716,32.907068],[-84.359738,32.905685],[-84.363046,32.903563],[-84.364275,32.901089],[-84.36213,32.899549],[-84.362912,32.896862],[-84.367598,32.893717],[-84.366899,32.892244],[-84.368032,32.890917],[-84.368325,32.886715],[-84.37417,32.885695],[-84.377056,32.885096],[-84.378615,32.884169],[-84.380213,32.882292],[-84.37906,32.880566],[-84.375947,32.881474],[-84.373766,32.881862],[-84.373417,32.881204],[-84.375116,32.879826],[-84.375488,32.878251],[-84.37544,32.87803],[-84.375285,32.877311],[-84.374307,32.876448],[-84.373588,32.875824],[-84.373408,32.875729],[-84.373308,32.875697],[-84.373202,32.875698],[-84.373096,32.875707],[-84.372992,32.875687],[-84.372898,32.875645],[-84.372849,32.875566],[-84.372853,32.875477],[-84.372927,32.875414],[-84.373068,32.875371],[-84.373166,32.875336],[-84.373262,32.875296],[-84.373337,32.875233],[-84.373384,32.875152],[-84.373409,32.875065],[-84.37341,32.874975],[-84.373456,32.874894],[-84.373528,32.874827],[-84.37363,32.874693],[-84.373658,32.874607],[-84.373664,32.874517],[-84.373667,32.874519],[-84.373667,32.874427],[-84.37376,32.87429],[-84.373752,32.874282],[-84.373744,32.874237],[-84.373736,32.874193],[-84.373729,32.874148],[-84.373719,32.874087],[-84.373724,32.874042],[-84.37373,32.873997],[-84.373736,32.873952],[-84.373742,32.873907],[-84.373749,32.873863],[-84.373756,32.873818],[-84.373764,32.873773],[-84.373772,32.873729],[-84.37378,32.873684],[-84.373789,32.87364],[-84.373799,32.873596],[-84.373809,32.873551],[-84.373819,32.873507],[-84.37383,32.873463],[-84.373841,32.873419],[-84.373853,32.873375],[-84.373865,32.873331],[-84.373877,32.873287],[-84.373898,32.873219],[-84.373989,32.873066],[-84.3746