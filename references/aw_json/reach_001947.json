[{"result":{"data":{"json":{"id":"1947","stub":{"id":"1947","section":"2. Poor Farm Rd. (Rt. 623) to Hidden Valley","altname":"","river":"Jackson","difficulty":"ItoIIstandoutIII","states":["USA-VRG"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"51","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Put in river right just downstream of the Poor Farm bridge, not far from Rt. 220.","id":"110448","location":{"latitude":"38.168444","longitude":"-79.749257"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":"Horizon line above ledgy class II+ or III- rapid depending on water level.  At low to moderate flows, enter far left and angle back to the right.","id":"um5l0fqgadTPRPA7ihIqV","location":{"latitude":"38.144544","longitude":"-79.766835"},"name":"Class II+ rapid","distance":"2.13","difficulty":"II+","approximate":false,"photoID":"886591"},{"type":"takeout","description":"Take out river left at the Hidden Valley parking area, just upstream of the low water bridge.","id":"115711","location":{"latitude":"38.104606","longitude":"-79.812547"},"name":"Take Out","distance":"7.02","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"886589","ext":"jpeg","post_id":"889318","description":"Hidden Valley section, 350 Bacova","caption":"Jackson River","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/886589","large":"https://api.americanwhitewater.org/image/images/big/886589"}},{"id":"886590","ext":"jpeg","post_id":"889319","description":"Hidden Valley section, 350 Bacova","caption":"Jackson River","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/886590","large":"https://api.americanwhitewater.org/image/images/big/886590"}},{"id":"886591","ext":"jpeg","post_id":"889320","description":"Hidden Valley section, 350 Bacova","caption":"Jackson River","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/886591","large":"https://api.americanwhitewater.org/image/images/big/886591"}}],"detail":{"id":"1947","permitUrl":"","permitInfo":"","description":"This is a great run if you are looking for scenery, solitude, and quiet with minimal whitewater. There's good public access at both ends and wilderness in between (there are some trails along the river however). Great for a tandem canoe trip. A couple of miles from the put-in bridge, there is a class II or low III ledgy rapid identifiable by a horizon line. You can scout/portage on river right. At most flows, enter far river left, with a right angle. However, this rapid is an outlier, and the rest of the trip is fairly mellow. Note that guidebook authors Grove and Gertler have described this section accurately, while Corbett says 'most of the rapids are solid Class 3' which is not accurate. Perhaps he paddled it at very high water or was thinking of Richardson Gorge downstream. In any case, this section is very much worth paddling, just don't expect much whitewater excitement.\n\nSee Also:\n\n*Classic Virginia Rivers,* Ed Grove (1992 ed), p. 218.\n\n*Virginia Whitewater*, Roger Corbett (2000 ed.), p. 268.\n\n*Exploring Virginia's Waterways*, Ed Gertler (2022 ed.), p. 192.","averageGradient":"21","maxGradient":null,"length":"7","correlations":[{"reachID":"1947","isPrimary":false,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDi