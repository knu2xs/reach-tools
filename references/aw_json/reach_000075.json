/image/images/medium/5293","large":"https://api.americanwhitewater.org/image/images/big/5293"}},{"id":"10142","ext":"jpeg","post_id":"7182","description":"Digital still pic from a video.  North Alabama Whitewater Festival, Short Creek Freestyle Competition.  ","caption":"NAWF-Short Creek Comp. 2005","poi_name":"Short Creek Falls","subject":"","author":"Joey","poi_id":"106981","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10142","large":"https://api.americanwhitewater.org/image/images/big/10142"}},{"id":"5294","ext":"jpeg","post_id":"5657","description":"Mike Morrow at Gratto Falls","caption":"(RM) Gratto Falls","poi_name":"Gratto Falls","subject":"Mike Morrow","author":"Rob Maxwell","poi_id":"106981","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5294","large":"https://api.americanwhitewater.org/image/images/big/5294"}},{"id":"5295","ext":"jpeg","post_id":"5657","description":"Marshall Fox runs Gratto Falls.","caption":"(RM) Gratto Falls from below","poi_name":"Gratto Falls","subject":"Marshall Fox","author":"Rob Maxwell","poi_id":"106981","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5295","large":"https://api.americanwhitewater.org/image/images/big/5295"}},{"id":"5292","ext":"jpeg","post_id":"5657","description":"Mike Morrow showing us how its done!","caption":"(RM) Short Creek Falls","poi_name":"Short Creek Falls","subject":"Mike Morrow","author":"Rob Maxwell","poi_id":"106981","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5292","large":"https://api.americanwhitewater.org/image/images/big/5292"}},{"id":"13548","ext":"mov","post_id":"9094","description":"","caption":"Thomas Runnin Short Creek","poi_name":"Short Creek Falls","subject":"Thomas Kreps","author":"Rob Beckman","poi_id":"106987","photo_date":null,"updated_at":nu