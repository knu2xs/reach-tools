[{"result":{"data":{"json":{"id":"1743","stub":{"id":"1743","section":"3. Highway 19E bridge @ Hampton High School to Covered Bridge Park - Elizabethton","altname":"Lower Doe","river":"Doe","difficulty":"IItoIII","states":["USA-TNN"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"112558","location":{"latitude":"36.2756","longitude":"-82.1771"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"playspot","description":"Big surfing wave above 900 cfs","id":"2062","location":{"latitude":"0","longitude":"0"},"name":"Bridge Rapid","distance":"1.5","difficulty":"II+","approximate":false,"photoID":"12209"},{"type":"takeout","description":"This last feature of the run is a 2.5 feet tall spill over concrete dam onto a concrete shelf. If you decide to run the dam, run it on the river left side about 6' off the concrete deck against the bank. DO NOT RUN THE DAM FROM LEFT CENTER OF THE RIVER TOO ANYWHERE OVER TO THE FISH LADDER ON RIVER RIGHT!!! The city had the contractor install a large line of limestone quarry boulders to slow down and break up the flow. Any flow below 2,000 cfs could result in a bad accident with the boulder line below the dam. Make sure you scout this drop to find the exact line on the left before attempting to run the drop. If you elect not to run the dam, you can take out on the river right side at the concrete steps that are constructed down to the river. The steps are located just before you go under the Covered Bridge.","id":"2905","location":{"latitude":"0","longitude":"0"},"name":"Covered Bridge Weir Dam","distance":"7.3","photoID":null,"difficulty":"III","approximate":false}],"alerts":[{"id":"101246410","title":null,"post_date":"2009-12-27 05:00:00+00","detail":"The line by the big bridge pylon on the main rapid is choked up with all kinds of crap, run well right of the rocks.","user":{"name":"Jeffrey A. Woods"}}],"photos":[{"id":"17413","ext":"jpeg","post_id":"8358","description":"Take out for the Lower Doe Run.","caption":"Covered Bridge Park","poi_name":"Weir Dam","subject":"Covered Bridge & Weir Dam","author":"Wesley R. Bradley","poi_id":"2062","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17413","large":"https://api.americanwhitewater.org/image/images/big/17413"}},{"id":"12210","ext":"jpeg","post_id":"8359","description":"Big Water!!!","caption":"Big Crashing Wave","poi_name":"Covered Bridge Dam","subject":"Covered Bridge Dam @ flood stage","author":"Wesley R. Bradley","poi_id":"2905","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/12210","large":"https://api.americanwhitewater.org/image/images/big/12210"}},{"id":"12208","ext":"jpeg","post_id":"8359","description":"The dam is gone now, due to this flood!","caption":"11-19-2004 Flood","poi_name":"Covered Bridge Dam","subject":"Covered Bridge Dam rapid @ +5,000 cfs","author":"Wesley R. Bradley","poi_id":"2905","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/12208","large":"https://api.americanwhitewater.org/image/images/big/12208"}},{"id":"12209","ext":"jpeg","post_id":"8359","description":"This is the 1st rapid going into the horseshoe @ flood stage.  At normal running levels there is about a 3' drop into a small hole.","caption":"Bridge Rapid @ flood stage","poi_name":"Bridge Rapid","subject":"Bridge Rapid starting the beggining of the horseshoe","author":"Wesley R. Bradley","poi_id":"2062","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/12209","large":"https://api.americanwhitewater.org/image/images/big/12209"}},{"id":"878185","ext":"jpeg","post_id":"878551","description":"","caption":"Doe River @ 1400 cfs","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.amer