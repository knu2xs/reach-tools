[{"result":{"data":{"json":{"id":"1681","stub":{"id":"1681","section":"SR 3013 to Rt. 239","altname":"","river":"Wapwallopen Creek","difficulty":"ItoIVstandoutVplus","states":["USA-PEN"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"71","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"108954","location":{"latitude":"41.0574989318848","longitude":"-76.0699005126953"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"114188","location":{"latitude":"41.0726013183594","longitude":"-76.1355972290039"},"name":"Take Out","distance":"2.7","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"17304","ext":"tiff","post_id":"9548","description":"","caption":"","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17304","large":"https://api.americanwhitewater.org/image/images/big/17304"}},{"id":"17305","ext":"tiff","post_id":"9548","description":"Impressive!  Props to anyone who runs this one","caption":"Anarchy","poi_name":"Anarchy","subject":"","author":"Art Barket","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17305","large":"https://api.americanwhitewater.org/image/images/big/17305"}},{"id":"882028","ext":"jpeg","post_id":"884672","description":"First D celebration. 215 cfs","caption":"Powder Hole","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/882028","large":"https://api.americanwhitewater.org/image/images/big/882028"}}],"detail":{"id":"1681","permitUrl":null,"permitInfo":null,"description":"This is a very pretty run through mostly placid waters that occassionally shows a flare of temper with some large waterfalls. The rocks are sharp and the drops are spectacular and sketchy. It is possible to run the creek and portage all of the big drops but bring your \"A\" game if you plan on dropping some of the falls.\n\n Starting at the SR 3013 bridge, the creek flows along at a mostly flat pace through some pretty woodlands. About 3/4 of a mile into the run, you will come to the first falls, Theatre. Here, the creek cascades about 30 feet over a series of ledges that land on a slide. Run right and make sure you keep your bow up off the first 8 foot clapper and then launch the 10 footer onto the slide. Some small runout drops carry you a pool at the bottom.\n\n A few small drops bring you to Anarchy, the second major drop. This drop is extremely scary and gets walked more often than it is run. It is a 20+ foot waterfall onto a pillowed boulder that needs to be boofed on the left followed immediately by a 10 foot falls. You need to drive across the falls and launch sideways to the current. Landing flat and sideways is the only possible way to avoid smashing yourself on the boulder at the bottom. Make sure you take a solid boof stroke, floating off this drop willy-nilly would be disastrous! Run the 10 foot falls that follows in the middle.\n\n The next rapid is a neat slide dropping 10-15 feet that should be run down the left. Right after this, the creek splits around a rock island. There is a cool 8 foot boof on the left or an intense drop into a large hole on the right. Both options are quite enjoyable!\n\n For the next mile, the creek goes back to a Class 1 pace with a few downed trees to walk around. Before you know it, you'll see a railroad bridge and a large horizon line. This is Big Daddy Boner, the last major drop on the creek and it is a BIG'UN. The creek falls 45 feet through a narrow notch, smacking all sorts of rock on the way down. For all intents and purposes, this drop is unrunable. Portage on the right. A half mile of Class 1 will carry you to the Rt. 239 bridge.","averageGradient":null,"maxGradient":null,"length":"5.2","correlations":[{"reachID":"1681","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"75","beginMediumRunnable":"100","beginHighRunnable":"200","endHighRunnable":"300"},"gaugeInfo":{"name":"Wapwallopen Creek near Wapwallopen, PA","gaugeSource":"USGS","gaugeSourceIdentifier":"01538000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"71","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.62","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"41.0594483","longitude":"-76.0938016"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/01538000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/01538000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"71","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["108954","114188"],"geometry":{"type":"LineString","coordinates":[[-76.0697123145083,41.05736480937205],[-76.06984772569803,41.057174802937766],[-76.07017759236419,41.056871202938225],[-76.07046512569707,41.056687802938484],[-76.0709577256963,41.05647466960551],[-76.07151092569546,41.05627586960583],[-76.07200459236134,41.056170469606],[-76.0723831256941,41.05618020293929],[-76.07260679236038,41.056236269605904],[-76.07379832569188,41.05665120293855],[-76.07521199235634,41.05704706960461],[-76.07620772568816,41.05708100293788],[