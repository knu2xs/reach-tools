[{"result":{"data":{"json":{"id":"457","stub":{"id":"457","section":"South Dover NY to Gaylordsville CT","altname":"10 Mile","river":"Tenmile","difficulty":"ItoIIstandoutIII","states":["USA-CNN"]},"primaryGaugeStatus":{"status":"low-runnable","latestReading":{"value":"2.1","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"110103","location":{"latitude":"41.6543006896973","longitude":"-73.5441970825195"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"playspot","description":"George's is a popular surf spot for boaters running Bulls Bridge. There's an easy line river right, a bouncy wave train river center, and a grippy hole on river left of the main channel.","id":"104721","location":{"latitude":"41.6609992980957","longitude":"-73.493896484375"},"name":"George's Hole","distance":"3.8","difficulty":"III","approximate":true,"photoID":"0"},{"type":"takeout","description":null,"id":"115360","location":{"latitude":"41.6464004516602","longitude":"-73.4832992553711"},"name":"Take Out","distance":"4.95","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"101253802","title":null,"post_date":"2018-08-29 04:00:00+00","detail":"Brought a friend down at around 1000cfs (fun flow) he flipped at Stateline rapid and must have caught a piece of metal or jagged rock. Pretty good laceration on his shoulder. Havent had a chance to go back and see what he hit but heads up!","user":{"name":"Ryan Coveney"}}],"photos":[{"id":"10888","ext":"jpeg","post_id":"6912","description":"","caption":"State Line 2","poi_name":"State Line","subject":"","author":"Jeff Lipchus","poi_id":"104722","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10888","large":"https://api.americanwhitewater.org/image/images/big/10888"}},{"id":"10887","ext":"jpeg","post_id":"6912","description":"State Line at a lower water level - route was easy and waves were tame, but the picture still doesn't quite do it justice","caption":"State Line Rapid","poi_name":"State Line","subject":"","author":"Jeff Lipchus","poi_id":"104722","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10887","large":"https://api.americanwhitewater.org/image/images/big/10887"}},{"id":"885375","ext":"jpeg","post_id":"888120","description":"","caption":"George's Hole","poi_name":"George's Hole","subject":"","author":"Zach Kane","poi_id":"104721","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/885375","large":"https://api.americanwhitewater.org/image/images/big/885375"}},{"id":"873713","ext":"jpeg","post_id":"873714","description":"Put In at Dogtails Corner right off rt 55. Parking right off road, dirt area enough for a pair of cars or so. There is a nice little path down the the waters edge.","caption":"Put In Dogtails Corner","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/873713","large":"https://api.americanwhitewater.org/image/images/big/873713"}}],"detail":{"id":"457","permitUrl":"","permitInfo":"","description":"The put-in is off Route 55 (Riverview Road) at a spot where there is room for a few cars to pull in and park. The first couple of miles are a mixture of flat water and Class I whitewater, making this a nice introduction for novice boaters. The first rapid of note is **State Line**, at the NY/CT border. This is a nice bouncy Class II drop with a large eddy behind a boulder river left at the bottom. After State Line there's a bit more flat water and a couple of easy Class II- rapids. At the confluence with the **Housatonic River**, you pass under a footbridge that is on the Appalachian Trail. There is a long slope on the broad stretch of the Housy here with scattered boulders, some surf waves and squirt lines on river left, and a more fluid line on river right. After some flat water and another Class II slope there's a pleasant surf wave with a friendly eddy on river right. From here, rounding the corner sharply to the right you come to **George's**, a popular play spot for boaters running Bulls Bridge. For beginner boaters, George's can be run to river right with minimal problems. A bouncier wave train forms the center line. To river left of the main channel a grippy hole forms. George's offers excellent surfing opportunities. A smaller hole is on river left, at the bottom of a minor channel over the drop, but it's quite shallow. After passing the **hydro power plant** on river left (which is the site of the Bulls Bridge takeout) there's a short stretch of flat water before a decent-sized Class II rapid. There are lots of lines here, the easiest of which is river left, eddying out behind the big boulder there. There's a 2ft high ledge river center that can form a hole at certain levels. The final bit of fun on the river is right by the take-out at **Gaylord Bridge**, where Route 7 crosses over the Housy. The easy line here is river right, straight shot to the take-out. The paddle takes two to three hours, depending how much you play along the way.","averageGradient":"0","maxGradient":"0","length":"5","correlations":[{"reachID":"457","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1.9","beginMediumRunnable":"3","beginHighRunnable":"3.8","endHighRunnable":"4"},"gaugeInfo":{"name":"TENMILE RIVER NEAR GAYLORDSVILLE, CT","gaugeSource":"USGS","gaugeSourceIdentifier":"01200000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"valu