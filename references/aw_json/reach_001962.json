[{"result":{"data":{"json":{"id":"1962","stub":{"id":"1962","section":"Riner (Route 8) to Copper Valley (Route 787)","altname":"","river":"Little (New R. trib)","difficulty":"ItoIV","states":["USA-VRG"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"165","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"110494","location":{"latitude":"37.013801574707","longitude":"-80.4268035888672"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"115758","location":{"latitude":"36.9961013793945","longitude":"-80.5212020874023"},"name":"Take Out","distance":"13","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"886632","ext":"jpeg","post_id":"889388","description":"This is a beautiful stretch of whitewater.  My OT Guide 119 was hard to maneuver since it was a 1/3 full of water after the falls!  ","caption":"Bear Falls","poi_name":null,"subject":null,"author":"Jay Ruff","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/886632","large":"https://api.americanwhitewater.org/image/images/big/886632"}},{"id":"31324","ext":"jpeg","post_id":"1046","description":"Looking back up at river left ledges across from Shoulder Snapper.  Didn't realize this was the Snapper until I looked over on the right.  The river gets divided by a large island, and the right side upstream didn't look like we could get through there on this day.","caption":"31324.jpeg","poi_name":"rt side of Shoulder Snapper","subject":"","author":"Kip Conklin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/31324","large":"https://api.americanwhitewater.org/image/images/big/31324"}},{"id":"886631","ext":"jpeg","post_id":"889387","description":"A long rope can help guide your boat around the left side of the falls.  One person in my party had a shorter rope. Their boat anchored at the end of the rope and filled with water. Another person in my party successfully ran the center of the falls in a Dagger Legend 15.  ","caption":"Bear Cub Falls","poi_name":null,"subject":null,"author":"Jay Ruff","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/886631","large":"https://api.americanwhitewater.org/image/images/big/886631"}},{"id":"31326","ext":"jpeg","post_id":"9512","description":"Taken from a scouting rock for this drop.  The double-knuckled pourover rock left of center has a nice 2' foot boof at whatever this level was.","caption":"31326.jpeg","poi_name":"Bear Falls","subject":"Bear Falls","author":"Kip Conklin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/31326","large":"https://api.americanwhitewater.org/image/images/big/31326"}},{"id":"30767","ext":"jpeg","post_id":"1045","description":"Bear Falls @ 700cfs on Graysontown gauge, which is many, many miles downstream.  ","caption":"Bear Falls ","poi_name":"Bear Falls","subject":"Little River","author":"Kip Conklin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/30767","large":"https://api.americanwhitewater.org/image/images/big/30767"}},{"id":"31325","ext":"jpeg","post_id":"9512","description":"Looking upstream at Shoulder Snapper.  ","caption":"31325.jpeg","poi_name":"Bottom of Shoulder Snapper","subject":"","author":"Kip Conklin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/31325","large":"https://api.americanwhitewater.org/image/images/big/31325"}},{"id":"886634","ext":"jpeg","post_id":"889390","description":"","caption":"Bear Falls","poi_name":null,"subject":null,"author":"Jay Ruff","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/886634","large":"https://api.americanwhitewater.org/image/images/big/886634"}}],"detail":{"id":"1962","permitUrl":null,"permitInfo":null,"description":"Eric O'Connell wrote:\n\nA silent jewel. With good water condition, this is a wonderful whitewater trip. There are 3, possibly 4 class IV rapids. The first 5 miles is truly boring, the next 3/4 mile is what you came for, then the last 2 miles suck. If you can make it down from the Rte. 8 bridge with no boat scraping then you are in for a great day, but if the water level is low at the bridge, go elsewhere. This is a fun trip for intermediate to lower advanced paddlers for 3/4 mile and beginers for the rest.\n\nIf you need any scouting info on Shoulder Snapper (IV), Bear Falls (IV+), Bear Cub Falls (IV-), or the one that has no name and is just a frightening IV++ in high water, please e-mail me at [oeric@swva.net](mailto:oeric@swva.net).\n\nSee Also:\n\n_Classic Virginia Rivers,_ Ed Grove (1992 ed), p. 298.\n\n_Virginia Whitewater_, Roger Corbett (2000 ed.), p. 464.\n\n_Exploring Virginia's Waterways_, Ed Gertler (2022 ed.), p. 335.","averageGradient":null,"maxGradient":null,"length":"13.2","correlations":[{"reachID":"1962","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1000","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"10000"},"gaugeInfo":{"name":"LITTLE RIVER AT GRAYSONTOWN, VA","gaugeSource":"USGS","gaugeSourceIdentifier":"03170000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"165","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"latestStageR