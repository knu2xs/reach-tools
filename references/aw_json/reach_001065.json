[{"result":{"data":{"json":{"id":"1065","stub":{"id":"1065","section":"2. Route 2221 to Route 2615 ","altname":"Cedar Falls to Ramseur","river":"Deep","difficulty":"ItoII","states":["USA-NCR"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"76","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Roadside and riverside park.  Good access.","id":"103173","location":{"latitude":"35.74348068237305","longitude":"-79.69764709472656"},"name":"Franklinville Put-in","distance":"0","photoID":"0","difficulty":"N/A","approximate":false},{"type":"hazard","description":"Dangerous breach on river left.  Portage on far river right.","id":"103172","location":{"latitude":"35.73273468017578","longitude":"-79.65676879882812"},"name":"Ramseur Dam","distance":"0","photoID":"0","difficulty":"N/A","approximate":false},{"type":"takeout","description":"Easy take-out.  Access permission unknown.","id":"103174","location":{"latitude":"35.73103713989258","longitude":"-79.65496826171875"},"name":"Alternate Take-out","distance":"0","photoID":"0","difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"1065","permitUrl":"","permitInfo":"","description":"See other segments for sources.\n\n**FRANKLINVILLE TO RAMSEUR:**\n\nIf you want to skip the Franklinville Dam portage, you can simply put-in at the park just north of the Franklinville Fire Dept.  The run begins with a small rapid and boulder garden.  Near the end of the park is the remants of another destroyed dam, but the iron gates to millrace remain.  This would probably created a hellish sieve on river left during high water.\n\nThis section has several small rapids, but there are fairly LONG stretches of flatwater to be crossed between them.\n\nThe dam at Ramseur has a dangerous breach on river left.  There is a 4-6' pourover with rebar protruding from both sides.  No one except for the insane should attempt running this temptress.  The dam can be portaged successfully on either side, but river right provides a fairly easy trail and a pool to pitch your boat into.","averageGradient":null,"maxGradient":null,"length":"5.6","correlations":[{"reachID":"1065","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"110","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"1500"},"gaugeInfo":{"name":"DEEP RIVER AT RAMSEUR, NC","gaugeSource":"USGS","gaugeSourceIdentifier":"02100500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"76","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"0.94","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"35.72638889","longitude":"-79.6555556"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/02100500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/02100500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":"Previous Flowbands: \nLow Runnable (R0-R4): 110 - 160 cfs Adjusted Difficulty: IstandoutII Comment: Scrapey runs can be done below 120 cfs.\nHigh Runnable (R6-R9): 500 - 1500 cfs Adjusted Difficulty: ItoIII Comment: Upper limit for best boatability uncertain. Please help your fellow boaters with a comment or report.\n\nMigration Errors: \nFor two ranges, R0 to R9 is not covered exactly","comment":"Gauge (Drainage = 349 sq.mi.) is just beyond the take-out for this reach, thus should accurately show actual flow in this reach.","status":{"status":"below-recommended","latestReading":{"value":"76","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric