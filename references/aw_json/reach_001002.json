[{"result":{"data":{"json":{"id":"1002","stub":{"id":"1002","section":"Buffalo Rapids: Kerr Dam to County Road Bridge","altname":"","river":"Flathead","difficulty":"IIIplus","states":["USA-MNT"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"29800","dateTime":"2026-05-12T02:50:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"110684","location":{"latitude":"47.6791","longitude":"-114.242996"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"115954","location":{"latitude":"47.65","longitude":"-114.345499"},"name":"Take Out","distance":"6.63","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"889051","ext":"jpeg","post_id":"891701","description":"","caption":"Rafting on Buffalo Rapids! ","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/889051","large":"https://api.americanwhitewater.org/image/images/big/889051"}}],"detail":{"id":"1002","permitUrl":"","permitInfo":"","description":"The Flathead river below Kerr Dam, known as the Lower Flathead or Buffalo Rapids, is a reasonably safe big river with a vastly changing flow throughout the year. The water is aquamarine and clear, and the scenery features some cool pale hoodoos carved into the conglomerate canyon walls. The peak of run off can bring water levels as high as 60,000 CFS and late august flows can dwindle down near 3,500 with average winter flow of 7-12,000 in between. The river is dam controlled and protected so there is never a danger of log jams or debris. Kerr dam is a top spill dam so we get the warmest water off the top for a much warmer river than the rest of western Montana, especially in early fall. Big run-off years with water exceeding 50,000 can be tricky with a few new rapids showing up and the entire river can be pretty squirrely. This is an 8 mile stretch, the first 2 miles are pretty flat followed by 4 miles of rapids(drop pool), and 2 more miles of flat water after.\n\nThe Confederated Salish and Kootenai Tribes put together an excellent [interactive map and educational guide](http://fwrconline.csktnrd.org/Map/Main/) to the river that is highly recommended.\n\nLogistics: Turn off of HWY 93 in Polson onto 1st street east heading south go 5 blocks then turn right onto 7th ave west this road will turn into Kerr dam rd. In 2.8 miles turn right to stay on Kerr dam road and follow the sign for Kerr dam. Do not turn right into the scenic overlook keep driving and you will wind down a hillside road into dam town there will be a pull off to the left with a path to the river this will be put in. Getting to take out go back up the hill and make a right turn onto Kerr dam rd there will be a lot of turns just keep right until you get to Buffalo Bridge rd(dirt rd). Follow this road until you cross Buffalo bridge and there will be a parking lot and boat launch immediately on the right.\n\nCommercial rafting is available through Flathead Raft Company.","averageGradient":null,"maxGradient":null,"length":"6.7","correlations":[{"reachID":"1002","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"2000","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"50000"},"gaugeInfo":{"name":"Flathead River near Polson MT","gaugeSource":"USGS","gaugeSourceIdentifier":"12372000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"29800","dateTime":"2026-05-12T02:50:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"12","dateTime":"2026-05-12T02:50:00.0