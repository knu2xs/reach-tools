[{"result":{"data":{"json":{"id":"452","stub":{"id":"452","section":"Bridge in Cannondale to Long Island Sound","altname":"","river":"Norwalk","difficulty":"IIstandoutIV","states":["USA-CNN"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"24","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"111385","location":{"latitude":"41.216301","longitude":"-73.426102"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":"A series of small class II drops culminating in the most constricted section of the river underneath a large stone foot bridge with a narrow archway, that could be considered class III at higher levels. It is below the bridge connecting route 7 and the route 7 connector. River wide strainers above or at these drops are extremely common so consider scounting what you can on foot first. You can do so by stopping at a shell gas station during shuttle and walking a short path over to the bridge to take a look upstream. At higher water this section becomes continuous and a large hole forms just in front of the stone bridge. At the risk of repeating myself, be on the lookout for wood!","id":"ri8M14MMG0GTJz7P0XFQE","location":{"latitude":"41.155674","longitude":"-73.424413"},"name":"Stone Bridge rapid","distance":"5.56","difficulty":"II+","approximate":false,"photoID":"wxIsldrhRAupf3q0REy4u"},{"type":"rapid","description":"Possibly the steepest single drop on the river since they took out the Flock Dam in 2018, which was just upstream of it. The river winds around a boulder then over a small ledge hole where the dam was, before it splits around a rail bridge tressel. Going right gives you a large eddy to boat scout the drop at lower levels. It is mostly straight forward with some haystacks after, but take caution at low water as there is a knife rock at the bottom of the drop that a curler feeds into. At higher water it becomes a large downstream V with a straight forward line and fairly shallow runout. This is the last drop before the river flows into some ponds along the route 7 connector where the Silvermine river feeds into it.","id":"Of6ruSmau47kOwS7vP5N9","location":{"latitude":"41.139263","longitude":"-73.427033"},"name":"Barbell","distance":"6.76","difficulty":"II","approximate":false,"photoID":null},{"type":"takeout","description":null,"id":"116654","location":{"latitude":"41.11849","longitude":"-73.412947"},"name":"Take Out","distance":"10.7","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"wxIsldrhRAupf3q0REy4u","ext":"jpg","post_id":"Kh9MUmgkolmB73drQ5r3W","description":"Medium/high flow on the last drop of the rapid at Stone Bridge.","caption":"Stone bridge ~600cfs","poi_name":null,"subject":"","author":"Jesse Koproski","poi_id":"ri8M14MMG0GTJz7P0XFQE","photo_date":"2024-04-08T17:18:07.000Z","updated_at":"2024-04-08T17:18:07.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/wxIsldrhRAupf3q0REy4u","large":"https://api.americanwhitewater.org/image/images/big/wxIsldrhRAupf3q0REy4u"}},{"id":"N1UrsNRcNyee7YY9KMRNv","ext":"jpg","post_id":"ZBytXs2dPgMTuWe117TaX","description":"","caption":"The bridge would look nicer without graffiti.","poi_name":null,"subject":"","author":"Anatoliy Marashev","poi_id":null,"photo_date":"2023-10-01T02:40:23.000Z","updated_at":"2024-11-24T02:40:23.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/N1UrsNRcNyee7YY9KMRNv","large":"https://api.americanwhitewater.org/image/images/big/N1UrsNRcNyee7YY9KMRNv"}},{"id":"Zlqm13l04jPFKjzvNzFMV","ext":"jpg","post_id":"ZBytXs2dPgMTuWe117TaX","description":"","caption":"Grist Mill Rd and Main Ave area. The lower section of the river begins from here and consists of class 3 technical Rapids. When the water level is higher than 400 cfs the lower section could become class 4.","poi_name":null,"subject":"","author":"Anatoliy Marashev","poi_id":null,"photo_date":"2023-10-01T02:40:23.000Z","updated_at":"2024-11-24T02:40:23.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/Zlqm13l04jPFKjzvNzFMV","large":"https://api.americanwhitewater.org/image/images/big/Zlqm13l04jPFKjzvNzFMV"}},{"id":"qSpaozd9q2i0UPlCDNjux","ext":"jpg","post_id":"ZBytXs2dPgMTuWe117TaX","description":"","caption":"Watch out for strainers, a lot of them on this run","poi_name":null,"subject":"","author":"Anatoliy Marashev","poi_id":null,"photo_date":"2023-10-01T02:40:23.000Z","updated_at":"2024-11-24T02:40:23.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/qSpaozd9q2i0UPlCDNjux","large":"https://api.americanwhitewater.org/image/images/big/qSpaozd9q2i0UPlCDNjux"}}],"detail":{"id":"452","permitUrl":"","permitInfo":"","description":"Lat/longitude coords are approximate.\n\nRiver levels are usually low and unrunnable, so it takes a good amount of rain to make this a worthwhile paddle.\n\nRecommended minimum flow is 200 cfs which makes class II-III, and will still result in some bottom scraping.\n\nMax recommended flow is somewhere around 600-700 cfs.  Tight and technical in some sections.  Stone bridge can begin to get pretty nasty.","averageGradient":"0","maxGradient":"0","length":"8.9","correlations":[{"reachID":"452","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"200","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"700"},"gaugeInfo":{"name":"NORWALK RIVER AT SOUTH WILTON, CT","gaugeSource":"USGS","gaugeSourceIdentifier":"01209700","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"24","dateTime":"2026-05-12T0