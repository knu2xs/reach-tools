[{"result":{"data":{"json":{"id":"455","stub":{"id":"455","section":"Valley Road (Shepaug Reservoir) to Route 47","altname":"","river":"Shepaug","difficulty":"IItoIII","states":["USA-CNN"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"51","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"111482","location":{"latitude":"41.7190208435059","longitude":"-73.2928848266602"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"116754","location":{"latitude":"41.6567764282227","longitude":"-73.3182373046875"},"name":"Take Out","distance":"6.5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"101248926","title":null,"post_date":"2012-02-06 05:00:00+00","detail":"3)02/07/2012 Word is in that the entire run is passable. I am sure partial river strainers exist. Safety first.\n\n2)Update: It appears that Rumsey to Bee Brook is passable, although many strainers still exist. Lumber has been cut out of the upper section about 2/3's of the way down as of MLK day. Strainers still exist.\n\n1)2011 winter storm Albert has made both the Upper Shepaug and the run from the Rumsey school impassable. There is a large number of full river strainers throughout the run.","user":{"name":"Chris and Suzanne Koerner"}},{"id":"101247946","title":null,"post_date":"2011-04-20 04:00:00+00","detail":"if you put in off valley rd(which is off of 341) watch for tree across river, it is before the 202 bridge","user":null}],"photos":[],"detail":{"id":"455","permitUrl":"","permitInfo":"","description":"Joe Cashman shared:\n\nHi, I am a Shepaug local. It's best above 225cfs or 3.4 ft. I've paddled it up to 1,700 cfs and every level down to 200cfs. Really best between 300 and 400. There are a ton of surf waves below the confluence with the Bantam, most have convenient eddies, some are catch on the fly. The outhouse wave near the picnic area is very reliable and friendly.\n\nNew England Whitewater River Guide, Gabler R.","averageGradient":"40","maxGradient":"50","length":"6.2","correlations":[{"reachID":"455","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"150","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"1700"},"gaugeInfo":{"name":"SHEPAUG RIVER AT PETERS DAM AT WOODVILLE, CT","gaugeSource":"USGS","gaugeSourceIdentifier":"01202501","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"51","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"2.62","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"41.719575","longitude":"-73.29260278"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/01202501","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/01202501/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":"Previous Flowbands: \nRange of Boatable Flows (R0-R9): 225 - 1700 cfs  Comment: \nLow Runnable (R0-R4): 150 - 224 cfs  Comment: \n\nMigration Errors: \nDifferent ranges are defining the same values","comment":null,"status":{"status":"below-recommended","latestReading":{"value":"51","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["111482","116754"],"geometry":{"type":"LineString","coordinates":[[-73.29281409992433,41.719039090453094],[-73.2927479966753,41.71878286857748],[-73.29274059667529,41.71809826857856],[-73.29272619667535,41.71793140191215],[-73.29281453000851,41.71706806858015],[-73