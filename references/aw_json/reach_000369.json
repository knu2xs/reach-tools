mages/big/579"}},{"id":"577","ext":"jpeg","post_id":"2410","description":"","caption":"PT in Spencer Heights","poi_name":"","subject":"Paul Lang","author":"JoAnn Lang (KHCC)","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/577","large":"https://api.americanwhitewater.org/image/images/big/577"}},{"id":"575","ext":"jpeg","post_id":"2410","description":"","caption":"BL in Spencer Heights","poi_name":"","subject":"Brent Laubaugh","author":"JoAnn Lang (KHCC)","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/575","large":"https://api.americanwhitewater.org/image/images/big/575"}},{"id":"574","ext":"jpeg","post_id":"2410","description":"","caption":"DB in Spencer Heights","poi_name":"","subject":"Dave Broer","author":"JoAnn Lang (KHCC)","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/574","large":"https://api.americanwhitewater.org/image/images/big/574"}},{"id":"576","ext":"jpeg","post_id":"2410","description":"","caption":"DD in Spencer Heights","poi_name":"","subject":"David Duke","author":"JoAnn Lang (KHCC)","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/576","large":"https://api.americanwhitewater.org/image/images/big/576"}},{"id":"4567","ext":"jpeg","post_id":"3526","description":"","caption":"Poudre Falls","poi_name":"Poudre Falls","subject":"portage","author":"christruction@yahoo.com","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/4567","large":"https://api.americanwhitewater.org/image/images/big/4567"}},{"id":"4569","ext":"jpeg","post_id":"3526","description":"","caption":"Spencer Heights","poi_name":"Spencer Heights","subject":"","author":"christruction@yahoo.com","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/4569","large":"https://api.americanwhitewater.org/image/images/big/4569"}},{"id":"4568","ext":"jpeg","post_id":"3526","description":"Serious water","caption":"Tuff Stuff","poi_name":"","subject":"below the falls","author":"christruction@yahoo.com","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/4568","large":"https://api.americanwhitewater.org/image/images/big/4568"}},{"id":"4607","ext":"jpeg","post_id":"3526","description":"Whitewater for the soul","caption":"Spencer Heights","poi_name":"","subject":"Wild and Scenic","author":"christruction@yahoo.com","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/4607","large":"https://api.americanwhitewater.org/image/images/big/4607"}},{"id":"18948","ext":"jpeg","post_id":"4974","description":"","caption":"Spencer Heights","poi_name":"","subject":"","author":"Will Reeves","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/18948","large":"https://api.americanwhitewater.org/image/images/big/18948"}},{"id":"18949","ext":"jpeg","post_id":"4974","description":"","caption":"Running Boneyard","poi_name":"","subject":"","author":"Will Reeves","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/18949","large":"https://api.americanwhitewater.org/image/images/big/18949"}},{"id":"18952","ext":"jpeg","post_id":"4974","description":"","caption":"Rocket Launcher","poi_name":"","subject":"","author":"Will Reeves","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/18952","large":"https://api.americanwhitewater.org/image/images/big/18952"}},{"id":"18946","ext":"jpeg","post_id":"4974","description":"","caption":"Backender at Boneyard","poi_name":"","subject":"","author":"Will Reeves","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/18946","large":"https://api.americanwhitewater.org/image/images/big/18946"}},{"id":"18950","ext":"jpeg","post_id":"4974","description":"","caption":"Approch to Rocket Launcher","poi_name":"","subject":"","author":"Will Reeves","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/18950","large":"https://api.americanwhitewater.org/image/images/big/18950"}}],"detail":{"id":"369","permitUrl":"","permitInfo":"","description":"The first mile of this run is typical Colorado whitewater. Bouncy undefined Class IV in a boulder garden riverbed. At Rocket Launcher(V) the character takes a turn as the river cuts into bedrock. Get out to scout when you see a large house-sized rock spliting the current. Most paddlers will run Rocket Launcher until the day they get stuck in the hole at the bottom, from that day on they all walk it... Just downstream is Poudre Falls, have your takeout eddy pre-scouted for this one. This series of 3 waterfalls could be described as the perfect nightmare. If it wasn't for the last fall Poudre Falls would be run all the time. The last waterfall has incredibly lethal consequences, and the odds of being upright and in control by the last fall are slim to none. All but a select few sickos portage without a seconds thought. The gorge just below the falls(V-) is fun and pushy, it looks big but just run it down the middle. There will be one more big rapid(V) before crossing under Highway 14. Directly after the bridge is Boneyard(V), watch out for the undercut on the bottom right (it's paddler magnetic). For the next 1/2 mile you are in a narrow gorge, there are a few Class V drops in here. Watch out for wood, it has a tendancy to wedge between the narrow walls badly. After the gorge you have 2 more good Class V rapids before the takeout. Don't snooze, the river will appear to be mellowing out before these rapids.\n\nThe correlation between the gauge at the canyon mouth and this run isn't very reliable, especially at low flows.  The outflow from the upstream reservoirs can make a big difference,  and the inflow from the Laramie River tunnel (right at the takeout) can inflate the lower readings.  Water levels in this run can rise very quickly from snowmelt on a hot spring day.\n\nAs of 2012, the best gauge is painted on a rock on river right, just downstream from the highway bridge at the top of Boneyard.  2.5 on this gauge is medium; above 3 is probably high (have a good look!).  At high water, a couple very sticky, powerful, and hard-to miss holes form in the gorge below Boneyard.\n\n**To get there:** The put-in is the CO14 bridge at Big South Fork Campground. Tunnel Picnic area, near the cascade from the Laramie River diversion, is the takeout\n\nSee _Colorado Rivers and Creeks II_, by Banks and Eckardt _(The Bible)_, for info on this and most of the other kewl runs of Colorado.  Or the more recent _Whitewater of the Southern Rockies_ by Stafford and McCutchen.\n\nLat/longitude coords are approximate, from TopoZone.\n\nSee also,\n\n[Big South](http://www.americanwhitewater.org/rivers/id/365/) (Class V/VI),\n\n[Joe Wright Creek](http://www.americanwhitewater.org/rivers/id/2859/) (Class V),\n\n[Spencer Heights](http://www.americanwhitewater.org/rivers/id/369/) (Class V/VI),\n\n[South Fork](http://www.americanwhitewater.org/rivers/id/374/) (Class IV/V),\n\n[White Mile Run/Upper Rustic](http://www.americanwhitewater.org/rivers/id/367/) (Class III),\n\n[Grandpa's Gorge/Lower Rustic](http://www.americanwhitewater.org/rivers/id/368/) (Class III/IV),\n\n[The Narrows](http://www.americanwhitewater.org/rivers/id/370/) (Class IV/V/V+),\n\n[Upper Mishawaka](http://www.americanwhitewater.org/rivers/id/371/) (Class III/IV),\n\n[Lower Mishiwaka](http://www.americanwhitewater.org/rivers/id/3368/) (Class III),\n\n[Poudre Park](http://www.americanwhitewater.org/rivers/id/3369/) (Class IV),\n\n[Bridges](http://www.americanwhitewater.org/rivers/id/3370/) (Class III/IV),\n\n[Upper North Fork](http://www.americanwhitewater.org/rivers/id/373/) (Class IV/V),\n\n[Lower North Fork](http://www.americanwhitewater.org/rivers/id/2822/) (Class II/III), and\n\n[Filter Plant](http://www.americanwhitewater.org/rivers/id/372/) (Class III).","averageGradient":"162","maxGradient":"196","length":"2.4","correlations":[{"reachID":"369","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":"Maybe 2 - 2.5 ft at Pineview.","mediumRunnableRangeComment":"Maybe 2.5 to 3 ft at Pineview","highRunnableRangeComment":"Maybe 3 to 3.75 ft at Pineview","aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"300","beginMediumRunnable":"400","beginHighRunnable":"700","endHighRunnable":"900"},"gaugeInfo":{"name":"CACHE LA POUDRE AT CANYON MOUTH NEAR FORT COLLINS","gaugeSource":"COLORADO_DEPARTMENT_OF_WATER_RESOURCES","gaugeSourceIdentifier":"CLAFTCCO","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"373","dateTime":"2026-05-11T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.68","dateTime":"2026-05-11T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"40.66451","longitude":"-105.224188"},"externalSourceLinks":null},"migrationErrorExplanation":null,"comment":null,"status":{"status":"low-runnable","latestReading":{"value":"373","dateTime":"2026-05-11T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["111556","116827"],"geometry":{"type":"LineString","coordinates":[[-105.807333,40.634234],[-105.807288,40.634815],[-105.807148,40.635312],[-105.80658,40.635849],[-105.806354,40.636159],[-105.80644,40.636452],[-105.806601,40.636631],[-105.806901,40.636883