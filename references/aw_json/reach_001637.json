[{"result":{"data":{"json":{"id":"1637","stub":{"id":"1637","section":"PA Route 381 to Youghiogheny River","altname":"","river":"Meadow Run","difficulty":"IVtoVstandoutVplus","states":["USA-PEN"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"4.45","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Put-in - Farmington - Ohiopyle Rd.","id":"110412","location":{"latitude":"39.8172","longitude":"-79.552498"},"name":"Put In - Farmington - Ohiopyle Rd.","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"put-in","description":"Grover Rd. - Potential Short Put-in","id":"xJAjpUtrqXoD4YI7nk2l1","location":{"latitude":"39.835362","longitude":"-79.508094"},"name":"Grover Rd. - Potential Short Put-in","distance":"3.16","photoID":null,"difficulty":"N/A","approximate":false},{"type":"waterfall","description":"The first of the three standout rapids on Meadow Run, the Cascades is a wide double drop.","id":"xNLz4BNlHrDP27cQvIrXD","location":{"latitude":"39.848889","longitude":"-79.490447"},"name":"The Cascades","distance":"5.46","difficulty":"V","approximate":false,"photoID":"411"},{"type":"waterfall","description":"The Natural Waterslide, sometimes just called \"the Slide\" is a long fast slide in which the Creek is often in a narrow and fast groove.","id":"L1YtbfAzKT6aPZGWNd5jN","location":{"latitude":"39.861888","longitude":"-79.494325"},"name":"Natural Waterslide","distance":"6.91","difficulty":"V","approximate":false,"photoID":"94"},{"type":"takeout","description":null,"id":"115674","location":{"latitude":"39.86354","longitude":"-79.49559"},"name":"Take Out","distance":"7.05","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"v8dRVHtAnwzi3ty6SUBn9","ext":"jpg","post_id":"KNkOxQgMeFx3J3HHkT5PU","description":null,"caption":"Meadow Run @PA Route 381 to Youghiogheny River","poi_name":null,"subject":null,"author":"Jeff Macklin","poi_id":null,"photo_date":null,"updated_at":"2021-12-30T05:10:54.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/v8dRVHtAnwzi3ty6SUBn9","large":"https://api.americanwhitewater.org/image/images/big/v8dRVHtAnwzi3ty6SUBn9"}},{"id":"878915","ext":"jpeg","post_id":"879330","description":"This is the last major rapid about 200 yards above the Slides. I call this one Undercut for the large looming undercut rock on river right. It is fairly easy to avoid the rock. Seven Foot Falls is about 100 yards upstream.","caption":"Undercut Rapid","poi_name":"","subject":"unknown","author":"Jeff Macklin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/878915","large":"https://api.americanwhitewater.org/image/images/big/878915"}},{"id":"7440","ext":"jpeg","post_id":"6336","description":"The large flat rock just to Jon's right has a fairly large void under it, with an opening next to the hole. It has been said to me that if a paddler gets stuck in the hole, he/she could get surfed under that rock. I have heard of some pretty good thrashings at this hole, but not a word about anyone actually getting surfed under the rock. Does anyone have an under rock or near under rock experience from Meadow Run's 7 ft falls? If so, what water level?","caption":"7 ft. Falls @ higher water","poi_name":"7 ft. Falls","subject":"Jon Love","author":"Jeff Macklin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/7440","large":"https://api.americanwhitewater.org/image/images/big/7440"}},{"id":"4560","ext":"jpeg","post_id":"5735","description":"Post Piton- you can see how narrow the slide is and how much flow punds down it.   Below this there is one nearly nasty hole followed by a ledge with a hole that is legitimately nasty on the RR","caption":"Ohiopile Slide- the Notch","poi_name":"Ohiopile Slide","subject":"Kevin Williams","author":"Shawn Modar","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/4560","large":"https://api.americanwhitewater.org/image/images/big/4560"}},{"id":"8587","ext":"jpeg","post_id":"6515","description":"In the bottom of the rapid just after 7ft falls is a mean pinning rock, well it's 2 rocks with about a 1ft gap in between them.","caption":"Dry water look at the Pin Rock in the rapid below 7ft","poi_name":"First rapid below 7ft falls","subject":"Dry water look at the Pin Rock in the rapid below 7ft","author":"Sam B.","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8587","large":"https://api.americanwhitewater.org/image/images/big/8587"}},{"id":"4559","ext":"jpeg","post_id":"5735","description":"This ledge on the RL will try and shunt you into a piton on the RR rock wall and it will hurt, and you will most likely run the rest of the drop backwards... not that that happened to him ;)","caption":"Ohiopyle Slide- at the last ledge","poi_name":"Ohiopyle Slide","subject":"Kevin Williams","author":"Shawn Modar","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/4559","large":"https://api.americanwhitewater.org/image/images/big/4559"}},{"id":"8188","ext":"jpeg","post_id":"6337","description":"The Cascade looks intimidating, but is relatively easy,,, and such a fun rapid (as long as you stay upright). It starts out river right-ish with about a 5-foot boof onto sloped, mostly smooth, rock lubricated with a thin layer of water. Once you start, it is hard to find enough water depth to get a paddle stroke in on this long slide. At the end of the slide is another drop of 6 ft or so. \r\nThe top panorama is two images 'stitched' together and really don't do justice to the impressive view when looking back upstream. In the top image Dan (green boat) is on target with the preferred line. The bottom left image Zach was a little right and was able to work back to the desired drop area.\r\n","caption":"Cascades,,, Yipppiiiii","poi_name":"Cascades","subject":"Dan Menoher and Zach Frederick","author":"Jeff Macklin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8188","large":"https://api.americanwhitewater.org/image/images/big/8188"}},{"id":"6119","ext":"jpeg","post_id":"6513","description":"","caption":"Top of Cascades","poi_name":"Cascades","subject":"Jen H.","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6119","large":"https://api.americanwhitewater.org/image/images/big/6119"}},{"id":"411","ext":"jpeg","post_id":"2514","description":"","caption":"The Cascades, Meadow Run","poi_name":"The Cascades","subject":"Craig Wood","author":"Dave Woten","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/411","large":"https://api.americanwhitewater.org/image/images/big/411"}},{"id":"1065","ext":"jpeg","post_id":"2514","description":"","caption":"Cascade!","poi_name":"Cascade","subject":"Chris Himes","author":"Dave Woten","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1065","large":"https://api.americanwhitewater.org/image/images/big/1065"}},{"id":"94","ext":"jpeg","post_id":"2514","description":"","caption":"The Slide, Meadow Run","poi_name":"The Slide","subject":"Andy Maser","author":"Bob Maxie, Monocacy Canoe Club","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/94","large":"https://api.americanwhitewater.org/image/images/big/94"}},{"id":"4557","ext":"jpeg","post_id":"5735","description":"After last narrow bit of the slide you get to play with this hole at higher levels- not a big deal but it could hold you for a few seconds. ","caption":"Bottom of Ohiopyle Slide","poi_name":"Ohiopyle Slide","subject":"Kevin WIlliams","author":"Shawn Modar","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/4557","large":"https://api.americanwhitewater.org/image/images/big/4557"}},{"id":"4558","ext":"jpeg","post_id":"5735","description":"This is at the second bend of the slide; to get here you've already traveled an easy 60m.  The fun kicks up as you play with the twisted holes and ledges.  ","caption":"Middle of Ohiopyle Slide","poi_name":"Ohiopyle Slide","subject":"Kevin Williams","author":"Shawn Modar","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/4558","large":"https://api.americanwhitewater.org/image/images/big/4558"}},{"id":"8768","ext":"jpeg","post_id":"6008","description":"","caption":" WHAT HAPPENED TO MY PADDLE.........? OH, there it is 15 feet behind me.  oops","poi_name":"OHIOPILE SLIDE","subject":"Mitch Greynolds","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8768","large":"https://api.americanwhitewater.org/image/images/big/8768"}},{"id":"17833","ext":"jpeg","post_id":"9547","description":"","caption":"Meadow Run hazard below slide","poi_name":"Slides","subject":"","author":"Art Barket","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17833","large":"https://api.americanwhitewater.org/image/images/big/17833"}},{"id":"17832","ext":"jpeg","post_id":"9547","description":"","caption":"Joe attaining the slide!","poi_name":"Slides","subject":"Joe","author":"Art Barket","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17832","large":"https://api.americanwhitewater.org/image/images/big/17832"}},{"id":"412","ext":"jpeg","post_id":"2514","description":"","caption":"Seven-foot Falls, Meadow Run","poi_name":"Seven-foot Falls","subject":"","author":"Matt Muir (KHCC)","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/412","large":"https://api.americanwhitewater.org/image/images/big/412"}},{"id":"16952","ext":"jpeg","post_id":"6335","description":"This is Sam's 11th run of The Slide on this day. I saw him do # 12. He shuttled back to the put-in for another whole run & probably # 13 on the slide.","caption":"Sam's 11th slide run of the day.","poi_name":"The Slide","subject":"Sam Mershon","author":"Jeff Macklin","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/16952","large":"https://api.americanwhitewater.org/image/images/big/16952"}},{"id":"6120","ext":"jpeg","post_id":"6513","description":"","caption":"Middle of Cascades","poi_name":"Cascades","subject":"E","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6120","large":"https://api.americanwhitewater.org/image/images/big/6120"}},{"id":"6121","ext":"jpeg","post_id":"6513","description":"","caption":"Cascades Last Drop","poi_name":"Cascades","subject":"Rappin Robin","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6121","large":"https://api.americanwhitewater.org/image/images/big/6121"}},{"id":"8590","ext":"jpeg","post_id":"6513","description":"","caption":"Undercut @ 7ft","poi_name":"7ft Falls","subject":"Undercut @ 7ft","author":"Sam B.","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8590","large":"https://api.americanwhitewater.org/image/images/big/8590"}},{"id":"8588","ext":"jpeg","post_id":"6515","description":"","caption":"Another look at the pinning rock below 7ft","poi_name":"Rapid below 7ft","subject":"Another look at the pinning rock below 7ft","author":"Sam B.","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8588","large":"https://api.americanwhitewater.org/image/images/big/8588"}},{"id":"8589","ext":"jpeg","post_id":"6515","description":"","caption":"Dry 7ft Falls","poi_name":"7ft falls","subject":"Dry 7ft Falls","author":"Sam B.","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8589","large":"https://api.americanwhitewater.org/image/images/big/8589"}},{"id":"8591","ext":"jpeg","post_id":"6513","description":"This slot will break ribs, pin boats, or piton you hard.  Advised to stay far left or right ","caption":"Pinning rock/slot in last slide before 7ft falls","poi_name":"Slide before 7ft falls","subject":"Pinning rock/slot in last slide before 7ft falls","author":"Sam B.","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/8591","large":"https://api.americanwhitewater.org/image/images/big/8591"}},{"id":"6044","ext":"jpeg","post_id":"6514","description":"E, about to get all of the BOOF!!","caption":"7 Foot Falls","poi_name":"7 Foot Falls","subject":"E ","author":"Bob B.","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6044","large":"https://api.americanwhitewater.org/image/images/big/6044"}},{"id":"889199","ext":"jpeg","post_id":"891886","description":"Jeff Macklin downstream from 7 Foot Falls","caption":"7 Foot Falls ","poi_name":null,"subject":null,"author":"Michael Maloney","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/889199","large":"https://api.americanwhitewater.org/image/images/big/889199"}},{"id":"3fkInCyMBgvn7Qmue3g4j","ext":"jpg","post_id":"G8E8JONbPzY6m0SM4RQqF","description":null,"caption":"Meadow Run @PA Route 381 to Youghiogheny River","poi_name":null,"subject":null,"author":"Jeff Macklin","poi_id":null,"photo_date":null,"updated_at":"2021-12-30T05:21:47.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3fkInCyMBgvn7Qmue3g4j","large":"https://api.americanwhitewater.org/image/images/big/3fkInCyMBgvn7Qmue3g4j"}}],"detail":{"id":"1637","permitUrl":"","permitInfo":"","description":"This is a narrow, tight stream. There are pinning rocks all over the place. One of the most characteristic rapids is the Cacades, which is a boney slide culminating in a 6-foot ledge. After the Cascades, there's a lot of boulder-bumping. Another good drop is Seven Foot Falls, which requires a committed boof to avoid an undercut wall and hole. The last major rapid is the Slide. This narrow, shallow monster is a portage for many who value their skin and their teeth. _Scout this puppy before running the stream!_ You don't want to miss the last-chance eddy and blunder into it. A small red flag on a river-left tree currently marks the last-chance eddy.\n\n**Putin:** there are putins downstream of Rte. 381, which eliminate some distance of flatwaterish stuff.\n\n**Takeout** is the bridge just above the Lower Yough, at Entrance Rapid. Those who wish, can continue on a high-water run of the Lower Yough and take out at the Loop or Bruner Run.\n\nFor a helmet-cam video of some of the drops including the last slide, go to [http://www.youtube.com/watch?v=OeczvJ6dLSo](http://www.youtube.com/watch?v=OeczvJ6dLSo)\n\n**Other related or nearby streams:**\n\n[Middle Yough](http://www.americanwhitewater.org/content/River/view/river-detail/1686/) (Class II)\n\n[Casselman](http://www.americanwhitewater.org/content/River/view/river-detail/1590/) (Class I-III)\n\n[Lower Yough](http://www.americanwhitewater.org/content/River/view/river-detail/1687/) (Class III)\n\n[Ohiopyle Falls](http://www.americanwhitewater.org/content/River/view/river-detail/3192/) (Class IV, _almost always illegal_)\n\n[Upper Yough](http://www.americanwhitewater.org/content/River/view/river-detail/753/) (Class IV-V)\n\n[Top Yough](http://www.americanwhitewater.org/content/River/view/river-detail/754/) (Class IV-V)\n\nGeorge Mower, CCA Cruiser; Ed Gertler.","averageGradient":"72","maxGradient":"140","length":"7.1","correlations":[{"reachID":"1637","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"6.5","beginMediumRunnable":"7","beginHighRunnable":"8","endHighRunnable":"9"},"gaugeInfo":{"name":"BIG SANDY CREEK AT ROCKVILLE, WV","gaugeSource":"USGS","gaugeSourceIdentifier":"03070500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"121","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"4.45","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"39.62175","longitude":"-79.7045556"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/03070500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/03070500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":"If the Sandy's about 6.5' and rising, this one might be good to go.","status":{"status":"below-recommended","latestReading":{"value":"4.45","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null}}],"pointOfInterestIDs":["110412","xJAjpUtrqXoD4YI7nk2l1","xNLz4BNlHrDP27cQvIrXD","L1YtbfAzKT6aPZGWNd5jN","115674"],"geometry":{"type":"LineString","coordinates":[[-79