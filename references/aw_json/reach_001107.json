[{"result":{"data":{"json":{"id":"1107","stub":{"id":"1107","section":"2. Smokemont Campground to Oconaluftee Visitor's Center","altname":"","river":"Oconaluftee","difficulty":"IItoIII","states":["USA-NCR"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"234","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Putting in here gives you an extra 0.2 miles of river and the rapid before Smokemont Bridge. There is only space to park 1-2 cars here, and unknown if it's acceptable during the summer season. More parking is available at the Smokemont Bridge.","id":"106559","location":{"latitude":"35.55549","longitude":"-83.31158"},"name":"Smokemont Campground","distance":"0","photoID":"FyufpoYlo6PyU3HTiTths","difficulty":"N/A","approximate":false},{"type":"put-in","description":"Alternate put in with more parking than at the campground. Easy access to river.","id":"106560","location":{"latitude":"35.55308","longitude":"-83.30961"},"name":"Smokemont Bridge","distance":"0.2","photoID":"0","difficulty":"N/A","approximate":false},{"type":"access","description":"Tow String Bridge and Rapid. Class II with some play spots and alternate river access with parking.","id":"101902","location":{"latitude":"35.5413","longitude":"-83.29716"},"name":"Tow String Bridge","distance":"1.3","photoID":"0","difficulty":"II","approximate":false},{"type":"access","description":"Class 2 shoals at the bridge.","id":"101905","location":{"latitude":"35.516","longitude":"-83.30634"},"name":"Job Corps Bridge","distance":"3","photoID":"0","difficulty":"II","approximate":false},{"type":"takeout","description":"Take out on the eddies on river right,  just below the visitors center. Follow path up to parking lot. Bathrooms and vending machines are available.","id":"101908","location":{"latitude":"35.51344","longitude":"-83.30617"},"name":"Oconaluftee Visitor's Center","distance":"3.2","photoID":"0","difficulty":"N/A","approximate":false}],"alerts":[{"id":"101102949","title":null,"post_date":"2009-10-05 04:00:00+00","detail":"W. Butler -\nRan the section in the Park on 9/28 around 900 cfs. There is a river ride strainer after the second bridge you pass under (Tow String Rd.) It was easy enough to make it around and under at this level but at higher levels the water would rise above it and create a hazard. You can't see the strainer until you paddle through the second rapid after the bridge. This run is a great alternative/upgrade from the Tuck gorge and has some nice boogie water. Would be better above 1000+ cfs closer to 1200. It would be really bumpy at 800 cfs.","user":null}],"photos":[{"id":"PUN97X2WNf0WnbRpSGBOa","ext":"jpg","post_id":"HL7VaR3seUorDXcqwMCPI","description":null,"caption":"Oconaluftee @2. Smokemont Campground to Oconaluftee Visitor's Center","poi_name":null,"subject":null,"author":"Steven Pack","poi_id":null,"photo_date":null,"updated_at":"2022-03-03T01:11:44.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/PUN97X2WNf0WnbRpSGBOa","large":"https://api.americanwhitewater.org/image/images/big/PUN97X2WNf0WnbRpSGBOa"}},{"id":"YmKFt3tvNrWt3qVMID7s8","ext":"jpg","post_id":"RlJ6OQHdzbFSvsiP4KroL","description":null,"caption":"Oconaluftee @2. Smokemont Campground to Oconaluftee Visitor's Center","poi_name":null,"subject":null,"author":"Steven Pack","poi_id":null,"photo_date":null,"updated_at":"2022-03-03T01:16:55.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/YmKFt3tvNrWt3qVMID7s8","large":"https://api.americanwhitewater.org/image/images/big/YmKFt3tvNrWt3qVMID7s8"}},{"id":"890310","ext":"jpeg","post_id":"892665","description":"Smokemont Campground Put In. ","caption":"Put In","poi_name":null,"subject":null,"author":"Steve Pack","poi_id":"106559","photo_date":null,"updated_at":"2022-03-03T01:06:40.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/890310","large":"https://api.americanwhitewater.org/image/images/big/890310"}},{"id":"880410","ext":"jpeg","post_id":"881529","description":"","caption":"","poi_name":null,"subject":null,"author":"Steve Pack","poi_id":"106561","photo_date":null,"updated_at":"2022-03-11T02:49:16.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880410","large":"https://api.americanwhitewater.org/image/images/big/880410"}},{"id":"880406","ext":"jpeg","post_id":"881525","description":"","caption":"","poi_name":null,"subject":null,"author":"Steve Pack","poi_id":"106558","photo_date":null,"updated_at":"2022-03-11T02:50:08.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880406","large":"https://api.americanwhitewater.org/image/images/big/880406"}},{"id":"FyufpoYlo6PyU3HTiTths","ext":"jpg","post_id":"yjVka4woBJsb2gf1tUyoq","description":null,"caption":"Oconaluftee @2. Smokemont Campground to Oconaluftee Visitor's Center","poi_name":null,"subject":null,"author":"Steven Pack","poi_id":null,"photo_date":null,"updated_at":"2022-03-17T23:51:33.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/FyufpoYlo6PyU3HTiTths","large":"https://api.americanwhitewater.org/image/images/big/FyufpoYlo6PyU3HTiTths"}},{"id":"880405","ext":"jpeg","post_id":"881524","description":"","caption":"","poi_name":null,"subject":null,"author":"Steve Pack","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880405","large":"https://api.americanwhitewater.org/image/images/big/880405"}},{"id":"880408","ext":"jpeg","post_id":"881527","description":"","caption":"","poi_name":null,"subject":null,"author":"Steve Pack","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880408","large":"https://api.americanwhitewater.org/image/images/big/880408"}},{"id":"888964","ext":"jpeg","post_id":"891612","description":"","caption":"Smokemont Rapid","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888964","large":"https://api.americanwhitewater.org/image/images/big/888964"}},{"id":"880404","ext":"jpeg","post_id":"881523","description":"","caption":"","poi_name":null,"subject":null,"author":"Steve Pack","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880404","large":"https://api.americanwhitewater.org/image/images/big/880404"}},{"id":"880402","ext":"jpeg","post_id":"881521","description":"As of 11/13/18, this tree is gone. ","caption":"","poi_name":"","subject":"","author":"Steve Pack","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880402","large":"https://api.americanwhitewater.org/image/images/big/880402"}}],"detail":{"id":"1107","permitUrl":"","permitInfo":"No permit required, National Park Service jurisdiction. Downstream of the visitor center, it becomes Cherokee Indian Reservation land and paddling is not permitted. ","description":"This is an under appreciated and very scenic Class II-III run in Great Smoky Mountains National Park, near Cherokee, NC. The shuttle logistics are easy, as the run is mostly roadside. The takeout offers bathrooms, vending and a very nice NPS Visitor Center with a wealth of local information.\n\nOverall, the difficulty level is close to the Nantahala and more challending than the Tuckaseegee Gorge. It offers a good introduction to Smoky Mountain creeking. That being said, this reach is not paddled often and requires some additional skills. This run is prone to tree strainers and has some blind curves. The leader should be able to boat scout Class III and communicate quickly to the group hazard locations. Adequate group spacing is manadatory. Everyone in the group should be able to quickly eddy out and stop if a strainer hazard is present. It's a fun and scenic run, just be ready for hazards. If you encounter a hazard, please post to this page and/or notify the NPS at the visitor center.\n\nAs of February 2022, this river section has several potentially dangerous strainers. Comprehensive pre-run scouting and safety preparations are recommended. With the abundance of wood, this is not an easy Class II-III run. It requires a high level of situational awareness and the ability to avoid potential hazards. On February 24, 2022, there was a fatality from a strainer upstream of the Smokemont Bridge. An abundance of caution, group skill assessment and risk evaulation is reccomended.","averageGradient":null,"maxGradient":null,"length":"3.7","correlations":[{"reachID":"1107","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"850","beginMediumRunnable":"1100","beginHighRunnable":"1600","endHighRunnable":"2500"},"gaugeInfo":{"name":"OCONALUFTEE RIVER AT BIRDTOWN, NC","gaugeSource":"USGS","gaugeSourceIdentifier":"03512000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"234","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.37","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"35.46138889","longitude":"-83.3536111"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/03512000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/03512000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"234","dateTime":"2026-05-12T03:00:00.000Z","qual