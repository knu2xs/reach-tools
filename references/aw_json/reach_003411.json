[{"result": {"data": {"json": {"id": "3411", "stub": {"id": "3411", "section": "2. Bremer to Ike Kinswa State Park (Lower)", "altname": "", "river": "Tilton", "difficulty": "IIItoIV", "states": ["USA-WSH"]}, "primaryGaugeStatus": {"status": "below-recommended", "latestReading": {"value": "244", "dateTime": "2026-05-12T02:45:00.000Z", "qualifier": "NORMAL"}, "metric": "cfs", "adjustedDifficulty": null}, "pointOfInterests": [{"type": "put-in", "description": "The access is on the upstream river left side of the bridge.", "id": "111554", "location": {"latitude": "46.579889", "longitude": "-122.416711"}, "name": "State Route 508 Bridge Put-In", "distance": "0", "photoID": null, "difficulty": "N/A", "approximate": false}, {"type": "rapid", "description": "The first significant drop on the run where the river funnels down through a bedrock chute. Look out for the hole on river right towards the bottom of the rapid.", "id": "5881", "location": {"latitude": "46.595116", "longitude": "-122.46703"}, "name": "First Drop", "distance": "3.46", "difficulty": "IV", "approximate": false, "photoID": "3218"}, {"type": "playspot", "description": "Lots of fun playspots on a series of waves where the river runs along the high bank on river left and bends around to the left.", "id": "5882", "location": {"latitude": "46.597626", "longitude": "-122.479084"}, "name": "Arcade", "distance": "4.17", "difficulty": "III", "approximate": false, "photoID": "0"}, {"type": "rapid", "description": "After you're done playing the Arcade a fun section begins with a distinct horizon line.", "id": "5883", "location": {"latitude": "46.594364", "longitude": "-122.47872"}, "name": "Second Drop", "distance": "4.42", "difficulty": "III+", "approximate": false, "photoID": "40427"}, {"type": "rapid", "description": "Leap of Faith has changed a bit over the years. The leap of faith you had to take is now largely visible from a scout on river left. Head either left or right of the two boulders near the top and then avoid the boulders on river left at the bottom. Wood has been an issue in this rapid in recent years and it's always good to get a recent report. There is a good recovery section where the river enters a beautiful gorge at the end of the rapid.", "id": "5884", "location": {"latitude": "46.593513", "longitude": "-122.490982"}, "name": "Leap of Faith", "distance": "5.25", "difficulty": "IV+", "approximate": false, "photoID": "3219"}, {"type": "rapid", "description": "The final ledge drop has a couple options. You can run the right line but don't go too far right at higher water as the wall on river right is undercut. You can also run a line on river left that involves an S turn move.", "id": "5885", "location": {"latitude": "46.584919", "longitude": "-122.507204"}, "name": "Final Ledge", "distance": "6.52", "difficulty": "IV", "approximate": false, "photoID": "40433"}, {"type": "rapid", "description": "Weave your way through the boulder field and then thread the holes at the bottom. This last major rapid is the longest drop on the run.", "id": "5886", "location": {"latitude": "46.585398", "longitude": "-122.509676"}, "name": "Boulder Garden", "distance": "6.66", "difficulty": "IV+", "approximate": false, "photoID": "3217"}, {"type": "takeout", "description": "A short paddle out on the reservoir takes you to an access on river left in Ike Kinswa State park just upstream of the Highway 122 Bridge.", "id": "116825", "location": {"latitude": "46.562313", "longitude": "-122.536586"}, "name": "Ike Kinswa State Park Take-Out", "distance": "8.85", "photoID": null, "difficulty": "N/A", "approximate": false}], "alerts": [{"id": "QZo0Yzffmf8YyYY5Zp59O", "title": "Shuttle Option provided by Cowlitz Kayak", "post_date": "2023-01-03 16:52:45+00", "detail": "Call ahead and avoid the 45 minute each way drive to the putin. Mike with Cowlitz Kayak is offering his large van up. Not sure the minimum for him to drive up but give him a call to check in at http://CowlitzKayak.com .", "use