[{"result":{"data":{"json":{"id":"327","stub":{"id":"327","section":"Highway 120 Bridge to Rainbow Pool Picnic Area","altname":"","river":"Tuolumne, S. Fork","difficulty":"IVtoV","states":["USA-CAL"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"120","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"112883","location":{"latitude":"37.8209","longitude":"-119.917999"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"118162","location":{"latitude":"37.823502","longitude":"-120.013"},"name":"Take Out","distance":"7","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"892175","ext":"jpg","post_id":"896073","description":null,"caption":" on Tuolumne, S. Fork @Highway 120 Bridge to Rainbow Pool Picnic Area","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/892175","large":"https://api.americanwhitewater.org/image/images/big/892175"}},{"id":"892176","ext":"jpg","post_id":"896074","description":null,"caption":" on Tuolumne, S. Fork @Highway 120 Bridge to Rainbow Pool Picnic Area","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/892176","large":"https://api.americanwhitewater.org/image/images/big/892176"}},{"id":"892177","ext":"jpg","post_id":"896075","description":null,"caption":" on Tuolumne, S. Fork @Highway 120 Bridge to Rainbow Pool Picnic Area","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/892177","large":"https://api.americanwhitewater.org/image/images/big/892177"}}],"detail":{"id":"327","permitUrl":null,"permitInfo":null,"description":"Despite the uninspiring description in the Holbeck/Stanley (\"bible\").  This is a fantastic run.  Maybe even a classic now that is has an internet guage and predictable flows. Likely a great wintertime resource in addition to spring melt.\n\n**Character**\n\nIV - V Lo-Medium Volume Creek.  Pool drop in nature with some longer boulder gardens. Probably 20-25 great rapids, mix of boulder gardens, ledges, and even a few slides. A few good mini gorges in the first mile or two.  Run flattens out and runs thru a ~1/2 m developed area.  After the dam, the run gets a bit steeper and more frequent pool drop. Good Rapids all the way to the take-out.\n\nAt similar flows, SF T is:\n\n1\\. Similar in difficulty but shorter than SF Feather.\n\n2\\. Easier, more open, and higher quality than Lovers Leap.\n\n3\\. Much longer and harder than Pauley/Lavazola.\n\nBest comparision is a longer, no hike version of Canyon Creek (SF Yuba trib).\n\n**Portages**\n\n2 Portages. 20-25' dam (looks runnable, I'll let you test for rebar) and a bigger drop multi-tier 35-40' drop somewhat similar to the \"ugly duckling portage\" on S Branch Feather. Do beware the obvious piton in the first significant drop of the run.\n\n**Logistics**\n\nTake Out = Rainbow Pool (just off of highway 120, just west of Cherry Lake Rd)\n\nPut In = HWY 120 bridge ~6mi upstream of rainbow pool\n\nRecommended Flows = 300-350 is ideal for first timers and/or the faint of heart.  Likely up to 600 if you are bold.\n\n**Is this run for me?**\n\nIf you want to step up to class V creeking, hone your boat scouting and have a fun adventure, go get it at 350cfs or less. Everything looked portageable. If you don't have fun on the first mile, take out at Berkeley camp.\n\nPlayground for a confident class V boater.\n\nIf you are a class V+ boater and haven't done it, it's worth it. Fun but not overly challenging.\n\nNote: the reach ID'ed by the lat/longitude coordinates is from Rte. 101 to the campground. However, it contains some flatwater. There's some pretty honking gradient from the campground to the main Tuolumne.\n\nThere is an upper section starting at Carlon Day Use Area, that provides an experience somewhere between what is found on the section described in the Holbeck/Stanley (\"bible\") and the honking gradient below Rainbow Falls.  It is [described here](https://mthoodh2o.blogspot.com/2019/10/sf-tuolumne-ascension-gorge.html), and provides an adventurous option when flows on the guidebook stretch are too low.","averageGradient":null,"maxGradient":null,"length":"7.4","correlations":[{"reachID":"327","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"300","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"600"},"gaugeInfo":{"name":"SF TUOLUMNE R NR OAKLAND REC CAMP","gaugeSource":"CDEC","gaugeSourceIdentifier":"STO","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"120","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.73","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"37.8217","longitude":"-120.0119"},"externalSourceLinks":{"sourceLink":{"url":"https://cdec.water.ca.gov/dynamicapp/QueryF?s=STO","text":"California Data Exchange - Station Log"},"secondaryLink":{"url":"https://cdec.water.ca.gov/cdecplotter/JspPlotAll?staid_id=STO","text":"California Data Exchange - Data Plot"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"120","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["112883","118162"],"geometry