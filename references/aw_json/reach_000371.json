ge/images/medium/uCLjFGtKe6kPOoXQdbgoh","large":"https://api.americanwhitewater.org/image/images/big/uCLjFGtKe6kPOoXQdbgoh"}},{"id":"TLgEuGsfiwlmR78Ryew1H","ext":"jpg","post_id":"PuDnjEN1QeKpDij6DsVVw","description":"","caption":"Flip Rock","poi_name":null,"subject":"Jeff Venturino","author":"Thomas O'Keefe","poi_id":null,"photo_date":"2025-05-29T05:40:46.000Z","updated_at":"2025-05-30T05:40:52.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/TLgEuGsfiwlmR78Ryew1H","large":"https://api.americanwhitewater.org/image/images/big/TLgEuGsfiwlmR78Ryew1H"}},{"id":"HMRSGTO9E1ab0TrcMQdEZ","ext":"jpg","post_id":"PuDnjEN1QeKpDij6DsVVw","description":"","caption":"Stevens Gulch","poi_name":null,"subject":"","author":"Thomas O'Keefe","poi_id":"110762","photo_date":"2025-05-29T05:40:47.000Z","updated_at":"2025-05-30T05:40:52.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/HMRSGTO9E1ab0TrcMQdEZ","large":"https://api.americanwhitewater.org/image/images/big/HMRSGTO9E1ab0TrcMQdEZ"}},{"id":"tjVGKc3YrAgMjLHlimxe5","ext":"jpg","post_id":"PuDnjEN1QeKpDij6DsVVw","description":"","caption":"Mishawaka Access","poi_name":null,"subject":"","author":"Thomas O'Keefe","poi_id":"PSkaOxY5mm7e2JsIB80Es","photo_date":"2025-05-29T05:40:46.000Z","updated_at":"2025-05-30T05:40:52.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/tjVGKc3YrAgMjLHlimxe5","large":"https://api.americanwhitewater.org/image/images/big/tjVGKc3YrAgMjLHlimxe5"}}],"detail":{"id":"371","permitUrl":"","permitInfo":"","description":"This is the most challenging stretch of water below the Narrows. Most of the rapids are read-and-run class IV. The first rapid of consequence is split rock (also called Triple Rock, Twin Pin, etc.), which has an aesthetic line in the middle until high water, when the hole becomes very sticky and has resulted in a number of good stories. The next significant drop is Tunnel Rapid (IV). Here the river has forceful waves and hydraulics before the current slams into a large undercut wall on the left. That rapid takes its name from the adjacent highway tunnel. Shortly downstream you will encounter an excellent squirt spot on river left; it's so good it's called the U.S.S. (Ultimate Squirt Spot).\n\nDirectly up-river from the Mishawaka Inn is its eponymous rapid, Mishawaka Falls (IV). Mishawaka Inn is an iconic riverfront music venue with seasonal outdoor amphitheater, indoor lounge, and full-service cafe. It can be overrun by hippies and/or bikers in the summer. At times it is like a Phish concert and/or Hells Angels rally.\n\nThis is an outstanding play run at about 3.25 to 4 feet on the Pineview gauge. Above 4', the current is rapid and you only get one, on-the-fly shot at river features. Rapids become much more continous and swims become more consequential. The most reliable flow information, and a calculator for converting cfs to/from the Pineview gauge, is available from the Poudre Rock Report at <http://www.poudrerockreport.com>\n\nLogistics:\n\nThe put-in is at Steven's Gulch Access or Upper Landing; both are very nice improved picnic area/launch sites with changing rooms. The take-out is at Dead Deer but you can also stop at Mishawaka Inn where you can have a beer with greasy food while you enjoy the music and the local scene.\n\nFor descriptions of Colorado runs, see Whitewater of the Southern Rockies by Stafford and McCutchen, or Colorado Rivers and Creeks by Banks and Eckert.\n\nAdditional Poudre Runs: [Big South](http://www.americanwhitewater.org/content/River/view/river-detail/365/) (Class V/VI), [Joe Wright Creek](http://www.americanwhitewater.org/content/River/view/river-detail/2859/) (Class V), [Spencer Heights](http://www.americanwhitewater.org/content/River/view/river-detail/369/) (Class V/VI), [South Fork](http://www.americanwhitewater.org/content/River/view/river-detail/374/) (Class IV/V), [White Mile Run/Upper Rustic](http://www.americanwhitewater.org/content/River/view/river-detail/367/) (Class III), [Grandpa's Gorge/Lower Rustic](http://www.americanwhitewater.org/content/River/view/river-detail/368/) (Class III/IV), [The Narrows](http://www.americanwhitewater.org/content/River/view/river-detail/370/) (Class IV/V/V+), [Upper Mishawaka](http://www.americanwhitewater.org/content/River/view/river-detail/371/) (Class III/IV), [Lower Mishiwaka](http://www.americanwhitewater.org/content/River/view/river-detail/3368/) (Class III), [Poudre Park](http://www.americanwhitewater.org/content/River/view/river-detail/3369/) (Class IV), [Bridges](http://www.americanwhitewater.org/content/River/view/river-detail/3370/) (Class III/IV), [Upper North Fork](http://www.americanwhitewater.org/content/River/view/river-detail/373/) (Class IV/V), [Lower North Fork](http://www.americanwhitewater.org/content/River/view/river-detail/2822/) (Class II/III), and [Filter Plant](http://www.americanwhitewater.org/content/River/view/river-detail/372/) (Class III)","averageGradient":"64","maxGradient":null,"length":"4.2","correlations":[{"reachID":"371","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"200","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"3000"},"gaugeInfo":{"name":"CACHE LA POUDRE AT CANYON MOUTH NEAR FORT COLLINS","gaugeSource":"COLORADO_DEPARTMENT_OF_WATER_RESOURCES","gaugeSourceIdentifier":"CLAFTCCO","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"373","dateTime":"2026-05-11T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.68","dateTime":"2026-05-11T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"40.66451","longitude":"-105.224188"},"externalSourceLinks":null},"migrationErrorExplanation":"Previous Flowbands: \nMed