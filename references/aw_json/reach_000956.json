[{"result":{"data":{"json":{"id":"956","stub":{"id":"956","section":"A) Silver Star Rd to Township Rd (22.3 miles)","altname":"","river":"Snake","difficulty":"ItoIII","states":["USA-MNN"]},"primaryGaugeStatus":{"status":"low-runnable","latestReading":{"value":"3.74","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"107864","location":{"latitude":"46.195004","longitude":"-93.251663"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"access","description":"This is an alternate (AND RECOMMENDED) put-in.","id":"106425","location":{"latitude":"46.170134","longitude":"-93.258358"},"name":"Aitkin County Park","distance":"2.5","photoID":"0","difficulty":"N/A","approximate":false},{"type":"access","description":"This is an alternate (and recommended) take-out.\n\nIf you use the alternate put-in (from the county park) and this take-out, you have a run of ~5.6 miles, and catch the best rapids and omit a lot of flatwater.","id":"106426","location":{"latitude":"46.125258","longitude":"-93.221536"},"name":"Olympic Street","distance":"8.15","photoID":"0","difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"113106","location":{"latitude":"46.024406","longitude":"-93.230881"},"name":"Take Out","distance":"22.3","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"956","permitUrl":null,"permitInfo":null,"description":"(Description thanks to jetmanjake, davefriend, and JeffB from RapidsRiders message board.)\n\nSome grade I-ish paddling can be cut if you put in at Aitkin County Park, about 5 mi north of the jct of highways 65 & 27. The park entrance is a clearly marked dirt road that runs east off Hwy 65. Stay left when on the dirt road to eventually get to the park. It is 2 to 2.5 miles off the highway.\n\nThe take-out is found by going east on 360th Ave and then turn left when 360th ends in a T intersection (approx 5 mi). After the left turn, go until you reach a bridge crossing the snake (less than a mile). 360th Ave is the dirt road that runs east from the junction of Hwys 65 & 27. (Hwy 27 runs west and is paved.) This junction is the village of Woodland - a bar and couple of buildings on the west side of Hwy 65.\n\nAll wheel drive may be an asset at times since the unpaved roads can be rather mushy.\n\nThe two significant rapids (Upper and Lower Snake River Falls) are both signposted, scout both river left. The term \"falls\" is a definite over-statement. Still they are fun sections with the river at about 3' or so. The first is a ninety-degree left hand turn against a wall, the second is a gorge-y bit that forms a couple holes, maybe III- at medium flows. While you'll paddle some fairly long stretches of flat water, Lower Falls is a fairly continuous rapid, maybe 900 yards worth. Since this stretch is paddled often in open canoes, both rapids are well posted with portage trails for those not inclined to run it. The rest is a good beginner/canoe run with I-II riffles.\n\nMinnesota DNR has a web page with pdf maps at [DNR Canoeing - Snake River](http://www.dnr.state.mn.us/canoeing/snakeriver/index.html). The \"top left\" pdf shows the section of the river we are talking about in a scaled up inset. Note that the pdf calls 360th ave \"County Road 82\" and/or \"State Forest Road\". I've never seen signs in the area with those designations. Likewise, the pdf map calls Olympic St. \"County Hwy 23\". I don't recall that there is any kind of signage for this road...","averageGradient":null,"maxGradient":null,"length":"22.1","correlations":[{"reachID":"956","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":"WE NEED YOUR INPUT to refine/redefine gauge ranges! Create a \"Trip Report\" stating flow and your impressions (low/moderate/high).","lowRunnableRangeComment":"WE NEED YOUR INPUT to refine/redefine gauge ranges! Create a \"Trip Report\" stating flow and your impressions (low/moderate/high).","mediumRunnableRangeComment":"WE NEED YOUR INPUT to refine/redefine gauge ranges! Create a \"Trip Report\" stating flow and your impressions (low/moderate/high).","highRunnableRangeComment":"WE NEED YOUR INPUT to refine/redefine gauge ranges! Create a \"Trip Report\" stating flow and your impressions (low/moderate/high).","aboveRecommendedRangeComment":"WE NEED YOUR INPUT to refine/redefine gauge ranges! Create a \"Trip Report\" stating flow and your impressions (low/moderate/high).","lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"3.5","beginMediumRunnable":"4.25","beginHighRunnable":"5","endHighRunnable":"6"},"gaugeInfo":{"name":"SNAKE RIVER NEAR PINE CITY, MN","gaugeSource":"USGS","gaugeSourceIdentifier":"05338500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"697","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.74","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"45.83986823","longitude":"-92.93631879"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/05338500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/05338500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":"Gauge (974 sq.mi. drainage) is far downstream with lake/dam intervening. Flow here may be ~1/7th flow reading of gauge.","status":{"status":"low-runnable","latestReading":{"value":"3.74","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null}}],"pointOfInterestIDs":["107864","106425","106426","113106"],"geometry":{"type":"LineString","coordinates":[[-93.25162064946338,46.194962558533284],[-93.25181123236149,46.194767794963184],[-93.25202163236116,46.194559394963505],[-93.25230223