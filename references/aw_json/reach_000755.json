[{"result":{"data":{"json":{"id":"755","stub":{"id":"755","section":"Chamberlain Lake to Allagash Village","altname":"Allagash Wilderness Waterway","river":"Allagash","difficulty":"ItoII","states":["USA-MAI"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"6160","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"108674","location":{"latitude":"46.4948","longitude":"-69.2861"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"113910","location":{"latitude":"46.5754","longitude":"-69.3597"},"name":"Take Out","distance":"92","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"755","permitUrl":null,"permitInfo":null,"description":"The Allagash is an iconic wilderness canoe trip. During the summer the river is downright packed with guided trips, private trips, and groups from summer camps.\n\nThe primary whitewater on the Allagash is Chase Stream Rapids (Class II). Chase Stream comes immediately below the dam at the outflow of Churchill Lake. These moderate rapids run for about two miles before flattening out. Many canoe trips elect to have the rangers at Churchill Dam portage their food and equipment around in a truck before running it with empty boats.\n\nThe other prominent drop is Allagash Falls, a large Class V that is portaged by all the canoe trips. Allagash Falls is likely runnable, though you'd have to be very enthusiastic about the logistics of getting a creek boat deep into the woods for a relatively short bit of paddling. It has [been swum](https://bangordailynews.com/2016/10/10/living/after-falling-40-feet-over-allagash-falls-this-man-has-a-story-to-tell/) [accidentally](http://fiddleheadfocus.com/2016/08/23/news/top-stories/kayaker-injured-but-alive-after-plunging-over-allagash-falls/), and knowing New England kayaking history someone may have run it many years ago.","averageGradient":null,"maxGradient":null,"length":"8.6","correlations":[{"reachID":"755","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"700","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"25000"},"gaugeInfo":{"name":"Allagash River near Allagash, Maine","gaugeSource":"USGS","gaugeSourceIdentifier":"01011000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"6160","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"5.79","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"47.0697222","longitude":"-69.0794444"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/01011000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/01011000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"migration-runnable","latestReading":{"value":"6160","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["108674","113910"],"geometry":{"type":"LineString","coordinates":[[-69.28540646956213,46.49423299449836],[-69.28487246956297,46.49456672783117],[-69.28469860289658,46.49475019449756],[-69.28424406956395,46.49504339449709],[-69.28402560289766,46.49524339449681],[-69.28347540289849,46.496172327828674],[-69.28278666956624,46.49693299449416],[-69.28149080290154,46.497649527826354],[-69.28126426956857,46.49784579449272],[-69.28081620290261,46.498493527825076],[-69.28049226956978,46.49917452782404],[-69.27981286957083,46.49998072782279],[-69.279