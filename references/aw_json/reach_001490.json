[{"result":{"data":{"json":{"id":"1490","stub":{"id":"1490","section":"2. End of pavement to McClun Wayside Park","altname":"","river":"Calapooia","difficulty":"IItoIII","states":["USA-ORE"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"51","dateTime":"2026-05-12T03:10:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"111841","location":{"latitude":"44.2957","longitude":"-122.653"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"117113","location":{"latitude":"44.3272018432617","longitude":"-122.741996765137"},"name":"Take Out","distance":"6.5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"890507","ext":"jpg","post_id":"893018","description":null,"caption":" on Calapooia @2. 13 mi. above Holley to Concrete Bridge","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/890507","large":"https://api.americanwhitewater.org/image/images/big/890507"}},{"id":"890510","ext":"jpg","post_id":"893023","description":null,"caption":"Pmacy","poi_name":"Dollar Drop","subject":null,"author":"jcruser","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/890510","large":"https://api.americanwhitewater.org/image/images/big/890510"}},{"id":"890511","ext":"jpg","post_id":"893064","description":null,"caption":" on Calapooia @2. 13 mi. above Holley to Concrete Bridge","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/890511","large":"https://api.americanwhitewater.org/image/images/big/890511"}},{"id":"890506","ext":"jpg","post_id":"893017","description":null,"caption":"Calapooia @2. 13 mi. above Holley to Concrete Bridge","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/890506","large":"https://api.americanwhitewater.org/image/images/big/890506"}},{"id":"890508","ext":"jpg","post_id":"893021","description":null,"caption":"Pmacy","poi_name":null,"subject":null,"author":"jcruser","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/890508","large":"https://api.americanwhitewater.org/image/images/big/890508"}},{"id":"30394","ext":"jpeg","post_id":"1039","description":"Nice spring run, just barely runnable for kayaks.  ","caption":"30394.jpeg","poi_name":"","subject":"","author":"Brent O'Neill","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/30394","large":"https://api.americanwhitewater.org/image/images/big/30394"}},{"id":"890512","ext":"jpg","post_id":"893065","description":null,"caption":" on Calapooia @2. 13 mi. above Holley to Concrete Bridge","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/890512","large":"https://api.americanwhitewater.org/image/images/big/890512"}},{"id":"890509","ext":"jpg","post_id":"893022","description":null,"caption":null,"poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/890509","large":"https://api.americanwhitewater.org/image/images/big/890509"}}],"detail":{"id":"1490","permitUrl":"","permitInfo":"","description":"The Wiley Creek gage is the closest actual gage, and is about 40% of what you will have in the Calapooia River.\n\nPat Welch has a correlation gage that can be used as well.  500-2000 cfs on Pat Welches is worth doing, 1,000-1,500 is most common: http://levels.wkcc.org/?f=cx3\n\nThere are a couple pull outs at the point where the road turns to gravel where there is room to park, with a convenient put in spot.\n\nDo not go past the pavement when doing this run, or you may face a $115 ticket.  This is a change from the past, and guidebook descriptions may be off.  The rules are clearly posted where the pavement ends, and listed below.\n\n**Upper Calapooia Road**\n\n- The road is open to the public unless the gates are closed. We will post a notification on [our website](http://www.co.linn.or.us/Roads/roads.asp?fbclid=IwAR1s72vsnVUAdCb8_fETw_DUlgvNJT4ajr8pJwKpdwW0ShaTBmYbRSzY-ng) when we are going to close the gates.\n\n- The road is posted no parking from the end of the pavement to the national forest boundary. Law enforcement is writing citations to anyone who violates the no parking restriction.\n\n- There is no legal access to the river from the public road until you get into the national forest.\n\n       .  Weyerhaeuser is actively logging in the vicinity so be very cautious and watch out for log trucks\n\nThe run starts off right away with defined class II rapids, keep an eye out for opportunities to play around throughout the run.  A stand out rapid early on ends in a mini-gorge, this is one of the more scenic spots on the run.    Just below the mini-gorge is a large rock in the center of the river, the small rapid just below the midstream rock ends in a short bedrock ledge creating a sticky hole that can be boofed over, or snuck on the right.  For more advanced boaters, this hole has eddy service and is a good place to practice working your way out of sticky situations at lower flows.  This location would make for a decent lunch spot with a cobble beach on the right.\n\nMore class II rapids with a couple that could be class III at some flows continue amongst many small front surf features, jets of water to ferry across and dynamic eddies, making for a great learning environment for those with a combat roll.\n\nThe stand out rapid of the run is Dollar Drop, a short ledge that can be scouted and portaged/lapped on the right.  There are straight forward boof options on the right half of the drop, or a class IV hydraulic in the middle.\n\nThings slow down below Dollar Drop, but the occasional class II/III rapid (including the longest of the run) await between here and the take out at McClun Wayside Park.\n\nTo access this run from Holley, drive upstream 2.1 miles on Upper Calapooia Rd to McClun Wayside Park.  This is just a gravel pull out with a small wooden kiosk that is easy to miss from the road.  This is the take out, and it is not a bad idea to mark the pull out spot at river level.\n\nThe put in is 6.5 miles upstream on the same road where it turns from pavement to gravel.  Park next to where the road is still paved.","averageGradient":"30","maxGradient":null,"length":"6.1","correlations":[{"reachID":"1490","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"200","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"1000"},"gaugeInfo":{"name":"WILEY CREEK NEAR FOSTER, OR","gaugeSource":"USGS","gaugeSourceIdentifier":"14187000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"51","dateTime":"2026-05-12T03:10:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.87","dateTime":"2026-05-12T03:10:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"44.37234769","longitude":"-122.6231384"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/14187000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/14187000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":"Previous Flowbands: \nRange of Boatable Flows (R0-R9): 200 - 1000 cfs  Comment: \t\t\r\n\r\nMaximum flow is estimated\r\n\n\nMigration Errors: \nSingle range is valid but doesn't provide low/medium/high runnable\nThere is one comment for all of low/medium/high runnable.","comment":null,"status":{"status":"below-recommended","latestReading":{"value":"51","dateTime":"2026-05-12T03:10:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["111841","117113"],"geometry":{"type":"LineString","coordinates":[[-122.65300010011761,44.29548955280186],[-122.65337518672443,44.29548973124458],[-122.65400952005677,44.29545153124462],[-122.65433798672292,44.29541319791139],[-122.65462078672249,44.29536379791142],[-122.65487298672205,44.29533639791146],[-122.6554307867212,44.29522153124498],[-122.65553778672103,44.295210531245004],[-122.65562178672093,44.29522153124498],[-122.655774720054,44.29523793124497],[-122.65585098672055,44.29527099791159],[-122.65629418671989,44.29536993124475],[-122.65635532005312,44.29539193124475],[-122.65652352005287,44.295402731244735],[-122.6569513200522,44.29538113124477],[-122.65727238671838,44.29529319791152],[-122.65811298671709,44.29496433124541],[-122.65827358671682,44.29492593124547],[-122.65841872004991,44.29490933124549],[-122.65925172004859,44.29492613124546],[-122.66026792004703,44.29485513124559],[-122.6604667200467,44.29482213124561],[-122.66070338671302,44.29476179791237],[-122.66139892004527,44.29454259791271],[-122.66205612004428,44.294465797912835],[-122.66228538671055,44.294465797912835],[-122.66274378670988,44.29449879791276],[-122.66289652004298,44.29452079791275],[-122.66304938670937,44.29457573124597],[-122.66318692004252,44.29467459791249],[-122.66333958670896,44.29482833124558],[-122.66355352004194,44.29498193124539],[-122.66366818670843,44.29503693124525],[-122.6642259200409,44.29545413124464],[-122.66431752004077,44.29559679791106],[-122.66443972