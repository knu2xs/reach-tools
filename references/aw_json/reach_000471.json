[{"result":{"data":{"json":{"id":"471","stub":{"id":"471","section":"3.14  -  Upper Hooch - GA Route 115 to Duncan Bridge Road","altname":"Upper Hooch","river":"Chattahoochee","difficulty":"IItoIII","states":["USA-GEO"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"1.73","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"111182","location":{"latitude":"34.5745","longitude":"-83.6345"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"playspot","description":"Multiple routes on both sides of the island. Big holes develop on the right side of the island at high water. At lower flows most people run the narrow channel on the left of the island.","id":"187","location":{"latitude":"0","longitude":"0"},"name":"Buck Island Shoals","distance":"1","difficulty":"II+","approximate":false,"photoID":"0"},{"type":"hazard","description":"Rock on river right above the Lunch Beach. Good surf wave with a huge eddy on the bottom right.","id":"195","location":{"latitude":"0","longitude":"0"},"name":"Canoe Eating Rock","distance":"1.2","photoID":"3828","difficulty":"II+","approximate":false},{"type":"hazard","description":"At flows above 2500 cfs or over about 4 feet a dangerous low head dam type hole forms on the right side of this rapid. This one is easy to see coming due to the long pool above it and the large rock outcrop on river right. Run left or right at most water levels.","id":"188","location":{"latitude":"0","longitude":"0"},"name":"First Ledge","distance":"1.5","photoID":"3285","difficulty":"II+","approximate":false},{"type":"rapid","description":"Generally run on river left.","id":"189","location":{"latitude":"0","longitude":"0"},"name":"Second Ledge","distance":"1.6","difficulty":"II+","approximate":false,"photoID":"14687"},{"type":"playspot","description":"Fun, shallow side surfing hole.  At flows around 3 feet the center of the hole can hold swimmers for a dangerously long time.  Easy to skirt the center on either side.","id":"190","location":{"latitude":"0","longitude":"0"},"name":"Third Ledge","distance":"1.8","difficulty":"II+","approximate":false,"photoID":"8195"},{"type":"playspot","description":"Another long wide shoal rapid. At higher flows there is great surfing everywhere in this one!","id":"192","location":{"latitude":"0","longitude":"0"},"name":"Washboard","distance":"1.9","difficulty":"II+","approximate":false,"photoID":"0"},{"type":"rapid","description":"A long riverwide shoal, with a sandy beach at the bottom on river left. Lots of fun small waves and holes thru the shoals.","id":"194","location":{"latitude":"0","longitude":"0"},"name":"False Horseshoe","distance":"2.1","difficulty":"II","approximate":false,"photoID":"0"},{"type":"playspot","description":"Run left to right. Big pool at the bottom.","id":"191","location":{"latitude":"0","longitude":"0"},"name":"Horseshoe","distance":"2.5","difficulty":"II+","approximate":false,"photoID":"4117"},{"type":"rapid","description":"long fun shoal rapids with some good surfing opportunities.","id":"2185","location":{"latitude":"0","longitude":"0"},"name":"Shoals below horseshoe","distance":"3","difficulty":"II+","approximate":false,"photoID":"0"},{"type":"rapid","description":null,"id":"586","location":{"latitude":"0","longitude":"0"},"name":"Take-out","distance":"4","difficulty":"N/A","approximate":false,"photoID":"0"},{"type":"takeout","description":null,"id":"116450","location":{"latitude":"34.5409","longitude":"-83.6224"},"name":"Take Out","distance":"4","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":"Just downstream of the takeout, below the bridge, is one last ledge. There are a series of holes on the right, and a wave on the left. At low flows there is an island in the middle. Play your brains out, then paddle back up the 100 yards to the take-out.","id":"587","location":{"latitude":"0","longitude":"0"},"name":"One more for the road.","distance":"4.1","difficulty":"II+","approximate":false,"photoID":"0"}],"alerts":[{"id":"101250741","title":null,"post_date":"2013-12-29 05:00:00+00","detail":"The river-left channel behind Buck Island (3/4 mile below 115 Bridge) has a new large tree down blocking the entire channel. We ran this channel in spring 2013 and it was clear then, so this is new wood.\nThere are eddys above the wood on river left where you can pull out and portage, however, it appears to be private property.\nThis channel is rarely paddled and won't affect the majority of boaters running the usual lines.","user":{"name":"Jim Tebbel"}},{"id":"101086043","title":null,"post_date":"2009-09-20 04:00:00+00","detail":"The Cornelia gauge is malfunctioning at high levels, reporting 363 cfs when the actual level is thousands higher. Watch for gauge malfunction at high levels in the future. Can be identified by wild jumps up and down on the gauge graph.","user":{"name":"Gary DeBacher"}}],"photos":[{"id":"3287","ext":"jpeg","post_id":"3898","description":"this is first ledge where you normally run it and at high it is a pretty good squirt spot but the hole was washed out","caption":"First ledge squirt","poi_name":"1st Ledge","subject":"Chris Gorman","author":"","poi_id":"189","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3287","large":"https://api.americanwhitewater.org/image/images/big/3287"}},{"id":"3293","ext":"jpeg","post_id":"3899","description":"This is a seal launch right into the first ledge, on the right bank, only possible at high water so the pool is deep.","caption":"Seal Launch at the Hooch","poi_name":"Seal launch","subject":"Chris Gorman","author":"Eric Mimes","poi_id":"2185","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3293","large":"https://api.americanwhitewater.org/image/images/big/3293"}},{"id":"11274","ext":"jpeg","post_id":"7472","description":"What Jimmy calls 'half a cartwheel' everyone else calls 'hitting your roll'.","caption":"First Ledge","poi_name":"First Ledge","subject":"Jimmy Lowe","author":"Greg Simpson","poi_id":"194","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/11274","large":"https://api.americanwhitewater.org/image/images/big/11274"}},{"id":"9601","ext":"jpeg","post_id":"4992","description":"Dumb canoe tricks","caption":"Canoe striding","poi_name":"Surfers Beach","subject":"Will Reeves","author":"Myra Reeves","poi_id":"192","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/9601","large":"https://api.americanwhitewater.org/image/images/big/9601"}},{"id":"7506","ext":"jpeg","post_id":"7491","description":"At the fist of the three ledges, on the right there is a nice little slide.  Just watch for the big pile of logs at the bottem.","caption":"Greg Simpson on upper hooch","poi_name":"Right of the First of The Three Ledges","subject":"Right of fist ledge at low water","author":"By  Jimmy L.","poi_id":"586","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/7506","large":"https://api.americanwhitewater.org/image/images/big/7506"}},{"id":"3828","ext":"jpeg","post_id":"1327","description":"","caption":"Lunch Beach Wave","poi_name":"Lunch Stop Wave","subject":"","author":"Brad Roberts","poi_id":"191","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3828","large":"https://api.americanwhitewater.org/image/images/big/3828"}},{"id":"877692","ext":"jpeg","post_id":"877969","description":"740 cfs","caption":"Zippy makes it down Third Ledge","poi_name":null,"subject":null,"author":"RiverSasquatch","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewate