[{"result":{"data":{"json":{"id":"1826","stub":{"id":"1826","section":"3. Santa Elena Canyon: Lajitas to Santa Elena Canyon River Access (20 miles)","altname":"","river":"Rio Grande","difficulty":"IIstandoutIII","states":["USA-TEX"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"8","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Large dirt parking lot and boat launch at river left","id":"104968","location":{"latitude":"29.2645263671875","longitude":"-103.78302001953125"},"name":"Lajitas River Access","distance":"0","photoID":"0","difficulty":"N/A","approximate":false},{"type":"takeout","description":"Parking/access at river left.  Composting toilets are available.","id":"101111","location":{"latitude":"29.155590057373047","longitude":"-103.59894561767578"},"name":"Santa Elena Canyon River Access","distance":"20.3","photoID":"0","difficulty":"N/A","approximate":false}],"alerts":[{"id":"l3QUnFcq8QfoszUonB3y9","title":"Santa Elena Canyon CFS","post_date":"2023-03-28 18:15:16+00","detail":null,"user":{"name":"Matthew Phillips"}}],"photos":[{"id":"885717","ext":"jpeg","post_id":"888496","description":"Entrance to main part of Rockslide Rapid","caption":"","poi_name":"","subject":"","author":"Andrea Croskrey","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/885717","large":"https://api.americanwhitewater.org/image/images/big/885717"}},{"id":"885718","ext":"jpeg","post_id":"888497","description":"Entrance to main part of Rockslide Rapid","caption":"","poi_name":"Rockslide","subject":"","author":"Jean Krejca","poi_id":"101108","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/885718","large":"https://api.americanwhitewater.org/image/images/big/885718"}},{"id":"885719","ext":"jpeg","post_id":"888498","description":"Main part of Rockslide Rapid","caption":"","poi_name":"Rockslide","subject":"","author":"Jean Krejca","poi_id":"101108","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/885719","large":"https://api.americanwhitewater.org/image/images/big/885719"}},{"id":"885299","ext":"jpeg","post_id":"888003","description":"the easiest entrance is to the left of the large boulder on the left","caption":"Rockslide Rapid 1","poi_name":"Rockslide","subject":"","author":"","poi_id":"101108","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/885299","large":"https://api.americanwhitewater.org/image/images/big/885299"}}],"detail":{"id":"1826","permitUrl":"","permitInfo":"","description":"In whitewater terms, the Rio Grande is not particularly challenging, but paddling through Santa Elena Canyon should still be on every whitewater paddler's bucket list, simply because of the scenery.  Santa Elena Canyon is a relatively narrow gorge (100-150 feet wide) with sheer cliff walls that tower as much as 1/4 mile above the river on both sides.  Unlike most canyons, Santa Elena also has two mouths-- the upper end looks just like the lower end.  This is one of the most remote and untamed stretches of river in Texas.  At Entrance Camp, you are at one of the least accessible points in Big Bend National Park, a place experienced only by a few paddlers every year-- and by the horses that run wild along the banks of the river.\n\nAt low to moderate levels, there are several \"wall shot\" rapids inside the canyon that are arguably more difficult than the named rapids (Matadero, etc.) above the canyon.  Generally, all of these rapids-- in addition to the named Class II rapids-- will require some maneuvering by canoeists, particularly when the river is relatively low and channelized.  However, whitewater paddlers will probably find them to be straightforward.  This section gets pushy at high levels (thousands of cfs), but most of the rapids (with the exception of Rock Slide) wash out at those levels.\n\nThis stretch is doable as a day trip when the river is running high (> 1000 cfs.)  It can be rafted down to 500 cfs as a 2-day trip and canoed or kayaked as a 2-day trip down to 150 cfs.  The entire section of river is in Big Bend National Park and requires a permit obtainable at park headquarters or in Lajitas.  The state and national parks require anyone on a river trip to wear their PFD's through named rapids.  All of the river access points are on river left (Texas side.)\n\nDistances and gradient measured using GIS tools in 2015.","averageGradient":"7","maxGradient":"0","length":"20.6","correlations":[{"reachID":"1826","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":"Too low for reasonable whitewater trip.","lowRunnableRangeComment":"OK for two-day kayak trip.  Too low for rafts.","mediumRunnableRangeComment":"Moderate flows.  Rapids are generally beginner-friendly (except for Rock Slide.)","highRunnableRangeComment":"High flows.  Pushy current.  Not beginner-friendly.","aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":"IIstandoutIII","highRunnableAdjustedDifficulty":"IItoIIIstandoutIV","beginLowRunnable":"150","beginMediumRunnable":"500","beginHighRunnable":"1000","endHighRunnable":"10000"},"gaugeInfo":{"name":"Rio Grande nr Castolon, TX","gaugeSource":"USGS","gaugeSourceIdentifier":"08374550","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"8","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"2.16","dateTime":"2026-05-12T03:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"29.13798","longitude":"-103.5249033"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/08374550","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/08374550/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"8","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["104968","101111"],"geometry":{"type":"LineString","coordinates":[[-103.78306879525103,29.26445190594239],[-103.78279848268198,29.264046287909707],[-103.78222541601622,29.26277728791166],[-103.78227441601615,29.262602887911953],[-103.78225068268284,29.262461021245485],[-103.78186161601678,29.26199888791291],[-103.78166988268373,29.26164062124678],[-103.78167288268372,29.261425887913788],[-103.78165715976706,29.261361114997214],[-103.7815960160172,29.26110922124758],[-103.78137961601749,29.260805287914764],[-103.78047501601891,29.258794687917888],[-103.78008128268618,29.25804228791901],[-103.77996861601969,29.25769662125288],[-103.7795964160203,29.257138221253797],[-103.77940741602055,29.25673948792104],[-103.77911421602101,29.256441221254878],[-103.77882128268817,29.25625082125515],[-103.77873168268832,29.256131287922013],[-103.77872361602164,29.25584382125578],[-103.77881508268814,29.255612487922804],[-103.77877081602156,29.255256021256685],[-103.77879028268819,29.25439508792471],[-103.77873168268832,29.25403888792522],[-103.77880679310482,29.253468370217778],[-103.77880688268817,29.25346768792616],[-103.77867888268838,29.2532426212598],[-103.77866261602173,29.253064487926736],[-103.77846781602204,29.25249728792767],[-103.77851388268863,29.252323287927936],[-103.77847688268866,29.252039287928373],[-103.77804001602271,29.25166788792893],[-103.77746048269029,29.25097948793001],[-103.77685008269123,29.25012888793134],[-103.77647388269179,29.249747087931897],[-103.77605468269246,29.249459021265697],[-103.77554228269328,29.248947087933175],[-103.77507208269395,29.247954021268015],[-103.77528388269366,29.247150287935938],[-103.77551928269327,29.24666682127003],[-103.77608881602572,29.245318621272133],[-103.776010482