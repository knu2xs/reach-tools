[{"result":{"data":{"json":{"id":"1970","stub":{"id":"1970","section":"Route 42 Wayside to Goshen (Route 39)","altname":"","river":"Mill Creek (Calfpasture trib)","difficulty":"IItoIII","states":["USA-VRG"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"110603","location":{"latitude":"38.0009994506836","longitude":"-79.5792999267578"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"115870","location":{"latitude":"37.986400604248","longitude":"-79.4942016601562"},"name":"Take Out","distance":"7.5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"100847354","title":null,"post_date":"2009-05-26 04:00:00+00","detail":"There are three strainers in Mill Creek as of mid-May 2009. Approximately 30 feet below the first drop in Panther Gap a live tree on the left bank dips into the middle of the river. Take either the middle left or far right line. The next strainer is at the top of a drop, and must be run within 3 feet of the right bank. Though it may seem that it can be run within 10 feet of the right bank a 4 inch diameter branch is concealed on river right just below the initial drop. Finally, a little further is a large tree across 2/3 of the river; it is passable on the left.\nA small dam is located just upstream of a private bridge prior to the first Rt 39 bridge. Though it can be run it seems to have a decent hydraulic so either punch it hard or portage on the left.","user":null}],"photos":[{"id":"878462","ext":"jpeg","post_id":"878875","description":"Michael W.","caption":"April 13, 2011","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/878462","large":"https://api.americanwhitewater.org/image/images/big/878462"}},{"id":"878460","ext":"jpeg","post_id":"878873","description":"Michael just below low-head","capt