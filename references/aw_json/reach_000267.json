"}},{"id":"G7smagJI1qElXZphFbnVY","ext":"jpg","post_id":"8vPFZZX5gcsa9IUL4k6pE","description":"","caption":"Great Day for Inflatables ","poi_name":null,"subject":"","author":"Dave Steindorf","poi_id":null,"photo_date":"2026-02-21T18:16:15.000Z","updated_at":"2026-02-23T18:16:15.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/G7smagJI1qElXZphFbnVY","large":"https://api.americanwhitewater.org/image/images/big/G7smagJI1qElXZphFbnVY"}},{"id":"890588","ext":"jpg","post_id":"894520","description":null,"caption":"Typical scene on Rancheria","poi_name":null,"subject":null,"author":"Trent Pearce","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/890588","large":"https://api.americanwhitewater.org/image/images/big/890588"}},{"id":"890586","ext":"jpg","post_id":"894518","description":null,"caption":"Morgan Rucks","poi_name":null,"subject":null,"author":"Trent Pearce","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/890586","large":"https://api.americanwhitewater.org/image/images/big/890586"}},{"id":"890587","ext":"jpg","post_id":"894519","description":null,"caption":"Paddle out on the Navarro","poi_name":null,"subject":null,"author":"Trent Pearce","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/890587","large":"https://api.americanwhitewater.org/image/images/big/890587"}}],"detail":{"id":"267","permitUrl":null,"permitInfo":null,"description":"Rancheria Creek is a scenic Class II–III run with a relatively straightforward 15-mile shuttle. The character of the run is predominantly Class II, with intermittent Class III rapids that become more technical due to channel constrictions and vegetation.\n\nA defining feature of this run is significant willow growth and frequent woody debris. Many rapids are partially choked with willows that tighten lines and require active boat control. Downed trees are common and should be expected on any trip. Wood hazards are dynamic and can change from season to season—or storm to storm—so boaters should remain alert, scout when visibility is limited, and be prepared for portages.\n\nOverall, Rancheria Creek offers a beautiful paddle through coastal forest terrain, with moderate technical challenges primarily driven by vegetation and wood rather than gradient alone.\n\n**Other Information Sources:** Cassady &amp; Calhoun, Schwind\n\nhttps://cacreeks.com/ranchria.htm\n\n<http://brt-insights.blogspot.com/2008/01/mountain-view-run-rancheria-creek.html>","averageGradient":"0","maxGradient":"0","length":"14","correlations":[{"reachID":"267","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"500","beginMediumRunnable":"1000","beginHighRunnable":"2500","endHighRunnable":"5000"},"gaugeInfo":{"name":"NAVARRO RIVER NEAR NAVARRO","gaugeSource":"CDEC","gaugeSourceIdentifier":"NRN","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"81","dateTime":"2026-05-12T01:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"2.19","dateTime":"2026-05-12T01:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"39.1704559326172","longitude":"-123.668067932129"},"externalSourceLinks":{"sourceLink":{"url":"https://cdec.water.ca.gov/dynamicapp/QueryF?s=NRN","text":"California Data Exchange - Station Log"},"secondaryLink":{"url":"https://cdec.water.ca.gov/cdecplotter/JspPlotAll?staid_id=NRN","text":"California Data Exchange - Data Plot"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"81","dateTime":"2026-05-12T01:15:00.000Z","qualifier":"NORMAL"