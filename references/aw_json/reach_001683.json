[{"result":{"data":{"json":{"id":"1683","stub":{"id":"1683","section":"Listonburg (Whites Creek Road) to Casselman River","altname":"","river":"Whites Creek","difficulty":"IItoIII","states":["USA-PEN"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"1.49","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"108494","location":{"latitude":"39.7928009033203","longitude":"-79.326301574707"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"113731","location":{"latitude":"39.7542991638184","longitude":"-79.3142013549805"},"name":"Take Out","distance":"5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"101253477","title":null,"post_date":"2018-04-06 04:00:00+00","detail":"Ran Whites creek today at 3.8 on the Casselman gauge. Likely the lower runnable level but had a blast. There is a creek wide strainer about a 1/4 of the way down the run around a left turn. Could be dangerous and can be avoided by hugging the left bank. Hopefully I will get back there soon and cut it. The rest of the creek is pretty clear of wood.","user":{"name":"John Nicholson"}}],"photos":[],"detail":{"id":"1683","permitUrl":null,"permitInfo":null,"description":"The run is class 2 moves, but approaches class 3 or higher for its continuity.\n\nThere are a few spots to note, about 2-3 miles from the end there is some concrete in the middle of the river, like a piece of road washed down, so that should be avoided on the right. It is visible from the road along the drive up There are a few slides, one set about a mile from the end and the other entering into the casselman. Take out at Harnedsville bridge or somewhere along the Middle Yough.\n\nPut-in\n\nOff Rt 523, called whites creek road. Coming from 40 it will be on your left, from Confluence on the right."