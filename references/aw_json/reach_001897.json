[{"result":{"data":{"json":{"id":"1897","stub":{"id":"1897","section":"2. U.S. Route 221 to New River (Route 693)","altname":"","river":"Big Reed Island Creek","difficulty":"ItoIII","states":["USA-VRG"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"107977","location":{"latitude":"36.7938995361328","longitude":"-80.6483993530273"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"113220","location":{"latitude":"36.9338989257812","longitude":"-80.7497024536133"},"name":"Take Out","distance":"20","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"IxEXgaAxnUTlGthfXfrFq","title":"Liberty hill access (Double Cabin Road)","post_date":"2025-07-10 16:01:54+00","detail":"The fence remains but river access/egress is possible on the downstream side/river left of the bridge. A narrow path, not too steep within the VDOT right of way.","user":{"name":"Charles Whittle"}},{"id":"1NtP38Tc2SHfXY5Mx9B7C","title":"Liberty Hill access","post_date":"2022-07-10 21:37:25+00","detail":"The river landing at Double Cabin Road Rt 753 has been fenced to prevent access.\nThis is the first access about 4 miles below Rt 221 and another 9 miles from the next access at Greasy Creek.","user":{"name":"Charles Whittle"}},{"id":"101248146","title":null,"post_date":"2011-06-05 04:00:00+00","detail":"WARNING: There is a tunnel on river left about 9 miles into this run after putting on at HWY 221 according the Corbett book. DO NOT ENTER THE TUNNEL in a kayak or canoe. The water is very swift at the entrance and once you are inside there is not enough room to swing a paddle. The 40' long tunnel ends with a sudden class V drop 15' into a nasty strainer/sieve then over another 10' cascade level IV and rocky. This tunnel and falls also cuts off over a mile of river that makes a hairpin turn. The Greasy Creek takeout where 765 and 764 intersect is in that hairpin bend of river and you will be well beyond the takeout Corbett recommends and on private property. TAKE CAUTION!","user":{"name":"Matt Wells"}}],"photos":[{"id":"887687","ext":"jpeg","post_id":"890479","description":"Another view of the ledge downstream of Greasy Creek","caption":"BRI below Greasy Creek","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887687","large":"https://api.americanwhitewater.org/image/images/big/887687"}},{"id":"882283","ext":"jpeg","post_id":"884980","description":"","caption":"Hole in the wall","poi_name":null,"subject":null,"author":"tlivick","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/882283","large":"https://api.americanwhitewater.org/image/images/big/882283"}},{"id":"882284","ext":"jpeg","post_id":"884981","description":"","caption":"","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/882284","large":"https://api.americanwhitewater.org/image/images/big/882284"}},{"id":"879181","ext":"jpeg","post_id":"879616","description":"","caption":"Hole in the Wall Falls","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/879181","large":"https://api.americanwhitewater.org/image/images/big/879181"}},{"id":"879182","ext":"jpeg","post_id":"879617","description":"","caption":"Sieve Survivors","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/879182","large":"https://api.americanwhitewater.org/image/images/big/879182"}},{"id":"887689","ext":"jpeg","post_id":"890481","description":"","caption":"BRI between Rt. 753 and Greasy Creek","