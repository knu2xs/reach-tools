[{"result":{"data":{"json":{"id":"1060","stub":{"id":"1060","section":"6. US Route 15/501 Bridge to US Route 1 Bridge ","altname":"","river":"Deep","difficulty":"ItoII","states":["USA-NCR"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"1.46","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"110944","location":{"latitude":"35.577","longitude":"-79.1944"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"access","description":"A new access has been added to the Deep River that would be a good alternative Put In to avoid several miles of flat water or as a take out for those who prefer flat water and to not need to portage the Lockville Dam. The access has a concrete ramp to launch from, but parking is about 0.2 miles up the dirt road to where there is a pit toilet. A temporary loading/unloading point is just next to the ramp. This can also be used as an alternate take out for the Lower Rocky River.","id":"xrwGVytV0EskZLVEhThk8","location":{"latitude":"35.62817616","longitude":"-79.11941051"},"name":"Alternate Put In/Take Out - Moncure-Pittsboro Rd","distance":"5.91","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"116210","location":{"latitude":"35.6167","longitude":"-79.0912"},"name":"Take Out","distance":"7","photoID":null,"difficulty":"N/A","approximate":false},{"type":"hazard","description":"Scheduled to be removed in the near future to uncover what used to be known as Pullen's Falls (The Story of the Cape Fear and Deep River Navigation Company). Just before the breach river right, get out and head away from the bank where the slope going uphill is mellower to find a portage trail up near the quarry retention wall. If water is higher than 3.5 ft, you may want to get out at a small stream right before the dam warning sign, but it will likely be muddy. Continue down the trail till you reach a small valley and you can put in below the breached dam area.","id":"2906","location":{"latitude":"35.622391","longitude":"-79.098533"},"name":"Dam at Moncure (Pullen's Falls)","distance":"7.35","photoID":null,"difficulty":null,"approximate":false}],"alerts":[],"photos":[{"id":"17173","ext":"jpeg","post_id":"8563","description":"","caption":"Confluence of Rocky and Deep Rivers","poi_name":"","subject":"","author":"Michael Carter","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17173","large":"https://api.americanwhitewater.org/image/images/big/17173"}},{"id":"17177","ext":"jpeg","post_id":"8563","description":"There a couple hundred yards of rapids between the dam and US 1.  A good level to run these is at about 3-4' USGS.","caption":"Dam at Moncure","poi_name":"","subject":"","author":"Michael Carter","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17177","large":"https://api.americanwhitewater.org/image/images/big/17177"}},{"id":"i9WaUuEgbT8DAZhbBioin","ext":"jpg","post_id":"fEwT0ZD5MaReVmNbUqNZR","description":"","caption":"Breach at the dam (very large hole)","poi_name":null,"subject":"","author":"Zach Schiada","poi_id":null,"photo_date":"2025-04-12T19:03:05.000Z","updated_at":"2025-04-13T19:03:05.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/i9WaUuEgbT8DAZhbBioin","large":"https://api.americanwhitewater.org/image/images/big/i9WaUuEgbT8DAZhbBioin"}},{"id":"17174","ext":"jpeg","post_id":"8563","description":"","caption":"Confluence of Rocky and Deep Rivers","poi_name":"","subject":"","author":"Michael Carter","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17174","large":"https://api.americanwhitewater.org/image/images/big/17174"}},{"id":"17175","ext":"jpeg","post_id":"8563","description":"","caption":"Confluence Rapids","poi_name":"","subject":"","author":"Michael Carter","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17175","large":"https://api.americanwhitewater.org/image/images/big/17175"}},{"id":"17176","ext":"jpeg","post_id":"8563","description":"Larry decides to see how his boat performs as an Ice Breaker.  And yes, it was cold.","caption":"A real Ice Breaker","poi_name":"","subject":"Larry Ausley","author":"Michael Carter","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17176","large":"https://api.americanwhitewater.org/image/images/big/17176"}},{"id":"17178","ext":"jpeg","post_id":"8563","description":"About a foot higher and these rapids would be a great little park and play spot.  These are visible from US 1 a little north of Sanford.","caption":"Rapids past Moncure Dam","poi_name":"","subject":"","author":"Michael Carter","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/17178","large":"https://api.americanwhitewater.org/image/images/big/17178"}},{"id":"LEdE1hrCQzirXcU5lzwba","ext":"jpg","post_id":"fEwT0ZD5MaReVmNbUqNZR","description":"","caption":"River right below the dam","poi_name":null,"subject":"","author":"Zach Schiada","poi_id":null,"photo_date":"2025-04-12T19:03:05.000Z","updated_at":"2025-04-13T19:03:05.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/LEdE1hrCQzirXcU5lzwba","large":"https://api.americanwhitewater.org/image/images/big/LEdE1hrCQzirXcU5lzwba"}},{"id":"5GMR4iJEqASEPJbTVXexy","ext":"jpg","post_id":"fEwT0ZD5MaReVmNbUqNZR","description":"","caption":"Middle channel below the dam","poi_name":null,"subject":"","author":"Zach Schiada","poi_id":null,"photo_date":"2025-04-12T19:03:05.000Z","updated_at":"2025-04-13T19:03:05.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/5GMR4iJEqASEPJbTVXexy","large":"https://api.americanwhitewater.org/image/images/big/5GMR4iJEqASEPJbTVXexy"}}],"detail":{"id":"1060","permitUrl":null,"permitInfo":null,"description":"**Put-in:**\n\nUS 15-501 River right.\n\n**Take-out:**\n\nOld US 1 River right.\n\n**Description:**\n\nThis section of the Deep River is a beautiful, mostly flat paddle. There are three sets of rapids along the way. The scenery is very nice, with little signs of civilization anywhere. This section is less than 30 minutes from Raleigh. The rapids below the dam would make a nice park and play spot. The center and river right lines have the best ride. The only difficulty is the portage around the Dam at Moncure. River right is steep and river left is not easy. Suggest using ropes to aid in the portage, especially river right. A great dry, cold weather paddle for beginners and novices.\n\nUpdate on Dam Portage: It used to be much harder to portage the Lockville Dam. Now you can follow a trail that goes uphill close to the Rock Quarry retention wall. Follow the trail to a small valley to put in just below the dam. At levels over 2 ft on the gage, this is followed by the best rapids of the run, class II with some wave trains, small ledges and a good roll practice spot right near the take out on the last rapid. You can then choose US1 on a small pull off for the take out if you eddy right into a small cove at the last rapid. Follow the trail to the take out. This is an easier take out than the Old US 1 take out, which is steep and adds a short section of flat water. The dam is scheduled to be removed in the future, but no date is set for it's removal.","averageGradient":"2","maxGradient":null,"length":"7.9","correlations":[{"reachID":"1060","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":"Barely Scraping, routes difficult to find","lowRunnableRangeComment":null,"mediumRunnableRangeComment":"Rapids below the dam become fun","highRunnableRangeComment":"Stay left side of river right channel to avoid holes.","aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":"IIplusstandoutIII","beginLowRunnable":"1.9","beginMediumRunnable":"2.5","beginHighRunnable":"3.5","endHighRunnable":"6"},"gaugeInfo":{"name":"DEEP RIVER AT MONCURE, NC","gaugeSource":"USGS","gaugeSourceIdentifier":"02102000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"155","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.46","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"35.62694444","longitude":"-79.1161111"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/02102000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/02102000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"1.46","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null}}],"pointOfInterestIDs":["110944","xrwGVytV0EskZLVEhThk8","116210","2906"],"geometry":{"type":"LineString","coordinates":[[-79.194722,35.578135],[-79.19419,35.578285],[-79.193356,35.578521],[-79.192474,35.578775],[-79.191652,35.578894],[-79.190172,35.57902],[-79.189252,35.579032],[-79.188547,35.579178],[-79.188017,35.579323],[-79.187371,35.579589],[-79.186783,35.579866],[-79.186322,35.580157],[-79.185946,35.58048],[-79.185626,35.580984],[-79.185286,35.581635],[-79.184804,35.582861],[-79.184468,35.583396],[-79.184211,35.583752],[-79.183728,35.584188],[-79.18313,35.584667],[-79.182326,35.585152],[-79.181827,35.585522],[-79.181408,35.585865],[-79.180539,35.586525],[-79.179508,35.587304],[-79.179076,35.587773],[-79.178966,35.587936],[-79.177114,35.589553],[-79.176345,35.590157],[-79.17445,35.