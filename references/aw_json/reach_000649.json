[{"result":{"data":{"json":{"id":"649","stub":{"id":"649","section":"Upper road end 11.2 mi to Jordan Creek, 15.6 mi to Salmon R.","altname":"","river":"Salmon, Yankee Fork","difficulty":"IIItoIV","states":["USA-IDA"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"1120","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"111792","location":{"latitude":"44.4913902282715","longitude":"-114.552780151367"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"117064","location":{"latitude":"44.2730560302734","longitude":"-114.744453430176"},"name":"Take Out","distance":"26.8","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"fKaA2L3qvE5YMTIrOz06t","ext":"jpg","post_id":"qDPNdWi0jsu2NroOFTfYf","description":"Approximately 350m upstream of confluence.","caption":"Logjam","poi_name":null,"subject":"","author":"","poi_id":null,"photo_date":"2022-05-29T04:22:36.000Z","updated_at":"2022-05-29T04:22:36.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/fKaA2L3qvE5YMTIrOz06t","large":"https://api.americanwhitewater.org/image/images/big/fKaA2L3qvE5YMTIrOz06t"}},{"id":"888970","ext":"jpeg","post_id":"891617","description":"","caption":"Lower Yankee Fork Rapids","poi_name":"","subject":"","author":"Kevin Colburn","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888970","large":"https://api.americanwhitewater.org/image/images/big/888970"}},{"id":"888969","ext":"jpeg","post_id":"891617","description":"","caption":"Roadside Yankee Fork","poi_name":"","subject":"","author":"Kevin Colburn","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888969","large":"https://api.americanwhitewater.org/image/images/big/888969"}}],"detail":{"id":"649","permitUrl":"","permitInfo":"","description":"The last 2-3 miles of the Yankee Fork offer paddlers a fun roadside class III+ or IV+ romp depending on the level. It is some of the most accessible creek boating in the area, though feels more like a small river than a creek. It is all scoutable from the road. The rapids are boulder gardens at low flows and wave trains at high flows, and the creek stays runnable at a wide range of flows.\n\nMost whitewater paddlers will want to put in at the first road bridge over the creek and paddle the last 2 miles of the Yankee Fork. There is another mile of good warm up that you can add. Above that are many miles of floatable and mellow creek. You can take out before the Salmon or keep paddling to continue on downstream through the remainder of the fun Class III Sunbeam Section of the Salmon. Check this one out on your way to an early season Middle Fork Salmon trip, and don't miss the historical sites at Sunbeam Dam and further up the Yankee Fork.\n\nLat/Longitude data are _very_ approximate.","averageGradient":null,"maxGradient":null,"length":"23","correlations":[{"reachID":"649","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"400","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"3500"},"gaugeInfo":{"name":"YANKEE FORK SALMON RIVER NR CLAYTON ID","gaugeSource":"USGS","gaugeSourceIdentifier":"13296000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"1120","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"9.48","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"44.27888889","longitude":"-114.7