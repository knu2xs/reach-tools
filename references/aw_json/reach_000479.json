[{"result":{"data":{"json":{"id":"479","stub":{"id":"479","section":"Chicken Coop Gap to East Cowpen Road - Upper","altname":"Upper Conasauga","river":"Conasauga","difficulty":"IIItoIV","states":["USA-GEO"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"44","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"109128","location":{"latitude":"34.9261016845703","longitude":"-84.6412963867188"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"other","description":"Park anywhere along this straight, level section of road that parallels the river (albeit way high above the river) along the ridge.. The trailhead is inconspicuous. Look for it near the curve at the north end of the straight stretch.","id":"jmn4F5ozANBrlCRQbgZJ5","location":{"latitude":"34.9251","longitude":"-84.6429"},"name":"Put-in parking","distance":"0.01","photoID":null,"difficulty":"N/A","approximate":false},{"type":"rapid","description":"Ledge drop. Multiple routes depending on water levels and wood.","id":"740","location":{"latitude":"0","longitude":"0"},"name":"First Ledge","distance":"2.5","difficulty":"III","approximate":false,"photoID":"3027"},{"type":"rapid","description":"A big S-turn rapid. The holes at the bottom can get large.","id":"741","location":{"latitude":"34.942844","longitude":"-84.649827"},"name":"Third set of ledges (aka Three Ledges)","distance":"3.19","difficulty":"III+","approximate":false,"photoID":"3028"},{"type":"rapid","description":"Slide high on the rock shelf to stay out of the undercut.","id":"737","location":{"latitude":"34.9455","longitude":"-84.652405"},"name":"Room of Doom","distance":"3.55","difficulty":"IV","approximate":false,"photoID":"3029"},{"type":"rapid","description":"Drive left around the big roostertail floom of water. Or portage on the right.","id":"738","location":{"latitude":"34.94689","longitude":"-84.652743"},"name":"Whale Tail","distance":"3.65","difficulty":"IV","approximate":false,"photoID":"3031"},{"type":"rapid","description":"AKA Pinball, is a few hundred yards below Whale Tail. It is recognized by a house-sized boulder on river left which is undercut. When entering this rapid stay away from the top of that large boulder. It appears to have an eddy above it but it funnels into a bad sieve. This one is best run by starting top right, then hitting the boof on the right side. Avoid the pinning rock in the bottom middle. Portage on the right.","id":"739","location":{"latitude":"34.948693","longitude":"-84.656473"},"name":"Last big rapid  aka Pinball","distance":"3.96","difficulty":"IV","approximate":false,"photoID":"879"},{"type":"takeout","description":"Public land is on the downstream side of the bridge. Upstream of the bridge is private property.","id":"114365","location":{"latitude":"34.974543","longitude":"-84.645027"},"name":"Take Out","distance":"7.42","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"89j1IKMwuJwBc1MS9UsaW","title":"New property owner","post_date":"2026-03-16 12:46:32+00","detail":"Be on alert for potential access threat. In 2025, an LLC investor bought the property located between the last rapid and the take-out bridge (the property that includes the old take-out where the river gets close to Old Hwy 2) changed hands. The river goes through this property, making access precarious.","user":{"name":"Tom Welander"}}],"photos":[{"id":"3031","ext":"jpeg","post_id":"1332","description":"Whale tail is the major drop on the conasauga.  Seen from above a midstream rock kicks up a 8 foot floom of water in a half crescent shape.  The move is to bust right to left around the the floom, but not get caught in the guard eddy beside it.  Portage right.","caption":"Whale Tail  aka Tombstone","poi_name":"Whale Tail","subject":"Rob Maxwell","author":"Brad Roberts","poi_id":"738","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3031","large":"https://api.americanwhitewater.org/image/images/big/3031"}},{"id":"880438","ext":"jpeg","post_id":"881558","description":"Pinball @ .4\" on the bridge gauge, Ran right down the center.  This is the rapid with the  sieves at the top on the River left eddy.  You see the water coming through the bottom.  1-27-2012","caption":"Pinball","poi_name":"Pinball","subject":"Jason Harris","author":"Jason Harris","poi_id":"737","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880438","large":"https://api.americanwhitewater.org/image/images/big/880438"}},{"id":"880440","ext":"jpeg","post_id":"881560","description":"Here is a sneak line for Room of Doom.  Run on far river left.  Level was 4\" on the bridge gauge..1-27-2012","caption":"Room of Doom","poi_name":"Room of Doom","subject":"Jason Harris","author":"Jason Harris","poi_id":"737","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880440","large":"https://api.americanwhitewater.org/image/images/big/880440"}},{"id":"3028","ext":"jpeg","post_id":"1332","description":"","caption":"Third good Conasauga rapid","poi_name":"","subject":"","author":"Brad Roberts","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3028","large":"https://api.americanwhitewater.org/image/images/big/3028"}},{"id":"3027","ext":"jpeg","post_id":"1333","description":"First big ledge.  Multiple routes available.","caption":"First ledge on Conasauga","poi_name":"","subject":"","author":"Brad Roberts","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3027","large":"https://api.americanwhitewater.org/image/images/big/3027"}},{"id":"9398","ext":"jpeg","post_id":"5668","description":"For years, or should I say decades, the \"Elbow Tree\" has been the way to gage if the Conasauga is running. Well, it died, rotted and fell into the river. This is whats left. Now the official gage is the East Cowpen Road Bridge gage. Located 2 miles downstream. 3\" is probably minimum for this section of the Conasauga.","caption":"(RM) Dead Elbow Tree","poi_name":"","subject":"Elbow Tree","author":"Rob Maxwell","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/9398","large":"https://api.americanwhitewater.org/image/images/big/9398"}},{"id":"3046","ext":"jpeg","post_id":"4004","description":"","caption":"a drop on the Upper Conasauga","poi_name":"unknown","subject":"Spanker","author":"Chris Hohol","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3046","large":"https://api.americanwhitewater.org/image/images/big/3046"}},{"id":"879","ext":"jpeg","post_id":"2429","description":"","caption":"Conasauga","poi_name":"","subject":"Ken Strickland","author":"Lee Wheeler","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/879","large":"https://api.americanwhitewater.org/image/images/big/879"}},{"id":"3047","ext":"jpeg","post_id":"4004","description":"Creeking in an \"Ego\"....nor recommended.","caption":"Hohol on the Conasauga","poi_name":"unknown","subject":"Hohol","author":"Spanker","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3047","large":"https://api.americanwhitewater.org/image/images/big/3047"}},{"id":"3030","ext":"jpeg","post_id":"1332","description":"This is what getting stuffed into an undercut looks like","caption":"Room of Doom - Bad Line","poi_name":"Room of Doom","subject":"","author":"Brad Roberts","poi_id":"737","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3030","large":"https://api.americanwhitewater.org/image/images/big/3030"}},{"id":"3029","ext":"jpeg","post_id":"1332","description":"This is a good line thru Room of Doom.  Beware the undercut on river right.  Also be careful of the re-bar around this rapid.","caption":"Room of Doom","poi_name":"Room of Doom","subject":"Simon Bishop","author":"Brad Roberts","poi_id":"737","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3029","large":"https://api.americanwhitewater.org/image/images/big/3029"}},{"id":"9397","ext":"jpeg","post_id":"5668","description":"The East Cowpen Road Bridge Gage is 2 miles downstream of the take-out. Located on the upstream river left side of the bridge. 4\" is probably minimum. At 7\" it was medium-low.","caption":"(RM) East Cowpen Road Bridge Gage","poi_name":"East Cowpen Road Bridge Gage","subject":"East Cowpen Road Bridge Gage ","author":"Rob Maxwell","poi_id":"739","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/9397","large":"https://api.americanwhitewater.org/image/images/big/9397"}},{"id":"880439","ext":"jpeg","post_id":"881559","description":"The bottom portion of Pinball,  A couple a rocks in the middle give this rapid it's good name.","caption":"Pinball","poi_name":"Pinball","subject":"Jason Harris","author":"Jason Harris","poi_id":"737","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880439","large":"https://api.americanwhitewater.org/image/images/big/880439"}}],"detail":{"id":"479","permitUrl":null,"permitInfo":null,"description":"Northern Georgia Canoeing, Sehlinger, B. and Otey, D.\n\nAppalachian Whitewater: The Southern States\n\n**Put In for Upper** **Consauaga**: Finding the put-in is the hard part. From the take-out drive up West Cowpen Road to Chicken Coop Gap. For lack of a better description, go about four miles up West Cowpen, then look for a turnout on the left. You should be able to just barely see the river at the bottom of the hill if there are no leaves on the trees some 250 vertical feet below.\n\nFrom there carefully carry your boat (or lower it on a short leash) down a shale and mud covered steep incline (borderline cliff) to the river.\n\nGradient by mile: 91, 56, 56, 128, 66, 40 ft/mi. .\n\nThe first few miles after the Chicken Coop Gap put-in offer a nice warm-up leading up to the major rapids. The four big drops, all located in that steep (128 ft/mi) fourth mile, are IIIs and IVs. The most difficult are Undercut (aka Room of Doom) and Whale Tail. They will be obvious, especially Whale Tail with its impressive roostertail of water.\n\nKeep an eye out for wood in all of the major drops. Another thing to watch out for is rebar in the drops. About 100 years ago this area was extensively logged and the rebar is leftover from the logging.\n\nThe Upper Conasauga is a beautiful wilderness run. People have put on higher than Chicken Coop Gap and report that it is a great run, though it does require quite a bit of work to get to the river.\n\n*Directions to the Upper Upper put-in from Boatertalk:*\n\n*'I don't remember the exact mileage, but from the take-out. Go back in the direction that you came in, take the first left up a steep hill. At the fork stay right, when the road T's, go left. This will dead end @ a trail head. It is probably a 20 minute hike downhill to the creek. Total driving distance is probably 8-10 miles. There is section below the put-in with class III - IV fun, it's all read &amp; run same as the lower part. Hope that this helps.'*\n\n**Directions:** From Atlanta take I-75 north to Highway 411 north. Continue north on Hwy 411 thru Chatsworth, Ga. to Cisco. In Cisco look for the Cisco Baptist Church. It's a stone church on the east side of the road at the intersection of Hwy 411 and Old Ga. Hwy 2, which turns into East Cowpen Road. Go east on East Cowpen Road into the Cohutta wilderness for about 7 miles.\n\n**Take Out for the Upper Conasauga**: The Conasauga take-out is NO LONGER the first major stream on the right as you come thru the mountains and the Alaculsy Valley opens up. Take out at the Old Hwy 2 Bridge to avoid landowner issues and make sure to park on the USFS land downstream side of the bridge, not on private property on the upstream side.\n\nOn the way to the take-out you will pass a game checking station. The game checking station is where West Cowpen Road intersects with East Cowpen Road. Using a good topo-map, a compass, and a GPS, you should be able to find Chicken Coop Gap on West Cowpen Road.\n\n*From Boatertalk (Nov 27 2001):*\n\n*'If you get on GA Hwy 2 east follow it all the way until you get to Hwy 411 intersection...there will be a gas station on your right and a church kind of in front of you and to the left...you are now in Cisco...drive straight across the intersection and go exactly 3.2 miles...you will see a guard station on your left....the take-out with the crooked tree is down the road past the guard station...just a little ways after the little wooden bridge (look for small creek on river left)....from the guard station go up the road to your right exactly 5.8 miles to the put-in...listen for water...there will be a 4-wheeler type trail behind you on the left and a sign that says no motor vehicles....then bring your rope because you are going down a steep freakin put-in....go straight down(don't go to right when trail looks like it goes that way)...don't carry your boat...bring a rope.... water is straight down there....Yes, I call that one undercut rapid(room of doom)....and Yeah Whale Tail is good to go... use gauge at Eaton, GA for Conasauga....but it drops fast and sometimes by the time that water gets to that gauge, it's already gone from the gorge....if the water table is up and we get a good rain, then get there early for a good level.*\n\n*peace,*\n\n*Jamie Smith'*","averageGradient":"80","maxGradient":"180","length":"7.4","correlations":[{"reachID":"479","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"300","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"2000"},"gaugeInfo":{"name":"HOLLY CREEK NEAR CHATSWORTH, GA","gaugeSource":"USGS","gaugeSourceIdentifier":"02385800","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"44","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.77","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"34.71675","longitude":"-84.77025"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/02385800","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/02385800/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"44","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["109128","jmn4F5ozANBrlCRQbgZJ5","740","741","737","738","739","114365"],"geometry":{"type":"LineString","coordinates":[[-84.64139,34.924897],[-84.641386,34.925024],[-84.641333,34.92512],[-84.641225,34.925226],[-84.64115,34.92527],[-84.641043,34.925331],[-84.640732,34.925446],[-84.640378,34.925604],[-84.640378,34.925604],[-84.640131,34.925727],[-84.639884,34.925921],[-84.639659,34.926229],[-84.639605,34.926361],[-84.639509,34.926853],[-84.639474,34.927219],[-84.639465,34.927218],[-84.639436,34.927522],[-84.63943,34.927557],[-84.639409,34.927625],[-84.639396,34.927659],[-84.639359,34.927724],[-84.639339,34.927754],[-84.639312,34.927782],[-84.