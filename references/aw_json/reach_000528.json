[{"result":{"data":{"json":{"id":"528","stub":{"id":"528","section":"Trail Creek Bridge to Cedar Creek (near Aldridge)","altname":"Wolverine Canyon","river":"Blackfoot","difficulty":"IVtoV","states":["USA-IDA"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":"The easiest parking and put ins, appear to be off a spur just upstream of this bridge or at the campground entrance just downstream.  All river miles for listed rapids are from this bridge as measured with Google Earth.","id":"101979","location":{"latitude":"0","longitude":"0"},"name":"Trail Creek Rd bridge","distance":"0","photoID":"0","difficulty":"N/A","approximate":false},{"type":"access","description":"A side road drops down to the river from Blackfoot River Road.","id":"101965","location":{"latitude":"43.13916778564453","longitude":"-111.92698669433594"},"name":"Possible Access","distance":"1.1","photoID":"0","difficulty":"N/A","approximate":false},{"type":"access","description":"A side road leads to the top of the bluff.  Trails may lead to the river.","id":"101966","location":{"latitude":"43.144615173339844","longitude":"-111.93303680419922"},"name":"Possible Access","distance":"1.7","photoID":"0","difficulty":"N/A","approximate":false},{"type":"hazard","description":"The river narrows and drops into one of the biggest rapids on the run.  The channel widens in the lower part of the rapid but it is cluttered with large boulders and logs which have jammed on those boulders.  Elevation at start, 5230 feet.","id":"101972","location":{"latitude":"43.16859817504883","longitude":"-111.9749984741211"},"name":"Teller Tube","distance":"5.31","photoID":"1437","difficulty":"V","approximate":false},{"type":"takeout","description":"The river bends northeast to go around a promontory across from Cedar Creek.  The first rapid is a narrow, straight chute leading into flat water of a horseshoe bend. This rapid is about 80 yards long.","id":"101977","location":{"latitude":"43.207401275634766","longitude":"-112.01300048828125"},"name":"Narrow Rapid","distance":"9.9","photoID":"0","difficulty":"IV","approximate":false},{"type":"takeout","description":"Cedar Creek comes in from river right at a horseshoe bend.   A fairly easy rapid, starts at the mouth of Cedar Creek and leads out of the horseshoe bend.\n\nIf you take out here, beach on the upstream side of Cedar Creek, above the rapid.  Carry up the creek a very short distance, cross the creek, then follow use trails up a steep hill to Blackfoot River Road.\n\nElevation at the river is 4796 feet, while the road side parking elevation is about 4970 feet.","id":"101978","location":{"latitude":"0","longitude":"0"},"name":"Cedar Creek Rapid","distance":"10.08","photoID":"0","difficulty":"III","approximate":false},{"type":"access","description":"A steep road or trail drops down the cliff to near the river.\n\nThe river is flat and meandering in this section, but it appears to be swift with plenty of waves.","id":"101981","location":{"latitude":"43.217750549316406","longitude":"-112.02591705322266"},"name":"Possible Access","distance":"11.73","photoID":"0","difficulty":"N/A","approximate":false},{"type":"access","description":"A well used spur road drops down to the river.","id":"101980","location":{"latitude":"43.232696533203125","longitude":"-112.02467346191406"},"name":"Possible Access","distance":"13.66","photoID":"0","difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"1436","ext":"jpeg","post_id":"3952","description":"This was the fourth portage of the day. It has supposedly been run.","caption":"Gnarly Sieve of Death","poi_name":"?","subject":"Sieve - Portage","author":"Dave Garrity","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1436","large":"https://api.americanwhitewater.org/image/images/big/1436"}},{"id":"1406","ext":"jpeg","post_id":"2436","description":"This was the fourth portage of the day. It has supposedly been run.","caption":"Gnarly Sieve of Death","poi_name":"?","subject":"Sieve - Portage","author":"Dave Garrity","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1406","large":"https://api.americanwhitewater.org/image/images/big/1406"}},{"id":"1429","ext":"jpeg","post_id":"3954","description":"Last rapid before the sieve. At higher water it looks a lot like El Horrendo on the Russell Fork, but with less margin for error and a nasty drop downstream.","caption":"Fourth major rapid","poi_name":"?","subject":"Dave Garrity","author":"Nick Bugenski","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1429","large":"https://api.americanwhitewater.org/image/images/big/1429"}},{"id":"1437","ext":"jpeg","post_id":"3953","description":"","caption":"First Big Rapid","poi_name":"? - First major drop","subject":"","author":"Dave Garrity","poi_id":"101967","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1437","large":"https://api.americanwhitewater.org/image/images/big/1437"}},{"id":"1435","ext":"jpeg","post_id":"3952","description":"This was the first portage of the day.","caption":"First big drop - top part","poi_name":"not known","subject":"First major rapid in canyon","author":"Dave Garrity","poi_id":"101967","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/1435","large":"https://api.americanwhitewater.org/image/images/big/1435"}},{"id":"893173","ext":"jpg","post_id":"896830","description":null,"caption":null,"poi_name":"Portage","subject":null,"author":null,"poi_id":"101979","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/893173","large":"https://api.americanwhitewater.org/image/images/big/893173"}},{"id":"893174","ext":"jpg","post_id":"896831","description":null,"caption":null,"poi_name":"Teller Tube","subject":null,"author":null,"poi_id":"101972","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/893174","large":"https://api.americanwhitewater.org/image/images/big/893174"}}],"detail":{"id":"528","permitUrl":"","permitInfo":"","description":"Wolverine Canyon is Southeast Idaho's premier Class V canyon. Generally runnable after most other class V sections are finished, irrigation needs allow the blackfoot to run later with warmer water than is typical, which in the heat of summer can be a bit much. I've ran this section down to 450cfs which was getting pretty boney, things can get spicey as the flows near 1000cfs. This run is fairly notorious for the dense jungle of  Poison Ivy that lines the banks in many areas, making scouting and portaging a real treat. Accessing this run from some routes requires you to cross Sho-Ban Reservation land, please be considerate and treat their land with the respect they deserve. The river mostly flows through BLM property for the first few miles.  When the BLM property ends, the river right bank is private property, while river left is Fort Hall Indian reservation property.\n\nThe River:\n\nThe stretch begins with a long section of meandering class II developing into class III for some miles, Moose have been known to enjoy this area so keep your eyes peeled. When you near the end of the calm before the storm, remain on your toes as the river gorge tightens and a good size pool marks the beginning of the whitewater, and time to scout.\n\nThe first main rapid, Teller Tube kicks of the excitement and is generally scouted and portaged on river right. A ledge drop leads into a flume that is punctuated by V waves and small holes, as the river passes the large boulder a quick eddy must be caught to avoid following the flow into a generally log choked constriction that has been the sight of past accidents, one fatal and quite a few near misses. So be on your toes and make your decision wisely.\n\nA fun section of more frequent class IV rapids eventually lead into what is sometimes called the Airplane Boof. This rapid is marked by a set of boulders at the horizon line with an entrance on river right. There are a few options for running this rapid, a shallower ledge on river right, the airplane boof in the middle, and the slot on river left, which is sometimes clogged with wood.\n\nSome more class III - IV rapids lead to the beginning sequence to the portage drop or \"Sieve Drop\".  A steeper and enjoyable flume drop is located directly above the Portage, be careful of what lies below! The \"Sieve\" is generally portaged on river right and requires a bit of a poison ivy safari. After the portage a fun section of fast moving class IV finishes of the run.\n\n------\n\n**Put in:**  Trail Creek Road Bridge.  There appears to be some parking and easy access to the river at the bridge or close by.  BLM has a primitive campground just downstream on river right.  There also appears to be access at 1 mile downstream and at 1.7 miles downstream.\n\n**Take out:**  It looks like there is a steep hike out at Cedar Creek, otherwise boaters must continue on down through slow water to road access at mile 12 or mile 13.\n\n\\-\\-\\----\n\nthis page is a work in progress!\n\n\\- edited by:\n\nDavis Gove June 2020\n\n\\-\\-\\----\n\n**Other Information Sources:**\n\n[BLM Blackfoot River Campgrounds](http://www.blm.gov/id/st/en/fo/pocatello/recreation_sites_/cutthroat_trout_recreation.html)\n\nFlow information phone number -208-238-0586","averageGradient":"74","maxGradient":"120","length":"10","correlations":[{"reachID":"528","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"400","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"1200"},"gaugeInfo":{"name":"Blackfoot Near Shelley","gaugeSource":"DREAM","gaugeSourceIdentifier":"512","gaugeFetchStatus":"ARCHIVED","latestFlowReading":null,"latestStageReading":null,"location":{"latitude":"30","longitude":"30"},"externalSourceLinks":{"sourceLink":{"url":"https://www.dreamflows.com/graphs/day.512.php","text":"Dream Flows"}}},"migrationErrorExplanation":"Previous Flowbands: \nRange of Boatable Flows (R0-R9): 400 - 1200 cfs  Comment: Actual range is likely different.\n\nMigration Errors: \nSingle range is valid but doesn't provide low/medium/high runnable\nThere is one comment for all of low/medium/high runnable.","comment":null,"status":null}],"pointOfInterestIDs":["101979","101965","101966","101972","101977","101978","101981","101980"],"geometry":{"type":"LineString","coordinates":[[-111.91091929266709,43.12952757700115],[-111.91102407006537,43.12947853305445],[-111.9111454033985,43.129398933054574],[-111.91154700339786,43.12975639972069],[-111.91200760339717,43.13045139971962],[-111.91266280339613,43.13160579971782],[-111.913161270062,43.13238133304998],[-111.91335420339504,43.132571799716345],[-111.91467580339304,43.13385379971436],[-111.91502927005911,43.13410019971394],[-111.91537340339192,43.13423779971373],[-111.9163022033905,43.13447739971338],[-111.917032870056,43.134555933046556],[-111.91855740338701,43.13452859971329],[-111.91951447005215,43.134373933046845],[-111.91985647005163,43.13438979971352],[-111.92101087004983,43.134859733046085],[-111.92153807004905,43.13519013304557],[-111.92317060337984,43.13625733304394],[-111.92341260337946,43.1365261330435],[-111.92377427004556,43.136816933043065],[-111.92465240337754,43.13727853304238],[-111.92568187004258,43.13799833304125],[-111.92679207004085,43.13859213304033],[-111.92803180337228,43.13981333303843],[-111.92832007003854,43.14014399970455],[-111.92880120337111,43.1405497330373],[-111.929347870