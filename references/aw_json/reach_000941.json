[{"result":{"data":{"json":{"id":"941","stub":{"id":"941","section":"Trowbridge Road to Indian River (up to 20.5 miles)","altname":"","river":"Sturgeon (Cheboygan)","difficulty":"ItoII","states":["USA-MCH"]},"primaryGaugeStatus":{"status":"medium-runnable","latestReading":{"value":"262","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"108145","location":{"latitude":"45.2169990539551","longitude":"-84.5699996948242"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"access","description":"A covered bridge could provide scenic access for a slightly longer trip. It appears (from satellite views) that the extra distance should be quite similar to the entire listed segment. It also appears that what GoogleMaps shows as 'roads' in this area appears to be doubletrack, and may be private lanes.","id":"105776","location":{"latitude":"45.21699905395508","longitude":"-84.56999969482422"},"name":"Possible Put-in?","distance":"0","photoID":"0","difficulty":"N/A","approximate":false},{"type":"access","description":"From satellite view, there appears to be a dead-end stub of Cornwell Grade Road with (likely) good parking and great river access which could be used as an alternate put-in.","id":"105777","location":{"latitude":"45.220001220703125","longitude":"-84.58499908447266"},"name":"Alternate Put-in #1","distance":"0.9","photoID":"0","difficulty":"N/A","approximate":false},{"type":"access","description":"Another alternate access point may be Trowbridge Road. The North Central State Trail runs right alongside this road, and would provide a great bike shuttle route!","id":"105778","location":{"latitude":"45.22200012207031","longitude":"-84.58799743652344"},"name":"Trowbridge Road","distance":"1.22","photoID":"0","difficulty":"N/A","approximate":false},{"type":"access","description":"Another crossing with Trowbridge Road (and the North Central State Trail) could be used as a put-in to cut 2.2 miles off the trip.","id":"105780","location":{"latitude":"45.231998443603516","longitude":"-84.58799743652344"},"name":"Trowbridge Road","distance":"2.2","photoID":"0","difficulty":"N/A","approximate":false},{"type":"access","description":"Interesting name (as listed on Google) for what appears to be a double-track with a wooden-plank bridge. FWIW, a \"Silent Sport Lodge River Cottage\" on the river at this location provides a cottage and/or B&B (bed and breakfast) for people who wish to vacation and enjoy the bike trail and river (for fishing and/or paddling).","id":"105781","location":{"latitude":"45.23099899291992","longitude":"-84.58899688720703"},"name":"Freeway Trail","distance":"2.62","photoID":"0","difficulty":"N/A","approximate":false},{"type":"access","description":"The confluence with the W.Branch is (by reports) the location of a park and perhaps the best (or only?) playable whitewater features on the run. Good access allows PnP (Park and Play) or put-in for shortened trip from here down to Indian River.\n\nThe following video shows (at least parts of) a trip with canoe and recreational/touring kayaks from near this location down to our listed take-out:","id":"105775","location":{"latitude":"45.271999","longitude":"-84.600998"},"name":"Confluence with West Branch","distance":"5.96","photoID":"0","difficulty":"N/A","approximate":false},{"type":"access","description":"Aerial/satellite views appear to show a short stub road to a cleared area which would allow parking and access (either take-out or put-in).","id":"105787","location":{"latitude":"45.28900146484375","longitude":"-84.60299682617188"},"name":"Possible Access","distance":"7.53","photoID":"0","difficulty":"N/A","approximate":false},{"type":"access","description":"It appears there is parking and access available here.","id":"105797","location":{"latitude":"45.38999938964844","longitude":"-84.61699676513672"},"name":"Fisher Woods Road","distance":"19.13","photoID":"0","difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"113387","location":{"latitude":"45.4029998779297","longitude":"-84.6119995117188"},"name":"Take Out","distance":"20.5","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"101254718","title":null,"post_date":"2020-05-07 04:00:00+00","detail":"NO 'hyperbole', THE 'Fastest WW River in the Lower Penninsula'. Take it for granted at high water and you may pay with your life. If not sure what level you're observing, call a Guide. I didn't know and was saved by the Grace of God through Jamie (happened along) www.sturgeonriverpaddle.com and persuaded me not to go. I assure you, I was 'Saved'.\nDoug Tally\nDetroit\ndougtally@gmail.com","user":{"name":"Douglas Tally"}}],"photos":[{"id":"12821","ext":"jpeg","post_id":"8707","description":"This wave is always fun.  It's right in the park in Wolverine.  If you start your trip at either park in Wolverine, you'll encounter it within 5 minutes of dropping in.","caption":"Adam and Standing Wave","poi_name":"Standing Wave In Wolverine","subject":"Standing Wave In Wolverine","author":"Bob Santimo","poi_id":"105782","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/12821","large":"https://api.americanwhitewater.org/image/images/big/12821"}}],"detail":{"id":"941","permitUrl":"","permitInfo":"","description":"Not far beyond our listed take-out, this Sturgeon River (one of many such named rivers in Michigan and beyond) flows into Burt Lake, the outflow from which becomes the Indian River, which almost immediately flows into Mullet Lake. The outflow from that becomes the Cheboygan River, flowing out to the South Channel of the Straits of Mackinac, just East of the Mackinac Bridge. The Sturgeon is a Blue Ribbon trout stream, and is said to be (likely only for marketing hyperbole)\"the fastest flowing river in Michigan's lower Peninsula\".\n\nAdam Vollmar contributes (2005-11-27):\n\n_When the river is high, which it often is, this stretch can be the most fun in the Lower Penninsula._\n\n_There are two parks in Wolverine. The one further to the south with swingsets is right where the two branches come together. There's a standing wave at the first park. I've done this stretch a lot and high or low water, it's always there (in high water there's a few others, none will compare to the first however). If you have someone else with you, there's a lookout right next to it. You can drive your car right up to it. I've done this stretch several times and recommend starting at the first park in Wolverine with swing sets and a bathroom and taking out at Indian River. There is great parking in the back area of the McDonalds parking lot and your car will be in view from the river._\n\n John Lee writes (2005-05-26 15:23:23): _\"Fastest flow in (lower) Michigan. Clean, scenic and sandy bottom. Perfect for novice.\"_![](/photos/archive/12821thumb.jpg)","averageGradient":"12","maxGradient":"0","length":"18.8","correlations":[{"reachID":"941","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":"Likely too low for any true whitewater.","lowRunnableRangeComment":"Likely tame whitewater.","mediumRunnableRangeComment":"Likely good flows.","highRunnableRangeComment":"400 - 800 cfs Likely moderate-to-higher flow. *** 800 - 1200 cfs Unusually high flow.","aboveRecommendedRangeComment":"(Near) Record flows. *Please leave a 'Trip Report' about gauge readings and your evaluation of difficulty/class and boatability.","lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"100","beginMediumRunnable":"250","beginHighRunnable":"500","endHighRunnable":"1200"},"gaugeInfo":{"name":"STURGEON RIVER AT WOLVERINE, MI","gaugeSource":"USGS","gaugeSourceIdentifier":"04127997","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"262","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.11","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"45.27445746","longitude":"-84.6000315"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/04127997","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/04127997/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":"Gauge (192 Sq.Mi. drainage) is at Wolverine, after confluence with W.Br., thus very accurate reflect flow at described wave.","status":{"status":"medium-runnable","latestReading":{"value":"262","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["108145","105776","105777","105778","105780","105781","105775","105787","105797","113387"],"geometry":{"type":"LineString","coordinates":[[-84.57001982469012,45.21740111842451],[-84.57008351250369,45.217397929813615],[-84.5718299791676,45.21701032981417],[-84.57280077916613,45.21630239648198],[-84.57357717916489,45.216005729815784],[-84.57441797916364,45.21591479648254],[-84.57496757916277,45.21596072981583],[-84.57661631249351,45.21646439648168],[-84.57726277915918,45.21660179648149],[-84.57765057915861,45.21689912981435],[-84.57771497915849,45.217036329814164],[-84.5780381124913,45.21731059648039],[-84.57832897915756,45.217402196480236],[-84.57900797915647,45.21751672981338],[-84.58065717915395,45.21763179647991],[-84.58098031248676,45.217837596479576],[-84.58120631248642,45.218203396479005],[-84.5816589124857,45.218317929812144],[-84.5823379791513,45.21824972981227],[-84.58246737915113,45.218181129812365],[-84.58324351248325,45.21813579647909],[-84.58356691248275,45.218227329812294],[-84.58489171248067,45.21916492981086],[-84.58508557914706,45.21934779647722],[-84.58505291248042,45.21991912980969],[-84.58479391248085,45.22028472980912],[-84.58479371248086,45.22053612980869],[-84.58527