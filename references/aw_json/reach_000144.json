[{"result":{"data":{"json":{"id":"144","stub":{"id":"144","section":"2. Kyburz to US 50 Bridge @ Riverton","altname":"Kyburz","river":"American, South Fork","difficulty":"IIItoV","states":["USA-CAL"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"740","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"108476","location":{"latitude":"38.7731018066406","longitude":"-120.292297363281"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"113713","location":{"latitude":"38.7710990905762","longitude":"-120.448303222656"},"name":"Take Out","distance":"9.6","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"101253571","title":null,"post_date":"2018-05-15 04:00:00+00","detail":"On a 5/9/18 evening run we cut a coiled stern line from our raft that was\ncaught in the first QBM (quality boof move) about 1 mile down from Indian\nFalls. The line is an old yellow and black climbing rope - please be aware!\n\nCarson Watts","user":{"name":"Theresa Lorejo-Simsiman"}}],"photos":[],"detail":{"id":"144","permitUrl":null,"permitInfo":null,"description":"2009 trip report by Neil Nikirk:\n\nJust ran the Kyburz section of the SFA for the first time last week. What a kick! It was running about 1100 cfs. Which while higher than most of the kayakers I joined had ever run it, was about the minimum I would want for a raft. I took the little cat and the comments from the kayakers before the run were: “you’ve never run it before? You’re gonna love it”; “well, you’ve got the craft to run the upper section”; and oh yeah “I’ve never seen a raft on here before.” So much for making me wonder what I was in for! We put in just below IndianFalls, a serious drop that has been run (not recommended) and boated about 6 miles. There is another 3 miles or so to the Peavine Road bridge with some good rapids I hear, but the climb out is pretty brutal for a raft.\n\nThe section we ran was well worth it. The first half mile or so was quite bony, just bouncing over a few rock gardens. After that, the river channel cleans up and the rapids get better. You can scout some of them from the highway. The series of rapids known as “the slide” was quite interesting. Individual good drops separated by moving water and short pools. A couple of must-make moves with minor consequences for not quite making the move. “Joe’s Garage” against a river left wall on a right corner was fun. You just didn’t want to spend much time in the “garage” so pulled right. “Kitty Litter” was just a fun slalom through some boulders. Below Kitty, the gradient lessens, the rapids drop off, and it’s an enjoyable float to the take-out.\n\nIn terms of difficulty, this run was comparable to the NF American (Chamberlains) at medium flows, but with longer rapids; a little easier than the Tuolumne\n\n. The beauty of this run for us here in Sac is that it’s less than an hours drive, shuttle is short and on the freeway, and the road is right there if anything goes wrong. The kayakers were right, I loved it. I also had a great craft for this river (13 foot cat). If I can, I’ll make sure they see a few more rafts or cats on this run in the future. For solid Class IV boaters, this is a great local run.\n\nNeil\n\n**Other Information Sources:** [CA Creeks](http://cacreeks.com/amer-skb.htm).\n\n[Dreamflows forum](http://dreamflows.com/forums/flowTopics.php?river=184&name=So.%20American%20-%20Below%20Kyburz)\n\n[Blog by CA49rivers](http://ca49rivers.blogspot.com/2006/07/sf-american-kyburz-iv_13.html)\n\nCassady & Calhoun, Holbek & Stanley, Martin, Penny","averageGradient":null,"maxGradient":null,"length":"9.8","correlations":[{"reachID":"144","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"600","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"3000"},"gaugeInfo":{"name":"So. American Below Kyburz","gaugeSource":"DREAM","gaugeSourceIdentifier":"184","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"740","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.87","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"30","longitude":"30"},"externalSourceLinks":{"sourceLink":{"url":"https://www.dreamflows.com/graphs/day.184.php","text":"Dream Flows"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"migration-runnable","latestReading":{"value":"740","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["108476","113713"],"geometry":{"type":"LineString","coordinates":[[-120.292613,38.772877],[-120.292712,38.772988],[-120.292788,38.773107],[-120.292886,38.773244],[-120.292929,38.773335],[-120.292961,38.773408],[-120.293004,38.773481],[-120.293035,38.773563],[-120.293078,38.773645],[-120.293122,38.773709],[-120.293166,38.773755],[-120.293188,38.773783],[-120.293245,38.773811],[-120.29329,38.77383],[-120.293347,38.77385],[-120.293462,38.773861],[-120.293611,38.773874],[-120.293841,38.773861],[-120.294094,38.773867],[-120.294405,38.773865],[-120.294557,38.773864],[-120.294574,38.773864],[-120.294751,38.773864],[-120.295062,38.773853],[-120.295361,38.773842],[-120.295438,38.77384],[-120.295453,38.77384],[-120.295649,38.773831],[-120.295938,38.773801],[-120.296099,38.773805],[-120.296294,38.773819],[-120.296409,38.773821],[-120.296501,38.773841],[-120.296604,38.773862],[-120.296706,38.773891],[-120.296808,38.77393],[-120.296944,38.773996],[-120.297023,38.774034],[-120.297124,38.77409],[-120.297227,38.774119],