 Miller","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/4714","large":"https://api.americanwhitewater.org/image/images/big/4714"}},{"id":"3018","ext":"jpeg","post_id":"5338","description":"","caption":"","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3018","large":"https://api.americanwhitewater.org/image/images/big/3018"}},{"id":"885383","ext":"jpeg","post_id":"888130","description":"This is the line just left of Hollywood.","caption":"3000cfs Hollywood Bowl","poi_name":"Hollywood Bowl","subject":"","author":"Brandon Beaty","poi_id":"1080","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/885383","large":"https://api.americanwhitewater.org/image/images/big/885383"}},{"id":"3023","ext":"jpeg","post_id":"5338","description":"To see the full-sized version of this photo, <a href=\"http://www.americanwhitewater.org/photos/?photoid=3018\">click here</a>.","caption":"","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3023","large":"https://api.americanwhitewater.org/image/images/big/3023"}},{"id":"885382","ext":"jpeg","post_id":"888129","description":"","caption":"3000cfs Coker Creek wave train","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/885382","large":"https://api.americanwhitewater.org/image/images/big/885382"}},{"id":"4774","ext":"jpeg","post_id":"1388","description":"","caption":"First Rapid, Drys","poi_name":"Hollywood Bowl(?)","subject":"Brad Roberts","author":"Kevin Miller","poi_id":"1096","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/4774","large":"https://api.americanwhitewater.org/image/images/big/4774"}},{"id":"4777","ext":"jpeg","post_id":"1388","description":"A long cool wavetrain with some great surfing.  Obviously the waves are big enough to nearly hide a 10 foot long open boat.","caption":"Wave train on the drys","poi_name":"Long Wave Train","subject":"Will Reeves","author":"Kevin Miller","poi_id":"1088","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/4777","large":"https://api.americanwhitewater.org/image/images/big/4777"}},{"id":"4713","ext":"jpeg","post_id":"4925","description":"This is why you should not put in at the Highway 68 bridge.","caption":"Hiawassee Dries - Trees","poi_name":"Trees","subject":"Will Reeves","author":"Kevin Miller","poi_id":"1090","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/4713","large":"https://api.americanwhitewater.org/image/images/big/4713"}},{"id":"888828","ext":"jpeg","post_id":"891475","description":"Beautiful bedrock","caption":"Wave Train","poi_name":"","subject":"Sam Evans","author":"Kevin Colburn","poi_id":null,"photo_date":"2018-02-23T15:09:06.000Z","updated_at":"2022-07-18T15:09:06.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888828","large":"https://api.americanwhitewater.org/image/images/big/888828"}},{"id":"885731","ext":"jpeg","post_id":"888516","description":"The last drop of Hollywood Bowl","caption":"Last drop of Hollywood Bowl","poi_name":"Hollywood Bowl","subject":"Justin Cullars","author":"Kemper Begley","poi_id":"1080","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/885731","large":"https://api.americanwhitewater.org/image/images/big/885731"}},{"id":"888832","ext":"jpeg","post_id":"891475","description":"The one looks kind of tree filled and sketchy from above, but is a nice series of corners with open lines. ","caption":"Tight corners","poi_name":"","subject":"Sam Evans","author":"Kevin Colburn","poi_id":null,"photo_date":"2018-02-23T15:09:06.000Z","updated_at":"2022-07-18T15:09:06.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888832","large":"https://api.americanwhitewater.org/image/images/big/888832"}},{"id":"POTJmj1DD1Je9VgnCu0ia","ext":"jpg","post_id":"kTIRJD0ZmA2gLwkGEnGLg","description":"The rock pictured in the top of this photo is the commonly run sliding drop on the far righthand side of the main channel. Often people end up paddling the crack if they don't get far enough right up onto the rock. Note that the slide rock and slot are undercut but especially note the nightmare pothole in the foreground (left side of drop).  ","caption":"Sieve Next to Hollywood Bowl Line","poi_name":null,"subject":"","author":"Kevin Colburn","poi_id":"1096","photo_date":"2019-10-14T17:44:24.000Z","updated_at":"2022-07-18T17:44:24.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/POTJmj1DD1Je9VgnCu0ia","large":"https://api.americanwhitewater.org/image/images/big/POTJmj1DD1Je9VgnCu0ia"}},{"id":"888825","ext":"jpeg","post_id":"891475","description":"","caption":"Top of Wu","poi_name":"Wu","subject":"","author":"Kevin Colburn","poi_id":null,"photo_date":"2018-02-23T15:09:05.000Z","updated_at":"2022-07-18T15:09:05.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888825","large":"https://api.americanwhitewater.org/image/images/big/888825"}},{"id":"bJAEiewZIJJ9yXg1gNPBo","ext":"jpg","post_id":"1uGiRyYOYNKAsIGYmYHFr","description":"","caption":"","poi_name":null,"subject":"","author":"Matthew Haughee","poi_id":null,"photo_date":"2022-08-09T19:39:19.000Z","updated_at":"2022-08-10T19:39:20.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/bJAEiewZIJJ9yXg1gNPBo","large":"https://api.americanwhitewater.org/image/images/big/bJAEiewZIJJ9yXg1gNPBo"}},{"id":"fc4yE0WyQqshkmL4bIeF4","ext":"jpg","post_id":"1uGiRyYOYNKAsIGYmYHFr","description":"This is the largest drop of the first major rapid. The rock the picture is taken from can be accessed via an eddy above the drop easily at 1500* cfs. ","caption":"First Rapid","poi_name":null,"subject":"Wolf Creek Rapid, Hollywood Bowl","author":"Matthew Haughee","poi_id":"1096","photo_date":"2022-08-09T19:54:04.000Z","updated_at":"2022-08-10T19:54:04.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/fc4yE0WyQqshkmL4bIeF4","large":"https://api.americanwhitewater.org/image/images/big/fc4yE0WyQqshkmL4bIeF4"}},{"id":"888830","ext":"jpeg","post_id":"891475","description":"Squirting below a great bedrock rapid. ","caption":"Fun Rapid","poi_name":"","subject":"Sam Evans","author":"Kevin Colburn","poi_id":null,"photo_date":"2018-02-23T15:09:05.000Z","updated_at":"2022-07-18T15:09:05.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888830","large":"https://api.americanwhitewater.org/image/images/big/888830"}},{"id":"888831","ext":"jpeg","post_id":"891475","description":"Lots of Class III wave trains.  ","caption":"Class III","poi_name":"","subject":"Sam Evans","author":"Kevin Colburn","poi_id":null,"photo_date":"2018-02-23T15:09:05.000Z","updated_at":"2022-07-18T15:09:05.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888831","large":"https://api.americanwhitewater.org/image/images/big/888831"}},{"id":"888829","ext":"jpeg","post_id":"891475","description":"Rapids are mixed among deep pools","caption":"Deep Pool","poi_name":"","subject":"Sam Evans","author":"Kevin Colburn","poi_id":null,"photo_date":"2018-02-23T15:09:05.000Z","updated_at":"2022-07-18T15:09:05.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888829","large":"https://api.americanwhitewater.org/image/images/big/888829"}},{"id":"888824","ext":"jpeg","post_id":"891475","description":"","caption":"Hollywood Bowl from Below","poi_name":"Hollywood Bowl","subject":"Sam Evans","author":"Kevin Colburn","poi_id":"1081","photo_date":"2018-02-23T15:09:05.000Z","updated_at":"2022-07-18T15:09:06.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888824","large":"https://api.americanwhitewater.org/image/images/big/888824"}},{"id":"888827","ext":"jpeg","post_id":"891475","description":"One of many nice wave trains in a big open river. ","caption":"Wave Train","poi_name":"","subject":"Sam Evans","author":"Kevin Colburn","poi_id":null,"photo_date":"2018-02-23T15:09:05.000Z","updated_at":"2022-07-18T15:09:05.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888827","large":"https://api.americanwhitewater.org/image/images/big/888827"}},{"id":"888823","ext":"jpeg","post_id":"891475","description":"","caption":"Top of Hollywood Bowl","poi_name":"Hollywood Bowl","subject":"","author":"Kevin Colburn","poi_id":"1081","photo_date":"2018-02-23T15:09:06.000Z","updated_at":"2022-07-18T15:09:06.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888823","large":"https://api.americanwhitewater.org/image/images/big/888823"}},{"id":"888822","ext":"jpeg","post_id":"891475","description":"Lots of line options, we ran a tongue left of center. ","caption":"Bottom of Hollywood Bowl","poi_name":"Hollywood Bowl","subject":"","author":"Kevin Colburn","poi_id":"1081","photo_date":"2018-02-23T15:09:06.000Z","updated_at":"2022-07-18T15:09:06.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888822","large":"https://api.americanwhitewater.org/image/images/big/888822"}},{"id":"888826","ext":"jpeg","post_id":"891475","description":"Thread the needle, sneak right, or go for either big boof!","caption":"Bottom of Wu","poi_name":"Wu","subject":"","author":"Kevin Colburn","poi_id":null,"photo_date":"2018-02-23T15:09:06.000Z","updated_at":"2022-07-18T15:09:06.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888826","large":"https://api.americanwhitewater.org/image/images/big/888826"}},{"id":"888833","ext":"jpeg","post_id":"891475","description":" The reason the Dries are dry. ","caption":"Apalachia Powerhouse","poi_name":"","subject":"","author":"Kevin Colburn","poi_id":null,"photo_date":"2018-02-23T15:09:06.000Z","updated_at":"2022-07-18T15:09:06.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888833","large":"https://api.americanwhitewater.org/image/images/big/888833"}},{"id":"VDD69ueF36VqIiXTESL67","ext":"jpg","post_id":"M5KlNy4SuGtvRTW99u2kQ","description":"Good parking, bad trail","caption":"Wolf Creek Put In","poi_name":null,"subject":"","author":"Kevin Colburn","poi_id":"qavCrclwGuuMrv5o53e2J","photo_date":"2016-02-06T18:03:56.000Z","updated_at":"2022-07-18T18:03:57.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/VDD69ueF36VqIiXTESL67","large":"https://api.americanwhitewater.org/image/images/big/VDD69ueF36VqIiXTESL67"}},{"id":"PewndtRkoI8QZl1anOM22","ext":"jpg","post_id":"kTIRJD0ZmA2gLwkGEnGLg","description":"Typical scene picking our way between rocks at base flow. ","caption":"Above Hollywood Bowl","poi_name":null,"subject":"Katie Schmidt","author":"Kevin Colburn","poi_id":"1081","photo_date":"2019-10-14T17:44:24.000Z","updated_at":"2022-07-18T17:44:24.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/PewndtRkoI8QZl1anOM22","large":"https://api.americanwhitewater.org/image/images/big/PewndtRkoI8QZl1anOM22"}},{"id":"y6tdQbbYKgnsZVEchCN4Z","ext":"jpg","post_id":"kTIRJD0ZmA2gLwkGEnGLg","description":"It is a good and big sign. ","caption":"Apalachia Dam ","poi_name":null,"subject":"Katie Schmidt","author":"Kevin Colburn","poi_id":null,"photo_date":"2019-10-14T17:44:24.000Z","updated_at":"2022-07-18T17:44:24.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/y6tdQbbYKgnsZVEchCN4Z","large":"https://api.americanwhitewater.org/image/images/big/y6tdQbbYKgnsZVEchCN4Z"}},{"id":"sdcvU0ObFmocXfhvZzqVo","ext":"jpg","post_id":"M5KlNy4SuGtvRTW99u2kQ","description":"Hollywood Bowl is just all big at this level.","caption":"All Big","poi_name":null,"subject":"","author":"Kevin Colburn","poi_id":"1096","photo_date":"2016-02-06T18:03:56.000Z","updated_at":"2022-07-18T18:03:57.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/sdcvU0ObFmocXfhvZzqVo","large":"https://api.americanwhitewater.org/image/images/big/sdcvU0ObFmocXfhvZzqVo"}},{"id":"YWweMMvaGex3WzisrEQPy","ext":"jpg","post_id":"kTIRJD0ZmA2gLwkGEnGLg","description":"This is where the water comes from, when it rarely spills. ","caption":"Apalachia Dam","poi_name":null,"subject":"","author":"Kevin Colburn","poi_id":null,"photo_date":"2019-10-14T17:44:24.000Z","updated_at":"2022-07-18T17:44:24.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/YWweMMvaGex3WzisrEQPy","large":"https://api.americanwhitewater.org/image/images/big/YWweMMvaGex3WzisrEQPy"}},{"id":"eDj7cbtfwcHNvnayHBUCM","ext":"jpg","post_id":"kTIRJD0ZmA2gLwkGEnGLg","description":"While very low, this little spot was zoomy and fun. ","caption":"Flow gathering into a wave train","poi_name":null,"subject":"Katie Schmidt","author":"Kevin Colburn","poi_id":null,"photo_date":"2019-10-14T17:44:24.000Z","updated_at":"2022-07-18T17:44:24.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/eDj7cbtfwcHNvnayHBUCM","large":"https://api.americanwhitewater.org/image/images/big/eDj7cbtfwcHNvnayHBUCM"}},{"id":"mesy1Suuy54A39ACh9X9H","ext":"jpg","post_id":"kTIRJD0ZmA2gLwkGEnGLg","description":"The riverbed is a forest above the main tributaries. ","caption":"Scene from the bridge","poi_name":null,"subject":"","author":"Kevin Colburn","poi_id":"1080","photo_date":"2019-10-14T17:44:24.000Z","updated_at":"2022-07-18T17:44:24.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/mesy1Suuy54A39ACh9X9H","large":"https://api.americanwhitewater.org/image/images/big/mesy1Suuy54A39ACh9X9H"}},{"id":"zU0T7Ju8pCSSQKEmt5xnf","ext":"jpg","post_id":"M5KlNy4SuGtvRTW99u2kQ","description":"Hollywood Bowl was a big kinda messy wave train this day. ","caption":"Hollywood Bowl from River Left","poi_name":null,"subject":"","author":"Kevin Colburn","poi_id":"1096","photo_date":"2016-02-06T18:03:56.000Z","updated_at":"2022-07-18T18:03:57.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/zU0T7Ju8pCSSQKEmt5xnf","large":"https://api.americanwhitewater.org/image/images/big/zU0T7Ju8pCSSQKEmt5xnf"}}],"detail":{"id":"1752","permitUrl":"","permitInfo":"","description":"The Hiwassee Dries is a big beautiful run that is almost always dewatered by TVA's Apalachia hydropower project. Think a big-water version of Section III of the Chattooga, just over the hill from the Ocoee. An old railroad line shares the river corridor, but the scenery is most often wild. The water is crystal clear, and there are plenty of waves and deep eddy lines to play with.\n\nThe run is only available when  Apalachia Dam is spilling due to high rainfall or more likely due to maintenance shut downs at the power plant, which happen once a year or so. There is no great way to tell if the dam is spilling except to keep an eye out for a notice on the [TVA website](https://www.tva.gov/Environment/Lake-Levels/Apalachia). At high water (>3,000) you can expect big waves and holes and lots of fun boils. At moderate flows (1,000-3,000) expect clean deep lines and moderate sized features. Its been run and is fun at least as low as 800.\n\nThe 70+ year old hydropower diversion has allowed trees to grow in the riverbed. Above Turtletown Creek the riverbed is essentially a forest, with dangerous and miserable strainers throughout the channel. Below Turtletown Creek trees and shrubs are seldom an issue for paddlers, but caution is advised of course. Because of this: DO NOT put in at Hwy 68.\n\nThe biggest rapid by a long shot on the Dries is Hollywood Bowl, about a mile below Turtletown Creek. Scout from river left and chose a route through the 3-4 ledges with multiple lines through each depending on flow. Shortly after Hollywood Bowl is Wu, a big wave train leading to two offset features that are rocks, pourovers, or holes depending on the flow. Thread the needle, sneak right, or go for a boof at Wu. After Wu are a dozen or so easier but nice class III rapids that offer up some fun technical moves and surfing opportunities. The stretch marked on the topo maps as the narrows has some suprisingly boily funny water. The recovery pools are quite large between almost all of the drops.\n\nYou can put in at the confluence of Turtletown Creek if you have a relatively high clearance 4WD vehicle. If not, hike the steep trail down from where the shuttle road first nears the river on a sharp bend. Hike a bit upstream from here to reach Hollywood Bowl. **Don't put in above Turtletown Creek (at HWY 68): it is swift flatwater and completely clogged with trees and strainers.** From Turtletown Creek to the Apalachia Powerhouse is 5.7 miles at an average of 40 fpm. Using the Turtletown put-in makes for an 8.5 mile shuttle, all on dirt roads. Be aware the roads can get rather muddy after a lot of rain. Take out downstream of the Apalachia Powerhouse on river left but be sure to park and stay very out of the way, and park outside of the yellow gate. This site has been closed in the past to parking and clear vehicular access to the powerhouse for TVA is mandatory at all times.\n\nThe Dries is home to several endangered and globally rare species that are likely underwater when you are paddling. Avoid disturbing vegetation on the bedrock islands and outcrops both above and below the water.\n\nAmerican Whitewater is very interested in restoring flows to the Hiwassee Dries. We appreciate paddlers documenting their runs with high quality photos and video, and noting flow volumes if known.","averageGradient":"32","maxGradient":"70","length":"5.7","correlations":[],"pointOfInterestIDs":["1080","1090","1081","1096","qavCrclwGuuMrv5o53e2J","1087","1088","1089","118068"],"geometry":{"type":"LineString","coordinates":[[-84.365267,35.170005],[-84.365316,35.170248],[-84.365535,35.170223],[-84.365889,35.170217],[-84.366022,35.170217],[-84.366553,35.170229],[-84.366685,35.17024],[-84.366902,35.170272],[-84.367673,35.170436],[-84.367842,35.170479],[-84.368314,35.170574],[-84.368396,35.170601],[-84.368435,35.170618],[-84.368472,35.170637],[-84.368508,35.170658],[-84.36874,35.170824],[-84.368984,35.171031],[-84.369119,35.171173],[-84.369165,35.171234],[-84.36923,35.171327],[-84.369355,35.171475],[-84.369452,35.171635],[-84.369693,35.172017],[-84.369969,35.172384],[-84.369989,35.172415],[-84.370133,35.172716],[-84.370276,35.172937],[-84.370394,35.173129],[-84.370688,35.173529],[-84.370804,35.173681],[-84.371163,35.174132],[-84.371217,35.174188],[-84.37156,35.174468],[-84.371593,35.174491],[-84.371955,35.174697],[-84.372181,35.17481],[-84.372334,35.174882],[-84.372578,35.174967],[-84.372915,35.175054],[-84.373039,35.175093],[-84.373407,35.175216],[-84.373729,35.175335],[-84.373984,35.175393],[-84.374333,35.175507],[-84.374463,35.17553],[-84.374856,35.175582],[-84.375164,35.17561],[-84.375385,35.175622],[-84.375823,35.175675],[-84.375867,35.175682],[-84.375909,35.175692],[-84.376157,35.175768],[-84.376436,35.175878],[-84.37655,35.175933],[-84.376588,35.175952],[-84.376802,35.176078],[-84.37702,35.176201],[-84.377323,35.176348],[-84.377575,35.176494],[-84.377795,35.176615],[-84.378058,35.176806],[-84.378126,35.176851],[-84.378199,35.176891],[-84.37826,35.176936],[-84.378447,35.177032],[-84.378603,35.177099],[-84.378716,35.177156],[-84.37895,35.177257],[-84.379385,35.177433],[-84.379669,35.177535],[-84.379752,35.177559],[-84.379794,35.177569],[-84.379968,35.177597],[-84.380098,35.177621],[-84.380186,35.177628],[-84.380274,35.177629],[-84.380581,35.177595],[-84.380798,35.17756],[-84.380841,35.177551],[-84.380924,35.17