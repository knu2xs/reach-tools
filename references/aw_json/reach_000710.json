[{"result":{"data":{"json":{"id":"710","stub":{"id":"710","section":"PA Route 841 to Elkton Rd., Elkton, MD","altname":"","river":"Big Elk Creek","difficulty":"ItoII","states":["USA-MRY","USA-PEN"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"30","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Put-in PA 841","id":"112308","location":{"latitude":"39.735907","longitude":"-75.875364"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"Elkton Rd., Elkton, MD","id":"117590","location":{"latitude":"39.621635","longitude":"-75.828757"},"name":"Take Out","distance":"12.59","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"880612","ext":"jpeg","post_id":"881813","description":"only surf hole","caption":"the fun spot","poi_name":"","subject":"nick and bob","author":"Jordan Troiani","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880612","large":"https://api.americanwhitewater.org/image/images/big/880612"}},{"id":"880613","ext":"jpeg","post_id":"881814","description":"only surf hole","caption":"the fun spot","poi_name":"","subject":"nick","author":"Jordan Troiani","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880613","large":"https://api.americanwhitewater.org/image/images/big/880613"}},{"id":"880614","ext":"jpeg","post_id":"881815","description":"john diggin in","caption":"the fun spot before md line","poi_name":"","subject":"john pasmore","author":"Jordan Troiani","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880614","large":"https://api.americanwhitewater.org/image/images/big/880614"}},{"id":"880615","ext":"jpeg","post_id":"881816","description":"bob getting spit out","caption":"the fun spot ","poi_name":"","subject":"bob w","author":"Jordan Troiani","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880615","large":"https://api.americanwhitewater.org/image/images/big/880615"}},{"id":"880616","ext":"jpeg","post_id":"881817","description":"john riding high","caption":"the fun spot ","poi_name":"","subject":"john p","author":"Jordan Troiani","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/880616","large":"https://api.americanwhitewater.org/image/images/big/880616"}}],"detail":{"id":"710","permitUrl":null,"permitInfo":null,"description":"Pretty pastoral stream, the most scenic part of which runs through the [Fair Hill Natural Resource Area](http://www.dnr.state.md.us/publiclands/central/fairhill.html), which is an old duPont family fox hunting estate. Here's a tidbit for you Oprah fans-the movie Beloved was filmed at Fair Hill, and the set, which is a grouping of historic farm structures, is still there. It's worth checking out, especially since there is a nasty partially washed out low water bridge located nearby, followed by a completely washed out bridge that gathers strainers, followed by a harmless but pretty [covered bridge](http://william-king.www.drexel.edu/top/bridge/CBfox.html). This low water bridge is the only serious hazard I'm aware of on this stream, and it should be scouted before running this section at high water.\n\n_From Ed Gertler:_\n\nThough I posted the following on the board, it occurred to me that Ishould have just sent it straight to you. So here it is. Glad to know someone else enjoys this lovely creek (great for cross country skiing also).\n\nIn reply to your request for opinions on the Big Elk gauge at ElkMills, I most recently ran from PA Rte. 841 to Elkton a few weeks ago on extraordinarily slowly dropping (read that stable) levels, the flow that day being 140 down to 110 cfs.  I found the creek bumpy in a few spots, but otherwise the level was adequate for me, a light guy in a voluminous C-1.  I intend to call 130 cfs minimum whenever I next revise MD& DEL Canoe Trails.  If you want to do the upper creek (from Elkdale, startingon the E. Br.) you probably want about 450 cfs at the gauge.  This is based on the historical record of the AVERAGE flow that day.  Keep in mind that it is nearly 15 miles from the upper put-in to the gauge which, on a normally flashy stream such as this, makes a gauge reading an approximation at best.  Hope this helps you out.\n\nSYOTR,\n\nEd","averageGradient":"15","maxGradient":"15","length":"13","correlations":[{"reachID":"710","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"139","beginMediumRunnable":"209","beginHighRunnable":"1500","endHighRunnable":"5000"},"gaugeInfo":{"name":"BIG ELK CREEK AT ELK MILLS, MD","gaugeSource":"USGS","gaugeSourceIdentifier":"01495000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"30","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"3.19","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"39.6675833","longitude":"-75.8255833"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/01495000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/01495000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":" ","status":{"status":"below-recommended","latestReading":{"value":"30","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adj