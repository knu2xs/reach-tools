anwhitewater.org/image/images/big/o110oiuHTG9Mfu20DxaXD"}},{"id":"vhMmCrWp1U5aY5b48yS42","ext":"jpg","post_id":"vAtDglflO1Ds72hwyDFq1","description":"Parking area at Hendricks Bridge","caption":"Parking at Hendricks Bridge","poi_name":null,"subject":"","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":"j8Hh0gzt2CJ78hsPPuQZz","photo_date":"2025-04-13T16:08:37.000Z","updated_at":"2025-04-14T16:08:40.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/vhMmCrWp1U5aY5b48yS42","large":"https://api.americanwhitewater.org/image/images/big/vhMmCrWp1U5aY5b48yS42"}},{"id":"RIsor3IKEKa2txFz6nL7o","ext":"jpg","post_id":"vAtDglflO1Ds72hwyDFq1","description":"","caption":"Leaburg Dam Boat Slide","poi_name":null,"subject":"","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":"109488","photo_date":"2025-04-13T16:08:37.000Z","updated_at":"2025-04-14T16:08:40.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/RIsor3IKEKa2txFz6nL7o","large":"https://api.americanwhitewater.org/image/images/big/RIsor3IKEKa2txFz6nL7o"}},{"id":"40113","ext":"jpeg","post_id":"1764","description":"Boat launch at Hendrick's Park at Highway 126 mile 11.6.","caption":"Hendrick's Park Boat Launch","poi_name":"","subject":"","author":"Thomas O'Keefe В©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/40113","large":"https://api.americanwhitewater.org/image/images/big/40113"}},{"id":"40108","ext":"jpeg","post_id":"1764","description":"Leaburg Powerhouse on the McKenzie River. This is part of the Leaburg-Walterville Hydropower Project (FERC P-2496) which includes two dams, and two powerhouses. The total rated capacity of the project is 23.20 MW.","caption":"Leaburg Powerhouse","poi_name":"","subject":"","author":"Thomas O'Keefe В©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/40108","large":"https://api.americanwhitewater.org/image/images/big/40108"}},{"id":"885432","ext":"jpeg","post_id":"888196","description":"Low Summer Flows Surf at the \"Bubble Gum\" wave just above Hayden Bridge","caption":"Low Summer Flows Surf","poi_name":"Bubble Gum Wave","subject":"Clinton Begley","author":"Clinton Begley","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/885432","large":"https://api.americanwhitewater.org/image/images/big/885432"}},{"id":"40109","ext":"jpeg","post_id":"1764","description":"Leaburg Dam on the McKenzie River. This is part of the Leaburg-Walterville Hydropower Project (FERC P-2496) which includes two dams, and two powerhouses. The total rated capacity of the project is 23.20 MW.","caption":"Leaburg Dam","poi_name":"","subject":"","author":"Thomas O'Keefe В©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/40109","large":"https://api.americanwhitewater.org/image/images/big/40109"}}],"detail":{"id":"1527","permitUrl":"","permitInfo":"","description":"There are many miles to paddle between the Leaburg Dam and Hayden Bridge.\n\nThe Hayden Bridge boat ramp (the takeout), just off Marcola Road, is a popular put-in spot for tubers and is often jam packed with cars on summer weekends when the temps rise above 90 degrees.\n\nA popular run for fisherman is from Hendricks Bridge Park in Springfield to Hayden Bridge (about 9 miles) and is basically a class I-II run at most levels. Bellinger landing provides a slightly shorter trip.\n\nThere is a pulloff on camp creek road \\[ 35788-35930 Camp Creek Rd Springfield, OR 97478 44.071816, -122.941368\\] that can serve as a put-in and create a nice little class I-II run to Hayden Bridge that is a perfect training run for boaters. There is a great spot for ferries and eddy play at that turn-off put-in, a couple of sets of shoals and swiftwater throughout and a fun II+/III- drop just before Hayden Bridge.\n\nBelow the drop is a great beginner play wave that has generous eddy service, is pretty smooth and just barely sticky enough to hold a spin...barely. The runout is deep and the eddyline is great for squirts. I've had 4 minute rides on this wave. I'd call it a good beginner wave to work on edge control and carving, but anyone looking to throw tricks will be disappointed.\n\nThis can also be a park and play spot from Hayden Bridge. Logistics are pretty easy. Just put in at the Hayden Bridge boat launch and paddle \\*upstream\\* passed the bridge. The wave will be obvious (river left) and you'll see some \"rock beavering\" that bolsters the eddy service.","averageGradient":null,"maxGradient":null,"length":"24","correlations":[{"reachID":"1527","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"900","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"2000"},"gaugeInfo":{"name":"MCKENZIE RIVER BLW LEABURG DAM, NR LEABURG, OR","gaugeSource":"USGS","gaugeSourceIdentifier":"14163150","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"2920","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"5.16","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"44.123738","longitude":"-122.6275715"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/14163150","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/14163150/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"above-recommended","latestReading":{"value":"2920","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"