[{"result":{"data":{"json":{"id":"472","stub":{"id":"472","section":"2 - Robertson to GA Route 115","altname":"Hoochy Helen Run","river":"Chattahoochee","difficulty":"ItoII","states":["USA-GEO"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"71","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"109105","location":{"latitude":"34.7122","longitude":"-83.7453"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"114340","location":{"latitude":"34.5745","longitude":"-83.6345"},"name":"Take Out","distance":"16","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"101246980","title":null,"post_date":"2010-06-06 04:00:00+00","detail":"WARNING! Just south of Helen, Unicoi Outfitters has a sign posted across the river that states that it is a private river and violators will be prosecuted. You cannot get out right there without crossing other people's property so we had to continue on about 1000 feet before we could exit. After we drug out boats up to the road we were confronted by a gentleman that was generally nice; however, threatening claimed that he was on the phone with the Police. If you are going through this section, make sure that you get out just before Unicoi Outfitters at the Helen Waterpark. I'm not sure at what point you can put back in. Might even want to consider not patronizing Unicoi Outfitters since they have cut this section off to boaters.","user":{"name":"Kyle Whitaker"}}],"photos":[{"id":"11148","ext":"jpeg","post_id":"7474","description":"When the river isn't littered with tubers, you can have a wave to yourself for a few minutes. ","caption":"from the bridge","poi_name":"","subject":"Jimmy Lowe (xstreamkayaking.com)","author":"Jamie Burch","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https: