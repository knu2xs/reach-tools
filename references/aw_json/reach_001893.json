[{"result":{"data":{"json":{"id":"1893","stub":{"id":"1893","section":"Backbone Rock Park to Laurel Creek (Damascus)","altname":"","river":"Beaverdam Creek","difficulty":"IItoIII","states":["USA-TNN","USA-VRG"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"275","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"110072","location":{"latitude":"36.5942001342773","longitude":"-81.8153991699219"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"115331","location":{"latitude":"36.6363983154297","longitude":"-81.7919006347656"},"name":"Take Out","distance":"4","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"101249969","title":null,"post_date":"2013-01-24 05:00:00+00","detail":"We paddled this section on 1/19/12 and there were numerous trees with mandatory portages, especially in the second half of the run. None of the strainers were unavoidable, but be on the lookout. If you wish to see a video of some of the rapids check out https://www.youtube.com/watch?v=V4fcj2fFftA","user":{"name":"Wayne Teague"}}],"photos":[],"detail":{"id":"1893","permitUrl":null,"permitInfo":null,"description":"Driving directions to the put in: From Damascus VA, take Rt. 58 to the intersection with TN 91. Turn right and continue on this road until you reach Backbone Rock. This road is well marked in town with a sign pointing you in the right direction. (To Backbone Rock/Shady Valley)From Backbone Rock you have two options for paddling this creek, 1.) is to drive past Backbone Rock access and decide where you want to put in along the creek. Or 2.) just put in upstream of the parking area and paddle down into the campground and run 'laps' on this short section. This creek is a good run for those just getting into creek boating with the difficulty level being predominantly cl. II-III.\n\nThe take out is located in the town of Damascus VA just before you reach the turn for TN 91. Park near the red caboose 'info' center and set shuttle here. Another option for running this creek is to take out at Backbone Rock. This gives the paddler the upper section of the 'steepest' gradient and allows for some laps on the last couple of good drops.\n\nWhen taking out at Backbone Rock, look for the last ledge drop just as you enter the campground and takeout just downstream of this. There is a trail that runs along the creek back to the vehicles at the Backbone Rock parking area.\n\nSee Also:\n\n_Virginia Whitewater_, Roger Corbett (2000 ed.), p. 385.","averageGradient":"25","maxGradient":"50","length":"3.9","correlations":[{"reachID":"1893","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1500","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"5000"},"gaugeInfo":{"name":"S F HOLSTON RIVER NEAR DAMASCUS, VA","gaugeSource":"USGS","gaugeSourceIdentifier":"03473000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"275","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"2.98","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"36.65178127","longitude":"-81.8440102"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/03473000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/03473000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"275","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"