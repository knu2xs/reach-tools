,"large":"https://api.americanwhitewater.org/image/images/big/883501"}},{"id":"883503","ext":"jpeg","post_id":"886192","description":"Looking down Midway Canyon, a good side hike that requires some technical moves.","caption":"Midway Canyon","poi_name":"","subject":"","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/883503","large":"https://api.americanwhitewater.org/image/images/big/883503"}},{"id":"888062","ext":"jpeg","post_id":"886192","description":"Boat ramp at Sand Hill serving as the put-in.","caption":"Sand Hill Access","poi_name":"","subject":"","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888062","large":"https://api.americanwhitewater.org/image/images/big/888062"}},{"id":"883509","ext":"jpeg","post_id":"886192","description":"","caption":"Canyons of the San Juan","poi_name":"","subject":"Tracy and Jan Tackett","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/883509","large":"https://api.americanwhitewater.org/image/images/big/883509"}},{"id":"883510","ext":"jpeg","post_id":"886192","description":"","caption":"The Narrows","poi_name":"","subject":"","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/883510","large":"https://api.americanwhitewater.org/image/images/big/883510"}},{"id":"883506","ext":"jpeg","post_id":"886192","description":"Canyons on the San Juan River","caption":"San Juan Canyon","poi_name":"","subject":"","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/883506","large":"https://api.americanwhitewater.org/image/images/big/883506"}},{"id":"883507","ext":"jpeg","post_id":"886192","description":"Aki in an inflatable kayak enjoying the canyons on the San Juan River.","caption":"San Juan Canyon","poi_name":"","subject":"Aki O'Keefe","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/883507","large":"https://api.americanwhitewater.org/image/images/big/883507"}},{"id":"887549","ext":"jpeg","post_id":"886192","description":"The start of a trip down the San Juan River.","caption":"Kids on the River","poi_name":"","subject":"Aki and Cassia","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887549","large":"https://api.americanwhitewater.org/image/images/big/887549"}},{"id":"887550","ext":"jpeg","post_id":"886192","description":"Petroglyphs on the San Juan River","caption":"Petroglyphs","poi_name":"","subject":"","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887550","large":"https://api.americanwhitewater.org/image/images/big/887550"}},{"id":"883494","ext":"jpeg","post_id":"886192","description":"Three miles into the trip, Moki Steps are visible. They provide historic evidence of those who called this canyon home generations ago.","caption":"Moki Steps","poi_name":"","subject":"","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/883494","large":"https://api.americanwhitewater.org/image/images/big/883494"}},{"id":"883511","ext":"jpeg","post_id":"886192","description":"","caption":"Ledge Rapid, Downstream View","poi_name":"Ledge Rapid","subject":"Aki O'Keefe","author":"Thomas O'Keefe ©","poi_id":"102951","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/883511","large":"https://api.americanwhitewater.org/image/images/big/883511"}},{"id":"883508","ext":"jpeg","post_id":"886192","description":"Entering Eight Foot Rapid.","caption":"Eight Foot Rapid","poi_name":"Eight-Foot Rapid","subject":"Tracy and Jan Tackett","author":"Thomas O'Keefe ©","poi_id":"102950","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/883508","large":"https://api.americanwhitewater.org/image/images/big/883508"}},{"id":"883502","ext":"jpeg","post_id":"886192","description":"A good line through Four-Foot Rapid.","caption":"Four-Foot Rapid","poi_name":"Four Foot Rapid","subject":"","author":"Thomas O'Keefe ©","poi_id":"102949","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/883502","large":"https://api.americanwhitewater.org/image/images/big/883502"}},{"id":"883517","ext":"jpeg","post_id":"886192","description":"The appearance of the Mexican Hat Rock announces the approach of the village of Mexican Hat and the BLM river access.","caption":"Mexican Hat","poi_name":"","subject":"Ed and Grace Canyon","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/883517","large":"https://api.americanwhitewater.org/image/images/big/883517"}},{"id":"883515","ext":"jpeg","post_id":"886192","description":"Collared lizards make the San Juan River corridor their home.","caption":"Collared Lizard","poi_name":"","subject":"","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/883515","large":"https://api.americanwhitewater.org/image/images/big/883515"}},{"id":"883516","ext":"jpeg","post_id":"886192","description":"Bighorn sheep are found in the canyon terrain along the San Juan River. In this photo two sheep blend into the landscape.","caption":"Find the Sheep","poi_name":"","subject":"","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/883516","large":"https://api.americanwhitewater.org/image/images/big/883516"}},{"id":"887548","ext":"jpeg","post_id":"886192","description":"Kids enjoying time together rafting on the San Juan River.","caption":"Kids on the River","poi_name":"","subject":"Kids","author":"Thomas O'Keefe ©","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887548","large":"https://api.americanwhitewater.org/image/images/big/887548"}}],"detail":{"id":"1871","permitUrl":"https://www.recreation.gov/permits/250986","permitInfo":"A permit is required year-round. For trips launching April 15 - July 15, launches are allocated through a permit lottery with applications due on January 31. Permits for trips before the lottery season are available by reservation on December 1 the year prior and trips after the lottery season are available by reservation on March 16.","description":"The San Juan River is a great multi-day river trip and this section features one of the finest collections of petroglyphs in the southwest. This section is often run as a three day trip but can also be the start of a longer trip that continues on downstream past Mexican Hat to Clay Hills Crossing.\n\nThe put-in is at Sand Hills Crossing near Bluff, Utah approximately half a mile upstream of the Highway 191 Bridge. Sand Island has a ranger station, several campsites including group sites, drinking water, toilets, trash collection, and a wide boat ramp that provides enough space for a few trips to stage simultaneously.\n\nThe run begins in open desert country. The first six miles have several petroglyphs and moki steps carved in the sandstone as toeholds for Native Americans who traveled through these canyons in centuries past. Particularly impressive panels with an incredible density of petroglyphs are visible just upstream and downstream of Butler Wash. A short hike up the wash takes you to some smaller ruins and petroglyphs.\n\nSix miles into the trip you reach the pullout for Riverhouse. It is about a 1/4 mile hike from the river to the base of the cliff. This ancestral puebloan ruin from the thirteenth century is built in a sandstone alcove overlooking the river. With 14 rooms this is the largest ruin along the river. It is visited by river runners and those on jeep tours. Given the heavy visitation, it is important to stay off the walls and out of the rooms so the structure remains undamaged for the benefit of future visitors. Less than a mile downstream of the Riverhouse is Barton's Trading Post. An interpretive sign marks the site which was established in the 1880s. The old trading post is at the base of San Juan Hill which was one of the last natural barriers encountered by Mormon pioneers who were searching for a route from Escalante to Bluff. Over the winter of 1879-1880, the pioneers sought to establish a settlement in the region to the east of the Colorado River and the journey that was expected to take only six weeks instead took six months. This last geologic barrier is a north to south-trending monocline known as Comb Ridge that extends approximately 80 miles and is bisected by the San Juan River. A short hike up San Juan Hill offers an impressive panorama of the landscape. All of these geologic and historic sites can be easily visited from one of the river camps on river right between River House and Comb Wash.\n\nAs you continue downstream, the river cuts through Comb Ridge as you approach the entrance to the canyon. On river left you will pass the trail to the Mule's Ear Diatreme. This feature is a volcanic pipe that formed when magma, originating in the upper mantle, rose up through a crack in the earth's crust. It takes a couple hours to hike up and back but it is easy walking on the sandstone ridge to reach the diatreme.\n\nThe next approximately 10 miles of river are through a deep canyon. A couple easier rapids get you ready for Four Foot Rapid, the first of the class II drops which can be scouted from the right. Below this rapid you pass the Perched Meander and Midway Canyon on river right. Both of these are great hikes accsessible from Midway Camp. The Perched Meander is a relatively easy hike where you can hike the ancient river channel before erosion sliced through the neck of the meander. Midway Canyon is a more technical hike with a series of puzzles that must be solved to pass upstream of the big ledges you encounter on your way up.\n\nAnother few miles downstream you will encounter Eight-Foot Rapid which is the most technical rapid on this section. Technical manuvering between a large midstream boulder at the top of the rapid and a bedrock wall on the right is required to safely negotiate this rapid. This drop is easy to scout from river left.\n\nWhile there are two camps immediately below Eight-Foot Rapid, the next two miles of river are closed to camping as this is prime habitat for bighorn sheep who need to be able to access the river for water without being disturbed. The end of this section is marked by Ledge Rapid which is formed by a debris fan on river left that pinches the river against the bedrock wall on river right. You will want to run river right to stay in the main current and clear of the rocky shoals but keep your boat angled to the left to avoid going up against the wall on river right. The drop can be easily scouted from the top on river right.\n\nWithin a mile of Ledge Rapid the canyon starts to open up and you pass Fossil Camp on the right. As its name suggests, this is a fun place to view fossils. Within a few more bends the Mexican Hat Rock comes into a view on river right. Once you pass this feature it is only another couple miles down to the boat ramp at the BLM River Access site of Mexican Hat. You will find camping, garbage collection, and toilets at this site but no running water.","averageGradient":"0","maxGradient":"0","length":"26.9","correlations":[{"reachID":"1871","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"500","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"8000"},"gaugeInfo":{"name":"SAN JUAN RIVER NEAR BLUFF, UT","gaugeSource":"USGS","gaugeSourceIdentifier":"09379500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"531","dateTime":"2026-05-12T03:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"5.62","dateTime":"2026-05-12T03:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"37.15067778","longitude":"-109.8666889"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/09379500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/09379500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"migration-runnable","latestReading":{"value":"531","dateTime":"2026-05-12T03:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["112639","117925"],"geometry":{"type":"LineString","coordinates":[[-109.61214623,37.26137432],[-109.61368387,37.26077041],[-109.61613027,37.26002761],[-109.61651521,37.26009328],[-109.61675581,37.26007681],[-109.61707867,37.25992828],[-109.61725707,37.25952708],[-109.61731187,37.25919748],[-109.61811561,37.25861468],[-109.61840407,37.25846081],[-109.61872027,37.25840568],[-109.62018301,37.25669088],[-109.62041641,37.25624568],[-109.62119221,37.25522341],[-109.62150107,37.25463001],[-109.62158321,37.25419588],[-109.62158967,37.25371241],[-109.62170521,37.25204761],[-109.62208281,37.2515