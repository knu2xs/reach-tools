4","poi_name":null,"subject":"","author":"Forest Kan","poi_id":null,"photo_date":"2026-03-24T03:58:42.000Z","updated_at":"2026-03-31T03:58:43.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/4HgljvKv0XM9kleHEAuTD","large":"https://api.americanwhitewater.org/image/images/big/4HgljvKv0XM9kleHEAuTD"}},{"id":"nQL1zXVT2U9gk4HNPpSon","ext":"jpg","post_id":"XPmQ3fELrPE7HZcoymVAN","description":"Good rapid at this flow. Sieves, but avoidable. ","caption":"Dream Gap 0","poi_name":null,"subject":"","author":"Forest Kan","poi_id":null,"photo_date":"2026-03-24T03:58:42.000Z","updated_at":"2026-03-31T03:58:43.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/nQL1zXVT2U9gk4HNPpSon","large":"https://api.americanwhitewater.org/image/images/big/nQL1zXVT2U9gk4HNPpSon"}},{"id":"wQBTeN0iPb8tMkRAw2rvN","ext":"jpg","post_id":"XPmQ3fELrPE7HZcoymVAN","description":"Picturesque rapid within the first gorge.","caption":"Zig Zag","poi_name":null,"subject":"","author":"Forest Kan","poi_id":null,"photo_date":"2026-03-24T03:58:42.000Z","updated_at":"2026-03-31T03:58:43.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/wQBTeN0iPb8tMkRAw2rvN","large":"https://api.americanwhitewater.org/image/images/big/wQBTeN0iPb8tMkRAw2rvN"}},{"id":"3889R6xXFb8UAhica1tjW","ext":"jpg","post_id":"XPmQ3fELrPE7HZcoymVAN","description":"Campsite river right above dream gap. Gravel bar that made for good enough camping. ","caption":"Campsite","poi_name":null,"subject":"","author":"Forest Kan","poi_id":null,"photo_date":"2026-03-24T03:58:42.000Z","updated_at":"2026-03-31T03:58:43.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/3889R6xXFb8UAhica1tjW","large":"https://api.americanwhitewater.org/image/images/big/3889R6xXFb8UAhica1tjW"}},{"id":"ret2e4b6yaibXZBuDYh42","ext":"jpg","post_id":"XPmQ3fELrPE7HZcoymVAN","description":"Big 'ol hole plug","caption":"First rapid","poi_name":null,"subject":"","author":"Forest Kan","poi_id":null,"photo_date":"2026-03-24T03:58:42.000Z","updated_at":"2026-03-31T03:58:43.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/ret2e4b6yaibXZBuDYh42","large":"https://api.americanwhitewater.org/image/images/big/ret2e4b6yaibXZBuDYh42"}},{"id":"MLJDXd9YRsGkV1M2JGylH","ext":"jpg","post_id":"XPmQ3fELrPE7HZcoymVAN","description":"A little bit too low for our taste. Portaged river right, but barely. Very heinous hike. ","caption":"Dream Gap 2","poi_name":null,"subject":"","author":"Forest Kan","poi_id":null,"photo_date":"2026-03-24T03:58:42.000Z","updated_at":"2026-03-31T03:58:43.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/MLJDXd9YRsGkV1M2JGylH","large":"https://api.americanwhitewater.org/image/images/big/MLJDXd9YRsGkV1M2JGylH"}},{"id":"877342","ext":"jpeg","post_id":"877577","description":"","caption":"","poi_name":null,"subject":null,"author":"Thomas M","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/877342","large":"https://api.americanwhitewater.org/image/images/big/877342"}}],"detail":{"id":"137","permitUrl":"","permitInfo":"","description":"**Put In**\n\nBeacroft Trailhead: [google map](http://maps.google.com/maps?q=39.193,+-%20120.5673+%28Beacroft+trailhead%29&hl=en&ie=UTF8&z=17&ll=39.193,-%20120.5673&spn=0.00376,0.010632&t=h&om=1).\n\nBottom of trail at Tadpole Creek:  [google map](http://maps.google.com/maps?q=39.2144,+-%20120.5722+%28Tadpole+Creek%29&hl=en&ie=UTF8&z=17&ll=39.2144,-%20120.5722&spn=0.00376,0.010632&t=h&om=1). Elevation = 2850 feet.\n\n**Take Out:** Boaters can stop at Euchre Bar [google map](http://maps.google.com/maps?q=39.1856,+-%20120.7613+%28Euchre+Bar%29&hl=en&ie=UTF8&z=17&ll=39.1856,-%20120.7613&spn=0.00376,0.010632&t=h&om=1) and hike up a trail to Euchre Bar Trailhead [google map](http://maps.google.com/maps?q=39.1933,+-%20120.7699+%28Euchre+Bar+trailhead%29&hl=en&ie=UTF8&z=17&ll=39.1933,-%20120.7699&spn=0.00376,0.010632&t=h&om=1), but this forces a 50 mile shuttle that takes an hour and a half each direction. Most boaters continue on through [Giant Gap](https://www.americanwhitewater.org/content/River/detail/id/138/) to exit at Colfax-Iowa Hill Rd. [google map](http://maps.google.com/maps?q=39.1004,+-120.9246+%28Colfax-Iowa+Hill+Road%29&hl=en&ie=UTF8&z=17&ll=39.1004,-120.9246&spn=0.00376,0.010632&t=h&om=1). This shuttle is about 30 miles and takes about an hour each way. Others continue on through the [Chamberlain Falls](https://www.americanwhitewater.org/content/River/detail/id/139/) section to Colfax-Foresthill Rd.  [google map](http://maps.google.com/maps?q=39.0403,+-120.9027+%28Colfax-Foresthill+Road%29&hl=en&ie=UTF8&z=17&ll=39.0403,-120.9027&spn=0.00376,0.010632&t=h&om=1) which reduces the shuttle to 28 miles and less than an hour each way.\n\nSee also:\n\n[Preston Holmes](http://www.ptone.com/Kayak/NFAmerican/) story.\n\nA Guide to the Best Whitewater in the State of California\n\nHolbek & Stanley, 1988","averageGradient":null,"maxGradient":null,"length":"12","correlations":[{"reachID":"137","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"500","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"2000"},"gaugeInfo":{"name":"NF AMERICAN R A NORTH FORK DAM CA","gaugeSource":"USGS","gaugeSourceIdentifier":"11427000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"878","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.43","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"38.9359915","longitude":"-121.023802"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gau