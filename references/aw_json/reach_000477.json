post_id":"891649","description":"","caption":"Dennis Simpkins and Gary Kyle surfing Turn Hole Rapid","poi_name":null,"subject":null,"author":"Karen Heath","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/888999","large":"https://api.americanwhitewater.org/image/images/big/888999"}},{"id":"13889","ext":"jpeg","post_id":"8236","description":"","caption":"Running Big Shoals","poi_name":"Big Shoals","subject":"Georgette Tarpley","author":"Jason Tarpley","poi_id":"2401","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/13889","large":"https://api.americanwhitewater.org/image/images/big/13889"}},{"id":"13887","ext":"jpeg","post_id":"8236","description":"","caption":"Turn Hole Rapid","poi_name":"Turn Hole","subject":"Georgette Tarpley","author":"Jason Tarpley","poi_id":"2400","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/13887","large":"https://api.americanwhitewater.org/image/images/big/13887"}},{"id":"13891","ext":"jpeg","post_id":"8236","description":"","caption":"Running Big Shoals","poi_name":"Big Shoals","subject":"Jason Tarpley","author":"Georgette","poi_id":"2401","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/13891","large":"https://api.americanwhitewater.org/image/images/big/13891"}},{"id":"13892","ext":"jpeg","post_id":"8236","description":"","caption":"Clean Run In Big Shoals","poi_name":"Big Shoals","subject":"Jason Tarpley","author":"Georgette","poi_id":"2401","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/13892","large":"https://api.americanwhitewater.org/image/images/big/13892"}},{"id":"13890","ext":"jpeg","post_id":"8236","description":"the small curler at the top took its claim","caption":"Swimming In Big Shoals","poi_name":"Big Shoals","subject":"Georgette Tarpley","author":"Jason Tarpley","poi_id":"2401","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/13890","large":"https://api.americanwhitewater.org/image/images/big/13890"}},{"id":"881191","ext":"bmp","post_id":"883705","description":"Stuart Ledford and I ran this starting at Hwy 28 at 1:00 PM on Sept. 19, 2012. Estimate of 2.30 on the Hwy 76 gauge, as it had shown as 2.56 at 7 AM and was down to 2.13 at 7 AM the following morning. Picture is at 3:00 PM of Vince from somewhere in Georgia, whom we met on the river. He's obviously going down the far Right side. His friend Carl also went down the not quite so far Right.  Also in an Ocoee canoe. Water was fine also at left of the island, and seemed fine through the middle for a play boat. ","caption":"Vince at Big Shoals","poi_name":"Big Shoals","subject":"","author":"Glenn Atkisson","poi_id":"2401","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/881191","large":"https://api.americanwhitewater.org/image/images/big/881191"}},{"id":"14236","ext":"jpeg","post_id":"8235","description":"Here is one of the MANY paddlesnakes lurking beneath the surface of your favorite rapid","caption":"Paddle Snake","poi_name":"","subject":"paddlesnake","author":"JT","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/14236","large":"https://api.americanwhitewater.org/image/images/big/14236"}}],"detail":{"id":"477","permitUrl":"","permitInfo":"","description":"Section 2 is a scenic float trip with a handful of small ledges, rapids, and shallow shoals separated by long sections of deep flatwater.  At moderate levels the run is class II+ with no significant objective hazards except perhaps the occasional tree. The run starts at an official put-in a mile or so downstream of the Highway 28 bridge, and Earls Ford is the typical take-out (River left). There are also a number of possible put ins on the West Fork upstream that add a nice addition to the run if the water is high or you want to make it a 2-day trip. There are quite a few nice campsite options on riverside benches in the middle part of the run, but few beaches. It is worth getting a trail map to pick a campsite away from trail access. 1.8 feet is a reasonable minimum for rafts.","averageGradient":null,"maxGradient":null,"length":"6.1","correlations":[{"reachID":"477","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1.3","beginMediumRunnable":"1.9","beginHighRunnable":"3","endHighRunnable":"5"},"gaugeInfo":{"name":"CHATTOOGA RIVER NEAR CLAYTON, GA","gaugeSource":"USGS","gaugeSourceIdentifier":"02177000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"269","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.37","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"34.81377778","longitude":"-83.3063611"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/02177000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/02177000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"low-runnable","latestReading":{"value":"1.37","dateTime":"2026-05-12T02:00:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null}}],"pointOfInterestIDs":["107716","2400","2401","112953"],"geometry":{"type":"LineString","coordinates":[[-83.181187,34.90765],[-83.180805,34.906425],[-83.18072,34.905959],[-83.180677,34.905396],[-83.180679,34.905372],[-83.180676,34.905372],[-83.180