[{"result":{"data":{"json":{"id":"1809","stub":{"id":"1809","section":"FM 1050 to First Crossing (SH 127 at Concan) (12 miles)","altname":"","river":"Frio","difficulty":"IItoIII","states":["USA-TEX"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"33","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Parking is available in the highway right-of-way on the south (downstream) side of the highway on either side of the bridge (the land on this side of the road is part of Garner State Park.)","id":"104776","location":{"latitude":"29.604700088500977","longitude":"-99.73770141601562"},"name":"FM 1050 Bridge","distance":"0","photoID":"0","difficulty":"N/A","approximate":false},{"type":"portage","description":"Up to about 1500 cfs, the dam forms a runnable slide with a small hydraulic at the bottom.  At higher levels, it is known to be deadly.  Portage on river left.","id":"105064","location":{"latitude":"29.53190040588379","longitude":"-99.70980072021484"},"name":"Low-Head Dam","distance":"7.98","photoID":"0","difficulty":"N/A","approximate":false},{"type":"playspot","description":"Limestone features constrict the river, forming a wave train at about 800 cfs and higher.  The first wave is surfable.","id":"105066","location":{"latitude":"29.5266056060791","longitude":"-99.70158386230469"},"name":"The Chute","distance":"8.63","difficulty":"II","approximate":false,"photoID":"0"},{"type":"playspot","description":"If the river is running at 1500+ cfs, this low-water crossing creates at 50-yard-wide play hole that gives up spins.  At 2500+, it becomes one of the best play holes in Texas, deep enough for areal moves.","id":"105035","location":{"latitude":"29.521499633789062","longitude":"-99.70159912109375"},"name":"Comanche Crossing","distance":"9","difficulty":"II","approximate":true,"photoID":"0"},{"type":"hazard","description":"Low-water bridge, generally passable at \"normal\" (recreational) flows.  If there is insufficient headroom under the bridge, portage at river left.  If water is over the bridge, it can be run at river left, with caution.","id":"104782","location":{"latitude":"29.515100479125977","longitude":"-99.69760131835938"},"name":"CR 348 (River Rd) Low-Water Crossing (Kenneth Arthur Crossing/Second Crossing)","distance":"9.54","photoID":"0","difficulty":"N/A","approximate":false},{"type":"waterfall","description":"3.5' drop that is runnable river right at all levels.","id":"105068","location":{"latitude":"29.507699966430664","longitude":"-99.70059967041016"},"name":"The Falls","distance":"10.8","difficulty":"N/A","approximate":false,"photoID":"0"},{"type":"takeout","description":"Bridge is known to be hazardous at high levels, but a new bridge is being constructed that may alleviate that issue.  Take out at river left.","id":"104783","location":{"latitude":"29.49519920349121","longitude":"-99.71170043945312"},"name":"SH 127 Bridge (Neal's Crossing/Concan Crossing/First Crossing)","distance":"11.98","photoID":"0","difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"1809","permitUrl":"","permitInfo":"","description":"Normally a scenic day trip, this section of the Frio also has numerous playspots at higher levels.  At low flows, it is also popular with swimmers and tubers.\n\nDifficulty rating is taken from [Texas Whitewater](http://philosophy.tamu.edu/%7Esdaniel/kayak.html) and paddler beta.  Some rapids described below are not yet rated due to lack of information.\n\nDistances and gradient measured using GIS tools in 2015.","averageGradient":"14","maxGradient":"0","length":"12","correlations":[{"reachID":"1809","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":nul