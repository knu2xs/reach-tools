tor Jason Robertson Surfing","poi_name":"Horseshoe Bend Surf Waves","subject":"Jason Robertson","author":"Rich Bowers","poi_id":null,"photo_date":"1900-01-01T04:02:21.000Z","updated_at":"2022-06-05T04:02:21.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/624","large":"https://api.americanwhitewater.org/image/images/big/624"}},{"id":"12752","ext":"mov","post_id":"9136","description":"Enjoying a Dr. Pep in the wave and riding with a \r\nkayaker's dog Boca","caption":"Drinking and Doggy Style","poi_name":"","subject":"Justin Logan and Boca","author":"Justin Logan","poi_id":null,"photo_date":"1900-01-01T04:03:00.000Z","updated_at":"2022-06-05T04:03:00.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/12752","large":"https://api.americanwhitewater.org/image/images/big/12752"}},{"id":"LN7xZinwRpZTi7ZaUNQKj","ext":"jpg","post_id":"iwMDAVKoWazkM8PSrwcU3","description":"","caption":"Sign","poi_name":null,"subject":"","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":null,"photo_date":"2018-06-14T18:39:24.000Z","updated_at":"2024-06-21T18:39:26.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/LN7xZinwRpZTi7ZaUNQKj","large":"https://api.americanwhitewater.org/image/images/big/LN7xZinwRpZTi7ZaUNQKj"}},{"id":"fzGtPwIRto46fkajsw9VW","ext":"jpg","post_id":"iwMDAVKoWazkM8PSrwcU3","description":"","caption":"Play Park","poi_name":null,"subject":"","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":null,"photo_date":"2018-06-14T18:39:25.000Z","updated_at":"2024-06-21T18:39:26.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/fzGtPwIRto46fkajsw9VW","large":"https://api.americanwhitewater.org/image/images/big/fzGtPwIRto46fkajsw9VW"}},{"id":"FJXEqDRXfyIzEbmi0cdQz","ext":"jpg","post_id":"iwMDAVKoWazkM8PSrwcU3","description":"","caption":"Play Park","poi_name":null,"subject":"","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":null,"photo_date":"2018-06-14T18:39:25.000Z","updated_at":"2024-06-21T18:39:26.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/FJXEqDRXfyIzEbmi0cdQz","large":"https://api.americanwhitewater.org/image/images/big/FJXEqDRXfyIzEbmi0cdQz"}}],"detail":{"id":"587","permitUrl":"","permitInfo":"","description":"**_Lat / Longitude data approximate._**\n\nThe 'Gutter' is about 1/2 hour from Boise near Horseshoe Bend. There are 4 drops. Usually only one or two at the bottom are sticky. You may also be interested in the [Upper Main](http://americanwhitewater.org/content/River/detail/id/4360/) or [Lower Main](http://americanwhitewater.org/content/River/detail/id/4156/) (includes [Climax Wave](http://americanwhitewater.org/content/River/detail/id/4156/#rapid1206)) on the Payette.\n\nThis recreation site is associated with the Horseshoe Bend Hydroelectric Project (FERC P-5376).\n\n**WHEN TO RUN:** Spring through Fall. Even a Winter's day can be fun given enough water. Big-water Springs bring on the 'Bladder Wave'.\n\n**HOW TO GET THERE:** Drive north from Boise on State Hwy 55 for about 22 miles. At Highway 55 mile 62.9 right on Pioneer Road just prior to crossing the first bridge over the Payette and actually entering Horseshoe Bend. Follow this road for 0.7 mile. Just after the pavement ends there is an access road that peels off in sight of the diversion dam to your left. This is a 'park-n-play' feature.\n\n**WHAT ELSE IS IN THE AREA:** LOTS! The Payette South Fork (Canyon, [Swirly Canyon](http://americanwhitewater.org/content/River/detail/id/4121/) and [Staircase runs](http://americanwhitewater.org/content/River/detail/id/596/)), Payette North Fork ( [Cabarton's](http://americanwhitewater.org/content/River/detail/id/591/) class III and [Smiths Ferry-Banks](http://www.americanwhitewater.org/rivers/id/592/) class V sections), Payette Middle Fork runs, as well as the Payette [Upper Main](http://www.americanwhitewater.org/rivers/id/4360/) and [Lower Main](http://americanwhitewater.org/content/River/detail/id/4156/).","averageGradient":null,"maxGradient":null,"length":"0.064","correlations":[{"reachID":"587","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":"A local described 11,000-12,000 as optimal for Bladder wave in 2017, with 11,800 being excellent.","highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"600","beginMediumRunnable":"11000","beginHighRunnable":"12000","endHighRunnable":"14000"},"gaugeInfo":{"name":"PAYETTE RIVER NR HORSESHOE BEND ID","gaugeSource":"USGS","gaugeSourceIdentifier":"13247500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"7960","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"9.11","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"43.943333","longitude":"-116.196667"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/13247500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/13247500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"low-runnable","latestReading":{"value":"7960","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["110172","115436"],"geometry":{"type":"LineString","coordinates":[[-116.190139,43.908747],[-116.19014,43.908746],[-116.190398,43.90856],[-116.190398,43.90856],[-116.190709,43.908328],[-116.190988,43.908053]]},"bannerPhotoID":"624","editedAt":"2023-03-28T15:52:31.000Z"},"updatedAt":1778556537},"meta":{"values":{"primaryGaugeStatus.latestReading.value":[["custom","decimal.js"]],"pointOfInterests.0.location.latitude":[["custom","decimal.js"]],"pointOfInterests.0.location.longitude":[["custom","decim