[{"result":{"data":{"json":{"id":"162","stub":{"id":"162","section":"2. Hangman's Bridge to Hwy 395","altname":"Markleeville to Gardnerville","river":"Carson, East Fork","difficulty":"IIplusstandoutIII","states":["USA-CAL","USA-NEV"]},"primaryGaugeStatus":{"status":"migration-runnable","latestReading":{"value":"923","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"access","description":"If the main put in is too busy, there is a large access next to the river a bit over a half mile upstream.","id":"105761","location":{"latitude":"38.6870002746582","longitude":"-119.75499725341797"},"name":"Alternate Put In","distance":"-0.67","photoID":"0","difficulty":"N/A","approximate":false},{"type":"put-in","description":"There is a convenient ramp down to the river on the downstream river right side of the bridge.","id":"105762","location":{"latitude":"0","longitude":"0"},"name":"Hangman Bridge Put In","distance":"0","photoID":"10896","difficulty":"N/A","approximate":false},{"type":"rapid","description":null,"id":"woKg6LVwtgpIx41E5Ec9o","location":{"latitude":"38.766581","longitude":"-119.715858"},"name":"Sidewinder","distance":"8.41","difficulty":"II+","approximate":false,"photoID":null},{"type":"other","description":"The Carson Hot Springs located on river left have been a draw for this overnight trip but reports indicate that a mud flow severely impacted the water supply and the pools.","id":"L56TPs4Zud113X8iWygMQ","location":{"latitude":"38.769189","longitude":"-119.715431"},"name":"Carson River Hot Spring","distance":"8.59","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":"The take out is on river right at a wide gravel beach.  Carry boats up a steep hill to the large parking area.  There are toilet facilities at this location.","id":"105766","location":{"latitude":"38.868786","longitude":"-119.6924"},"name":"Washoe Road Take-Out","distance":"19.12","photoID":"0","difficulty":"N/A","approximate":false},{"type":"portage","description":"A 30' tall dam and navigational hazard just downstream of the take-out. Be sure to exit the river before this structure.","id":"n7bnJGNdzOB7MfGcZABVm","location":{"latitude":"38.872513","longitude":"-119.693114"},"name":"Ruhenstroth Dam","distance":"19.6","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"101249279","title":null,"post_date":"2012-05-04 04:00:00+00","detail":"Just wanted to post that I have done this river for many years and I did it for the first time this season on this last, tuesday, 5/1 - 5/2 2012. I had a most excellent trip with an overnight at the hotsprings. Everything was great until we got out at the Dam. When we walked to where we had parked our takeout vehicle we found nothing but a pile of ash and marks from where it had been towed. We found out later that someone had come over night and burned our car into nothing more then a metal frame. The police know nothing and can give us no help. I just want to send out a warning to all of those doing this river. We have very little money and losing a vehicle like this is a huge set-back for us. Please all others be wary, I don't wish this stress on anyone!","user":{"name":"Cody"}}],"photos":[{"id":"887637","ext":"jpeg","post_id":"890424","description":"Taken on 4/22/17 @1250cfs showing two channels converging just above main hot springs camp. ","caption":"Rattlesnake drop","poi_name":null,"subject":null,"author":"S.Hayward","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887637","large":"https://api.americanwhitewater.org/image/images/big/887637"}},{"id":"mN08WBYVz3z105mCBERYS","ext":"jpg","post_id":"IkrUH0yiO3SDFwn8ZpLbh","description":"","caption":"Hot spring camp ","poi_name":null,"subject":"","author":"Erik A Johnson","poi_id":null,"photo_date":"2023-04-10T14:22:56.000Z","updated_at":"2023-04-12T14:22:56.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/mN08WBYVz3z105mCBERYS","large":"https://api.americanwhitewater.org/image/images/big/mN08WBYVz3z105mCBERYS"}},{"id":"10897","ext":"jpeg","post_id":"LuQ41gYifikNsWbtOSlEi","description":"View from the bridge.","caption":"Lower East Fork Carson","poi_name":"","subject":"","author":"Thomas O'Keefe","poi_id":null,"photo_date":"2005-05-14T20:07:20.000Z","updated_at":"2023-09-02T20:07:20.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10897","large":"https://api.americanwhitewater.org/image/images/big/10897"}},{"id":"887519","ext":"jpeg","post_id":"890287","description":"New rapid that formed in the high flows of the winter of 2017.","caption":"Rattlesnake Drop Diagram","poi_name":"Rattlesnake Drop","subject":"","author":"Scott Hayward","poi_id":"105756","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/887519","large":"https://api.americanwhitewater.org/image/images/big/887519"}},{"id":"xBchhX5jpvIntOzAFkchq","ext":"jpg","post_id":"IkrUH0yiO3SDFwn8ZpLbh","description":"","caption":"","poi_name":null,"subject":"","author":"Erik A Johnson","poi_id":null,"photo_date":"2023-04-10T14:22:56.000Z","updated_at":"2023-04-12T14:22:56.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/xBchhX5jpvIntOzAFkchq","large":"https://api.americanwhitewater.org/image/images/big/xBchhX5jpvIntOzAFkchq"}},{"id":"10896","ext":"jpeg","post_id":"LuQ41gYifikNsWbtOSlEi","description":"This access on downstream river right serves as the put-in acces for the lower run and the take-out for the upper run.","caption":"Hangman Bridge River Access","poi_name":"","subject":"","author":"Thomas O'Keefe","poi_id":"105762","photo_date":"2005-05-14T20:07:20.000Z","updated_at":"2023-09-02T20:07:20.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/10896","large":"https://api.americanwhitewater.org/image/images/big/10896"}}],"detail":{"id":"162","permitUrl":"","permitInfo":"","description":"The East Fork Carson is a popular and scenic class 2 stretch, but it is more difficult in two respects than the rating can indicate. The water is very cold, so swims could lead to hypothermia. While the rapids are not difficult, they are non-stop in the early miles. The current constantly pushes towards one bank or the other and those banks are undercut cliffs in many areas. Constant manuvering is required to stay in the center of the channel.\n\nPeople often take two days and camp at Carson River Hot Spring, but one day runs are also feasible.\n\nThe run is popular for boaters with whitewater open canoes with float bags and strong whitewater canoeing skills.\n\nThere are toilets at Hangman's Bridge put in, at the take out, and one pit toilet about halfway down. Those camping on the river should bring their own toilet systems, though they are not required.\n\nAccess: To reach put-in, drive south on highway 89/4 to Markleeville, and continue about a mile past town to Hangman's Bridge, where there is an outhouse. You can find better put-in spots upstream between the highway and river. Even on Friday nights, campsites are often available at a USFS campground down a dirt road before the bridge. Shuttles are readily available by inquiring at stores in Markleeville. River Rats Shuttle Service, a family operation since 1986, is run by Teo and Laura Rocha and they can be reached at 775-901-6492. Paul and Gloria Washam operate a long-time company, Family Shuttle Service at 530-694-2966.\n\nTo reach take-out, drive north to highway 88, turn right, and descend into Nevada. You can take a shortcut by turning right on Centerville Lane, and left across a bridge before Dresslerville, although going all the way to Minden and turning right on highway 395 thru Gardnerville works too. On 395 just past the Lahonton Fish Hatchery, turn right onto a dirt road where the highway starts climbing a hill. The BLM parking lot is uphill at the end of the dirt road. This take-out has a reputation for overnight vandalism.\n\n**Other Information Sources:**\n\n[Description in Bill Tuthill's California Creekin](http://cacreeks.com/carson-e.htm).\n\nCassady &amp; Calhoun, Holbek &amp; Stanley, Gerald Meral.","averageGradient":"25","maxGradient":null,"length":"19.1","correlations":[{"reachID":"162","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"400","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"4000"},"gaugeInfo":{"name":"E FK CARSON RV BLW MARKLEEVILLE CK NR MARKLEEVILLE","gaugeSource":"USGS","gaugeSourceIdentifier":"10308200","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"923","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"4.17","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"38.7146274","longitude":"-119.7648985"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/10308200","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/10308200/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"migration-runnable","latestReading":{"value":"923","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["105761","105762","woKg6LVwtgpIx41E5Ec9o","L56TPs4Zud113X8iWygMQ","105766","n7bnJGNdzOB7MfGcZABVm"],"geometry":{"type":"LineString","coordinates":[[-119.765594,38.690068],[-119.765685,38.690205],[-119.766108,38.690697],[-119.76618,38.690738],[-119.766268,38.690885],[-119.766514,38.69104],[-119.766706,38.69122