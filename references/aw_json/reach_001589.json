age/images/medium/686238","large":"https://api.americanwhitewater.org/image/images/big/686238"}},{"id":"686282","ext":"jpeg","post_id":"686280","description":"Drop at Pack Saddle Bridge","caption":"Pack Saddle Bridge","poi_name":"","subject":"","author":"Patrick Neff","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/686282","large":"https://api.americanwhitewater.org/image/images/big/686282"}},{"id":"878488","ext":"jpeg","post_id":"878900","description":"","caption":"","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/878488","large":"https://api.americanwhitewater.org/image/images/big/878488"}}],"detail":{"id":"1589","permitUrl":null,"permitInfo":null,"description":"For more information, see _Keystone Canoeing_ by Gertler, Ed.\n\nKevin Williams 2003-04-07 12:41:20\n\nWonderful little creek that runs into Wills above Railroad Cut Falls.  Starts out with perhaps the most picturesque drop I've run - a class IV - two step fall _under_ a covered bridge!   A few distinct class III drops and consistent class II boogie water in-between.  Gorgeous scenery and pretty much natural surroundings.  I don't have a good gauge reading to go from but if you put-in (above or below the covered bridge) the class II busy water right below should be easily runnable or else you'll end up with a shallow run.  Wills was around 5.5 the last time I ran Brush.  The two times I've run this creek I've combined it with a run down Wills although you could take-out above Railroad Cut Falls.  Careful not to drift into the falls (class V), eddies run out before you think they do.  Look for an S turn (left) in the creek with reddish rocks on the right and a rocky beach on the left.  Scout from the railroad- portage left and walk down until you have a good embankment.  Apparently this one is full of rebar and nasty sharp things.  I've run it at 5.5 down the right and across the nasty hole on the third ledge and seen it run all the way down the left with varying degrees of success.","averageGradient":null,"maxGradient":null,"length":"3.2","correlations":[{"reachID":"1589","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"700","beginMediumRunnable":"800","beginHighRunnable":"2500","endHighRunnable":"5000"},"gaugeInfo":{"name":"Wills Creek below Hyndman, PA","gaugeSource":"USGS","gaugeSourceIdentifier":"01601000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"66","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.92","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"39.81202897","longitude":"-78.7164072"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/01601000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/01601000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"66","dateTime":"2026-05-12T02:15:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["109181","114419"],"geometry":{"type":"LineString","coordinates":[[-78.817349,39.867481],[-78.817356,39.867431],[-78.817391,39.867354],[-78.817448,39.867327],[-78.817683,39.867283],[-78.817854,39.867261],[-78.818317,39.867305],[-78.818724,39.86736],[-78.819058,39.867492],[-78.819393,39.867684],[-78.819864,39.86787],[-78.820234,39.86798],[-78.820555,39.868008],[-78.820861,39.868085],[-78.821118,39.868084],[-78.821331,39.86815],[-78.82141,39.86826],[-78.821388