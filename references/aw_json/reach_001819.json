[{"result":{"data":{"json":{"id":"1819","stub":{"id":"1819","section":"2. Johnson City to Pedernales Falls SP (20 miles)","altname":"","river":"Pedernales","difficulty":"IItoIVstandoutV","states":["USA-TEX"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"12","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":"Parking/access at river right","id":"104925","location":{"latitude":"30.28689956665039","longitude":"-98.39659881591797"},"name":"LCRA Pedernales River Nature Park","distance":"0","photoID":"0","difficulty":"N/A","approximate":false},{"type":"hazard","description":"Runnability unknown.  You can easily put in below the dam without leaving the LCRA park.","id":"104928","location":{"latitude":"30.28753089904785","longitude":"-98.39596557617188"},"name":"Johnson City Dam","distance":"0.11","photoID":"0","difficulty":"N/A","approximate":false},{"type":"hazard","description":"May create a hazard at some levels (beta needed)","id":"104929","location":{"latitude":"30.287500381469727","longitude":"-98.37989807128906"},"name":"Private Low-Water Crossing/Dam","distance":"1.22","photoID":"0","difficulty":"N/A","approximate":false},{"type":"hazard","description":"Likely hazard at some levels","id":"104930","location":{"latitude":"30.278919219970703","longitude":"-98.33511352539062"},"name":"Pedernales Hills Rd (Low Bridge)","distance":"9.58","photoID":"0","difficulty":"N/A","approximate":false},{"type":"access","description":"Alternate takeout for those who would prefer to carry their boat a mile rather than portage/run the falls and do the 3-mile paddle-out.  A trail system leads back to the Pedernales Falls parking area/trailhead.","id":"105134","location":{"latitude":"30.335800170898438","longitude":"-98.26319885253906"},"name":"State Park Boundary","distance":"16.5","photoID":"0","difficulty":"N/A","approximate":false},{"type":"portage","description":"See [separate description](http://www.americanwhitewater.org/content/River/detail/id/10843) for the falls.  Note that, if the river is within the recommended range for the downriver run, Pedernales Falls will be either a Class V or a V+.\n\n**NOTE:  As of this writing, the official park policy is to disallow boaters from putting in or taking out at the falls (although you may, of course, legally portage them.)  If you don't want to run the falls, you can take out at the park boundary and hike a mile to the Pedernales Falls parking area.  You can also portage/run the falls and take out 3 miles below them at the swimming area.  Please respect park regulations and be respectful to rangers.  You are legally allowed to run the river, but the park is legally allowed to control access to it.**","id":"104932","location":{"latitude":"30.339599609375","longitude":"-98.25360107421875"},"name":"Pedernales Falls","distance":"17.18","photoID":"0","difficulty":"V","approximate":false},{"type":"takeout","description":"Official takeout, accessible on river right via a 300-yard foot trail that leads from the swimming area parking lot.","id":"105133","location":{"latitude":"30.311199188232422","longitude":"-98.23979949951172"},"name":"Pedernales Falls SP Swimming Area","distance":"20.03","photoID":"0","difficulty":"N/A","approximate":false}],"alerts":[],"photos":[{"id":"878283","ext":"jpeg","post_id":"878674","description":"Low water view of the slow below the falls","caption":"Slot below the falls, low water","poi_name":null,"subject":null,"author":"Will Reeves","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/878283","large":"https://api.americanwhitewater.org/image/images/big/878283"}},{"id":"878282","ext":"jpeg","post_id":"878673","description":"Low water ledge above the big slide","caption":"Small ledge at low water","poi_name":null,"subject":null,"author":"Will Reeves","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/878282","large":"https://api.americanwhitewater.org/image/images/big/878282"}},{"id":"878281","ext":"jpeg","post_id":"878672","description":"Side view of Pedernales Falls from the beach.","caption":"Pedernales Falls, low water","poi_name":null,"subject":null,"author":"Will Reeves","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/878281","large":"https://api.americanwhitewater.org/image/images/big/878281"}}],"detail":{"id":"1819","permitUrl":"","permitInfo":"","description":"The Perd doesn't go very often, but when it goes, it goes big.  The river bed is extraordinarily wide (often well over 100 yards), but unlike the Upper Perd, this stretch tends to channelize the flow much more, and thus it is runnable at much lower levels.  At very high water (10,000+ cfs), the features become Grand Canyon-sized.  For more specific beta, see [Texas Whitewater](http://philosophy.tamu.edu/%7Esdaniel/kayak.html).\n\nThe crux of the run is near the end.  Pedernales Falls is a series of three features spaced about 200 yards apart.  At levels where the downriver run is worth doing, the falls are likely to be deadly, so most boaters choose to take out at river right in the large pool above the top drop and portage the rest of the falls, or to run just the top drop and portage The Slide and S-Turn.  The best time to huck the falls is when the river is low and the rest of the run is scrapey.  See [separate description](http://www.americanwhitewater.org/content/River/view/river-detail/10843) for the falls for level-specific beta.\n\n**NOTE:  As of this writing, the official park policy is to disallow boaters from putting in or taking out at the falls (although you may, of course, legally portage them.)  If you don't want to run the falls, you can take out at the park boundary and hike a mile to the Pedernales Falls parking area.  You can also portage/run the falls and take out 3 miles below them at the swimming area.  Please respect park regulations and be respectful to rangers.  You are legally allowed to run the river, but the park is legally allowed to control access to it.**\n\nDistances and gradient measured using GIS tools in 2015.  Average gradient from Johnson City to the top of Pedernales Falls = 14 fpm.  Maximum gradient is 132 fpm, measured from the top of 60/40 Falls to the base of S-Turn (0.34 miles.)","averageGradient":"16","maxGradient":"132","length":"20.3","correlations":[{"reachID":"1819","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":"50 - 800 cfs Pedernales Falls is a good park 'n' huck, but the river is too low for a downriver run. ** 800 - 1500 cfs falls become Class V, but the downriver run is still on the low side.","lowRunnableRangeComment":"Falls are Class V to V+ at these levels.","mediumRunnableRangeComment":"Falls are Class V to V+ at these levels.","highRunnableRangeComment":"Falls are Class V to V+ at these levels.","aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"1500","beginMediumRunnable":"5000","beginHighRunnable":"10000","endHighRunnable":"15000"},"gaugeInfo":{"name":"Pedernales Rv nr Johnson City, TX","gaugeSource":"USGS","gaugeSourceIdentifier":"08153500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"12","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"10.3","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"30.29187379","longitude":"-98.3994904"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/08153500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/08153500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status"