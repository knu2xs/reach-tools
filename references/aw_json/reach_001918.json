[{"result":{"data":{"json":{"id":"1918","stub":{"id":"1918","section":"3. St. Paul to Dungannon","altname":"","river":"Clinch","difficulty":"II","states":["USA-VRG"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"279","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"110201","location":{"latitude":"36.9015007019043","longitude":"-82.3080978393555"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"115464","location":{"latitude":"36.8246002197266","longitude":"-82.4633026123047"},"name":"Take Out","distance":"18","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"100349269","title":null,"post_date":"2008-06-06 04:00:00+00","detail":"There is a semi-submerged snag at the bottom of the big ledge just downstream of the Rt 58 bridge in St Paul. The snag is in the center-left portion of the main chute in the middle of the river. The snag is not visible from upriver until you are entering the rapid. I saw this snag during the last week of May 2008, could not tell how extensive it is because only a little of it poked above water.\nZack Fields","user":null}],"photos":[{"id":"50962","ext":"jpeg","post_id":"877290","description":"Located between Oxbow Park and Industrial Park put in.  Can see by walking path at industrial park.  103cfs at time of picture.","caption":"St. Paul ","poi_name":"","subject":"","author":"IronOar","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/50962","large":"https://api.americanwhitewater.org/image/images/big/50962"}}],"detail":{"id":"1918","permitUrl":null,"permitInfo":null,"description":"Long easy trip for some fun in a canoe or a playboat when it is in flood.\n\nSome waves and holes here and there, but mainly flat moving water except for the still hole at Millers Yard after the Guest and Little Stony confluences with the Clinch.\n\nIf you paddle from St Paul, you can stop at the first major tributary on RR and a short distance upstream is a nice waterfall. But don't drag the boats, it is unrunnable. Unless you're stoopid. This falls lands on rocks and in a 12' deep pool. Not going to happen, don't care who you are.\n\nMakes for a good photo tho.\n\nSee Also:\n\n_Classic Virginia Rivers,_ Ed Grove (1992 ed), p. 327.\n\n_Virginia Whitewater_, Roger Corbett (2000 ed.), p. 398.\n\n_Exploring Virginia's Waterways_, Ed Gertler (2022 ed.), p. 364.","averageGradient":null,"maxGradient":null,"length":"17","correlations":[{"reachID":"1918","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"300","beginMediumRunnable":"707","beginHighRunnable":"3500","endHighRunnable":"10000"},"gaugeInfo":{"name":"CLINCH RIVER AT CLEVELAND, VA","gaugeSource":"USGS","gaugeSourceIdentifier":"03524000","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"279","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"2.05","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"36.9448295","longitude":"-82.1548569"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/03524000","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/03524000/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"279","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["11