[{"result":{"data":{"json":{"id":"1315","stub":{"id":"1315","section":"Twin Falls","altname":"State Put-in to Degrasse","river":"Grass, Lower S. Branch","difficulty":"IVtoV","states":["USA-NYO"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"659","dateTime":"2026-05-12T02:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"108323","location":{"latitude":"44.3053","longitude":"-74.9945"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"waterfall","description":"This is the first tree top horizon line you come to. Scout right side then left if you consider running this. It is normally portaged left. Safety is difficult. The hole at the bottom of the falls can be bad at high flows and the wall on the right below the drop is a magnet for flipped paddlers and makes rolling tough.\n\n_Lat/longitude coords are approximate, from online maps._","id":"1260","location":{"latitude":"44.30634689331055","longitude":"-74.99868774414062"},"name":"Large Marge (Rainbow Falls)","distance":"0.2","difficulty":"V+","approximate":false,"photoID":"5907"},{"type":"rapid","description":"The river narrows down and makes a nice continuous set of rapids for about 0.3mi that is punctuated with a river wide hole \"Whip-it Good\" near the end. At higher flows this hole can be real sticky. Stay left.","id":"1267","location":{"latitude":"0","longitude":"0"},"name":"Whip-it Good","distance":"0.6","difficulty":"IV","approximate":false,"photoID":null},{"type":"rapid","description":"Ledge slide drop with multiple lines and a sticky hole at the bottom.","id":"1261","location":{"latitude":"44.31829071044922","longitude":"-75.00773620605469"},"name":"Flat Rock Falls","distance":"1.3","difficulty":"IV","approximate":false,"photoID":"0"},{"type":"rapid","description":"Scout Left.","id":"1262","location":{"latitude":"44.33150100708008","longitude":"-75.02239990234375"},"name":"Adrenaline Falls (Stewart Rapid)","distance":"3","difficulty":"IV","approximate":false,"photoID":"881812"},{"type":"waterfall","description":"This 30'(+)ledge slide is a rocket launching pad! Scout right. If you don't see the line think about walking. Hint try and finish between the two Rooster Tails at the bottom right. Getting off-line or flipping can be ugly.","id":"1263","location":{"latitude":"44.332698822021484","longitude":"-75.02549743652344"},"name":"Twin Falls","distance":"3.25","difficulty":"IV+","approximate":false,"photoID":"881839"},{"type":"rapid","description":"The Iron Bridge crossing the river marks this drop (bridge connects Lake George Rd to Tooley Pd Rd). Watch the hole at the bottom, it can/will eat your lunch, especially at high water. Scout right at Med and low flows, high flows scout left. Portage is easiest left I'm told.","id":"1264","location":{"latitude":"44.33810043334961","longitude":"-75.0468978881836"},"name":"Iron Bridge (Sinclair Falls)","distance":"4.3","difficulty":"IV+","approximate":false,"photoID":"881840"},{"type":"rapid","description":"Multiple lines. Left side slide is easier. The center ledges and holes offer a tricky CL V option. Scout the center and right lines from the right. Scout Left line from the left. -","id":"1265","location":{"latitude":"44.34040069580078","longitude":"-75.05799865722656"},"name":"Basford Falls","distance":"5.1","difficulty":"IV","approximate":false,"photoID":"881841"},{"type":"takeout","description":"This rapid looks intimidating, but a great finish to great run. The hole can be sticky at high water.","id":"1266","location":{"latitude":"0","longitude":"0"},"name":"Degrasse Graffiti","distance":"6.5","photoID":null,"difficulty":"IV","approximate":false}],"alerts":[{"id":"lASf9Z8b6GMvNLkOhVjo4","title":"Tree below Large Marge","post_date":"2021-03-30 15:54:24+00","detail":"There is a river wide tree wedged across the flow below Large Marge. Boaters must be on the river left shoreline below the falls to avoid the tree. There is also a buoy and cable that appears to be attached to the tree which may be a hazard.","user":{"name":"Alex Barham"}},{"id":"101250938","title":null,"post_date":"2014-04-19 04:00:00+00","detail":"There is a river wide log in the rapid under the Degrasse takeout bridge. When you check the visual gauge on the rock you will see it.","user":{"name":"Jim Dobbins"}}],"photos":[{"id":"6928","ext":"jpeg","post_id":"2658","description":"","caption":"Degrasse Rapid","poi_name":"Degrasse Flume","subject":"","author":"Pat Rogers","poi_id":"1266","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6928","large":"https://api.americanwhitewater.org/image/images/big/6928"}},{"id":"4194","ext":"jpeg","post_id":"4775","description":"More of my photos can be found on my <a href=\"http://www.kayakingphotos.com\">NEW kayakingphotos.com page</a> and my <a href=\"http://www.americanwhitewater.org/photos/?rivername=&rapidname=&title=&author=patrick+rogers&subject=&state=any&max=15&orderby=id&sort=desc&incphotos=on&incvideos=on&ext=&dosearch=Photo+Search\">American Whitewater page</a>.","caption":"Grass River","poi_name":"","subject":"Steve","author":"Patrick Rogers","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/4194","large":"https://api.americanwhitewater.org/image/images/big/4194"}},{"id":"4195","ext":"jpeg","post_id":"4775","description":"More of my photos can be found on my <a href=\"http://www.kayakingphotos.com\">NEW kayakingphotos.com page</a> and my <a href=\"http://www.americanwhitewater.org/photos/?rivername=&rapidname=&title=&author=patrick+rogers&subject=&state=any&max=15&orderby=id&sort=desc&incphotos=on&incvideos=on&ext=&dosearch=Photo+Search\">American Whitewater page</a>.","caption":"Grass River","poi_name":"","subject":"Dennis Squires","author":"Patrick Rogers","poi_id":null,"photo_dat