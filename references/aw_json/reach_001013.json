mages/medium/iw6R3z6YBAOnHifKlSisU","large":"https://api.americanwhitewater.org/image/images/big/iw6R3z6YBAOnHifKlSisU"}},{"id":"889831","ext":"jpeg","post_id":"892368","description":"","caption":"S turn road view ","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/889831","large":"https://api.americanwhitewater.org/image/images/big/889831"}},{"id":"891909","ext":"jpg","post_id":"895820","description":null,"caption":" on Madison @2) Quake Lake to 1.5 miles downstream","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/891909","large":"https://api.americanwhitewater.org/image/images/big/891909"}},{"id":"6370","ext":"jpeg","post_id":"6636","description":"","caption":"Jason Matthews at the S-Turn","poi_name":"S-Turn","subject":"Jason Matthews","author":"David Schroeder","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6370","large":"https://api.americanwhitewater.org/image/images/big/6370"}},{"id":"6565","ext":"jpeg","post_id":"6635","description":"","caption":"Mark at S-Turn","poi_name":"S-Turn","subject":"Mark","author":"David Schroeder","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/6565","large":"https://api.americanwhitewater.org/image/images/big/6565"}},{"id":"11851","ext":"jpeg","post_id":"8844","description":"Pat Rogers, IPA, tackles the \"big V\" the near the top of S-turn.  Punch it in the gut or skirt it on the left, either way, bust hard left and avoid the next two holes in the middle. ","caption":"Pat Rogers, IPA, S-turn","poi_name":"S-turn","subject":"Pat Rogers, IPA","author":"Ben Whaley","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/11851","large":"https://api.americanwhitewater.org/image/images/big/11851"}},{"id":"889211","ext":"jpeg","post_id":"891899","description":"S-Turn on rare nice weather day.","caption":"S-Turn","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/889211","large":"https://api.americanwhitewater.org/image/images/big/889211"}},{"id":"889212","ext":"jpeg","post_id":"891900","description":"Matt sees his shadow, six more weeks of winter?","caption":"S-Turn Boof","poi_name":null,"subject":null,"author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/889212","large":"https://api.americanwhitewater.org/image/images/big/889212"}},{"id":"V73cCFThbTIHxm37fVnTA","ext":"jpg","post_id":"ll950ExWPoCXw9xhefNmG","description":null,"caption":"Madison @2) Quake Lake to 1.5 miles downstream","poi_name":null,"subject":null,"author":null,"poi_id":null,"photo_date":null,"updated_at":"2021-07-16T01:17:07.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/V73cCFThbTIHxm37fVnTA","large":"https://api.americanwhitewater.org/image/images/big/V73cCFThbTIHxm37fVnTA"}},{"id":"11850","ext":"jpeg","post_id":"8844","description":"The IPA lines it up on S-turn.  Front to back; Pat Rogers, Chi-town Ben, Joe Booth","caption":"IPA on S-turn","poi_name":"S-turn","subject":"Inedendent Paddlers Association","author":"Ben Whaley, IPA","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/11850","large":"https://api.americanwhitewater.org/image/images/big/11850"}},{"id":"11849","ext":"jpeg","post_id":"8845","description":"Joe Booth, IPA, gets a good look at the sharp rocks of quake.  A bomber roll is a must for this fast moving section with nothing but sharp landslide rocks on its river bed","caption":"Bottoms up","poi_name":"S-Turn","subject":"Joe Booth, IPA","author":"Ben Whaley, IPA","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/11849","large":"https://api.americanwhitewater.org/image/images/big/11849"}}],"detail":{"id":"1013","permitUrl":null,"permitInfo":null,"description":"On August 17th, 1959 at 11:37 PM a major earthquake rocked the Greater Yellowstone Area. Rating a 7.5 on the Richter Scale, this quake was the largest in the documented history of Montana and took the greatest toll on human life. An entire mountainside came tumbling down on a crowded forest service campground before charging a full 400 feet up the opposite mountainside. This slide completely dammed the Madison River, eventually forming Earthquake Lake. The Army Corp of Engineers cut a new path for the river through the debris and this is now a SW Montana padling classic.\n\nThe run starts across from the Quake Lake visitors center on Montana Hwy 287. A dirt path leads down to where the lake once again becomes a river. From the moment you drift through the skeletal reamins of the forest poking up from the lake bottom, you are faced with continuous class IV boogie water requiring good read and run paddling skills. Though not overly difficult, the upper section is shallow and extremely sharp. A swim would be painful at best.\n\nAs you fly down the run, keep your eyes peeled for a big eddy on river left, just before the river bends hard to the right. You will be directly below the main part of the slide. Catch this eddy and scout the next 120 yards. This rapid, known as the S-Turn, is known for carnage and has drawn its fair share of blood. It is a definite class V at all levels but can easily be portaged on the left.\n\nBelow this drop, the river mellows quickly and you can take out wherever you like as Hwy. 287 follows this run in its' entirety. Most folks run it two or three times in a day. Enjoy!","averageGradient":"155","maxGradient":null,"length":"1.5","correlations":[{"reachID":"1013","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"700","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"2700"},"gaugeInfo":{"name":"Madison River bl Hebgen Lake nr Grayling MT","gaugeSource":"USGS","gaugeSourceIdentifier":"06038500","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"468","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"1.23","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"44.86639167","longitude":"-111.3387806"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/06038500","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/06038500/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"468","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["111458","YCDZUq19wWCW3Oi2hWQx3","116729"],"geometry":{"type":"LineString","coordinates":[[-111.422918,44.829846],[-111.423107,44.82983],[-111.423226,44.82982],[-111.424054,44.829562],[-111.424552,44.82926],[-111.424881,44.828858],[-111.424918,44.8284],[-111.425132,44.827998],[-111.426044,44.827996],[-111.426488,44.827928],[-111.426883,44.82778],[-111.42717,44.827534],[-111.427427,44.827358],[-111.428072,44.827214],[-111.42862,44.827251],[-111.429115,44.827264],[-111.429441,44.827158],[-111.429743,44.826892],[-111.430234,44.826645],[-111.431144,44.826577],[-111.431675,44.826611],[-111.4323,44.826542],[-111.432629,44.826639],