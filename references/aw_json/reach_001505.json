mericanwhitewater.org/image/images/medium/JNULfxIUS98qmo7DjztRg","large":"https://api.americanwhitewater.org/image/images/big/JNULfxIUS98qmo7DjztRg"}},{"id":"haWXxqiFV9HhLXBnvgDK0","ext":"jpg","post_id":"TvQKhNHmXa0se4c1IrmWL","description":"","caption":"Approaching Big Eddy Rapid","poi_name":null,"subject":"","author":"Thomas O'Keefe and Rie Yamazaki","poi_id":null,"photo_date":"2019-03-28T19:38:35.000Z","updated_at":"2023-02-25T19:38:35.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/haWXxqiFV9HhLXBnvgDK0","large":"https://api.americanwhitewater.org/image/images/big/haWXxqiFV9HhLXBnvgDK0"}},{"id":"882497","ext":"jpeg","post_id":"885189","description":"Sous Hole- around 1200 cfs","caption":"","poi_name":null,"subject":"David Kinker","author":"Matt Deacon","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/882497","large":"https://api.americanwhitewater.org/image/images/big/882497"}}],"detail":{"id":"1505","permitUrl":"","permitInfo":"","description":"This is the Big Eddy section which is a popular summer raft trip for outfitters in Bend who take clients down throughout the summer.\n\nA good portion of this short run is flat water through a scenic reach of National Forest with a bit of class II.\n\nThe highlight is Big Eddy rapid which is a long class III+ rapid that can feel pushy for newer boaters. The trail on river left makes it easy to hike back up and do laps on the main rapid. Many boaters do laps on Big Eddy to try to get ready for the more difficult Meadocamp section, a few miles downstream. Make sure to takeout on river left before Lava Island Falls, a powerful class V rapid just downstream.  In the fall and spring, when flows are switching between summer and winter levels, Sous Hole becomes a very good park and play hole. Ideal levels for Sous are 1200-1600 cfs.\n\nFor additional information on recreational opportunities see the [Deschutes National Forest web site](https://www.fs.usda.gov/main/deschutes/).\n\nLogistics: Take Highway 372 out of Bend and at mile marker 7.6 turn on to Forest Road 41.\n\nAt mile 0.4 on Forest Road 41 turn left onto 4100-800, follow this 0.6 mile, then turn left on Forest Road 4100-850 to reach the river access and take-out at Lava Island Falls Day Use Area.\n\nTo reach the put-in, continue on Forest Road 41 to mile 1.6 and turn left onto Forest Road 4100-700. Continue 0.3 mile to a junction and stay right to remain on 4100-700 and in 1.0 mile you will reach the river at Aspen that serves as the put-in for this segment.","averageGradient":"0","maxGradient":"0","length":"2","correlations":[{"reachID":"1505","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"500","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"2200"},"gaugeInfo":{"name":"Deschutes River at Benham Falls, OR","gaugeSource":"USBR","gaugeSourceIdentifier":"beno","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"1610","dateTime":"2026-05-11T19:30:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"4.7","dateTime":"2026-05-11T19:30:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"43.930277777777775","longitude":"-121.41083333333333"},"externalSourceLinks":{"sourceLink":{"url":"https://www.usbr.gov/pn/hydromet/rtgraph.html?list=beno%20q&daily=beno","text":"US Bureau of Reclamation"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"migration-runnable","latestReading":{"value":"1610","dateTime":"2026-05-11T19:30:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null}}],"pointOfInterestIDs":["109797","TgszOCNVxCz7wJd5w8if8","115049"],"geometry":{"type":"LineString","coordinates":[[-121.41