[{"result":{"data":{"json":{"id":"774","stub":{"id":"774","section":"U.S. 201 to Cathance Rd","altname":"","river":"Cathance (Sagadahoc Co.)","difficulty":"IIItoIVstandoutV","states":["USA-MAI"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"put-in","description":null,"id":"108709","location":{"latitude":"43.9562","longitude":"-69.969002"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"113944","location":{"latitude":"43.9618","longitude":"-69.930603"},"name":"Take Out","distance":"3.5","photoID":null,"difficulty":"N/A","approximate":false},{"type":"waterfall","description":"This waterfall is just after the takeout at Head of Tide Park and is the point where the Cathance reaches the ocean. At high (and preferably VERY high) tides, this can be paddled carefully, though it is best to thoroughly scout the landing zone. As the tide goes down, it rapidly exposes rocks and mud flats.","id":"107405","location":{"latitude":"0","longitude":"0"},"name":"Ankle Breaker","distance":"3.55","difficulty":"IV+","approximate":false,"photoID":"0"}],"alerts":[{"id":"100984756","title":null,"post_date":"2009-08-02 04:00:00+00","detail":null,"user":null}],"photos":[{"id":"zfY1Z7LRo6i6aKaRSEPbf","ext":"jpg","post_id":"bhmIumkA7hY20J3apf80g","description":"","caption":"Cathance River Hiking Trails and Location of Rapids","poi_name":null,"subject":"","author":"Eric Nathanson","poi_id":null,"photo_date":"2025-05-15T12:27:09.000Z","updated_at":"2025-05-15T12:27:09.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/zfY1Z7LRo6i6aKaRSEPbf","large":"https://api.americanwhitewater.org/image/images/big/zfY1Z7LRo6i6aKaRSEPbf"}},{"id":"877330","ext":"jpeg","post_id":"877565","description":"The line is right down the middle..its pretty straight forward. Avoid the pour over on the left its sticky and shallow","caption":"Cave Drop","poi_name":null,"subject":null,"author":"Josh Geib","poi_