mages/big/42522"}},{"id":"42884","ext":"jpeg","post_id":"10211","description":"kyle crankin 1 out in lil suzy's","caption":"lil suzy's flume o death","poi_name":"lil suzy's flume o death","subject":"kyle b","author":"joe c","poi_id":"885","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/42884","large":"https://api.americanwhitewater.org/image/images/big/42884"}},{"id":"42888","ext":"jpeg","post_id":"10211","description":"","caption":"lil suzy's","poi_name":"lil suzy's","subject":"kyle b","author":"joe c","poi_id":"885","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/42888","large":"https://api.americanwhitewater.org/image/images/big/42888"}},{"id":"42889","ext":"jpeg","post_id":"10211","description":"","caption":"over the top!","poi_name":"washing machine","subject":"tracy t","author":"joe c","poi_id":"885","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/42889","large":"https://api.americanwhitewater.org/image/images/big/42889"}},{"id":"42886","ext":"jpeg","post_id":"10211","description":"","caption":"lil suzy's","poi_name":"lil suzy's","subject":"tracy t","author":"joe c","poi_id":"885","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/42886","large":"https://api.americanwhitewater.org/image/images/big/42886"}},{"id":"42885","ext":"jpeg","post_id":"10211","description":"","caption":"lil suzy's flume o death","poi_name":"lil suzy's flume o death","subject":"joe c","author":"","poi_id":"885","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/42885","large":"https://api.americanwhitewater.org/image/images/big/42885"}},{"id":"42890","ext":"jpeg","post_id":"10211","description":"pj throwin a peace sign and showin out 4 the ladies as usual!","caption":"pj playin it up!","poi_name":"washing machine","subject":"greg stacy","author":"joe c","poi_id":"885","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/42890","large":"https://api.americanwhitewater.org/image/images/big/42890"}},{"id":"42887","ext":"jpeg","post_id":"10211","description":" boofin in over the top @ the machine!","caption":"over da top!(washing machine)","poi_name":"washing machine","subject":"joe c","author":"","poi_id":"885","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/42887","large":"https://api.americanwhitewater.org/image/images/big/42887"}},{"id":"fwko5LVQsCe06rHcv6tUl","ext":"jpg","post_id":"fwko5LVQsCe06rHcv6tUl","description":"","caption":"washing machine @3.5","poi_name":null,"subject":"washing machine @3.5","author":"","poi_id":null,"photo_date":"2021-04-27T13:00:00.000Z","updated_at":"2021-04-29T20:13:16.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/fwko5LVQsCe06rHcv6tUl","large":"https://api.americanwhitewater.org/image/images/big/fwko5LVQsCe06rHcv6tUl"}},{"id":"2141","ext":"jpeg","post_id":"4066","description":"BIG WATER FUN!","caption":"Jason over the Machine","poi_name":"Washing Machine","subject":"Jason Mellor","author":"Marysia Jastrzebski","poi_id":"885","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/2141","large":"https://api.americanwhitewater.org/image/images/big/2141"}},{"id":"2145","ext":"jpeg","post_id":"4068","description":"Recovering a swimmer's boat at the top of the Washing Machine ","caption":"Boat Rescue","poi_name":"Washing Machine","subject":"Cowper, John and Randy","author":"Marysia Jastrzebski","poi_id":"885","photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/2145","large":"https://api.americanwhitewater.org/image/images/big/2145"}},{"id":"JOSaKzaVgkvrlP04Q06Be","ext":"jpg","post_id":"JOSaKzaVgkvrlP04Q06Be","description":"Pretty bony but definitely doable at this level. My buddies with a raft couldn’t fit so I just did it and hiked back up with them running safety.","caption":"first time out to the cossatot! definitely plan to come back for some more!","poi_name":null,"subject":"first time out to the cossatot! definitely plan to come back for some more!","author":"","poi_id":null,"photo_date":"2021-04-20T13:00:00.000Z","updated_at":"2021-04-29T20:11:35.000Z","url":{"medium":"https://api.americanwhitewater.org/image/images/medium/JOSaKzaVgkvrlP04Q06Be","large":"https://api.americanwhitewater.org/image/images/big/JOSaKzaVgkvrlP04Q06Be"}}],"detail":{"id":"92","permitUrl":"","permitInfo":"","description":"**Put-in:** To reach the Falls, Sandbar bridge and Ed Banks access points, go East from the takeout and turn left on either the first road (high water route) or second road (main route). Both roads are rough dirt/gravel and have signs directing to the Falls and access points. The first road is longer but is located between the Hwy 278 bridges over the Cossatot and Baker Creek. The second road is East of the Hwy 278 bridge and crosses the normal low-water take-out bridge for [Baker creek.](http://www.americanwhitewater.org/rivers/id/86/) Normally passable when the Cossatot is below 6 feet.\n\nAlternate access to the Falls and access points can be reached from these roads where they connect with Hwy 246 (East side of River).\n\n**Take-out:** Reached by taking the access road on the West side of the Hwy 278 bridge over the River. Located about 9 miles East of Hwy 278/Hwy 71 intersection in Wickes.\n\nThose who don't wish to paddle the falls, can opt for the 2 mile class III run from Ed Banks access to the Sandbar Bridge or the Falls access points. The Falls access can be used as a park and play area, as the carry back up the falls is not too bad.\n\nMain rapids are The Esses, The Falls, Deer Camp Rapid, Devil's Hollow Rapid and Devil Hollow Falls. Several other class II-III ledge type drops are scattered throughout the run with small pools in-between.\n\nThere are nice but small campgrounds at the Falls and at Hwy 278. Both campgrounds offer nice tent sites and tables, the Falls has a restroom and campsite fees. Hwy 278 currently only has a portajohn and no fees. Primitive free camping is available near Ed Banks Bridge and Sandbar Bridge above the Falls.\n\nGradient by mile: 25, 25, 45, 15, 30, 5. The Falls area drops 30+ feet in about 0.25 miles.\n\nMore info at the [Cossatot River State Park - Natural Area](http://www.arkansasstateparks.com/cossatotriver/) site.","averageGradient":"20","maxGradient":"45","length":"6.4","correlations":[{"reachID":"92","isPrimary":true,"correlationDetails":{"metric":"levelFT","belowRecommendedRangeComment":null,"lowRunnableRangeComment":null,"mediumRunnableRangeComment":null,"highRunnableRangeComment":null,"aboveRecommendedRangeComment":null,"lowRunnableAdjustedDifficulty":null,"highRunnableAdjustedDifficulty":null,"beginLowRunnable":"3","beginMediumRunnable":null,"beginHighRunnable":null,"endHighRunnable":"6"},"gaugeInfo":{"name":"Cossatot River near Vandervoort, AR","gaugeSource":"USGS","gaugeSourceIdentifier":"07340300","gaugeFetchStatus":"ACTIVE","latestFlowReading":{"value":"30","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"latestStageReading":{"value":"2.27","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"location":{"latitude":"34.38","longitude":"-94.2363889"},"externalSourceLinks":{"sourceLink":{"url":"https://water.noaa.gov/gauges/07340300","text":"NOAA"},"secondaryLink":{"url":"https://waterdata.usgs.gov/monitoring-location/07340300/#parameterCode=00060&period=P7D","text":"US Geological Survey"}}},"migrationErrorExplanation":null,"comment":null,"status":{"status":"below-recommended","latestReading":{"value":"2.27","dateTime":"2026-05-12T03:00:00.000Z","qualifier":"NORMAL"},"metric":"levelFT","adjustedDifficulty":null}}],"pointOfInterestID