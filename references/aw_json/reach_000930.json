[{"result":{"data":{"json":{"id":"930","stub":{"id":"930","section":"B) Swimming Hole Ck.CG to Boney Falls Basin (10 miles)","altname":"","river":"Escanaba","difficulty":"ItoII","states":["USA-MCH"]},"primaryGaugeStatus":{"status":"below-recommended","latestReading":{"value":"1180","dateTime":"2026-05-12T02:45:00.000Z","qualifier":"NORMAL"},"metric":"cfs","adjustedDifficulty":null},"pointOfInterests":[{"type":"put-in","description":null,"id":"111804","location":{"latitude":"46.0863","longitude":"-87.345299"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"takeout","description":null,"id":"117076","location":{"latitude":"45.992298","longitude":"-87.270401"},"name":"Take Out","distance":"0","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[],"photos":[],"detail":{"id":"930","permitUrl":null,"permitInfo":null,"description":"Put-in at Swimming Hole Ck.Campground on River Rd 8 miles W of town of Rock.\n\nTake-out is at boat landing on river right as you encounter Boney Falls Basin (flowage behind dam).\n\nRiver is generally wide, open channel with fast current and some standing waves (at increasingly higher levels). (There are NO significant obstructions and NO real rapids.)\n\nGoogle Maps has excellent resolution aerials of this reach. We highly recommend going to the \"Access\" tab, clicking the put-in coordinates, clicking lower-left inset to switch view to 'Satellite',  and doing a 'virtual tour' to 'walk' down the reach. You'll see no discernable rapids. (Ok, maybe a minor rock garden or two.)","averageGradient":"10","maxGradient":"10","length":"9.8","correlations":[{"reachID":"930","isPrimary":true,"correlationDetails":{"metric":"cfs","belowRecommendedRangeComment":null,"lowRunnableRangeComment":"Low-boatable range. Suitable for novice whitewater paddlers.","mediumRunnableRangeComment":"Moderate flows. Suitable for intermediate whitewater boaters.","highRunnableRangeComment":"High, pushy flows. Suitable