[{"result":{"data":{"json":{"id":"1892","stub":{"id":"1892","section":"Route 611 to Route 609","altname":"","river":"Barbours Creek","difficulty":"IItoIIIplusstandoutIV","states":["USA-VRG"]},"primaryGaugeStatus":null,"pointOfInterests":[{"type":"takeout","description":null,"id":"118018","location":{"latitude":"37.5303001403809","longitude":"-80.0366973876953"},"name":"Take Out","distance":"0","photoID":null,"difficulty":"N/A","approximate":false},{"type":"put-in","description":null,"id":"112735","location":{"latitude":"37.5471000671387","longitude":"-80.1233978271484"},"name":"Put In","distance":"0","photoID":null,"difficulty":"N/A","approximate":false}],"alerts":[{"id":"100832965","title":null,"post_date":"2009-05-11 04:00:00+00","detail":"Always beware of strainers on this run. Look for them safely when you set shuttle. They are there and likely always will be. I also had a close call with a rogue cable about 1/4 inch diameter that wrapped me and my boat about 75 ft above Salty Pepper. When I spun it off I saw it was attached to a tree river right.","user":{"name":"John Layman"}}],"photos":[{"id":"43111","ext":"jpeg","post_id":"9944","description":"Jeff kickin it over the top ledge of Barbours Creek Falls ( aka Double Ledge).\r\nThis rapid is preceeded by an unusually large flat section of the creek that the top ledge backs up, so it shouldnt surprise you. ","caption":"Barbours Creek Falls","poi_name":"barbours creek falls (double ledge)","subject":"j barbour","author":"jlayman","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/43111","large":"https://api.americanwhitewater.org/image/images/big/43111"}},{"id":"42677","ext":"jpeg","post_id":"9943","description":"low angle slide. wide. very shallow. ","caption":"one of two long slides","poi_name":"","subject":"chall / JGO","author":"jlayman","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/42677","large":"https://api.americanwhitewater.org/image/images/big/42677"}},{"id":"43163","ext":"jpeg","post_id":"9942","description":"","caption":"put in bridge","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/43163","large":"https://api.americanwhitewater.org/image/images/big/43163"}},{"id":"43162","ext":"jpeg","post_id":"9945","description":"The Barbours 'gauge' was at -2 on 5-7 and +1 on 5-10   (+2 on 5-9)","caption":"local drainage area","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/43162","large":"https://api.americanwhitewater.org/image/images/big/43162"}},{"id":"43165","ext":"jpeg","post_id":"9946","description":"we got under it at -2 but took no chances at +1\r\n","caption":"typical strainer","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/43165","large":"https://api.americanwhitewater.org/image/images/big/43165"}},{"id":"42670","ext":"jpeg","post_id":"9943","description":"as of 3-16-09 the strainer in the foreground goes out & barely past the center eddy from river right to left. ","caption":"cartman's ledge","poi_name":"","subject":"chall","author":"jlayman","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/42670","large":"https://api.americanwhitewater.org/image/images/big/42670"}},{"id":"43151","ext":"jpeg","post_id":"9946","description":"it'll keep","caption":"the part time recycler","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/43151","large":"https://api.americanwhitewater.org/image/images/big/43151"}},{"id":"43160","ext":"jpeg","post_id":"9944","description":"i painted the picture so we can share some flow feedback. when your there you can see the lines in the concrete from where it was poured. ","caption":"Put In Gauge","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/43160","large":"https://api.americanwhitewater.org/image/images/big/43160"}},{"id":"43164","ext":"jpeg","post_id":"9946","description":"im calling it +1.....it soon dropped to -2 by late afternoon....","caption":"gauge","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/43164","large":"https://api.americanwhitewater.org/image/images/big/43164"}},{"id":"43169","ext":"jpeg","post_id":"9946","description":"taken after lap #1 at +1 and falling... dropped below \"0\" for second lap. We got over the bridge w/o scraping to a halt at this level. ","caption":"low water bridge at +1","poi_name":"low water bridge","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/43169","large":"https://api.americanwhitewater.org/image/images/big/43169"}},{"id":"43152","ext":"jpeg","post_id":"9945","description":"Barbours was already primed and around -2 on Thursday. The rain hit Friday night and dropped an inch in Newcastle and by Saturday morning at 10:30 it was beautiful. We opted to wait till Sunday AM to hit it up and caught it still at +1....","caption":"No Gauge? No Problem.","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/43152","large":"https://api.americanwhitewater.org/image/images/big/43152"}},{"id":"43153","ext":"jpeg","post_id":"9944","description":"\r\nthis is the gorilla walk / seesaw off when its around minimum. ","caption":"low water bridge","poi_name":"","subject":"","author":"","poi_id":null,"photo_date":null,"updated_at":null,"url":{"medium":"https://api.americanwhitewater.org/image/images/medium/43153","large":"https://api.americanwhitewater.org/image/images/big/43153"}}],"detail":{"id":"1892","permitUrl":"","permitInfo":"","description":"7-7-09\n\n**ACCESS PROBLEMS:**\n\n(see comments) The landowner that owns the entire upper section including 'The Falls' has made it absolutely clear that boaters are not allowed on 'his creek'.\n\nSo consider this wonderful little stretch of water CLOSED.\n\nOld beta...5-2009....\n\nOtherwise.....\n\nBarbours Creek is a pristine mountain stream.\n\nThis run is a great intro to creeking. The most serious hazards are usually strainers. Undercuts are infrequent.\n\nSo when you drive shuttle (see directions tab) be safe and when you park get well out of the road and leave room for others. Take a trashbag and pick up around the put in especially. Wave and smile at local landowners if you pass them while paddling. Talk to them if engaged. Be friendly. Pick up trash.\n\nDon't Even Think About Fishing Without Written Permission. To fish take your licenses and go way upstream to Nat'l Forest. 'The Pines Campground' is on Nat'l Forest up between the North and South Prongs and has plenty of free camping and good trout fishing when the prongs are stocked.\n\nThere seem to always be several natural strainers on this run so keep a close look out for wood everywhere and take it extra slow. As with most small mtn. streams, avoid large groups much over 4 people at a time; this allows everyone to spread out enough, but still stay within eyesight and earshot.\n\nThis run is about 3 miles and can be done fairly easily in about 2 hours at '0'. This will be a bumpy level but you should have no trouble avoiding strainers and if you're lucky you can tunnel though most of it. After learning the run it is a blast to run laps on at a (+) level.\n\nSee Also:\n\n_Virginia Whitewater_, Roger Corbett (2000 ed.), p. 227.\n\n_Exploring Virginia's Waterways_, Ed Gertler (2022 ed.), p. 219.","averageGradient":"36","maxGradient":"60","length":"7.2","correlations":[],"pointOfInterestIDs":["118018","112735"],"geometry":{"type":"LineString","coordinates":[[-80.123134,37.547432],[-80.123112,37.547415],[-80.122435,37.546994],[-80.12203,37.546982],[-80.121913,37.546823],[-80.121816,37.546724],[-80.121692,37.546619],[-80.12125,37.54629],[-80.121112,37.546153],[-80.120401,37.545356],[-80.120221,37.545175],[-80.120062,37.545032],[-80.119841,37.544868],[-80.119703,37.544791],[-80.119586,37.544752],[-80.119517,37.544742],[-80.119337,37.544775],[-80.118537,37.545105],[-80.118475,37.545143],[-80.118372,37.545231],[-80.118179,37.545358],[-80.117634,37.545501],[-80.117199,37.545583],[-80.116785,37.545644],[-80.116564,37.545666],[-80.115405,37.545754],[-80.115398,37.545743],[-80.115377,37.545743],[-80.115239,37.545766],[-80.114963,37.545777],[-80.114556,37.545771],[-80.114046,37.545728],[-80.113204,37.545596],[-80.112203,37.545487],[-80.111761,37.545448],[-80.111596,37.545448],[-80.11132,37.545465],[-80.111071,37.545487],[-80.11094,37.545515],[-80.110816,37.545559],[-80.11072,37.545625],[-80.110547,37.545784],[-80.110368,37.54602],[-80.109872,37.546718],[-80.109747,37.546883],[-80.109644,37.546999],[-80.109423,37.547207],[-80.109278,37.547328],[-80.108879,37.547642],[-80.10832,37.54806],[-80.107182,37.548917],[-80.106837,37.549142],[-80.106671,37.54923],[-80.106278,37.549357],[-80.105933,37.54945],[-80.105602,37.54956],[-80.105485,37.549621],[-80.105388,37.549692],[-80.105298,37.549775],[-80.10516,37.549929],[-80.105085,37.549995],[-80.105002,37.550039],[-80.104884,37.550077],[-80.104698,37.550105],[-80.104512,37.550105],[-80.102925,37.549924],[-80.102524,37.549869],[-80.102435,37.549875],[-80.102366,37.549891],[-80.102283,37.549924],[-80.1022,37.549985],[-80.102131,37.550056],[-80.102014,37.550375],[-80.101952,37.550617],[-80.10